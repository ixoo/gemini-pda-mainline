#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=cb9f6bbf179ba4e1b6a20efdc6065f5a291e43beed742df6d49ecc1cb251c285
readonly PARENT_SOURCE_INTEGRITY=dbbd6b0bc0bbec63194d1b9de59a913fd01da9ea218aab72ba1d07c99901a398
readonly PARENT_PATCH=0468-soc-mediatek-bind-retained-cluster-CPU9-dispatch.patch
readonly PARENT_PATCH_SHA256=7094356ee6bc1b5fb095e43cc42f525e59e340cec800c2f60a13c83779f7e2ce

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1 source_root=$2 output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared source state changed'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity changed'
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repository_dir=$(cd -- "$script_dir/../../.." && pwd -P)
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout mismatch'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root")
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity failed'
parent_patch_path="$repository_dir/patches/v7.1.3/$PARENT_PATCH"
printf '%s  %s\n' "$PARENT_PATCH_SHA256" "$parent_patch_path" |
	sha256sum --check --status || die 'canonical parent patch changed'
[[ "$(tail -n 1 "$repository_dir/patches/series")" == "v7.1.3/$PARENT_PATCH" ]] ||
	die 'canonical series tail changed'

package="$output_root/cpu9-controller-${project_commit:0:12}"
partial="${package}.partial.$$"
mkdir -p "$output_root"
cleanup() { [[ ! -d "${partial:-}" ]] || rm -rf -- "$partial"; }
trap cleanup EXIT
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/generate_controller_patch.py" \
	--source-root "$source_root" --repository-commit "$project_commit" \
	--output "$partial"
(cd "$partial" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=1 cpu9_controller_validation=pass \
	cpu8_path=unchanged-core-one-request \
	cpu8_gate=terminal-membership-p27-provider-cpu8-online \
	cpu9_order=derive-publish-prepare-add_cpu \
	cpu9_attempt=atomic-one-shot cpu9_request_count=one \
	cpu9_failure=terminal-retain-cpu8-provider-cluster \
	cpu9_combined_diagnostic=controller-and-binder \
	cpu9_cpu_off_paths=0 cpu9_retry_paths=0 cpu9_cluster_effect_paths=0 \
	focused_kunit_cases=8 source_mutations_rejected=10 \
	strict_checkpatch=pass \
	checkpatch_ignored=missing-signoff-file-path-open-ended-line \
	deterministic_replay=pass native_vm_build=none device_action=none \
	physical_cpu_request=none boot_candidate=false; do
	grep -Fx "$marker" "$partial/provenance.txt" >/dev/null ||
		die "missing marker: $marker"
done
mv -- "$partial" "$package"
trap - EXIT
printf 'Generated CPU9 controller patch at %s\n' "$package"
