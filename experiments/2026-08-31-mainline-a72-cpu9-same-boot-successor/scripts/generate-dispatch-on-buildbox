#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=3451d57127083e0950c74569a4b1f1e047d97d8c902f0cda4b11f3ec56e9331e
readonly PARENT_SOURCE_INTEGRITY=4ffb52c7e6edb2edbddd5faee1dea22d4db3a82aad8a840338fb816de465d180
readonly PARENT_PATCH=0467-soc-mediatek-fix-CPU9-executor-test-fixture-type.patch
readonly PARENT_PATCH_SHA256=b3a3631d33c2872589ac249d216bd70b6064cf63df148a22b739223d209079e9
readonly CURRENT_PATCH=0468-soc-mediatek-bind-retained-cluster-CPU9-dispatch.patch
readonly CURRENT_PATCH_SHA256=7094356ee6bc1b5fb095e43cc42f525e59e340cec800c2f60a13c83779f7e2ce

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1 source_root=$2 output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared source state changed'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity changed'
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repository_dir=$(cd -- "$script_dir/../../.." && pwd -P)
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout mismatch'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root")
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity failed'
parent_patch_path="$repository_dir/patches/v7.1.3/$PARENT_PATCH"
printf '%s  %s\n' "$PARENT_PATCH_SHA256" "$parent_patch_path" |
	sha256sum --check --status || die 'canonical parent patch changed'
current_patch_path="$repository_dir/patches/v7.1.3/$CURRENT_PATCH"
printf '%s  %s\n' "$CURRENT_PATCH_SHA256" "$current_patch_path" |
	sha256sum --check --status || die 'canonical CPU9 dispatch patch changed'
[[ "$(tail -n 1 "$repository_dir/patches/series")" == "v7.1.3/$CURRENT_PATCH" ]] ||
	die 'canonical series tail changed'

package="$output_root/cpu9-dispatch-${project_commit:0:12}"
partial="${package}.partial.$$"
mkdir -p "$output_root"
cleanup() { [[ ! -d "${partial:-}" ]] || rm -rf -- "$partial"; }
trap cleanup EXIT
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/generate_dispatch_patch.py" \
	--source-root "$source_root" --repository-commit "$project_commit" \
	--output "$partial"
(cd "$partial" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=1 cpu9_dispatch_validation=pass \
	cpu9_dispatch_psci=preflight-validate-boot-secondary-complete-failure \
	cpu9_dispatch_p30e=cpu9-slot-operation-readback \
	cpu9_dispatch_ledger=record1-independent-terminal \
	cpu9_dispatch_membership=cpu9-specific \
	cpu9_dispatch_cpu_requests=one-standard-psci-callback \
	cpu9_dispatch_cpu8_binder_changes=0 \
	cpu9_dispatch_controller_callers=0 cpu9_dispatch_add_cpu_callers=0 \
	cpu9_dispatch_cpu_off_paths=0 cpu9_dispatch_retry_paths=0 \
	cpu9_dispatch_cluster_effect_paths=0 focused_kunit_cases=8 \
	source_mutations_rejected=10 strict_checkpatch=pass \
	checkpatch_ignored=missing-signoff-file-path-open-ended-line \
	deterministic_replay=pass native_vm_build=none device_action=none \
	boot_candidate=false; do
	grep -Fx "$marker" "$partial/provenance.txt" >/dev/null ||
		die "missing marker: $marker"
done
mv -- "$partial" "$package"
trap - EXIT
printf 'Generated CPU9 dispatch patch at %s\n' "$package"
