#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly EXPECTED_REMOTE=https://github.com/ixoo/gemini-pda-mainline.git
readonly EXPECTED_PROFILE=gemini-cpu9-controller-kunit

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 2 ]] || die 'expected PACKAGE_DIR RAW_LOG'
package_dir=$(cd -- "$1" 2>/dev/null && pwd -P) || die 'package absent'
readonly package_dir
raw_log=$2
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
experiment_dir=$(cd -- "$script_dir/.." && pwd -P)
repository_dir=$(cd -- "$experiment_dir/../.." && pwd -P)
readonly script_dir experiment_dir repository_dir
[[ "$raw_log" == /* ]] || raw_log="$repository_dir/$raw_log"
readonly raw_log

for command in git grep jq python3 qemu-system-aarch64 sha256sum timeout; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
readonly build_json="$package_dir/provenance/build.json"
readonly image="$package_dir/Image"
readonly config="$package_dir/kernel.config"
readonly system_map="$package_dir/System.map"
readonly sums="$package_dir/SHA256SUMS"
for file in "$build_json" "$image" "$config" "$system_map" "$sums"; do
	[[ -f "$file" && ! -L "$file" ]] || die "unsafe package file: $file"
done

package_commit=$(jq -er '.repository_commit' "$build_json")
harness_commit=$(git -C "$repository_dir" rev-parse HEAD)
readonly package_commit harness_commit
[[ "$package_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid package commit'
[[ "$harness_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid harness commit'
[[ "$(git -C "$repository_dir" remote get-url origin)" == "$EXPECTED_REMOTE" ]] ||
	die 'unexpected origin URL'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'repository worktree is not clean'
[[ "$(git -C "$repository_dir" rev-parse origin/main)" == "$harness_commit" ]] ||
	die 'harness HEAD is not published at origin/main'
git -C "$repository_dir" merge-base --is-ancestor \
	"$package_commit" "$harness_commit" || die 'package commit is not a harness ancestor'
[[ "$(jq -er '.repository_dirty' "$build_json")" == false ]] ||
	die 'package was built from a dirty repository'
[[ "$(jq -er '.build_profile' "$build_json")" == "$EXPECTED_PROFILE" ]] ||
	die 'unexpected package profile'
[[ "$(jq -er '.target_architecture' "$build_json")" == arm64 ]] ||
	die 'unexpected package architecture'
case "$package_dir" in
	"$repository_dir/artifacts/buildbox/$package_commit/"*) ;;
	*) die 'package is outside the exact ignored Buildbox commit root' ;;
esac
(
	cd "$package_dir"
	sha256sum --check --strict SHA256SUMS >/dev/null
) || die 'package checksum validation failed'

for token in \
	'CONFIG_KUNIT=y' \
	'CONFIG_KUNIT_DEFAULT_ENABLED=y' \
	'CONFIG_KUNIT_AUTORUN_ENABLED=y' \
	'CONFIG_CMDLINE_FORCE=y' \
	'CONFIG_ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST=y' \
	'CONFIG_ARM64_MT6797_A72_DIRECT_STATE_COMPOSITOR=y' \
	'CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR=y' \
	'CONFIG_ARM64_MT6797_A72_BOOTSTRAP_PUBLISHER=y' \
	'CONFIG_ARM64_MT6797_A72_DERIVED_ADMISSION=y' \
	'CONFIG_ARM64_MT6797_A72_CPU9_MEMBERSHIP=y' \
	'CONFIG_PSTORE_GEMINI_CPU9_TRANSITION_LEDGER=y' \
	'CONFIG_PSTORE_GEMINI_CPU9_PROGRESS_LEDGER=y' \
	'CONFIG_PSTORE_GEMINI_CPU9_PROGRESS_LEDGER_KUNIT_TEST=y' \
	'CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR=y' \
	'CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR_KUNIT_TEST=y' \
	'CONFIG_MTK_MT6797_A72_CPU9_BINDER=y' \
	'CONFIG_MTK_MT6797_A72_CPU9_BINDER_KUNIT_TEST=y' \
	'# CONFIG_PSTORE_GEMINI_ADMISSION_TRACE is not set' \
	'CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y' \
	'CONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER=y' \
	'CONFIG_MTK_MT6797_A72_ADMISSION_LIVE_TRIGGER=y' \
	'CONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER_KUNIT_TEST=y' \
	'CONFIG_MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER=y' \
	'CONFIG_MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER_KUNIT_TEST=y' \
	'CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR=y' \
	'CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR_KUNIT_TEST=y' \
	'CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER=y' \
	'CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER_KUNIT_TEST=y'; do
	grep -Fx "$token" "$config" >/dev/null ||
		die "configuration missing: $token"
done
! grep -Eq '^CONFIG_HOTPLUG_SPLIT_STARTUP=(y|m)$' "$config" ||
	die 'hardware-free profile unexpectedly enables the late startup caller'
focused_test_count=$(grep -Ec '^CONFIG_.*_KUNIT_TEST=y$' "$config")
focused_tests=$(grep -E '^CONFIG_.*_KUNIT_TEST=y$' "$config" | sort)
readonly focused_test_count focused_tests
[[ "$focused_test_count" -eq 8 ]] || die 'KUnit option inventory changed'
[[ "$focused_tests" == $'CONFIG_ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST=y\nCONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER_KUNIT_TEST=y\nCONFIG_MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER_KUNIT_TEST=y\nCONFIG_MTK_MT6797_A72_CPU9_BINDER_KUNIT_TEST=y\nCONFIG_MTK_MT6797_A72_CPU9_EXECUTOR_KUNIT_TEST=y\nCONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER_KUNIT_TEST=y\nCONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR_KUNIT_TEST=y\nCONFIG_PSTORE_GEMINI_CPU9_PROGRESS_LEDGER_KUNIT_TEST=y' ]] ||
	die 'unexpected KUnit test selected'

for symbol in \
	mt6797_a72_membership_derive_cpu9_diagnostic \
	mt6797_a72_membership_derive_cpu9 \
	mt6797_a72_membership_publish_cpu9 \
	mt6797_a72_membership_preflight_cpu9 \
	mt6797_a72_membership_claim_cpu9 \
	mt6797_a72_membership_reject_cpu9 \
	mt6797_a72_membership_begin_cpu9_on \
	mt6797_a72_membership_publish_cpu9_success \
	mt6797_a72_membership_finalize_cpu9_success \
	mt6797_a72_cpu9_executor_begin \
	mt6797_a72_cpu9_executor_secondary \
	mt6797_a72_cpu9_executor_complete \
	mt6797_a72_cpu9_executor_fail \
	mt6797_a72_cpu9_executor_run \
	mt6797_cpu9_executor_test_suite \
	mt6797_a72_cpu9_binder_prepare \
	mt6797_a72_cpu9_binder_preflight \
	mt6797_a72_cpu9_binder_validate \
	mt6797_a72_cpu9_binder_cpu_boot \
	mt6797_a72_cpu9_binder_secondary_complete \
	mt6797_a72_cpu9_binder_complete \
	mt6797_a72_cpu9_binder_failure \
	mt6797_cpu9_binder_test_suite \
	mt6797_a72_admission_probe \
	mt6797_a72_admission_trigger_run \
	mt6797_a72_admission_controller_suite \
	mt6797_a72_cpu9_admission_state_init \
	mt6797_a72_cpu9_admission_run \
	mt6797_a72_cpu9_admission_controller_suite \
	mt6797_a72_cpu9_binder_diagnostic_snapshot \
	gemini_cpu9_ledger_begin \
	gemini_cpu9_ledger_checkpoint \
	gemini_cpu9_progress_begin \
	gemini_cpu9_progress_checkpoint \
	cpu9_progress_suite \
	mt6797_a72_owner_cpu9_parent_gate \
	mt6797_a72_owner_cpu9_parent_mutations \
	mt6797_a72_owner_cpu9_success_lifecycle \
	mt6797_a72_owner_cpu9_rejection_one_shot \
	mt6797_a72_owner_suite \
	mt6797_a72_transition_run \
	mt6797_transition_suite \
	mt6797_a72_binder_preflight \
	mt6797_a72_binder_cpu_boot \
	mt6797_a72_binder_complete \
	mt6797_a72_binder_failure \
	mt6797_binder_test_suite; do
	grep -q " ${symbol}$" "$system_map" || die "required symbol absent: $symbol"
done

mkdir -p "$repository_dir/artifacts/qemu"
raw_parent=$(cd -- "$(dirname -- "$raw_log")" 2>/dev/null && pwd -P) ||
	die 'raw-log parent absent'
readonly raw_parent
[[ "$raw_parent" == "$repository_dir/artifacts/qemu" ]] ||
	die 'raw log must be directly below ignored artifacts/qemu'
[[ ! -L "$raw_parent" ]] || die 'raw-log parent is a symlink'
[[ "$raw_log" == "$raw_parent/"[a-z0-9._-]*.log ]] || die 'unsafe raw-log name'
[[ ! -e "$raw_log" ]] || die 'refusing to overwrite a raw log'

set +e
timeout --signal=TERM 45 qemu-system-aarch64 \
	-accel tcg,thread=single \
	-machine virt -cpu cortex-a53 -smp 4 -m 1024 \
	-nographic -no-reboot -nic none -kernel "$image" \
	>"$raw_log" 2>&1
qemu_exit=$?
set -e
readonly qemu_exit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/classify-kunit.py" \
	--package "$package_dir" \
	--raw-log "$raw_log" \
	--qemu-exit "$qemu_exit" \
	--repository-commit "$package_commit" \
	--harness-commit "$harness_commit"
