#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=0f91989ff1d1a929c16aabf492e341adfa4fe302fdbf5f95ce27fe9ef65a6685
readonly KCONFIG_SHA256=89a285c126d6e9cd531955c320e686ea16900ded82fb6fefc31108c677e2a4e5
readonly MAKEFILE_SHA256=5c274637746948c9b89df1616e4f3f54c7969b17452358840a6843540ded99b9
readonly CLOCK_HEADER_SHA256=f13b88cd262f476e8ac0e55fda3cdf115041dabefa69a5ff5e3ca8c1dcc8bcf5
readonly BIGIDVFS_HEADER_SHA256=ba3430ec9e3fe54448d1c93ed744ae06e4b5c6113f800de03226105fc26f3329
readonly DTS_MAKEFILE_SHA256=a712121f7f926245c0f09e68bd0a284cf9416ef3921f9d0b6cf334808fda117f
readonly GEMINI_DTS_SHA256=08f8b007379e52daa441d8b48731f8cd4a0549a3c1d887791762db68320fdbd8
readonly MT6797_DTSI_SHA256=548426810a4ece2b41a26070280b0ad8243c51690956defa9e10e47ab6356a7d

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" && ! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
experiment_dir="$(cd -- "$script_dir/.." && pwd -P)"
repository_dir="$(cd -- "$experiment_dir/../.." && pwd -P)"
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root" |
	grep -E '^source_tree_integrity=[0-9a-f]{64}$' >/dev/null ||
	die 'prepared source integrity verification failed'

check_file() {
	local expected=$1
	local relative=$2
	printf '%s  %s\n' "$expected" "$source_root/$relative" |
		sha256sum --check --status || die "parent source changed: $relative"
}
check_file "$KCONFIG_SHA256" drivers/soc/mediatek/Kconfig
check_file "$MAKEFILE_SHA256" drivers/soc/mediatek/Makefile
check_file "$CLOCK_HEADER_SHA256" include/linux/soc/mediatek/mt6797-dvfsp-clock-backend.h
check_file "$BIGIDVFS_HEADER_SHA256" include/linux/soc/mediatek/mt6797-bigidvfs-backend.h
check_file "$DTS_MAKEFILE_SHA256" arch/arm64/boot/dts/mediatek/Makefile
check_file "$GEMINI_DTS_SHA256" arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
check_file "$MT6797_DTSI_SHA256" arch/arm64/boot/dts/mediatek/mt6797.dtsi

readonly work_root=/workspace/gemini-pda/protected-readback-observer-work
readonly package="$output_root/protected-readback-observer-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'

if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated protected-readback observer at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work="$(mktemp -d "$work_root/generation.XXXXXX")"
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] || rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] || rm -rf -- "$partial"
}
trap cleanup EXIT

for relative in \
  drivers/soc/mediatek/Kconfig \
  drivers/soc/mediatek/Makefile \
  include/linux/soc/mediatek/mt6797-dvfsp-clock-backend.h \
  include/linux/soc/mediatek/mt6797-bigidvfs-backend.h \
  arch/arm64/boot/dts/mediatek/Makefile \
  arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts \
  arch/arm64/boot/dts/mediatek/mt6797.dtsi; do
	mkdir -p "$work/source/$(dirname "$relative")"
	cp -- "$source_root/$relative" "$work/source/$relative"
done
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- .
GIT_AUTHOR_DATE=2026-08-21T23:30:00Z \
GIT_COMMITTER_DATE=2026-08-21T23:30:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'protected-readback observer parent'
baseline_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly baseline_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --step binding
git -C "$work/source" diff --check
git -C "$work/source" add -- \
	Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-protected-readback-observer.yaml
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T23:31:00Z \
GIT_COMMITTER_DATE=2026-08-21T23:31:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'dt-bindings: soc: mediatek: add MT6797 protected readback observer' \
		-m 'Describe the candidate-only consumer of the protected clock and BigiDVFS readback transports.'

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --step observer
git -C "$work/source" diff --check
git -C "$work/source" add -- \
	drivers/soc/mediatek/Kconfig \
	drivers/soc/mediatek/Makefile \
	drivers/soc/mediatek/mt6797-protected-readback-observer.c
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T23:32:00Z \
GIT_COMMITTER_DATE=2026-08-21T23:32:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'soc: mediatek: add one-shot protected readback observer' \
		-m 'Wait until both already-reviewed read-only transports are bound, call each exactly once, and publish their complete raw records and return codes.' \
		-m 'Expose no trigger, retry, owner registration, state classification, firmware write, or CPU operation.'

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --step dts
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/source"
git -C "$work/source" diff --check
git -C "$work/source" add -- \
	arch/arm64/boot/dts/mediatek/Makefile \
	arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-protected-readback.dts
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T23:33:00Z \
GIT_COMMITTER_DATE=2026-08-21T23:33:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'arm64: dts: mediatek: add Gemini protected readback candidate' \
		-m 'Add a separate Gemini DTB derivative that enables only the two protected readback transports and their bounded one-shot observer.' \
		-m 'Leave the base Gemini DTB, transition owner, and CPU8/CPU9 admission unchanged.'
result_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly result_commit

mkdir -p "$partial/patches" "$partial/provenance"
mapfile -t generated < <(git -C "$work/source" format-patch \
	--no-signature --output-directory "$partial/patches" \
	"${baseline_commit}..${result_commit}")
[[ "${#generated[@]}" -eq 3 ]] || die 'generated patch count changed'
readonly patch_1=0320-dt-bindings-soc-mediatek-add-MT6797-protected-readback-observer.patch
readonly patch_2=0321-soc-mediatek-add-one-shot-protected-readback-observer.patch
readonly patch_3=0322-arm64-dts-mediatek-add-Gemini-protected-readback-candidate.patch
mv -- "${generated[0]}" "$partial/patches/$patch_1"
mv -- "${generated[1]}" "$partial/patches/$patch_2"
mv -- "${generated[2]}" "$partial/patches/$patch_3"
printf '%s\n%s\n%s\n' "$patch_1" "$patch_2" "$patch_3" \
	>"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patches.py" \
	--patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$baseline_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date \
	"$partial/patches/$patch_1" "$partial/patches/$patch_2" \
	"$partial/patches/$patch_3"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$result_commit" ]] ||
	die 'patch replay did not reproduce generated commit'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/verify"
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

for patch in "$patch_1" "$patch_2" "$patch_3"; do
	if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
		--ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE,QUOTED_STRING_SPLIT \
		"$partial/patches/$patch" \
		>"$partial/provenance/checkpatch-${patch%.patch}.txt"; then
		cat "$partial/provenance/checkpatch-${patch%.patch}.txt" >&2
		die "strict checkpatch rejected $patch"
	fi
done

cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-protected-readback-runtime-observer
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
baseline_commit=$baseline_commit
result_commit=$result_commit
generated_patch_count=3
checkpatch_intentional_ignore=QUOTED_STRING_SPLIT-for-one-atomic-raw-record
observer_calls=clock-1,bigidvfs-1
defer_before_hardware_access=yes
automatic_retry_after_access=no
raw_fields=complete
candidate_dtb_enables=clock,bigidvfs,observer
base_gemini_dtb_changed=false
named_tee_identity_gate=required-before-deployment
secure_write=none
owner_registration=0
cpu_on=false
cpu_off=false
device_action=none
boot_candidate=false
EOF
printf '%s\n%s\n%s\n' "$patch_1" "$patch_2" "$patch_3" \
	>"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated protected-readback observer at %s\n' "$package"
