#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=b4dae5f2b949b20f9429c30a575093a1c0417478e7ac54189b237bd1eb2b0e80
readonly PARENT_SOURCE_INTEGRITY=8bcad2457060d79a933de181a76f4db338692736abbbab7168047676b7a5050d
readonly MT6797_DTSI_SHA256=bcfc0a1f1d1c7aae64d5aa1cb1f397bb9b1ecca8d2d4a3e07f36970d0b83fe3f
readonly GEMINI_DTS_SHA256=08f8b007379e52daa441d8b48731f8cd4a0549a3c1d887791762db68320fdbd8
readonly MAKEFILE_SHA256=cff172618c01f18f04f0b555130f07967637d3555b68d8fa787ef7c4c7ebe057
readonly THERMAL_BINDING_SHA256=db97e8ff71eeb4011b1e6612de764d14a40589466767542bb8ef6e6a9245df3f
readonly ZONES_BINDING_SHA256=e33f5e5cd8f635a96eba3fed9d98d8405822208c0fa40eecd8bbb0caa6a7743b

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" && ! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'
[[ -f "$source_root/.gemini-source-integrity" && ! -L "$source_root/.gemini-source-integrity" ]] ||
	die 'prepared source integrity marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared parent source integrity changed'

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
experiment_dir=$(cd -- "$script_dir/.." && pwd -P)
repository_dir=$(cd -- "$experiment_dir/../.." && pwd -P)
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done

readonly mediatek="$source_root/arch/arm64/boot/dts/mediatek"
printf '%s  %s\n' "$MT6797_DTSI_SHA256" "$mediatek/mt6797.dtsi" |
	sha256sum --check --status || die 'parent mt6797.dtsi changed'
printf '%s  %s\n' "$GEMINI_DTS_SHA256" "$mediatek/mt6797-gemini-pda.dts" |
	sha256sum --check --status || die 'parent Gemini DTS changed'
printf '%s  %s\n' "$MAKEFILE_SHA256" "$mediatek/Makefile" |
	sha256sum --check --status || die 'parent MediaTek Makefile changed'
printf '%s  %s\n' "$THERMAL_BINDING_SHA256" \
	"$source_root/Documentation/devicetree/bindings/thermal/mediatek,thermal.yaml" |
	sha256sum --check --status || die 'thermal binding changed'
printf '%s  %s\n' "$ZONES_BINDING_SHA256" \
	"$source_root/Documentation/devicetree/bindings/thermal/thermal-zones.yaml" |
	sha256sum --check --status || die 'thermal-zones binding changed'

readonly work_root=/workspace/gemini-pda/mt6797-thermal-serviceability-work
readonly package="$output_root/mt6797-thermal-serviceability-patches-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'
if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" "$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated MT6797 thermal serviceability patch review at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work=$(mktemp -d "$work_root/generation.XXXXXX")
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] || rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] || rm -rf -- "$partial"
}
trap cleanup EXIT

mkdir -p "$work/source/arch/arm64/boot/dts/mediatek"
cp -- "$mediatek/mt6797.dtsi" "$mediatek/mt6797-gemini-pda.dts" \
	"$mediatek/Makefile" "$work/source/arch/arm64/boot/dts/mediatek/"
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- arch/arm64/boot/dts/mediatek
GIT_AUTHOR_DATE=2026-09-04T13:00:00Z GIT_COMMITTER_DATE=2026-09-04T13:00:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'bounded MT6797 thermal serviceability source parent'
baseline_commit=$(git -C "$work/source" rev-parse HEAD)
readonly baseline_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --phase reset
git -C "$work/source" diff --check
git -C "$work/source" add -- arch/arm64/boot/dts/mediatek/mt6797.dtsi
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-09-04T13:01:00Z \
GIT_COMMITTER_DATE=2026-09-04T13:01:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'arm64: dts: mediatek: add MT6797 thermal reset' \
		-m 'Describe the source-proven infracfg reset input.' \
		-m 'Keep the reusable SoC thermal consumer disabled by default.'
reset_commit=$(git -C "$work/source" rev-parse HEAD)
readonly reset_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --phase variant
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/source" >"$work/source-validation.txt"
git -C "$work/source" diff --check
git -C "$work/source" add -- arch/arm64/boot/dts/mediatek/Makefile \
	arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-thermal-serviceability.dts
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-09-04T13:02:00Z \
GIT_COMMITTER_DATE=2026-09-04T13:02:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'arm64: dts: mediatek: add Gemini thermal serviceability' \
		-m 'Enable only the MT6797 thermal consumer in a dedicated board DT.' \
		-m 'Add one trip-free zone and leave standalone AUXADC disabled.'
variant_commit=$(git -C "$work/source" rev-parse HEAD)
readonly variant_commit

mkdir -p "$partial/patches" "$partial/provenance"
readonly patch1=0519-arm64-dts-mediatek-add-MT6797-thermal-reset.patch
readonly patch2=0520-arm64-dts-mediatek-add-Gemini-thermal-serviceability.patch
git -C "$work/source" format-patch -2 --no-signature --numbered \
	--start-number 1 --output-directory "$partial/patches" >/dev/null
generated1=$(find "$partial/patches" -maxdepth 1 -type f -name '0001-*.patch' -print)
generated2=$(find "$partial/patches" -maxdepth 1 -type f -name '0002-*.patch' -print)
[[ -n "$generated1" && -n "$generated2" ]] || die 'normal patch output absent'
mv -- "$generated1" "$partial/patches/$patch1"
mv -- "$generated2" "$partial/patches/$patch2"
printf '%s\n' "$patch1" "$patch2" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patches.py" \
	--patch-dir "$partial/patches" >"$partial/provenance/patch-validation.txt"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$baseline_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date \
	"$partial/patches/$patch1" "$partial/patches/$patch2"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$variant_commit" ]] ||
	die 'normal patch application did not reproduce generated commits'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/verify" >/dev/null
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
	--ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE \
	"$partial/patches/$patch1" "$partial/patches/$patch2" \
	>"$partial/provenance/checkpatch.txt"; then
	cat "$partial/provenance/checkpatch.txt" >&2
	die 'strict checkpatch rejected generated patches'
fi
cp -- "$work/source-validation.txt" "$partial/provenance/source-validation.txt"
cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-mt6797-thermal-serviceability-dt
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
parent_source_integrity=$PARENT_SOURCE_INTEGRITY
baseline_commit=$baseline_commit
reset_commit=$reset_commit
variant_commit=$variant_commit
generated_patch_count=2
changed_path_count=3
thermal_zone_count=1
trip_count=0
cooling_map_count=0
generator=experiments/2026-09-04-mt6797-thermal-serviceability/scripts/generate-on-buildbox
synthetic_signoff=absent
native_vm_kernel_build=no
hardware_action=none
device_action=none
boot_candidate=false
EOF
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv "$partial" "$package"
trap - EXIT
rm -rf -- "$work"
printf 'Generated MT6797 thermal serviceability patch review at %s\n' "$package"
