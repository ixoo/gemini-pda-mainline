# Proposed allnoconfig-based upstream test profile; not an admitted build input.
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT6797=y
CONFIG_MFD_SYSCON=y
CONFIG_KUNIT=y
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_KUNIT_AUTORUN_ENABLED=y
CONFIG_KUNIT_DEFAULT_TIMEOUT=5
CONFIG_COMMON_CLK_MEDIATEK_RESET_KUNIT_TEST=y
CONFIG_COMMON_CLK_MT6797_RESET_KUNIT_TEST=y
CONFIG_LOCALVERSION="-mt6797-infracfg-upstream-kunit"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_KUNIT_ALL_TESTS is not set
# CONFIG_KUNIT_TEST is not set
# CONFIG_KUNIT_EXAMPLE_TEST is not set
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_USB is not set
# CONFIG_MMC is not set
# CONFIG_I2C is not set
# CONFIG_REGULATOR is not set
# CONFIG_THERMAL is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
