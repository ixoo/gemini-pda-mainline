From ef85af6b76cd1f8c28aac853cb0e6ed7360d5f11 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sat, 5 Sep 2026 03:00:00 +0000
Subject: [PATCH 1/6] clk: mediatek: reject out-of-bank SET/CLEAR reset IDs

Validate translated reset banks before indexing register offsets or calling regmap. Keep the bank full-width until validation and leave outputs untouched on invalid input. Share the private arithmetic with focused tests.
---
 drivers/clk/mediatek/reset-internal.h | 35 +++++++++++++++++++++++++++
 drivers/clk/mediatek/reset.c          | 19 ++++++++-------
 2 files changed, 45 insertions(+), 9 deletions(-)
 create mode 100644 drivers/clk/mediatek/reset-internal.h

diff --git a/drivers/clk/mediatek/reset-internal.h b/drivers/clk/mediatek/reset-internal.h
new file mode 100644
index 0000000..9a012b8
--- /dev/null
+++ b/drivers/clk/mediatek/reset-internal.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __DRV_CLK_MTK_RESET_INTERNAL_H
+#define __DRV_CLK_MTK_RESET_INTERNAL_H
+
+#include <linux/bitops.h>
+#include <linux/errno.h>
+
+#include "reset.h"
+
+static inline int
+mtk_reset_xlate_index(const struct mtk_clk_rst_desc *desc, unsigned int index)
+{
+	if (!desc->rst_idx_map || index >= desc->rst_idx_map_nr)
+		return -EINVAL;
+
+	return desc->rst_idx_map[index];
+}
+
+static inline int
+mtk_reset_set_clr_reg(const struct mtk_clk_rst_desc *desc,
+		      unsigned long id, bool deassert,
+		      unsigned int *reg, unsigned int *mask)
+{
+	unsigned long bank = id / RST_NR_PER_BANK;
+
+	if (!desc->rst_bank_ofs || bank >= desc->rst_bank_nr)
+		return -EINVAL;
+
+	*reg = desc->rst_bank_ofs[bank] + (deassert ? 0x4 : 0);
+	*mask = BIT(id % RST_NR_PER_BANK);
+
+	return 0;
+}
+
+#endif /* __DRV_CLK_MTK_RESET_INTERNAL_H */
diff --git a/drivers/clk/mediatek/reset.c b/drivers/clk/mediatek/reset.c
index 2e33039..4f83a20 100644
--- a/drivers/clk/mediatek/reset.c
+++ b/drivers/clk/mediatek/reset.c
@@ -10,7 +10,7 @@
 #include <linux/regmap.h>
 #include <linux/slab.h>
 
-#include "reset.h"
+#include "reset-internal.h"
 
 static inline struct mtk_clk_rst_data *to_mtk_clk_rst_data(struct reset_controller_dev *rcdev)
 {
@@ -55,12 +55,14 @@ static int mtk_reset_update_set_clr(struct reset_controller_dev *rcdev,
 				    unsigned long id, bool deassert)
 {
 	struct mtk_clk_rst_data *data = to_mtk_clk_rst_data(rcdev);
-	unsigned int deassert_ofs = deassert ? 0x4 : 0;
+	unsigned int reg, mask;
+	int ret;
+
+	ret = mtk_reset_set_clr_reg(data->desc, id, deassert, &reg, &mask);
+	if (ret)
+		return ret;
 
-	return regmap_write(data->regmap,
-			    data->desc->rst_bank_ofs[id / RST_NR_PER_BANK] +
-			    deassert_ofs,
-			    BIT(id % RST_NR_PER_BANK));
+	return regmap_write(data->regmap, reg, mask);
 }
 
 static int mtk_reset_assert_set_clr(struct reset_controller_dev *rcdev,
@@ -103,11 +105,10 @@ static int reset_xlate(struct reset_controller_dev *rcdev,
 {
 	struct mtk_clk_rst_data *data = to_mtk_clk_rst_data(rcdev);
 
-	if (reset_spec->args[0] >= rcdev->nr_resets ||
-	    reset_spec->args[0] >= data->desc->rst_idx_map_nr)
+	if (reset_spec->args[0] >= rcdev->nr_resets)
 		return -EINVAL;
 
-	return data->desc->rst_idx_map[reset_spec->args[0]];
+	return mtk_reset_xlate_index(data->desc, reset_spec->args[0]);
 }
 
 int mtk_register_reset_controller_with_dev(struct device *dev,
