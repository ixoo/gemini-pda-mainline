#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=268ebef69a7575d23004b137a3334989b82b444cbf3a773850626566275b8fb8
readonly PARENT_SOURCE_INTEGRITY=9f18bf45f6d001892044d8b1f1303b5e26c49e2fcd19dab637a994355fc6c65f
readonly KCONFIG_SHA256=8e8c918409a16ce6cf21ccba3ee8b8952661b774e8172df56c4355204a4b9bfa
readonly LEDGER_SHA256=29addf6255b47918726aac434c02b50a78fccc343e64193a535fd5a446f674f5
readonly OBSERVER_SHA256=298754808189edd5e6346a4cc23694334019cc02d3e45009f7fae79c2eec9fb9
readonly PARENT_PATCH=0356-soc-mediatek-move-A72-physical-source-result-off-stack.patch
readonly PARENT_PATCH_SHA256=94076d20cf542941016e72996d5bdc1a8c03cedbd6e284763e424d8841dde4c9
readonly PATCH=0357-pstore-soc-add-Gemini-A72-pre-capture-ledger.patch

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" &&
	! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'
[[ -f "$source_root/.gemini-source-integrity" &&
	! -L "$source_root/.gemini-source-integrity" ]] ||
	die 'prepared source integrity marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity marker changed'

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
experiment_dir=$(cd -- "$script_dir/.." && pwd -P)
repository_dir=$(cd -- "$experiment_dir/../.." && pwd -P)
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root")
readonly integrity
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity verification failed'

readonly kconfig_relative=fs/pstore/Kconfig
readonly ledger_relative=fs/pstore/gemini_protected_readback_ledger.c
readonly observer_relative=drivers/soc/mediatek/mt6797-a72-physical-source-observer.c
printf '%s  %s\n' "$KCONFIG_SHA256" "$source_root/$kconfig_relative" |
	sha256sum --check --status || die 'parent Kconfig changed'
printf '%s  %s\n' "$LEDGER_SHA256" "$source_root/$ledger_relative" |
	sha256sum --check --status || die 'parent ledger changed'
printf '%s  %s\n' "$OBSERVER_SHA256" "$source_root/$observer_relative" |
	sha256sum --check --status || die 'parent observer changed'
readonly parent_patch_path="$repository_dir/patches/v7.1.3/$PARENT_PATCH"
[[ -f "$parent_patch_path" && ! -L "$parent_patch_path" ]] ||
	die 'canonical parent patch absent or unsafe'
printf '%s  %s\n' "$PARENT_PATCH_SHA256" "$parent_patch_path" |
	sha256sum --check --status || die 'canonical parent patch changed'

readonly work_root=/workspace/gemini-pda/a72-physical-source-precapture-work
readonly package="$output_root/a72-physical-source-precapture-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'
if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated A72 physical-source pre-capture ledger at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work=$(mktemp -d "$work_root/generation.XXXXXX")
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] || rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] || rm -rf -- "$partial"
}
trap cleanup EXIT

for relative in "$kconfig_relative" "$ledger_relative" "$observer_relative"; do
	mkdir -p "$work/source/$(dirname "$relative")"
	cp -- "$source_root/$relative" "$work/source/$relative"
done
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- .
GIT_AUTHOR_DATE=2026-08-24T16:30:00Z \
GIT_COMMITTER_DATE=2026-08-24T16:30:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'A72 physical-source pre-capture canonical parent'
parent_commit=$(git -C "$work/source" rev-parse HEAD)
readonly parent_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" --source-root "$work/source"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" --source-root "$work/source"
git -C "$work/source" diff --check
git -C "$work/source" add -- .
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-24T16:31:00Z \
GIT_COMMITTER_DATE=2026-08-24T16:31:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'pstore: soc: add Gemini A72 pre-capture ledger' \
		-m 'Record physical-source probe entry and successful acquisition of all three bound source devices, then release them without running the capture.' \
		-m 'Reuse the qualified first-dmesg writer and keep physical snapshots, provider transactions, owner mutation, publication, and CPU requests closed.'
result_commit=$(git -C "$work/source" rev-parse HEAD)
readonly result_commit

mkdir -p "$partial/patches" "$partial/provenance"
git -C "$work/source" format-patch -1 --no-signature --numbered \
	--start-number 1 --output-directory "$partial/patches" >/dev/null
generated=$(find "$partial/patches" -maxdepth 1 -type f -name '0001-*.patch' -print)
[[ -n "$generated" ]] || die 'normal pre-capture patch absent'
mv -- "$generated" "$partial/patches/$PATCH"
printf '%s\n' "$PATCH" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patch.py" --patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$parent_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date "$partial/patches/$PATCH"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$result_commit" ]] ||
	die 'patch replay did not reproduce generated commit'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" --source-root "$work/verify"
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
	--ignore MISSING_SIGN_OFF,COMMIT_LOG_LONG_LINE,SPLIT_STRING \
	"$partial/patches/$PATCH" >"$partial/provenance/checkpatch.txt"; then
	cat "$partial/provenance/checkpatch.txt" >&2
	die 'strict checkpatch rejected pre-capture patch'
fi

cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-a72-physical-source-precapture-ledger
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
parent_source_integrity=$PARENT_SOURCE_INTEGRITY
canonical_parent_patch=$PARENT_PATCH
canonical_parent_patch_sha256=$PARENT_PATCH_SHA256
parent_commit=$parent_commit
result_commit=$result_commit
generated_patch_count=1
changed_files=$kconfig_relative,$ledger_relative,$observer_relative
retained_token=GAPC-20260824-A
retained_checkpoints=probe-enter,sources-held
retained_slots=1,2
retained_maximum_writes=2
capture_calls_in_precapture_path=0
provider_transactions=0
publisher_calls=0
owner_mutations=0
cpu_requests=0
device_action=none
boot_candidate=false
EOF
printf '%s\n' "$PATCH" >"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z | xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated A72 physical-source pre-capture ledger at %s\n' "$package"
