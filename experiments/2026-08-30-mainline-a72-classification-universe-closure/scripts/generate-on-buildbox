#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=404d5b64ed9668f812ad122b30a36faa523266890367a0c7eaa44491dfb8e464
readonly PARENT_SOURCE_INTEGRITY=1f8f978d358d3099b1c986765004d68b3da811db38592f65fa4dad6277f4b471
readonly PARENT_PATCH=0440-arm64-repair-Gemini-late-CPU-plan-expectations.patch
readonly PARENT_PATCH_SHA256=b629ff9589748131a72928942c23f25765054cea4be977c2623956b6d84726cc
readonly CURRENT_PATCH=0441-arm64-complete-Gemini-late-CPU-classified-universe.patch

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1 source_root=$2 output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] || die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] || die 'prepared source state changed'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] || die 'prepared source integrity changed'
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repository_dir=$(cd -- "$script_dir/../../.." && pwd -P)
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] || die 'project checkout mismatch'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] || die 'project checkout is dirty'
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root")
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] || die 'prepared source integrity failed'
parent_patch_path="$repository_dir/patches/v7.1.3/$PARENT_PATCH"
printf '%s  %s\n' "$PARENT_PATCH_SHA256" "$parent_patch_path" | sha256sum --check --status || die 'canonical parent patch changed'
[[ "$(tail -n 1 "$repository_dir/patches/series")" == "v7.1.3/$PARENT_PATCH" ]] || die 'canonical series parent changed'
[[ ! -e "$repository_dir/patches/v7.1.3/$CURRENT_PATCH" ]] || die 'closure patch is already canonical'
package="$output_root/a72-classification-universe-closure-${project_commit:0:12}"
partial="${package}.partial.$$"
mkdir -p "$output_root"
cleanup() { [[ ! -d "${partial:-}" ]] || rm -rf -- "$partial"; }
trap cleanup EXIT
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/generate_patch.py" --source-root "$source_root" --repository-commit "$project_commit" --output "$partial"
(cd "$partial" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=1 source_validation=pass \
	classified_cache_mismatch=absent present_cache_mismatch=absent \
	required_cache_mismatch=absent producer_changes=0 effect_model_changes=0 \
	policy_changes=0 new_cpu_request_paths=0 cpu9_request_paths=0 \
	cpu_off_paths=0 retry_paths=0 hardware_writes=0 \
	unsafe_source_mutations_rejected=4 profile_fragments_changed=0 \
	native_vm_build=none device_action=none boot_candidate=false; do
	grep -Fx "$marker" "$partial/provenance.txt" >/dev/null || die "missing marker: $marker"
done
mv -- "$partial" "$package"
trap - EXIT
printf 'Generated A72 classified-universe closure at %s\n' "$package"
