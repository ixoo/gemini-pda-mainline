#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=24a6905922ecd7d6a618bedd8da3819de5d7d8b97c92f081f95fd9c28e3cf041
readonly PARENT_SOURCE_INTEGRITY=e62aa413d9a4126e428608e07c4f7e8245ca123a9457b874ef42057b7a620db1

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1 source_root=$2 output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] || die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] || die 'prepared source state changed'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] || die 'prepared source integrity changed'
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repository_dir=$(cd -- "$script_dir/../../.." && pwd -P)
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] || die 'project checkout mismatch'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] || die 'project checkout is dirty'
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root")
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] || die 'prepared source integrity failed'
[[ "$(tail -n 1 "$repository_dir/patches/series")" == 'v7.1.3/0445-arm64-mediatek-update-closed-admission-test-contract.patch' ]] || die 'canonical series parent changed'
package="$output_root/a72-ready-token-contract-${project_commit:0:12}"
partial="${package}.partial.$$"
mkdir -p "$output_root"
cleanup() { [[ ! -d "${partial:-}" ]] || rm -rf -- "$partial"; }
trap cleanup EXIT
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/generate_patch.py" \
	--source-root "$source_root" --repository-commit "$project_commit" \
	--output "$partial"
(cd "$partial" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=1 ready_contract_validation=pass \
	production_observation_contract=empty-before-target-execution \
	expected_target_mpidrs=0x200,0x201 focused_ready_cases=2 \
	new_cpu_request_paths=0 cpu9_request_paths=0 cpu_off_paths=0 \
	retry_paths=0 hardware_writes=0 native_vm_build=none \
	device_action=none boot_candidate=false; do
	grep -Fx "$marker" "$partial/provenance.txt" >/dev/null || \
		die "missing marker: $marker"
done
mv -- "$partial" "$package"
trap - EXIT
printf 'Generated READY-token contract patch at %s\n' "$package"
