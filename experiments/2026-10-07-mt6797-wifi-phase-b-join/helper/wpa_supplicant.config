# SPDX-License-Identifier: MIT
# Minimal WPA2-PSK station supplicant for the Gemini PDA mainline RAM root.
# Static aarch64, nl80211 only, internal crypto, Unix control socket.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_CTRL_IFACE=unix
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_CONFIG_BLOBS=y
CONFIG_NO_ROAMING=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
CONFIG_OS=unix
CONFIG_ELOOP=eloop
CONFIG_ELOOP_EPOLL=y
CONFIG_MAIN=main
CONFIG_IEEE8021X_EAPOL=y
CONFIG_WPA_CLI_EDIT=n
