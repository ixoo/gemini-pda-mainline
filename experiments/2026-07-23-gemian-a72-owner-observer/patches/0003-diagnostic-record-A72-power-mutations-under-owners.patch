From 429afb35a3b5ccaec976d31288dd52148855ef79 Mon Sep 17 00:00:00 2001
From: Gemini PDA Investigation <gemini-observer@example.invalid>
Date: Thu, 23 Jul 2026 20:38:13 -0400
Subject: [PATCH 3/4] diagnostic: record A72 power mutations under owners

---
 arch/arm64/kernel/psci.c                      | 84 ++++++++++++++++++-
 .../misc/mediatek/base/power/mt6797/mt_dcm.c  | 78 +++++++++++++++--
 .../misc/mediatek/base/power/spm_v2/mt_spm.c  |  5 +-
 .../watchdog/mediatek/wdt/mt6797/mtk_wdt.c    | 31 +++++++
 .../linux/mt6797_a72_transition_observer.h    |  2 +-
 5 files changed, 188 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/kernel/psci.c b/arch/arm64/kernel/psci.c
index 051bdbbf..a0f100ee 100644
--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -43,6 +43,9 @@
 #include <mt_ocp.h>
 #include <mt6797/mt_wdt.h>
