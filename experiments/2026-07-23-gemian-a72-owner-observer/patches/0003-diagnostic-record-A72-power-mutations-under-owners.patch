 			wdt_sys_val &= ~MTK_WDT_SWSYS_RST_CONMCU_RST;
 		break;
 	}
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	if (mt6797_a72_obs_is_cpu(observer_cpu))
+		snapshot.requested = wdt_sys_val;
+#endif
 	mt_reg_sync_writel(wdt_sys_val, MTK_WDT_SWSYSRST);
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	if (mt6797_a72_obs_is_cpu(observer_cpu))
+		snapshot.after = __raw_readl(MTK_WDT_SWSYSRST);
+#endif
 	spin_unlock(&rgu_reg_operation_spinlock);
 
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	if (mt6797_a72_obs_is_cpu(observer_cpu))
+		mt6797_a72_obs_toprgu(observer_cpu,
+			set_value ? MT6797_A72_PHASE_TOPRGU_ASSERT :
+				    MT6797_A72_PHASE_TOPRGU_DEASSERT,
+			&snapshot);
+#endif
 	/* mdelay(10); */
 	pr_debug("after set wdt_sys_val =%x,wdt_sys_val=%x\n", __raw_readl(MTK_WDT_SWSYSRST), wdt_sys_val);
 	return 0;
