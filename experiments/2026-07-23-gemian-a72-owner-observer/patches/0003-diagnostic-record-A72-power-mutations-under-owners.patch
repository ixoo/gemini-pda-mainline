@@ -502,39 +505,92 @@ static int __init cpu_psci_cpu_prepare(unsigned int cpu)
 
 #ifdef CONFIG_ARCH_MT6797
 #ifdef CONFIG_CL2_BUCK_CTRL
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+static void mt6797_a72_obs_fixed_snapshot(unsigned int cpu, u16 phase)
+{
+	da9214_a72_obs_snapshot(cpu, phase);
+	mt6797_a72_obs_spm_snapshot(cpu, phase);
+	mt6797_a72_obs_secure_snapshot(cpu, phase);
+	mt6797_a72_obs_clock_snapshot(cpu, phase);
+	mt6797_a72_obs_dcm_snapshot(cpu, phase);
+}
+#endif
+
 static int cpu_power_on_buck(unsigned int cpu, bool hotplug)
 {
 	static void __iomem *reg_base;
 	static volatile unsigned int temp;
 	int ret = 0;
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	int smc_ret;
+
+	mt6797_a72_obs_tx_ensure(cpu, MT6797_A72_PHASE_POWER_ON_ENTER);
+	mt6797_a72_obs_fixed_snapshot(cpu, MT6797_A72_PHASE_POWER_ON_PRE);
+#endif
 
 	/* set reset_flags for OCP */
 	spin_lock(&reset_lock);
 	reset_flags = 1;
 	spin_unlock(&reset_lock);
 
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	if (!mt6797_a72_obs_spm_rmw(cpu,
+				    MT6797_A72_PHASE_SPM_RESET_RELEASE,
+				    0x218, BIT(0), BIT(0))) {
+		reg_base = ioremap(MT6797_SPM_BASE_ADDR, 0x1000);
+		writel_relaxed((readl(reg_base + 0x218) | (1 << 0)),
+			       reg_base + 0x218);
+		iounmap(reg_base);
+	}
+#else
 	reg_base = ioremap(MT6797_SPM_BASE_ADDR, 0x1000);
-	writel_relaxed((readl(reg_base + 0x218) | (1 << 0)), reg_base + 0x218);
+	writel_relaxed((readl(reg_base + 0x218) | (1 << 0)),
+		       reg_base + 0x218);
 	iounmap(reg_base);
+#endif
 
 	reg_base = ioremap(MT6797_IDVFS_BASE_ADDR, 0x1000);	/* 0x102224a0 */
 	temp = readl(reg_base + 0x4a0); /* dummy read */
 	iounmap(reg_base);
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	mt6797_a72_obs_lifecycle(cpu, MT6797_A72_PHASE_PLL_ORDERING_READ,
+				 0, temp, 0x102224a0);
+#endif
 
 	/* latch RESET */
 	mtk_wdt_swsysret_config(MTK_WDT_SWSYS_RST_PWRAP_SPI_CTL_RST, 1);
 
 	if (hotplug) {
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+		da9214_a72_obs_buckb_config(cpu, true,
+					    MT6797_A72_PHASE_BUCK_ENABLE);
+#else
 		BUG_ON(da9214_config_interface(0x0, 0x0, 0xF, 0) < 0);
 		BUG_ON(da9214_config_interface(0x5E, 0x1, 0x1, 0) < 0);
+#endif
 
 		udelay(1000);
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+		da9214_a72_obs_snapshot(cpu,
+					MT6797_A72_PHASE_BUCK_ENABLE_SETTLED);
+#endif
 	}
 
 	/* EXT_BUCK_ISO */
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	if (!mt6797_a72_obs_spm_rmw(cpu,
+				    MT6797_A72_PHASE_SPM_ISOLATION_CLEAR,
+				    0x290, 0x3, 0)) {
+		reg_base = ioremap(MT6797_SPM_BASE_ADDR, 0x1000);
+		writel_relaxed((readl(reg_base + 0x290) & ~(0x3)),
+			       reg_base + 0x290);
+		iounmap(reg_base);
+	}
+#else
 	reg_base = ioremap(MT6797_SPM_BASE_ADDR, 0x1000);
 	writel_relaxed((readl(reg_base + 0x290) & ~(0x3)), reg_base + 0x290);
 	iounmap(reg_base);
+#endif
 
 	/* unlatch RESET */
 	mtk_wdt_swsysret_config(MTK_WDT_SWSYS_RST_PWRAP_SPI_CTL_RST, 0);
@@ -546,8 +602,18 @@ static int cpu_power_on_buck(unsigned int cpu, bool hotplug)
 
 	/* set VSRAM enable, cal_eFuse, rsh = 0x0f -> 0x08 */
 	udelay(240);
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	mt6797_a72_obs_fixed_snapshot(cpu, MT6797_A72_PHASE_SRAM_PRE);
+	smc_ret = BigiDVFSSRAMLDOSet(110000);
+	mt6797_a72_obs_lifecycle(cpu, MT6797_A72_PHASE_SRAM_POST,
+				 smc_ret, 110000, 0);
+#else
 	BigiDVFSSRAMLDOSet(110000);
+#endif
 	udelay(240);
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	mt6797_a72_obs_fixed_snapshot(cpu, MT6797_A72_PHASE_SRAM_POST);
+#endif
 
 	return ret;
 }
@@ -555,11 +621,24 @@ static int cpu_power_on_buck(unsigned int cpu, bool hotplug)
 static int cpu_power_off_buck(unsigned int cpu)
 {
 	int ret = 0;
-
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	int smc_ret;
+
+	mt6797_a72_obs_fixed_snapshot(cpu,
+				      MT6797_A72_PHASE_LAST_A72_OFFLINE);
+	ret = da9214_a72_obs_buckb_config(cpu, false,
+					  MT6797_A72_PHASE_BUCK_DISABLE);
+	smc_ret = BigiDVFSSRAMLDODisable();
+	mt6797_a72_obs_lifecycle(cpu, MT6797_A72_PHASE_OFFLINE_FINAL,
+				 smc_ret, ret, 0);
+	mt6797_a72_obs_fixed_snapshot(cpu,
+				      MT6797_A72_PHASE_OFFLINE_FINAL);
+#else
 	ret = da9214_config_interface(0x0, 0x0, 0xF, 0);
 	ret = da9214_config_interface(0x5E, 0x0, 0x1, 0);
 
 	BigiDVFSSRAMLDODisable();
+#endif
 
 	return ret;
 }
