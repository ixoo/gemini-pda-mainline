 int mtk_wdt_swsysret_config(int bit, int set_value)
 {
 	unsigned int wdt_sys_val;
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	struct mt6797_a72_obs_toprgu snapshot = { };
+	unsigned int observer_cpu = ~0U;
+
+	if (bit == MTK_WDT_SWSYS_RST_PWRAP_SPI_CTL_RST)
+		observer_cpu = mt6797_a72_obs_active_cpu();
+#endif
 
 	spin_lock(&rgu_reg_operation_spinlock);
 	wdt_sys_val = __raw_readl(MTK_WDT_SWSYSRST);
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	if (mt6797_a72_obs_is_cpu(observer_cpu)) {
+		snapshot.before = wdt_sys_val;
+		snapshot.mask = MTK_WDT_SWSYS_RST_PWRAP_SPI_CTL_RST;
+	}
+#endif
 	pr_debug("fwq2 before set wdt_sys_val =%x\n", wdt_sys_val);
 	wdt_sys_val |= MTK_WDT_SWSYS_RST_KEY;
 	switch (bit) {
