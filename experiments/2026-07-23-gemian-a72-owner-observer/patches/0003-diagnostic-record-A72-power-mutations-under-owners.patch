 /*****************************************
  * following is implementation per DCM module.
@@ -988,6 +994,54 @@ int dcm_mcusys_mp2_sync_dcm(ENUM_MCUSYS_DCM on)
 {
 //	dcm_info("%s(%d)\n", __func__, on);
 
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+	struct mt6797_a72_obs_dcm snapshot = {
+		.mask = MCUCFG_SYNC_DCM_MP2_MASK,
+		.on = on == MCUSYS_DCM_ON,
+	};
+	unsigned long flags;
+	unsigned int cpu;
+
+	cpu = mt6797_a72_obs_active_cpu();
+	spin_lock_irqsave(&mt6797_a72_obs_mp2_dcm_lock, flags);
+	snapshot.before = reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG);
+
+	if (on == MCUSYS_DCM_ON) {
+		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
+			  aor(snapshot.before, ~MCUCFG_SYNC_DCM_MP2_MASK,
+			      (MCUCFG_SYNC_DCM_MP2_ON |
+			       MCUCFG_SYNC_DCM_MP2_DIV_SEL4 |
+			       MCUCFG_SYNC_DCM_MP2_TOG1)));
+		snapshot.toggle = reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG);
+
+		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
+			  aor(snapshot.toggle, ~MCUCFG_SYNC_DCM_MP2_MASK,
+			      (MCUCFG_SYNC_DCM_MP2_ON |
+			       MCUCFG_SYNC_DCM_MP2_DIV_SEL4 |
+			       MCUCFG_SYNC_DCM_MP2_TOG0)));
+	} else {
+		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
+			  aor(snapshot.before, ~MCUCFG_SYNC_DCM_MP2_MASK,
+			      (MCUCFG_SYNC_DCM_MP2_OFF |
+			       MCUCFG_SYNC_DCM_MP2_DIV_SEL0 |
+			       MCUCFG_SYNC_DCM_MP2_TOG1)));
+		snapshot.toggle = reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG);
+
+		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
+			  aor(snapshot.toggle, ~MCUCFG_SYNC_DCM_MP2_MASK,
+			      (MCUCFG_SYNC_DCM_MP2_OFF |
+			       MCUCFG_SYNC_DCM_MP2_DIV_SEL0 |
+			       MCUCFG_SYNC_DCM_MP2_TOG0)));
+	}
+	snapshot.final = reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG);
+	spin_unlock_irqrestore(&mt6797_a72_obs_mp2_dcm_lock, flags);
+
+	if (mt6797_a72_obs_is_cpu(cpu))
+		mt6797_a72_obs_dcm(cpu,
+			on == MCUSYS_DCM_ON ? MT6797_A72_PHASE_DCM_ENABLE :
+					     MT6797_A72_PHASE_DCM_DISABLE,
+			&snapshot);
+#else
 	if (on == MCUSYS_DCM_ON) {
 
 		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
@@ -996,7 +1050,6 @@ int dcm_mcusys_mp2_sync_dcm(ENUM_MCUSYS_DCM on)
 				    (MCUCFG_SYNC_DCM_MP2_ON |
 				     MCUCFG_SYNC_DCM_MP2_DIV_SEL4 |
 				     MCUCFG_SYNC_DCM_MP2_TOG1)));
-		/* dcm_info("[0x%x] = 0x%x\n", MCUCFG_SYNC_DCM_MP2_CONFIG, reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG)); */
 
 		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
 				aor(reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG),
@@ -1004,17 +1057,13 @@ int dcm_mcusys_mp2_sync_dcm(ENUM_MCUSYS_DCM on)
 				    (MCUCFG_SYNC_DCM_MP2_ON |
 				     MCUCFG_SYNC_DCM_MP2_DIV_SEL4 |
 				     MCUCFG_SYNC_DCM_MP2_TOG0)));
-		/* dcm_info("[0x%x] = 0x%x\n", MCUCFG_SYNC_DCM_MP2_CONFIG, reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG)); */
 	} else {
-		/* dcm_info("MP2 sync DCM OFF\n"); */
-
 		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
 				aor(reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG),
 				    ~MCUCFG_SYNC_DCM_MP2_MASK,
 				    (MCUCFG_SYNC_DCM_MP2_OFF |
 				     MCUCFG_SYNC_DCM_MP2_DIV_SEL0 |
 				     MCUCFG_SYNC_DCM_MP2_TOG1)));
-		/* dcm_info("[0x%x] = 0x%x\n", MCUCFG_SYNC_DCM_MP2_CONFIG, reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG)); */
 
 		reg_write(MCUCFG_SYNC_DCM_MP2_CONFIG,
 				aor(reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG),
@@ -1022,12 +1071,29 @@ int dcm_mcusys_mp2_sync_dcm(ENUM_MCUSYS_DCM on)
 				    (MCUCFG_SYNC_DCM_MP2_OFF |
 				     MCUCFG_SYNC_DCM_MP2_DIV_SEL0 |
 				     MCUCFG_SYNC_DCM_MP2_TOG0)));
-		/* dcm_info("[0x%x] = 0x%x\n", MCUCFG_SYNC_DCM_MP2_CONFIG, reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG)); */
 	}
+#endif
 
 	return 0;
 }
 
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+void mt6797_a72_obs_dcm_snapshot(unsigned int cpu, u16 phase)
+{
+	struct mt6797_a72_obs_dcm snapshot = {
+		.mask = MCUCFG_SYNC_DCM_MP2_MASK,
+	};
+	unsigned long flags;
+
+	spin_lock_irqsave(&mt6797_a72_obs_mp2_dcm_lock, flags);
+	snapshot.before = reg_read(MCUCFG_SYNC_DCM_MP2_CONFIG);
+	snapshot.toggle = snapshot.before;
+	snapshot.final = snapshot.before;
+	spin_unlock_irqrestore(&mt6797_a72_obs_mp2_dcm_lock, flags);
+	mt6797_a72_obs_dcm(cpu, phase, &snapshot);
+}
+#endif
