+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+static const u32 mt6797_a72_secure_registers[] = {
+	0x10222470, 0x10222498, 0x1022249c, 0x102224a0,
+	0x102224a4, 0x102224ac, 0x102224b0, 0x102224b4,
+	0x102224cc, 0x102222b0, 0x102222b4, 0x10222274,
+};
+
+void mt6797_a72_obs_secure_snapshot(unsigned int cpu, u16 phase)
+{
+	struct mt6797_a72_obs_secure snapshot = { };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mt6797_a72_secure_registers); i++) {
+		snapshot.values[i] = (u32)SEC_BIGIDVFS_READ(
+			mt6797_a72_secure_registers[i]);
+		snapshot.valid |= BIT(i);
+	}
+	snapshot.sentinel_after =
+		(u32)SEC_BIGIDVFS_READ(mt6797_a72_secure_registers[0]);
+	snapshot.stable =
+		snapshot.sentinel_after == snapshot.values[0];
+	mt6797_a72_obs_secure(cpu, phase, &snapshot);
+}
+#endif
