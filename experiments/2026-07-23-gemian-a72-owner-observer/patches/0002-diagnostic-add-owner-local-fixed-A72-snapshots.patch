 }
 EXPORT_SYMBOL(mt_spm_base_get);
 
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+#define MT6797_A72_SPM_PHYS	0x10006000
+
+static const u32 mt6797_a72_spm_offsets[] = {
+	0x180, 0x184, 0x188, 0x18c, 0x218, 0x290,
+};
+
+static void __iomem *mt6797_a72_obs_spm_base(bool *temporary)
+{
+	void __iomem *base = READ_ONCE(spm_base);
+
+	*temporary = false;
+	if (!base) {
+		base = ioremap(MT6797_A72_SPM_PHYS, 0x1000);
+		*temporary = base != NULL;
+	}
+	return base;
+}
+
+void mt6797_a72_obs_spm_snapshot(unsigned int cpu, u16 phase)
+{
+	struct mt6797_a72_obs_spm snapshot = { };
+	void __iomem *base;
+	unsigned long flags;
+	bool temporary;
+	unsigned int i;
+
+	base = mt6797_a72_obs_spm_base(&temporary);
+	if (!base) {
+		mt6797_a72_obs_spm(cpu, phase, &snapshot);
+		return;
+	}
+
+	spin_lock_irqsave(&__spm_lock, flags);
+	for (i = 0; i < ARRAY_SIZE(mt6797_a72_spm_offsets); i++) {
+		snapshot.values[i] =
+			readl_relaxed(base + mt6797_a72_spm_offsets[i]);
+		snapshot.valid |= BIT(i);
+	}
+	spin_unlock_irqrestore(&__spm_lock, flags);
+
+	if (temporary)
+		iounmap(base);
+	mt6797_a72_obs_spm(cpu, phase, &snapshot);
+}
+
+void mt6797_a72_obs_spm_rmw(unsigned int cpu, u16 phase, u32 offset,
+			    u32 mask, u32 value)
+{
+	struct mt6797_a72_obs_mutation mutation = {
+		.address = MT6797_A72_SPM_PHYS + offset,
+		.mask = mask,
+		.requested = value,
+	};
+	void __iomem *base;
+	unsigned long flags;
+	bool temporary;
+
+	base = mt6797_a72_obs_spm_base(&temporary);
+	if (!base) {
+		mutation.status = -ENOMEM;
+		mt6797_a72_obs_mutation(cpu, phase, &mutation);
+		return;
+	}
+
+	spin_lock_irqsave(&__spm_lock, flags);
+	mutation.before = readl_relaxed(base + offset);
+	writel_relaxed((mutation.before & ~mask) | (value & mask),
+		       base + offset);
+	mutation.after = readl_relaxed(base + offset);
+	spin_unlock_irqrestore(&__spm_lock, flags);
+
+	if (temporary)
+		iounmap(base);
+	mt6797_a72_obs_mutation(cpu, phase, &mutation);
+}
+#endif
