 /* Other global variable           */
@@ -412,6 +415,65 @@ void mt6797_0x1001AXXX_unlock(void)
 	spin_unlock(&g_mt6797_0x1001AXXX_lock);
 }
 
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+#define MT6797_A72_CLOCK_PLL_CON1	0x224
+#define MT6797_A72_CLOCK_MUXSEL		0x270
+#define MT6797_A72_CLOCK_CKDIV		0x274
+
+void mt6797_a72_obs_clock_snapshot(unsigned int cpu, u16 phase)
+{
+	struct mt6797_a72_obs_clock snapshot = { .status = -ENODEV };
+	unsigned long flags;
+	unsigned int i;
+	bool acquired = false;
+
+	if (!spin_trylock_irqsave(&g_mt6797_0x1001AXXX_lock, flags)) {
+		snapshot.status = -EBUSY;
+		mt6797_a72_obs_clock(cpu, phase, &snapshot);
+		return;
+	}
+	snapshot.semaphore |= BIT(2);
+
+	if (!g_mcumixed_base || !g_reg_sema3_m0 ||
+	    !g_reg_cspm_poweron_en)
+		goto out;
+	snapshot.semaphore |= BIT(3);
+
+	hs_write32(g_reg_cspm_poweron_en, 0x0b160001);
+	for (i = 0; i < DIV_ROUND_UP(SEMA_GET_TIMEOUT, 10); i++) {
+		hs_write32(g_reg_sema3_m0, 0x1);
+		if (hs_read32(g_reg_sema3_m0) & 0x1) {
+			acquired = true;
+			break;
+		}
+		udelay(10);
+	}
+	if (!acquired) {
+		snapshot.status = -ETIMEDOUT;
+		goto out;
+	}
+	snapshot.semaphore |= BIT(0);
+
+	ndelay(200);
+	snapshot.pll_con1 = readl(g_mcumixed_base +
+					 MT6797_A72_CLOCK_PLL_CON1);
+	snapshot.muxsel = readl(g_mcumixed_base +
+				       MT6797_A72_CLOCK_MUXSEL);
+	snapshot.ckdiv = readl(g_mcumixed_base +
+				      MT6797_A72_CLOCK_CKDIV);
+	snapshot.status = 0;
+
+	hs_write32(g_reg_sema3_m0, 0x1);
+	if (!(hs_read32(g_reg_sema3_m0) & 0x1))
+		snapshot.semaphore |= BIT(1);
+	else
+		snapshot.status = -EIO;
+out:
+	spin_unlock_irqrestore(&g_mt6797_0x1001AXXX_lock, flags);
+	mt6797_a72_obs_clock(cpu, phase, &snapshot);
+}
+#endif
