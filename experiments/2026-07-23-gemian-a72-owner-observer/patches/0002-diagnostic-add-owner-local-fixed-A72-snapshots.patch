diff --git a/drivers/misc/mediatek/power/mt6797/da9214.c b/drivers/misc/mediatek/power/mt6797/da9214.c
index 05b3d63f..db897e56 100644
--- a/drivers/misc/mediatek/power/mt6797/da9214.c
+++ b/drivers/misc/mediatek/power/mt6797/da9214.c
@@ -25,6 +25,10 @@
 #include <asm/atomic.h>
 #include <linux/module.h>
 
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+#include <linux/mt6797_a72_transition_observer.h>
+#endif
+
 #include "da9214.h"
 
 #define PMIC_DEBUG_PR_DBG
@@ -285,6 +289,241 @@ unsigned int da9214_write_byte(unsigned char cmd, unsigned char writeData)
 	return ret == xfers ? 1 : -1;
 }
 #endif
+
+#ifdef CONFIG_MTK_A72_TRANSITION_OBSERVER
+#define DA9214_A72_VALID_PAGE_BEFORE	BIT(0)
+#define DA9214_A72_VALID_PAGE_SELECTED	BIT(1)
+#define DA9214_A72_VALID_BUCK_BEFORE	BIT(2)
+#define DA9214_A72_VALID_BUCK_AFTER	BIT(3)
+#define DA9214_A72_VALID_VSEL		BIT(4)
+#define DA9214_A72_VALID_PAGE_RESTORE	BIT(5)
+#define DA9214_A72_VALID_PAGE_VERIFY	BIT(6)
+
+#define DA9214_A72_REG_PAGE		0x00
+#define DA9214_A72_REG_BUCKB		0x5e
+#define DA9214_A72_REG_BUCKB_VSEL	0xd9
+#define DA9214_A72_PAGE_MASK		0x0f
+#define DA9214_A72_PAGE_REVERT		0x80
+
+/*
+ * These helpers are used only while da9214_i2c_access is held.  They mirror
+ * the existing byte transaction exactly but do not acquire the mutex again.
+ */
+static int da9214_a72_read_locked(unsigned char cmd, unsigned char *value)
+{
+#ifdef CONFIG_MTK_I2C_EXTENSION
+	char cmd_buf[1] = { cmd };
+	int ret;
+
+	new_client->ext_flag =
+		((new_client->ext_flag) & I2C_MASK_FLAG) | I2C_WR_FLAG |
+		I2C_PUSHPULL_FLAG | I2C_HS_FLAG;
+	new_client->timing = 3400;
+	ret = i2c_master_send(new_client, cmd_buf, (1 << 8 | 1));
+	new_client->ext_flag = 0;
+	if (ret < 0)
+		return ret;
+	*value = cmd_buf[0];
+	return 1;
+#else
+	struct i2c_msg msgs[2] = {
+		{
+			.addr = new_client->addr,
+			.flags = 0,
+			.len = 1,
+			.buf = &cmd,
+		}, {
+			.addr = new_client->addr,
+			.flags = I2C_M_RD,
+			.len = 1,
+			.buf = value,
+		}
+	};
+	int ret;
+
+	ret = i2c_transfer(new_client->adapter, msgs, 2);
+	return ret == 2 ? 1 : -1;
+#endif
+}
+
+static int da9214_a72_write_locked(unsigned char cmd, unsigned char value)
+{
+#ifdef CONFIG_MTK_I2C_EXTENSION
+	char data[2] = { cmd, value };
+	int ret;
+
+	new_client->ext_flag =
+		((new_client->ext_flag) & I2C_MASK_FLAG) |
+		I2C_DIRECTION_FLAG | I2C_PUSHPULL_FLAG | I2C_HS_FLAG;
+	new_client->timing = 3400;
+	ret = i2c_master_send(new_client, data, 2);
+	new_client->ext_flag = 0;
+	return ret < 0 ? ret : 1;
+#else
+	unsigned char data[2] = { cmd, value };
+	struct i2c_msg msg = {
+		.addr = new_client->addr,
+		.flags = 0,
+		.len = 2,
+		.buf = data,
+	};
+	int ret;
+
+	ret = i2c_transfer(new_client->adapter, &msg, 1);
+	return ret == 1 ? 1 : -1;
+#endif
+}
+
+static int da9214_a72_config_locked(unsigned char reg, unsigned char value,
+				    unsigned char mask, unsigned char shift)
+{
+	unsigned char old = 0;
+	int ret;
+
+	ret = da9214_a72_read_locked(reg, &old);
+	old &= ~(mask << shift);
+	old |= value << shift;
+	ret = da9214_a72_write_locked(reg, old);
+	return ret;
+}
+
+int da9214_a72_obs_snapshot(unsigned int cpu, u16 phase)
+{
+	struct mt6797_a72_obs_da9214 snapshot = { };
+	unsigned char selected = 0;
+	int ret;
+
+	if (!new_client) {
+		snapshot.status = -ENODEV;
+		mt6797_a72_obs_da9214(cpu, phase, &snapshot);
+		return -ENODEV;
+	}
+
+	mutex_lock(&da9214_i2c_access);
+	ret = da9214_a72_read_locked(DA9214_A72_REG_PAGE,
+				     &snapshot.page_before);
+	if (ret < 0)
+		goto out;
+	snapshot.valid |= DA9214_A72_VALID_PAGE_BEFORE;
+
+	selected = snapshot.page_before & ~DA9214_A72_PAGE_MASK;
+	snapshot.page_selected = selected;
+	if (selected != snapshot.page_before) {
+		ret = da9214_a72_write_locked(DA9214_A72_REG_PAGE, selected);
+		if (ret < 0)
+			goto restore;
+	}
+	snapshot.valid |= DA9214_A72_VALID_PAGE_SELECTED;
+
+	ret = da9214_a72_read_locked(DA9214_A72_REG_BUCKB,
+				     &snapshot.buck_enable_before);
+	if (ret < 0)
+		goto restore;
+	snapshot.buck_enable_after = snapshot.buck_enable_before;
+	snapshot.valid |= DA9214_A72_VALID_BUCK_BEFORE |
+			  DA9214_A72_VALID_BUCK_AFTER;
+
+	ret = da9214_a72_read_locked(DA9214_A72_REG_BUCKB_VSEL,
+				     &snapshot.buck_vsel);
+	if (ret < 0)
+		goto restore;
+	snapshot.valid |= DA9214_A72_VALID_VSEL;
+
+restore:
+	if (selected != snapshot.page_before) {
+		int restore_ret;
+
+		restore_ret = da9214_a72_write_locked(DA9214_A72_REG_PAGE,
+						      snapshot.page_before);
+		if (restore_ret >= 0)
+			snapshot.valid |= DA9214_A72_VALID_PAGE_RESTORE;
+		if (ret >= 0)
+			ret = restore_ret;
+	}
+
+	/*
+	 * PAGE_REVERT can change PAGE_CON as a side effect of the verifying
+	 * access itself.  Record an accepted restore write but do not issue a
+	 * misleading verify-read when that mode was originally selected.
+	 */
+	if (!(snapshot.page_before & DA9214_A72_PAGE_REVERT) && ret >= 0) {
+		ret = da9214_a72_read_locked(DA9214_A72_REG_PAGE,
+					     &snapshot.page_after);
+		if (ret >= 0)
+			snapshot.valid |= DA9214_A72_VALID_PAGE_VERIFY;
+	} else {
+		snapshot.page_after = snapshot.page_before;
+	}
+out:
+	mutex_unlock(&da9214_i2c_access);
+	snapshot.status = ret < 0 ? ret : 0;
+	mt6797_a72_obs_da9214(cpu, phase, &snapshot);
+	return snapshot.status;
+}
+
+unsigned int da9214_a72_obs_buckb_config(unsigned int cpu, bool enable,
+					 u16 phase)
+{
+	struct mt6797_a72_obs_da9214 snapshot = { };
+	unsigned int mutation_ret = (unsigned int)-1;
+	unsigned char page = 0;
+	unsigned char buck = 0;
+	int ret;
+
+	if (!new_client) {
+		snapshot.status = -ENODEV;
+		mt6797_a72_obs_da9214(cpu, phase, &snapshot);
+		return mutation_ret;
+	}
+
+	mutex_lock(&da9214_i2c_access);
+	ret = da9214_a72_read_locked(DA9214_A72_REG_PAGE, &page);
+	if (ret >= 0) {
+		snapshot.page_before = page;
+		snapshot.valid |= DA9214_A72_VALID_PAGE_BEFORE;
+	}
+
+	/*
+	 * Preserve the vendor mutation order: select page zero first, then
+	 * update BUCKB enable.  Unlike a pure snapshot this intentionally
+	 * leaves the selector in the same page-zero state as the old path.
+	 */
+	ret = da9214_a72_config_locked(DA9214_A72_REG_PAGE, 0,
+				       DA9214_A72_PAGE_MASK, 0);
+	if (ret >= 0) {
+		snapshot.page_selected = page & ~DA9214_A72_PAGE_MASK;
+		snapshot.valid |= DA9214_A72_VALID_PAGE_SELECTED;
+	}
+
+	ret = da9214_a72_read_locked(DA9214_A72_REG_BUCKB, &buck);
+	if (ret >= 0) {
+		snapshot.buck_enable_before = buck;
+		snapshot.valid |= DA9214_A72_VALID_BUCK_BEFORE;
+	}
+
+	mutation_ret = da9214_a72_config_locked(DA9214_A72_REG_BUCKB,
+						enable ? 1 : 0, 1, 0);
+	ret = da9214_a72_read_locked(DA9214_A72_REG_BUCKB, &buck);
+	if (ret >= 0) {
+		snapshot.buck_enable_after = buck;
+		snapshot.valid |= DA9214_A72_VALID_BUCK_AFTER;
+	}
+	ret = da9214_a72_read_locked(DA9214_A72_REG_BUCKB_VSEL,
+				     &snapshot.buck_vsel);
+	if (ret >= 0)
+		snapshot.valid |= DA9214_A72_VALID_VSEL;
+	ret = da9214_a72_read_locked(DA9214_A72_REG_PAGE,
+				     &snapshot.page_after);
+	if (ret >= 0)
+		snapshot.valid |= DA9214_A72_VALID_PAGE_VERIFY;
+	mutex_unlock(&da9214_i2c_access);
+
+	snapshot.status = (int)mutation_ret < 0 ? (int)mutation_ret : 0;
+	mt6797_a72_obs_da9214(cpu, phase, &snapshot);
+	return mutation_ret;
+}
+#endif
+
 /*
  *   [Read / Write Function]
  */
