#!/bin/busybox sh
# shellcheck shell=dash

export PATH=/bin
readonly MARKER='GEMINI_KEYBOARD_MANUAL_REBOOT_20260719_X'

# /dev/null is unavailable before devtmpfs. Keep this first mount unredirected.
if ! mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev; then
	printf '%s devtmpfs=failed; STATIC HOLD\n' "$MARKER"
	while :; do
		sleep 3600
	done
fi

procfs_status=failed
sysfs_status=failed
if mount -t proc -o ro,nosuid,nodev,noexec proc /proc 2>/dev/null; then
	procfs_status=mounted
fi
if mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /sys 2>/dev/null; then
	sysfs_status=mounted
fi

: >/run/x-status
/bin/x-record 'entry profile=keyboard-wrrd-manual-reboot cpu_policy=maxcpus-1'
/bin/x-record "procfs=$procfs_status sysfs=$sysfs_status marker_path=kmsg-console-ramoops"
if [ "$sysfs_status" != mounted ]; then
	/bin/x-record 'diagnostic=invalid reason=sysfs-unavailable; STATIC HOLD'
	while :; do
		sleep 3600
	done
fi

online=unavailable
if [ -r /sys/devices/system/cpu/online ]; then
	online="$(cat /sys/devices/system/cpu/online 2>/dev/null || true)"
fi
/bin/x-record "cpu_online=${online:-unavailable} storage_access=none runtime_networking=none"

# Probe discovery starts independently of the shell. Candidate X deliberately
# starts no watchdog worker and never opens or pings a watchdog device.
/bin/x-probe &
/bin/x-record 'services=launched probe=independent tty1_shell=supervised watchdog_userspace=not-started manual_reboot=typed-only'

exec /bin/busybox init
