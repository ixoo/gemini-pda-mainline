diff --git a/src/mm21.c b/src/mm21.c
new file mode 100644
index 0000000..a78b120
--- /dev/null
+++ b/src/mm21.c
@@ -0,0 +1,65 @@
+/*
+ * MediaTek MM21 block layout to linear NV12, on the CPU.
+ *
+ * Each tile is read front to back in one pass, so the source - often an
+ * uncached decoder buffer - is streamed sequentially, while the 16-byte
+ * row stores land in at most 32 destination lines that stay in the cache.
+ * Each 16-byte row copy compiles to one paired load and store.
+ *
+ * Copyright (C) 2026 Julien Etienne <julien.etienne@gmail.com>
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include <stddef.h>
+#include <string.h>
+
+#include "mm21.h"
+
+static inline __attribute__((always_inline)) void
+detile_plane(uint8_t *dst, uint32_t dst_pitch, const uint8_t *src,
+	     uint32_t src_pitch, uint32_t width, uint32_t rows,
+	     const unsigned int tile_h)
+{
+	const size_t tile_size = 16 * tile_h;
+	const size_t tile_row_size = (size_t)src_pitch * tile_h;
+	uint32_t cols = (width + 15) / 16;
+
+	if (cols > src_pitch / 16)
+		cols = src_pitch / 16;
+
+	for (uint32_t y = 0; y < rows; y += tile_h) {
+		const uint8_t *s = src + (size_t)(y / tile_h) * tile_row_size;
+		uint8_t *d = dst + (size_t)y * dst_pitch;
+
+		if (rows - y >= tile_h) {
+			for (uint32_t x = 0; x < cols; x++) {
+				const uint8_t *t = s + x * tile_size;
+				uint8_t *o = d + x * 16;
+
+				for (unsigned int r = 0; r < tile_h; r++)
+					memcpy(o + (size_t)r * dst_pitch,
+					       t + r * 16, 16);
+			}
+		} else {
+			/* Partial last tile row. */
+			for (uint32_t x = 0; x < cols; x++) {
+				const uint8_t *t = s + x * tile_size;
+				uint8_t *o = d + x * 16;
+
+				for (unsigned int r = 0; r < rows - y; r++)
+					memcpy(o + (size_t)r * dst_pitch,
+					       t + r * 16, 16);
+			}
+		}
+	}
+}
+
+void v4l2r_mm21_detile(uint8_t *dst_y, uint8_t *dst_uv, uint32_t dst_pitch,
+		       const uint8_t *src_y, const uint8_t *src_uv,
+		       uint32_t src_pitch, uint32_t width, uint32_t height)
+{
+	detile_plane(dst_y, dst_pitch, src_y, src_pitch, width, height, 32);
+	detile_plane(dst_uv, dst_pitch, src_uv, src_pitch, width,
+		     (height + 1) / 2, 16);
+}
diff --git a/src/mm21.h b/src/mm21.h
new file mode 100644
index 0000000..51e1f09
--- /dev/null
+++ b/src/mm21.h
@@ -0,0 +1,31 @@
+/*
+ * MediaTek MM21 block layout to linear NV12, on the CPU.
+ *
+ * Copyright (C) 2026 Julien Etienne <julien.etienne@gmail.com>
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#ifndef V4L2_REQUEST_MM21_H
+#define V4L2_REQUEST_MM21_H
+
+#include <stdint.h>
+
+/*
+ * Detile one MM21 frame into linear NV12.
+ *
+ * MM21 has two planes with the same line pitch (src_pitch, a multiple of
+ * 16). The luma plane is a raster of 16x32 tiles (512 bytes each, 16-byte
+ * rows); the interleaved CbCr plane is a raster of 16x16 tiles (256 bytes).
+ * The luma plane must hold height rows rounded up to 32, the chroma plane
+ * height / 2 rows rounded up to 16.
+ *
+ * width is the number of bytes per row to produce (rounded up to whole
+ * 16-byte tile columns, so dst_pitch must be at least that), height the
+ * number of luma rows. dst_y and dst_uv may point into the same buffer.
+ */
+void v4l2r_mm21_detile(uint8_t *dst_y, uint8_t *dst_uv, uint32_t dst_pitch,
+		       const uint8_t *src_y, const uint8_t *src_uv,
+		       uint32_t src_pitch, uint32_t width, uint32_t height);
+
+#endif /* V4L2_REQUEST_MM21_H */
diff --git a/src/surface.c b/src/surface.c
index f7fe03d..283cc37 100644
--- a/src/surface.c
+++ b/src/surface.c
@@ -18,6 +18,7 @@
 #include <sys/mman.h>
 #include <unistd.h>
 
+#include <linux/dma-heap.h>
 #include <linux/videodev2.h>
 
 #include <drm_fourcc.h>
@@ -445,6 +446,57 @@ next:
 	return VA_STATUS_ERROR_OPERATION_FAILED;
 }
 
+/*
+ * Linear NV12 backing from the system dma-buf heap, for decoders that cannot
+ * produce NV12 themselves (MediaTek MM21). The chroma plane follows height
+ * luma rows of pitch bytes in the same buffer.
+ */
+static VAStatus backing_alloc_heap(struct v4l2r_surface *surface,
+				   uint32_t width, uint32_t height,
+				   uint32_t pitch)
+{
+	struct v4l2r_surface_backing *backing;
+	struct dma_heap_allocation_data data = {
+		.len = (uint64_t)pitch * height + (uint64_t)pitch * (height / 2),
+		.fd_flags = O_RDWR | O_CLOEXEC,
+	};
+	int heap;
+
+	heap = open("/dev/dma_heap/system", O_RDONLY | O_CLOEXEC);
+	if (heap < 0) {
+		v4l2r_log("cannot open /dev/dma_heap/system: %s\n",
+			  strerror(errno));
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	}
+
+	if (ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &data) < 0) {
+		v4l2r_log("dma-buf heap allocation of %llu bytes failed: %s\n",
+			  (unsigned long long)data.len, strerror(errno));
+		close(heap);
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	}
+	close(heap);
+
+	backing = calloc(1, sizeof(*backing));
+	if (!backing) {
+		close(data.fd);
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	}
+	for (unsigned int i = 0; i < VIDEO_MAX_PLANES; i++)
+		backing->dmabuf_fd[i] = -1;
+
+	backing->pixelformat = V4L2_PIX_FMT_NV12;
+	backing->width = width;
+	backing->height = height;
+	backing->pitch = pitch;
+	backing->nb_planes = 1;
+	backing->plane_size[0] = data.len;
+	backing->dmabuf_fd[0] = data.fd;
+
+	surface->backing = backing;
+	return VA_STATUS_SUCCESS;
+}
