 	convert_reap(ctx, false);
 
 	/* All slots busy: wait one out. */
@@ -335,6 +500,18 @@ void v4l2r_convert_drain_index(struct v4l2r_context *ctx, int capture_index)
 		return;
 
 	pthread_mutex_lock(&ctx->mutex);
+
+	/* Software: nothing in flight. A frame about to be overwritten that
+	 * nobody read needs no conversion anymore. */
+	if (conv->software) {
+		if (capture_index >= 0 && capture_index < (int)ctx->nb_captures &&
+		    ctx->captures[capture_index].surface)
+			ctx->captures[capture_index].surface->convert_pending =
+				false;
+		pthread_mutex_unlock(&ctx->mutex);
+		return;
+	}
+
 	while (in_flight) {
 		in_flight = false;
 		for (unsigned int i = 0; i < V4L2R_CONVERT_SLOTS; i++) {
@@ -360,6 +537,19 @@ VAStatus v4l2r_convert_wait(struct v4l2r_surface *surface)
 		return VA_STATUS_SUCCESS;
 
 	pthread_mutex_lock(&ctx->mutex);
+
+	if (ctx->conv->software) {
+		if (surface->convert_pending &&
+		    surface->capture_index >= 0) {
+			status = convert_software(ctx, surface);
+			if (status != VA_STATUS_SUCCESS)
+				v4l2r_log("MM21 conversion failed\n");
+		}
+		surface->convert_pending = false;
+		pthread_mutex_unlock(&ctx->mutex);
+		return status;
+	}
+
 	while (surface->convert_pending) {
 		if (convert_reap(ctx, true) < 0) {
 			v4l2r_log("failed waiting for format conversion\n");
