+/*
+ * --- software converter (MediaTek MM21) ---
+ *
+ * The conversion runs on the first read of the surface: v4l2r_convert_kick()
+ * only marks the surface, and v4l2r_convert_wait() - reached through
+ * v4l2r_surface_ready() from vaSyncSurface, vaExportSurfaceHandle,
+ * vaDeriveImage and vaGetImage - detiles it. vaEndPicture() also waits for
+ * the surface (see v4l2r_EndPicture): some clients (Chromium) export each
+ * surface once and never sync it again, so the backing must be current when
+ * vaEndPicture returns. A frame overwritten before anyone read it is simply
+ * not converted.
+ *
+ * The backing is linear NV12 at the decoder's padded size (whole tiles),
+ * with the line pitch aligned to 64 bytes and the chroma plane right after
+ * the luma rows of the backing. Consumers crop to the visible size as with
+ * any other decoder's padded CAPTURE buffers.
+ */
+
+static VAStatus convert_setup_software(struct v4l2r_context *ctx)
+{
+	const struct v4l2_pix_format_mplane *src = &ctx->capture_format.fmt.pix_mp;
+	struct v4l2_pix_format_mplane *dst;
+	struct v4l2r_convert *conv;
+	uint32_t src_pitch, height, pitch;
+
+	if (!V4L2_TYPE_IS_MULTIPLANAR(ctx->capture_format.type) ||
+	    src->num_planes != 2)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	src_pitch = src->plane_fmt[0].bytesperline;
+	if (!src_pitch || src_pitch % 16 ||
+	    src->plane_fmt[1].bytesperline != src_pitch)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	/* Padded height: whole 32-line luma tiles. */
+	height = src->plane_fmt[0].sizeimage / src_pitch;
+	height -= height % 32;
+	if (height < src->height ||
+	    src->plane_fmt[1].sizeimage < src_pitch * (height / 2))
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	pitch = (src_pitch + 63) & ~63u;
+
+	conv = calloc(1, sizeof(*conv));
+	if (!conv)
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+
+	conv->fd = -1;
+	conv->software = true;
+	conv->output_format = ctx->capture_format;
+	conv->capture_format = (struct v4l2_format) {
+		.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+	};
+	dst = &conv->capture_format.fmt.pix_mp;
+	dst->pixelformat = V4L2_PIX_FMT_NV12;
+	dst->width = src_pitch;
+	dst->height = height;
+	dst->num_planes = 1;
+	dst->plane_fmt[0].bytesperline = pitch;
+	dst->plane_fmt[0].sizeimage = pitch * height + pitch * (height / 2);
+	for (unsigned int i = 0; i < V4L2R_CONVERT_SLOTS; i++)
+		conv->jobs[i].capture_index = -1;
+
+	ctx->conv = conv;
+
+	v4l2r_log("converting MM21 to NV12 on the CPU (%ux%u, pitch %u)\n",
+		  dst->width, dst->height, pitch);
+
+	return VA_STATUS_SUCCESS;
+}
+
+static void dmabuf_sync(int fd, uint64_t flags)
+{
+	struct dma_buf_sync sync = {
+		.flags = flags,
+	};
+
+	if (fd < 0)
+		return;
+
+	while (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) < 0 &&
+	       (errno == EINTR || errno == EAGAIN))
+		continue;
+}
+
+/* Detile the surface's decoded CAPTURE buffer into its NV12 backing.
+ * ctx->mutex must be held. */
+static VAStatus convert_software(struct v4l2r_context *ctx,
+				 struct v4l2r_surface *surface)
+{
+	const struct v4l2_pix_format_mplane *dst =
+		&ctx->conv->capture_format.fmt.pix_mp;
+	struct v4l2r_surface_backing *backing;
+	struct v4l2r_frame_view src;
+	uint32_t rows;
+	uint64_t t0;
+
+	if (v4l2r_surface_convert_backing(ctx->drv, surface) !=
+	    VA_STATUS_SUCCESS)
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	backing = surface->backing;
+
+	if (v4l2r_surface_capture_view(surface, true, &src) !=
+	    VA_STATUS_SUCCESS || src.nb_planes != 2)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	if (!backing->map[0]) {
+		void *addr = mmap(NULL, backing->plane_size[0],
+				  PROT_READ | PROT_WRITE, MAP_SHARED,
+				  backing->dmabuf_fd[0], 0);
+		if (addr == MAP_FAILED)
+			return VA_STATUS_ERROR_OPERATION_FAILED;
+		backing->map[0] = addr;
+	}
+
+	rows = dst->height < backing->height ? dst->height : backing->height;
+
+	t0 = v4l2r_now_ns();
+
+	/* The write sync also waits for readers of the previous frame (a GPU
+	 * still sampling the backing) through the dma-buf fences. */
+	dmabuf_sync(src.dmabuf_fd[0], DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+	dmabuf_sync(src.dmabuf_fd[1], DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+	dmabuf_sync(backing->dmabuf_fd[0],
+		    DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE);
+
+	v4l2r_mm21_detile(backing->map[0],
+			  (uint8_t *)backing->map[0] +
+			  (size_t)backing->pitch * backing->height,
+			  backing->pitch, src.map[0], src.map[1], src.pitch,
+			  dst->width, rows);
+
+	dmabuf_sync(backing->dmabuf_fd[0],
+		    DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE);
+	dmabuf_sync(src.dmabuf_fd[1], DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+	dmabuf_sync(src.dmabuf_fd[0], DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+
+	v4l2r_trace("detile (surface 0x%08x buf #%d): %.2f ms\n", surface->id,
+		    surface->capture_index, (v4l2r_now_ns() - t0) / 1e6);
+
+	return VA_STATUS_SUCCESS;
+}
+
 VAStatus v4l2r_convert_setup(struct v4l2r_context *ctx)
 {
 	struct v4l2r_driver *drv = ctx->drv;
@@ -52,6 +203,13 @@ VAStatus v4l2r_convert_setup(struct v4l2r_context *ctx)
 	uint32_t width = v4l2r_format_width(&ctx->capture_format);
 	uint32_t height = v4l2r_format_height(&ctx->capture_format);
 
