#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=905fb7f5ead29cbe65eaf7f66e41433aea417c2ee15d751ebda6ddf79f19ad8e
readonly MTK_WDT_SHA256=4019382de687cb3167c57941610db7b02f8fe457c0d665b0dfdc1681f62bf387
readonly MTK_SOC_KCONFIG_SHA256=84afa801aeedaeacf00b432e6b13ba2ffdf437dbd716adea20d6890a20251b91
readonly MTK_SOC_MAKEFILE_SHA256=32bb8f64506de4f2f3c26e4ee472797c6b13a900e8bc02d2527f6b7b45de8971
readonly MT6797_DTSI_SHA256=def954c8455b8f6937a1fe71cac0cfcc44f5b322dbebfbcc9cf7fe73b5eaa9d6
readonly GEMINI_DTS_SHA256=d04c4e951010d2ac6bd7babb90cc2c824d75fe8afc6dc0c7277ae4a06e63f13d

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3 ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" && ! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
experiment_dir="$(cd -- "$script_dir/.." && pwd -P)"
repository_dir="$(cd -- "$experiment_dir/../.." && pwd -P)"
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root" |
	grep -E '^source_tree_integrity=[0-9a-f]{64}$' >/dev/null ||
	die 'prepared source integrity verification failed'

check_file() {
	local expected=$1
	local relative=$2
	printf '%s  %s\n' "$expected" "$source_root/$relative" |
		sha256sum --check --status || die "parent source changed: $relative"
}
check_file "$MTK_WDT_SHA256" drivers/watchdog/mtk_wdt.c
check_file "$MTK_SOC_KCONFIG_SHA256" drivers/soc/mediatek/Kconfig
check_file "$MTK_SOC_MAKEFILE_SHA256" drivers/soc/mediatek/Makefile
check_file "$MT6797_DTSI_SHA256" arch/arm64/boot/dts/mediatek/mt6797.dtsi
check_file "$GEMINI_DTS_SHA256" arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
for relative in \
  drivers/soc/mediatek/mt6797-a72-platform-state.c \
  include/linux/soc/mediatek/mt6797-a72-platform-state.h \
  Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-state.yaml; do
	[[ ! -e "$source_root/$relative" ]] || die "new path already exists: $relative"
done

readonly work_root=/workspace/gemini-pda/mt6797-a72-platform-state-work
readonly package="$output_root/mt6797-a72-platform-state-patches-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'

if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated MT6797 A72 platform-state patch review at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work="$(mktemp -d "$work_root/generation.XXXXXX")"
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] || rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] || rm -rf -- "$partial"
}
trap cleanup EXIT

for relative in \
  drivers/watchdog/mtk_wdt.c \
  drivers/soc/mediatek/Kconfig \
  drivers/soc/mediatek/Makefile \
  arch/arm64/boot/dts/mediatek/mt6797.dtsi \
  arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts; do
	mkdir -p "$work/source/$(dirname "$relative")"
	cp -- "$source_root/$relative" "$work/source/$relative"
done
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- .
GIT_AUTHOR_DATE=2026-08-21T18:00:00Z \
GIT_COMMITTER_DATE=2026-08-21T18:00:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'MT6797 A72 platform-state source parent'
baseline_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly baseline_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --step watchdog
git -C "$work/source" diff --check
git -C "$work/source" add -- drivers/watchdog/mtk_wdt.c
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T18:01:00Z \
GIT_COMMITTER_DATE=2026-08-21T18:01:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'watchdog: mtk: expose locked reset status' \
		-m 'Read WDT_SWSYSRST under the reset controller existing spinlock and expose the logical bit through the standard reset status callback.' \
		-m 'Add no watchdog write, reset action, polling loop, lifecycle caller, CPU operation, boot candidate, or device action.'

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --step platform
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/source"
git -C "$work/source" diff --check
git -C "$work/source" add -- .
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T18:02:00Z \
GIT_COMMITTER_DATE=2026-08-21T18:02:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'soc: mediatek: add MT6797 A72 platform-state source' \
		-m 'Capture two immediate read-only samples of the source-backed SPM, PWRAP reset, MP2 DCM, and MP2 CCI state and publish a typed record only when the A72 fields are stable.' \
		-m 'Keep the DT node disabled and add no polling, register write, A34 caller, lifecycle publication, CPU operation, boot candidate, or device action.'
result_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly result_commit

mkdir -p "$partial/patches" "$partial/provenance"
mapfile -t generated < <(git -C "$work/source" format-patch \
	--no-signature --output-directory "$partial/patches" \
	"${baseline_commit}..${result_commit}")
[[ "${#generated[@]}" -eq 2 ]] || die 'generated patch count changed'
readonly patch_1=0308-watchdog-mtk-expose-locked-reset-status.patch
readonly patch_2=0309-soc-mediatek-add-MT6797-A72-platform-state-source.patch
mv -- "${generated[0]}" "$partial/patches/$patch_1"
mv -- "${generated[1]}" "$partial/patches/$patch_2"
printf '%s\n%s\n' "$patch_1" "$patch_2" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patches.py" \
	--patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$baseline_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date \
	"$partial/patches/$patch_1" "$partial/patches/$patch_2"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$result_commit" ]] ||
	die 'patch replay did not reproduce generated commit'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/verify"
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

for patch in "$patch_1" "$patch_2"; do
	if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
		--ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE \
		"$partial/patches/$patch" >"$partial/provenance/checkpatch-${patch%.patch}.txt"; then
		cat "$partial/provenance/checkpatch-${patch%.patch}.txt" >&2
		die "strict checkpatch rejected $patch"
	fi
done

cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-mt6797-a72-platform-state-source
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
baseline_commit=$baseline_commit
result_commit=$result_commit
generated_patch_count=2
toprgu_status=locked-read-only
platform_samples=2-no-loop
cci_mp2_port_offset=0x6000
cci_global_status_offset=0x000c
hardware_write=none
a34_caller=none
opens_owner=false
cpu_on=false
cpu_off=false
device_action=none
boot_candidate=false
EOF
printf '%s\n%s\n' "$patch_1" "$patch_2" >"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated MT6797 A72 platform-state patch review at %s\n' "$package"
