#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly EXPECTED_REMOTE=https://github.com/ixoo/gemini-pda-mainline.git
readonly EXPECTED_PROFILE=gemini-a72-cpu8-observer-kunit

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 2 ]] || die 'expected PACKAGE_DIR RAW_LOG'
package_dir=$(cd -- "$1" 2>/dev/null && pwd -P) || die 'package absent'
readonly package_dir
raw_log=$2
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
experiment_dir=$(cd -- "$script_dir/.." && pwd -P)
repository_dir=$(cd -- "$experiment_dir/../.." && pwd -P)
readonly script_dir experiment_dir repository_dir
[[ "$raw_log" == /* ]] || raw_log="$repository_dir/$raw_log"
readonly raw_log

for command in git grep jq python3 qemu-system-aarch64 sha256sum timeout; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
readonly build_json="$package_dir/provenance/build.json"
readonly image="$package_dir/Image"
readonly config="$package_dir/kernel.config"
readonly system_map="$package_dir/System.map"
readonly sums="$package_dir/SHA256SUMS"
for file in "$build_json" "$image" "$config" "$system_map" "$sums"; do
	[[ -f "$file" && ! -L "$file" ]] || die "unsafe package file: $file"
done

package_commit=$(jq -er '.repository_commit' "$build_json")
harness_commit=$(git -C "$repository_dir" rev-parse HEAD)
readonly package_commit harness_commit
[[ "$package_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid package commit'
[[ "$harness_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid harness commit'
[[ "$(git -C "$repository_dir" remote get-url origin)" == "$EXPECTED_REMOTE" ]] ||
	die 'unexpected origin URL'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'repository worktree is not clean'
[[ "$(git -C "$repository_dir" rev-parse origin/main)" == "$harness_commit" ]] ||
	die 'harness HEAD is not published at origin/main'
git -C "$repository_dir" merge-base --is-ancestor \
	"$package_commit" "$harness_commit" || die 'package commit is not a harness ancestor'
[[ "$(jq -er '.repository_dirty' "$build_json")" == false ]] ||
	die 'package was built from a dirty repository'
[[ "$(jq -er '.build_profile' "$build_json")" == "$EXPECTED_PROFILE" ]] ||
	die 'unexpected package profile'
[[ "$(jq -er '.target_architecture' "$build_json")" == arm64 ]] ||
	die 'unexpected package architecture'
case "$package_dir" in
	"$repository_dir/artifacts/buildbox/$package_commit/"*) ;;
	*) die 'package is outside the exact ignored Buildbox commit root' ;;
esac
(
	cd "$package_dir"
	sha256sum --check --strict SHA256SUMS >/dev/null
) || die 'package checksum validation failed'

for token in \
	'CONFIG_KUNIT=y' \
	'CONFIG_KUNIT_DEFAULT_ENABLED=y' \
	'CONFIG_KUNIT_AUTORUN_ENABLED=y' \
	'CONFIG_CMDLINE_FORCE=y' \
	'CONFIG_ARM64_MT6797_A72_CPU9_MEMBERSHIP=y' \
	'CONFIG_MTK_MT6797_A72_HOTPLUG_EXECUTOR=y' \
	'CONFIG_MTK_MT6797_A72_CPU8_OBSERVER=y' \
	'CONFIG_MTK_MT6797_A72_CPU8_OBSERVER_KUNIT_TEST=y'; do
	grep -Fx "$token" "$config" >/dev/null ||
		die "configuration missing: $token"
done
focused_test_count=$(grep -Ec '^CONFIG_.*_KUNIT_TEST=y$' "$config")
focused_tests=$(grep -E '^CONFIG_.*_KUNIT_TEST=y$' "$config" | sort)
readonly focused_test_count focused_tests
[[ "$focused_test_count" -eq 1 ]] || die 'KUnit option inventory changed'
[[ "$focused_tests" == \
	'CONFIG_MTK_MT6797_A72_CPU8_OBSERVER_KUNIT_TEST=y' ]] ||
	die 'unexpected KUnit test selected'

for symbol in \
	mt6797_a72_cpu8_observer_init \
	mt6797_a72_cpu8_observer_identity_matches \
	mt6797_a72_cpu8_observer_run_with_ops \
	mt6797_a72_cpu8_observer_run \
	cpu8_observer_suite \
	cpu8_observer_success_test \
	cpu8_observer_cpu_refusal_test \
	cpu8_observer_identity_refusal_test \
	cpu8_observer_dispatch_refusal_test \
	cpu8_observer_timeout_late_callback_test \
	cpu8_observer_one_shot_test \
	cpu8_observer_snapshot_identity_test; do
	grep -q " ${symbol}$" "$system_map" || die "required symbol absent: $symbol"
done
for symbol in \
	mt6797_a72_admission_controller_probe \
	mt6797_a72_hotplug_physical_execute \
	mt6797_a72_physical_source_capture \
	gemini_protected_readback_ledger_checkpoint; do
	! grep -q " ${symbol}$" "$system_map" || die "excluded symbol linked: $symbol"
done

mkdir -p "$repository_dir/artifacts/qemu"
raw_parent=$(cd -- "$(dirname -- "$raw_log")" 2>/dev/null && pwd -P) ||
	die 'raw-log parent absent'
readonly raw_parent
[[ "$raw_parent" == "$repository_dir/artifacts/qemu" ]] ||
	die 'raw log must be directly below ignored artifacts/qemu'
[[ ! -L "$raw_parent" ]] || die 'raw-log parent is a symlink'
[[ "$raw_log" == "$raw_parent/"[a-z0-9._-]*.log ]] || die 'unsafe raw-log name'
[[ ! -e "$raw_log" ]] || die 'refusing to overwrite a raw log'

set +e
timeout --signal=TERM 45 qemu-system-aarch64 \
	-accel tcg,thread=single \
	-machine virt -cpu cortex-a53 -smp 4 -m 1024 \
	-nographic -no-reboot -nic none -kernel "$image" \
	>"$raw_log" 2>&1
qemu_exit=$?
set -e
readonly qemu_exit

PYTHONDONTWRITEBYTECODE=1 python3 \
	"$script_dir/classify-cpu8-observer-kunit.py" \
	--package "$package_dir" \
	--raw-log "$raw_log" \
	--qemu-exit "$qemu_exit" \
	--repository-commit "$package_commit" \
	--harness-commit "$harness_commit"
