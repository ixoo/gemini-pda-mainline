#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_source_state=91b3bdb345c962aa9c1b81d333520bef1e9f687574777ea069814377e4db33f0
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-readback-bitmap-patch"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ "$(<"${source_root}/.gemini-source-state")" == "${expected_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]
cleanup() {
	if [[ -d "${temporary}" && ! -L "${temporary}" ]]; then
		rm -rf -- "${temporary}"
	fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_readback_bitmap_patch.py" \
	--source-root "${source_root}" \
	--repository-commit "${repository_commit}" \
	--output "${temporary}"
(
	cd "${temporary}"
	sha256sum --check --strict SHA256SUMS >/dev/null
	for marker in "repository_commit=${repository_commit}" \
		generated_patch_count=1 mismatch_bits=24 bitmap_format_bit=31 \
		wire_size_changed=false predicate_behavior_changed=false \
		focused_kunit_cases=1 unsafe_mutations_rejected=10 \
		physical_effect_calls=0 native_vm_build=none boot_candidate=false \
		device_action=none; do
		grep -Fx "${marker}" provenance.txt >/dev/null
	done
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 readback bitmap patch at %s\n' "${destination}"
