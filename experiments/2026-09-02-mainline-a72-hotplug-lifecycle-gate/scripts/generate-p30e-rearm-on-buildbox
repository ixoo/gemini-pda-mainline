#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_source_state=abcf68148338da888a861232052528a3881ce33fea4fc257289981b0bebe3450
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-p30e-rearm-patches"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ "$(<"${source_root}/.gemini-source-state")" == "${expected_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]
cleanup() {
	if [[ -d "${temporary}" && ! -L "${temporary}" ]]; then
		rm -rf -- "${temporary}"
	fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_p30e_rearm_patches.py" \
	--source-root "${source_root}" \
	--repository-commit "${repository_commit}" \
	--output "${temporary}"
(
	cd "${temporary}"
	sha256sum --check --strict SHA256SUMS >/dev/null
	for marker in "repository_commit=${repository_commit}" \
		generated_patch_count=2 target_cpu=9 \
		p30e_controller_sequence_after=2 target_claim_changed=false \
		head_S_changed=false primitive_mutations_rejected=14 \
		final_mutations_rejected=25 restore_cpu_on_calls_max=1 \
		rearm_failure_cpu_on_calls=0 retry_calls_added=0 \
		ledger_version=0x00010003 ledger_stages=14,15,16,17,18 \
		successful_ledger_writes_max=649 native_vm_build=none \
		boot_candidate=false device_action=none; do
		grep -Fx "${marker}" provenance.txt >/dev/null
	done
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 P30E rearm patches at %s\n' "${destination}"
