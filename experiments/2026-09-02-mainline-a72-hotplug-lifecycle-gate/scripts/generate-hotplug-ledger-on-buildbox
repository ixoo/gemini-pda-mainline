#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_parent_source_state=5dc7d6e1dad97896ec01271103ca69be53e0d54dbe7bb7600ea91628e8aca9ff
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-hotplug-ledger-patch"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ -f "${source_root}/.gemini-source-state" ]]
prepared_source_state="$(<"${source_root}/.gemini-source-state")"
readonly prepared_source_state
[[ "${prepared_source_state}" == "${expected_parent_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]

cleanup() {
	if [[ -n "${temporary:-}" && -d "${temporary}" && ! -L "${temporary}" ]]; then
		rm -rf -- "${temporary}"
	fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_hotplug_ledger_patch.py" \
	--source-root "${source_root}" \
	--repository-commit "${repository_commit}" \
	--output "${temporary}"
(
	cd "${temporary}"
	sha256sum --check --strict SHA256SUMS >/dev/null
	grep -Fx "repository_commit=${repository_commit}" provenance.txt >/dev/null
	for marker in generated_patch_count=1 record_index=4 \
		record_base=0x44414000 preserved_record_indices=0,1,2,3 \
		wire_copy_words=27 successful_records_max=16 \
		successful_word_writes_max=451 kunit_cases=10 \
		unsafe_mutations_rejected=20 production_callers=0 \
		physical_effect_calls=0 mt6797_cpu_can_disable=false \
		native_vm_build=none boot_candidate=false device_action=none; do
		grep -Fx "${marker}" provenance.txt >/dev/null
	done
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 hotplug-ledger patch at %s\n' "${destination}"
