#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_parent_source_state=5208381d47410281b7b4492beaa1ecb5b19de11fa15889c0f1ce6ffa4a851d69
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-hotplug-owner-patches"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ -f "${source_root}/.gemini-source-state" ]]
prepared_source_state="$(<"${source_root}/.gemini-source-state")"
readonly prepared_source_state
[[ "${prepared_source_state}" == "${expected_parent_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]

cleanup() {
  if [[ -n "${temporary:-}" && -d "${temporary}" && ! -L "${temporary}" ]]; then
    rm -rf -- "${temporary}"
  fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_owner_patches.py" \
  --source-root "${source_root}" \
  --repository-commit "${repository_commit}" \
  --output "${temporary}"
(
  cd "${temporary}"
  sha256sum --check --strict SHA256SUMS >/dev/null
  grep -Fx "repository_commit=${repository_commit}" provenance.txt >/dev/null
  grep -Fx 'generated_patch_count=2' provenance.txt >/dev/null
  grep -Fx 'cpu9_down_attempts=1' provenance.txt >/dev/null
  grep -Fx 'affinity_attempts=1' provenance.txt >/dev/null
  grep -Fx 'cpu9_restore_attempts=1' provenance.txt >/dev/null
  grep -Fx 'precommit_failure=rejected-without-membership-change' provenance.txt >/dev/null
  grep -Fx 'postcommit_failure=reset-only-fault' provenance.txt >/dev/null
  grep -Fx 'restore_identity=distinct-and-parent-linked' provenance.txt >/dev/null
  grep -Fx 'focused_kunit_cases=5' provenance.txt >/dev/null
  grep -Fx 'owner_source_mutation_rejections=20' provenance.txt >/dev/null
  grep -Fx 'mt6797_callbacks=unset' provenance.txt >/dev/null
  grep -Fx 'mt6797_cpu_can_disable=false' provenance.txt >/dev/null
  grep -Fx 'physical_effect_calls=0' provenance.txt >/dev/null
  grep -Fx 'native_vm_build=none' provenance.txt >/dev/null
  grep -Fx 'boot_candidate=false' provenance.txt >/dev/null
  grep -Fx 'device_action=none' provenance.txt >/dev/null
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 hotplug owner patches at %s\n' "${destination}"
