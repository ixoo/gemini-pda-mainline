#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_source_state=95bdf01487ec09a7ed1e99aae0671117798887f16376340efe313e07f218ffc3
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-restore-readiness-patch"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ "$(<"${source_root}/.gemini-source-state")" == "${expected_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]
cleanup() {
	if [[ -d "${temporary}" && ! -L "${temporary}" ]]; then
		rm -rf -- "${temporary}"
	fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_restore_readiness_patch.py" \
	--source-root "${source_root}" \
	--repository-commit "${repository_commit}" \
	--output "${temporary}"
(
	cd "${temporary}"
	sha256sum --check --strict SHA256SUMS >/dev/null
	for marker in "repository_commit=${repository_commit}" \
		generated_patch_count=1 readiness_samples_max=51 \
		readiness_sleeps_max=50 readiness_sleep_us=5000-6000 \
		readiness_source=platform-state-read-only \
		cpu_on_gate=both-CPU9-status-mirrors-clear \
		retained_raw_fields=first-and-last-status-status2-cpu9-pwr-con \
		ledger_version=0x00010002 successful_ledger_writes_max=611 \
		binding_kunit_cases=13 ledger_kunit_cases=14 \
		unsafe_mutations_rejected=13 cpu_off_calls_added=0 \
		cpu_on_calls_added=0 affinity_calls_added=0 retry_calls_added=0 \
		native_vm_build=none boot_candidate=false device_action=none; do
		grep -Fx "${marker}" provenance.txt >/dev/null
	done
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 restore readiness patch at %s\n' "${destination}"
