#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_parent_source_state=cb7d204abbf314d61b8f740cfa8bc6b3878fa8febec00fd7889684db414f2e55
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-cpu8-observer-patch"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ -f "${source_root}/.gemini-source-state" ]]
prepared_source_state="$(<"${source_root}/.gemini-source-state")"
readonly prepared_source_state
[[ "${prepared_source_state}" == "${expected_parent_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]

cleanup() {
	if [[ -n "${temporary:-}" && -d "${temporary}" && ! -L "${temporary}" ]]; then
		rm -rf -- "${temporary}"
	fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_cpu8_observer_patch.py" \
	--source-root "${source_root}" \
	--repository-commit "${repository_commit}" \
	--output "${temporary}"
(
	cd "${temporary}"
	sha256sum --check --strict SHA256SUMS >/dev/null
	grep -Fx "repository_commit=${repository_commit}" provenance.txt >/dev/null
	for marker in generated_patch_count=1 target_cpu=8 \
		dispatch=smp_call_function_single-wait-0 dispatch_calls=1 \
		controller_wait_timeout_ms=250 \
		context_lifetime=binder-owned-one-shot \
		identity=exact-down-off-committed retry_calls=0 \
		synchronous_wait_1_calls=0 focused_kunit_cases=7 \
		unsafe_mutations_rejected=21 production_callers=0 \
		device_tree_nodes=0 runtime_ipis=0 \
		mt6797_cpu_can_disable=false native_vm_build=none \
		boot_candidate=false device_action=none; do
		grep -Fx "${marker}" provenance.txt >/dev/null
	done
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 CPU8-observer patch at %s\n' "${destination}"
