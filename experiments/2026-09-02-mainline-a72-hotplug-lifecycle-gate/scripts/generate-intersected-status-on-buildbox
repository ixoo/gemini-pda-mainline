#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_source_state=d564a365c01cc49fe34419919d4dff00eaa78e5504975fb220a2507f3e27ea59
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-intersected-status-patch"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ "$(<"${source_root}/.gemini-source-state")" == "${expected_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]
cleanup() {
	if [[ -d "${temporary}" && ! -L "${temporary}" ]]; then
		rm -rf -- "${temporary}"
	fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_intersected_status_patch.py" \
	--source-root "${source_root}" \
	--repository-commit "${repository_commit}" \
	--output "${temporary}"
(
	cd "${temporary}"
	sha256sum --check --strict SHA256SUMS >/dev/null
	for marker in "repository_commit=${repository_commit}" \
		generated_patch_count=1 cpu8_status_rule=both-mirrors \
		cpu9_off_status_rule=two-word-intersection-clear \
		raw_bitmap_terms=24-unchanged snapshot_calls=unchanged \
		acceptance_behavior_changed=true focused_kunit_cases=9 \
		unsafe_mutations_rejected=10 physical_effect_calls=0 \
		native_vm_build=none boot_candidate=false device_action=none; do
		grep -Fx "${marker}" provenance.txt >/dev/null
	done
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 intersected status patch at %s\n' "${destination}"
