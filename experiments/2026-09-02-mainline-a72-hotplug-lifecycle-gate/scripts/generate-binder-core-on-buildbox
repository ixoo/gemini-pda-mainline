#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_parent_source_state=febbcbb48905cdba86af117b2774bfcc79d1126ca80620126adaecac2a83ac89
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-hotplug-binder-core-patches"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ -f "${source_root}/.gemini-source-state" ]]
prepared_source_state="$(<"${source_root}/.gemini-source-state")"
readonly prepared_source_state
[[ "${prepared_source_state}" == "${expected_parent_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]

cleanup() {
  if [[ -n "${temporary:-}" && -d "${temporary}" && ! -L "${temporary}" ]]; then
    rm -rf -- "${temporary}"
  fi
}
trap cleanup EXIT

python3 "${script_dir}/generate_binder_core_patches.py" \
  --source-root "${source_root}" \
  --repository-commit "${repository_commit}" \
  --output "${temporary}"
(
  cd "${temporary}"
  sha256sum --check --strict SHA256SUMS >/dev/null
  grep -Fx "repository_commit=${repository_commit}" provenance.txt >/dev/null
  for marker in generated_patch_count=2 target_cpu=9 \
    same_task_required=true ordered_requests=remove9,add9-restore \
    parent_proof_calls=1 ledger_begin_calls=1 \
    checkpoint_stages=1,13,17 remove_cpu_call_sites=1 \
    restore_add_cpu_call_sites=1 focused_kunit_cases=9 \
    unsafe_mutations_rejected=22 production_callers=0 \
    physical_effect_calls=0 native_vm_build=none boot_candidate=false \
    device_action=none; do
    grep -Fx "${marker}" provenance.txt >/dev/null
  done
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated A72 hotplug binder core patches at %s\n' "${destination}"
