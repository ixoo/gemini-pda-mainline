#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_parent_source_state=9d03c2ebbde4792b9db0a136c4a12e95c4343e47fb283f413a4acd7fd6f311c0
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-default-off-binder-patches"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ -f "${source_root}/.gemini-source-state" ]]
prepared_source_state="$(<"${source_root}/.gemini-source-state")"
readonly prepared_source_state
[[ "${prepared_source_state}" == "${expected_parent_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]

cleanup() {
  if [[ -n "${temporary:-}" && -d "${temporary}" && ! -L "${temporary}" ]]; then
    rm -rf -- "${temporary}"
  fi
}
trap cleanup EXIT

python3 "${script_dir}/generate-patches.py" \
  --source-root "${source_root}" \
  --repository-commit "${repository_commit}" \
  --output "${temporary}"
(
  cd "${temporary}"
  sha256sum --check --strict SHA256SUMS >/dev/null
  grep -Fx "repository_commit=${repository_commit}" provenance.txt >/dev/null
  grep -Fx 'generated_patch_count=5' provenance.txt >/dev/null
  grep -Fx 'executor_stages=10' provenance.txt >/dev/null
  grep -Fx 'regular_success_checkpoints=20' provenance.txt >/dev/null
  grep -Fx 'terminal_commits=1' provenance.txt >/dev/null
  grep -Fx 'terminal_failure_contexts=31' provenance.txt >/dev/null
  grep -Fx 'executor_kunit_cases=12' provenance.txt >/dev/null
  grep -Fx 'membership_kunit_cases=4' provenance.txt >/dev/null
  grep -Fx 'binder_kunit_cases=5' provenance.txt >/dev/null
  grep -Fx 'focused_kunit_cases=21' provenance.txt >/dev/null
  grep -Fx 'membership_before_terminal=true' provenance.txt >/dev/null
  grep -Fx 'terminal_before_finalize=true' provenance.txt >/dev/null
  grep -Fx 'cpu_on_call_sites=1' provenance.txt >/dev/null
  grep -Fx 'binder_delegated_cpu_on_calls=1' provenance.txt >/dev/null
  grep -Fx 'cpu_off_call_sites=0' provenance.txt >/dev/null
  grep -Fx 'retry_call_sites=0' provenance.txt >/dev/null
  grep -Fx 'probe_provider_hardware_reads=0' provenance.txt >/dev/null
  grep -Fx 'supplier_device_links=managed-consumer' provenance.txt >/dev/null
  grep -Fx 'binder_publication_serialized=true' provenance.txt >/dev/null
  grep -Fx 'base_dt_enablements=0' provenance.txt >/dev/null
  grep -Fx 'production_cpu_requests=0' provenance.txt >/dev/null
  grep -Fx 'physical_effect_calls=0' provenance.txt >/dev/null
  grep -Fx 'device_action=none' provenance.txt >/dev/null
  grep -Fx 'boot_candidate=false' provenance.txt >/dev/null
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated CPU8 default-off binder patches at %s\n' "${destination}"
