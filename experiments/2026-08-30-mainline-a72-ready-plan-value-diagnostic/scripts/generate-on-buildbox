#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=a5a27faa45863cb4d9b75d83fe416b2962c9b94068726254ac87caed57c41980
readonly PARENT_SOURCE_INTEGRITY=f1b7972ae8ac0acb325c5310d48f8316a36ffa9879cd539267ac4d62ce6d731d
readonly PARENT_PATCH=0438-arm64-report-Gemini-late-CPU-plan-predicates.patch
readonly PARENT_PATCH_SHA256=45c7db03b022325f93d2bac62df6ec13b352878c1c80a083418ed291c56fbd1c
readonly CURRENT_PATCH=0439-arm64-report-Gemini-late-CPU-plan-values.patch

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1 source_root=$2 output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" &&
	! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'
[[ -f "$source_root/.gemini-source-integrity" &&
	! -L "$source_root/.gemini-source-integrity" ]] ||
	die 'prepared source integrity marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity changed'

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
experiment_dir=$(cd -- "$script_dir/.." && pwd -P)
repository_dir=$(cd -- "$experiment_dir/../.." && pwd -P)
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" \
	verify "$source_root")
readonly integrity
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity verification failed'

readonly parent_patch_path="$repository_dir/patches/v7.1.3/$PARENT_PATCH"
printf '%s  %s\n' "$PARENT_PATCH_SHA256" "$parent_patch_path" |
	sha256sum --check --status || die 'canonical parent patch changed'
[[ "$(tail -n 1 "$repository_dir/patches/series")" == "v7.1.3/$PARENT_PATCH" ]] ||
	die 'canonical series parent changed'
[[ ! -e "$repository_dir/patches/v7.1.3/$CURRENT_PATCH" ]] ||
	die 'value-observer patch is already canonical'

readonly package="$output_root/a72-ready-plan-values-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'
if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" "$package/provenance.txt" \
		>/dev/null || die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated A72 READY value observer at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'
cleanup() {
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] ||
		rm -rf -- "$partial"
}
trap cleanup EXIT
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/generate_patch.py" \
	--source-root "$source_root" --repository-commit "$project_commit" \
	--output "$partial"
(cd "$partial" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=1 source_validation=pass \
	validator_return_owner=unchanged-contract value_bitmap_fields=5 \
	value_policy_fields=2 diagnostic_success_logging=none \
	new_cpu_request_paths=0 cpu9_request_paths=0 cpu_off_paths=0 \
	retry_paths=0 hardware_writes=0 unsafe_source_mutations_rejected=7 \
	profile_fragments_changed=0 native_vm_build=none device_action=none \
	boot_candidate=false; do
	grep -Fx "$marker" "$partial/provenance.txt" >/dev/null ||
		die "missing generated marker: $marker"
done
mv -- "$partial" "$package"
trap - EXIT
printf 'Generated A72 READY value observer at %s\n' "$package"
