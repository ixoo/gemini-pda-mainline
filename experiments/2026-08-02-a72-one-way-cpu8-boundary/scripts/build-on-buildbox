readonly -a common_disassembly_symbols=(
  cpu_down
  hps_algo_do_cluster_action
  mt6797_a72_one_way_secondary_complete
)
changed_disassembly_symbols=("${common_disassembly_symbols[@]}")
baseline_disassembly_symbols=("${common_disassembly_symbols[@]}")
if [[ "${build_mode}" == held || "${build_mode}" == late || \
      "${build_mode}" == cpu9 ]]; then
  changed_disassembly_symbols+=(
    mt6797_a72_hold_ipi
    mt6797_a72_hold_workfn
  )
fi
if [[ "${build_mode}" == late || "${build_mode}" == cpu9 ]]; then
  baseline_disassembly_symbols+=(
    mt6797_a72_hold_ipi
    mt6797_a72_hold_workfn
  )
fi
readonly -a changed_disassembly_symbols
readonly -a baseline_disassembly_symbols
"${cross_prefix}objdump" -dr "${output}/vmlinux" | \
  python3 "${held_experiment_dir}/scripts/extract-disassembly.py" \
    --output-dir "${output}/focused-disassembly" \
    "${changed_disassembly_symbols[@]}"
"${cross_prefix}objdump" -dr "${baseline_output}/vmlinux" | \
  python3 "${held_experiment_dir}/scripts/extract-disassembly.py" \
    --output-dir "${baseline_output}/focused-disassembly" \
    "${baseline_disassembly_symbols[@]}"
for symbol in cpu_down hps_algo_do_cluster_action \
  mt6797_a72_one_way_secondary_complete; do
