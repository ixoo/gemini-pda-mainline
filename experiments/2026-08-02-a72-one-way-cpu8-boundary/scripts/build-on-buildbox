import pathlib
import sys

def function(path, name):
    text = pathlib.Path(path).read_text()
    marker = name + "("
    marker_offset = text.index(marker)
    start = text.rfind("\n", 0, marker_offset) + 1
    brace = text.index("{", marker_offset)
    depth = 0
    for offset in range(brace, len(text)):
        if text[offset] == "{":
            depth += 1
        elif text[offset] == "}":
            depth -= 1
            if depth == 0:
                return text[start:offset + 1]
    raise SystemExit("unterminated function: " + name)

for name in (
    "mt6797_a72_cpu9_boot",
    "mt6797_a72_coh_wait_turn",
    "mt6797_a72_coh_ipi",
    "mt6797_a72_ml_wait_turn",
    "mt6797_a72_ml_ipi",
):
    if function(sys.argv[1], name) != function(sys.argv[2], name):
        raise SystemExit("parallel disjoint-load changed inherited function: " + name)
