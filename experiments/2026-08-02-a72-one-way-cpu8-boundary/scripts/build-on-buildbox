  cp "${output}/parallel-stack.txt" \
    "${package_partial}/outputs/parallel-stack.txt"
elif [[ "${build_mode}" == scheduler ]]; then
  cp "${output}/scheduler-stack.txt" \
    "${package_partial}/outputs/scheduler-stack.txt"
elif [[ "${build_mode}" == register ]]; then
  cp "${output}/register-stack.txt" \
    "${package_partial}/outputs/register-stack.txt"
elif [[ "${build_mode}" == pmsg ]]; then
  cp "${output}/pmsg-stack.txt" \
    "${package_partial}/outputs/pmsg-stack.txt"
fi
cp -R "${output}/focused-disassembly" \
  "${package_partial}/outputs/focused-disassembly"
mkdir -p "${package_partial}/outputs/baseline"
cp "${baseline_output}/build.log" "${package_partial}/outputs/baseline/build.log"
cp "${baseline_output}/.config" "${package_partial}/outputs/baseline/config"
cp "${baseline_output}/config.diff" "${package_partial}/outputs/baseline/config.diff"
cp "${baseline_output}/diagnostics.txt" \
  "${package_partial}/outputs/baseline/diagnostics.txt"
cp "${baseline_output}/System.map" "${package_partial}/outputs/baseline/System.map"
cp -R "${baseline_output}/focused-disassembly" \
  "${package_partial}/outputs/baseline/focused-disassembly"
(
  cd "${baseline_output}"
  sha256sum arch/arm64/boot/Image.gz-dtb System.map vmlinux > \
    "${package_partial}/outputs/baseline/output-sha256.txt"
)
(
  cd "${output}"
  find . -type f -name '*.su' -print0 | sort -z > \
    "${package_partial}/outputs/stack-usage-files.nul"
  tar --null --files-from="${package_partial}/outputs/stack-usage-files.nul" \
    -cf "${package_partial}/outputs/stack-usage.tar"
)
tar -tf "${package_partial}/outputs/stack-usage.tar" > \
  "${package_partial}/outputs/stack-usage-files.txt"
stack_usage_count="$(tr -cd '\0' < \
  "${package_partial}/outputs/stack-usage-files.nul" | wc -c)"
readonly stack_usage_count
archive_member_count="$(wc -l < \
  "${package_partial}/outputs/stack-usage-files.txt")"
readonly archive_member_count
[[ "${stack_usage_count}" -gt 100 && \
   "${archive_member_count}" -eq "${stack_usage_count}" ]] || \
  die "stack-usage capture is unexpectedly incomplete"
tar -C "${output}" --compare \
  --file="${package_partial}/outputs/stack-usage.tar"
(
  cd "${baseline_output}"
  find . -type f -name '*.su' -print0 | sort -z > \
    "${package_partial}/outputs/baseline/stack-usage-files.nul"
  tar --null \
    --files-from="${package_partial}/outputs/baseline/stack-usage-files.nul" \
    -cf "${package_partial}/outputs/baseline/stack-usage.tar"
)
tar -tf "${package_partial}/outputs/baseline/stack-usage.tar" > \
  "${package_partial}/outputs/baseline/stack-usage-files.txt"
baseline_stack_usage_count="$(tr -cd '\0' < \
  "${package_partial}/outputs/baseline/stack-usage-files.nul" | wc -c)"
readonly baseline_stack_usage_count
baseline_archive_member_count="$(wc -l < \
  "${package_partial}/outputs/baseline/stack-usage-files.txt")"
readonly baseline_archive_member_count
[[ "${baseline_stack_usage_count}" -gt 100 && \
   "${baseline_archive_member_count}" -eq "${baseline_stack_usage_count}" ]] || \
  die "baseline stack-usage capture is unexpectedly incomplete"
tar -C "${baseline_output}" --compare \
  --file="${package_partial}/outputs/baseline/stack-usage.tar"
"${cross_prefix}gcc" --version > "${package_partial}/provenance/compiler.txt"
"${cross_prefix}ld" --version > "${package_partial}/provenance/linker.txt"
gcc --version > "${package_partial}/provenance/host-compiler.txt"
jq -n \
  --arg repository_commit "${project_commit}" \
  --arg source_url "${SOURCE_URL}" \
  --arg source_commit "${SOURCE_COMMIT}" \
  --arg parent_patchset_sha256 "${parent_patchset_sha}" \
  --arg accepted_rollback_patchset_sha256 "${accepted_rollback_patchset_sha}" \
  --arg one_way_patchset_sha256 "${one_way_patchset_sha}" \
  --arg held_patchset_sha256 "${held_patchset_sha}" \
  --arg late_patchset_sha256 "${late_patchset_sha}" \
  --arg cpu9_patchset_sha256 "${cpu9_patchset_sha}" \
  --arg window_patchset_sha256 "${window_patchset_sha}" \
  --arg terminal_patchset_sha256 "${terminal_patchset_sha}" \
  --arg coherence_patchset_sha256 "${coherence_patchset_sha}" \
  --arg multiline_patchset_sha256 "${multiline_patchset_sha}" \
  --arg parallel_patchset_sha256 "${parallel_patchset_sha}" \
  --arg scheduler_phase_parent_patchset_sha256 \
    "${scheduler_phase_parent_patchset_sha}" \
  --arg scheduler_patchset_sha256 "${scheduler_patchset_sha}" \
  --arg register_patchset_sha256 "${register_patchset_sha}" \
  --arg pmsg_patchset_sha256 "${pmsg_patchset_sha}" \
  --arg build_mode "${build_mode}" \
  --arg config_sha256 "${CONFIG_SHA256}" \
  --arg toolchain_manifest_sha256 "${manifest_sha}" \
  --arg snapshot_url "${SNAPSHOT_URL}" \
  --arg cust_dtsi_sha256 "${CUST_DTSI_SHA256}" \
  --arg build_architecture "$(uname -m)" \
  --arg target_architecture arm64 \
  --argjson stack_usage_file_count "${stack_usage_count}" \
  --argjson baseline_stack_usage_file_count "${baseline_stack_usage_count}" \
  --arg completed_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{repository_commit: $repository_commit, repository_dirty: false,
    build_mode: $build_mode,
    source_url: $source_url, source_commit: $source_commit,
    parent_patchset_sha256: $parent_patchset_sha256,
    accepted_rollback_patchset_sha256: $accepted_rollback_patchset_sha256,
    one_way_patchset_sha256: $one_way_patchset_sha256,
    held_patchset_sha256: $held_patchset_sha256,
    late_patchset_sha256: $late_patchset_sha256,
    cpu9_patchset_sha256: $cpu9_patchset_sha256,
    window_patchset_sha256: $window_patchset_sha256,
    terminal_patchset_sha256: $terminal_patchset_sha256,
    coherence_patchset_sha256: $coherence_patchset_sha256,
    multiline_patchset_sha256: $multiline_patchset_sha256,
    parallel_patchset_sha256: $parallel_patchset_sha256,
    scheduler_phase_parent_patchset_sha256:
      $scheduler_phase_parent_patchset_sha256,
    scheduler_patchset_sha256: $scheduler_patchset_sha256,
    register_patchset_sha256: $register_patchset_sha256,
    pmsg_patchset_sha256: $pmsg_patchset_sha256,
    baseline_config_sha256: $config_sha256,
    toolchain_manifest_sha256: $toolchain_manifest_sha256,
    snapshot_url: $snapshot_url, cust_dtsi_sha256: $cust_dtsi_sha256,
    build_architecture: $build_architecture,
    target_architecture: $target_architecture, host_extra_cflags: "-fcommon",
    target_extra_cflags: "-fstack-usage",
    baseline_comparison: true, diagnostics_identical: true,
    baseline_source_parent_rollback_owners: ($build_mode == "one-way"),
    baseline_source_exact_one_way: ($build_mode == "held"),
    baseline_source_exact_held: ($build_mode == "late"),
    baseline_source_exact_late: ($build_mode == "cpu9"),
    baseline_source_exact_cpu9: ($build_mode == "window"),
    baseline_source_exact_window: ($build_mode == "terminal"),
    baseline_source_exact_terminal: ($build_mode == "coherence"),
    baseline_source_exact_coherence: ($build_mode == "multiline"),
    baseline_source_exact_multiline: ($build_mode == "parallel"),
    baseline_source_exact_scheduler_phase_parent: ($build_mode == "scheduler"),
    baseline_source_exact_scheduler_unpark: ($build_mode == "register"),
    baseline_source_exact_register_capsule: ($build_mode == "pmsg"),
    cpu9_startup_source_identical: ($build_mode == "window" or
      $build_mode == "terminal" or $build_mode == "coherence" or
      $build_mode == "multiline" or $build_mode == "parallel" or
      $build_mode == "scheduler" or $build_mode == "register" or
      $build_mode == "pmsg"),
    stack_usage_captured: true,
    stack_usage_file_count: $stack_usage_file_count,
    baseline_stack_usage_file_count: $baseline_stack_usage_file_count,
    purpose: (if $build_mode == "pmsg" then
      "a72-pmsg-witness-compile-review-only" elif $build_mode == "register" then
      "a72-target-register-capsule-compile-review-only" elif $build_mode == "scheduler" then
      "a72-scheduler-unpark-compile-review-only" elif $build_mode == "parallel" then
      "cpu9-parallel-disjoint-load-compile-review-only" elif $build_mode == "multiline" then
      "cpu9-multiline-integrity-compile-review-only" elif $build_mode == "coherence" then
      "cpu9-bounded-coherency-compile-review-only" elif $build_mode == "terminal" then
      "cpu9-terminal-attribution-compile-review-only" elif $build_mode == "window" then
      "cpu9-retention-window-compile-review-only" elif $build_mode == "cpu9" then
      "cpu9-cluster-reuse-compile-review-only" elif $build_mode == "late" then
      "late-hold-compile-review-only" elif $build_mode == "held" then
      "held-online-compile-review-only" else "one-way-compile-review-only" end),
    boot_candidate: false, completed_utc: $completed_utc}' > \
  "${package_partial}/provenance/build.json"
(
  cd "${package_partial}"
  find outputs provenance -type f -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS
  sha256sum --check --strict SHA256SUMS >/dev/null
)
rm -rf -- "${output}" "${baseline_output}"
mv "${package_partial}" "${package}"
trap - EXIT
printf 'Packaged Gemian %s compile review at %s\n' \
  "${build_mode}" "${package}"
