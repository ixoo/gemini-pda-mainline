import collections
import pathlib
import re
import sys

child_root = pathlib.Path(sys.argv[1])
parent_root = pathlib.Path(sys.argv[2])

def read(root, symbol):
    return (root / (symbol + ".txt")).read_text()

def calls(text):
    return collections.Counter(
        re.findall(r"\bbl\s+[0-9a-f]+\s+<([^>]+)>", text)
    )

writer_callsite_delta = {
    "mt6797_a72_obs_init": 1,
    "mt6797_a72_hold_workfn": 1,
    "mt6797_a72_sc_terminal": 2,
}
for symbol, count in writer_callsite_delta.items():
    child = calls(read(child_root, symbol))
    parent = calls(read(parent_root, symbol))
    expected = parent + collections.Counter({"pstore_write_pmsg_kernel": count})
    if child != expected:
        raise SystemExit(
            "pmsg direct-call delta changed for {}: child={} parent={}".format(
                symbol, sorted(child.items()), sorted(parent.items())
            )
        )

helper = read(child_root, "pstore_write_pmsg_kernel")
helper_calls = calls(helper)
expected_helper_calls = collections.Counter({
    "mutex_lock": 1,
    "mutex_unlock": 1,
    "strcmp": 1,
})
if helper_calls != expected_helper_calls:
    raise SystemExit(
        "pmsg helper direct calls changed: {}".format(sorted(helper_calls.items()))
    )
if len(re.findall(r"\bblr\s+x[0-9]+\b", helper)) != 1:
    raise SystemExit("pmsg helper indirect backend call count changed")
forbidden = re.compile(
    r"<(?:[^>]*)(?:psci|invoke_psci|ioremap|readl|writel|regulator|clk_|"
    r"schedule|sleep|delay|smc|hvc|cpu_up|cpu_down|reboot|restart)(?:[^>]*)>"
)
match = forbidden.search(helper)
if match:
    raise SystemExit("forbidden pmsg-helper call: " + match.group(0))

child_task = read(child_root, "mt6797_a72_sc_thread")
parent_task = read(parent_root, "mt6797_a72_sc_thread")
child_mrs = len(re.findall(r"\bmrs\b", child_task))
parent_mrs = len(re.findall(r"\bmrs\b", parent_task))
if child_mrs != 26 or parent_mrs != 26:
    raise SystemExit(
        "pmsg/register task mrs inventory changed: child={} parent={}".format(
            child_mrs, parent_mrs
        )
    )
print("pmsg_source_operations=3")
print("pmsg_compiled_callsites=entry:1,pre-scheduler:1,terminal-branches:2")
print("pmsg_terminal_callsite_pair=mutually-exclusive-source-conditional")
print("pmsg_helper_direct_calls=mutex_lock,mutex_unlock,strcmp")
print("pmsg_helper_indirect_backend_calls=1")
print("pmsg_register_task_mrs_count=26")
print("pmsg_forbidden_calls=none")
