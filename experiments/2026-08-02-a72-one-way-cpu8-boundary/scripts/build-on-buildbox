  '{repository_commit: $repository_commit, repository_dirty: false,
    source_url: $source_url, source_commit: $source_commit,
    parent_patchset_sha256: $parent_patchset_sha256,
    accepted_rollback_patchset_sha256: $accepted_rollback_patchset_sha256,
    one_way_patchset_sha256: $one_way_patchset_sha256,
    held_patchset_sha256: $held_patchset_sha256,
