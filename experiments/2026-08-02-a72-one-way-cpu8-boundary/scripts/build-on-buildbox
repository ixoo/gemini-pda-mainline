if [[ "${build_mode}" == cpu9 ]]; then
  grep -q ' mt6797_a72_one_way_secondary_complete$' \
    "${baseline_output}/System.map" || \
    die "CPU9 baseline is not the exact late-CPU8 parent"
  for map in "${output}/System.map" "${baseline_output}/System.map"; do
    grep -q ' mt6797_a72_hold_ipi$' "${map}" || \
      die "CPU9 comparison is missing the shared IPI callback"
    grep -q ' mt6797_a72_hold_workfn$' "${map}" || \
      die "CPU9 comparison is missing the shared delayed sampler"
  done
  if cmp "${output}/focused-disassembly/hps_algo_do_cluster_action.txt" \
    "${baseline_output}/focused-disassembly/hps_algo_do_cluster_action.txt" \
    >/dev/null; then
    die "CPU9 HPS caller is binary-identical to the late-CPU8 baseline"
  fi
  if cmp "${output}/focused-disassembly/mt6797_a72_one_way_secondary_complete.txt" \
    "${baseline_output}/focused-disassembly/mt6797_a72_one_way_secondary_complete.txt" \
    >/dev/null; then
    die "CPU9 completion owner is binary-identical to the late-CPU8 baseline"
  fi
  "${cross_prefix}strings" "${output}/vmlinux" | \
