import pathlib
import sys

def function(path, name):
    text = pathlib.Path(path).read_text()
    start = text.index("static int " + name + "(")
    brace = text.index("{", start)
    depth = 0
    for offset in range(brace, len(text)):
        if text[offset] == "{":
            depth += 1
        elif text[offset] == "}":
            depth -= 1
            if depth == 0:
                return text[start:offset + 1]
    raise SystemExit("unterminated function: " + name)

if function(sys.argv[1], "mt6797_a72_cpu9_boot") != \
        function(sys.argv[2], "mt6797_a72_cpu9_boot"):
    raise SystemExit("terminal-attribution changed CPU9 PSCI boot source")
PY
