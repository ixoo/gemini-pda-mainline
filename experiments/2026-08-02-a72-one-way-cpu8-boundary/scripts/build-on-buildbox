    target_architecture: $target_architecture, host_extra_cflags: "-fcommon",
    target_extra_cflags: "-fstack-usage",
    baseline_comparison: true, diagnostics_identical: true,
    baseline_source_parent_rollback_owners: ($build_mode == "one-way"),
    baseline_source_exact_one_way: ($build_mode == "held"),
    baseline_source_exact_held: ($build_mode == "late"),
    baseline_source_exact_late: ($build_mode == "cpu9"),
    stack_usage_captured: true,
    stack_usage_file_count: $stack_usage_file_count,
    baseline_stack_usage_file_count: $baseline_stack_usage_file_count,
    purpose: (if $build_mode == "cpu9" then
      "cpu9-cluster-reuse-compile-review-only" elif $build_mode == "late" then
      "late-hold-compile-review-only" elif $build_mode == "held" then
      "held-online-compile-review-only" else "one-way-compile-review-only" end),
    boot_candidate: false, completed_utc: $completed_utc}' > \
  "${package_partial}/provenance/build.json"
