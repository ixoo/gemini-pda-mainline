    grep -F 'sc_wake8=' >/dev/null; then
    die "scheduler unpark child retains rejected wake terminal fields"
  fi
  if "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
    grep -F 'sc_unpark8=' >/dev/null; then
    die "scheduler phase parent unexpectedly contains unpark terminal fields"
  fi
  for phase in task-ready-before task-ready-after task-start-wait-before \
    task-start-wait-after task-work-before task-work-after task-done-before \
    task-done-after create8-before create8-after create9-before create9-after \
    ready8-wait-before ready8-wait-after ready9-wait-before ready9-wait-after \
    release-before \
    release-after done8-wait-before done8-wait-after done9-wait-before \
    done9-wait-after stop8-before stop8-after stop9-before stop9-after run-exit; do
    "${cross_prefix}strings" "${output}/vmlinux" | grep -F "phase=${phase}" >/dev/null || \
      die "scheduler unpark child is missing shared phase marker ${phase}"
    "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
      grep -F "phase=${phase}" >/dev/null || \
      die "scheduler phase parent is missing shared phase marker ${phase}"
  done
  for phase in unpark8-before unpark8-after unpark9-before unpark9-after; do
    "${cross_prefix}strings" "${output}/vmlinux" | \
      grep -F "phase=${phase}" >/dev/null || \
      die "scheduler unpark child is missing activation marker ${phase}"
  done
  for phase in wake8-before wake8-after wake9-before wake9-after; do
    "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
      grep -F "phase=${phase}" >/dev/null || \
      die "scheduler phase parent is missing activation marker ${phase}"
  done
  if "${cross_prefix}strings" "${output}/vmlinux" | \
    grep -F 'phase=wake' >/dev/null; then
    die "scheduler unpark child retains rejected wake phase markers"
  fi
  if "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
    grep -F 'phase=unpark' >/dev/null; then
    die "scheduler phase parent unexpectedly contains unpark phase markers"
  fi
  find "${output}" -type f -name '*.su' -exec \
    grep -hE 'mt6797_a72_(sc_thread|sc_run|sc_terminal|coh_workfn|hold_workfn)' {} + > \
    "${output}/scheduler-stack.raw" || :
  python3 - "${output}/scheduler-stack.raw" > \
    "${output}/scheduler-stack.txt" <<'PY'
import pathlib
import sys

expected = {
    "mt6797_a72_sc_thread": 512,
    "mt6797_a72_sc_terminal": 1024,
    "mt6797_a72_coh_workfn": 512,
    "mt6797_a72_hold_workfn": 1024,
}
optional = {"mt6797_a72_sc_run": 512}
seen = {}
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    fields = line.split()
    if len(fields) < 3:
        continue
    name = fields[0].rsplit(":", 1)[-1]
    limit = expected.get(name, optional.get(name))
    if limit is not None:
        size = int(fields[1])
        if fields[2] != "static" or size > limit:
            raise SystemExit("unsafe stack usage: " + line)
        seen[name] = size
if not set(expected).issubset(seen):
    raise SystemExit("scheduler stack report is incomplete")
for name in sorted(seen):
    print("{}={}".format(name, seen[name]))
PY
  rm "${output}/scheduler-stack.raw"
elif [[ "${build_mode}" == parallel ]]; then
  for map in "${output}/System.map" "${baseline_output}/System.map"; do
    for symbol in mt6797_a72_hold_ipi mt6797_a72_hold_workfn \
      mt6797_a72_hps_down_snapshot mt6797_a72_coh_ipi \
      mt6797_a72_coh_workfn mt6797_a72_ml_ipi mt6797_a72_ml_data; do
      grep -q " ${symbol}$" "${map}" || \
        die "parallel comparison is missing inherited ${symbol}"
    done
  done
  grep -q ' mt6797_a72_pl_ipi$' "${output}/System.map" || \
    die "parallel build is missing its IPI callback"
  grep -q ' mt6797_a72_pl_data$' "${output}/System.map" || \
    die "parallel build is missing its static working set"
  if grep -qE ' mt6797_a72_pl_(ipi|data)$' \
    "${baseline_output}/System.map"; then
    die "pair-v5 parent unexpectedly contains parallel symbols"
  fi
  grep -q '<mt6797_a72_pl_ipi>:' \
    "${output}/focused-disassembly/mt6797_a72_pl_ipi.txt" || \
    die "parallel disassembly is missing its callback"
  grep -Eq '\bdmb[[:space:]]+ishld\b' \
    "${output}/focused-disassembly/mt6797_a72_pl_ipi.txt" || \
    die "parallel wait loop is missing its acquire barrier"
  grep -Eq '\bdmb[[:space:]]+ishst\b' \
    "${output}/focused-disassembly/mt6797_a72_pl_ipi.txt" || \
    die "parallel callback is missing its release barrier"
  if cmp "${output}/focused-disassembly/mt6797_a72_coh_workfn.txt" \
    "${baseline_output}/focused-disassembly/mt6797_a72_coh_workfn.txt" \
    >/dev/null; then
    die "parallel integration is binary-identical to pair-v5"
  fi
  "${cross_prefix}strings" "${output}/vmlinux" | \
    grep -F 'gemini-a72-pair-v6 result=pass sample=3 cpu8=8 cpu9=9 online8=1 online9=1 hits8=3 hits9=3' >/dev/null || \
    die "parallel build is missing the pair-v6 pass terminal"
  "${cross_prefix}strings" "${output}/vmlinux" | \
    grep -F 'gemini-a72-pair-v6 result=fault sample=3 cpu8=8 cpu9=9 online8=1 online9=1 hits8=3 hits9=3' >/dev/null || \
    die "parallel build is missing the pair-v6 fault terminal"
  "${cross_prefix}strings" "${output}/vmlinux" | \
    grep -F 'pl_reported=%d pl_rounds=128 pl_lines=1024 pl_words=8 pl_cpu8=%d pl_cpu9=%d pl_error8=%d pl_error9=%d pl_done8=%d pl_done9=%d pl_ready=%d pl_written=%d pl_verified=%d' >/dev/null || \
    die "parallel build is missing its complete bounded result fields"
  "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
    grep -F 'gemini-a72-pair-v5 result=pass sample=3 cpu8=8 cpu9=9 online8=1 online9=1 hits8=3 hits9=3' >/dev/null || \
    die "parallel baseline is missing exact pair-v5"
  if "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
    grep -F 'gemini-a72-pair-v6' >/dev/null; then
    die "pair-v5 parent unexpectedly contains pair-v6"
  fi
  find "${output}" -type f -name '*.su' -exec \
    grep -hE 'mt6797_a72_(pl_ipi|coh_workfn|hold_workfn)' {} + > \
    "${output}/parallel-stack.raw" || :
  python3 - "${output}/parallel-stack.raw" > \
    "${output}/parallel-stack.txt" <<'PY'
import pathlib
import sys

expected = {
    "mt6797_a72_pl_ipi": 512,
    "mt6797_a72_coh_workfn": 512,
    "mt6797_a72_hold_workfn": 1024,
}
seen = {}
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    fields = line.split()
    if len(fields) < 3:
        continue
    name = fields[0].rsplit(":", 1)[-1]
    if name in expected:
        size = int(fields[1])
        if fields[2] != "static" or size > expected[name]:
            raise SystemExit("unsafe stack usage: " + line)
        seen[name] = size
if set(seen) != set(expected):
    raise SystemExit("parallel stack report is incomplete")
for name in sorted(seen):
    print("{}={}".format(name, seen[name]))
PY
  rm "${output}/parallel-stack.raw"
elif [[ "${build_mode}" == multiline ]]; then
