import pathlib
import sys

expected = {
    "mt6797_a72_hold_workfn": 1024,
    "mt6797_a72_obs_init": 512,
    "mt6797_a72_sc_terminal": 1024,
    "mt6797_a72_sc_thread": 1024,
    "pstore_write_pmsg_kernel": 512,
}
seen = {}
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    fields = line.split()
    if len(fields) < 3:
        continue
    name = fields[0].rsplit(":", 1)[-1]
    if name in expected:
        size = int(fields[1])
        if fields[2] != "static" or size > expected[name]:
            raise SystemExit("unsafe pmsg stack usage: " + line)
        seen[name] = size
if set(seen) != set(expected):
    missing = sorted(set(expected) - set(seen))
    raise SystemExit("pmsg stack report is incomplete: " + ",".join(missing))
for name in sorted(seen):
    print("{}={}".format(name, seen[name]))
