    "${baseline_output}/System.map" || \
    die "held baseline is not the exact one-way parent"
  grep -q ' mt6797_a72_hold_ipi$' "${output}/System.map" || \
    die "held build is missing the CPU8 IPI callback"
  grep -q ' mt6797_a72_hold_workfn$' "${output}/System.map" || \
    die "held build is missing the delayed sampler"
  if grep -qE ' mt6797_a72_hold_(ipi|workfn)$' \
    "${baseline_output}/System.map"; then
    die "one-way baseline unexpectedly contains held-online symbols"
  fi
  "${cross_prefix}strings" "${output}/vmlinux" | \
    grep -F 'gemini-a72-hold-v1 result=down-veto' >/dev/null || \
    die "held build is missing the early down-veto marker"
  "${cross_prefix}strings" "${output}/vmlinux" | \
    grep -F 'gemini-a72-hold-v1 result=pass sample=2' >/dev/null || \
    die "held build is missing the terminal IPI-pass marker"
  if "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
    grep -F 'gemini-a72-hold-v1' >/dev/null; then
    die "one-way baseline unexpectedly contains held-online markers"
  fi
elif grep -qE ' (mtk_wd_a72_recovery_takeover|mt6797_a72_one_way_.*)$' \
  "${baseline_output}/System.map"; then
