import collections
import pathlib
import re
import sys

child_root = pathlib.Path(sys.argv[1])
parent_root = pathlib.Path(sys.argv[2])

def read(root, symbol):
    return (root / (symbol + ".txt")).read_text()

def calls(text):
    return collections.Counter(
        re.findall(r"\bbl\s+[0-9a-f]+\s+<([^>]+)>", text)
    )

child_calls = calls(read(child_root, "mt6797_a72_hold_workfn"))
parent_calls = calls(read(parent_root, "mt6797_a72_hold_workfn"))
child_expected = {
    "kthread_create_on_cpu": 2,
    "kthread_unpark": 2,
    "wake_up_process": 0,
    "kthread_stop": 2,
}
parent_expected = {
    "kthread_create_on_cpu": 2,
    "kthread_unpark": 0,
    "wake_up_process": 2,
    "kthread_stop": 2,
}
for symbol, count in child_expected.items():
    if child_calls[symbol] != count:
        raise SystemExit(
            "scheduler child {} call count is {}, expected {}".format(
                symbol, child_calls[symbol], count
            )
        )
for symbol, count in parent_expected.items():
    if parent_calls[symbol] != count:
        raise SystemExit(
            "scheduler phase parent {} call count is {}, expected {}".format(
                symbol, parent_calls[symbol], count
            )
        )

def validate_core(root, label):
    create = read(root, "kthread_create_on_cpu")
    parkme = read(root, "__kthread_parkme")
    park = read(root, "kthread_park")
    public_unpark = read(root, "kthread_unpark")
    internal_unpark = read(root, "__kthread_unpark")
    stop = read(root, "kthread_stop")
    wake = read(root, "wake_up_process")
    if calls(create)["kthread_park"] != 1:
        raise SystemExit(label + " kthread_create_on_cpu park call changed")
    if "#0x200" not in parkme:
        raise SystemExit(label + " __kthread_parkme lacks TASK_PARKED state")
    park_calls = calls(park)
    for symbol in ("wake_up_process", "wait_for_completion"):
        if park_calls[symbol] != 1:
            raise SystemExit(label + " kthread_park call changed: " + symbol)
    if calls(public_unpark)["__kthread_unpark"] != 1:
        raise SystemExit(label + " kthread_unpark call changed")
    internal_calls = calls(internal_unpark)
    for symbol in (
        "clear_bit", "test_and_clear_bit", "__kthread_bind", "wake_up_state"
    ):
        if internal_calls[symbol] != 1:
            raise SystemExit(label + " __kthread_unpark call changed: " + symbol)
    if internal_unpark.count("#0x200") != 2:
        raise SystemExit(label + " __kthread_unpark TASK_PARKED mask changed")
    stop_calls = calls(stop)
    for symbol in (
        "__kthread_unpark", "wake_up_process", "wait_for_completion"
    ):
        if stop_calls[symbol] != 1:
            raise SystemExit(label + " kthread_stop call changed: " + symbol)
    if calls(wake)["try_to_wake_up"] != 2 or wake.count("#0x3") != 2:
        raise SystemExit(label + " wake_up_process TASK_NORMAL mask changed")

validate_core(child_root, "scheduler child")
validate_core(parent_root, "scheduler phase parent")
PY
