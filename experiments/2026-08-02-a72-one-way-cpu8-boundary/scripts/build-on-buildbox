readonly observer_experiment_dir
rollback_experiment_dir="${repository_dir}/experiments/2026-08-02-a72-pre-isolation-rollback-discriminator"
readonly rollback_experiment_dir
held_experiment_dir="${repository_dir}/experiments/2026-08-02-a72-cpu8-held-online"
readonly held_experiment_dir
late_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-cpu8-late-hold"
readonly late_experiment_dir
cpu9_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-cpu9-cluster-reuse"
readonly cpu9_experiment_dir
window_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-cpu9-retention-window"
readonly window_experiment_dir
terminal_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-cpu9-terminal-attribution"
readonly terminal_experiment_dir
coherence_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-cpu9-bounded-coherency"
readonly coherence_experiment_dir
multiline_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-cpu9-multiline-integrity"
readonly multiline_experiment_dir
parallel_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-cpu9-parallel-disjoint-load"
readonly parallel_experiment_dir
scheduler_experiment_dir="${repository_dir}/experiments/2026-08-03-a72-scheduler-context"
readonly scheduler_experiment_dir
register_experiment_dir="${repository_dir}/experiments/2026-08-28-a72-target-register-capsule"
readonly register_experiment_dir
pmsg_experiment_dir="${repository_dir}/experiments/2026-08-28-a72-pmsg-witness"
readonly pmsg_experiment_dir
[[ "$(git -C "${repository_dir}" rev-parse HEAD)" == "${project_commit}" ]] || \
  die "project checkout does not match requested commit"
[[ -z "$(git -C "${repository_dir}" status --porcelain)" ]] || \
  die "project checkout is dirty"

readonly manifest="${observer_experiment_dir}/inputs/stretch-cross-toolchain.tsv"
readonly baseline_config="${observer_experiment_dir}/inputs/active-gemian.config"
readonly parent_patch_series="${observer_experiment_dir}/patches/series"
readonly -a accepted_rollback_patches=(
  0001-diagnostic-extend-A72-observer-rollback-ABI.patch
  0002-diagnostic-add-exact-A72-rollback-owner-operations.patch
)
readonly one_way_patch_series="${experiment_dir}/patches/series"
readonly held_patch_series="${held_experiment_dir}/patches/series"
readonly late_patch_series="${late_experiment_dir}/patches/series"
readonly cpu9_patch_series="${cpu9_experiment_dir}/patches/series"
readonly window_patch_series="${window_experiment_dir}/patches/series"
readonly terminal_patch_series="${terminal_experiment_dir}/patches/series"
readonly coherence_patch_series="${coherence_experiment_dir}/patches/series"
readonly multiline_patch_series="${multiline_experiment_dir}/patches/series"
readonly parallel_patch_series="${parallel_experiment_dir}/patches/series"
readonly scheduler_patch_series="${scheduler_experiment_dir}/patches/series"
readonly register_patch_series="${register_experiment_dir}/patches/series"
readonly pmsg_patch_series="${pmsg_experiment_dir}/patches/series"
readonly -a scheduler_phase_parent_patches=(
  0001-diagnostic-add-bounded-A72-scheduler-context-execution.patch
  0002-diagnostic-add-A72-scheduler-phase-attribution.patch
)
readonly scheduler_unpark_patch=0003-diagnostic-unpark-A72-scheduler-context-tasks.patch
readonly EXPECTED_SCHEDULER_PHASE_PARENT_PATCHSET_SHA256=b2c971d4a1860ec09616a61dbd8a29fde488f7d99deb8bd6bfbf2c517b2c3493
# Exact admitted phase-parent plus unpark child series identity.
readonly EXPECTED_SCHEDULER_UNPARK_PATCHSET_SHA256=bd5799cecd14aa34a87562b09507a6d9f18f11cd138420bcba629f12793e7bfe
readonly EXPECTED_REGISTER_PATCHSET_SHA256=71ef281aae8d0b99d0421b81bd3d61d82ab090125c4885977ba39d8280838469
readonly EXPECTED_PMSG_PATCHSET_SHA256=6663fe7b073ce2e939bf2ba6ce3de28e824cf3b30d1653c4d3c272bf3ba2bd46
manifest_sha="$(sha256sum "${manifest}" | awk '{print $1}')"
readonly manifest_sha
parent_patchset_sha="$(cd "${observer_experiment_dir}/patches" && while IFS= read -r patch; do sha256sum "${patch}"; done < series | sha256sum | awk '{print $1}')"
readonly parent_patchset_sha
