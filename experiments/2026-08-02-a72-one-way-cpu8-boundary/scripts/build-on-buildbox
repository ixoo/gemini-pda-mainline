held_patchset_sha="$({
  cd "${held_experiment_dir}/patches"
  while IFS= read -r patch; do
    sha256sum "${patch}" | awk '{print $1}'
  done < series
} | sha256sum | awk '{print $1}')"
readonly held_patchset_sha
late_patchset_sha="$({
  cd "${late_experiment_dir}/patches"
  while IFS= read -r patch; do
    sha256sum "${patch}" | awk '{print $1}'
  done < series
} | sha256sum | awk '{print $1}')"
readonly late_patchset_sha
cpu9_patchset_sha="$({
  cd "${cpu9_experiment_dir}/patches"
  while IFS= read -r patch; do
    sha256sum "${patch}" | awk '{print $1}'
  done < series
} | sha256sum | awk '{print $1}')"
readonly cpu9_patchset_sha
window_patchset_sha="$({
  cd "${window_experiment_dir}/patches"
  while IFS= read -r patch; do
    sha256sum "${patch}" | awk '{print $1}'
  done < series
} | sha256sum | awk '{print $1}')"
readonly window_patchset_sha
terminal_patchset_sha=not-selected
if [[ "${build_mode}" == terminal || "${build_mode}" == coherence || \
      "${build_mode}" == multiline || "${build_mode}" == parallel || \
      "${build_mode}" == scheduler || "${build_mode}" == register || \
      "${build_mode}" == pmsg ]]; then
  [[ -f "${terminal_patch_series}" ]] || \
    die "terminal-attribution patch series is absent"
  terminal_patchset_sha="$({
    cd "${terminal_experiment_dir}/patches"
    while IFS= read -r patch; do
      sha256sum "${patch}" | awk '{print $1}'
    done < series
  } | sha256sum | awk '{print $1}')"
fi
readonly terminal_patchset_sha
coherence_patchset_sha=not-selected
if [[ "${build_mode}" == coherence || "${build_mode}" == multiline ||
      "${build_mode}" == parallel || "${build_mode}" == scheduler || \
      "${build_mode}" == register || "${build_mode}" == pmsg ]]; then
  [[ -f "${coherence_patch_series}" ]] || \
    die "bounded-coherency patch series is absent"
  coherence_patchset_sha="$({
    cd "${coherence_experiment_dir}/patches"
    while IFS= read -r patch; do
      sha256sum "${patch}" | awk '{print $1}'
    done < series
  } | sha256sum | awk '{print $1}')"
fi
readonly coherence_patchset_sha
if [[ "${build_mode}" == coherence || "${build_mode}" == multiline ||
      "${build_mode}" == parallel || "${build_mode}" == scheduler || \
      "${build_mode}" == register || "${build_mode}" == pmsg ]]; then
  [[ "${coherence_patchset_sha}" == \
     d4c40577b9e91fedfde048b29cb203311de264c526c71e3abd907fc6fafcf67f ]] || \
    die "bounded-coherency patchset identity mismatch"
fi
multiline_patchset_sha=not-selected
if [[ "${build_mode}" == multiline || "${build_mode}" == parallel || \
      "${build_mode}" == scheduler || "${build_mode}" == register || \
      "${build_mode}" == pmsg ]]; then
  [[ -f "${multiline_patch_series}" ]] || \
    die "multiline-integrity patch series is absent"
  multiline_patchset_sha="$({
    cd "${multiline_experiment_dir}/patches"
    while IFS= read -r patch; do
      sha256sum "${patch}" | awk '{print $1}'
    done < series
  } | sha256sum | awk '{print $1}')"
fi
readonly multiline_patchset_sha
if [[ "${build_mode}" == multiline || "${build_mode}" == parallel || \
      "${build_mode}" == scheduler || "${build_mode}" == register || \
      "${build_mode}" == pmsg ]]; then
  [[ "${multiline_patchset_sha}" == \
     c7a9b020563c4abb74059bbf72705839c528a81d577c7031ddfb36de647fd896 ]] || \
    die "multiline-integrity patchset identity mismatch"
fi
parallel_patchset_sha=not-selected
if [[ "${build_mode}" == parallel || "${build_mode}" == scheduler || \
      "${build_mode}" == register || "${build_mode}" == pmsg ]]; then
  [[ -f "${parallel_patch_series}" ]] || \
    die "parallel disjoint-load patch series is absent"
  parallel_patchset_sha="$({
    cd "${parallel_experiment_dir}/patches"
    while IFS= read -r patch; do
      sha256sum "${patch}" | awk '{print $1}'
    done < series
  } | sha256sum | awk '{print $1}')"
fi
readonly parallel_patchset_sha
if [[ "${build_mode}" == parallel || "${build_mode}" == scheduler || \
      "${build_mode}" == register || "${build_mode}" == pmsg ]]; then
  [[ "${parallel_patchset_sha}" == \
     94d3b07355e1ddb67f3f643165570255bb1f42131b3b67c074d270e8581989e2 ]] || \
    die "parallel disjoint-load patchset identity mismatch"
fi
scheduler_phase_parent_patchset_sha=not-selected
scheduler_patchset_sha=not-selected
if [[ "${build_mode}" == scheduler || "${build_mode}" == register || \
      "${build_mode}" == pmsg ]]; then
  [[ -f "${scheduler_patch_series}" ]] || \
    die "scheduler-context patch series is absent"
  expected_scheduler_series="$(
    printf '%s\n' "${scheduler_phase_parent_patches[@]}" \
      "${scheduler_unpark_patch}"
  )"
  readonly expected_scheduler_series
  [[ "$(<"${scheduler_patch_series}")" == "${expected_scheduler_series}" ]] || \
    die "scheduler-context series is not exact phase-parent plus unpark child"
  scheduler_phase_parent_patchset_sha="$({
    cd "${scheduler_experiment_dir}/patches"
    for patch in "${scheduler_phase_parent_patches[@]}"; do
      [[ -f "${patch}" && ! -L "${patch}" ]] || \
        die "scheduler phase-parent patch is absent or unsafe: ${patch}"
      sha256sum "${patch}" | awk '{print $1}'
    done
  } | sha256sum | awk '{print $1}')"
  [[ "${scheduler_phase_parent_patchset_sha}" == \
     "${EXPECTED_SCHEDULER_PHASE_PARENT_PATCHSET_SHA256}" ]] || \
    die "scheduler phase-parent patchset identity mismatch"
  [[ -f "${scheduler_experiment_dir}/patches/${scheduler_unpark_patch}" && \
     ! -L "${scheduler_experiment_dir}/patches/${scheduler_unpark_patch}" ]] || \
    die "scheduler unpark child patch is absent or unsafe"
  scheduler_patchset_sha="$({
    cd "${scheduler_experiment_dir}/patches"
    while IFS= read -r patch; do
      sha256sum "${patch}" | awk '{print $1}'
    done < series
  } | sha256sum | awk '{print $1}')"
fi
readonly scheduler_phase_parent_patchset_sha
readonly scheduler_patchset_sha
if [[ "${build_mode}" == scheduler || "${build_mode}" == register || \
      "${build_mode}" == pmsg ]]; then
  [[ "${EXPECTED_SCHEDULER_UNPARK_PATCHSET_SHA256}" =~ ^[0-9a-f]{64}$ ]] || \
    die "scheduler unpark child patchset hash pin is pending"
  [[ "${scheduler_patchset_sha}" == \
     "${EXPECTED_SCHEDULER_UNPARK_PATCHSET_SHA256}" ]] || \
    die "scheduler unpark child patchset identity mismatch"
fi
register_patchset_sha=not-selected
if [[ "${build_mode}" == register || "${build_mode}" == pmsg ]]; then
  [[ -f "${register_patch_series}" && ! -L "${register_patch_series}" ]] || \
    die "register-capsule patch series is absent or unsafe"
  [[ "$(<"${register_patch_series}")" == \
     0001-diagnostic-capture-A72-target-register-capsules.patch ]] || \
    die "register-capsule series is not the exact admitted child"
  register_patchset_sha="$({
    cd "${register_experiment_dir}/patches"
    while IFS= read -r patch; do
      [[ -f "${patch}" && ! -L "${patch}" ]] || \
        die "register-capsule patch is absent or unsafe: ${patch}"
      sha256sum "${patch}" | awk '{print $1}'
    done < series
  } | sha256sum | awk '{print $1}')"
  [[ "${register_patchset_sha}" == \
     "${EXPECTED_REGISTER_PATCHSET_SHA256}" ]] || \
    die "register-capsule patchset identity mismatch"
fi
readonly register_patchset_sha
pmsg_patchset_sha=not-selected
if [[ "${build_mode}" == pmsg ]]; then
  [[ -f "${pmsg_patch_series}" && ! -L "${pmsg_patch_series}" ]] || \
    die "pmsg-witness patch series is absent or unsafe"
  [[ "$(<"${pmsg_patch_series}")" == \
     0001-diagnostic-add-same-version-pmsg-witness.patch ]] || \
    die "pmsg-witness series is not the exact admitted child"
  pmsg_patchset_sha="$({
    cd "${pmsg_experiment_dir}/patches"
    while IFS= read -r patch; do
      [[ -f "${patch}" && ! -L "${patch}" ]] || \
        die "pmsg-witness patch is absent or unsafe: ${patch}"
      sha256sum "${patch}" | awk '{print $1}'
    done < series
  } | sha256sum | awk '{print $1}')"
  [[ "${pmsg_patchset_sha}" == "${EXPECTED_PMSG_PATCHSET_SHA256}" ]] || \
    die "pmsg-witness patchset identity mismatch"
fi
readonly pmsg_patchset_sha
[[ "$(sha256sum "${baseline_config}" | awk '{print $1}')" == "${CONFIG_SHA256}" ]] || \
  die "active Gemian configuration hash mismatch"

for command in apt-cache apt-get dpkg-deb file git jq make python3 sha256sum tar; do
  command -v "${command}" >/dev/null 2>&1 || die "missing Buildbox command: ${command}"
done

prepare_toolchain() {
  local apt_root
  local architecture
  local compiler
  local deb
  local filename
  local package
  local partial
  local sha
  local version
  local wrapper

  local toolchain="${toolchain_root}/${manifest_sha}"
  if [[ -f "${toolchain}/validated" && ! -L "${toolchain}" ]]; then
    [[ "$(<"${toolchain}/validated")" == "${manifest_sha}" ]] || \
      die "cached toolchain validation identity mismatch"
    return
  fi

  mkdir -p "${toolchain_root}"
  for partial in "${toolchain_root}/${manifest_sha}.partial."*; do
    [[ -d "${partial}" && ! -L "${partial}" ]] || continue
    rm -rf -- "${partial}"
  done
  partial="${toolchain_root}/${manifest_sha}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' RETURN
  mkdir -p "${partial}/apt/etc" "${partial}/apt/lists/partial" \
    "${partial}/apt/cache/archives/partial" "${partial}/debs" \
    "${partial}/root" "${partial}/wrappers"
  printf '%s\n' "deb [trusted=yes] ${SNAPSHOT_URL} stretch main" > \
    "${partial}/apt/etc/sources.list"
  : > "${partial}/apt/status"
  apt_root="${partial}/apt"
  local -a apt_options=(
    -o "Dir::Etc::sourcelist=${apt_root}/etc/sources.list"
    -o Dir::Etc::sourceparts=-
    -o "Dir::State::status=${apt_root}/status"
    -o "Dir::State::lists=${apt_root}/lists"
    -o "Dir::Cache=${apt_root}/cache"
    -o Dir::Cache::archives=archives
    -o Acquire::Check-Valid-Until=false
    -o APT::Get::List-Cleanup=false
    -o APT::Sandbox::User=builder
  )
  apt-get "${apt_options[@]}" update >/dev/null

  while IFS=$'\t' read -r package version architecture filename sha; do
    [[ "${package}" != package ]] || continue
    [[ "${package}" =~ ^[a-z0-9][a-z0-9+.-]*$ ]] || die "unsafe package name"
    [[ "${architecture}" =~ ^(all|amd64)$ ]] || die "unsafe package architecture"
    [[ "${filename}" =~ ^[A-Za-z0-9_.+%:-]+\.deb$ ]] || die "unsafe package filename"
    [[ "${sha}" =~ ^[0-9a-f]{64}$ ]] || die "unsafe package checksum"
    (
      cd "${partial}/debs"
      apt-get "${apt_options[@]}" download "${package}=${version}" >/dev/null
    )
    deb="${partial}/debs/${filename}"
    [[ -f "${deb}" && ! -L "${deb}" ]] || die "missing downloaded package: ${filename}"
    [[ "$(sha256sum "${deb}" | awk '{print $1}')" == "${sha}" ]] || \
      die "package checksum mismatch: ${filename}"
    [[ "$(dpkg-deb -f "${deb}" Package)" == "${package}" ]] || die "package identity mismatch"
    [[ "$(dpkg-deb -f "${deb}" Version)" == "${version}" ]] || die "package version mismatch"
    [[ "$(dpkg-deb -f "${deb}" Architecture)" == "${architecture}" ]] || die "package architecture mismatch"
  done < "${manifest}"
  [[ "$(find "${partial}/debs" -maxdepth 1 -type f -name '*.deb' | wc -l)" -eq 39 ]] || \
    die "unexpected toolchain package count"
  while IFS=$'\t' read -r package version architecture filename sha; do
    [[ "${package}" != package ]] || continue
    dpkg-deb -x "${partial}/debs/${filename}" "${partial}/root"
  done < "${manifest}"

  wrapper="${partial}/wrappers/aarch64-linux-gnu-gcc"
  cat > "${wrapper}" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
toolchain_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
export LD_LIBRARY_PATH="${toolchain_dir}/root/usr/lib/x86_64-linux-gnu"
exec "${toolchain_dir}/root/usr/bin/aarch64-linux-gnu-gcc-6" \
  -B"${toolchain_dir}/root/usr/lib/gcc-cross/aarch64-linux-gnu/6/" \
  --sysroot="${toolchain_dir}/root" "$@"
WRAPPER
  chmod 0755 "${wrapper}"
  cat > "${partial}/wrappers/python2.7" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
toolchain_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
export LD_LIBRARY_PATH="${toolchain_dir}/root/usr/lib/x86_64-linux-gnu"
export PYTHONHOME="${toolchain_dir}/root/usr"
exec "${toolchain_dir}/root/usr/bin/python2.7" "$@"
WRAPPER
  chmod 0755 "${partial}/wrappers/python2.7"
  for command in addr2line ar as c++filt elfedit gprof ld ld.bfd nm objcopy objdump ranlib readelf size strings strip; do
    [[ -x "${partial}/root/usr/bin/aarch64-linux-gnu-${command}" ]] || \
      die "missing cross tool: ${command}"
    ln -s "../root/usr/bin/aarch64-linux-gnu-${command}" \
      "${partial}/wrappers/aarch64-linux-gnu-${command}"
  done
  compiler="${partial}/wrappers/aarch64-linux-gnu-gcc"
  export LD_LIBRARY_PATH="${partial}/root/usr/lib/x86_64-linux-gnu"
  [[ "$("${compiler}" --version | head -n 1)" == "${EXPECTED_GCC}" ]] || \
    die "pinned compiler identity mismatch"
  [[ "$("${partial}/wrappers/aarch64-linux-gnu-ld" --version | head -n 1)" == "${EXPECTED_LD}" ]] || \
    die "pinned linker identity mismatch"
  [[ "$("${partial}/wrappers/python2.7" --version 2>&1)" == "${EXPECTED_PYTHON}" ]] || \
    die "pinned Python identity mismatch"
  printf 'int probe(void) { return 0; }\n' | \
    "${compiler}" -x c -c -o "${partial}/probe.o" -
  file "${partial}/probe.o" | grep -F 'ELF 64-bit LSB relocatable, ARM aarch64' >/dev/null || \
    die "pinned compiler object probe failed"
  printf '%s\n' "${manifest_sha}" > "${partial}/validated"
  mv "${partial}" "${toolchain}"
  partial=""
  trap - RETURN
}

prepare_mirror() {
  mkdir -p "${source_root}"
  if [[ ! -d "${source_mirror}" ]]; then
    git clone --mirror "${SOURCE_URL}" "${source_mirror}.partial"
    mv "${source_mirror}.partial" "${source_mirror}"
  fi
  [[ "$(git --git-dir="${source_mirror}" remote get-url origin)" == "${SOURCE_URL}" ]] || \
    die "vendor source mirror origin mismatch"
  git --git-dir="${source_mirror}" fetch origin "${SOURCE_COMMIT}"
  [[ "$(git --git-dir="${source_mirror}" rev-parse FETCH_HEAD)" == "${SOURCE_COMMIT}" ]] || \
    die "vendor source fetch mismatch"
}

prepare_variant() {
  local current_diff_sha
  local expected_diff_sha
  local include_one_way="$4"
  local include_held="$5"
  local include_late="$6"
  local include_cpu9="$7"
  local include_window="$8"
  local include_terminal="$9"
  local include_coherence="${10}"
  local include_multiline="${11}"
  local include_parallel="${12:-0}"
  local include_scheduler="${13:-0}"
  local include_register="${14:-0}"
  local include_pmsg="${15:-0}"
  local patch
  local partial
  local state_identity
  local state_source
  local target="$1"
  local state_file="$2"
  local expected_identity="$3"

  mkdir -p "$(dirname "${target}")"
  if [[ -f "${target}/${state_file}" && ! -L "${target}" ]]; then
    read -r state_source state_identity expected_diff_sha < \
      "${target}/${state_file}"
    [[ "${state_source}" == "${SOURCE_COMMIT}" && \
       "${state_identity}" == "${expected_identity}" && \
       "${expected_diff_sha}" =~ ^[0-9a-f]{64}$ ]] || \
      die "prepared source identity mismatch: ${target}"
    git -C "${target}" diff --check
    current_diff_sha="$(git -C "${target}" diff --binary | sha256sum | awk '{print $1}')"
    [[ "${current_diff_sha}" == "${expected_diff_sha}" ]] || \
      die "prepared source diff mismatch: ${target}"
    return
  fi
  for partial in "${target}.partial."*; do
    [[ -d "${partial}" && ! -L "${partial}" ]] || continue
    rm -rf -- "${partial}"
  done
  partial="${target}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' RETURN
  git clone --no-checkout "${source_mirror}" "${partial}"
  git -C "${partial}" checkout --detach "${SOURCE_COMMIT}"
  while IFS= read -r patch; do
    [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || die "unsafe observer patch name"
    git -C "${partial}" apply --check "${observer_experiment_dir}/patches/${patch}"
    git -C "${partial}" apply "${observer_experiment_dir}/patches/${patch}"
  done < "${parent_patch_series}"
  for patch in "${accepted_rollback_patches[@]}"; do
    [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
      die "unsafe rollback patch name"
    git -C "${partial}" apply --check \
      "${rollback_experiment_dir}/patches/${patch}"
    git -C "${partial}" apply \
      "${rollback_experiment_dir}/patches/${patch}"
  done
  if [[ "${include_one_way}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe one-way patch name"
      git -C "${partial}" apply --check "${experiment_dir}/patches/${patch}"
      git -C "${partial}" apply "${experiment_dir}/patches/${patch}"
    done < "${one_way_patch_series}"
  fi
  if [[ "${include_held}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe held-online patch name"
      git -C "${partial}" apply --check \
        "${held_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${held_experiment_dir}/patches/${patch}"
    done < "${held_patch_series}"
  fi
  if [[ "${include_late}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe late-hold patch name"
      git -C "${partial}" apply --check \
        "${late_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${late_experiment_dir}/patches/${patch}"
    done < "${late_patch_series}"
  fi
  if [[ "${include_cpu9}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe CPU9 patch name"
      git -C "${partial}" apply --check \
        "${cpu9_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${cpu9_experiment_dir}/patches/${patch}"
    done < "${cpu9_patch_series}"
  fi
  if [[ "${include_window}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe retention-window patch name"
      git -C "${partial}" apply --check \
        "${window_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${window_experiment_dir}/patches/${patch}"
    done < "${window_patch_series}"
  fi
  if [[ "${include_terminal}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe terminal-attribution patch name"
      git -C "${partial}" apply --check \
        "${terminal_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${terminal_experiment_dir}/patches/${patch}"
    done < "${terminal_patch_series}"
  fi
  if [[ "${include_coherence}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe bounded-coherency patch name"
      git -C "${partial}" apply --check \
        "${coherence_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${coherence_experiment_dir}/patches/${patch}"
    done < "${coherence_patch_series}"
  fi
  if [[ "${include_multiline}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe multiline-integrity patch name"
      git -C "${partial}" apply --check \
        "${multiline_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${multiline_experiment_dir}/patches/${patch}"
    done < "${multiline_patch_series}"
  fi
  if [[ "${include_parallel}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe parallel disjoint-load patch name"
      git -C "${partial}" apply --check \
        "${parallel_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${parallel_experiment_dir}/patches/${patch}"
    done < "${parallel_patch_series}"
  fi
  if [[ "${include_scheduler}" == 1 || "${include_scheduler}" == 2 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe scheduler-context patch name"
      if [[ "${include_scheduler}" == 2 && \
            "${patch}" == "${scheduler_unpark_patch}" ]]; then
        continue
      fi
      git -C "${partial}" apply --check \
        "${scheduler_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${scheduler_experiment_dir}/patches/${patch}"
    done < "${scheduler_patch_series}"
  fi
  if [[ "${include_register}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe register-capsule patch name"
      git -C "${partial}" apply --check \
        "${register_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${register_experiment_dir}/patches/${patch}"
    done < "${register_patch_series}"
  fi
  if [[ "${include_pmsg}" == 1 ]]; then
    while IFS= read -r patch; do
      [[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
        die "unsafe pmsg-witness patch name"
      git -C "${partial}" apply --check \
        "${pmsg_experiment_dir}/patches/${patch}"
      git -C "${partial}" apply \
        "${pmsg_experiment_dir}/patches/${patch}"
    done < "${pmsg_patch_series}"
  fi
  git -C "${partial}" diff --check
  current_diff_sha="$(git -C "${partial}" diff --binary | sha256sum | awk '{print $1}')"
  printf '%s %s %s\n' "${SOURCE_COMMIT}" "${expected_identity}" \
    "${current_diff_sha}" > "${partial}/${state_file}"
  mv "${partial}" "${target}"
  partial=""
  trap - RETURN
}

