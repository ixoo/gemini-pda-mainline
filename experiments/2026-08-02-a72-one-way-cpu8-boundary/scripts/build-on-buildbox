    "${baseline_output}/System.map" || \
    die "late baseline is not the exact held-online parent"
  for map in "${output}/System.map" "${baseline_output}/System.map"; do
    grep -q ' mt6797_a72_hold_ipi$' "${map}" || \
      die "late comparison is missing the CPU8 IPI callback"
    grep -q ' mt6797_a72_hold_workfn$' "${map}" || \
      die "late comparison is missing the delayed sampler"
  done
  "${cross_prefix}strings" "${output}/vmlinux" | \
    grep -F 'gemini-a72-hold-v2 result=pass sample=3' >/dev/null || \
    die "late build is missing the third-sample terminal"
  if "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
    grep -F 'gemini-a72-hold-v2' >/dev/null; then
    die "held-online baseline unexpectedly contains late-hold markers"
  fi
  "${cross_prefix}strings" "${baseline_output}/vmlinux" | \
    grep -F 'gemini-a72-hold-v1 result=pass sample=2' >/dev/null || \
    die "late baseline is missing the exact held-online terminal"
elif [[ "${build_mode}" == held ]]; then
