  --arg repository_commit "${project_commit}" \
  --arg source_url "${SOURCE_URL}" \
  --arg source_commit "${SOURCE_COMMIT}" \
  --arg parent_patchset_sha256 "${parent_patchset_sha}" \
  --arg accepted_rollback_patchset_sha256 "${accepted_rollback_patchset_sha}" \
  --arg one_way_patchset_sha256 "${one_way_patchset_sha}" \
