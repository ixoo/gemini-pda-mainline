sed '3s/^ \* [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\} [0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}$/ * 1970-01-01 00:00:00/' \
  "${baseline_dct_output}/cust.dtsi" > "${baseline_dct_output}/cust.dtsi.normalized"
