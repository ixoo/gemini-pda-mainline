From d583f18d90806c798d879366d12a097ef820702a Mon Sep 17 00:00:00 2001
From: Gemini diagnostic experiment <diagnostic@example.invalid>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] diagnostic: observe one existing Gemian REG06 read

Default-off internal experiment; synthetic non-certifying author.
No added charger transaction or changed policy/transfer result.
---
 drivers/i2c/busses/i2c-mtk.c                 | 51 +++++++++++++
 drivers/i2c/busses/i2c-mtk.h                 |  5 ++
 drivers/misc/mediatek/power/mt6797/bq25890.c | 77 +++++++++++++++++++-
 include/linux/gemini-reg06-observer.h        | 37 ++++++++++
 4 files changed, 166 insertions(+), 4 deletions(-)
 create mode 100644 include/linux/gemini-reg06-observer.h

diff --git a/drivers/i2c/busses/i2c-mtk.c b/drivers/i2c/busses/i2c-mtk.c
index ef497bc..cdcaa2f 100644
--- a/drivers/i2c/busses/i2c-mtk.c
+++ b/drivers/i2c/busses/i2c-mtk.c
@@ -510,6 +510,11 @@ static int mt_i2c_do_transfer(struct mt_i2c *i2c)
 	i2c->irq_stat = 0;
 	if (i2c->total_len > 8 || i2c->msg_aux_len > 8)
 		isDMA = true;
+	if (i2c->reg06_active) {
+		i2c->reg06_active->transfers++;
+		i2c->reg06_active->fifo_path = !isDMA;
+		i2c->reg06_active->wrrd = i2c->op == I2C_MASTER_WRRD;
+	}
 	if (i2c->ext_data.isEnable && i2c->ext_data.timing)
 		speed_hz = i2c->ext_data.timing;
 	else
@@ -642,6 +647,8 @@ static int mt_i2c_do_transfer(struct mt_i2c *i2c)
 	}
 
 	tmo = wait_event_timeout(i2c->wait, i2c->trans_stop, tmo);
+	if (i2c->reg06_active)
+		i2c->reg06_active->irq = i2c->irq_stat;
 
 	if (tmo == 0) {
 		dev_err(i2c->dev, "addr: %x, transfer timeout\n", i2c->addr);
@@ -660,6 +667,10 @@ static int mt_i2c_do_transfer(struct mt_i2c *i2c)
 	}
 	if (i2c->op != I2C_MASTER_WR && isDMA == false) {
 		data_size = (i2c_readw(i2c, OFFSET_FIFO_STAT) >> 4) & 0x000F;
+		if (i2c->reg06_active) {
+			i2c->reg06_active->fifo_seen = true;
+			i2c->reg06_active->fifo_count = data_size;
+		}
 		ptr = i2c->dma_buf.vaddr;
 		while (data_size--) {
 			*ptr = i2c_readw(i2c, OFFSET_DATA_PORT);
@@ -937,7 +948,21 @@ static int mt_i2c_transfer(struct i2c_adapter *adap,
 		return -EBUSY;
 
 	mutex_lock(&i2c->i2c_mutex);
+	if (i2c->reg06_pending && i2c->reg06_request == msgs) {
+		i2c->reg06_pending->master_calls++;
+		if (i2c->id == 0 && !i2c->appm && !i2c->gpupm &&
+		    !i2c->have_pmic && !i2c->have_dcm &&
+		    !i2c->use_push_pull && !i2c->buffermode &&
+		    !i2c->is_hw_trig && !i2c->ext_data.isEnable &&
+		    i2c->speed_hz == 400000 && i2c->clk_src_div == 10 &&
+		    adap->timeout == 2 * HZ && adap->retries == 1 &&
+		    i2c->dev_comp && i2c->dev_comp->dma_support == 1) {
+			i2c->reg06_active = i2c->reg06_pending;
+			i2c->reg06_active->controller_ok = true;
+		}
+	}
 	ret = __mt_i2c_transfer(i2c, msgs, num);
+	i2c->reg06_active = NULL;
 	mutex_unlock(&i2c->i2c_mutex);
 
 	mt_i2c_clock_disable(i2c);
@@ -1104,6 +1129,32 @@ static const struct of_device_id mtk_i2c_of_match[] = {
 
 MODULE_DEVICE_TABLE(of, mtk_i2c_of_match);
 
+/* Caller owns the bound charger's existing read; no additional transaction. */
+int gemini_reg06_transfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+			  struct gemini_reg06_record *record)
+{
+	struct mt_i2c *i2c;
+	int ret;
+
+	if (adap->algo != &mt_i2c_algorithm || adap->nr != 0 ||
+	    msgs[0].addr != 0x6b || msgs[1].addr != 0x6b ||
+	    msgs[0].flags || msgs[1].flags != I2C_M_RD ||
+	    msgs[0].len != 1 || msgs[1].len != 1 ||
+	    !msgs[0].buf || !msgs[1].buf || msgs[0].buf[0] != 6)
+		return i2c_transfer(adap, msgs, 2);
+
+	i2c_lock_adapter(adap);
+	i2c = i2c_get_adapdata(adap);
+	i2c->reg06_request = msgs;
+	i2c->reg06_pending = record;
+	ret = __i2c_transfer(adap, msgs, 2);
+	i2c->reg06_pending = NULL;
+	i2c->reg06_request = NULL;
+	i2c_unlock_adapter(adap);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gemini_reg06_transfer);
+
 static int mt_i2c_probe(struct platform_device *pdev)
 {
 	int ret = 0;
diff --git a/drivers/i2c/busses/i2c-mtk.h b/drivers/i2c/busses/i2c-mtk.h
index 772ff82..594956e 100644
--- a/drivers/i2c/busses/i2c-mtk.h
+++ b/drivers/i2c/busses/i2c-mtk.h
@@ -14,6 +14,8 @@
 #ifndef __I2C_MTK_H__
 #define __I2C_MTK_H__
 
+#include <linux/gemini-reg06-observer.h>
+
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/slab.h>
@@ -224,6 +226,9 @@ struct mt_i2c {
 	u16 timing_reg;
 	u16 high_speed_reg;
 	struct mutex i2c_mutex;
+	struct gemini_reg06_record *reg06_pending;
+	struct gemini_reg06_record *reg06_active;
+	struct i2c_msg *reg06_request;
 	struct mt_i2c_ext ext_data;
 	bool is_hw_trig;
 	const struct mtk_i2c_compatible *dev_comp;
diff --git a/drivers/misc/mediatek/power/mt6797/bq25890.c b/drivers/misc/mediatek/power/mt6797/bq25890.c
index a878731..4cf8b32 100644
--- a/drivers/misc/mediatek/power/mt6797/bq25890.c
+++ b/drivers/misc/mediatek/power/mt6797/bq25890.c
@@ -16,6 +16,7 @@
 #include <linux/module.h>	/* For MODULE_ marcros  */
 #include <linux/platform_device.h>
 #include <linux/i2c.h>
+#include <linux/gemini-reg06-observer.h>
 #include <linux/slab.h>
 #include <linux/delay.h>
 #ifdef CONFIG_OF
@@ -127,12 +128,61 @@ unsigned int bq25890_write_byte(unsigned char cmd, unsigned char writeData)
 	return 1;
 }
 #else
-unsigned int bq25890_read_byte(unsigned char cmd, unsigned char *returnData)
+/* Diagnostic-only; all state is protected by bq25890_i2c_access. */
+static bool reg06_observer;
+module_param(reg06_observer, bool, 0400);
+MODULE_PARM_DESC(reg06_observer, "Allow one passive REG06 observation");
+
+/* 0 idle, 1 armed, 2 consumed/in flight, 3 terminal. No rearm. */
+static unsigned int reg06_state;
+static struct gemini_reg06_record reg06_record;
+
+static ssize_t reg06_observe_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct gemini_reg06_record *r = &reg06_record;
+	ssize_t size;
+
+	mutex_lock(&bq25890_i2c_access);
+	if (!reg06_observer) {
+		size = scnprintf(buf, PAGE_SIZE, "disabled\n");
+	} else if (!reg06_state) {
+		reg06_state = 1;
+		size = scnprintf(buf, PAGE_SIZE, "armed\n");
+	} else if (reg06_state != 3) {
+		size = scnprintf(buf, PAGE_SIZE, "pending\n");
+	} else if (gemini_reg06_valid(r)) {
+		size = scnprintf(buf, PAGE_SIZE,
+				 "ok ret=%d calls=%d transfers=%d irq=%x fifo=%u value=%02x\n",
+				 r->result, r->master_calls, r->transfers, r->irq,
+				 r->fifo_count, r->value);
+	} else {
+		size = scnprintf(buf, PAGE_SIZE,
+				 "failed ret=%d calls=%d transfers=%d irq=%x fifo_seen=%u fifo=%u controller=%u fifo_path=%u wrrd=%u\n",
+				 r->result, r->master_calls, r->transfers, r->irq,
+				 r->fifo_seen, r->fifo_count, r->controller_ok,
+				 r->fifo_path, r->wrrd);
+	}
+	mutex_unlock(&bq25890_i2c_access);
+	return size;
+}
+
+static DEVICE_ATTR(reg06_observe, 0400, reg06_observe_show, NULL);
+
+static unsigned int bq25890_read_byte_observed(unsigned char cmd,
+					       unsigned char *data, bool eligible)
 {
 	unsigned char xfers = 2;
 	int ret, retries = 1;
+	bool observe;
 
 	mutex_lock(&bq25890_i2c_access);
+	observe = eligible && cmd == 6 && reg06_observer &&
+		reg06_state == 1;
+	if (observe) {
+		reg06_state = 2;
+		memset(&reg06_record, 0, sizeof(reg06_record));
+	}
 
 	do {
 		struct i2c_msg msgs[2] = {
@@ -147,7 +197,7 @@ unsigned int bq25890_read_byte(unsigned char cmd, unsigned char *returnData)
 				.addr = new_client->addr,
 				.flags = I2C_M_RD,
 				.len = 1,
-				.buf = returnData,
+				.buf = data,
 			}
 		};
 
@@ -155,7 +205,11 @@ unsigned int bq25890_read_byte(unsigned char cmd, unsigned char *returnData)
 		 * Avoid sending the segment addr to not upset non-compliant
 		 * DDC monitors.
 		 */
-		ret = i2c_transfer(new_client->adapter, msgs, xfers);
+		if (observe)
+			ret = gemini_reg06_transfer(new_client->adapter, msgs,
+						    &reg06_record);
+		else
+			ret = i2c_transfer(new_client->adapter, msgs, xfers);
 
 		if (ret == -ENXIO) {
 			battery_log(BAT_LOG_CRTI, "skipping non-existent adapter %s\n", new_client->adapter->name);
@@ -163,11 +217,22 @@ unsigned int bq25890_read_byte(unsigned char cmd, unsigned char *returnData)
 		}
 	} while (ret != xfers && --retries);
 
+	if (observe) {
+		reg06_record.result = ret;
+		if (gemini_reg06_valid(&reg06_record))
+			reg06_record.value = *data;
+		reg06_state = 3;
+	}
 	mutex_unlock(&bq25890_i2c_access);
 
 	return ret == xfers ? 1 : -1;
 }
 
+unsigned int bq25890_read_byte(unsigned char cmd, unsigned char *data)
+{
+	return bq25890_read_byte_observed(cmd, data, false);
+}
+
 unsigned int bq25890_write_byte(unsigned char cmd, unsigned char writeData)
 {
 	unsigned char xfers = 1;
@@ -237,7 +302,8 @@ unsigned int bq25890_config_interface(unsigned char RegNum, unsigned char val, u
 	unsigned int ret = 0;
 
 	mutex_lock(&bq25890_access_mutex);
-	ret = bq25890_read_byte(RegNum, &bq25890_reg);
+	ret = bq25890_read_byte_observed(RegNum, &bq25890_reg,
+					 RegNum == 6 && MASK == 0x3f && SHIFT == 2);
 
 	bq25890_reg_ori = bq25890_reg;
 	bq25890_reg &= ~(MASK << SHIFT);
@@ -1130,6 +1196,9 @@ static int bq25890_user_space_probe(struct platform_device *dev)
 	battery_log(BAT_LOG_CRTI, "******** bq25890_user_space_probe!! ********\n");
 
 	ret_device_file = device_create_file(&(dev->dev), &dev_attr_bq25890_access);
+	if (reg06_observer &&
+	    device_create_file(&dev->dev, &dev_attr_reg06_observe))
+		dev_warn(&dev->dev, "REG06 observer unavailable\n");
 
 	return 0;
 }
diff --git a/include/linux/gemini-reg06-observer.h b/include/linux/gemini-reg06-observer.h
new file mode 100644
index 0000000..41c3b69
--- /dev/null
+++ b/include/linux/gemini-reg06-observer.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _GEMINI_REG06_OBSERVER_H
+#define _GEMINI_REG06_OBSERVER_H
+
+#include <linux/types.h>
+
+#ifdef CONFIG_MTK_I2C_EXTENSION
+#error "Gemini REG06 observer requires native I2C messages"
+#endif
+
+struct i2c_adapter;
+struct i2c_msg;
+
+struct gemini_reg06_record {
+	int master_calls;
+	int transfers;
+	int result;
+	u16 irq;
+	u8 fifo_count;
+	u8 value;
+	bool controller_ok;
+	bool fifo_path;
+	bool wrrd;
+	bool fifo_seen;
+};
+
+static inline bool gemini_reg06_valid(const struct gemini_reg06_record *r)
+{
+	return r->result == 2 && r->master_calls == 1 && r->transfers == 1 &&
+		r->controller_ok && r->fifo_path && r->wrrd && r->fifo_seen &&
+		r->fifo_count == 1 && (r->irq & 1) && !(r->irq & 6);
+}
+
+int gemini_reg06_transfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+			  struct gemini_reg06_record *record);
+
+#endif
-- 
2.39.5

