# This inherited recovery wrapper is present but forbidden by this session.
set -eu
[ "$#" -eq 1 ] || exit 2
expected_boot=$1
case "$expected_boot" in
  ????????-????-????-????-????????????) ;;
  *) exit 2 ;;
esac
case "$expected_boot" in
  *[!0-9a-f-]*) exit 2 ;;
esac
boot_id=$(/bin/busybox cat /proc/sys/kernel/random/boot_id) || exit 3
[ "$boot_id" = "$expected_boot" ] || exit 3
[ "$(/bin/busybox cat /run/a53/boot-id)" = "$boot_id" ] || exit 3
[ ! -e /run/toprgu/restart-claimed ] || exit 4
/bin/busybox mkdir /run/toprgu/restart-claimed || exit 4
# Re-read both identities after the one-shot claim and immediately before the
# marker and reboot. A boot change after host sealing reaches no effect.
boot_id=$(/bin/busybox cat /proc/sys/kernel/random/boot_id) || exit 3
[ "$boot_id" = "$expected_boot" ] || exit 3
[ "$(/bin/busybox cat /run/a53/boot-id)" = "$boot_id" ] || exit 3
printf 'GEMINI_CONSYS_PASSIVE_V1 contract=consys-passive-boot-v1 inherited_wrapper=busybox-reboot-n-f-v1 candidate=%s input_id=%s boot_id=%s phase=forbidden-wrapper-request count=1\n' '7.1.3-gemini-consys-passive' 'INPUT_ID_PLACEHOLDER' "$boot_id" >/dev/kmsg
exec /bin/busybox reboot -n -f
