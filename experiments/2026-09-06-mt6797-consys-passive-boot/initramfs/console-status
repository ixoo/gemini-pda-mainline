#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# shellcheck shell=dash
export PATH=/bin TERM=linux
umask 077
/bin/busybox chvt 1 || exit 1
/bin/busybox stty sane || exit 1
/bin/busybox clear
printf '%s\n' 'Gemini passive CONSYS observation candidate' 'USB administration requires the prepared SSH key.'
printf '%s\n' 'This screen accepts no commands. Follow the admitted session packet.'
printf 'console=ready\n' >/run/toprgu/console.status
