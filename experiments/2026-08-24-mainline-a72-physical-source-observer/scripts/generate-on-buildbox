#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=6e3b726cd84b346409bb14b6fb66652b7a52aae60a4636b39229e949275d961f
readonly PARENT_SOURCE_INTEGRITY=75be833a675873a374e1b4ef1c77ba0557307b4d054eab793e31930d097785dd
readonly SOC_KCONFIG_SHA256=6c3279d60ce69bec699bdcacb1abb23ccfeb0b7f1dd926b42062d88aec7b147b
readonly SOC_MAKEFILE_SHA256=d24018e5561312249ef0743b3471d184588a504329b39fa7580bdefc4b398e0d
readonly PSTORE_KCONFIG_SHA256=04038cb9a1fadea83f5957debe20586e117665a24cfa2f80db590997e6594018
readonly LEDGER_SHA256=8bdba6319719c2d083fcfd4e60e2b78d5251b436d4959241bad88396878b024d
readonly DTS_MAKEFILE_SHA256=a82046b54ec73518a0182c4a56e942586377159d4c337f48211e874fce4414ce

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" &&
	! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'
[[ -f "$source_root/.gemini-source-integrity" &&
	! -L "$source_root/.gemini-source-integrity" ]] ||
	die 'prepared source integrity marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity changed'

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
experiment_dir=$(cd -- "$script_dir/.." && pwd -P)
repository_dir=$(cd -- "$experiment_dir/../.." && pwd -P)
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" \
	verify "$source_root")
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] ||
	die 'prepared source integrity verification failed'

readonly work_root=/workspace/gemini-pda/a72-physical-source-work
readonly package="$output_root/a72-physical-source-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'

if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated A72 physical-source patches at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work=$(mktemp -d "$work_root/generation.XXXXXX")
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] ||
		rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] ||
		rm -rf -- "$partial"
}
trap cleanup EXIT

for relative in \
	drivers/soc/mediatek/Kconfig \
	drivers/soc/mediatek/Makefile \
	fs/pstore/Kconfig \
	fs/pstore/gemini_protected_readback_ledger.c \
	arch/arm64/boot/dts/mediatek/Makefile; do
	mkdir -p "$work/source/$(dirname "$relative")"
	cp -- "$source_root/$relative" "$work/source/$relative"
done

check_file() {
	local expected=$1
	local relative=$2
	printf '%s  %s\n' "$expected" "$work/source/$relative" |
		sha256sum --check --status || die "parent source changed: $relative"
}
check_file "$SOC_KCONFIG_SHA256" drivers/soc/mediatek/Kconfig
check_file "$SOC_MAKEFILE_SHA256" drivers/soc/mediatek/Makefile
check_file "$PSTORE_KCONFIG_SHA256" fs/pstore/Kconfig
check_file "$LEDGER_SHA256" fs/pstore/gemini_protected_readback_ledger.c
check_file "$DTS_MAKEFILE_SHA256" arch/arm64/boot/dts/mediatek/Makefile

git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- .
GIT_AUTHOR_DATE=2026-08-24T20:00:00Z \
GIT_COMMITTER_DATE=2026-08-24T20:00:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'A72 physical-source observer canonical parent'
parent_commit=$(git -C "$work/source" rev-parse HEAD)
readonly parent_commit

commit_phase() {
	local date=$1
	local subject=$2
	local body=$3
	git -C "$work/source" diff --check
	git -C "$work/source" add -- .
	git -C "$work/source" diff --cached --check
	GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
	GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
	GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
	GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
	GIT_AUTHOR_DATE="$date" GIT_COMMITTER_DATE="$date" \
		git -C "$work/source" commit --quiet --no-gpg-sign \
			-m "$subject" -m "$body"
}

run_phase() {
	local phase=$1
	PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
		--source-root "$work/source" --phase "$phase"
	PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
		--source-root "$work/source" --phase "$phase"
}

run_phase ledger
commit_phase 2026-08-24T20:01:00Z \
	'pstore: add Gemini A72 physical-source ledger mode' \
	'Give the candidate-only direct source exact first-dmesg records before and after its one BigiDVFS read. Reuse the qualified all-ones gate, signature-last commit, full readback, two-write ceiling, and no-clear/no-retry policy.'

run_phase observer
commit_phase 2026-08-24T20:02:00Z \
	'soc: mediatek: add A72 direct physical-source observer' \
	'Retain three bound source devices, temporarily register one exact direct callback, compose platform, DA921x, clock, retained checkpoints, and BigiDVFS in fixed order, then unregister before releasing references. Publish no transition decision and request no CPU.'

run_phase binding
commit_phase 2026-08-24T20:03:00Z \
	'dt-bindings: soc: mediatek: add A72 physical-source observer' \
	'Describe the candidate-only observer and its three bound component phandles without making it a state owner or transition consumer.'

run_phase dts
commit_phase 2026-08-24T20:04:00Z \
	'arm64: dts: mediatek: add Gemini physical-source candidate' \
	'Add a separate Gemini DTB that enables only the three read-only sources and one-shot direct observer. Leave the ordinary board DT unchanged.'

run_phase tests
commit_phase 2026-08-24T20:05:00Z \
	'soc: mediatek: test A72 physical-source observer' \
	'Use injected in-memory readers and runtime operations to cover the exact six-stage capture order, every failure boundary, all-zero results, and register/snapshot/unregister lifetime without touching hardware or retained RAM.'

result_commit=$(git -C "$work/source" rev-parse HEAD)
readonly result_commit

mkdir -p "$partial/patches" "$partial/provenance"
mapfile -t generated < <(git -C "$work/source" format-patch \
	--no-signature --output-directory "$partial/patches" \
	"${parent_commit}..${result_commit}")
[[ "${#generated[@]}" -eq 5 ]] || die 'generated patch count changed'
readonly patches=(
	0350-pstore-add-Gemini-A72-physical-source-ledger-mode.patch
	0351-soc-mediatek-add-A72-direct-physical-source-observer.patch
	0352-dt-bindings-soc-mediatek-add-A72-physical-source-observer.patch
	0353-arm64-dts-mediatek-add-Gemini-physical-source-candidate.patch
	0354-soc-mediatek-test-A72-physical-source-observer.patch
)
for index in "${!patches[@]}"; do
	mv -- "${generated[$index]}" "$partial/patches/${patches[$index]}"
done
printf '%s\n' "${patches[@]}" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patches.py" \
	--patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$parent_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
for patch in "${patches[@]}"; do
	git -C "$work/verify" am --quiet --committer-date-is-author-date \
		"$partial/patches/$patch"
done
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$result_commit" ]] ||
	die 'patch replay did not reproduce generated commit'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/verify" --phase tests
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

for patch in "${patches[@]}"; do
	if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
		--ignore MISSING_SIGN_OFF,COMMIT_LOG_LONG_LINE,FILE_PATH_CHANGES \
		"$partial/patches/$patch" \
		>"$partial/provenance/checkpatch-${patch%.patch}.txt"; then
		cat "$partial/provenance/checkpatch-${patch%.patch}.txt" >&2
		die "strict checkpatch rejected $patch"
	fi
done

cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-a72-physical-source-observer
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
parent_source_integrity=$PARENT_SOURCE_INTEGRITY
parent_commit=$parent_commit
result_commit=$result_commit
generated_patch_count=5
source_registrations=1
source_callbacks=1
source_unregistrations=1
component_order=platform-provider-clock-checkpoint0-bigidvfs-checkpoint1
retained_token=GPSQ-20260824-A
retained_slots=1,2
retained_maximum_writes=2
clock_calls=1
bigidvfs_calls=1
bigidvfs_smc_reads=8
compositor_retries=0
provider_transactions=0
publisher_calls=0
owner_mutations=0
cpu_requests=0
hardware_free_tests=4
device_action=none
boot_candidate=false
EOF
printf '%s\n' "${patches[@]}" >"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated A72 physical-source patches at %s\n' "$package"
