#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=1db1fb912bc7a0f35e4511f314d4300e52d0ab4f687b4b06a1556d8b687b5f3b
readonly ARM64_KCONFIG_SHA256=3d68d6d08ff9f6da5a014bda607dc4dcf4b86a3753fcd13af04c48bc65a52987
readonly ARM64_PLATFORM_KCONFIG_SHA256=c6cad2cd07fae22439b7221ca217b87ae5d2ccb4426244802dcf45e578bc0783
readonly ARM64_MAKEFILE_SHA256=75e9b95431c33cfb3b17e484889c891acd00e8d93be26ea0f70e3e811846a89a
readonly ARM64_SMP_SHA256=f9f23ef0702733df793e969f200a4237bd28ebc5e3d5069e413f32e95b5e6599
readonly MEMBERSHIP_HEADER_SHA256=6126bbad3bdfe998d3281edcffd28a8f637d098218337085561bc00ebb396d30
readonly MEMBERSHIP_SOURCE_SHA256=8287ce26bcb05bcfe2ab58e1d76218a8a767ec99d82f981ae9a7d1f95234741d
readonly MT6797_PSCI_SHA256=7e3329797e0f2eebc4372aa47c84c09e3c2ed85e5121f9492898727db5e4f83d
readonly MTK_WDT_SOURCE_SHA256=08c7e94770ad4ccbf299beca17fe43de473167a1dde12fa0bd4d8dd159c4714d

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3 ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" && ! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
experiment_dir="$(cd -- "$script_dir/.." && pwd -P)"
repository_dir="$(cd -- "$experiment_dir/../.." && pwd -P)"
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root" |
	grep -E '^source_tree_integrity=[0-9a-f]{64}$' >/dev/null ||
	die 'prepared source integrity verification failed'

check_file() {
	local expected=$1
	local relative=$2
	printf '%s  %s\n' "$expected" "$source_root/$relative" |
		sha256sum --check --status || die "parent source changed: $relative"
}
check_file "$ARM64_KCONFIG_SHA256" arch/arm64/Kconfig
check_file "$ARM64_PLATFORM_KCONFIG_SHA256" arch/arm64/Kconfig.platforms
check_file "$ARM64_MAKEFILE_SHA256" arch/arm64/kernel/Makefile
check_file "$ARM64_SMP_SHA256" arch/arm64/kernel/smp.c
check_file "$MEMBERSHIP_HEADER_SHA256" arch/arm64/include/asm/mt6797_a72_membership.h
check_file "$MEMBERSHIP_SOURCE_SHA256" arch/arm64/kernel/mt6797_a72_membership.c
check_file "$MT6797_PSCI_SHA256" arch/arm64/kernel/mt6797_psci.c
check_file "$MTK_WDT_SOURCE_SHA256" drivers/watchdog/mtk_wdt.c

readonly work_root=/workspace/gemini-pda/a72-a34-eligibility-work
readonly package="$output_root/a72-a34-eligibility-patch-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'

if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated A34 evaluator patch review at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work="$(mktemp -d "$work_root/generation.XXXXXX")"
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] || rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] || rm -rf -- "$partial"
}
trap cleanup EXIT

mkdir -p "$work/source/arch/arm64/include/asm" \
	"$work/source/arch/arm64/kernel"
cp -- "$source_root/arch/arm64/Kconfig" \
	"$source_root/arch/arm64/Kconfig.platforms" "$work/source/arch/arm64/"
cp -- "$source_root/arch/arm64/include/asm/mt6797_a72_membership.h" \
	"$work/source/arch/arm64/include/asm/"
cp -- "$source_root/arch/arm64/kernel/Makefile" \
	"$source_root/arch/arm64/kernel/smp.c" \
	"$source_root/arch/arm64/kernel/mt6797_a72_membership.c" \
	"$source_root/arch/arm64/kernel/mt6797_psci.c" \
	"$work/source/arch/arm64/kernel/"
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- arch
GIT_AUTHOR_DATE=2026-08-20T23:00:00Z \
GIT_COMMITTER_DATE=2026-08-20T23:00:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'Gate 7 A34 eligibility source parent'
baseline_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly baseline_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/source"
git -C "$work/source" diff --check
git -C "$work/source" add -- arch
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-20T23:01:00Z \
GIT_COMMITTER_DATE=2026-08-20T23:01:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'arm64: add A72 A34 eligibility evaluator' \
		-m 'Evaluate only an immutable exact-zero tuple carrying explicit platform or external reset provenance and owner-safe private replay-zero proof.' \
		-m 'Add no production caller or state mutation; keep the owner, admission, provider, P27/P28, P30, CPU_ON, CPU_OFF, and device effects closed.'
result_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly result_commit

mkdir -p "$partial/patches" "$partial/provenance"
readonly patch_name=0302-arm64-add-A72-A34-eligibility-evaluator.patch
generated="$(git -C "$work/source" format-patch -1 --no-signature \
	--output-directory "$partial/patches")"
[[ -f "$generated" ]] || die 'generated patch absent'
mv -- "$generated" "$partial/patches/$patch_name"
printf '%s\n' "$patch_name" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patches.py" \
	--patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$baseline_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date \
	"$partial/patches/$patch_name"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$result_commit" ]] ||
	die 'patch replay did not reproduce generated commit'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/verify"
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
	--ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE \
	"$partial/patches/$patch_name" >"$partial/provenance/checkpatch.txt"; then
	cat "$partial/provenance/checkpatch.txt" >&2
	die 'strict checkpatch rejected generated patch'
fi

cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-a72-a34-eligibility-evaluator
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
baseline_commit=$baseline_commit
result_commit=$result_commit
generated_patch_count=1
observation_mutations=every-byte
accepted_reset_provenance_cases=2
kunit_case_count=5
production_hook=none
opens_owner=false
state_mutation=false
transaction_caller=false
provider_call=false
p27_p28_effect=false
p30_mutation=false
cpu_on=false
cpu_off=false
hardware_action=none
device_action=none
boot_candidate=false
EOF
printf '%s\n' "$patch_name" >"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated A34 evaluator patch review at %s\n' "$package"
