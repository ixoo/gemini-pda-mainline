#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=292db59582fe1842fa3e94960bcf1ea508fa9ee126b88c8de289bfa223517079
readonly PARENT_INTEGRITY=8af2140b302516d30df7845745de98df644a63d3eef856a8efc392b94946d0a6
readonly PARENT_MEMBERSHIP_SHA256=8f13777e4dc4a6c9a693f81d10ee133cce61db59172fe4f09cdfb1d2f7aa5c73
readonly PATCH=0301-arm64-reject-malformed-A72-provider-release-ABI.patch

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3 ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
experiment_dir=$(cd -- "$script_dir/.." && pwd -P)
repository_dir=$(cd -- "$experiment_dir/../.." && pwd -P)
readonly script_dir experiment_dir repository_dir
readonly source_file=arch/arm64/kernel/mt6797_a72_membership.c

[[ -f "$source_root/.gemini-source-state" &&
	! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'
integrity=$("$repository_dir/scripts/source-tree-integrity" verify "$source_root")
readonly integrity
[[ "$integrity" == "source_tree_integrity=$PARENT_INTEGRITY" ]] ||
	die 'prepared parent integrity changed'
printf '%s  %s\n' "$PARENT_MEMBERSHIP_SHA256" \
	"$source_root/$source_file" | sha256sum --check --status ||
	die 'parent membership source changed'
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate.py"

readonly work_root=/workspace/gemini-pda/da921x-pre-p28-provider-abort-release-abi-work
readonly package="$output_root/da921x-pre-p28-provider-abort-release-abi-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'
if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated DA921x pre-P28 release-ABI patch at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work=$(mktemp -d "$work_root/generation.XXXXXX")
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] ||
		rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] ||
		rm -rf -- "$partial"
}
trap cleanup EXIT

mkdir -p "$work/source/arch/arm64/kernel" "$partial/patches" \
	"$partial/provenance"
cp -- "$source_root/$source_file" "$work/source/$source_file"
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- "$source_file"
GIT_AUTHOR_DATE=2026-08-20T20:07:00Z \
GIT_COMMITTER_DATE=2026-08-20T20:07:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'Gate 7 provider-release ABI parent'
baseline_commit=$(git -C "$work/source" rev-parse HEAD)
readonly baseline_commit

python3 - "$work/source/$source_file" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
old = """\tret = mt6797_a72_provider_release(&handle, response);
\tif (ret)
\t\tgoto out_fault;

\tproof.abi = MT6797_A72_PROVIDER_ABORT_ABI;
"""
new = """\tret = mt6797_a72_provider_release(&handle, response);
\tif (ret)
\t\tgoto out_fault;
\tif (response->abi != MT6797_A72_PROVIDER_CALL_ABI) {
\t\tret = -EPROTO;
\t\tgoto out_fault;
\t}

\tproof.abi = MT6797_A72_PROVIDER_ABORT_ABI;
"""
if text.count(old) != 1:
    raise SystemExit("provider release ABI edit anchor changed")
path.write_text(text.replace(old, new), encoding="utf-8")
PY
PYTHONDONTWRITEBYTECODE=1 python3 \
	"$script_dir/validate_release_abi_fix_source.py" \
	--source-file "$work/source/$source_file"
git -C "$work/source" diff --check
git -C "$work/source" add -- "$source_file"
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-20T20:08:00Z \
GIT_COMMITTER_DATE=2026-08-20T20:08:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'arm64: reject malformed A72 provider release ABI' \
		-m 'Require the provider call ABI before accepting release proof.' \
		-m 'Treat a mismatched callback response as terminal ambiguity.'
fixed_commit=$(git -C "$work/source" rev-parse HEAD)
readonly fixed_commit
[[ "$(git -C "$work/source" diff-tree --no-commit-id --name-only -r \
	"$fixed_commit")" == "$source_file" ]] || die 'release-ABI fix touched extra paths'

git -C "$work/source" format-patch -1 --no-signature --numbered \
	--start-number 1 --output-directory "$partial/patches" >/dev/null
generated=$(find "$partial/patches" -maxdepth 1 -type f \
	-name '0001-*.patch' -print)
[[ -n "$generated" ]] || die 'normal release-ABI patch absent'
mv -- "$generated" "$partial/patches/$PATCH"
printf '%s\n' "$PATCH" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 \
	"$script_dir/validate_release_abi_fix_patch.py" \
	--patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$baseline_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date \
	"$partial/patches/$PATCH"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$fixed_commit" ]] ||
	die 'normal patch replay did not reproduce release-ABI commit'
PYTHONDONTWRITEBYTECODE=1 python3 \
	"$script_dir/validate_release_abi_fix_source.py" \
	--source-file "$work/verify/$source_file"
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
	--ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE \
	"$partial/patches/$PATCH" >"$partial/provenance/checkpatch.txt"; then
	cat "$partial/provenance/checkpatch.txt" >&2
	die 'strict checkpatch rejected release-ABI patch'
fi

final_membership_sha256=$(sha256sum "$work/source/$source_file" | cut -d' ' -f1)
readonly final_membership_sha256
cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-da921x-pre-p28-provider-abort-release-abi-fix
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
parent_source_integrity=$PARENT_INTEGRITY
parent_membership_sha256=$PARENT_MEMBERSHIP_SHA256
baseline_commit=$baseline_commit
fixed_commit=$fixed_commit
final_membership_sha256=$final_membership_sha256
generated_patch_count=1
response_abi_checks=1
production_code_changed=true
production_reachability_changed=false
hardware_action=none
device_action=none
boot_candidate=false
physical_da921x_write_authorized=false
p28_effect=false
cpu_on=false
cpu_off=false
cpu8_cpu9_admission=closed
EOF
printf '%s\n' "$PATCH" >"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated DA921x pre-P28 release-ABI patch at %s\n' "$package"
