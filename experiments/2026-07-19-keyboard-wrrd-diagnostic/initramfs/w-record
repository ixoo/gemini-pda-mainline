#!/bin/busybox sh
# shellcheck shell=dash

readonly MARKER='GEMINI_KEYBOARD_WRRD_20260719_W'
line="$MARKER $*"

printf '%s\n' "$line" >>/run/w-status 2>/dev/null || true
if [ -c /dev/kmsg ]; then
	printf '<6>%s\n' "$line" >/dev/kmsg 2>/dev/null || true
fi
for output in /dev/ttyS0; do
	[ -c "$output" ] || continue
	printf '%s\n' "$line" >"$output" 2>/dev/null || true
done
