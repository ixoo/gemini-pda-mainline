#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail
export LC_ALL=C PYTHONDONTWRITEBYTECODE=1
export GIT_AUTHOR_DATE=2026-09-05T02:00:00Z GIT_COMMITTER_DATE=2026-09-05T02:00:00Z
[[ $# == 1 && $1 =~ ^[0-9a-f]{40}$ ]] || exit 2
revision=$1
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo=$(cd -- "$script_dir/../../.." && pwd -P)
source_root=/workspace/gemini-pda/src/linux-7.1.3-series-source
managed_root=/workspace/gemini-pda/thermal-observer-work
output=/workspace/gemini-pda/thermal-profile-patches
[[ "$(git -C "$repo" rev-parse HEAD)" == "$revision" ]]
[[ -z "$(git -C "$repo" status --porcelain)" ]]
[[ "$(cat "$source_root/.gemini-source-state")" == 8187a55d11ef8528f163e19f2a43383734504f09762cbc2eb980f2accf65c3f9 ]]
[[ "$(cat "$source_root/.gemini-source-integrity")" == 5cb1e30dd8367cda6961863bb483a8b9d54984bcd654d8041ecf30ed017546d8 ]]
python3 "$repo/scripts/source-tree-integrity" verify "$source_root"
[[ ! -e "$output" ]]
mkdir -p "$managed_root"
work=$(mktemp -d "$managed_root/generation.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
path=arch/arm64/kernel
mkdir -p "$work/source/$path"
cp "$source_root/$path/mt6797_psci.c" "$work/source/$path/"
(
 cd "$work/source"
 git init -q
 git config user.name 'Gemini Mainline Experiment'
 git config user.email gemini-mainline@example.invalid
 git add arch
 git -c commit.gpgsign=false commit -qm 'Pinned thermal observation profile parent'
 python3 "$script_dir/profile-source-edits.py" "$work/source"
 git add arch
 git diff --cached --check
 git -c commit.gpgsign=false commit -qm 'arm64: bind Gemini thermal snapshot configuration' \
  -m 'Accept the exact thermal snapshot config-input identity only under the explicitly enabled thermal observer. Preserve the previously accepted frequency observer and physical lifecycle configurations.'
 mkdir "$work/patches"
 git format-patch -1 --no-signature --numbered --output-directory "$work/patches" >/dev/null
)
patches=("$work"/patches/*.patch)
[[ ${#patches[@]} == 1 ]]
perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
 --ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE,OPEN_ENDED_LINE \
 "${patches[@]}" >"$work/checkpatch.txt" || { cat "$work/checkpatch.txt"; exit 1; }
git clone -q "$work/source" "$work/replay"
git -C "$work/replay" reset --hard HEAD~1 >/dev/null
git -C "$work/replay" config user.name 'Gemini Mainline Experiment'
git -C "$work/replay" config user.email gemini-mainline@example.invalid
git -C "$work/replay" -c commit.gpgsign=false am -q "${patches[@]}"
[[ "$(git -C "$work/replay" rev-parse 'HEAD^{tree}')" == "$(git -C "$work/source" rev-parse 'HEAD^{tree}')" ]]
printf 'generation_revision=%s\npatches=1\nreplay=identical-tree\nproduction_driver_changes=config-input-binding-only\nhardware_access=none\n' "$revision" >"$work/generation.txt"
mkdir "$work/result"
cp "${patches[0]}" "$work/result/0540-arm64-bind-Gemini-thermal-snapshot-configuration.patch"
cp "$work/checkpatch.txt" "$work/generation.txt" "$work/result/"
(cd "$work/result" && sha256sum ./* >SHA256SUMS)
mv "$work/result" "$output"
printf 'output=%s\n' "$output"
