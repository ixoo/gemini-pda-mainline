#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# shellcheck shell=dash
# Put the connectivity firmware in RAM from the owner's own Gemian system. It reads the named
# files from /data/system.img on Gemian's linux partition, which init has already mounted
# read-only, through a read-only loop device. It starts no radio, writes to no partition, reads
# no calibration or identifier, and sends nothing anywhere. Files go at reboot.
# The three Wi-Fi files are required. The two FM files and the GNSS DSP firmware, which is built
# from libmnl.so, are copied too, but a problem with one of them never stops Wi-Fi.
# Prints one word: ready, no-gemian-system, or missing- or mismatch- with the file's name; or
# ready-missing- or ready-mismatch- with the first FM or GNSS file that is not in place.
# A file already in place, however it got there, is checked and never replaced.
# See docs/hardware/firmware.md.
export PATH=/bin
bb=/bin/busybox
dir=/lib/firmware/mediatek/mt6797
image=/mnt/data/data/system.img
source=/run/firmware-source
loop=
sum() {
    case "$1" in
    ROMv3_patch_1_0_hdr.bin) echo 450c2b0949cf879217ac9aef81b18b860982f0e69340784b448b54365d8cf630 ;;
    ROMv3_patch_1_1_hdr.bin) echo 5732c0730380e937b48ad169f2805b65e8d4a178265566c5083cb2cc2d249f1e ;;
    WIFI_RAM_CODE_6797) echo a69383d74d829430487c39eef6b5e281b25f901595c903a632a10aa8631426dd ;;
    mt6631_fm_v1_patch.bin) echo ba35c74d26660729caf83b41a567e700f633b6c99384dfa6cbb3c17ceb767e26 ;;
    mt6631_fm_v1_coeff.bin) echo d32f4a16b35f950ed1a57f2ae88f77ac4b5674d5c4210b65f6fe7912901fd8db ;;
    gnss_dsp_6797.bin) echo a99cacea8b7509d310d2b66e29fe71f3ed5c6b775c0a8a825f1c6a021370f497 ;;
    esac
}
names='ROMv3_patch_1_0_hdr.bin ROMv3_patch_1_1_hdr.bin WIFI_RAM_CODE_6797'
extras='mt6631_fm_v1_patch.bin mt6631_fm_v1_coeff.bin gnss_dsp_6797.bin'
note=
matches() { [ "$($bb sha256sum "$1" | $bb cut -d' ' -f1)" = "$(sum "$2")" ]; }
leave() {
    $bb grep -q " $source " /proc/mounts && $bb umount "$source"
    [ -z "$loop" ] || $bb losetup -d "$loop"
    $bb rm -f "$dir"/*.partial
    $bb rmdir "$source" 2>/dev/null
    echo "$1"
    case "$1" in ready*) exit 0 ;; *) exit 1 ;; esac
}
# An FM or GNSS file that cannot be put in place is noted, once, and left out.
extra() {
    [ -n "$note" ] || note=-$1-$2
    $bb rm -f "$dir/$2.partial"
}
# The GNSS firmware is the boot header libmnl.so builds in code, rebuilt here the same way, then
# the image. libmnl.so (a2e3fe69...330f) stores an 8-byte descriptor just before the image: its
# size in words, two DSP addresses and a key. The rest of the header comes from two tables in
# libmnl.so and values it derives from the 26 MHz crystal. The result's hash is checked as usual.
# shellcheck disable=SC2016 # the awk program's own variables
gnss_dsp() {
    desc=2008661
    {
        $bb od -An -v -tu1 -j "$desc" -N 8 "$1" | $bb sed 's/^/D /'
        $bb od -An -v -tu1 -j $((0xd2c00 + 5 * 72)) -N 72 "$1" | $bb sed 's/^/R /'
        $bb od -An -v -tu1 -j $((0xd2f16)) -N 20 "$1" | $bb sed 's/^/T /'
        $bb od -An -v -tu1 -j $((desc + 8)) -N 61440 "$1" | $bb sed 's/^/I /'
    } | $bb awk '
    function rnd(x,  f, c) { f = int(x); if (x < 0 && f != x) f--; c = (f == x) ? f : f + 1; return (x < (f + c) * 0.5) ? f : c }
    function w(o, v) { h[o] = v % 256; h[o + 1] = int(v / 256) % 256 }
    $1 == "D" { for (i = 2; i <= NF; i++) d[nd++] = $i; next }
    $1 == "R" { for (i = 2; i <= NF; i++) r[nr++] = $i; next }
    $1 == "T" { for (i = 2; i <= NF; i++) t[nt++] = $i; next }
    $1 == "I" { for (i = 2; i <= NF; i++) { if (($i == 170 || $i == 222)) st[int(n / 1400)]++; n++ } }
    END {
        clk = 26000000; mhz = clk / 1e6
        for (i = 0; i < 106; i++) h[i] = 0
        h[0] = 26; w(6, int(clk / 57600)); w(8, int(clk / 38400))
        for (i = 0; i < 8; i++) h[14 + i] = d[i]
        frags = int((n + 8 + 1391) / 1400)
        for (i = 0; i < frags; i++) count += st[i] >= 14 ? 2 : 1
        w(22, count); h[28] = 5
        # Values libmnl derives from the crystal; two come from its tables (26 MHz is entry 2).
        k = int(1571328000 / clk); v8 = rnd(((1571328000 - clk * k) * 16777216) / clk)
        v9 = rnd(16777216 * 4.092 / mhz); v10 = rnd(16777216 * 3.069 / mhz); v11 = rnd(67108864 * 1.023 / mhz)
        w(30, 157); w(32, int(v8 / 65536) % 256 + k * 256); w(34, v8 % 65536)
        w(36, rnd(157 / mhz * 3142.656 * 0.0625)); w(38, 0)
        w(40, t[2] + 256 * t[3]); w(42, t[12] + 256 * t[13])
        w(44, int(v9 / 65536)); w(46, v9 % 65536); w(48, int(v10 / 65536)); w(50, v10 % 65536)
        w(52, int(v11 / 65536)); w(54, v11 % 65536); w(56, clk / 1000 - 1)
        h[58] = 7
        # The crystal row: 18 words at a 4-byte stride, words 5 to 8 taken from one byte.
        for (i = 0; i < 18; i++) w(62 + 2 * i, (i >= 5 && i <= 8) ? r[4 * i + 1] : r[4 * i] + 256 * r[4 * i + 1])
        for (i = 0; i < 8; i++) h[98 + i] = 72 + i
        for (i = 0; i < 106; i++) printf "\\0%03o", h[i]
        print ""
    }' | { read -r esc; printf '%b' "$esc"; }
    $bb tail -c "+$((desc + 9))" "$1" | $bb head -c 61440
}
# Copy one file into place under a temporary name; the GNSS firmware is built from libmnl.so.
fetch() {
    case "$1" in
    gnss_dsp_6797.bin)
        [ -f "$source/vendor/lib/libmnl.so" ] || return 1
        gnss_dsp "$source/vendor/lib/libmnl.so" >"$dir/$1.partial" ;;
    *)
        [ -f "$source/vendor/firmware/$1" ] || return 1
        $bb cp "$source/vendor/firmware/$1" "$dir/$1.partial" ;;
    esac
}
absent=
for name in $names; do
    if [ -e "$dir/$name" ]; then
        matches "$dir/$name" "$name" || leave "mismatch-$name"
    else
        absent="$absent $name"
    fi
done
optional=
for name in $extras; do
    if [ -e "$dir/$name" ]; then
        matches "$dir/$name" "$name" || extra mismatch "$name"
    else
        optional="$optional $name"
    fi
done
[ -n "$absent$optional" ] || leave "ready$note"
# No source: Wi-Fi fails only when it still needs a file.
nosource() {
    [ -z "$absent" ] || leave no-gemian-system
    # shellcheck disable=SC2086 # a list of names
    set -- $optional
    leave "ready${note:--missing-$1}"
}
[ -f "$image" ] || nosource
# The file system is mounted read-only, and the loop device refuses writes as well, since a
# read-only ext4 mount can otherwise still clear an orphan list.
loop=$($bb losetup -f) || { loop=; nosource; }
$bb losetup -r "$loop" "$image" || { loop=; nosource; }
[ "$($bb blockdev --getro "$loop")" = 1 ] || nosource
$bb mkdir -p "$source" "$dir"
$bb mount -t ext4 -o ro,noload,nosuid,nodev,noexec "$loop" "$source" || nosource
for name in $absent; do
    fetch "$name" || leave "missing-$name"
    matches "$dir/$name.partial" "$name" || leave "mismatch-$name"
    $bb chmod 0644 "$dir/$name.partial"
    $bb mv "$dir/$name.partial" "$dir/$name"
done
for name in $optional; do
    fetch "$name" || { extra missing "$name"; continue; }
    matches "$dir/$name.partial" "$name" || { extra mismatch "$name"; continue; }
    $bb chmod 0644 "$dir/$name.partial"
    $bb mv "$dir/$name.partial" "$dir/$name"
done
leave "ready$note"
