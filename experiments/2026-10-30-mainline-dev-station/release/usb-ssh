#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# shellcheck shell=dash
# The station's usb-ssh, with a host key made in RAM on each boot, since the image
# carries none. /run/station/host-key.pub lets the tester compare it from the console.
export PATH=/bin
bb=/bin/busybox
waited=0
while [ ! -d /sys/class/net/usb0 ] && [ "$waited" -lt 30 ]; do
    $bb sleep 1
    waited=$((waited + 1))
done
[ -d /sys/class/net/usb0 ] || exec $bb sleep 30
key=/etc/dropbear/host_key
[ -s "$key" ] || /bin/dropbearkey -t ed25519 -f "$key" >/dev/null 2>>/run/station/ssh.log
/bin/dropbearkey -y -f "$key" >/run/station/host-key.pub 2>>/run/station/ssh.log
$bb ip link set usb0 up
$bb ip address replace 10.15.19.82/24 dev usb0
exec /bin/dropbear -F -s -j -k -l usb0 -p 10.15.19.82:22 \
    -D /root/.ssh -r "$key" -P /run/station/ssh-pid \
    -T 2 2>>/run/station/ssh.log
