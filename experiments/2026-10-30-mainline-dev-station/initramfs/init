#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# shellcheck shell=dash
# Development station: a RAM root that stays up, Gemian's linux partition at
# /mnt/data, SSH on USB and a shell on the console. Nothing here holds the
# boot: a failed step is recorded in /run/station/status and the rest runs.
export PATH=/bin
bb=/bin/busybox
$bb mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
$bb mount -t proc -o nosuid,nodev,noexec proc /proc
$bb mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
$bb mkdir -p /dev/pts /run /tmp /mnt/data
$bb mount -t devpts -o nosuid,noexec,mode=0620 devpts /dev/pts
$bb mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run
$bb mkdir -p /run/station
status() { $bb echo "$*" >>/run/station/status; }
$bb --install -s /bin
# The initramfs root is tmpfs when the kernel has it; cap it at 1 GiB.
if $bb mount -o remount,size=1g /; then status root=tmpfs-1g; else status root=unbounded; fi
status "cpus_online=$($bb cat /sys/devices/system/cpu/online)"
status "release=$($bb uname -r)"
status "boot_id=$($bb cat /proc/sys/kernel/random/boot_id)"
# The charging guard is built into the charger driver; nothing else stops charging below 60 C.
if [ -e /sys/class/power_supply/bq25890-charger-0/charge_control_end_threshold ]; then
    status charge-guard=bound
else
    status charge-guard=MISSING
    $bb echo "station: charge-guard=MISSING, charging is unguarded" >/dev/kmsg
fi
# The kernel's thermal zones (built in): the SoC with its trips and armed
# hardware reset, and the battery NTC with its critical trip.
for zone in /sys/class/thermal/thermal_zone*; do
    [ -d "$zone" ] && status "zone=$($bb cat "$zone/type") temp=$($bb cat "$zone/temp" 2>/dev/null)"
done
# Gemian's linux partition, found by its GPT name, never by number.
data=
waited=0
while [ "$waited" -lt 30 ]; do
    data=
    count=0
    for uevent in /sys/class/block/mmcblk0p*/uevent; do
        [ -f "$uevent" ] || continue
        if $bb grep -qx PARTNAME=linux "$uevent"; then
            data=/dev/$($bb sed -n 's/^DEVNAME=//p' "$uevent")
            count=$((count + 1))
        fi
    done
    [ "$count" -eq 1 ] && break
    $bb sleep 1
    waited=$((waited + 1))
done
if [ "$count" -ne 1 ]; then
    status "data=not-found count=$count"
elif $bb mount -t ext4 -o rw,noatime "$data" /mnt/data; then
    status "data=mounted device=$data"
else
    status "data=mount-failed device=$data"
fi
# The left Type-C chip (FUSB301, I2C 1-0025) keeps its mode through a power-off,
# so a source mode left by a test leaves the left port without VBUS or USB SSH.
# Start it as a sink unless /mnt/data/keep-left-typec-mode exists or a driver owns it.
left=/sys/bus/i2c/devices/1-0025
if [ -e /mnt/data/keep-left-typec-mode ]; then
    status left-typec=kept-by-file
elif [ -e "$left/driver" ]; then
    status left-typec=driver-owned
elif [ "$($bb i2cget -fy 1 0x25 0x01 2>/dev/null)" != 0x12 ]; then
    status left-typec=not-found
elif [ "$($bb i2cget -fy 1 0x25 0x02)" = 0x04 ]; then
    status left-typec=sink
elif $bb i2cset -fy 1 0x25 0x02 0x04 && [ "$($bb i2cget -fy 1 0x25 0x02)" = 0x04 ]; then
    status left-typec=set-sink
else
    status left-typec=set-failed
fi
# The A72s (experiments/2026-11-01-mt6797-all-cores): off until the custodian creates
# /mnt/data/a72-at-boot after the A72 soak. They load before the CPU frequency modules
# below, because the cluster clock driver keeps the words it finds at its probe and
# bringing the A72s up changes some of them. A load that never finished skips the next
# boot.
(
    marker=/mnt/data/a72-loading
    if ! $bb grep -q ' /mnt/data ' /proc/mounts; then
        status a72=skipped-no-data
    elif ! [ -e /mnt/data/a72-at-boot ]; then
        status a72=off
    elif [ -e "$marker" ]; then
        $bb rm -f "$marker"
        $bb sync
        status a72=skipped-last-load-unfinished
    elif ! $bb touch "$marker"; then
        status a72=skipped-no-data
    else
        $bb sync
        if $bb insmod "/lib/modules/$($bb uname -r)/mt6797-a72.ko"; then
            status "a72=loaded cpus=$($bb cat /sys/devices/system/cpu/online)"
        else
            status a72=failed
        fi
        $bb rm -f "$marker"
        $bb sync
    fi
)
# CPU frequency scaling (experiments/2026-11-07-mt6797-a53-cpufreq): off until the
# custodian creates /mnt/data/cpufreq-at-boot after the heat soak. Each module in the
# list loads if this image carries it, in this order: the rail providers, the cluster
# clocks, then the policies and the CCI. A load that never finished skips the next boot.
(
    marker=/mnt/data/cpufreq-loading
    if ! $bb grep -q ' /mnt/data ' /proc/mounts; then
        status cpufreq=skipped-no-data
    elif ! [ -e /mnt/data/cpufreq-at-boot ]; then
        status cpufreq=off
    elif [ -e "$marker" ]; then
        $bb rm -f "$marker"
        $bb sync
        status cpufreq=skipped-last-load-unfinished
    elif ! $bb touch "$marker"; then
        status cpufreq=skipped-no-data
    else
        $bb sync
        result=loaded
        for module in da9213-legacy-regulator mt6797-vsram-regulator clk-mt6797-mcusys \
                      cpufreq-dt mtk-cci-devfreq; do
            ko=/lib/modules/$($bb uname -r)/$module.ko
            [ -e "$ko" ] || continue
            if $bb insmod "$ko"; then
                result="$result,$module"
            else
                result="failed-at-$module"
                break
            fi
        done
        # A CCI probe can defer and still load. Unbound, nothing keeps VPROC1 up for
        # the CCI's boot rate, so unload the policies while they hold their first point.
        if [ "${result#failed}" = "$result" ] && [ -e /proc/device-tree/cci ] &&
           ! [ -e /sys/bus/platform/drivers/mtk-ccifreq/cci ]; then
            $bb rmmod mtk_cci_devfreq 2>/dev/null
            $bb rmmod cpufreq_dt 2>/dev/null
            result=failed-cci-unbound
        fi
        if [ "${result#failed}" = "$result" ]; then
            # schedutil on every policy, whatever the image's default governor.
            for policy in /sys/devices/system/cpu/cpufreq/policy*; do
                [ -e "$policy/scaling_governor" ] && $bb echo schedutil >"$policy/scaling_governor"
            done
            # Power allocator on the SoC zone; it refuses to bind, and step-wise stays,
            # unless every cooling device on the control trip has an energy model.
            for zone in /sys/class/thermal/thermal_zone*; do
                [ "$($bb cat "$zone/type" 2>/dev/null)" = soc-thermal ] || continue
                $bb echo power_allocator >"$zone/policy" 2>/dev/null || continue
                result="$result,power_allocator"
                # Binding estimates the PID gains from sustainable-power; those
                # oscillate about 9 C around 75 C. These held it within 3.4 C
                # (experiments/2026-11-08-mt6797-a53-dvfs).
                for gain in k_po=60 k_pu=60 k_i=10 integral_cutoff=3000; do
                    $bb echo "${gain#*=}" >"$zone/${gain%%=*}" 2>/dev/null
                done
            done
        fi
        status "cpufreq=$result"
        $bb rm -f "$marker"
        $bb sync
    fi
)
# A persistent root (experiments/2026-11-06-gemini-arch-root): exactly one partition
# named gemini-arch, off the eMMC, with an init. It is handed over only on a normal
# start, since LK leaves lk, nvram and boot writable in the other modes; and not if
# a key is pressed within 3 s on the console, which keeps this RAM root as the rescue.
# Otherwise every eMMC partition goes read-only, nvdata is mounted read-only, and
# systemd gets the root read-only with this image's modules, to check and remount it.
new=/newroot
arch=
count=0
waited=0
while :; do
    arch=
    count=0
    for uevent in /sys/class/block/*/uevent; do
        case $uevent in /sys/class/block/mmcblk0*) continue ;; esac
        if $bb grep -qx PARTNAME=gemini-arch "$uevent"; then
            arch=/dev/$($bb sed -n 's/^DEVNAME=//p' "$uevent")
            count=$((count + 1))
        fi
    done
    [ "$count" -ge 1 ] && break
    # Wait up to 5 s for a card that is present but not yet partitioned.
    [ "$waited" -ge 5 ] && break
    set -- /sys/class/mmc_host/mmc1/mmc1:*
    [ "$waited" -ge 1 ] && ! [ -e "$1" ] && break
    $bb sleep 1
    waited=$((waited + 1))
done
mode=$($bb od -A n -t u4 -j 8 -N 4 /sys/firmware/devicetree/base/chosen/atag,boot 2>/dev/null | $bb tr -d ' ')
handover=
if [ "$count" -eq 0 ]; then
    status arch=none
elif [ "$count" -ne 1 ]; then
    status "arch=refused count=$count"
elif [ "$mode" != 0 ]; then
    status "arch=refused boot-mode=${mode:-unknown}"
else
    $bb chvt 1
    $bb loadkmap </etc/gemini-us.bkeymap
    $bb printf '\nPress any key within 3 s to stay in the RAM shell.\n' >/dev/tty1
    # shellcheck disable=SC3045 # busybox ash has read -t and -n
    if read -r -t 3 -n 1 _ </dev/tty1; then
        status arch=kept-ram-root
        $bb printf 'Staying in the RAM shell.\n' >/dev/tty1
    else
        handover=1
    fi
fi
if [ -n "$handover" ]; then
    $bb grep -q ' /mnt/data ' /proc/mounts && { $bb sync; $bb umount /mnt/data || status data=umount-failed; }
    ro=ok
    for disk in /sys/class/block/mmcblk0 /sys/class/block/mmcblk0p*; do
        [ -e "$disk/dev" ] || continue
        $bb blockdev --setro "/dev/${disk##*/}" || ro=failed
    done
    $bb mkdir -p "$new"
    if [ "$ro" != ok ] || $bb grep -q '^/dev/mmcblk0' /proc/mounts; then
        status "arch=refused emmc-readonly=$ro"
    elif ! $bb mount -t ext4 -o ro "$arch" "$new"; then
        status "arch=mount-failed device=$arch"
    else
        # An absolute link is resolved inside the new root; a relative one,
        # as Arch has, resolves there anyway.
        target=$($bb readlink "$new/sbin/init") || target=
        case $target in /*) check=$new$target ;; *) check=$new/sbin/init ;; esac
        modules=/lib/modules/$($bb uname -r)
        if ! [ -x "$check" ]; then
            status "arch=refused no-init"
        elif ! $bb mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$new/usr/lib/modules" ||
             ! $bb cp -a "$modules" "$new/usr/lib/modules/"; then
            status arch=modules-failed
        else
            # The root carries its own copy of the Wi-Fi record; nvdata isn't mounted.
            status "arch=handover device=$arch"
            $bb printf 'Starting the root on %s.\n' "$arch" >/dev/tty1
            for fs in /dev /proc /sys /run; do
                $bb mount --move "$fs" "$new$fs"
            done
            exec $bb switch_root "$new" /sbin/init
        fi
        $bb umount "$new/usr/lib/modules" 2>/dev/null
        $bb umount "$new" 2>/dev/null
    fi
    # Not handed over: the station runs on with the eMMC read-only, so remount
    # the data partition read-only for the steps below.
    status "arch=station-continues emmc=read-only"
    if [ -n "$data" ] && $bb mount -t ext4 -o ro,noload,nosuid,nodev,noexec "$data" /mnt/data; then
        status "data=mounted-ro device=$data"
    fi
fi
# The lid policy (backlight off, keyboard inhibited while closed).
if $bb insmod "/lib/modules/$($bb uname -r)/gemini-lid.ko"; then status lid=gemini-lid; else status lid=insmod-failed; fi
# The indicator LEDs: nothing lit, and caps lock on the inside LED.
if $bb insmod "/lib/modules/$($bb uname -r)/leds-aw9120.ko"; then status leds=leds-aw9120; else status leds=insmod-failed; fi
# The vibration motor, as an idle force-feedback input device; nothing plays on it.
if $bb insmod "/lib/modules/$($bb uname -r)/regulator-haptic.ko"; then status haptic=regulator-haptic; else status haptic=insmod-failed; fi
# The Wi-Fi calibration record, copied into RAM (owner, 2026-11-07): nvdata is
# mounted only for the copy, then unmounted, so nothing keeps it mounted. The
# device goes read-only first, and noload keeps an unclean journal from being
# replayed; ext4 still clears an orphan list unless the device is read-only.
nvdata=
for uevent in /sys/class/block/mmcblk0p*/uevent; do
    $bb grep -qx PARTNAME=nvdata "$uevent" && nvdata=/dev/$($bb sed -n 's/^DEVNAME=//p' "$uevent")
done
record=/lib/firmware/mediatek/mt6797/WIFI.storage
if [ -z "$nvdata" ]; then
    status nvdata=none
elif ! $bb blockdev --setro "$nvdata"; then
    status "nvdata=setro-failed device=$nvdata"
elif ! $bb mount -t ext4 -o ro,noload,nosuid,nodev,noexec "$nvdata" /nvdata; then
    status "nvdata=mount-failed device=$nvdata"
else
    if (umask 077 && $bb cp /nvdata/APCFG/APRDEB/WIFI "$record.partial") &&
       [ "$($bb wc -c <"$record.partial")" -eq 514 ]; then
        $bb mv "$record.partial" "$record"
        status "nvdata=record-copied device=$nvdata"
    else
        $bb rm -f "$record.partial"
        status "nvdata=record-failed device=$nvdata"
    fi
    if $bb umount /nvdata; then status nvdata=unmounted; else status nvdata=umount-failed; fi
fi
# Wi-Fi: CONSYS starts the firmware after probe and mac attaches when it is ready.
for module in mt6797-wlan-core mt6797-consys mac; do
    if $bb insmod "/lib/modules/$($bb uname -r)/$module.ko"; then status "wifi=$module"; else status "wifi=$module-failed"; fi
done
# The owner's regulatory country; cfg80211 applies it from regulatory.db.
if LD_LIBRARY_PATH=/lib /bin/iw reg set US; then status reg=US; else status reg=set-failed; fi
# Audio, quiet until a stream runs.
status "audio=$(/bin/audio-start)"
# A fixed console cursor: the flag is fbcon's own, so it stays through the handover.
$bb echo 0 >/sys/class/graphics/fbcon/cursor_blink
# The native display, in the background so a stuck load can't hold SSH back. Otherwise
# simplefb stays, which still has the lid: with the no-native-display file; for one boot
# after a load that never reached the panel, including a hang or a power loss; and with
# no writable data partition, since a hang then could never be skipped.
(
    marker=/mnt/data/native-display-loading
    if ! $bb grep -q ' /mnt/data ' /proc/mounts; then
        status display=skipped-no-data
    elif [ -e /mnt/data/no-native-display ]; then
        status display=skipped
    elif [ -e "$marker" ]; then
        $bb rm -f "$marker"
        $bb sync
        status display=skipped-last-load-unfinished
    elif ! $bb touch "$marker"; then
        status display=skipped-no-data
    else
        $bb sync
        result=$(/bin/display-start)
        status "display=$result"
        if [ "$result" = native ]; then
            $bb rm -f "$marker"
            $bb sync
        fi
    fi
) &
exec $bb init
