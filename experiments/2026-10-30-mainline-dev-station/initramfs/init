#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# shellcheck shell=dash
# Development station: a RAM root that stays up, Gemian's linux partition at
# /mnt/data, SSH on USB and a shell on the console. Nothing here holds the
# boot: a failed step is recorded in /run/station/status and the rest runs.
export PATH=/bin
bb=/bin/busybox
$bb mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
$bb mount -t proc -o nosuid,nodev,noexec proc /proc
$bb mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
$bb mkdir -p /dev/pts /run /tmp /mnt/data
$bb mount -t devpts -o nosuid,noexec,mode=0620 devpts /dev/pts
$bb mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run
$bb mkdir -p /run/station
status() { $bb echo "$*" >>/run/station/status; }
$bb --install -s /bin
# The initramfs root is tmpfs when the kernel has it; cap it at 1 GiB.
if $bb mount -o remount,size=1g /; then status root=tmpfs-1g; else status root=unbounded; fi
status "cpus_online=$($bb cat /sys/devices/system/cpu/online)"
status "release=$($bb uname -r)"
status "boot_id=$($bb cat /proc/sys/kernel/random/boot_id)"
# The charging guard is built into the charger driver; nothing else stops charging below 60 C.
if [ -e /sys/class/power_supply/bq25890-charger-0/charge_control_end_threshold ]; then
    status charge-guard=bound
else
    status charge-guard=MISSING
    $bb echo "station: charge-guard=MISSING, charging is unguarded" >/dev/kmsg
fi
# The kernel's thermal zones (built in): the SoC with its trips and armed
# hardware reset, and the battery NTC with its critical trip.
for zone in /sys/class/thermal/thermal_zone*; do
    [ -d "$zone" ] && status "zone=$($bb cat "$zone/type") temp=$($bb cat "$zone/temp" 2>/dev/null)"
done
# Gemian's linux partition, found by its GPT name, never by number.
data=
waited=0
while [ "$waited" -lt 30 ]; do
    data=
    count=0
    for uevent in /sys/class/block/mmcblk0p*/uevent; do
        [ -f "$uevent" ] || continue
        if $bb grep -qx PARTNAME=linux "$uevent"; then
            data=/dev/$($bb sed -n 's/^DEVNAME=//p' "$uevent")
            count=$((count + 1))
        fi
    done
    [ "$count" -eq 1 ] && break
    $bb sleep 1
    waited=$((waited + 1))
done
if [ "$count" -ne 1 ]; then
    status "data=not-found count=$count"
elif $bb mount -t ext4 -o rw,noatime "$data" /mnt/data; then
    status "data=mounted device=$data"
else
    status "data=mount-failed device=$data"
fi
# The left Type-C chip (FUSB301, I2C 1-0025) keeps its mode through a power-off,
# so a source mode left by a test leaves the left port without VBUS or USB SSH.
# Start it as a sink unless /mnt/data/keep-left-typec-mode exists or a driver owns it.
left=/sys/bus/i2c/devices/1-0025
if [ -e /mnt/data/keep-left-typec-mode ]; then
    status left-typec=kept-by-file
elif [ -e "$left/driver" ]; then
    status left-typec=driver-owned
elif [ "$($bb i2cget -fy 1 0x25 0x01 2>/dev/null)" != 0x12 ]; then
    status left-typec=not-found
elif [ "$($bb i2cget -fy 1 0x25 0x02)" = 0x04 ]; then
    status left-typec=sink
elif $bb i2cset -fy 1 0x25 0x02 0x04 && [ "$($bb i2cget -fy 1 0x25 0x02)" = 0x04 ]; then
    status left-typec=set-sink
else
    status left-typec=set-failed
fi
# The lid policy (backlight off, keyboard inhibited while closed).
if $bb insmod "/lib/modules/$($bb uname -r)/gemini-lid.ko"; then status lid=gemini-lid; else status lid=insmod-failed; fi
# The indicator LEDs: nothing lit, and caps lock on the inside LED.
if $bb insmod "/lib/modules/$($bb uname -r)/leds-aw9120.ko"; then status leds=leds-aw9120; else status leds=insmod-failed; fi
# The vibration motor, as an idle force-feedback input device; nothing plays on it.
if $bb insmod "/lib/modules/$($bb uname -r)/regulator-haptic.ko"; then status haptic=regulator-haptic; else status haptic=insmod-failed; fi
# The Wi-Fi calibration record, read in place from nvdata: read-only, and
# noload so that an unclean journal is never replayed onto the partition. ext4 still
# clears an orphan list on such a mount unless the device itself is read-only.
nvdata=
for uevent in /sys/class/block/mmcblk0p*/uevent; do
    $bb grep -qx PARTNAME=nvdata "$uevent" && nvdata=/dev/$($bb sed -n 's/^DEVNAME=//p' "$uevent")
done
if [ -n "$nvdata" ] && ! $bb blockdev --setro "$nvdata"; then
    status "nvdata=setro-failed device=$nvdata"
elif [ -n "$nvdata" ] && $bb mount -t ext4 -o ro,noload,nosuid,nodev,noexec "$nvdata" /nvdata; then
    status "nvdata=mounted device=$nvdata"
else
    status "nvdata=mount-failed device=$nvdata"
fi
$bb ln -sf /nvdata/APCFG/APRDEB/WIFI /lib/firmware/mediatek/mt6797/WIFI.storage
# Wi-Fi: CONSYS starts the firmware after probe and mac attaches when it is ready.
for module in mt6797-wlan-core mt6797-consys mac; do
    if $bb insmod "/lib/modules/$($bb uname -r)/$module.ko"; then status "wifi=$module"; else status "wifi=$module-failed"; fi
done
# The owner's regulatory country; cfg80211 applies it from regulatory.db.
if LD_LIBRARY_PATH=/lib /bin/iw reg set US; then status reg=US; else status reg=set-failed; fi
# Audio, quiet until a stream runs.
status "audio=$(/bin/audio-start)"
# A fixed console cursor: the flag is fbcon's own, so it stays through the handover.
$bb echo 0 >/sys/class/graphics/fbcon/cursor_blink
# The native display, in the background so a stuck load can't hold SSH back. Otherwise
# simplefb stays, which still has the lid: with the no-native-display file; for one boot
# after a load that never reached the panel, including a hang or a power loss; and with
# no writable data partition, since a hang then could never be skipped.
(
    marker=/mnt/data/native-display-loading
    if ! $bb grep -q ' /mnt/data ' /proc/mounts; then
        status display=skipped-no-data
    elif [ -e /mnt/data/no-native-display ]; then
        status display=skipped
    elif [ -e "$marker" ]; then
        $bb rm -f "$marker"
        $bb sync
        status display=skipped-last-load-unfinished
    elif ! $bb touch "$marker"; then
        status display=skipped-no-data
    else
        $bb sync
        result=$(/bin/display-start)
        status "display=$result"
        if [ "$result" = native ]; then
            $bb rm -f "$marker"
            $bb sync
        fi
    fi
) &
exec $bb init
