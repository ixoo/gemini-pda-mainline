#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=9c4c8924132e37a40fb6b334e8bcfa4e1d241bd34542a6736d6fba9f5e488b8e
readonly PARENT_SOURCE_INTEGRITY=19387cb31b807805a120732f76b2183534aa63ab9cb811f1acb20dd185616e10
readonly PARENT_PATCH=0458-arm64-refine-P30E-post-capabilities-checkpoints.patch
readonly PARENT_PATCH_SHA256=2a6c72ae0a10c346bd826bd0dddf80ecf26ccae6aa41e239a267153f3c9013bf
readonly CURRENT_PATCH=0459-arm64-bind-Gemini-A72-r0p1-expected-MIDR.patch

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1 source_root=$2 output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] || \
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] || \
	die 'prepared source state changed'
[[ "$(<"$source_root/.gemini-source-integrity")" == "$PARENT_SOURCE_INTEGRITY" ]] || \
	die 'prepared source integrity changed'
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repository_dir=$(cd -- "$script_dir/../../.." && pwd -P)
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] || \
	die 'project checkout mismatch'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] || \
	die 'project checkout is dirty'
integrity=$(python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root")
[[ "$integrity" == "source_tree_integrity=$PARENT_SOURCE_INTEGRITY" ]] || \
	die 'prepared source integrity failed'
parent_patch_path="$repository_dir/patches/v7.1.3/$PARENT_PATCH"
printf '%s  %s\n' "$PARENT_PATCH_SHA256" "$parent_patch_path" | \
	sha256sum --check --status || die 'canonical parent patch changed'
[[ "$(tail -n 1 "$repository_dir/patches/series")" == "v7.1.3/$PARENT_PATCH" ]] || \
	die 'canonical series parent changed'
[[ ! -e "$repository_dir/patches/v7.1.3/$CURRENT_PATCH" ]] || \
	die 'r0p1 expected-pair patch is already canonical'

package="$output_root/a72-r0p1-expected-pair-${project_commit:0:12}"
partial="${package}.partial.$$"
mkdir -p "$output_root"
cleanup() { [[ ! -d "${partial:-}" ]] || rm -rf -- "$partial"; }
trap cleanup EXIT
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/generate_patch.py" \
	--source-root "$source_root" --repository-commit "$project_commit" \
	--output "$partial"
(cd "$partial" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=1 r0p1_expected_pair_validation=pass \
	expected_midr=0x410fd081 capability_model_matching=all-revisions-unchanged \
	changed_source_lines=1 new_cpu_request_paths=0 new_cpu9_request_paths=0 \
	new_cpu_off_paths=0 new_retry_paths=0 new_power_sequence_calls=0 \
	new_storage_writes=0 new_reboot_paths=0 deterministic_replay=pass \
	native_vm_build=none device_action=none boot_candidate=false; do
	grep -Fx "$marker" "$partial/provenance.txt" >/dev/null || \
		die "missing marker: $marker"
done
mv -- "$partial" "$package"
trap - EXIT
printf 'Generated r0p1 expected-pair repair at %s\n' "$package"
