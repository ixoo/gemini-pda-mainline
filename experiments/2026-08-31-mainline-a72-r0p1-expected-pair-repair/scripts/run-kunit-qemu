#!/usr/bin/env python3
"""Run the exact r0p1 expected-pair KUnit package without networking."""

from __future__ import annotations

import hashlib
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path


SOURCE_SHA256 = "4375a60af95706d56d91f6d057c054aaec60f8a683101e18121e1179feeb2b22"
PROFILES = {"a72-default-off-binder-kunit"}


def main() -> None:
    script_dir = Path(__file__).resolve().parent
    repository = script_dir.parents[2]
    base_path = (
        repository
        / "experiments/2026-08-31-mainline-a72-post-capabilities-checkpoints"
        / "scripts/run-kunit-qemu"
    )
    if hashlib.sha256(base_path.read_bytes()).hexdigest() != SOURCE_SHA256:
        raise SystemExit("error: source QEMU harness changed")
    loader = SourceFileLoader("r0p1_qemu_base", str(base_path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:
        raise SystemExit("error: unable to load pinned QEMU harness")
    module = module_from_spec(spec)
    loader.exec_module(module)
    module.__file__ = __file__
    module.PROFILES = PROFILES
    module.main()


if __name__ == "__main__":
    main()
