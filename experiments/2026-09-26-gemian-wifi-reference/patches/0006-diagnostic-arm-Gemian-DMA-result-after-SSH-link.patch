From 86c8c485db09f986fc1f1e6e0c5deaf0b611962d Mon Sep 17 00:00:00 2001
From: Gemini diagnostic experiment <nobody@example.invalid>
Date: Sat, 26 Sep 2026 15:30:45 -0400
Subject: [PATCH] diagnostic: arm Gemian DMA result from a root-only flag

The v5 first post-carrier records followed link-up by about one
millisecond and may be control traffic. Keep the once-per-direction
idle record disabled by default, then allow one bounded diagnostic
window to arm it through a root-only module parameter after the
authenticated Wi-Fi connection is established. The flag is software
state; this patch adds no radio action or DMA register access.
---
 .../wlan/gen3/os/linux/hif/ahb_sdioLike/ahb.c     | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/ahb.c b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/ahb.c
index a7a6b82..874aa1a 100644
--- a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/ahb.c
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/ahb.c
@@ -36,6 +36,7 @@
 /* #include <linux/kernel.h> */
 #include <linux/device.h>
 #include <linux/netdevice.h>
+#include <linux/moduleparam.h>
 /* #include <linux/errno.h> */
 #include <linux/platform_device.h>
 /* #include <linux/fs.h> */
@@ -65,6 +66,10 @@
 #include "sdio.h"
 #define NIC_TX_PAGE_SIZE                        128	/* in unit of bytes */
 DEFINE_SPINLOCK(HifLock);
+
+static bool gemini_wifi_ref_capture;
+module_param_named(gemini_wifi_ref_capture, gemini_wifi_ref_capture, bool, 0600);
+MODULE_PARM_DESC(gemini_wifi_ref_capture, "Record first RX/TX DMA result after an authenticated diagnostic trigger");
 #endif
 
 #if !defined(CONFIG_MTK_CLKMGR)
@@ -1010,9 +1015,10 @@ kalDevPortRead(IN P_GLUE_INFO_T GlueInfo, IN UINT_16 Port, IN UINT_32 Size, OUT
 		if (pfWlanDmaOps != NULL)
 			pfWlanDmaOps->DmaClockCtrl(FALSE);
 
-		if (GlueInfo->prDevHandler &&
+		if (READ_ONCE(gemini_wifi_ref_capture) &&
+		    GlueInfo->prDevHandler &&
 		    netif_carrier_ok(GlueInfo->prDevHandler))
-			pr_info_once("gemini-wifi-ref-v5: dma-rx carrier=1 port=%u size=%u count=%u src=0x%lx dst=0x%lx idle_return=%u idle_polls=%u count_escape=%u\n",
+			pr_info_once("gemini-wifi-ref-v6: dma-rx trigger=1 carrier=1 port=%u size=%u count=%u src=0x%lx dst=0x%lx idle_return=%u idle_polls=%u count_escape=%u\n",
 				     Port, Size, count, DmaConf.Src, DmaConf.Dst,
 				     DmaStillRunning, LoopCnt, DmaIdleEscape);
 
@@ -1281,9 +1287,10 @@ kalDevPortWrite(IN P_GLUE_INFO_T GlueInfo, IN UINT_16 Port, IN UINT_32 Size, IN
 		if (pfWlanDmaOps != NULL)
 			pfWlanDmaOps->DmaClockCtrl(FALSE);
 
-		if (GlueInfo->prDevHandler &&
+		if (READ_ONCE(gemini_wifi_ref_capture) &&
+		    GlueInfo->prDevHandler &&
 		    netif_carrier_ok(GlueInfo->prDevHandler))
-			pr_info_once("gemini-wifi-ref-v5: dma-tx carrier=1 port=%u size=%u count=%u src=0x%lx dst=0x%lx idle_return=%u idle_polls=%u count_escape=%u\n",
+			pr_info_once("gemini-wifi-ref-v6: dma-tx trigger=1 carrier=1 port=%u size=%u count=%u src=0x%lx dst=0x%lx idle_return=%u idle_polls=%u count_escape=%u\n",
 				     Port, Size, count, DmaConf.Src, DmaConf.Dst,
 				     DmaStillRunning, LoopCnt, DmaIdleEscape);
 
