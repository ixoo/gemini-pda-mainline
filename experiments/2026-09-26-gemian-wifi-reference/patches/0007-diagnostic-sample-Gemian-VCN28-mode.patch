From eabd52c2b88e5459a1fe407db0ae08a1b6e040f8 Mon Sep 17 00:00:00 2001
From: Gemini diagnostic experiment <nobody@example.invalid>
Date: Sat, 26 Sep 2026 17:00:03 -0400
Subject: [PATCH] diagnostic: sample MT6351 VCN28 mode after Gemian setup

Take one read-only PMIC-wrap sample of VCN28 CON0 after the selected
co-clock-zero path requests hardware mode and enables VCN28. Record
the transport status and value once without changing the vendor return
or radio sequence.

Internal diagnostic only; synthetic non-certifying author, no DCO.
---
 .../common/common_main/mt6797/mtk_wcn_consys_hw.c    | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c b/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c
index d0261ef..09fb8b0 100644
--- a/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c
+++ b/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c
@@ -40,6 +40,7 @@
 #else
 #include <linux/clk.h>
 #endif /* defined(CONFIG_MTK_CLKMGR) */
+#include <linux/atomic.h>
 #include <linux/delay.h>
 #include <linux/printk.h>
 #include <linux/memblock.h>
@@ -319,6 +320,8 @@ INT32 mtk_wcn_consys_hw_reg_ctrl(UINT32 on, UINT32 co_clock_type)
 		udelay(240);
 
 		if (0 == co_clock_type) {
+			static atomic_t gemini_vcn28_read_claim = ATOMIC_INIT(0);
+
 			/*switch VCN28 to HW control mode */
 			pmic_set_register_value(MT6351_PMIC_RG_VCN28_ON_CTRL, 1);
 			/*turn on VCN28 LDO */
@@ -335,6 +338,15 @@ INT32 mtk_wcn_consys_hw_reg_ctrl(UINT32 on, UINT32 co_clock_type)
 					WMT_PLAT_INFO_FUNC("enable VCN_2V8 ok\n");
 			}
 #endif
+			if (atomic_cmpxchg(&gemini_vcn28_read_claim, 0, 1) == 0) {
+				unsigned int con0 = 0;
+				unsigned int status;
+
+				status = pmic_read_interface(MT6351_LDO_VCN28_CON0,
+							     &con0, 0xffff, 0);
+				pr_info("gemini-wifi-ref-v7: vcn28_con0 status=%u value=0x%04x\n",
+					status, con0);
+			}
 		}
 #endif
 		CONSYS_REG_WRITE(conn_reg.topckgen_base + CONSYS_CONN2AP_SLEEP_MASK_OFFSET,
-- 
