From b151b1545f2fcab93bba93c3d250088f40bccda5 Mon Sep 17 00:00:00 2001
From: Gemini diagnostic experiment <nobody@example.invalid>
Date: Sat, 26 Sep 2026 19:02:22 -0400
Subject: [PATCH] diagnostic: record Gemian CONMCU reset readbacks

Capture one read of TOPRGU CONMCU reset bit 12 after the existing assert
request and another after the existing release request in the selected
Gemian Wi-Fi power-on path. Emit one typed record after the existing
settling delay. The atomic claim limits the added reads to the first
mapped on path in a boot.

No reset, radio, regulator or firmware operation is added, and the
vendor return path is unchanged. Internal diagnostic only; synthetic
author, no DCO certification.
---
 .../common_main/mt6797/mtk_wcn_consys_hw.c    | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c b/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c
index 09fb8b0..4b6ff96 100644
--- a/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c
+++ b/drivers/misc/mediatek/connectivity/common/common_main/mt6797/mtk_wcn_consys_hw.c
@@ -283,6 +283,11 @@ INT32 mtk_wcn_consys_hw_reg_ctrl(UINT32 on, UINT32 co_clock_type)
 	INT32 iRet = -1;
 	UINT32 retry = 10;
 	UINT32 consysHwChipId = 0;
+#ifdef CONFIG_OF
+	static atomic_t gemini_conmcu_read_claim = ATOMIC_INIT(0);
+	UINT32 gemini_conmcu_assert = 0, gemini_conmcu_release = 0;
+	int gemini_conmcu_record = 0;
+#endif
 #if CONSYS_PMIC_CTRL_ENABLE && !defined(CONFIG_MTK_PMIC_LEGACY)
 	int vcn18_voltage_ret = -ENODEV, vcn18_enable_ret = -ENODEV;
 	int vcn28_voltage_ret = -ENODEV, vcn28_enable_ret = -ENODEV;
@@ -355,11 +360,17 @@ INT32 mtk_wcn_consys_hw_reg_ctrl(UINT32 on, UINT32 co_clock_type)
 /*step2.MTCMOS ctrl*/
 
 #ifdef CONFIG_OF		/*use DT */
+		if (conn_reg.ap_rgu_base &&
+		    atomic_cmpxchg(&gemini_conmcu_read_claim, 0, 1) == 0)
+			gemini_conmcu_record = 1;
 		/*3.assert CONNSYS CPU SW reset  0x10007018 "[12]=1'b1  [31:24]=8'h88 (key)" */
 		/*CONSYS_REG_WRITE((conn_reg.ap_rgu_base + CONSYS_CPU_SW_RST_OFFSET),
 				 CONSYS_REG_READ(conn_reg.ap_rgu_base + CONSYS_CPU_SW_RST_OFFSET) |
 				 CONSYS_CPU_SW_RST_BIT | CONSYS_CPU_SW_RST_CTRL_KEY);*/
 		mtk_wdt_swsysret_config((1 << 12), 1);
+		if (gemini_conmcu_record)
+			gemini_conmcu_assert = CONSYS_REG_READ(conn_reg.ap_rgu_base +
+							CONSYS_CPU_SW_RST_OFFSET);
 		WMT_PLAT_INFO_FUNC("reg dump:CONSYS_CPU_SW_RST_REG(0x%x)\n",
 				  CONSYS_REG_READ(conn_reg.ap_rgu_base + CONSYS_CPU_SW_RST_OFFSET));
 		/*turn on SPM clock gating enable PWRON_CONFG_EN  0x10006000  32'h0b160001 */
@@ -519,6 +530,9 @@ INT32 mtk_wcn_consys_hw_reg_ctrl(UINT32 on, UINT32 co_clock_type)
 				 (CONSYS_REG_READ(conn_reg.ap_rgu_base + CONSYS_CPU_SW_RST_OFFSET) &
 				 ~CONSYS_CPU_SW_RST_BIT) | CONSYS_CPU_SW_RST_CTRL_KEY);*/
 		mtk_wdt_swsysret_config((1 << 12), 0);
+		if (gemini_conmcu_record)
+			gemini_conmcu_release = CONSYS_REG_READ(conn_reg.ap_rgu_base +
+							 CONSYS_CPU_SW_RST_OFFSET);
 #else /*use HADRCODE, maybe no use.. */
 		/*3.assert CONNSYS CPU SW reset  0x10007018  "[12]=1'b1  [31:24]=8'h88 (key)" */
 		CONSYS_REG_WRITE(CONSYS_CPU_SW_RST_REG,
@@ -632,6 +646,11 @@ INT32 mtk_wcn_consys_hw_reg_ctrl(UINT32 on, UINT32 co_clock_type)
 
 #endif
 		msleep(20);
+#ifdef CONFIG_OF
+		if (gemini_conmcu_record)
+			pr_info("gemini-wifi-ref-v8: conmcu_reset assert=0x%08x release=0x%08x chip_id=%04x\n",
+				gemini_conmcu_assert, gemini_conmcu_release, consysHwChipId);
+#endif
 		pr_info("gemini-wifi-ref-v3: conn_enable=%d chip_id=%04x mode=%u\n",
 			conn_enable_ret, consysHwChipId, co_clock_type);
 #if CONSYS_PMIC_CTRL_ENABLE && !defined(CONFIG_MTK_PMIC_LEGACY)
-- 
