+/* From 4 pixels in 5 bytes least significant bit first, to the same in CSI-2 packing. */
+static void mtispLineToCsi2(uint8_t *line, size_t length)
+{
+	for (size_t i = 0; i + 5 <= length; i += 5, line += 5) {
+		uint64_t v = 0;
+
+		memcpy(&v, line, 5);
+		line[0] = v >> 2;
+		line[1] = v >> 12;
+		line[2] = v >> 22;
+		line[3] = v >> 32;
+		line[4] = (v & 3) | ((v >> 10) & 3) << 2 | ((v >> 20) & 3) << 4 |
+			  ((v >> 30) & 3) << 6;
+	}
+}
