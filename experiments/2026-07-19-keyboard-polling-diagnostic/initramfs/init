#!/bin/busybox sh
# shellcheck shell=dash

export PATH=/bin
readonly MARKER='GEMINI_KEYBOARD_POLLING_20260719_U'
readonly STATUS_FILE=/run/u-status

if ! mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev 2>/dev/null; then
	if [ ! -c /dev/null ]; then
		printf '%s devtmpfs=failed; STATIC HOLD\n' "$MARKER"
		while :; do sleep 3600; done
	fi
fi
mount -t proc -o ro,nosuid,nodev,noexec proc /proc 2>/dev/null || true
mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /sys 2>/dev/null || true

record() {
	printf '%s\n' "$*" >>"$STATUS_FILE"
	for console in /dev/tty0 /dev/console /dev/ttyS0; do
		[ -c "$console" ] || continue
		printf '%s\n' "$*" >"$console" 2>/dev/null || true
	done
	if [ -c /dev/kmsg ]; then
		printf '<6>%s\n' "$*" >/dev/kmsg 2>/dev/null || true
	fi
}

record "$MARKER entry profile=keyboard-polling cpu_policy=maxcpus-1 auto_reboot=no"
active_vt=unavailable
if [ -r /sys/class/tty/tty0/active ]; then
	active_vt="$(cat /sys/class/tty/tty0/active 2>/dev/null || true)"
fi
record "$MARKER active_vt=${active_vt:-unavailable} tty1_shell=supervised probe=independent"

exec /bin/busybox init
