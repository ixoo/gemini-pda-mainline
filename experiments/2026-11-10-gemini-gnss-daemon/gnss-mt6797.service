# The Gemini PDA's GNSS receiver. Not enabled: starting it switches the GPS radio on,
# so it runs only when started, for example with "systemctl start gnss-mt6797".
# NMEA appears at /run/gnss-mt6797/nmea, a pty that gpsd reads, and at
# /run/gnss-mt6797/nmea.sock, the socket GeoClue's NMEA source reads.
[Unit]
Description=MT6797 GNSS receiver (switches the GPS radio on)
Documentation=https://github.com/ixoo/gemini-pda-mainline/tree/main/experiments/2026-11-10-gemini-gnss-daemon

[Service]
ExecStartPre=/usr/bin/modprobe gnss-mt6797
ExecStart=/usr/bin/gnss-mt6797d
# Hand the pty to gpsd through its control socket, which gpsd.socket provides and which starts
# gpsd on demand. Without that socket, gpsd is left alone.
ExecStartPost=-/bin/sh -c 'i=0; while [ ! -e /run/gnss-mt6797/nmea ] && [ $$i -lt 50 ]; do sleep 0.2; i=$$((i + 1)); done; [ -S /run/gpsd.sock ] && /usr/bin/gpsdctl add /run/gnss-mt6797/nmea'
ExecStopPost=-/bin/sh -c '[ -S /run/gpsd.sock ] && /usr/bin/gpsdctl remove /run/gnss-mt6797/nmea'
RuntimeDirectory=gnss-mt6797
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
