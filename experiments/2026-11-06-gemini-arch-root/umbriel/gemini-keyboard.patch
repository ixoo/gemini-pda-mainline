Umbriel for the Gemini PDA keyboard (gemini-pda-mainline, MIT).

- Load a complete keymap file named by UMBRIEL_XKB_KEYMAP_FILE. A keymap built
  from layout and variant names keeps only one group per layout, so the two-group
  Gemini layouts (ru, jp, ara, cz, sk, gr) lose their second group.
- Accept Mod5 in keybinds: Fn is xkb level 3 (Mod5), and the media, volume and
  brightness keysyms come from Fn plus a letter. Binds match modifiers exactly.

diff --git a/src/config/keybind_parse.cpp b/src/config/keybind_parse.cpp
index 7d1ae74..2685b2d 100644
--- a/src/config/keybind_parse.cpp
+++ b/src/config/keybind_parse.cpp
@@ -60,6 +60,9 @@ namespace umbriel {
         output.modifiers |= WLR_MODIFIER_ALT;
       } else if (modifier == "super" || modifier == "logo" || modifier == "win") {
         output.modifiers |= WLR_MODIFIER_LOGO;
+      } else if (modifier == "mod5") {
+        // Level 3: a function layer such as the Gemini PDA's Fn key.
+        output.modifiers |= WLR_MODIFIER_MOD5;
       } else {
         return false;
       }
