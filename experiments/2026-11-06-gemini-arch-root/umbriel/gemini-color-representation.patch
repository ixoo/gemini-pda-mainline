diff --git a/umbrielfx/render/fx_renderer/fx_framebuffer.c b/umbrielfx/render/fx_renderer/fx_framebuffer.c
index 4358081..c2ce0e9 100644
--- a/umbrielfx/render/fx_renderer/fx_framebuffer.c
