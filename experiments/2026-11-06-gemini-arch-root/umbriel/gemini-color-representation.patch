@@ -54,6 +54,33 @@ GLuint fx_framebuffer_get_texture(struct fx_framebuffer* buffer) {
   return buffer->tex;
 }
 
+void fx_framebuffer_set_yuv(struct fx_framebuffer* buffer, enum wlr_color_encoding encoding, enum wlr_color_range range) {
+  if (!buffer->external_only || (buffer->yuv_encoding == encoding && buffer->yuv_range == range)) {
+    return;
+  }
+
+  struct wlr_dmabuf_attributes dmabuf = {0};
+  if (!wlr_buffer_get_dmabuf(buffer->buffer, &dmabuf)) {
+    return;
+  }
+  bool external_only;
+  EGLImageKHR image =
+      wlr_egl_create_image_from_dmabuf_yuv(buffer->renderer->egl, &dmabuf, &external_only, encoding, range);
+  if (image == EGL_NO_IMAGE_KHR) {
+    return;
+  }
+
+  if (buffer->tex != 0) {
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, buffer->tex);
+    buffer->renderer->procs.glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, image);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+  }
+  wlr_egl_destroy_image(buffer->renderer->egl, buffer->image);
+  buffer->image = image;
+  buffer->yuv_encoding = encoding;
+  buffer->yuv_range = range;
+}
