# SPDX-License-Identifier: MIT
# Umbriel, Noctalia's wlroots compositor (owner, 2026-11-08: "replace Niri with Umbriel and
# Noctalia"). Neither Arch Linux ARM nor a release ships it yet, so ../build-card.sh builds
# this pinned upstream commit in the card's chroot. Follows the AUR's umbriel-git recipe,
# without xdg-desktop-portal-umbriel (screen sharing and input capture only), and with
# gemini-keyboard.patch: whole Gemini keymap files, and Mod5 (Fn) in keybinds.
pkgname=umbriel
_commit=94ab5961dce31cd53e5cdca76d2723d73fc2e189
pkgver=0.1.0.r20261108.94ab596
pkgrel=3
pkgdesc='A Wayland compositor built on wlroots'
arch=('aarch64')
url='https://github.com/noctalia-dev/umbriel'
license=('MIT')
depends=('cairo' 'gcc-libs' 'glibc' 'jemalloc' 'lcms2' 'libdrm' 'libdisplay-info' 'libei' 'libglvnd'
         'libinput' 'libxcb' 'libxkbcommon' 'mesa' 'pango' 'pixman' 'systemd-libs' 'tomlplusplus'
         'wayland' 'xcb-util-wm' 'xorg-xwayland' 'wlroots0.20')
makedepends=('meson' 'ninja' 'nlohmann-json' 'pkgconf' 'wayland-protocols')
options=('!debug')
source=("umbriel-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz" gemini-keyboard.patch)
sha256sums=('e6ea803bafc0cc0ff7a99864ab694ae54f33b69d144a4165597bfffc30926814' SKIP)

prepare() {
    patch -d "umbriel-${_commit}" -p1 <gemini-keyboard.patch
}

build() {
    arch-meson "umbriel-${_commit}" build -Db_ndebug=true -Dtests=disabled -Dharness=disabled
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
    install -Dm644 "umbriel-${_commit}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
