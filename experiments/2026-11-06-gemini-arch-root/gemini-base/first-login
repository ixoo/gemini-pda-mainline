#!/bin/sh
# SPDX-License-Identifier: MIT
# Once per user, at the first login, from Umbriel's autostart (owner, 2026-11-08). Each
# step leaves its own marker; a failed step leaves none, so the next login tries again.
state=${XDG_STATE_HOME:-$HOME/.local/state}/gemini
mkdir -p "$state"

# The output volume starts at 60% (owner, 2026-11-11: YouTube clean on the speakers at 60%
# with kernel fixes 0707 and 0712; the 35% before was tuned to the 0712 bug, and too quiet
# without it). WirePlumber keeps the user's later changes.
wait_for() {
    tries=0
    while ! wpctl inspect "$1" >/dev/null 2>&1 && [ "$tries" -lt 20 ]; do
        sleep 0.5
        tries=$((tries + 1))
    done
}
if [ ! -e "$state/volume-set" ]; then
    wait_for @DEFAULT_AUDIO_SINK@
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.60 && touch "$state/volume-set"
fi

# The microphone starts muted (owner, 2026-11-11); WirePlumber keeps it that way until
# the user unmutes it.
if [ ! -e "$state/mic-muted" ]; then
    wait_for @DEFAULT_AUDIO_SOURCE@
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 && touch "$state/mic-muted"
fi

# Umbriel's keybind cheatsheet: nice for the first boot, not for later starts.
# Ctrl+Alt+I shows it any time; any key closes it.
if [ ! -e "$state/cheatsheet-shown" ]; then
    umbriel msg cheatsheet-open >/dev/null && touch "$state/cheatsheet-shown"
fi

# qutebrowser reads userscripts only from the user's data directory, so each user gets a link
# to the packaged one, which then follows package updates. A file of the same name the user
# already has stays; once linked, removing it is the user's choice and sticks.
gm=${XDG_DATA_HOME:-$HOME/.local/share}/qutebrowser/greasemonkey
if [ ! -e "$state/no-av1-linked" ]; then
    if [ -e "$gm/gemini-no-av1.user.js" ] || [ -L "$gm/gemini-no-av1.user.js" ]; then
        touch "$state/no-av1-linked"
    else
        mkdir -p "$gm" &&
            ln -s /usr/share/gemini/qutebrowser/gemini-no-av1.user.js "$gm/gemini-no-av1.user.js" &&
            touch "$state/no-av1-linked"
    fi
fi

# Noctalia settings that cut wakeups on battery, linked once per user like the userscript: a
# file of that name the user already has stays, and a removed link stays removed.
nc=${XDG_CONFIG_HOME:-$HOME/.config}/noctalia
if [ ! -e "$state/noctalia-power-linked" ]; then
    if [ -e "$nc/10-gemini-power.toml" ] || [ -L "$nc/10-gemini-power.toml" ]; then
        touch "$state/noctalia-power-linked"
    else
        mkdir -p "$nc" &&
            ln -s /usr/share/gemini/noctalia/10-gemini-power.toml "$nc/10-gemini-power.toml" &&
            touch "$state/noctalia-power-linked"
    fi
fi
