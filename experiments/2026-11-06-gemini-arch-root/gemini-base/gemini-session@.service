# SPDX-License-Identifier: MIT
# The user's sway session on tty1, logged in without a password (owner decision,
# 2026-11-06). gemini-firstboot enables it for the first user. Other VTs keep a getty.
[Unit]
Description=sway session for %i on tty1
After=systemd-user-sessions.service gemini-display.service gemini-firstboot.service
Conflicts=getty@tty1.service
Wants=gemini-display.service

[Service]
User=%i
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Panfrost isn't loaded at boot yet, so wlroots renders in software.
Environment=WLR_RENDERER=pixman
ExecStart=/usr/lib/gemini/sway-session
Restart=no

[Install]
WantedBy=graphical.target
