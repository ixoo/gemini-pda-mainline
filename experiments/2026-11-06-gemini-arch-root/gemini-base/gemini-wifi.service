[Unit]
Description=Set the Wi-Fi country, then start the MT6797 Wi-Fi
After=gemini-modules.service
Before=iwd.service
ConditionPathExists=/usr/lib/firmware/mediatek/mt6797/WIFI.storage

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/gemini/wifi-start

[Install]
WantedBy=multi-user.target
