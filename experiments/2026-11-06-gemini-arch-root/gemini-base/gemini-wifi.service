# SPDX-License-Identifier: MIT
[Unit]
Description=Set the Wi-Fi country, then start the MT6797 Wi-Fi
After=gemini-modules.service nvdata.mount
Before=iwd.service
ConditionPathIsMountPoint=/nvdata

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/gemini/wifi-start

[Install]
WantedBy=multi-user.target
