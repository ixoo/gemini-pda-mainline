#!/bin/sh
# SPDX-License-Identifier: MIT
# Nothing transmits until the owner sets a country in /etc/conf.d/wireless-regdom
# (Arch's own file). The country goes first, and is seen applied, before the three
# Wi-Fi modules load in order; cfg80211 is built in, so module options can't set it.
# The calibration record is the copy gemian-firmware put in /usr/lib/firmware; nvdata isn't mounted.
# Arch's file is a list of commented lines; the last uncommented one counts.
WIRELESS_REGDOM=$(sed -n 's/^WIRELESS_REGDOM="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/conf.d/wireless-regdom 2>/dev/null | tail -1)
case "$WIRELESS_REGDOM" in
'') echo off-no-country; exit 0 ;;
[A-Z][A-Z]) ;;
*) echo off-bad-country; exit 1 ;;
esac
iw reg set "$WIRELESS_REGDOM" || { echo reg-failed; exit 1; }
waited=0
until iw reg get | grep -q "^country $WIRELESS_REGDOM:"; do
    [ "$waited" -ge 10 ] && { echo reg-not-applied; exit 1; }
    sleep 1
    waited=$((waited + 1))
done
for module in mt6797-wlan-core mt6797-consys mac; do
    modprobe "$module" || { echo "$module-failed"; exit 1; }
done
echo "on country=$WIRELESS_REGDOM"
