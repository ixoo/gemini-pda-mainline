#!/bin/sh
# SPDX-License-Identifier: MIT
# Keeps the battery's learned full charge across boots (owner, 2026-11-11). The fuel gauge
# learns charge_full (0732) but forgets it at power-off; this restores it when the battery
# appears and saves it when the driver changes it and at shutdown. After fitting a new
# battery, remove /var/lib/gemini/battery-charge-full so the gauge learns the new cell.
# usage: battery-capacity restore|save [SYSFS_DIR]
# udev passes the battery's sysfs directory; the shutdown unit uses the default.
dir=${2:-/sys/class/power_supply/battery}
file=/var/lib/gemini/battery-charge-full
num() { case "$1" in '' | *[!0-9]*) return 1 ;; esac; }
case "$1" in
restore)
    [ -r "$file" ] || exit 0
    # "charge_full charge_full_design" as saved, rescaled to today's design value, since
    # 0736 changed the scale to usable charge. A single number is 0732's format, whose
    # design value was 4268000 µAh.
    read -r value saved_design _ <"$file"
    saved_design=${saved_design:-4268000}
    num "$value" && num "$saved_design" && [ "$saved_design" -gt 0 ] || exit 0
    design=$(cat "$dir/charge_full_design" 2>/dev/null)
    num "$design" || exit 0
    value=$((value * design / saved_design))
    # The driver refuses values outside 50-110 % of the design capacity (ERANGE), and
    # answers ENODATA for a moment after the battery registers, so try three times.
    for _ in 1 2 3; do
        echo "$value" >"$dir/charge_full" 2>/dev/null && break
        sleep 1
    done
    exit 0
    ;;
save)
    value=$(cat "$dir/charge_full" 2>/dev/null) || exit 0
    design=$(cat "$dir/charge_full_design" 2>/dev/null) || exit 0
    num "$value" && num "$design" || exit 0
    [ "$value $design" = "$(cat "$file" 2>/dev/null)" ] && exit 0
    # A fresh install keeps no file until the driver has learned something.
    [ -e "$file" ] || [ "$value" != "$design" ] || exit 0
    mkdir -p "${file%/*}"
    printf '%s %s\n' "$value" "$design" >"$file.new" && mv "$file.new" "$file"
    exit 0
    ;;
esac
echo "usage: battery-capacity restore|save [SYSFS_DIR]" >&2
exit 2
