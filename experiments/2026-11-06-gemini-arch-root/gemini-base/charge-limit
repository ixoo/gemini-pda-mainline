#!/bin/sh
# SPDX-License-Identifier: MIT
# Run by udev when the battery appears (charge-limit.rules), before UPower sees it: with
# UPower's saved charge-limit switch off, lift the kernel's boot limit to 100%.
# UPower writes the status file as a bare "1" or "0".
[ "$(cat /var/lib/upower/charging-threshold-status 2>/dev/null)" = 0 ] || exit 0
echo 100 >"/sys$DEVPATH/charge_control_end_threshold"
