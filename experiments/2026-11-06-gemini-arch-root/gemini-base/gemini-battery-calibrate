#!/bin/bash
# SPDX-License-Identifier: MIT
# Walks the owner through one battery calibration cycle, so the fuel gauge (0732, 0746) can learn
# the battery's full charge (owner, 2026-11-11). The gauge learns from two rested readings
# far apart: one after a full charge, one low, with the charger attached and charging held.
# This sets the charge limits for each step and restores them on any exit.
# usage: sudo gemini-battery-calibrate
set -u
bat=/sys/class/power_supply/battery
rest_s=1800 # the gauge wants 30 min within +/-20 mA for a rested reading
poll_s=30

[ "$(id -u)" = 0 ] || { echo "Run it as root: sudo gemini-battery-calibrate" >&2; exit 1; }
for a in charge_full capacity status current_now temp charge_control_start_threshold \
    charge_control_end_threshold; do
    [ -e "$bat/$a" ] || { echo "No $bat/$a: this needs a station image with 0695 and 0732." >&2; exit 1; }
done

get() { cat "$bat/$1"; }
# The learned full charge: on the adaptive gauge (0746) learned_full_uah, on the OCV table's
# scale; before it, charge_full.
learned() {
    if [ -e "$bat/device/learned_full_uah" ]; then cat "$bat/device/learned_full_uah"; else get charge_full; fi
}
# The gauge says why it took or refused a reading only at debug level, so its debug messages
# are on for the cycle (needs debugfs).
dyndbg=/sys/kernel/debug/dynamic_debug/control
debug() { [ -w "$dyndbg" ] && echo "file mt6351-fuel-gauge.c $1" >"$dyndbg" 2>/dev/null; }
say() { printf '%s  %s\n' "$(date +%H:%M)" "$*"; }
# An end sets the start 5 points below it (0695), so a start is written after its end.
limits() { echo "$1" >"$bat/charge_control_end_threshold" && echo "$2" >"$bat/charge_control_start_threshold"; }

old_end=$(get charge_control_end_threshold)
old_start=$(get charge_control_start_threshold)
full_before=$(learned)
restore() {
    trap - EXIT INT TERM
    debug -p
    limits "$old_end" "$old_start" && say "Charge limits restored: $old_start-$old_end %."
}
trap restore EXIT
trap 'exit 130' INT TERM
debug +p

temp_ok() {
    local t
    t=$(get temp)
    if [ "$t" -lt 150 ] || [ "$t" -gt 350 ]; then
        say "The battery is at $((t / 10)) °C; the gauge only accepts 15-35 °C."
        return 1
    fi
}
abs_ma() { local c; c=$(($(get current_now) / 1000)); echo "${c#-}"; }

# While the guard's latch holds charging, anything that rewrites the thresholds ends the hold:
# Noctalia's charge-limit switch, a UPower restart, or a reboot.
holding=0
hold_ok() {
    [ "$holding" = 1 ] || return 0
    if [ "$(get charge_control_end_threshold)" != 50 ] || [ "$(get charge_control_start_threshold)" != 0 ]; then
        say "The charge limits were changed by something else, so charging is no longer held. Stopping."
        exit 1
    fi
}

# A rested reading: 30 min with the current within +/-20 mA. Restarts the count if it moves.
rest() {
    local since=$SECONDS
    say "$1: leave it plugged in for 30 min. The count restarts if the current moves."
    while [ $((SECONDS - since)) -lt "$rest_s" ]; do
        sleep "$poll_s"
        hold_ok
        if [ "$(abs_ma)" -gt 20 ]; then
            [ $((SECONDS - since)) -ge 600 ] && say "$1: the current is $(abs_ma) mA, outside +/-20 mA; still waiting."
            since=$SECONDS
        fi
        temp_ok || since=$SECONDS
    done
    say "$1: rested reading done at $(get capacity) %."
}

say "Battery $(get capacity) %, learned full charge $((full_before / 1000)) mAh," \
    "limits $old_start-$old_end %."
say "Step 1 of 3: charge to full. Keep the charger plugged in."
say "Use a wall charger and leave the screen idle: on a 500 mA computer port the battery"
say "makes up the shortfall, and the current never settles within +/-20 mA."
limits 100 99
until [ "$(get status)" != Charging ] && [ "$(abs_ma)" -le 20 ]; do
    sleep "$poll_s"
done
rest "Full"
dmesg | grep "mt6351-fuel-gauge.*learning:" | tail -1
full_at=$SECONDS
full_temp=$(get temp)
# The guard's end can't go below 50 %, but its "full" latch holds from the end down to the
# start (0695): with end 50 and start 0, set while the battery is full, charging stays held
# through the discharge and after the replug.
limits 50 0
holding=1

say "Step 2 of 3: unplug and use it down to about 20-30 %. Then plug the charger back in."
say "Until the end: don't power off or reboot, and don't touch the charge-limit switch."
until [ "$(get status)" = Discharging ]; do sleep "$poll_s"; hold_ok; done
until [ "$(get status)" != Discharging ]; do sleep "$poll_s"; hold_ok; done
low=$(get capacity)
if [ "$low" -gt 60 ]; then
    say "Plugged in at $low %: the two readings must be 40 points apart, so this pair won't count."
fi
t=$(get temp)
if [ $((t > full_temp ? t - full_temp : full_temp - t)) -gt 100 ]; then
    say "The battery is $(((t - full_temp) / 10)) °C off the full reading; the gauge accepts 10 °C."
fi
if [ $((SECONDS - full_at)) -gt $((72 * 3600)) ]; then
    say "More than 72 h since the full reading: this pair won't count."
fi

# The charger's status is polled, up to 10 s behind the chip.
sleep "$poll_s"
hold_ok
if [ "$(get status)" = Charging ]; then
    say "It is charging instead of holding at $low %, so there can be no low reading. Stopping."
    exit 1
fi
say "Step 3 of 3: charging is held at $low % for the low reading. Wall charger, screen idle."
seen=$(dmesg | grep -c "full charge")
rest "Low"
# The driver takes its reading at the first capacity read after 30 min of its own rest, which
# can start a little later than this count; keep charging held, reading the capacity, until it
# reports the pair, for up to 15 min.
waited=0
until [ "$(dmesg | grep -c "full charge")" -gt "$seen" ]; do
    if [ "$waited" -ge 900 ]; then
        say "The gauge reported no pair within 15 min. Its last word:"
        dmesg | grep "mt6351-fuel-gauge.*learning" | tail -3
        break
    fi
    sleep "$poll_s"
    waited=$((waited + poll_s))
    hold_ok
    get capacity >/dev/null
done

full_after=$(learned)
say "Learned full charge: $((full_before / 1000)) mAh before, $((full_after / 1000)) mAh now."
line=$(dmesg | grep "full charge" | tail -1)
echo "$line"
# "full charge N uAh from M uAh over P points": this pair's own estimate is M x 100 / |P|. The
# learned value moves only a quarter of the way toward it per cycle.
m=$(echo "$line" | sed -n 's/.*from \([0-9]*\) uAh over -\{0,1\}\([0-9]*\) points.*/\1/p')
pts=$(echo "$line" | sed -n 's/.*from \([0-9]*\) uAh over -\{0,1\}\([0-9]*\) points.*/\2/p')
if [ -n "$m" ] && [ -n "$pts" ] && [ "$pts" -gt 0 ]; then
    say "This cycle measured $((m * 100 / pts / 1000)) mAh; the learned value moves a quarter of the way toward it each cycle."
fi
if [ ! -e "$bat/device/learned_full_uah" ]; then
    say "Charging resumes now; the capacity may read high until the next charge finishes."
fi
