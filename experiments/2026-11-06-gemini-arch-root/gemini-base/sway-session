#!/bin/sh
# SPDX-License-Identifier: MIT
# The Gemini's sway session. The Gemini layouts make the Fn key (KEY_LEFTMETA) the
# Fn symbol layer, so it can't also be sway's Mod; the owner chose Ctrl+Alt instead.
# sway's default config sets $mod at its top and expands bindings as it reads, so a
# config.d drop-in can't change it: this runs sway on the packaged default with only
# that line changed, regenerated each start so sway's own updates still apply. A
# user's own ~/.config/sway/config is used as it is.
# Diagnostic (R5): logind has refused sway the DRM device ("Could not take device:
# Operation not permitted") on early starts. In logind that refusal comes from a session
# without a seat or a device on another seat, so record both, and the active VT, in the
# journal before sway asks.
{
    echo "gemini-session: session=${XDG_SESSION_ID:-none} tty0-active=$(cat /sys/class/tty/tty0/active 2>&1)"
    loginctl show-session "${XDG_SESSION_ID:-}" -p Seat -p VTNr -p TTY -p Active -p State -p Type -p Class 2>&1
    loginctl show-seat seat0 -p ActiveSession -p CanGraphical -p CanTTY 2>&1
    udevadm info -q property -n /dev/dri/card0 2>&1 | grep -E '^(ID_SEAT|TAGS|CURRENT_TAGS)='
} | sed 's/^/gemini-session: /' >&2
user=${XDG_CONFIG_HOME:-$HOME/.config}/sway/config
[ -e "$user" ] && exec sway
out=${XDG_RUNTIME_DIR:?}/gemini-sway.config
# shellcheck disable=SC2016 # a sed pattern, not shell
# floating_modifier takes one modifier, not a chord, so dragging floating windows uses
# Alt alone.
sed -e 's/^set \$mod Mod4$/set $mod Mod1+Control/' \
    -e 's/^\([[:space:]]*\)floating_modifier \$mod /\1floating_modifier Mod1 /' \
    /etc/sway/config >"$out" && exec sway -c "$out"
exec sway
