#!/bin/bash
# SPDX-License-Identifier: MIT
# First boot, on the console: the keyboard layout, the package keyring, the time zone,
# the hostname, one user in wheel with a password and the Wi-Fi country, then the
# autologin session. Networks are joined later from Noctalia (owner, 2026-11-08),
# through iwd.
# The stock systemd-firstboot.service is masked, since it asks on the serial port.
# A marker, not ConditionFirstBoot, so an interrupted run asks again next boot.
set -u
state=/var/lib/gemini
echo "Gemini first boot."
# The keyboard layout first, so everything typed after it, passwords included, types
# the same here, on the console later and in Umbriel: one of Gemian's Gemini layouts,
# loaded on this console at once and kept for the console and for Umbriel. Two-group
# layouts switch groups with both Shift keys together.
layouts=/usr/share/gemini/xkb/layouts.tsv
echo "Keyboard layouts:"
awk -F '\t' '{ printf "  %-7s %s\n", $1, $2 }' "$layouts"
while :; do
    read -r -p "Keyboard layout (empty keeps us): " layout
    layout=${layout:-us}
    [[ "$layout" =~ ^[a-z_]+$ ]] && [ -e "/usr/share/gemini/xkb/$layout.xkb" ] && break
    echo "Type one of the codes on the left."
done
loadkeys -u "gemini-$layout" >/dev/null || echo "The console keymap did not load; it stays the Gemini US map."
echo "KEYMAP=gemini-$layout" >/etc/vconsole.conf
pacman-key --init >/dev/null && pacman-key --populate archlinuxarm >/dev/null ||
    echo "pacman-key failed; run it again later: pacman-key --init; pacman-key --populate archlinuxarm"
# Asks only while /etc/localtime is unset; the list of zones is paged.
systemd-firstboot --prompt-timezone ||
    echo "No time zone set; set one later with: timedatectl set-timezone ZONE"
# Replaces the image's "alarm" (owner, 2026-11-08). nss-myhostname resolves it, so
# /etc/hosts needs no line.
while :; do
    read -r -p "Hostname (empty keeps gemini): " host
    host=${host:-gemini}
    [[ "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] && break
    echo "Use letters, digits and -, not at either end, up to 63 characters."
done
echo "$host" >/etc/hostname
echo "$host" >/proc/sys/kernel/hostname
while :; do
    read -r -p "User name: " user
    [[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && ! id "$user" >/dev/null 2>&1 && break
    echo "Use lower case letters, digits, _ or -, for a new user."
done
# video: hardware video decoding, also from a remote session (dma-heap.rules).
useradd -m -G wheel,video "$user"
until passwd "$user"; do :; done
# The country stays here: nothing transmits until one is set, and Noctalia doesn't set it.
read -r -p "Wi-Fi country, two letters (empty keeps Wi-Fi off): " country
country=$(echo "$country" | tr '[:lower:]' '[:upper:]')
if [[ "$country" =~ ^[A-Z][A-Z]$ ]]; then
    echo "WIRELESS_REGDOM=\"$country\"" >/etc/conf.d/wireless-regdom
    # gemini-wifi already ran at boot with no country; a restart applies this one.
    systemctl restart gemini-wifi.service && systemctl start iwd.service ||
        echo "Wi-Fi did not start; see: journalctl -u gemini-wifi -u iwd"
    # Bluetooth and FM skipped at boot for want of the connectivity firmware; load them now.
    systemctl restart gemini-hw@bluetooth.service gemini-hw@fm.service ||
        echo "Bluetooth or FM did not load; see: journalctl -u gemini-hw@bluetooth -u gemini-hw@fm"
    echo "Join a network from Noctalia's bar once the session starts."
fi
systemctl enable "gemini-session@$user.service"
systemctl set-default graphical.target
touch "$state/firstboot-done"
echo "Done. The session starts now. Fn types the symbols printed on the keys. Umbriel's"
echo "shortcuts use Ctrl+Alt: Ctrl+Alt+Space or the side key opens the launcher,"
echo "Ctrl+Alt+T a terminal, Ctrl+Alt+Q closes a window, Ctrl+Alt+N picks a Wi-Fi network,"
echo "Ctrl+Alt+I lists the rest, Ctrl+Alt+Backspace leaves the session, Ctrl+Alt+Tab goes"
echo "to a text console; with Shift, use the right Shift key;"
echo "on a console, Alt+Left/Right or Ctrl+Alt+1 to 0 switch consoles."
