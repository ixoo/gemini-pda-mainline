#!/bin/bash
# SPDX-License-Identifier: MIT
# First boot, on the console: the package keyring, the time zone, one user in wheel
# with a password, the Wi-Fi country and a first join, then the autologin session.
# The stock systemd-firstboot.service is masked, since it asks on the serial port.
# A marker, not ConditionFirstBoot, so an interrupted run asks again next boot.
set -u
state=/var/lib/gemini
echo "Gemini first boot."
pacman-key --init >/dev/null && pacman-key --populate archlinuxarm >/dev/null ||
    echo "pacman-key failed; run it again later: pacman-key --init; pacman-key --populate archlinuxarm"
# Asks only while /etc/localtime is unset; the list of zones is paged.
systemd-firstboot --prompt-timezone ||
    echo "No time zone set; set one later with: timedatectl set-timezone ZONE"
# The keyboard layout for sway, from Gemian's Gemini layouts. Two-group layouts switch
# between their two groups with both Shift keys together.
layouts=/usr/share/gemini/xkb/layouts.tsv
echo "Keyboard layouts:"
awk -F '\t' '{ printf "  %-7s %s\n", $1, $2 }' "$layouts"
while :; do
    read -r -p "Keyboard layout (empty keeps us): " layout
    layout=${layout:-us}
    [[ "$layout" =~ ^[a-z_]+$ ]] && [ -e "/usr/share/gemini/xkb/$layout.xkb" ] && break
    echo "Type one of the codes on the left."
done
echo "input type:keyboard xkb_file /usr/share/gemini/xkb/$layout.xkb" >/etc/sway/config.d/60-gemini-keyboard.conf
while :; do
    read -r -p "User name: " user
    [[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && ! id "$user" >/dev/null 2>&1 && break
    echo "Use lower case letters, digits, _ or -, for a new user."
done
useradd -m -G wheel "$user"
until passwd "$user"; do :; done
read -r -p "Wi-Fi country, two letters (empty keeps Wi-Fi off): " country
country=$(echo "$country" | tr '[:lower:]' '[:upper:]')
if [[ "$country" =~ ^[A-Z][A-Z]$ ]]; then
    echo "WIRELESS_REGDOM=\"$country\"" >/etc/conf.d/wireless-regdom
    # gemini-wifi already ran at boot with no country; a restart applies this one.
    systemctl restart gemini-wifi.service && systemctl start iwd.service ||
        echo "Wi-Fi did not start; see: journalctl -u gemini-wifi -u iwd"
    echo "Join a network: station wlan0 scan, station wlan0 get-networks, station wlan0 connect NAME. Type quit when done."
    iwctl
fi
systemctl enable "gemini-session@$user.service"
systemctl set-default graphical.target
touch "$state/firstboot-done"
echo "Done. The session starts now. Fn types the symbols printed on the keys. sway's"
echo "shortcuts use Ctrl+Alt: Ctrl+Alt+Enter opens a terminal, Ctrl+Alt+D a launcher,"
echo "Ctrl+Alt+Shift+E leaves the session."
