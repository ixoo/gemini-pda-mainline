Noctalia shows the battery temperature in its Power tab (gemini-pda-mainline, MIT).

UPower reports each battery's Temperature, but Noctalia 5.4.1 doesn't read it (owner,
2026-11-11: "In the noctalia power panel, could we see the battery temperature?"). Read it
with the other battery properties, and show it in the battery card under the charge rate,
only when the device reports one. UPower's display device doesn't aggregate Temperature (it
reads 0 there, 25.3 on the battery), so the state built from it takes the temperature from
the system battery. The same change is drafted for upstream Noctalia.

--- a/src/dbus/upower/upower_service.cpp
+++ b/src/dbus/upower/upower_service.cpp
@@ -487,6 +487,10 @@
     next = readDeviceState(*m_displayDeviceProxy);
     next.onBattery = getPropertyOr<bool>(*m_upowerProxy, kUpowerInterface, "OnBattery", false);
     if (next.isPresent) {
+      // UPower's display device does not aggregate Temperature.
+      if (const auto* battery = defaultSystemBattery(); battery != nullptr) {
+        next.temperature = battery->state.temperature;
+      }
       return next;
     }
   }
@@ -516,6 +520,7 @@
   next.timeToFull = getPropertyOr<std::int64_t>(proxy, kDeviceInterface, "TimeToFull", 0);
   next.energyRate = getPropertyOr<double>(proxy, kDeviceInterface, "EnergyRate", 0.0);
   next.energy = getPropertyOr<double>(proxy, kDeviceInterface, "Energy", 0.0);
+  next.temperature = getPropertyOr<double>(proxy, kDeviceInterface, "Temperature", 0.0);
 
   // Fallback calculation for timeToEmpty / timeToFull if they are reported as 0 or less
   if (next.state == BatteryState::Discharging && next.timeToEmpty <= 0 && next.energyRate > 0.0 && next.energy > 0.0) {
