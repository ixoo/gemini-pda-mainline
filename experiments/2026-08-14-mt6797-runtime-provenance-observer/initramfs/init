#!/bin/busybox sh
# shellcheck shell=dash

export PATH=/bin
readonly MARKER='GEMINI_DVFSP_PROVENANCE_DIAGNOSTIC_20260815'

# /dev/null is unavailable before devtmpfs. Keep this first mount visible.
if ! mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev; then
	printf '%s devtmpfs=failed; STATIC HOLD\n' "$MARKER"
	while :; do sleep 3600; done
fi
if ! mount -t proc -o ro,nosuid,nodev,noexec proc /proc 2>/dev/null; then
	printf '%s procfs=failed; STATIC HOLD\n' "$MARKER" >/dev/tty1 2>/dev/null || true
	while :; do sleep 3600; done
fi
if ! mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /sys 2>/dev/null; then
	printf '%s sysfs=failed; STATIC HOLD\n' "$MARKER" >/dev/tty1 2>/dev/null || true
	while :; do sleep 3600; done
fi

: >/run/ac-status
/bin/ac-record 'entry profile=vendor-provenance-diagnostic storage_access=none dvfsp_hardware_write=none'
/bin/provenance-record
/bin/usb-net &
/bin/ac-record 'services=launched provenance=early-and-live usb_network=legacy-android-rndis watchdog_userspace=none automatic_reboot=none'

exec /bin/busybox init
