#!/usr/bin/env bash

set -Eeuo pipefail

# `rc` is assigned inside the ERR trap command.
# shellcheck disable=SC2154

trap 'rc=$?; trap - ERR; printf "error: provenance full-link line %s status %s\n" \
  "${LINENO}" "${rc}" >&2; exit "${rc}"' ERR

readonly SOURCE_COMMIT=d388d350cb2dda8f23b99be6fa5db9628896e87f
readonly PATCHED_COMMIT=f3d2a14bd1b8355c68e59e8bd4be6bc1525f9c24
readonly SOURCE_URL=https://github.com/gemian/gemini-linux-kernel-3.18.git
readonly PATCH_SHA256=3520538de1c31ea592c2f0c76af7deef10f5c1ee00689d74bdac17def48dbb11
readonly EXPECTED_GCC='aarch64-linux-gnu-gcc-6 (Debian 6.3.0-18) 6.3.0 20170516'
readonly EXPECTED_LD='GNU ld (GNU Binutils for Debian) 2.28'
readonly EXPECTED_PYTHON='Python 2.7.13'
readonly CUST_DTSI_SHA256=7a7eb416499346afff30c15f967ccb9cf79323c076204b6a953515db74811632

die() {
  echo "error: $*" >&2
  exit 1
}

[[ "$#" -eq 6 ]] || \
  die "expected PROJECT_COMMIT SOURCE_ROOT BUILD_ROOT ARTIFACT_ROOT TOOLCHAIN_ROOT JOBS"
readonly project_commit="$1"
readonly source_root="$2"
readonly build_root="$3"
readonly artifact_root="$4"
readonly toolchain_root="$5"
readonly jobs="$6"

[[ "${project_commit}" =~ ^[0-9a-f]{40}$ ]] || die "invalid project commit"
[[ "${jobs}" =~ ^[1-9][0-9]*$ ]] || die "invalid job count"
for root in "${source_root}" "${build_root}" "${artifact_root}" "${toolchain_root}"; do
  [[ "${root}" == /workspace/gemini-pda/* && \
     "${root}" != /workspace/gemini-pda ]] || die "unsafe managed root: ${root}"
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
experiment_dir="$(cd "${script_dir}/.." && pwd -P)"
readonly experiment_dir
repository_dir="$(cd "${experiment_dir}/../.." && pwd -P)"
readonly repository_dir
[[ "$(git -C "${repository_dir}" rev-parse HEAD)" == "${project_commit}" ]] || \
  die "project checkout does not match requested commit"
[[ -z "$(git -C "${repository_dir}" status --porcelain)" ]] || \
  die "project checkout is dirty"

readonly patch="${experiment_dir}/patches/0001-power-add-read-only-DVFSP-provenance-observer.patch"
readonly series="${experiment_dir}/patches/series"
readonly manifest="${repository_dir}/experiments/2026-07-23-gemian-a72-owner-observer/inputs/stretch-cross-toolchain.tsv"
manifest_sha="$(sha256sum "${manifest}" | awk '{print $1}')"
readonly manifest_sha
readonly toolchain="${toolchain_root}/${manifest_sha}"
readonly cross_prefix="${toolchain}/wrappers/aarch64-linux-gnu-"
readonly source_mirror="${source_root}/gemian-linux-kernel-3.18.git"
readonly prepared_source="${source_root}/prepared-${SOURCE_COMMIT:0:12}-${PATCHED_COMMIT:0:12}"
readonly output="${build_root}/gemian-provenance-observer/${project_commit}"
readonly package="${artifact_root}/gemian-provenance-observer-${project_commit:0:12}"
readonly package_partial="${package}.partial.$$"

for command in file git jq make nm python3 sha256sum tar; do
  command -v "${command}" >/dev/null 2>&1 || die "missing Buildbox command: ${command}"
done
PYTHONDONTWRITEBYTECODE=1 python3 "${script_dir}/validate.py"
[[ "$(sha256sum "${patch}" | awk '{print $1}')" == "${PATCH_SHA256}" ]] || \
  die "observer patch checksum mismatch"
[[ "$(<"${series}")" == "$(basename "${patch}")" ]] || \
  die "observer patch series mismatch"

[[ -f "${toolchain}/validated" && ! -L "${toolchain}" ]] || \
  die "pinned Gemian toolchain cache is unavailable"
[[ "$(<"${toolchain}/validated")" == "${manifest_sha}" ]] || \
  die "cached toolchain validation identity mismatch"
export LD_LIBRARY_PATH="${toolchain}/root/usr/lib/x86_64-linux-gnu"
[[ "$("${cross_prefix}gcc" --version | head -n 1)" == "${EXPECTED_GCC}" ]] || \
  die "pinned compiler identity mismatch"
[[ "$("${cross_prefix}ld" --version | head -n 1)" == "${EXPECTED_LD}" ]] || \
  die "pinned linker identity mismatch"
[[ "$("${toolchain}/wrappers/python2.7" --version 2>&1)" == "${EXPECTED_PYTHON}" ]] || \
  die "pinned Python identity mismatch"

mkdir -p "${source_root}"
if [[ ! -d "${source_mirror}" ]]; then
  git clone --mirror "${SOURCE_URL}" "${source_mirror}.partial"
  mv "${source_mirror}.partial" "${source_mirror}"
fi
[[ "$(git --git-dir="${source_mirror}" remote get-url origin)" == "${SOURCE_URL}" ]] || \
  die "vendor source mirror origin mismatch"
git --git-dir="${source_mirror}" fetch origin "${SOURCE_COMMIT}"
[[ "$(git --git-dir="${source_mirror}" rev-parse FETCH_HEAD)" == "${SOURCE_COMMIT}" ]] || \
  die "vendor source fetch mismatch"

if [[ -d "${prepared_source}" ]]; then
  [[ ! -L "${prepared_source}" && \
     "$(git -C "${prepared_source}" rev-parse HEAD)" == "${PATCHED_COMMIT}" && \
     -z "$(git -C "${prepared_source}" status --porcelain)" ]] || \
    die "prepared source state mismatch"
else
  for stale in "${prepared_source}.partial."*; do
    [[ -d "${stale}" && ! -L "${stale}" ]] || continue
    rm -rf -- "${stale}"
  done
  partial="${prepared_source}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' RETURN
  git clone --no-checkout "${source_mirror}" "${partial}"
  git -C "${partial}" checkout --detach "${SOURCE_COMMIT}"
  git -C "${partial}" -c user.name='Gemini Mainline Experiment' \
    -c user.email=gemini-mainline@example.invalid \
    am --committer-date-is-author-date "${patch}"
  [[ "$(git -C "${partial}" rev-parse HEAD)" == "${PATCHED_COMMIT}" ]] || \
    die "normal patch application did not reproduce generated commit"
  [[ -z "$(git -C "${partial}" status --porcelain)" ]] || \
    die "prepared source is dirty"
  mv "${partial}" "${prepared_source}"
  partial=""
  trap - RETURN
fi

git -C "${prepared_source}" show --check --oneline --no-renames HEAD >/dev/null
git -C "${prepared_source}" diff-tree --no-commit-id --name-only -r HEAD > \
  "${prepared_source}/.git/gemini-changed-paths"
python3 - "${prepared_source}/.git/gemini-changed-paths" <<'PY'
import pathlib
import sys

expected = [
    "drivers/misc/mediatek/base/power/Kconfig",
    "drivers/misc/mediatek/base/power/mt6797/Makefile",
    "drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.c",
    "drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.h",
    "drivers/misc/mediatek/base/power/mt6797/mt_eem.c",
    "drivers/misc/mediatek/base/power/ppm_v1/src/mt_ppm_api.c",
]
actual = pathlib.Path(sys.argv[1]).read_text().splitlines()
if actual != expected:
    raise SystemExit("applied patch changed-path set is not exact")
PY

[[ ! -e "${package}" ]] || die "refusing to overwrite package: ${package}"
[[ ! -e "${package_partial}" ]] || die "stale package partial exists"
if [[ -e "${output}" ]]; then
  [[ -d "${output}" && ! -L "${output}" && \
     "${output}" == /workspace/gemini-pda/build/gemian-provenance-observer/* ]] || \
    die "unsafe stale build directory"
  rm -rf -- "${output}"
fi
mkdir -p "${output}" "${artifact_root}"
trap 'test -d "${output}" && rm -rf -- "${output}"; test -d "${package_partial}" && rm -rf -- "${package_partial}"' EXIT

export HOST_EXTRACFLAGS=-fcommon
make -C "${prepared_source}" O="${output}" ARCH=arm64 \
  CROSS_COMPILE="${cross_prefix}" gemini_modular_defconfig
cp "${output}/.config" "${output}/baseline.config"
"${prepared_source}/scripts/config" --file "${output}/.config" \
  --enable GEMINI_MT6797_DVFSP_PROVENANCE_OBSERVER \
  --set-str LOCALVERSION "-gemini-provenance-observer"
make -C "${prepared_source}" O="${output}" ARCH=arm64 \
  CROSS_COMPILE="${cross_prefix}" olddefconfig
python3 - "${output}/baseline.config" "${output}/.config" > \
  "${output}/config.diff" <<'PY'
import pathlib
import sys

def symbols(path):
    result = {}
    for line in pathlib.Path(path).read_text().splitlines():
        if line.startswith("CONFIG_") and "=" in line:
            name, value = line.split("=", 1)
            result[name] = value
        elif line.startswith("# CONFIG_") and line.endswith(" is not set"):
            result[line[2:-11]] = "n"
    return result

before = symbols(sys.argv[1])
after = symbols(sys.argv[2])
changes = []
for name in sorted(set(before) | set(after)):
    if before.get(name) != after.get(name):
        changes.append((name, before.get(name, "missing"), after.get(name, "missing")))
for change in changes:
    print("{}\t{}\t{}".format(*change))
expected = [
    ("CONFIG_GEMINI_MT6797_DVFSP_PROVENANCE_OBSERVER", "missing", "y"),
    ("CONFIG_LOCALVERSION", '\"\"', '\"-gemini-provenance-observer\"'),
]
if changes != expected:
    raise SystemExit("observer configuration delta is not exact")
PY

readonly dct_output="${output}/arch/arm64/boot/dts"
mkdir -p "${dct_output}"
(
  cd "${prepared_source}/tools/dct"
  "${toolchain}/wrappers/python2.7" DrvGen.py \
    "${prepared_source}/drivers/misc/mediatek/dws/mt6797/aeon6797_6m_n.dws" \
    "${dct_output}/" "${dct_output}/" cust_dtsi
) > "${output}/dct.log" 2>&1
[[ "$(sed -n '3{/^ \* [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\} [0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}$/p;}' \
  "${dct_output}/cust.dtsi" | wc -l)" -eq 1 ]] || \
  die "generated cust.dtsi timestamp contract changed"
sed '3s/^ \* [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\} [0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}$/ * 1970-01-01 00:00:00/' \
  "${dct_output}/cust.dtsi" > "${dct_output}/cust.dtsi.normalized"
mv "${dct_output}/cust.dtsi.normalized" "${dct_output}/cust.dtsi"
[[ "$(sha256sum "${dct_output}/cust.dtsi" | awk '{print $1}')" == \
   "${CUST_DTSI_SHA256}" ]] || die "generated cust.dtsi checksum mismatch"

if ! make -C "${prepared_source}" O="${output}" ARCH=arm64 \
  CROSS_COMPILE="${cross_prefix}" python="${toolchain}/wrappers/python2.7" \
  -j"${jobs}" V=1 Image.gz-dtb > "${output}/build.log" 2>&1; then
  tail -n 160 "${output}/build.log" >&2
  die "provenance observer full kernel link failed"
fi
readonly image="${output}/arch/arm64/boot/Image.gz-dtb"
[[ -s "${image}" && -s "${output}/vmlinux" && -s "${output}/System.map" ]] || \
  die "full-link outputs are incomplete"

"${cross_prefix}nm" -u "${output}/vmlinux" > "${output}/undefined-symbols.txt"
unresolved_count="$(wc -l < "${output}/undefined-symbols.txt")"
readonly unresolved_count
[[ "${unresolved_count}" -eq 0 ]] || die "full kernel has unresolved symbols"
for symbol in gemini_mt6797_dvfsp_provenance_calibration_bank_publish \
  gemini_mt6797_dvfsp_provenance_calibration_invalidate \
  gemini_mt6797_dvfsp_provenance_table_commit \
  gemini_mt6797_dvfsp_provenance_init; do
  grep -q " ${symbol}$" "${output}/System.map" || \
    die "linked observer symbol is absent: ${symbol}"
done
for marker in 'gemini_dvfsp_provenance' 'observation_complete=' \
  'ppm_expected_cluster_count=' 'ppm_cluster_mask=0x' \
  'eem_required_bank_mask=0x' 'eem_calibration_bank_mask=0x' \
  'owner_handle=0' \
  'transition_handle=0' 'coherent_transition_owner=0' 'provider=none' \
  'hardware_write=none' 'cpu8_cpu9_admission=closed'; do
  "${cross_prefix}strings" "${output}/vmlinux" | grep -F "${marker}" >/dev/null || \
    die "linked observer marker is absent: ${marker}"
done
grep -E -i '(^|[^[:alpha:]])(warning|error):' "${output}/build.log" > \
  "${output}/diagnostics.txt" || :

mkdir -p "${package_partial}/outputs" "${package_partial}/provenance"
cp "${output}/.config" "${package_partial}/outputs/config"
cp "${output}/baseline.config" "${package_partial}/outputs/baseline.config"
cp "${output}/config.diff" "${package_partial}/outputs/config.diff"
cp "${dct_output}/cust.dtsi" "${package_partial}/outputs/cust.dtsi"
cp "${output}/dct.log" "${package_partial}/outputs/dct.log"
cp "${output}/build.log" "${package_partial}/outputs/build.log"
cp "${output}/diagnostics.txt" "${package_partial}/outputs/diagnostics.txt"
cp "${output}/undefined-symbols.txt" "${package_partial}/outputs/undefined-symbols.txt"
cp "${image}" "${package_partial}/outputs/Image.gz-dtb"
cp "${output}/System.map" "${package_partial}/outputs/System.map"
cp "${output}/vmlinux" "${package_partial}/outputs/vmlinux"
cp "${prepared_source}/.git/gemini-changed-paths" \
  "${package_partial}/provenance/changed-paths.txt"
"${cross_prefix}gcc" --version > "${package_partial}/provenance/compiler.txt"
"${cross_prefix}ld" --version > "${package_partial}/provenance/linker.txt"
git -C "${prepared_source}" log -2 --format=fuller > \
  "${package_partial}/provenance/source-commits.txt"

baseline_config_sha="$(sha256sum "${output}/baseline.config" | awk '{print $1}')"
readonly baseline_config_sha
jq -n \
  --arg repository_commit "${project_commit}" \
  --arg source_url "${SOURCE_URL}" \
  --arg source_commit "${SOURCE_COMMIT}" \
  --arg patched_commit "${PATCHED_COMMIT}" \
  --arg patch_sha256 "${PATCH_SHA256}" \
  --arg baseline_config_sha256 "${baseline_config_sha}" \
  --arg toolchain_manifest_sha256 "${manifest_sha}" \
  --arg cust_dtsi_sha256 "${CUST_DTSI_SHA256}" \
  --arg completed_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson unresolved_symbol_count "${unresolved_count}" \
  '{repository_commit: $repository_commit, repository_dirty: false,
    purpose: "vendor-runtime-provenance-full-link-compile-review-only",
    build_mode: "provenance-observer", source_url: $source_url,
    source_commit: $source_commit, patched_commit: $patched_commit,
    patch_sha256: $patch_sha256,
    patch_application: "git-am", normal_patch_application: true,
    baseline_configuration: "gemini_modular_defconfig",
    baseline_config_sha256: $baseline_config_sha256,
    observer_config_enabled: true,
    localversion: "-gemini-provenance-observer",
    config_delta_exact: true,
    toolchain_manifest_sha256: $toolchain_manifest_sha256,
    cust_dtsi_sha256: $cust_dtsi_sha256,
    build_architecture: "x86_64", target_architecture: "arm64",
    host_extra_cflags: "-fcommon", full_kernel_link: true,
    unresolved_symbol_count: $unresolved_symbol_count,
    debugfs_mode: "0444", interrupt_safe_observer: true,
    lifecycle_completion_fail_closed: true,
    eem_required_bank_mask: "0x0000003b",
    coherent_transition_owner: false,
    owner_handle: 0, transition_handle: 0, provider: "none",
    hardware_write: "none", cpu8_cpu9_admission: "closed",
    boot_candidate: false, completed_utc: $completed_utc}' > \
  "${package_partial}/provenance/build.json"
(
  cd "${package_partial}"
  find outputs provenance -type f -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS
  sha256sum --check --strict SHA256SUMS >/dev/null
)
rm -rf -- "${output}"
mv "${package_partial}" "${package}"
trap - EXIT
printf 'Packaged Gemian provenance observer compile review at %s\n' "${package}"
