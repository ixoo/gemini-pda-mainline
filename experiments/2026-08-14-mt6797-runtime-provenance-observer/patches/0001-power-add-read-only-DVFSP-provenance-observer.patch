From f3d2a14bd1b8355c68e59e8bd4be6bc1525f9c24 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 14 Aug 2026 20:30:00 -0400
Subject: [PATCH] power: add read-only DVFSP provenance observer

---
 drivers/misc/mediatek/base/power/Kconfig      |  11 +
 .../misc/mediatek/base/power/mt6797/Makefile  |   1 +
 .../mt6797/mt6797-dvfsp-provenance-observer.c | 281 ++++++++++++++++++
 .../mt6797/mt6797-dvfsp-provenance-observer.h |  28 ++
 .../misc/mediatek/base/power/mt6797/mt_eem.c  |   5 +
 .../base/power/ppm_v1/src/mt_ppm_api.c        |   3 +
 6 files changed, 329 insertions(+)
 create mode 100644 drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.c
 create mode 100644 drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.h

diff --git a/drivers/misc/mediatek/base/power/Kconfig b/drivers/misc/mediatek/base/power/Kconfig
index 2197aade3..b64b51b88 100644
--- a/drivers/misc/mediatek/base/power/Kconfig
+++ b/drivers/misc/mediatek/base/power/Kconfig
@@ -92,3 +92,14 @@ config MTK_CPU_HOTPLUG_DEBUG_3
 	  latency profiling. This information is useful for someone who
 	  care the latency, for example, thermal.
 	  If unsure, say Y.
+
+config GEMINI_MT6797_DVFSP_PROVENANCE_OBSERVER
+	bool "Gemini MT6797 read-only DVFSP provenance observer"
+	depends on ARCH_MT6797 && DEBUG_FS
+	default n
+	help
+	  Publish a bounded read-only debugfs record for the vendor EEM
+	  calibration lifecycle and PPM table commit epoch.  This diagnostic
+	  does not register a regulator provider, replace a setter, write
+	  hardware, or admit CPUs.  Its zero owner and transition handles make
+	  the missing coherent transition owner explicit.
diff --git a/drivers/misc/mediatek/base/power/mt6797/Makefile b/drivers/misc/mediatek/base/power/mt6797/Makefile
index 661c90084..ce343dc98 100644
--- a/drivers/misc/mediatek/base/power/mt6797/Makefile
+++ b/drivers/misc/mediatek/base/power/mt6797/Makefile
@@ -48,6 +48,7 @@ obj-y += mt_eem.o
 obj-y += mt_otp.o
 obj-y += mt_static_power.o
 obj-y += mt_cpufreq.o
+obj-$(CONFIG_GEMINI_MT6797_DVFSP_PROVENANCE_OBSERVER) += mt6797-dvfsp-provenance-observer.o
 obj-y += mt_cpufreq_hybrid.o
 obj-y += mt_idvfs.o
 #obj-y += mt_udi.o
diff --git a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.c b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.c
new file mode 100644
index 000000000..5803777a0
--- /dev/null
+++ b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.c
@@ -0,0 +1,281 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0
+ *
+ * Read-only MT6797 DVFSP provenance observer for the Gemini experiment.
+ */
+#include <linux/bitops.h>
+#include <linux/debugfs.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+#include <mt-plat/mt_devinfo.h>
+
+#include "mt6797-dvfsp-provenance-observer.h"
+
+#define GEMINI_MT6797_DVFSP_PROVENANCE_ABI	1
+#define GEMINI_MT6797_EEM_REQUIRED_BANK_MASK	0x3bU
+
+static DEFINE_SPINLOCK(gemini_mt6797_dvfsp_provenance_lock);
+static u64 gemini_mt6797_dvfsp_observer_generation = 1;
+static u64 gemini_mt6797_dvfsp_table_epoch;
+static u64 gemini_mt6797_dvfsp_calibration_sequence = 1;
+static u64 gemini_mt6797_dvfsp_calibration_handle;
+static u32 gemini_mt6797_dvfsp_ppm_cluster_mask;
+static u32 gemini_mt6797_dvfsp_ppm_expected_clusters;
+static u32 gemini_mt6797_dvfsp_calibration_bank_mask;
+static u32 gemini_mt6797_dvfsp_table_commit_count;
+static u32 gemini_mt6797_dvfsp_calibration_bank_publish_count;
+static u32 gemini_mt6797_dvfsp_calibration_publish_count;
+static u32 gemini_mt6797_dvfsp_calibration_invalidate_count;
+static bool gemini_mt6797_dvfsp_provenance_faulted;
+static struct dentry *gemini_mt6797_dvfsp_debugfs_root;
+
+static bool gemini_mt6797_dvfsp_counter_can_advance(u64 value)
+{
+	return value != ~0ULL;
+}
+
+void gemini_mt6797_dvfsp_provenance_calibration_bank_publish(
+	unsigned int bank)
+{
+	unsigned long flags;
+	u32 bank_bit;
+
+	spin_lock_irqsave(&gemini_mt6797_dvfsp_provenance_lock, flags);
+	if (!gemini_mt6797_dvfsp_counter_can_advance(
+			gemini_mt6797_dvfsp_observer_generation) ||
+	    gemini_mt6797_dvfsp_calibration_bank_publish_count == ~0U ||
+	    bank >= 32) {
+		gemini_mt6797_dvfsp_provenance_faulted = true;
+		gemini_mt6797_dvfsp_calibration_handle = 0;
+		goto out;
+	}
+	bank_bit = BIT(bank);
+	if (!(bank_bit & GEMINI_MT6797_EEM_REQUIRED_BANK_MASK)) {
+		gemini_mt6797_dvfsp_provenance_faulted = true;
+		gemini_mt6797_dvfsp_calibration_handle = 0;
+		goto out;
+	}
+	gemini_mt6797_dvfsp_calibration_bank_mask |= bank_bit;
+	gemini_mt6797_dvfsp_calibration_bank_publish_count++;
+	gemini_mt6797_dvfsp_observer_generation++;
+	if (!gemini_mt6797_dvfsp_calibration_handle &&
+	    gemini_mt6797_dvfsp_calibration_bank_mask ==
+			GEMINI_MT6797_EEM_REQUIRED_BANK_MASK) {
+		if (!gemini_mt6797_dvfsp_counter_can_advance(
+				gemini_mt6797_dvfsp_calibration_sequence) ||
+		    gemini_mt6797_dvfsp_calibration_publish_count == ~0U) {
+			gemini_mt6797_dvfsp_provenance_faulted = true;
+			goto out;
+		}
+		gemini_mt6797_dvfsp_calibration_handle =
+			gemini_mt6797_dvfsp_calibration_sequence++;
+		gemini_mt6797_dvfsp_calibration_publish_count++;
+	}
+out:
+	spin_unlock_irqrestore(&gemini_mt6797_dvfsp_provenance_lock, flags);
+}
+
+void gemini_mt6797_dvfsp_provenance_calibration_invalidate(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&gemini_mt6797_dvfsp_provenance_lock, flags);
+	gemini_mt6797_dvfsp_calibration_handle = 0;
+	gemini_mt6797_dvfsp_calibration_bank_mask = 0;
+	if (!gemini_mt6797_dvfsp_counter_can_advance(
+			gemini_mt6797_dvfsp_observer_generation) ||
+	    gemini_mt6797_dvfsp_calibration_invalidate_count == ~0U) {
+		gemini_mt6797_dvfsp_provenance_faulted = true;
+		goto out;
+	}
+	gemini_mt6797_dvfsp_observer_generation++;
+	gemini_mt6797_dvfsp_calibration_invalidate_count++;
+out:
+	spin_unlock_irqrestore(&gemini_mt6797_dvfsp_provenance_lock, flags);
+}
+
+void gemini_mt6797_dvfsp_provenance_table_commit(unsigned int cluster,
+	unsigned int cluster_count)
+{
+	unsigned long flags;
+	u32 expected_mask;
+
+	spin_lock_irqsave(&gemini_mt6797_dvfsp_provenance_lock, flags);
+	if (!gemini_mt6797_dvfsp_counter_can_advance(
+			gemini_mt6797_dvfsp_observer_generation) ||
+	    gemini_mt6797_dvfsp_table_commit_count == ~0U ||
+	    !cluster_count || cluster_count > 32 || cluster >= cluster_count) {
+		gemini_mt6797_dvfsp_provenance_faulted = true;
+		goto out;
+	}
+	expected_mask = cluster_count == 32 ? ~0U : BIT(cluster_count) - 1;
+	if (gemini_mt6797_dvfsp_ppm_expected_clusters &&
+	    gemini_mt6797_dvfsp_ppm_expected_clusters != cluster_count) {
+		gemini_mt6797_dvfsp_provenance_faulted = true;
+		goto out;
+	}
+	gemini_mt6797_dvfsp_ppm_expected_clusters = cluster_count;
+	gemini_mt6797_dvfsp_ppm_cluster_mask |= BIT(cluster);
+	gemini_mt6797_dvfsp_observer_generation++;
+	gemini_mt6797_dvfsp_table_commit_count++;
+	if (!gemini_mt6797_dvfsp_table_epoch &&
+	    gemini_mt6797_dvfsp_ppm_cluster_mask == expected_mask)
+		gemini_mt6797_dvfsp_table_epoch = 1;
+out:
+	spin_unlock_irqrestore(&gemini_mt6797_dvfsp_provenance_lock, flags);
+}
+
+static u32 gemini_mt6797_dvfsp_variant_id(void)
+{
+	u32 function_word = get_devinfo_with_index(22);
+	u32 date_word = get_devinfo_with_index(61);
+	u32 function_code;
+	u32 date_code;
+	u32 cpu_level;
+	u32 tt_segment = 0;
+
+	if (!function_word && !date_word)
+		return 0;
+	function_code = function_word & 0xf;
+	date_code = (((date_word >> 4) & 0xf) < 7) ? 0 : 1;
+	switch (function_code) {
+	case 0:
+	case 3:
+		cpu_level = 0;
+		break;
+	case 1:
+	case 6:
+		cpu_level = 1;
+		break;
+	case 2:
+	case 7:
+		cpu_level = 2;
+		break;
+	case 0xf:
+		cpu_level = 3;
+		break;
+	case 4:
+		cpu_level = 1;
+		tt_segment = 1;
+		break;
+	default:
+		cpu_level = 0;
+		break;
+	}
+	return 1 + (date_code << 8) + (cpu_level << 4) + tt_segment;
+}
+
+static int gemini_mt6797_dvfsp_provenance_show(struct seq_file *seq,
+	void *unused)
+{
+	unsigned long flags;
+	u64 generation;
+	u64 table_epoch;
+	u64 calibration_handle;
+	u32 ppm_cluster_mask;
+	u32 ppm_expected_clusters;
+	u32 calibration_bank_mask;
+	u32 table_commits;
+	u32 calibration_bank_publishes;
+	u32 calibration_publishes;
+	u32 calibration_invalidates;
+	u32 variant_id;
+	bool faulted;
+	bool observation_complete;
+
+	variant_id = gemini_mt6797_dvfsp_variant_id();
+	spin_lock_irqsave(&gemini_mt6797_dvfsp_provenance_lock, flags);
+	generation = gemini_mt6797_dvfsp_observer_generation;
+	table_epoch = gemini_mt6797_dvfsp_table_epoch;
+	calibration_handle = gemini_mt6797_dvfsp_calibration_handle;
+	ppm_cluster_mask = gemini_mt6797_dvfsp_ppm_cluster_mask;
+	ppm_expected_clusters = gemini_mt6797_dvfsp_ppm_expected_clusters;
+	calibration_bank_mask = gemini_mt6797_dvfsp_calibration_bank_mask;
+	table_commits = gemini_mt6797_dvfsp_table_commit_count;
+	calibration_bank_publishes =
+		gemini_mt6797_dvfsp_calibration_bank_publish_count;
+	calibration_publishes = gemini_mt6797_dvfsp_calibration_publish_count;
+	calibration_invalidates =
+		gemini_mt6797_dvfsp_calibration_invalidate_count;
+	faulted = gemini_mt6797_dvfsp_provenance_faulted;
+	spin_unlock_irqrestore(&gemini_mt6797_dvfsp_provenance_lock, flags);
+	observation_complete = !faulted && variant_id && table_epoch &&
+		calibration_handle;
+
+	seq_printf(seq, "abi=%u\n", GEMINI_MT6797_DVFSP_PROVENANCE_ABI);
+	seq_printf(seq, "state=%s\n", faulted ? "fault" :
+		(observation_complete ? "available" :
+		 (calibration_invalidates ? "invalidated" : "unavailable")));
+	seq_printf(seq, "observation_complete=%u\n", observation_complete);
+	seq_printf(seq, "variant_id=%u\n", variant_id);
+	seq_printf(seq, "observer_generation=%llu\n",
+		(unsigned long long)generation);
+	seq_printf(seq, "table_epoch=%llu\n",
+		(unsigned long long)table_epoch);
+	seq_printf(seq, "calibration_handle=%llu\n",
+		(unsigned long long)calibration_handle);
+	seq_printf(seq, "ppm_expected_cluster_count=%u\n",
+		ppm_expected_clusters);
+	seq_printf(seq, "ppm_cluster_mask=0x%08x\n", ppm_cluster_mask);
+	seq_printf(seq, "eem_required_bank_mask=0x%08x\n",
+		GEMINI_MT6797_EEM_REQUIRED_BANK_MASK);
+	seq_printf(seq, "eem_calibration_bank_mask=0x%08x\n",
+		calibration_bank_mask);
+	seq_printf(seq, "table_commit_count=%u\n", table_commits);
+	seq_printf(seq, "calibration_bank_publish_count=%u\n",
+		calibration_bank_publishes);
+	seq_printf(seq, "calibration_publish_count=%u\n",
+		calibration_publishes);
+	seq_printf(seq, "calibration_invalidate_count=%u\n",
+		calibration_invalidates);
+	seq_puts(seq, "owner_handle=0\ntransition_handle=0\n");
+	seq_puts(seq, "coherent_transition_owner=0\n");
+	seq_puts(seq, "provider=none\nhardware_write=none\n");
+	seq_puts(seq, "cpu8_cpu9_admission=closed\n");
+	return 0;
+}
+
+static int gemini_mt6797_dvfsp_provenance_open(struct inode *inode,
+	struct file *file)
+{
+	return single_open(file, gemini_mt6797_dvfsp_provenance_show,
+		inode->i_private);
+}
+
+static const struct file_operations gemini_mt6797_dvfsp_provenance_fops = {
+	.owner = THIS_MODULE,
+	.open = gemini_mt6797_dvfsp_provenance_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int __init gemini_mt6797_dvfsp_provenance_init(void)
+{
+	struct dentry *state;
+
+	gemini_mt6797_dvfsp_debugfs_root =
+		debugfs_create_dir("gemini_dvfsp_provenance", NULL);
+	if (IS_ERR_OR_NULL(gemini_mt6797_dvfsp_debugfs_root))
+		return gemini_mt6797_dvfsp_debugfs_root ?
+			PTR_ERR(gemini_mt6797_dvfsp_debugfs_root) : -ENOMEM;
+	state = debugfs_create_file("state", 0444,
+		gemini_mt6797_dvfsp_debugfs_root, NULL,
+		&gemini_mt6797_dvfsp_provenance_fops);
+	if (IS_ERR_OR_NULL(state)) {
+		debugfs_remove_recursive(gemini_mt6797_dvfsp_debugfs_root);
+		return state ? PTR_ERR(state) : -ENOMEM;
+	}
+	pr_info("Gemini MT6797 DVFSP provenance observer ready\n");
+	return 0;
+}
+late_initcall(gemini_mt6797_dvfsp_provenance_init);
+
+MODULE_DESCRIPTION("Gemini MT6797 read-only DVFSP provenance observer");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.h b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.h
new file mode 100644
index 000000000..3d9cae708
--- /dev/null
+++ b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-provenance-observer.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __MT6797_DVFSP_PROVENANCE_OBSERVER_H__
+#define __MT6797_DVFSP_PROVENANCE_OBSERVER_H__
+
+#ifdef CONFIG_GEMINI_MT6797_DVFSP_PROVENANCE_OBSERVER
+void gemini_mt6797_dvfsp_provenance_calibration_bank_publish(
+	unsigned int bank);
+void gemini_mt6797_dvfsp_provenance_calibration_invalidate(void);
+void gemini_mt6797_dvfsp_provenance_table_commit(unsigned int cluster,
+	unsigned int cluster_count);
+#else
+static inline void
+gemini_mt6797_dvfsp_provenance_calibration_bank_publish(unsigned int bank)
+{
+}
+
+static inline void
+gemini_mt6797_dvfsp_provenance_calibration_invalidate(void)
+{
+}
+
+static inline void gemini_mt6797_dvfsp_provenance_table_commit(
+	unsigned int cluster, unsigned int cluster_count)
+{
+}
+#endif
+
+#endif /* __MT6797_DVFSP_PROVENANCE_OBSERVER_H__ */
diff --git a/drivers/misc/mediatek/base/power/mt6797/mt_eem.c b/drivers/misc/mediatek/base/power/mt6797/mt_eem.c
index b8a16b773..143b30200 100644
--- a/drivers/misc/mediatek/base/power/mt6797/mt_eem.c
+++ b/drivers/misc/mediatek/base/power/mt6797/mt_eem.c
@@ -1037,6 +1037,7 @@ static unsigned int cpu_speed;
 	#include "mach/mt_ppm_api.h"
 	#include "mt_gpufreq.h"
 	#include "mt_cpufreq.h"
+	#include "mt6797-dvfsp-provenance-observer.h"
 	#include "mt_ptp.h"
 	#include "mt_defptp.h"
 	#include <mach/mt_secure_api.h>
@@ -3998,6 +3999,8 @@ static inline void handle_init02_isr(struct eem_det *det)
 		cpu_in_mon = 0;
 	#endif
 	eem_set_eem_volt(det);
+	gemini_mt6797_dvfsp_provenance_calibration_bank_publish(
+		det->ctrl_id);
 
 	/*
 	 * Set EEMEN.EEMINITEN/EEMEN.EEMINIT2EN = 0x0 &
@@ -5141,6 +5144,7 @@ static int eem_resume(struct platform_device *pdev)
 	}
 	*/
 	FUNC_ENTER(FUNC_LV_MODULE);
+	gemini_mt6797_dvfsp_provenance_calibration_invalidate();
 	#ifdef __KERNEL__
 	mt_cpufreq_eem_resume();
 	#endif
@@ -6558,6 +6562,7 @@ int __init eem_init(void)
 static void __exit eem_exit(void)
 {
 	FUNC_ENTER(FUNC_LV_MODULE);
+	gemini_mt6797_dvfsp_provenance_calibration_invalidate();
 	eem_debug("eem de-initialization\n");
 	FUNC_EXIT(FUNC_LV_MODULE);
 }
