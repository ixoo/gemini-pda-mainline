From 883fb98a6452e4b8980ca1deca35801138cfaabc Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 18:43:04 +0000
Subject: [PATCH] power: bind vendor writer lifecycle and runtime events

---
 .../power/mt6797/mt6797-dvfsp-vendor-writer.c | 286 +++++++++++++++++-
 .../power/mt6797/mt6797-dvfsp-vendor-writer.h |  56 +++-
 .../mediatek/base/power/mt6797/mt_cpufreq.c   | 118 +++++++-
 .../base/power/mt6797/mt_cpufreq_hybrid.c     |   6 +
 4 files changed, 458 insertions(+), 8 deletions(-)

diff --git a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c
index 73135a503..20d24697e 100644
--- a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c
+++ b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c
@@ -9,6 +9,7 @@
 #include <linux/interrupt.h>
 #include <linux/mutex.h>
 #include <linux/sched.h>
+#include <linux/workqueue.h>
 #include <linux/types.h>
 
 #include "mt6797-dvfsp-vendor-writer.h"
@@ -21,13 +22,32 @@ static void *gemini_mt6797_dvfsp_vendor_writer_context;
 struct gemini_mt6797_dvfsp_vendor_writer_mainline_binding {
 	const struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops *ops;
 	void *context;
+	const struct gemini_mt6797_dvfsp_vendor_runtime_ops *runtime_ops;
+	void *runtime_context;
 	u64 owner_handle;
 	u64 transition_handle;
+	bool runtime_events_enabled;
 };
 
 static struct gemini_mt6797_dvfsp_vendor_writer_mainline_binding
 gemini_mt6797_dvfsp_vendor_writer_mainline_binding;
 
+static DEFINE_MUTEX(gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+static const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops
+	*gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops;
+static void *gemini_mt6797_dvfsp_vendor_writer_lifecycle_context;
+static bool gemini_mt6797_dvfsp_vendor_writer_lifecycle_registering;
+static bool gemini_mt6797_dvfsp_vendor_writer_lifecycle_registered;
+static bool gemini_mt6797_dvfsp_vendor_writer_lifecycle_unregistering;
+
+static unsigned int gemini_mt6797_dvfsp_vendor_writer_deferred_type;
+static unsigned int gemini_mt6797_dvfsp_vendor_writer_deferred_cpu;
+static bool gemini_mt6797_dvfsp_vendor_writer_deferred_pending;
+static void gemini_mt6797_dvfsp_vendor_writer_deferred_work(
+	struct work_struct *work);
+static DECLARE_WORK(gemini_mt6797_dvfsp_vendor_writer_work,
+	gemini_mt6797_dvfsp_vendor_writer_deferred_work);
+
 static bool gemini_mt6797_dvfsp_vendor_writer_mainline_ops_valid(
 	const struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops *ops)
 {
@@ -35,6 +55,29 @@ static bool gemini_mt6797_dvfsp_vendor_writer_mainline_ops_valid(
 		ops->begin && ops->commit && ops->abort && ops->read_identity;
 }
 
+static bool gemini_mt6797_dvfsp_vendor_runtime_ops_valid(
+	const struct gemini_mt6797_dvfsp_vendor_runtime_ops *ops)
+{
+	return ops && ops->abi == GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_EVENT_ABI &&
+		ops->event;
+}
+
+static bool gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops_valid(
+	const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops *ops)
+{
+	return ops &&
+		ops->abi == GEMINI_MT6797_DVFSP_VENDOR_OWNER_LIFECYCLE_ABI &&
+		ops->register_writer && ops->unregister_writer;
+}
+
+static int gemini_mt6797_dvfsp_vendor_runtime_event_check(
+	unsigned int type, unsigned int cpu)
+{
+	if (type >= GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_EVENT_COUNT)
+		return -EINVAL;
+	return 0;
+}
+
 static int gemini_mt6797_dvfsp_vendor_writer_mainline_begin(
 	void *context,
 	enum gemini_mt6797_dvfsp_vendor_writer_site site, u64 *generation)
@@ -167,12 +210,16 @@ EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_unregister);
 
 int gemini_mt6797_dvfsp_vendor_writer_register_mainline_owner(
 	const struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops *ops,
-	void *context, u64 owner_handle, u64 transition_handle)
+	void *context,
+	const struct gemini_mt6797_dvfsp_vendor_runtime_ops *runtime_ops,
+	void *runtime_context, u64 owner_handle, u64 transition_handle)
 {
 	int ret = 0;
 
 	if (!gemini_mt6797_dvfsp_vendor_writer_mainline_ops_valid(ops) ||
-		!context || !owner_handle || !transition_handle)
+		!gemini_mt6797_dvfsp_vendor_runtime_ops_valid(runtime_ops) ||
+		!context || !runtime_context || !owner_handle ||
+		!transition_handle)
 		return -EINVAL;
 
 	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lock);
@@ -185,6 +232,12 @@ int gemini_mt6797_dvfsp_vendor_writer_register_mainline_owner(
 			owner_handle;
 		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.transition_handle =
 			transition_handle;
+		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.runtime_ops =
+			runtime_ops;
+		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.runtime_context =
+			runtime_context;
+		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.runtime_events_enabled =
+			true;
 		gemini_mt6797_dvfsp_vendor_writer_ops =
 			&gemini_mt6797_dvfsp_vendor_writer_mainline_writer_ops;
 		gemini_mt6797_dvfsp_vendor_writer_context =
@@ -198,7 +251,9 @@ EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_register_mainline_owner);
 
 int gemini_mt6797_dvfsp_vendor_writer_unregister_mainline_owner(
 	const struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops *ops,
-	void *context, u64 owner_handle, u64 transition_handle)
+	void *context,
+	const struct gemini_mt6797_dvfsp_vendor_runtime_ops *runtime_ops,
+	void *runtime_context, u64 owner_handle, u64 transition_handle)
 {
 	int ret = 0;
 
@@ -209,12 +264,21 @@ int gemini_mt6797_dvfsp_vendor_writer_unregister_mainline_owner(
 			&gemini_mt6797_dvfsp_vendor_writer_mainline_binding ||
 		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.ops != ops ||
 		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.context != context ||
+		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.runtime_ops !=
+			runtime_ops ||
+		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.runtime_context !=
+			runtime_context ||
 		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.owner_handle !=
 			owner_handle ||
 		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.transition_handle !=
 			transition_handle) {
 		ret = -ENOENT;
 	} else {
+		gemini_mt6797_dvfsp_vendor_writer_mainline_binding.runtime_events_enabled =
+			false;
+		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+		flush_work(&gemini_mt6797_dvfsp_vendor_writer_work);
+		mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lock);
 		gemini_mt6797_dvfsp_vendor_writer_ops = NULL;
 		gemini_mt6797_dvfsp_vendor_writer_context = NULL;
 		memset(&gemini_mt6797_dvfsp_vendor_writer_mainline_binding, 0,
@@ -226,6 +290,105 @@ int gemini_mt6797_dvfsp_vendor_writer_unregister_mainline_owner(
 }
 EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_unregister_mainline_owner);
 
+int gemini_mt6797_dvfsp_vendor_writer_set_owner_lifecycle_ops(
+	const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops *ops,
+	void *context)
+{
+	if (!gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops_valid(ops) ||
+		!context)
+		return -EINVAL;
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	if (gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_registering ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_registered ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_unregistering) {
+		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+		return -EBUSY;
+	}
+	gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops = ops;
+	gemini_mt6797_dvfsp_vendor_writer_lifecycle_context = context;
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_set_owner_lifecycle_ops);
+
+int gemini_mt6797_dvfsp_vendor_writer_clear_owner_lifecycle_ops(
+	const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops *ops,
+	void *context)
+{
+	int ret = 0;
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	if (gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops != ops ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_context != context)
+		ret = -ENOENT;
+	else if (gemini_mt6797_dvfsp_vendor_writer_lifecycle_registering ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_registered ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_unregistering)
+		ret = -EBUSY;
+	else {
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops = NULL;
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_context = NULL;
+	}
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_clear_owner_lifecycle_ops);
+
+int gemini_mt6797_dvfsp_vendor_writer_owner_lifecycle_register(void)
+{
+	const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops *ops;
+	void *context;
+	int ret;
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	if (gemini_mt6797_dvfsp_vendor_writer_lifecycle_registered ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_registering ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_unregistering) {
+		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+		return -EBUSY;
+	}
+	ops = gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops;
+	context = gemini_mt6797_dvfsp_vendor_writer_lifecycle_context;
+	if (!ops) {
+		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+		return -EOPNOTSUPP;
+	}
+	gemini_mt6797_dvfsp_vendor_writer_lifecycle_registering = true;
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	ret = ops->register_writer(context);
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	gemini_mt6797_dvfsp_vendor_writer_lifecycle_registering = false;
+	if (!ret)
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_registered = true;
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_owner_lifecycle_register);
+
+int gemini_mt6797_dvfsp_vendor_writer_owner_lifecycle_unregister(void)
+{
+	const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops *ops;
+	void *context;
+	int ret;
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	if (!gemini_mt6797_dvfsp_vendor_writer_lifecycle_registered ||
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_unregistering) {
+		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+		return -EINVAL;
+	}
+	ops = gemini_mt6797_dvfsp_vendor_writer_lifecycle_ops;
+	context = gemini_mt6797_dvfsp_vendor_writer_lifecycle_context;
+	gemini_mt6797_dvfsp_vendor_writer_lifecycle_unregistering = true;
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	ret = ops->unregister_writer(context);
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	gemini_mt6797_dvfsp_vendor_writer_lifecycle_unregistering = false;
+	if (!ret)
+		gemini_mt6797_dvfsp_vendor_writer_lifecycle_registered = false;
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lifecycle_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_owner_lifecycle_unregister);
+
 int gemini_mt6797_dvfsp_vendor_writer_begin(
 	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
 	enum gemini_mt6797_dvfsp_vendor_writer_site site)
@@ -276,6 +439,123 @@ int gemini_mt6797_dvfsp_vendor_writer_begin(
 }
 EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_begin);
 
+int gemini_mt6797_dvfsp_vendor_writer_transaction_event(
+	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
+	unsigned int type, unsigned int cpu)
+{
+	struct gemini_mt6797_dvfsp_vendor_writer_mainline_binding *binding;
+
+	if (!transaction || !transaction->active ||
+		gemini_mt6797_dvfsp_vendor_runtime_event_check(type, cpu))
+		return -EINVAL;
+	if (gemini_mt6797_dvfsp_vendor_writer_ops !=
+		&gemini_mt6797_dvfsp_vendor_writer_mainline_writer_ops)
+		return -ENODEV;
+	binding = gemini_mt6797_dvfsp_vendor_writer_context;
+	if (!binding || !binding->runtime_events_enabled ||
+		!binding->runtime_ops || !binding->runtime_ops->event)
+		return -ENODEV;
+	return binding->runtime_ops->event(binding->runtime_context, type, cpu);
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_transaction_event);
+
+int gemini_mt6797_dvfsp_vendor_writer_transaction_event_or_abort(
+	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
+	unsigned int type, unsigned int cpu)
+{
+	int ret;
+	int abort_ret;
+
+	ret = gemini_mt6797_dvfsp_vendor_writer_transaction_event(
+		transaction, type, cpu);
+	if (!ret)
+		return 0;
+	abort_ret = gemini_mt6797_dvfsp_vendor_writer_finish(transaction, ret);
+	return abort_ret ? abort_ret : ret;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_transaction_event_or_abort);
+
+int gemini_mt6797_dvfsp_vendor_writer_runtime_event(
+	unsigned int type, unsigned int cpu)
+{
+	struct gemini_mt6797_dvfsp_vendor_writer_mainline_binding *binding;
+	int ret;
+	ret = gemini_mt6797_dvfsp_vendor_runtime_event_check(type, cpu);
+	if (ret)
+		return ret;
+	if (in_atomic() || irqs_disabled())
+		return -EWOULDBLOCK;
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	if (gemini_mt6797_dvfsp_vendor_writer_ops !=
+		&gemini_mt6797_dvfsp_vendor_writer_mainline_writer_ops)
+		binding = NULL;
+	else
+		binding = gemini_mt6797_dvfsp_vendor_writer_context;
+	if (!binding || !binding->runtime_events_enabled ||
+		!binding->runtime_ops || !binding->runtime_ops->event)
+		ret = -ENODEV;
+	else
+		ret = binding->runtime_ops->event(binding->runtime_context, type, cpu);
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_runtime_event);
+
+static void gemini_mt6797_dvfsp_vendor_writer_deferred_work(
+	struct work_struct *work)
+{
+	struct gemini_mt6797_dvfsp_vendor_writer_mainline_binding *binding;
+	unsigned int type, cpu;
+
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	if (!gemini_mt6797_dvfsp_vendor_writer_deferred_pending) {
+		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+		return;
+	}
+	type = gemini_mt6797_dvfsp_vendor_writer_deferred_type;
+	cpu = gemini_mt6797_dvfsp_vendor_writer_deferred_cpu;
+	gemini_mt6797_dvfsp_vendor_writer_deferred_pending = false;
+	if (gemini_mt6797_dvfsp_vendor_writer_ops ==
+		&gemini_mt6797_dvfsp_vendor_writer_mainline_writer_ops)
+		binding = gemini_mt6797_dvfsp_vendor_writer_context;
+	else
+		binding = NULL;
+	if (binding && binding->runtime_events_enabled &&
+		binding->runtime_ops && binding->runtime_ops->event)
+		binding->runtime_ops->event(binding->runtime_context, type, cpu);
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+}
+
+int gemini_mt6797_dvfsp_vendor_writer_runtime_event_deferred(
+	unsigned int type, unsigned int cpu)
+{
+	struct gemini_mt6797_dvfsp_vendor_writer_mainline_binding *binding;
+	int ret;
+	ret = gemini_mt6797_dvfsp_vendor_runtime_event_check(type, cpu);
+	if (ret)
+		return ret;
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	if (gemini_mt6797_dvfsp_vendor_writer_ops ==
+		&gemini_mt6797_dvfsp_vendor_writer_mainline_writer_ops)
+		binding = gemini_mt6797_dvfsp_vendor_writer_context;
+	else
+		binding = NULL;
+	if (!binding || !binding->runtime_events_enabled)
+		ret = -ENODEV;
+	else if (gemini_mt6797_dvfsp_vendor_writer_deferred_pending)
+		ret = -EBUSY;
+	else {
+		gemini_mt6797_dvfsp_vendor_writer_deferred_type = type;
+		gemini_mt6797_dvfsp_vendor_writer_deferred_cpu = cpu;
+		gemini_mt6797_dvfsp_vendor_writer_deferred_pending = true;
+		schedule_work(&gemini_mt6797_dvfsp_vendor_writer_work);
+		ret = 0;
+	}
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_runtime_event_deferred);
+
 int gemini_mt6797_dvfsp_vendor_writer_finish(
 	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
 	int result)
diff --git a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h
index 4e4da36b6..737ee3fa5 100644
--- a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h
+++ b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h
@@ -21,6 +21,32 @@ enum gemini_mt6797_dvfsp_vendor_writer_site {
 };
 
 #define GEMINI_MT6797_DVFSP_VENDOR_WRITER_ABI	2
+#define GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_EVENT_ABI	1
+#define GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_EVENT_COUNT	8
+#define GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_CPU_NONE	(~0U)
+#define GEMINI_MT6797_DVFSP_VENDOR_OWNER_LIFECYCLE_ABI	1
+
+enum gemini_mt6797_dvfsp_vendor_runtime_event_type {
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_CPU_ONLINE,
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_CPU_DOWN_PREPARE,
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_CPU_DOWN_FAILED,
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_PM_SUSPEND_PREPARE,
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_PM_POST_SUSPEND,
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_CLOCK_TRANSITION,
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_RAIL_TRANSITION,
+	GEMINI_MT6797_DVFSP_VENDOR_RUNTIME_PCM_FAULT,
+};
+
+struct gemini_mt6797_dvfsp_vendor_runtime_ops {
+	u32 abi;
+	int (*event)(void *context, unsigned int type, unsigned int cpu);
+};
+
+struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops {
+	u32 abi;
+	int (*register_writer)(void *context);
+	int (*unregister_writer)(void *context);
+};
 
 struct gemini_mt6797_dvfsp_vendor_writer_transaction {
 	enum gemini_mt6797_dvfsp_vendor_writer_site site;
@@ -62,10 +88,23 @@ struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops {
 
 int gemini_mt6797_dvfsp_vendor_writer_register_mainline_owner(
 	const struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops *ops,
-	void *context, u64 owner_handle, u64 transition_handle);
+	void *context,
+	const struct gemini_mt6797_dvfsp_vendor_runtime_ops *runtime_ops,
+	void *runtime_context, u64 owner_handle, u64 transition_handle);
 int gemini_mt6797_dvfsp_vendor_writer_unregister_mainline_owner(
 	const struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops *ops,
-	void *context, u64 owner_handle, u64 transition_handle);
+	void *context,
+	const struct gemini_mt6797_dvfsp_vendor_runtime_ops *runtime_ops,
+	void *runtime_context, u64 owner_handle, u64 transition_handle);
+
+int gemini_mt6797_dvfsp_vendor_writer_set_owner_lifecycle_ops(
+	const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops *ops,
+	void *context);
+int gemini_mt6797_dvfsp_vendor_writer_clear_owner_lifecycle_ops(
+	const struct gemini_mt6797_dvfsp_vendor_owner_lifecycle_ops *ops,
+	void *context);
+int gemini_mt6797_dvfsp_vendor_writer_owner_lifecycle_register(void);
+int gemini_mt6797_dvfsp_vendor_writer_owner_lifecycle_unregister(void);
 
 int gemini_mt6797_dvfsp_vendor_writer_register(
 	const struct gemini_mt6797_dvfsp_vendor_writer_ops *ops,
@@ -86,4 +125,17 @@ int gemini_mt6797_dvfsp_vendor_writer_finish(
 	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
 	int result);
 
+/* begin/finish hold the shared writer lock around these callbacks. */
