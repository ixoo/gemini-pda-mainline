From 0000000000000000000000000000000000000015 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 11 Aug 2026 03:20:00 -0400
Subject: [PATCH] power: publish explicit vendor provenance handles

Add the vendor-owned publication required by the provenance contract. EEM
publishes an opaque calibration-lifecycle token only after its table setup is
complete and invalidates it on teardown or resume. The writer bridge maintains
a separate mutable-table epoch, advances it only for committed PTP/table
updates, and exposes both values only while the observation transaction holds
the shared writer lock. PPM table registration now uses that same transaction
without replacing its existing client callback.

The source adapter derives the variant token from the pinned vendor efuse
fields, echoes the exact observation generation and owner handles, and fails
closed on a changed snapshot or unavailable lifecycle token. This remains an
experiment-only cooperation patch: no provider, setter replacement, firmware
operation, hardware write, device boot, or CPU admission is performed.
---
 drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h |  10 +
 drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c | 176 ++++++++++++++++++++
 drivers/misc/mediatek/base/power/mt6797/mt_eem.c                    |  12 +
 drivers/misc/mediatek/base/power/ppm_v1/src/mt_ppm_api.c            |  22 +++
 4 files changed, 220 insertions(+)

diff --git a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h
--- a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h
+++ b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.h
@@ -88,5 +88,6 @@ struct gemini_mt6797_dvfsp_vendor_writer_transaction {
 	u64 generation;
 	u64 owner_handle;
 	u64 transition_handle;
+	bool table_update;
 	bool active;
 };
@@ -161,9 +162,18 @@ int gemini_mt6797_dvfsp_vendor_writer_finish(
 	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
 	int result);
+int gemini_mt6797_dvfsp_vendor_writer_prepare_table_update(
+	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction);
+int gemini_mt6797_dvfsp_vendor_writer_publish_calibration_handle(void);
+int gemini_mt6797_dvfsp_vendor_writer_invalidate_calibration_handle(void);
+int gemini_mt6797_dvfsp_vendor_writer_read_provenance(
+	const struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
+	u64 *table_epoch, u64 *calibration_handle);
 int gemini_mt6797_dvfsp_vendor_writer_abort_observation(
 	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction);
 
+/* prepare/read are called while the shared writer transaction is held. */
+
 /* begin/finish hold the shared writer lock around these callbacks. */
 int gemini_mt6797_dvfsp_vendor_writer_transaction_event(
 	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
 	unsigned int type, unsigned int cpu);
diff --git a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c
--- a/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c
+++ b/drivers/misc/mediatek/base/power/mt6797/mt6797-dvfsp-vendor-writer.c
@@ -23,5 +23,8 @@ static const struct gemini_mt6797_dvfsp_vendor_writer_ops
 	*gemini_mt6797_dvfsp_vendor_writer_ops;
 static void *gemini_mt6797_dvfsp_vendor_writer_context;
+static u64 gemini_mt6797_dvfsp_vendor_writer_table_epoch = 1;
+static u64 gemini_mt6797_dvfsp_vendor_writer_calibration_sequence = 1;
+static u64 gemini_mt6797_dvfsp_vendor_writer_calibration_handle;
 
 struct gemini_mt6797_dvfsp_vendor_writer_mainline_binding {
 	const struct gemini_mt6797_dvfsp_vendor_writer_mainline_ops *ops;
@@ -670,4 +674,6 @@ int gemini_mt6797_dvfsp_vendor_writer_begin(
 	transaction->generation = 0;
 	transaction->owner_handle = 0;
 	transaction->transition_handle = 0;
+	transaction->table_update =
+		site == GEMINI_MT6797_DVFSP_VENDOR_WRITER_SITE_PTP_TABLE;
 	transaction->active = false;
@@ -686,5 +691,10 @@ int gemini_mt6797_dvfsp_vendor_writer_begin(
 		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
 		return ret ? ret : -EPROTO;
 	}
+	if (transaction->table_update &&
+	    gemini_mt6797_dvfsp_vendor_writer_table_epoch == ~0ULL) {
+		mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+		return -EOVERFLOW;
+	}
 
 	ret = ops->begin(context, site, &transaction->generation);
@@ -700,5 +710,60 @@ int gemini_mt6797_dvfsp_vendor_writer_begin(
 EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_begin);
 
+int gemini_mt6797_dvfsp_vendor_writer_prepare_table_update(
+	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction)
+{
+	if (!transaction || !transaction->active ||
+	    transaction->site != GEMINI_MT6797_DVFSP_VENDOR_WRITER_SITE_PPM)
+		return -EINVAL;
+	if (gemini_mt6797_dvfsp_vendor_writer_table_epoch == ~0ULL)
+		return -EOVERFLOW;
+	transaction->table_update = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_prepare_table_update);
+
+int gemini_mt6797_dvfsp_vendor_writer_publish_calibration_handle(void)
+{
+	int ret = 0;
+
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	if (gemini_mt6797_dvfsp_vendor_writer_calibration_sequence == ~0ULL)
+		ret = -EOVERFLOW;
+	else
+		gemini_mt6797_dvfsp_vendor_writer_calibration_handle =
+			gemini_mt6797_dvfsp_vendor_writer_calibration_sequence++;
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_publish_calibration_handle);
+
+int gemini_mt6797_dvfsp_vendor_writer_invalidate_calibration_handle(void)
+{
+	mutex_lock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	gemini_mt6797_dvfsp_vendor_writer_calibration_handle = 0;
+	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_invalidate_calibration_handle);
+
+int gemini_mt6797_dvfsp_vendor_writer_read_provenance(
+	const struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
+	u64 *table_epoch, u64 *calibration_handle)
+{
+	if (!transaction || !transaction->active ||
+	    transaction->site != GEMINI_MT6797_DVFSP_VENDOR_WRITER_SITE_OBSERVE ||
+	    !table_epoch || !calibration_handle)
+		return -EINVAL;
+	if (!gemini_mt6797_dvfsp_vendor_writer_table_epoch ||
+	    !gemini_mt6797_dvfsp_vendor_writer_calibration_handle)
+		return -ENODEV;
+	*table_epoch = gemini_mt6797_dvfsp_vendor_writer_table_epoch;
+	*calibration_handle =
+		gemini_mt6797_dvfsp_vendor_writer_calibration_handle;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gemini_mt6797_dvfsp_vendor_writer_read_provenance);
+
 int gemini_mt6797_dvfsp_vendor_writer_transaction_event(
 	struct gemini_mt6797_dvfsp_vendor_writer_transaction *transaction,
 	unsigned int type, unsigned int cpu)
@@ -850,5 +940,12 @@ int gemini_mt6797_dvfsp_vendor_writer_finish(
+	if (!ret && transaction->table_update) {
+		if (gemini_mt6797_dvfsp_vendor_writer_table_epoch == ~0ULL)
+			ret = -EOVERFLOW;
+		else
+			gemini_mt6797_dvfsp_vendor_writer_table_epoch++;
+	}
 	transaction->site = GEMINI_MT6797_DVFSP_VENDOR_WRITER_SITE_COUNT;
 	transaction->generation = 0;
 	transaction->owner_handle = 0;
 	transaction->transition_handle = 0;
+	transaction->table_update = false;
 	transaction->active = false;
@@ -874,5 +973,6 @@ int gemini_mt6797_dvfsp_vendor_writer_abort_observation(
 	transaction->generation = 0;
 	transaction->owner_handle = 0;
 	transaction->transition_handle = 0;
+	transaction->table_update = false;
 	transaction->active = false;
 	mutex_unlock(&gemini_mt6797_dvfsp_vendor_writer_lock);
@@ -1149,11 +1249,114 @@ static int gemini_mt6797_dvfsp_vendor_source_identity_observation(
 	return abort_ret ? abort_ret : ret;
 }
 
+static u32 gemini_mt6797_dvfsp_vendor_source_variant_id(void)
+{
+	u32 function_word = get_devinfo_with_index(22);
+	u32 date_word = get_devinfo_with_index(61);
+	u32 function_code;
+	u32 date_code;
+	u32 cpu_level;
+	u32 tt_segment = 0;
+
+	if (!function_word && !date_word)
+		return 0;
+	function_code = function_word & 0xf;
+	date_code = (((date_word >> 4) & 0xf) < 7) ? 0 : 1;
+
+	switch (function_code) {
+	case 0:
+	case 3:
+		cpu_level = 0;
+		break;
+	case 1:
+	case 6:
+		cpu_level = 1;
+		break;
+	case 2:
+	case 7:
+		cpu_level = 2;
+		break;
+	case 0xf:
+		cpu_level = 3;
+		break;
+	case 4:
+		cpu_level = 1;
+		tt_segment = 1;
+		break;
+	default:
+		cpu_level = 0;
+		break;
+	}
+
+	return 1 + (date_code << 8) + (cpu_level << 4) + tt_segment;
+}
+
+static int gemini_mt6797_dvfsp_vendor_source_provenance(
+	void *context,
+	const struct mt6797_dvfsp_vendor_source_snapshot *snapshot,
+	struct mt6797_dvfsp_vendor_source_provenance *provenance)
+{
+	struct gemini_mt6797_dvfsp_vendor_writer_integration_binding *binding =
+		context;
+	struct gemini_mt6797_dvfsp_vendor_writer_transaction transaction = { };
+	u64 table_epoch;
+	u64 calibration_handle;
+	u32 variant_id;
+	int ret;
+	int abort_ret;
+
+	if (binding !=
+		&gemini_mt6797_dvfsp_vendor_writer_integration_binding ||
+	    !binding->bound || !binding->mainline_registered ||
+	    !snapshot || !provenance)
+		return -ENODEV;
+
+	ret = gemini_mt6797_dvfsp_vendor_writer_begin(&transaction,
+		GEMINI_MT6797_DVFSP_VENDOR_WRITER_SITE_OBSERVE);
+	if (ret)
+		return ret;
+	if (transaction.generation != snapshot->generation ||
+	    transaction.owner_handle != snapshot->owner_handle ||
+	    transaction.transition_handle != snapshot->transition_handle) {
+		ret = -EAGAIN;
+		goto abort;
+	}
+
+	table_epoch = 0;
+	calibration_handle = 0;
+	ret = gemini_mt6797_dvfsp_vendor_writer_read_provenance(
+		&transaction, &table_epoch, &calibration_handle);
+	if (ret)
+		goto abort;
+	variant_id = gemini_mt6797_dvfsp_vendor_source_variant_id();
+	if (!variant_id) {
+		ret = -EPROTO;
+		goto abort;
+	}
+
+	memset(provenance, 0, sizeof(*provenance));
+	provenance->abi = MT6797_DVFSP_VENDOR_SOURCE_PROVENANCE_ABI;
+	provenance->variant_id = variant_id;
+	provenance->table_epoch = table_epoch;
+	provenance->calibration_handle = calibration_handle;
+	provenance->source_generation = transaction.generation;
+	provenance->owner_handle = transaction.owner_handle;
+	provenance->transition_handle = transaction.transition_handle;
+	ret = gemini_mt6797_dvfsp_vendor_writer_abort_observation(&transaction);
+	return ret;
+
+abort:
+	abort_ret = gemini_mt6797_dvfsp_vendor_writer_abort_observation(
+		&transaction);
+	return abort_ret ? abort_ret : ret;
+}
+
 static const struct mt6797_dvfsp_vendor_source_ops
 gemini_mt6797_dvfsp_vendor_source_ops = {
 	.abi = MT6797_DVFSP_VENDOR_SOURCE_ABI,
 	.snapshot = gemini_mt6797_dvfsp_vendor_source_snapshot,
 	.read_identity = gemini_mt6797_dvfsp_vendor_source_identity,
 	.read_identity_observation =
 		gemini_mt6797_dvfsp_vendor_source_identity_observation,
+	.read_provenance = gemini_mt6797_dvfsp_vendor_source_provenance,
 };
diff --git a/drivers/misc/mediatek/base/power/mt6797/mt_eem.c b/drivers/misc/mediatek/base/power/mt6797/mt_eem.c
--- a/drivers/misc/mediatek/base/power/mt6797/mt_eem.c
+++ b/drivers/misc/mediatek/base/power/mt6797/mt_eem.c
@@ -1037,4 +1037,5 @@
 	#include "mt_gpufreq.h"
 	#include "mt_cpufreq.h"
+	#include "mt6797-dvfsp-vendor-writer.h"
 	#include "mt_ptp.h"
 	#include "mt_defptp.h"
@@ -5103,6 +5104,11 @@
 		mt_cpufreq_set_ptbl_registerCB(mt_cpufreq_set_ptbl_funcEEM);
 		eem_init01();
 	#endif
 	ptp_data[0] = 0;
+	ret = gemini_mt6797_dvfsp_vendor_writer_publish_calibration_handle();
+	if (ret) {
+		eem_error("calibration handle publication failed: %d\\n", ret);
+		return ret;
+	}
 
 	#if (defined(__KERNEL__) && !defined(EARLY_PORTING))
@@ -5135,2 +5143,3 @@ static int eem_resume(struct platform_device *pdev)
 static int eem_resume(struct platform_device *pdev)
 {
+	int ret;
@@ -5148,1 +5158,5 @@
+	gemini_mt6797_dvfsp_vendor_writer_invalidate_calibration_handle();
 	eem_init02();
+	ret = gemini_mt6797_dvfsp_vendor_writer_publish_calibration_handle();
+	if (ret)
+		return ret;
@@ -6561,1 +6578,2 @@ static void __exit eem_exit(void)
 	FUNC_ENTER(FUNC_LV_MODULE);
+	gemini_mt6797_dvfsp_vendor_writer_invalidate_calibration_handle();
diff --git a/drivers/misc/mediatek/base/power/ppm_v1/src/mt_ppm_api.c b/drivers/misc/mediatek/base/power/ppm_v1/src/mt_ppm_api.c
--- a/drivers/misc/mediatek/base/power/ppm_v1/src/mt_ppm_api.c
+++ b/drivers/misc/mediatek/base/power/ppm_v1/src/mt_ppm_api.c
@@ -13,9 +13,12 @@
 
 
 #include "mt_ppm_internal.h"
+#include "../../mt6797/mt6797-dvfsp-vendor-writer.h"
 
 /* APIs */
 void mt_ppm_set_dvfs_table(unsigned int cpu, struct cpufreq_frequency_table *tbl,
 	unsigned int num, enum dvfs_table_type type)
 {
 	int i, j;
+	int writer_ret;
+	struct gemini_mt6797_dvfsp_vendor_writer_transaction writer_transaction = { };
@@ -27,4 +33,18 @@ void mt_ppm_set_dvfs_table(unsigned int cpu, struct cpufreq_frequency_table *tbl,
 			if (ppm_main_info.cluster_info[i].dvfs_tbl)
 				return;
 
+			writer_ret = gemini_mt6797_dvfsp_vendor_writer_begin(
+				&writer_transaction,
+				GEMINI_MT6797_DVFSP_VENDOR_WRITER_SITE_PPM);
+			if (writer_ret)
+				return;
+			writer_ret =
+				gemini_mt6797_dvfsp_vendor_writer_prepare_table_update(
+					&writer_transaction);
+			if (writer_ret) {
+				gemini_mt6797_dvfsp_vendor_writer_finish(
+					&writer_transaction, writer_ret);
+				return;
+			}
+
 			ppm_lock(&ppm_main_info.lock);
@@ -54,1 +64,6 @@ void mt_ppm_set_dvfs_table(unsigned int cpu, struct cpufreq_frequency_table *tbl,
 			ppm_unlock(&ppm_main_info.lock);
+			writer_ret = gemini_mt6797_dvfsp_vendor_writer_finish(
+				&writer_transaction, 0);
+			if (writer_ret)
+				ppm_err("DVFSP writer bridge failed PPM table commit: %d\\n",
+					writer_ret);
-- 
2.39.5
