#!/bin/busybox sh
# shellcheck shell=dash

export PATH=/bin
readonly MARKER='GEMINI_KEYBOARD_WATCHDOG_20260719_V'

# /dev/null is unavailable before devtmpfs. Keep this first mount unredirected.
if ! mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev; then
	printf '%s devtmpfs=failed; STATIC HOLD\n' "$MARKER"
	while :; do
		sleep 3600
	done
fi

procfs_status=failed
sysfs_status=failed
if mount -t proc -o ro,nosuid,nodev,noexec proc /proc 2>/dev/null; then
	procfs_status=mounted
fi
if mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /sys 2>/dev/null; then
	sysfs_status=mounted
fi

: >/run/v-status
/bin/v-record "entry profile=keyboard-watchdog cpu_policy=maxcpus-1"
/bin/v-record "procfs=$procfs_status sysfs=$sysfs_status marker_path=kmsg-console-ramoops"
if [ "$sysfs_status" != mounted ]; then
	/bin/v-record 'diagnostic=invalid reason=sysfs-unavailable; STATIC HOLD'
	while :; do
		sleep 3600
	done
fi

online=unavailable
if [ -r /sys/devices/system/cpu/online ]; then
	online="$(cat /sys/devices/system/cpu/online 2>/dev/null || true)"
fi
/bin/v-record "cpu_online=${online:-unavailable} storage_access=none runtime_networking=none"

# These workers are deliberately independent: neither event discovery nor raw
# capture can postpone the shell or watchdog ownership handoff.
/bin/v-watchdog &
/bin/v-probe &
/bin/v-record 'services=launched watchdog=independent probe=independent tty1_shell=supervised'

exec /bin/busybox init
