#!/bin/busybox sh
# shellcheck shell=dash

readonly MARKER='GEMINI_KEYBOARD_WATCHDOG_20260719_V'
line="$MARKER $*"

printf '%s\n' "$line" >>/run/v-status 2>/dev/null || true
if [ -c /dev/kmsg ]; then
	printf '<6>%s\n' "$line" >/dev/kmsg 2>/dev/null || true
fi
for output in /dev/console /dev/tty0 /dev/tty1 /dev/ttyS0; do
	[ -c "$output" ] || continue
	printf '%s\n' "$line" >"$output" 2>/dev/null || true
done
