#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# shellcheck shell=dash
export PATH=/bin
umask 077
hold() { printf 'TOPRGU candidate hold: %s; recovery required.\n' "$1"; while :; do /bin/busybox sleep 3600; done; }
/bin/busybox mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev || hold devtmpfs-failed
/bin/busybox mount -t proc -o ro,nosuid,nodev,noexec proc /proc || hold proc-failed
/bin/busybox mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /sys || hold sysfs-failed
/bin/busybox mount -t tmpfs -o nosuid,nodev,noexec,mode=0700,size=8m tmpfs /run || hold run-failed
/bin/busybox mkdir -p /dev/pts /run/toprgu /run/a53
/bin/busybox mount -t devpts -o nosuid,noexec,mode=0620 devpts /dev/pts || hold devpts-failed
for pair in online:0-7 offline:8-9 possible:0-9 present:0-9; do
    field=${pair%:*}; expected=${pair#*:}
    actual=$(/bin/busybox cat "/sys/devices/system/cpu/$field") || hold cpu-unreadable
    [ "$actual" = "$expected" ] || hold cpu-state-mismatch
done
[ "$(/bin/busybox uname -r)" = 7.1.3-gemini-mt6797-toprgu-minimal-restart ] || hold kernel-mismatch
/bin/busybox cat /proc/sys/kernel/random/boot_id >/run/a53/boot-id || hold boot-id-missing
boot_id=$(/bin/busybox cat /run/a53/boot-id) || hold boot-id-unreadable
/bin/busybox printf 'GEMINI_TOPRGU_V1 contract=toprgu-minimal-restart-v1 wrapper=busybox-reboot-n-f-v1 candidate=7.1.3-gemini-mt6797-toprgu-minimal-restart input_id=INPUT_ID_PLACEHOLDER boot_id=%s phase=entry\n' "$boot_id" >/dev/kmsg || hold entry-marker-failed
# Keep the baseline logger/sealer contract: kmsg-capture is the sole reader,
# its PID is a canonical decimal in kmsg-pid, and its exit is waited and
# recorded before any later kmsg-seal operation.
capture_logs() {
    /bin/kmsg-capture &
    capture_pid=$!
    /bin/busybox printf '%s\n' "$capture_pid" >/run/a53/kmsg-pid
    wait "$capture_pid"
    result=$?
    /bin/busybox printf '%s\n' "$result" >/run/a53/kmsg-exit
}
capture_logs &
/bin/usb-auth &
exec /bin/busybox init
