From b28ba424bfcba52ac4768aad6ec1420ab4a5596e Mon Sep 17 00:00:00 2001
From: Gemini recovery experiment <noreply@gemini-recovery.invalid>
Date: Mon, 3 Aug 2026 00:10:00 +0000
Subject: [PATCH] diagnostic: reject A72 during recovery gate

Add an experiment-only configuration that rejects CPU8 and CPU9.

Return before vendor preparation, firmware CPU-on, DCM, or online state.

Keep the no-A72 boundary structurally testable.
---
 arch/arm64/kernel/psci.c              | 7 +++++++
 drivers/watchdog/mediatek/wdt/Kconfig | 9 +++++++++
 2 files changed, 16 insertions(+)

diff --git a/arch/arm64/kernel/psci.c b/arch/arm64/kernel/psci.c
index 051bdbbf5..218302c9e 100644
--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -571,6 +571,13 @@ static int cpu_psci_cpu_boot(unsigned int cpu)
 #ifdef CONFIG_ARCH_MT6797
 	int err = 0;
 
+#ifdef CONFIG_MTK_A72_RECOVERY_DISCRIMINATOR
+	if (cpu == 8 || cpu == 9) {
+		pr_info("recovery-only: reject CPU%u before A72 action\n", cpu);
+		return -EPERM;
+	}
+#endif
+
 
 #ifdef CONFIG_MTK_CPU_HOTPLUG_DEBUG_3
 	TIMESTAMP_REC(hotplug_ts_rec, TIMESTAMP_FILTER,  cpu, 0, 0, 0);
diff --git a/drivers/watchdog/mediatek/wdt/Kconfig b/drivers/watchdog/mediatek/wdt/Kconfig
index 2c7fe2e8b..02da6ddd0 100644
--- a/drivers/watchdog/mediatek/wdt/Kconfig
+++ b/drivers/watchdog/mediatek/wdt/Kconfig
@@ -8,6 +8,15 @@ config MTK_WATCHDOG
 	please note that mediatek watchdog driver don't use
 	watchdog core which define by WATCHDOG_CORE.
 
+config MTK_A72_RECOVERY_DISCRIMINATOR
+	bool "Gemini A72 recovery-only discriminator"
+	depends on MTK_WATCHDOG && MTK_WD_KICKER
+	depends on PSTORE && PSTORE_CONSOLE && PSTORE_RAM
+	default n
+	help
+	  Experiment-only watchdog and console-ramoops recovery gate.
+	  Rejects CPU8 and CPU9 before any platform or firmware action.
+
 # common watchdog driver
 config MTK_WATCHDOG_COMMON
 	bool "WatchDog Support Common"
