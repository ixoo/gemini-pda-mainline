#!/usr/bin/env bash

set -euo pipefail

readonly SOURCE_COMMIT=59e00a9144d782e148332009a835b99c43382467
readonly SOURCE_URL=https://github.com/gemian/gemini-linux-kernel-3.18.git

die() {
	echo "error: $*" >&2
	exit 1
}

[[ "$#" -eq 3 ]] || die "expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT"
readonly project_commit="$1"
readonly source_root="$2"
readonly output_root="$3"
[[ "${project_commit}" =~ ^[0-9a-f]{40}$ ]] || die "invalid project commit"
[[ "${source_root}" == /workspace/gemini-pda/* ]] || die "unsafe source root"
[[ "${output_root}" == /workspace/gemini-pda/* ]] || die "unsafe output root"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
experiment_dir="$(cd "${script_dir}/.." && pwd -P)"
readonly experiment_dir
repository_dir="$(cd "${experiment_dir}/../.." && pwd -P)"
readonly repository_dir
[[ "$(git -C "${repository_dir}" rev-parse HEAD)" == "${project_commit}" ]] || \
	die "project checkout does not match requested commit"
[[ -z "$(git -C "${repository_dir}" status --porcelain)" ]] || \
	die "project checkout is dirty"

for command in git python3 sha256sum; do
	command -v "${command}" >/dev/null 2>&1 || die "missing command: ${command}"
done

readonly mirror="${source_root}/gemian-linux-kernel-3.18.git"
readonly work_root=/workspace/gemini-pda/recovery-only-work
readonly package="${output_root}/gemian-a72-recovery-patches-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "${source_root}" "${work_root}" "${output_root}"
[[ ! -e "${partial}" ]] || die "stale output partial exists"

if [[ -d "${package}" && ! -L "${package}" ]]; then
	grep -Fx "repository_commit=${project_commit}" \
		"${package}/provenance/generation.txt" >/dev/null || \
		die "existing package commit mismatch"
	(
		cd "${package}"
		sha256sum --check --strict SHA256SUMS >/dev/null
	)
	printf 'Generated recovery-only patch review at %s\n' "${package}"
	exit 0
fi
[[ ! -e "${package}" ]] || die "unsafe existing package path"

if [[ ! -d "${mirror}" ]]; then
	git clone --mirror "${SOURCE_URL}" "${mirror}.partial"
	mv "${mirror}.partial" "${mirror}"
fi
[[ "$(git --git-dir="${mirror}" remote get-url origin)" == "${SOURCE_URL}" ]] || \
	die "vendor mirror origin mismatch"
git --git-dir="${mirror}" fetch origin "${SOURCE_COMMIT}"
[[ "$(git --git-dir="${mirror}" rev-parse FETCH_HEAD)" == "${SOURCE_COMMIT}" ]] || \
	die "vendor source fetch mismatch"

work="$(mktemp -d "${work_root}/recovery.XXXXXX")"
readonly work
cleanup() {
	if [[ -d "${work}" && "${work}" == "${work_root}"/recovery.* ]]; then
		rm -rf -- "${work}"
	fi
	if [[ -d "${partial}" && "${partial}" == "${output_root}"/*.partial.* ]]; then
		rm -rf -- "${partial}"
	fi
}
trap cleanup EXIT

git clone --no-checkout "${mirror}" "${work}/source"
git -C "${work}/source" checkout --detach "${SOURCE_COMMIT}"
git -C "${work}/source" config user.name "Gemini recovery experiment"
git -C "${work}/source" config user.email "noreply@gemini-recovery.invalid"
mkdir -p "${partial}/patches" "${partial}/provenance"

commit_step() {
	local date="$1"
	local subject="$2"
	local body_one="$3"
	local body_two="$4"
	local body_three="$5"
	shift 5
	git -C "${work}/source" diff --check
	git -C "${work}/source" add -- "$@"
	git -C "${work}/source" diff --cached --check
	GIT_AUTHOR_NAME="Gemini recovery experiment" \
	GIT_AUTHOR_EMAIL="noreply@gemini-recovery.invalid" \
	GIT_COMMITTER_NAME="Gemini recovery experiment" \
	GIT_COMMITTER_EMAIL="noreply@gemini-recovery.invalid" \
	GIT_AUTHOR_DATE="${date}" GIT_COMMITTER_DATE="${date}" \
		git -C "${work}/source" commit --no-gpg-sign \
			-m "${subject}" -m "${body_one}" -m "${body_two}" -m "${body_three}"
}

python3 "${script_dir}/source_edits.py" --source "${work}/source" --step guard
commit_step 2026-08-03T00:10:00Z \
	"diagnostic: reject A72 during recovery gate" \
	"Add an experiment-only configuration that rejects CPU8 and CPU9." \
	"Return before vendor preparation, firmware CPU-on, DCM, or online state." \
	"Keep the no-A72 boundary structurally testable." \
	arch/arm64/kernel/psci.c drivers/watchdog/mediatek/wdt/Kconfig

python3 "${script_dir}/source_edits.py" --source "${work}/source" --step owner
commit_step 2026-08-03T00:11:00Z \
	"diagnostic: add exclusive TOPRGU recovery owner" \
	"Claim the existing register lock and arm one fixed reset-only deadline." \
	"Interlock later restart calls once terminal recovery ownership begins." \
	"Return exact mode and length readback without inventing rollback." \
	drivers/watchdog/mediatek/include/ext_wd_drv.h \
	drivers/watchdog/mediatek/wdt/mt6797/mtk_wdt.c

python3 "${script_dir}/source_edits.py" --source "${work}/source" --step trigger
commit_step 2026-08-03T00:12:00Z \
	"diagnostic: run bounded watchdog pstore gate" \
	"Transfer ownership under the ordinary kickers own serialization lock." \
	"Arm a fixed twelve-second deadline and emit one exact ramoops marker." \
	"Restore normal kicks only when low-level ownership never began." \
	drivers/watchdog/mediatek/wdk/wd_common_drv.c

readonly patch1=0001-diagnostic-reject-A72-during-recovery-gate.patch
readonly patch2=0002-diagnostic-add-exclusive-TOPRGU-recovery-owner.patch
readonly patch3=0003-diagnostic-run-bounded-watchdog-pstore-gate.patch
git -C "${work}/source" format-patch -1 --no-signature --stdout HEAD~2 \
	> "${partial}/patches/${patch1}"
git -C "${work}/source" format-patch -1 --no-signature --stdout HEAD~1 \
	> "${partial}/patches/${patch2}"
git -C "${work}/source" format-patch -1 --no-signature --stdout HEAD \
	> "${partial}/patches/${patch3}"
printf '%s\n' "${patch1}" "${patch2}" "${patch3}" > "${partial}/patches/series"

python3 "${script_dir}/validate_patches.py" --patch-dir "${partial}/patches"
python3 "${script_dir}/test_static.py" --patch-dir "${partial}/patches"
git -C "${work}/source" diff --check
[[ -z "$(git -C "${work}/source" status --porcelain)" ]] || \
	die "generated vendor source is dirty"

cat > "${partial}/provenance/generation.txt" <<EOF
purpose=experiment-only-recovery-source-review
boot_candidate=false
device_action=none
repository_commit=${project_commit}
source_url=${SOURCE_URL}
source_commit=${SOURCE_COMMIT}
generated_patch_count=3
generator=experiments/2026-08-02-a72-recovery-only-discriminator/scripts/generate-on-buildbox
native_vm_kernel_build=no
EOF
(
	cd "${partial}"
	find patches provenance -type f -print0 | LC_ALL=C sort -z \
		| xargs -0 sha256sum > SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv "${partial}" "${package}"
trap - EXIT
rm -rf -- "${work}"
printf 'Generated recovery-only patch review at %s\n' "${package}"
