#!/usr/bin/env bash

set -euo pipefail

readonly SOURCE_COMMIT=59e00a9144d782e148332009a835b99c43382467
readonly SOURCE_URL=https://github.com/gemian/gemini-linux-kernel-3.18.git
readonly CONFIG_SHA256=231d8a2ffe7afac3a4cc62c27d0eb6fe8bd9165ebd096e3e3346dd6df35c18f4
readonly CUST_DTSI_SHA256=7a7eb416499346afff30c15f967ccb9cf79323c076204b6a953515db74811632
readonly EXPECTED_GCC='aarch64-linux-gnu-gcc-6 (Debian 6.3.0-18) 6.3.0 20170516'
readonly EXPECTED_LD='GNU ld (GNU Binutils for Debian) 2.28'
readonly TARGET_EXTRA_CFLAGS=-fstack-usage

die() {
	echo "error: $*" >&2
	exit 1
}

[[ "$#" -eq 6 ]] || \
	die "expected PROJECT_COMMIT SOURCE_ROOT BUILD_ROOT ARTIFACT_ROOT TOOLCHAIN_ROOT JOBS"
readonly project_commit="$1"
readonly source_root="$2"
readonly build_root="$3"
readonly artifact_root="$4"
readonly toolchain_root="$5"
readonly jobs="$6"
[[ "${project_commit}" =~ ^[0-9a-f]{40}$ ]] || die "invalid project commit"
[[ "${jobs}" =~ ^[1-9][0-9]*$ ]] || die "invalid job count"
for root in "${source_root}" "${build_root}" "${artifact_root}" "${toolchain_root}"; do
	[[ "${root}" == /workspace/gemini-pda/* && "${root}" != /workspace/gemini-pda ]] || \
		die "unsafe managed root: ${root}"
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
experiment_dir="$(cd "${script_dir}/.." && pwd -P)"
readonly experiment_dir
repository_dir="$(cd "${experiment_dir}/../.." && pwd -P)"
readonly repository_dir
observer_dir="${repository_dir}/experiments/2026-07-23-gemian-a72-owner-observer"
readonly observer_dir
[[ "$(git -C "${repository_dir}" rev-parse HEAD)" == "${project_commit}" ]] || \
	die "project checkout does not match requested commit"
[[ -z "$(git -C "${repository_dir}" status --porcelain)" ]] || \
	die "project checkout is dirty"

for command in file git jq make python3 sha256sum tar; do
	command -v "${command}" >/dev/null 2>&1 || die "missing Buildbox command: ${command}"
done

readonly manifest="${observer_dir}/inputs/stretch-cross-toolchain.tsv"
readonly baseline_config="${observer_dir}/inputs/active-gemian.config"
readonly patch_series="${experiment_dir}/patches/series"
manifest_sha="$(sha256sum "${manifest}" | awk '{print $1}')"
readonly manifest_sha
patchset_sha="$(cd "${experiment_dir}/patches" && while IFS= read -r patch; do sha256sum "${patch}"; done < series | sha256sum | awk '{print $1}')"
readonly patchset_sha
[[ "$(sha256sum "${baseline_config}" | awk '{print $1}')" == "${CONFIG_SHA256}" ]] || \
	die "active Gemian configuration hash mismatch"

readonly toolchain="${toolchain_root}/${manifest_sha}"
[[ -f "${toolchain}/validated" && ! -L "${toolchain}" ]] || \
	die "validated pinned Gemian toolchain is unavailable; run the observer compile lane first"
[[ "$(<"${toolchain}/validated")" == "${manifest_sha}" ]] || \
	die "cached toolchain identity mismatch"
readonly cross_prefix="${toolchain}/wrappers/aarch64-linux-gnu-"
export LD_LIBRARY_PATH="${toolchain}/root/usr/lib/x86_64-linux-gnu"
[[ "$("${cross_prefix}gcc" --version | head -n 1)" == "${EXPECTED_GCC}" ]] || \
	die "pinned compiler identity mismatch"
[[ "$("${cross_prefix}ld" --version | head -n 1)" == "${EXPECTED_LD}" ]] || \
	die "pinned linker identity mismatch"

readonly source_mirror="${source_root}/gemian-linux-kernel-3.18.git"
mkdir -p "${source_root}"
if [[ ! -d "${source_mirror}" ]]; then
	git clone --mirror "${SOURCE_URL}" "${source_mirror}.partial"
	mv "${source_mirror}.partial" "${source_mirror}"
fi
[[ "$(git --git-dir="${source_mirror}" remote get-url origin)" == "${SOURCE_URL}" ]] || \
	die "vendor source mirror origin mismatch"
git --git-dir="${source_mirror}" fetch origin "${SOURCE_COMMIT}"
[[ "$(git --git-dir="${source_mirror}" rev-parse FETCH_HEAD)" == "${SOURCE_COMMIT}" ]] || \
	die "vendor source fetch mismatch"

prepare_source() {
	local current_diff_sha
	local expected_diff_sha
	local include_recovery="$4"
	local patch
	local partial
	local target="$1"
	local state_file="$2"
	local expected_identity="$3"

	if [[ -f "${target}/${state_file}" && ! -L "${target}" ]]; then
		read -r state_source state_identity expected_diff_sha < "${target}/${state_file}"
		[[ "${state_source}" == "${SOURCE_COMMIT}" && \
		   "${state_identity}" == "${expected_identity}" && \
		   "${expected_diff_sha}" =~ ^[0-9a-f]{64}$ ]] || \
			die "prepared source identity mismatch: ${target}"
		current_diff_sha="$(git -C "${target}" diff --binary | sha256sum | awk '{print $1}')"
		[[ "${current_diff_sha}" == "${expected_diff_sha}" ]] || \
			die "prepared source diff mismatch: ${target}"
		return
	fi
	for partial in "${target}.partial."*; do
		[[ -d "${partial}" && ! -L "${partial}" ]] || continue
		rm -rf -- "${partial}"
	done
	mkdir -p "$(dirname "${target}")"
	partial="${target}.partial.$$"
	trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' RETURN
	git clone --no-checkout "${source_mirror}" "${partial}"
	git -C "${partial}" checkout --detach "${SOURCE_COMMIT}"
	if [[ "${include_recovery}" == 1 ]]; then
		while IFS= read -r patch; do
			[[ "${patch}" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || die "unsafe patch name"
			git -C "${partial}" apply --check "${experiment_dir}/patches/${patch}"
			git -C "${partial}" apply "${experiment_dir}/patches/${patch}"
		done < "${patch_series}"
	fi
	git -C "${partial}" diff --check
	current_diff_sha="$(git -C "${partial}" diff --binary | sha256sum | awk '{print $1}')"
	printf '%s %s %s\n' "${SOURCE_COMMIT}" "${expected_identity}" \
		"${current_diff_sha}" > "${partial}/${state_file}"
	mv "${partial}" "${target}"
	partial=""
	trap - RETURN
}

readonly prepared_source="${source_root}/gemian-recovery/by-patchset-${patchset_sha:0:16}"
readonly baseline_source="${source_root}/gemian-clean/${SOURCE_COMMIT}"
prepare_source "${baseline_source}" .gemini-clean-state clean 0
prepare_source "${prepared_source}" .gemini-recovery-state "${patchset_sha}" 1

readonly output="${build_root}/gemian-recovery/${project_commit}"
readonly baseline_output="${build_root}/gemian-recovery-baseline/${project_commit}"
readonly package="${artifact_root}/gemian-a72-recovery-compile-${project_commit:0:12}"
readonly package_partial="${package}.partial.$$"
[[ ! -e "${package}" ]] || die "refusing to overwrite compile package: ${package}"
[[ ! -e "${package_partial}" ]] || die "stale compile package partial exists"
for stale in "${output}" "${baseline_output}"; do
	if [[ -e "${stale}" ]]; then
		[[ -d "${stale}" && ! -L "${stale}" && \
		   "${stale}" == /workspace/gemini-pda/build/gemian-*/* ]] || \
			die "unsafe stale build directory"
		rm -rf -- "${stale}"
	fi
done
mkdir -p "${output}" "${baseline_output}" "${artifact_root}"
trap 'test -d "${output}" && rm -rf -- "${output}"; test -d "${baseline_output}" && rm -rf -- "${baseline_output}"; test -d "${package_partial}" && rm -rf -- "${package_partial}"' EXIT

configure_tree() {
	local build="$1"
	local source="$2"
	local recovery="$3"
	cp "${baseline_config}" "${build}/baseline.config"
	cp "${baseline_config}" "${build}/.config"
	if [[ "${recovery}" == 1 ]]; then
		"${source}/scripts/config" --file "${build}/.config" \
			--enable MTK_A72_RECOVERY_DISCRIMINATOR
	fi
	make -C "${source}" O="${build}" ARCH=arm64 \
		CROSS_COMPILE="${cross_prefix}" olddefconfig
	python3 - "${build}/baseline.config" "${build}/.config" "${recovery}" \
		> "${build}/config.diff" <<'PY'
import pathlib
import sys

def symbols(path):
    result = {}
    for line in pathlib.Path(path).read_text().splitlines():
        if line.startswith("CONFIG_") and "=" in line:
            name, value = line.split("=", 1)
            result[name] = value
        elif line.startswith("# CONFIG_") and line.endswith(" is not set"):
            result[line[2:-11]] = "n"
    return result

before = symbols(sys.argv[1])
after = symbols(sys.argv[2])
changes = []
for name in sorted(set(before) | set(after)):
    if before.get(name) != after.get(name):
        changes.append((name, before.get(name, "missing"), after.get(name, "missing")))
for row in changes:
    print("{}\t{}\t{}".format(*row))
expected = [("CONFIG_ANBOX", "missing", "n")]
if sys.argv[3] == "1":
    expected.append(("CONFIG_MTK_A72_RECOVERY_DISCRIMINATOR", "missing", "y"))
if changes != expected:
    raise SystemExit("resolved configuration delta is not exact")
PY
}

generate_dct() {
	local build="$1"
	local source="$2"
	local dct_output="${build}/arch/arm64/boot/dts"
	mkdir -p "${dct_output}"
	(
		cd "${source}/tools/dct"
		"${toolchain}/wrappers/python2.7" DrvGen.py \
			"${source}/drivers/misc/mediatek/dws/mt6797/aeon6797_6m_n.dws" \
			"${dct_output}/" "${dct_output}/" cust_dtsi
	) > "${build}/dct.log" 2>&1
	[[ "$(sed -n '3{/^ \* [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\} [0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}$/p;}' \
		"${dct_output}/cust.dtsi" | wc -l)" -eq 1 ]] || die "DCT timestamp contract changed"
	sed '3s/^ \* [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\} [0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}$/ * 1970-01-01 00:00:00/' \
		"${dct_output}/cust.dtsi" > "${dct_output}/cust.dtsi.normalized"
	mv "${dct_output}/cust.dtsi.normalized" "${dct_output}/cust.dtsi"
	[[ "$(sha256sum "${dct_output}/cust.dtsi" | awk '{print $1}')" == \
	   "${CUST_DTSI_SHA256}" ]] || die "generated cust.dtsi checksum mismatch"
}

build_tree() {
	local build="$1"
	local label="$2"
	local source="$3"
	if ! make -C "${source}" O="${build}" ARCH=arm64 \
		CROSS_COMPILE="${cross_prefix}" python="${toolchain}/wrappers/python2.7" \
		KCFLAGS="${TARGET_EXTRA_CFLAGS}" -j"${jobs}" V=1 Image.gz-dtb \
		> "${build}/build.log" 2>&1; then
		tail -n 160 "${build}/build.log" >&2
		die "${label} source build failed"
	fi
	[[ -s "${build}/arch/arm64/boot/Image.gz-dtb" && \
	   -s "${build}/vmlinux" && -s "${build}/System.map" ]] || \
		die "${label} outputs are incomplete"
	grep -E -i '(^|[^[:alpha:]])(warning|error):' "${build}/build.log" > \
		"${build}/diagnostics.txt" || :
}

configure_tree "${output}" "${prepared_source}" 1
configure_tree "${baseline_output}" "${baseline_source}" 0
generate_dct "${output}" "${prepared_source}"
generate_dct "${baseline_output}" "${baseline_source}"
export HOST_EXTRACFLAGS=-fcommon
build_tree "${output}" recovery "${prepared_source}"
build_tree "${baseline_output}" baseline "${baseline_source}"
cmp "${output}/diagnostics.txt" "${baseline_output}/diagnostics.txt" >/dev/null || \
	die "recovery and baseline compiler diagnostics differ"
[[ -s "${output}/diagnostics.txt" ]] || die "expected vendor baseline diagnostic is absent"
grep -q ' mtk_wdt_recovery_arm$' "${output}/System.map" || \
	die "recovery owner symbol is absent"
grep -q ' recovery_discriminator_callback$' "${output}/System.map" || \
	die "recovery trigger symbol is absent"
if grep -qE ' (mtk_wdt_recovery_arm|recovery_discriminator_callback)$' \
	"${baseline_output}/System.map"; then
	die "baseline unexpectedly contains recovery symbols"
fi

mkdir -p "${package_partial}/outputs/baseline" "${package_partial}/provenance"
for name in .config config.diff dct.log build.log System.map vmlinux diagnostics.txt; do
	case "${name}" in .config) destination=config ;; *) destination="${name}" ;; esac
	cp "${output}/${name}" "${package_partial}/outputs/${destination}"
	cp "${baseline_output}/${name}" "${package_partial}/outputs/baseline/${destination}"
done
cp "${output}/arch/arm64/boot/dts/cust.dtsi" "${package_partial}/outputs/cust.dtsi"
cp "${output}/arch/arm64/boot/Image.gz-dtb" "${package_partial}/outputs/Image.gz-dtb"
(
	cd "${baseline_output}"
	sha256sum arch/arm64/boot/Image.gz-dtb System.map vmlinux > \
		"${package_partial}/outputs/baseline/output-sha256.txt"
)
changed_stack_usage_count=0
baseline_stack_usage_count=0
for variant in changed baseline; do
	if [[ "${variant}" == changed ]]; then build="${output}"; prefix="${package_partial}/outputs"; else build="${baseline_output}"; prefix="${package_partial}/outputs/baseline"; fi
	(
		cd "${build}"
		find . -type f -name '*.su' -print0 | sort -z > "${prefix}/stack-usage-files.nul"
		tar --null --files-from="${prefix}/stack-usage-files.nul" -cf "${prefix}/stack-usage.tar"
	)
	tar -tf "${prefix}/stack-usage.tar" > "${prefix}/stack-usage-files.txt"
	stack_usage_count="$(tr -cd '\0' < "${prefix}/stack-usage-files.nul" | wc -c)"
	[[ "${stack_usage_count}" -gt 100 ]] || \
		die "${variant} stack-usage capture is incomplete"
	if [[ "${variant}" == changed ]]; then
		changed_stack_usage_count="${stack_usage_count}"
	else
		baseline_stack_usage_count="${stack_usage_count}"
	fi
	tar -C "${build}" --compare --file="${prefix}/stack-usage.tar"
done
"${cross_prefix}gcc" --version > "${package_partial}/provenance/compiler.txt"
"${cross_prefix}ld" --version > "${package_partial}/provenance/linker.txt"
gcc --version > "${package_partial}/provenance/host-compiler.txt"
jq -n \
	--arg repository_commit "${project_commit}" \
	--arg source_url "${SOURCE_URL}" --arg source_commit "${SOURCE_COMMIT}" \
	--arg recovery_patchset_sha256 "${patchset_sha}" \
	--arg config_sha256 "${CONFIG_SHA256}" \
	--arg toolchain_manifest_sha256 "${manifest_sha}" \
	--arg cust_dtsi_sha256 "${CUST_DTSI_SHA256}" \
	--argjson stack_usage_file_count "${changed_stack_usage_count}" \
	--argjson baseline_stack_usage_file_count "${baseline_stack_usage_count}" \
	--arg completed_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
	'{repository_commit: $repository_commit, repository_dirty: false,
	  source_url: $source_url, source_commit: $source_commit,
	  recovery_patchset_sha256: $recovery_patchset_sha256,
	  baseline_config_sha256: $config_sha256,
	  toolchain_manifest_sha256: $toolchain_manifest_sha256,
	  cust_dtsi_sha256: $cust_dtsi_sha256, build_architecture: "x86_64",
	  target_architecture: "arm64", host_extra_cflags: "-fcommon",
	  target_extra_cflags: "-fstack-usage", baseline_comparison: true,
	  baseline_source_unpatched: true, diagnostics_identical: true,
	  stack_usage_captured: true,
	  stack_usage_file_count: $stack_usage_file_count,
	  baseline_stack_usage_file_count: $baseline_stack_usage_file_count,
	  purpose: "recovery-compile-review-only",
	  boot_candidate: false, completed_utc: $completed_utc}' > \
	"${package_partial}/provenance/build.json"
(
	cd "${package_partial}"
	find outputs provenance -type f -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
rm -rf -- "${output}" "${baseline_output}"
mv "${package_partial}" "${package}"
trap - EXIT
printf 'Packaged Gemian recovery compile review at %s\n' "${package}"
