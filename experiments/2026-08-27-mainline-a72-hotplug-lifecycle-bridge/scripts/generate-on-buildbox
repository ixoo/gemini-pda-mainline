#!/usr/bin/env bash
set -euo pipefail

readonly repository_commit="${1:?repository commit required}"
readonly source_root="${2:?prepared source root required}"
readonly artifact_root="${3:?artifact root required}"
readonly expected_parent_source_state=fbd9f19e0eeb36540d922bb65965afbf1a329d15c3f113f82b8a4443367f5246
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly package_name="${repository_commit}-a72-hotplug-lifecycle-patches"
readonly destination="${artifact_root}/${package_name}"
readonly temporary="${destination}.partial.$$"

[[ "${repository_commit}" =~ ^[0-9a-f]{40}$ ]]
[[ -d "${source_root}" && ! -L "${source_root}" ]]
[[ -f "${source_root}/.gemini-source-state" ]]
prepared_source_state="$(<"${source_root}/.gemini-source-state")"
readonly prepared_source_state
[[ "${prepared_source_state}" == "${expected_parent_source_state}" ]]
[[ -d "${artifact_root}" && ! -L "${artifact_root}" ]]
[[ ! -e "${destination}" ]]

cleanup() {
  if [[ -n "${temporary:-}" && -d "${temporary}" && ! -L "${temporary}" ]]; then
    rm -rf -- "${temporary}"
  fi
}
trap cleanup EXIT

python3 "${script_dir}/generate-patches.py" \
  --source-root "${source_root}" \
  --repository-commit "${repository_commit}" \
  --output "${temporary}"
(
  cd "${temporary}"
  sha256sum --check --strict SHA256SUMS >/dev/null
  grep -Fx "repository_commit=${repository_commit}" provenance.txt >/dev/null
  grep -Fx 'generated_patch_count=2' provenance.txt >/dev/null
  grep -Fx 'secondary_hook=after-successful-__cpu_up' provenance.txt >/dev/null
  grep -Fx 'full_hook=after-successful-cpuhp-up-callbacks' provenance.txt >/dev/null
  grep -Fx 'generic_secondary_timeout_ms=5000' provenance.txt >/dev/null
  grep -Fx 'focused_kunit_cases=10' provenance.txt >/dev/null
  grep -Fx 'cpu_on_maximum=1' provenance.txt >/dev/null
  grep -Fx 'cpu_off_maximum=0' provenance.txt >/dev/null
  grep -Fx 'retry_maximum=0' provenance.txt >/dev/null
  grep -Fx 'mt6797_production_lifecycle_callbacks=0' provenance.txt >/dev/null
  grep -Fx 'production_callers=0' provenance.txt >/dev/null
  grep -Fx 'physical_effect_calls=0' provenance.txt >/dev/null
  grep -Fx 'device_action=none' provenance.txt >/dev/null
  grep -Fx 'boot_candidate=false' provenance.txt >/dev/null
)
mv "${temporary}" "${destination}"
trap - EXIT
printf 'Generated CPU8 hotplug lifecycle patches at %s\n' "${destination}"
