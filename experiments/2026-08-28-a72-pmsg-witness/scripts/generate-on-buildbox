#!/usr/bin/env bash

set -Eeuo pipefail
export LC_ALL=C

readonly SOURCE_COMMIT=59e00a9144d782e148332009a835b99c43382467
readonly SOURCE_URL=https://github.com/gemian/gemini-linux-kernel-3.18.git
readonly PARENT_REGISTER_PATCHSET_SHA256=71ef281aae8d0b99d0421b81bd3d61d82ab090125c4885977ba39d8280838469
readonly GENERATED_PATCH=0001-diagnostic-add-same-version-pmsg-witness.patch
readonly GENERATED_PATCH_SHA256=cf102ea22af912a9a4755039c6acc109be36be859d1e3ac826d884d8a095fd59
readonly CHECKPATCH=/workspace/gemini-pda/src/linux-7.1.3/scripts/checkpatch.pl
readonly CHECKPATCH_SHA256=e34bf5cec12c1a208b601cd863dd17536710a68e3f11c6e0d4fb4bf72243902e

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1 source_root=$2 output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/* ]] || die 'unsafe source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repository_dir="$(cd -- "$script_dir/../../.." && pwd -P)"
readonly script_dir repository_dir
readonly admitted_dir="$repository_dir/experiments/2026-08-28-a72-pmsg-witness/patches"
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] || \
  die 'project checkout mismatch'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] || \
  die 'project checkout is dirty'
[[ -f "$admitted_dir/$GENERATED_PATCH" &&
   ! -L "$admitted_dir/$GENERATED_PATCH" ]] || \
  die 'admitted pmsg-witness patch is unavailable'
[[ "$(cat "$admitted_dir/series")" == "$GENERATED_PATCH" ]] || \
  die 'admitted pmsg-witness series changed'
[[ "$(sha256sum "$admitted_dir/$GENERATED_PATCH" | awk '{print $1}')" == \
  "$GENERATED_PATCH_SHA256" ]] || die 'admitted pmsg-witness patch changed'
for command in awk cmp cp diff find git grep mkdir mktemp mv perl python3 rm \
  sha256sum sort xargs; do
  command -v "$command" >/dev/null || die "missing command: $command"
done
[[ -f "$CHECKPATCH" && ! -L "$CHECKPATCH" ]] || \
  die 'pinned Linux 7.1.3 checkpatch is unavailable'
[[ "$(sha256sum "$CHECKPATCH" | awk '{print $1}')" == \
  "$CHECKPATCH_SHA256" ]] || die 'pinned checkpatch identity changed'

readonly mirror="$source_root/gemian-linux-kernel-3.18.git"
readonly work_root=/workspace/gemini-pda/a72-pmsg-witness-work
readonly package="$output_root/gemian-a72-pmsg-witness-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$source_root" "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'
if [[ -d "$package" && ! -L "$package" ]]; then
  grep -Fx "repository_commit=$project_commit" \
    "$package/provenance/generation.txt" >/dev/null || \
    die 'existing package commit mismatch'
  grep -Fx 'purpose=experiment-only-a72-pmsg-witness-source-review' \
    "$package/provenance/generation.txt" >/dev/null || \
    die 'existing package purpose mismatch'
  (cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
  printf 'Generated A72 pmsg-witness patch review at %s\n' "$package"
  exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

if [[ ! -d "$mirror" ]]; then
  git clone --mirror "$SOURCE_URL" "${mirror}.partial"
  mv "${mirror}.partial" "$mirror"
fi
[[ "$(git --git-dir="$mirror" remote get-url origin)" == "$SOURCE_URL" ]] || \
  die 'vendor mirror origin mismatch'
git --git-dir="$mirror" fetch origin "$SOURCE_COMMIT"
[[ "$(git --git-dir="$mirror" rev-parse FETCH_HEAD)" == "$SOURCE_COMMIT" ]] || \
  die 'vendor source fetch mismatch'

work="$(mktemp -d "$work_root/pmsg-witness.XXXXXX")"
readonly work
cleanup() {
  [[ ! -d "$work" || "$work" != "$work_root"/pmsg-witness.* ]] || \
    rm -rf -- "$work"
  [[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] || \
    rm -rf -- "$partial"
}
trap cleanup EXIT
git clone --no-checkout "$mirror" "$work/source"
git -C "$work/source" checkout --detach "$SOURCE_COMMIT"
git -C "$work/source" config user.name 'Gemini A72 experiment'
git -C "$work/source" config user.email noreply@gemini-a72.invalid

apply_series() {
  local parent=$1 patch
  while IFS= read -r patch; do
    [[ "$patch" =~ ^[A-Za-z0-9_.+-]+\.patch$ ]] || \
      die 'unsafe parent patch name'
    git -C "$work/source" am --committer-date-is-author-date \
      "$repository_dir/experiments/$parent/patches/$patch"
  done <"$repository_dir/experiments/$parent/patches/series"
}

apply_series 2026-07-23-gemian-a72-owner-observer
for patch in 0001-diagnostic-extend-A72-observer-rollback-ABI.patch \
  0002-diagnostic-add-exact-A72-rollback-owner-operations.patch; do
  git -C "$work/source" am --committer-date-is-author-date \
    "$repository_dir/experiments/2026-08-02-a72-pre-isolation-rollback-discriminator/patches/$patch"
done
for parent in 2026-08-02-a72-one-way-cpu8-boundary \
  2026-08-02-a72-cpu8-held-online 2026-08-03-a72-cpu8-late-hold \
  2026-08-03-a72-cpu9-cluster-reuse \
  2026-08-03-a72-cpu9-retention-window \
  2026-08-03-a72-cpu9-terminal-attribution \
  2026-08-03-a72-cpu9-bounded-coherency \
  2026-08-03-a72-cpu9-multiline-integrity \
  2026-08-03-a72-cpu9-parallel-disjoint-load \
  2026-08-03-a72-scheduler-context \
  2026-08-28-a72-target-register-capsule; do
  apply_series "$parent"
done

register_dir="$repository_dir/experiments/2026-08-28-a72-target-register-capsule/patches"
register_patchset_sha="$({
  while IFS= read -r patch; do
    sha256sum "$register_dir/$patch" | awk '{print $1}'
  done <"$register_dir/series"
} | sha256sum | awk '{print $1}')"
readonly register_dir register_patchset_sha
[[ "$register_patchset_sha" == "$PARENT_REGISTER_PATCHSET_SHA256" ]] || \
  die 'register-capsule parent patchset identity changed'

mkdir -p "$work/parent-root"
for path in arch/arm64/kernel/psci.c \
  drivers/misc/mediatek/base/power/mt6797/mt_a72_transition_observer.c \
  fs/pstore/pmsg.c include/linux/pstore.h; do
  mkdir -p "$work/parent-root/$(dirname "$path")"
  cp "$work/source/$path" "$work/parent-root/$path"
done

python3 "$script_dir/test_witness_child.py" --self-test
python3 "$script_dir/witness_edits.py" --source "$work/source"
git -C "$work/source" diff --check
python3 "$script_dir/test_witness_child.py" \
  --source "$work/source" --parent-root "$work/parent-root"
diff -u \
  <(printf '%s\n' arch/arm64/kernel/psci.c \
    drivers/misc/mediatek/base/power/mt6797/mt_a72_transition_observer.c \
    fs/pstore/pmsg.c include/linux/pstore.h | sort) \
  <(git -C "$work/source" diff --name-only | sort) >/dev/null || \
  die 'pmsg witness changed-path inventory is not exact'

git -C "$work/source" add -- arch/arm64/kernel/psci.c \
  drivers/misc/mediatek/base/power/mt6797/mt_a72_transition_observer.c \
  fs/pstore/pmsg.c include/linux/pstore.h
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini A72 experiment' \
GIT_AUTHOR_EMAIL=noreply@gemini-a72.invalid \
GIT_COMMITTER_NAME='Gemini A72 experiment' \
GIT_COMMITTER_EMAIL=noreply@gemini-a72.invalid \
GIT_AUTHOR_DATE=2026-08-29T00:30:00Z \
GIT_COMMITTER_DATE=2026-08-29T00:30:00Z \
git -C "$work/source" commit --no-gpg-sign \
  -m 'diagnostic: add same-version pmsg witness' \
  -m 'Retain fixed entry, pre-scheduler, and pre-capsule records.' \
  -m 'Keep the parent power, CPU_OFF, watchdog, and capsule paths unchanged.'
generated_source_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly generated_source_commit

mkdir -p "$partial/patches" "$partial/provenance"
git -C "$work/source" format-patch -1 --no-signature --stdout HEAD \
  >"$partial/patches/$GENERATED_PATCH"
printf '%s\n' "$GENERATED_PATCH" >"$partial/patches/series"
git -C "$work/source" diff-tree --no-commit-id --name-only -r HEAD \
  >"$partial/provenance/changed-paths.txt"
python3 "$script_dir/test_witness_child.py" \
  --source "$work/source" --parent-root "$work/parent-root" \
  >"$partial/provenance/validation.txt"
if ! perl "$CHECKPATCH" --no-tree --strict --ignore MISSING_SIGN_OFF \
  "$partial/patches/$GENERATED_PATCH" \
  >"$partial/provenance/checkpatch.txt"; then
  cat "$partial/provenance/checkpatch.txt" >&2
  die 'strict checkpatch rejected the pmsg-witness patch'
fi
[[ -z "$(git -C "$work/source" status --porcelain)" ]] || \
  die 'generated source is dirty'
generated_patch_sha="$(sha256sum "$partial/patches/$GENERATED_PATCH" | awk '{print $1}')"
readonly generated_patch_sha
[[ "$generated_patch_sha" == "$GENERATED_PATCH_SHA256" ]] || \
  die 'generated pmsg-witness patch identity changed'
cmp "$partial/patches/$GENERATED_PATCH" \
  "$admitted_dir/$GENERATED_PATCH" || \
  die 'generated pmsg-witness patch differs from admitted patch'
cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-a72-pmsg-witness-source-review
boot_candidate=false
device_action=none
repository_commit=$project_commit
source_url=$SOURCE_URL
source_commit=$SOURCE_COMMIT
parent_register_patchset_sha256=$register_patchset_sha
generated_source_commit=$generated_source_commit
generated_patch=$GENERATED_PATCH
generated_patch_sha256=$generated_patch_sha
checkpatch_sha256=$CHECKPATCH_SHA256
checkpatch_args=--no-tree,--strict,--ignore=MISSING_SIGN_OFF
generated_patch_count=1
changed_path_count=4
pmsg_backend=ramoops-only
pmsg_record_max_bytes=256
pmsg_record_sites=3
pmsg_terminal_results=pass,fault
retained_record_total_lt_bytes=1024
mainline_cross_version_pmsg=false
physical_action=none
native_vm_kernel_build=no
EOF
(
  cd "$partial"
  find patches provenance -type f -print0 | sort -z | \
    xargs -0 sha256sum >SHA256SUMS
  sha256sum --check --strict SHA256SUMS >/dev/null
)
mv "$partial" "$package"
rm -rf -- "$work"
trap - EXIT
printf 'Generated A72 pmsg-witness patch review at %s\n' "$package"
