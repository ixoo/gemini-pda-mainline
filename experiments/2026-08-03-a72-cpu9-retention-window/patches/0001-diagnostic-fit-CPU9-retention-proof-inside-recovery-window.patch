From d572811955bf36b164a64e3a88a1465fde2ed675 Mon Sep 17 00:00:00 2001
From: Gemini A72 experiment <noreply@gemini-a72.invalid>
Date: Mon, 3 Aug 2026 23:30:00 +0000
Subject: [PATCH] diagnostic: fit CPU9 retention proof inside recovery window

Move all three CPU8/CPU9 callbacks before the fixed watchdog.

Report the first HPS down veto once while rejecting every request.

Keep PSCI startup, CPU_OFF prohibition, and power state unchanged.
---
 arch/arm64/kernel/psci.c                        | 10 +++++-----
 .../power/mt6797/mt_hotplug_strategy_algo.c     | 17 +++++++++++++++--
 kernel/cpu.c                                    |  2 ++
 3 files changed, 22 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/kernel/psci.c b/arch/arm64/kernel/psci.c
index 2b546d2a0..4ed5a1db5 100644
--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -563,7 +563,7 @@ static void mt6797_a72_hold_workfn(struct work_struct *work)
 	}
 	if (ret8 || ret9 || observed_cpu8 != 8 || observed_cpu9 != 9 ||
 	    !cpu_online(8) || !cpu_online(9) || hits8 != hits9) {
-		pr_emerg("gemini-a72-pair-v1 result=fault sample=%d cpu8=%d cpu9=%d online8=%d online9=%d hits8=%d hits9=%d error8=%d error9=%d\n",
+		pr_emerg("gemini-a72-pair-v2 result=fault sample=%d cpu8=%d cpu9=%d online8=%d online9=%d hits8=%d hits9=%d error8=%d error9=%d\n",
 			 sample, observed_cpu8, observed_cpu9, cpu_online(8),
 			 cpu_online(9), hits8, hits9, ret8, ret9);
 		console_lock();
@@ -573,16 +573,16 @@ static void mt6797_a72_hold_workfn(struct work_struct *work)
 	atomic_inc(&mt6797_a72_hold_hits);
 	atomic_inc(&mt6797_a72_cpu9_hits);
 	if (sample < 3) {
-		unsigned long delay = sample == 1 ? 5000 : 4000;
+		unsigned long delay = 2000;
 
-		pr_emerg("gemini-a72-pair-v1 result=sample sample=%d cpu8=8 cpu9=9 online8=1 online9=1 hits8=%d hits9=%d\n",
+		pr_emerg("gemini-a72-pair-v2 result=sample sample=%d cpu8=8 cpu9=9 online8=1 online9=1 hits8=%d hits9=%d\n",
 			 sample, atomic_read(&mt6797_a72_hold_hits),
 			 atomic_read(&mt6797_a72_cpu9_hits));
 		console_lock();
 		console_unlock();
 		if (!schedule_delayed_work(&mt6797_a72_hold_work,
 					   msecs_to_jiffies(delay))) {
-			pr_emerg("gemini-a72-pair-v1 result=fault sample=%d cpu8=-1 cpu9=-1 online8=%d online9=%d hits8=%d hits9=%d error8=%d error9=%d\n",
+			pr_emerg("gemini-a72-pair-v2 result=fault sample=%d cpu8=-1 cpu9=-1 online8=%d online9=%d hits8=%d hits9=%d error8=%d error9=%d\n",
 				 sample + 1, cpu_online(8), cpu_online(9),
 				 atomic_read(&mt6797_a72_hold_hits),
 				 atomic_read(&mt6797_a72_cpu9_hits), -EBUSY, -EBUSY);
@@ -591,7 +591,7 @@ static void mt6797_a72_hold_workfn(struct work_struct *work)
 		}
 		return;
 	}
-	pr_emerg("gemini-a72-pair-v1 result=pass sample=3 cpu8=8 cpu9=9 online8=1 online9=1 hits8=3 hits9=3\n");
+	pr_emerg("gemini-a72-pair-v2 result=pass sample=3 cpu8=8 cpu9=9 online8=1 online9=1 hits8=3 hits9=3\n");
 	console_lock();
 	console_unlock();
 #else
diff --git a/drivers/misc/mediatek/base/power/mt6797/mt_hotplug_strategy_algo.c b/drivers/misc/mediatek/base/power/mt6797/mt_hotplug_strategy_algo.c
index 47a1bc512..c825361bf 100644
--- a/drivers/misc/mediatek/base/power/mt6797/mt_hotplug_strategy_algo.c
+++ b/drivers/misc/mediatek/base/power/mt6797/mt_hotplug_strategy_algo.c
@@ -225,6 +225,10 @@ static int hps_algo_check_criteria(void)
 	return ret;
 }
 
+#ifdef CONFIG_MTK_A72_CPU9_CLUSTER_REUSE
+static atomic_t mt6797_a72_hps_down_reported = ATOMIC_INIT(0);
+#endif
+
 static int hps_algo_do_cluster_action(unsigned int cluster_id)
 {
 	unsigned int cpu, target_cores, online_cores, cpu_id_min, cpu_id_max;
@@ -287,8 +291,17 @@ static int hps_algo_do_cluster_action(unsigned int cluster_id)
 						MT6797_A72_PHASE_HPS_CPU_DOWN_END,
 						hotplug_ret);
 #endif
-				if (hotplug_ret)
-					hps_warn("[Info]CPU %d --!\n", cpu);
+				if (hotplug_ret) {
+#ifdef CONFIG_MTK_A72_CPU9_CLUSTER_REUSE
+					if ((cpu == 8 || cpu == 9) &&
+					    hotplug_ret == -EPERM) {
+						if (!atomic_xchg(&mt6797_a72_hps_down_reported, 1))
+							pr_emerg("gemini-a72-retain-v1 result=hps-down-held-first cpu=%d error=%d\n",
+								 cpu, hotplug_ret);
+					} else
+#endif
+						hps_warn("[Info]CPU %d --!\n", cpu);
+				}
 				--online_cores;
 			}
 			if (target_cores == online_cores)
diff --git a/kernel/cpu.c b/kernel/cpu.c
index 7d232b3de..90b424b49 100644
--- a/kernel/cpu.c
+++ b/kernel/cpu.c
@@ -529,8 +529,10 @@ int __ref cpu_down(unsigned int cpu)
 
 #ifdef CONFIG_MTK_A72_ONE_WAY_CPU8
 	if (cpu == 8 || cpu == 9) {
+#ifndef CONFIG_MTK_A72_CPU9_CLUSTER_REUSE
 		pr_emerg("gemini-a72-hold-v1 result=down-veto cpu=%u stage=entry\n",
 			 cpu);
+#endif
 		return -EPERM;
 	}
 #endif
