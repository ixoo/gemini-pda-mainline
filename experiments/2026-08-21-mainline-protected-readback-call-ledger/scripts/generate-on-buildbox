#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=6404b05308f392c3753bfdd5e36c35c4cc666ae931bfdc9dc5ca6c15f72bb7de
readonly PSTORE_KCONFIG_SHA256=add1aacb2bd70673becf231e69c4ad029f001ad1a07dba7104f907d095a950b2
readonly PSTORE_MAKEFILE_SHA256=bd4eb47ab55df200534a5954b8c05241deac9f47024a3aed4195136f097b3d7e
readonly PSTORE_RAM_SHA256=c8859d9cf246a8ebc31cc933b476c39288961a8d3df090cf0915d9eeb1e65218
readonly PSTORE_HEADER_SHA256=47ce44198f98f4a972a1c8d5edfb38183a8ac2001707b55e4de71612edd108fb
readonly OBSERVER_SHA256=8f69fdff44181bc0f8bcd827d8d2c81aff18678f023c76854420667d2f469f3d

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3-series-source ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" &&
	! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
experiment_dir="$(cd -- "$script_dir/.." && pwd -P)"
repository_dir="$(cd -- "$experiment_dir/../.." && pwd -P)"
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root" |
	grep -E '^source_tree_integrity=[0-9a-f]{64}$' >/dev/null ||
	die 'prepared source integrity verification failed'

check_file() {
	local expected=$1
	local relative=$2
	printf '%s  %s\n' "$expected" "$source_root/$relative" |
		sha256sum --check --status || die "parent source changed: $relative"
}
check_file "$PSTORE_KCONFIG_SHA256" fs/pstore/Kconfig
check_file "$PSTORE_MAKEFILE_SHA256" fs/pstore/Makefile
check_file "$PSTORE_RAM_SHA256" fs/pstore/ram.c
check_file "$PSTORE_HEADER_SHA256" include/linux/pstore_ram.h
check_file "$OBSERVER_SHA256" \
	drivers/soc/mediatek/mt6797-protected-readback-observer.c

readonly work_root=/workspace/gemini-pda/protected-readback-call-ledger-work
readonly package="$output_root/protected-readback-call-ledger-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'

if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated protected-readback call ledger at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work="$(mktemp -d "$work_root/generation.XXXXXX")"
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] ||
		rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] ||
		rm -rf -- "$partial"
}
trap cleanup EXIT

for relative in \
  fs/pstore/Kconfig \
  fs/pstore/Makefile \
  fs/pstore/ram.c \
  include/linux/pstore_ram.h \
  drivers/soc/mediatek/mt6797-protected-readback-observer.c; do
	mkdir -p "$work/source/$(dirname "$relative")"
	cp -- "$source_root/$relative" "$work/source/$relative"
done
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- .
GIT_AUTHOR_DATE=2026-08-21T22:30:00Z \
GIT_COMMITTER_DATE=2026-08-21T22:30:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'protected-readback call-ledger parent'
baseline_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly baseline_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/source"
git -C "$work/source" diff --check
git -C "$work/source" add -- \
	fs/pstore/Kconfig \
	fs/pstore/Makefile \
	fs/pstore/ram.c \
	fs/pstore/gemini_protected_readback_ledger.c \
	include/linux/pstore_ram.h \
	drivers/soc/mediatek/mt6797-protected-readback-observer.c
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T22:31:00Z \
GIT_COMMITTER_DATE=2026-08-21T22:31:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'pstore: add Gemini protected readback call ledger' \
		-m 'Bracket the first protected-clock read with two fail-closed retained records so known-good Gemian can localize a pre-USB return.' \
		-m 'Keep the exact two read-only transports, skip normal ramoops only in the isolated profile, and add no retry, owner, or CPU operation.'
result_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly result_commit

mkdir -p "$partial/patches" "$partial/provenance"
mapfile -t generated < <(git -C "$work/source" format-patch \
	--no-signature --output-directory "$partial/patches" \
	"${baseline_commit}..${result_commit}")
[[ "${#generated[@]}" -eq 1 ]] || die 'generated patch count changed'
readonly patch=0323-pstore-add-Gemini-protected-readback-call-ledger.patch
mv -- "${generated[0]}" "$partial/patches/$patch"
printf '%s\n' "$patch" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patches.py" \
	--patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$baseline_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date \
	"$partial/patches/$patch"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$result_commit" ]] ||
	die 'patch replay did not reproduce generated commit'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/verify"
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
	--ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE,SPLIT_STRING \
	"$partial/patches/$patch" \
	>"$partial/provenance/checkpatch-${patch%.patch}.txt"; then
	cat "$partial/provenance/checkpatch-${patch%.patch}.txt" >&2
	die "strict checkpatch rejected $patch"
fi

cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-protected-readback-call-ledger
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
baseline_commit=$baseline_commit
result_commit=$result_commit
generated_patch_count=1
retained_slots=173,174
retained_maximum_writes=2
payload_before_metadata=yes
full_readback=yes
normal_mainline_ramoops=skipped-on-exact-Gemini-only
new_protected_reads=0
total_protected_reads=clock-1,bigidvfs-1
automatic_retry=no
secure_write=none
owner_registration=0
cpu_on=false
cpu_off=false
device_action=none
boot_candidate=false
EOF
printf '%s\n' "$patch" >"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated protected-readback call ledger at %s\n' "$package"
