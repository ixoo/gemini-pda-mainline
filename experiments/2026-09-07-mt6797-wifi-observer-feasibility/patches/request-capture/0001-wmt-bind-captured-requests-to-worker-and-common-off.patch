@@ -825,12 +827,14 @@ LONG WMT_unlocked_ioctl(struct file *filp, UINT32 cmd, ULONG arg)
 		do {
 			MTK_WCN_BOOL bRet = MTK_WCN_BOOL_FALSE;
 
+			mt6797_wfc_request_begin(arg);
