diff --git a/drivers/misc/mediatek/connectivity/common/common_main/core/wmt-request-capture.h b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt-request-capture.h
new file mode 100644
index 0000000..72256d9
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt-request-capture.h
@@ -0,0 +1,304 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* One native ioctl on/off pair; pointer identities never enter retained RAM. */
+#ifndef _WMT_REQUEST_CAPTURE_H
+#define _WMT_REQUEST_CAPTURE_H
+
+#include <linux/mt6797_wifi_capture.h>
+#include <linux/pstore_ram.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+#include <asm/unaligned.h>
+
+enum wfc_request_phase {
+	WFC_REQ_UNUSED,
+	WFC_REQ_ROOT,
+	WFC_REQ_BOUND,
+	WFC_REQ_QUEUED,
+	WFC_REQ_WORKER,
+	WFC_REQ_WORKER_DONE,
+	WFC_REQ_WAIT_DONE,
+	WFC_REQ_ON_DONE,
+	WFC_REQ_DONE,
+	WFC_REQ_FAILED,
+};
+
+static DEFINE_RAW_SPINLOCK(wfc_request_lock);
+static enum wfc_request_phase wfc_request_phase;
+static struct task_struct *wfc_request_root;
+static struct task_struct *wfc_request_worker;
+static const void *wfc_request_op;
+static u32 wfc_request_id;
+static unsigned int wfc_request_common;
+
+static void wfc_request_fail(void)
+{
+	u8 status[4];
+
+	wfc_request_phase = WFC_REQ_FAILED;
+	wfc_request_op = NULL;
+	/* Failed scopes retain at most one root and one worker task pin. */
+	put_unaligned_le32(2, status);
+	if (ramoops_capture_active())
+		ramoops_capture_append(255, 0, status, sizeof(status));
+}
+
+static void wfc_request_emit(u32 *words, size_t count)
+{
+	u8 data[24];
+	size_t i;
+
+	if (count < 2 || count > ARRAY_SIZE(data) / sizeof(u32)) {
+		wfc_request_fail();
+		return;
+	}
+	words[1] = wfc_request_id;
+	for (i = 0; i < count; i++)
+		put_unaligned_le32(words[i], data + i * 4);
+	if (!ramoops_capture_active() ||
+	    ramoops_capture_append(10, wfc_request_id, data, count * 4))
+		wfc_request_fail();
+}
+
+static unsigned int wfc_request_opid(void)
+{
+	return wfc_request_id == 1 ? WMT_OPID_FUNC_ON : WMT_OPID_FUNC_OFF;
+}
+
+void mt6797_wfc_request_begin(unsigned long arg)
+{
+	unsigned long flags;
+	u32 words[] = {16, 0, arg};
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (wfc_request_phase == WFC_REQ_UNUSED && arg == 0x80000003UL) {
+		get_task_struct(current);
+		wfc_request_root = current;
+		wfc_request_id = 1;
+	} else if (wfc_request_phase == WFC_REQ_ON_DONE && arg == 3 &&
+		   wfc_request_root == current && !wfc_request_op &&
+		   !wfc_request_worker) {
+		wfc_request_id = 2;
+		wfc_request_common = 0;
+	} else {
+		wfc_request_fail();
+		goto out;
+	}
+	wfc_request_phase = WFC_REQ_ROOT;
+	wfc_request_emit(words, ARRAY_SIZE(words));
+out:
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+void mt6797_wfc_request_bind(const void *op, unsigned int opid,
+			     unsigned int type, unsigned int timeout)
+{
+	unsigned long flags;
+	u32 words[] = {17, 0, opid, type, timeout};
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (!op || wfc_request_root != current ||
+	    wfc_request_phase != WFC_REQ_ROOT ||
+	    opid != wfc_request_opid() || type != WMTDRV_TYPE_WIFI ||
+	    timeout != 4000) {
+		wfc_request_fail();
+	} else {
+		wfc_request_op = op;
+		wfc_request_phase = WFC_REQ_BOUND;
+		wfc_request_emit(words, ARRAY_SIZE(words));
+	}
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+static void wfc_request_submit(P_OSAL_OP op)
+{
+	unsigned long flags;
+	u32 words[] = {18, 0};
+
+	if (!op || !ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (op != wfc_request_op) {
+		if (op->op.opId == WMT_OPID_FUNC_ON || op->op.opId == WMT_OPID_FUNC_OFF)
+			wfc_request_fail();
+	} else if (wfc_request_root != current ||
+		   wfc_request_phase != WFC_REQ_BOUND) {
+		wfc_request_fail();
+	} else {
+		wfc_request_phase = WFC_REQ_QUEUED;
+		wfc_request_emit(words, ARRAY_SIZE(words));
+	}
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+static void wfc_request_worker_begin(P_OSAL_OP op)
+{
+	unsigned long flags;
+	u32 words[] = {19, 0, op->op.opId, op->op.au4OpData[0]};
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (op != wfc_request_op) {
+		if (op->op.opId == WMT_OPID_FUNC_ON || op->op.opId == WMT_OPID_FUNC_OFF)
+			wfc_request_fail();
+	} else if (wfc_request_phase != WFC_REQ_QUEUED ||
+		   current == wfc_request_root || op->op.opId != wfc_request_opid() ||
+		   op->op.au4OpData[0] != WMTDRV_TYPE_WIFI) {
+		wfc_request_fail();
+	} else {
+		get_task_struct(current);
+		wfc_request_worker = current;
+		wfc_request_phase = WFC_REQ_WORKER;
+		wfc_request_emit(words, ARRAY_SIZE(words));
+	}
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+bool mt6797_wfc_request_common_begin(void)
+{
+	unsigned long flags;
+	bool bound = false;
+	u32 words[] = {22, 0, 1};
+
+	if (!ramoops_capture_active())
+		return false;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (wfc_request_phase != WFC_REQ_WORKER || wfc_request_id != 2 ||
+	    wfc_request_worker != current || wfc_request_common) {
+		wfc_request_fail();
+	} else {
+		wfc_request_common = 1;
+		wfc_request_emit(words, ARRAY_SIZE(words));
+		bound = wfc_request_phase != WFC_REQ_FAILED;
+	}
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+	return bound;
+}
+
+void mt6797_wfc_request_common_end(void)
+{
+	unsigned long flags;
+	u32 words[] = {23, 0, 1};
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (wfc_request_phase != WFC_REQ_WORKER || wfc_request_id != 2 ||
+	    wfc_request_worker != current || wfc_request_common != 1) {
+		wfc_request_fail();
+	} else {
+		wfc_request_common = 2;
+		wfc_request_emit(words, ARRAY_SIZE(words));
+	}
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+static void wfc_request_worker_end(P_OSAL_OP op, int status)
+{
+	unsigned long flags;
+	u32 words[] = {20, 0, status};
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (op != wfc_request_op) {
+		if (op->op.opId == WMT_OPID_FUNC_ON || op->op.opId == WMT_OPID_FUNC_OFF)
+			wfc_request_fail();
+		goto out;
+	}
+	if (wfc_request_phase != WFC_REQ_WORKER || wfc_request_worker != current) {
+		wfc_request_fail();
+	} else {
+		wfc_request_phase = WFC_REQ_WORKER_DONE;
+		wfc_request_emit(words, ARRAY_SIZE(words));
+		if (status || wfc_request_common != (wfc_request_id == 2 ? 2 : 0))
+			wfc_request_fail();
+		if (wfc_request_phase == WFC_REQ_WORKER_DONE) {
+			/* Matching current remains live; this is not its last task ref. */
+			put_task_struct(wfc_request_worker);
+			wfc_request_worker = NULL;
+		}
+	}
+out:
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+static void wfc_request_wait(P_OSAL_OP op, int wait, bool valid,
+			     int result, unsigned int success)
+{
+	unsigned long flags;
+	u32 words[] = {21, 0, wait, valid, result, success};
+
+	if (!op || !ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (op != wfc_request_op) {
+		if (op->op.opId == WMT_OPID_FUNC_ON || op->op.opId == WMT_OPID_FUNC_OFF)
+			wfc_request_fail();
+		goto out;
+	}
+	wfc_request_emit(words, ARRAY_SIZE(words));
+	if (wfc_request_phase != WFC_REQ_WORKER_DONE ||
+	    wfc_request_root != current || wait <= 0 || !valid || result || success != 1) {
+		wfc_request_fail();
+	} else {
+		wfc_request_phase = WFC_REQ_WAIT_DONE;
+		/* The caller still owns the operation; clear before its pool release. */
+		wfc_request_op = NULL;
+	}
+out:
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+void mt6797_wfc_request_end(int status)
+{
+	unsigned long flags;
+	u32 words[] = {24, 0, status};
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (wfc_request_phase != WFC_REQ_WAIT_DONE ||
+	    wfc_request_root != current || wfc_request_op || wfc_request_worker) {
+		wfc_request_fail();
+	} else {
+		wfc_request_phase = wfc_request_id == 1 ? WFC_REQ_ON_DONE : WFC_REQ_DONE;
+		wfc_request_emit(words, ARRAY_SIZE(words));
+		if (status)
+			wfc_request_fail();
+		if (wfc_request_phase == WFC_REQ_DONE) {
+			put_task_struct(wfc_request_root);
+			wfc_request_root = NULL;
+		}
+	}
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+static void wfc_request_release(const void *op)
+{
+	unsigned long flags;
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (op == wfc_request_op)
+		wfc_request_fail();
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+static void wfc_request_reset(void)
+{
+	unsigned long flags;
+
+	if (!ramoops_capture_active())
+		return;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	wfc_request_fail();
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+}
+
+#endif
diff --git a/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_exp.c b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_exp.c
index d4e1626..ff9a6ae 100644
--- a/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_exp.c
+++ b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_exp.c
@@ -37,6 +37,8 @@
 *                    E X T E R N A L   R E F E R E N C E S
 ********************************************************************************
 */
+#include <linux/mt6797_wifi_capture.h>
+
 #include "osal_typedef.h"
 
 #include <wmt_exp.h>
@@ -114,6 +116,8 @@ static MTK_WCN_BOOL mtk_wcn_wmt_func_ctrl(ENUM_WMTDRV_TYPE_T type, ENUM_WMT_OPID
 		pSignal->timeoutValue =
 		    (WMT_OPID_FUNC_ON == pOp->op.opId) ? MAX_FUNC_ON_TIME : MAX_FUNC_OFF_TIME;
 
+	mt6797_wfc_request_bind(pOp, pOp->op.opId, pOp->op.au4OpData[0],
+				pSignal->timeoutValue);
 	WMT_INFO_FUNC("wmt-exp: OPID(%d) type(%zu) start\n", pOp->op.opId, pOp->op.au4OpData[0]);
 
 	/*do not check return value, we will do this either way */
diff --git a/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_lib.c b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_lib.c
index a602df1..69c3ea2 100644
--- a/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_lib.c
+++ b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt_lib.c
@@ -57,6 +57,7 @@
 #include "psm_core.h"
 #include "stp_sdio.h"
 #include "stp_dbg.h"
+#include "wmt-request-capture.h"
 
 /*******************************************************************************
 *                              C O N S T A N T S
@@ -141,6 +142,8 @@ static INT32 wmt_op_put(P_OSAL_OP op)
 	mutex_lock(&wmt_op_lock);
 	release = !--wmt_op_state[op - gDevWmt.arQue].users;
 	mutex_unlock(&wmt_op_lock);
+	if (release)
+		wfc_request_release(op);
 	if (release && !wmt_lib_put_op(&gDevWmt.rFreeOpQ, op))
 		return -1;
 	return 0;
@@ -1134,7 +1137,9 @@ static INT32 wmtd_thread(void *pvData)
 			}
 		} else {
 			wmt_lib_set_current_op(pWmtDev, pOp);
+			wfc_request_worker_begin(pOp);
 			iResult = wmt_core_opid(&pOp->op);
+			wfc_request_worker_end(pOp, iResult);
 		}
 
 		if (iResult)
@@ -1280,6 +1285,7 @@ MTK_WCN_BOOL wmt_lib_put_act_op(P_OSAL_OP pOp)
 
 		/* Acquire queue/worker ownership before the operation becomes visible. */
 		wmt_op_get(pOp);
+		wfc_request_submit(pOp);
 		bRet = wmt_lib_put_op(&pWmtDev->rActiveOpQ, pOp);
 		if (MTK_WCN_BOOL_FALSE == bRet) {
 			WMT_WARN_FUNC("put to active queue fail\n");
@@ -1331,6 +1337,7 @@ MTK_WCN_BOOL wmt_lib_put_act_op(P_OSAL_OP pOp)
 		bRet = result ? MTK_WCN_BOOL_FALSE : MTK_WCN_BOOL_TRUE;
 	} while (0);
 
+	wfc_request_wait(pOp, waitRet, waitRet > 0, waitRet > 0 ? result : 0, bRet);
 	if (bCleanup)
 		wmt_op_put(pOp);
 
@@ -1908,6 +1915,7 @@ ENUM_WMTRSTRET_TYPE_T wmt_lib_cmb_rst(ENUM_WMTRSTSRC_TYPE_T src)
 		"WMTRSTSRC_RESET_TEST"
 	};
 
+	wfc_request_reset();
 	if (src < WMTRSTSRC_RESET_MAX)
 		WMT_INFO_FUNC("reset source = %s\n", srcName[src]);
 
