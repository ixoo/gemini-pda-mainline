 .../common/common_detect/wmt_capture_init.h   | 34 +++++++++++++
 .../common/common_detect/wmt_detect.c         | 49 +++++++++++++++++++
 .../common/common_detect/wmt_detect.h         | 10 ++++
 fs/pstore/wifi_capture.h                      |  2 +-
 7 files changed, 181 insertions(+), 1 deletion(-)
 create mode 100644 drivers/misc/mediatek/connectivity/common/common_detect/wmt_capture_init.h

