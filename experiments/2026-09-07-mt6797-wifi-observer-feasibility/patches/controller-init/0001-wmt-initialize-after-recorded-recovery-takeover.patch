 	i_ret_tmp = mtk_wcn_stp_uart_drv_init();
+	capture_ret = wmt_capture_init_result(13, i_ret_tmp);
+	if (capture_ret)
+		return capture_ret;
 	i_ret += i_ret_tmp;
 	WMT_DETECT_DBG_FUNC("STP-UART driver init, i_ret:%d\n", i_ret);
 
 	/* STP-SDIO driver init */
