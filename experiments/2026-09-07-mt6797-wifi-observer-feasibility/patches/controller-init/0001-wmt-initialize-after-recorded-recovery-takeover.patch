 	WMT_DETECT_DBG_FUNC("HIF-SDIO driver init, i_ret:%d\n", i_ret);
 
 	/* WMT driver init */
+	capture_ret = wmt_capture_init_event(12, 1, 0);
+	if (capture_ret)
+		return capture_ret;
 	i_ret_tmp = mtk_wcn_common_drv_init();
+	capture_ret = wmt_capture_init_result(12, i_ret_tmp);
+	if (capture_ret)
+		return capture_ret;
 	i_ret += i_ret_tmp;
 	WMT_DETECT_DBG_FUNC("COMBO COMMON driver init, i_ret:%d\n", i_ret);
 
