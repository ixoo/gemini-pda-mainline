+	if (capture_ret)
+		return capture_ret;
 	tmp_ret = do_common_drv_init(chip_id);
+	capture_ret = wmt_capture_init_result(1, tmp_ret);
+	if (capture_ret)
+		return capture_ret;
 	i_ret += tmp_ret;
 	if (tmp_ret) {
 		WMT_DETECT_ERR_FUNC("do common driver init failed, ret:%d\n", tmp_ret);
@@ -51,27 +63,57 @@ int do_connectivity_driver_init(int chip_id)
 		return i_ret;
 	}
 
+	capture_ret = wmt_capture_init_event(2, 1, 0);
+	if (capture_ret)
+		return capture_ret;
 	tmp_ret = do_bluetooth_drv_init(chip_id);
+	capture_ret = wmt_capture_init_result(2, tmp_ret);
+	if (capture_ret)
+		return capture_ret;
 	i_ret += tmp_ret;
 	if (tmp_ret)
 		WMT_DETECT_ERR_FUNC("do common driver init failed, ret:%d\n", tmp_ret);
 
+	capture_ret = wmt_capture_init_event(3, 1, 0);
+	if (capture_ret)
+		return capture_ret;
