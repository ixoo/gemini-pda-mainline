@@ -31,7 +38,13 @@ int do_wlan_drv_init(int chip_id)
 	WMT_DETECT_INFO_FUNC("start to do wlan module init 0x%x\n", chip_id);
 
 	/* WMT-WIFI char dev init */
+	capture_ret = wmt_capture_init_event(21, 1, 0);
+	if (capture_ret)
+		return capture_ret;
 	ret = mtk_wcn_wmt_wifi_init();
+	capture_ret = wmt_capture_init_result(21, ret);
+	if (capture_ret)
+		return capture_ret;
 	WMT_DETECT_INFO_FUNC("WMT-WIFI char dev init, ret:%d\n", ret);
 	i_ret += ret;
 
@@ -40,7 +53,13 @@ int do_wlan_drv_init(int chip_id)
 	case 0x6797:
 #ifdef MTK_WCN_WLAN_GEN3
 		/* WLAN driver init */
+		capture_ret = wmt_capture_init_event(22, 1, 0);
+		if (capture_ret)
+			return capture_ret;
 		ret = mtk_wcn_wlan_gen3_init();
+		capture_ret = wmt_capture_init_result(22, ret);
+		if (capture_ret)
+			return capture_ret;
 		WMT_DETECT_INFO_FUNC("WLAN-GEN3 driver init, ret:%d\n", ret);
 		i_ret += ret;
 #else
diff --git a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_capture_init.h b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_capture_init.h
new file mode 100644
index 0000000..d58b043
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_capture_init.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _WMT_CAPTURE_INIT_H
+#define _WMT_CAPTURE_INIT_H
+
+#ifdef CONFIG_MTK_A72_RECOVERY_DISCRIMINATOR
+#include <linux/pstore_ram.h>
+
+static inline int wmt_capture_init_event(u32 site, u32 stage, int result)
+{
+	__le32 record[] = { cpu_to_le32(site), cpu_to_le32(stage),
+			    cpu_to_le32((u32)result) };
+
+	return ramoops_capture_append(12, 0, (const u8 *)record, sizeof(record));
+}
+
+static inline int wmt_capture_init_result(u32 site, int result)
+{
+	int recorded = wmt_capture_init_event(site, 2, result);
+
+	return result ? result : recorded;
+}
+#else
+static inline int wmt_capture_init_event(u32 site, u32 stage, int result)
+{
+	return 0;
+}
+
+static inline int wmt_capture_init_result(u32 site, int result)
+{
+	return 0;
+}
+#endif
+
+#endif
diff --git a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c
index 632cd1e..b2a04dd 100644
--- a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c
+++ b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c
@@ -22,6 +22,11 @@
 
 #include "wmt_detect.h"
 #include "wmt_gpio.h"
+#ifdef CONFIG_MTK_A72_RECOVERY_DISCRIMINATOR
+#include <linux/capability.h>
+#include <ext_wd_drv.h>
+#include "wmt_capture_init.h"
+#endif
 
 #if MTK_WCN_REMOVE_KO
 #include "conn_drv_init.h"
@@ -80,8 +85,47 @@ ssize_t wmt_detect_write(struct file *filp, const char __user *buf, size_t count
 	return 0;
 }
 
+#ifdef CONFIG_MTK_A72_RECOVERY_DISCRIMINATOR
+static long wmt_capture_initialize(unsigned long arg)
+{
+	struct wmt_capture_identity input;
+	struct mtk_wdt_recovery_state recovery;
+	__le32 failed = cpu_to_le32(2);
+	int ret, recorded;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (copy_from_user(&input, (const void __user *)arg, sizeof(input)))
+		return -EFAULT;
+#if !MTK_WCN_REMOVE_KO || !defined(CONFIG_MTK_COMBO_WIFI)
+	return -EOPNOTSUPP;
+#endif
+	ret = mtk_wdt_capture_begin(input.cycle, input.identity, &recovery);
+	if (ret)
+		return ret;
+	ret = wmt_capture_init_event(0, 1, 0);
+	if (ret)
+		goto failed_capture;
+	mtk_wcn_wmt_set_chipid(0x6797);
+	ret = do_connectivity_driver_init(0x6797);
+	recorded = wmt_capture_init_event(0, 2, ret);
+	if (!ret)
+		ret = recorded;
+	if (!ret)
+		return 0;
+failed_capture:
+	ramoops_capture_append(255, 0, (const u8 *)&failed, sizeof(failed));
+	return ret > 0 ? -EIO : ret;
+}
+#endif
+
 static long wmt_detect_unlocked_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 {
+#ifdef CONFIG_MTK_A72_RECOVERY_DISCRIMINATOR
+	if (cmd != COMBO_IOCTL_CAPTURE_INIT)
+		return -EPERM;
+	return wmt_capture_initialize(arg);
+#else
 	int retval = 0;
 
 	WMT_DETECT_INFO_FUNC("cmd (%d),arg(%ld)\n", cmd, arg);
@@ -145,15 +189,20 @@ static long wmt_detect_unlocked_ioctl(struct file *filp, unsigned int cmd, unsig
 		break;
 	}
 	return retval;
+#endif
 }
 #ifdef CONFIG_COMPAT
 static long WMT_compat_detect_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 {
+#ifdef CONFIG_MTK_A72_RECOVERY_DISCRIMINATOR
+	return -EOPNOTSUPP;
+#else
 	long ret;
 
 	WMT_DETECT_INFO_FUNC("cmd (%d)\n", cmd);
 	ret = wmt_detect_unlocked_ioctl(filp, cmd, arg);
 	return ret;
+#endif
 }
 #endif
 const struct file_operations gWmtDetectFops = {
diff --git a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.h b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.h
index 3a59805..cc3ded4 100644
