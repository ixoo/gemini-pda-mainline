From 3146f836d23dc22c23c9afffbbe2ffc87ee3ef93 Mon Sep 17 00:00:00 2001
From: Gemini experiment archive <experiment@invalid.example>
Date: Wed, 9 Sep 2026 20:55:12 -0400
Subject: [PATCH] pstore: freeze native capture parameters before registration

Freeze the capture choice before ramoops initialization. Native kernfs
permits inode mode changes and param_attr_store calls the setter without
checking the original parameter permissions. A setter-level refusal
prevents a later permission change from releasing exclusion.

The native boot parameter parser also calls set without a NULL check.
Give the denial mask an explicit refusing setter so a supplied boot
argument fails instead of dereferencing NULL.

The archive identity is synthetic and non-certifying. This is an
unselected native experiment fix, not submission-ready.
---
 fs/pstore/ram.c | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/fs/pstore/ram.c b/fs/pstore/ram.c
index d1fadac..56d0405 100644
--- a/fs/pstore/ram.c
+++ b/fs/pstore/ram.c
@@ -102,12 +102,32 @@ MODULE_PARM_DESC(mem_type,
 
 /* Boot-only exclusion: never transfer PMSG ownership in a running kernel. */
 static bool pmsg_capture;
-module_param(pmsg_capture, bool, 0400);
+static bool pmsg_capture_locked;
+
+static int pmsg_capture_set(const char *val, const struct kernel_param *kp)
+{
+	if (pmsg_capture_locked)
+		return -EPERM;
+	return param_set_bool(val, kp);
+}
+
+static const struct kernel_param_ops pmsg_capture_ops = {
+	.set = pmsg_capture_set,
+	.get = param_get_bool,
+};
+module_param_cb(pmsg_capture, &pmsg_capture_ops, &pmsg_capture, 0400);
 MODULE_PARM_DESC(pmsg_capture, "reserve PMSG from ordinary writes and erases");
 
 /* Bit 0: rejected write; bit 1: rejected erase. Never clear during this boot. */
 static unsigned long pmsg_capture_denials;
+
+static int pmsg_capture_denials_set(const char *val, const struct kernel_param *kp)
+{
+	return -EPERM;
+}
+
 static const struct kernel_param_ops pmsg_capture_denials_ops = {
+	.set = pmsg_capture_denials_set,
 	.get = param_get_ulong,
 };
 module_param_cb(pmsg_capture_denials, &pmsg_capture_denials_ops,
@@ -703,6 +723,7 @@ static void ramoops_register_dummy(void)
 
 static int __init ramoops_init(void)
 {
+	pmsg_capture_locked = true;
 #ifdef MODULE
 	/* Capture exclusion must last for the boot, without unload/reload. */
 	if (pmsg_capture)
