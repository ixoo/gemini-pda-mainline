diff --git a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
new file mode 100644
index 0000000..c1c75f7
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Isolated native MT6797 buffer/section observation, not a firmware loader. */
+#include <linux/err.h>
+#include <linux/pstore_ram.h>
+#include <linux/string.h>
+#include <crypto/hash.h>
+#include <crypto/sha.h>
+#include <asm/unaligned.h>
+#include "include/hif_capture.h"
+#include "include/hif_fw_capture.h"
+
+static void wfc_fw_image_fail(struct wfc_fw_image *trace)
+{
+	trace->transaction = 0;
+	wfc_dma_abort();
+}
+
+static bool wfc_fw_image_live(const struct wfc_fw_image *trace)
+{
+	return trace->transaction && !atomic_read(&trace->binding->retired) &&
+		ramoops_capture_active();
+}
+
+static void wfc_fw_image_emit(struct wfc_fw_image *trace,
+			      const u8 *data, size_t bytes)
+{
+	if (!wfc_fw_image_live(trace) ||
+	    ramoops_capture_append(7, trace->transaction, data, bytes))
+		wfc_fw_image_fail(trace);
+}
+
+static int wfc_fw_image_hash(struct wfc_fw_image *trace, u8 *digest)
+{
+	u8 context[sizeof(struct shash_desc) + sizeof(struct sha256_state)]
+		CRYPTO_MINALIGN_ATTR;
+	struct shash_desc *desc = (struct shash_desc *)context;
+	int ret;
+
+	memset(context, 0, sizeof(context));
+	desc->tfm = trace->hash;
+	ret = crypto_shash_digest(desc, trace->buffer, WFC_FW_BYTES, digest);
+	memzero_explicit(context, sizeof(context));
+	return ret;
+}
+
+void wfc_fw_image_begin(struct wfc_fw_image *trace,
+			const struct wfc_dma_trace *binding,
+			const struct wfc_fw_buffer *read,
+			const void *buffer, u32 bytes, const void *header)
+{
+	u8 data[52];
+	u32 i;
+
+	memset(trace, 0, sizeof(*trace));
+	if (!ramoops_capture_active())
+		return;
+	if (!read || !read->read_id || !binding || !binding->device ||
+	    atomic_read(&binding->retired) || read->device != binding->device ||
+	    !buffer || buffer != read->buffer || buffer != header ||
+	    bytes != read->bytes || bytes != WFC_FW_BYTES)
+		goto fail;
+	trace->binding = binding;
+	trace->buffer = buffer;
+	trace->device = read->device;
+	trace->transaction = read->read_id;
+	/* Validate every descriptor before the extra whole-buffer reads. */
+	if (get_unaligned_le32(trace->buffer) != 0x454b544d ||
+	    get_unaligned_le32(trace->buffer + 8) != WFC_FW_SECTIONS)
+		goto fail;
+	for (i = 0; i < WFC_FW_SECTIONS; i++) {
+		const u8 *section = trace->buffer + 24 + i * 16;
+		u32 offset = get_unaligned_le32(section);
+		u32 length = get_unaligned_le32(section + 8);
+		u32 destination = get_unaligned_le32(section + 12);
+
+		if (offset < 24 + WFC_FW_SECTIONS * 16 || offset > bytes ||
+		    !length || length > bytes - offset ||
+		    (u64)destination + length > 0x100000000ULL)
+			goto fail;
+	}
+	trace->hash = crypto_alloc_shash("sha256-generic", 0, 0);
+	if (IS_ERR(trace->hash)) {
+		trace->hash = NULL;
+		goto fail;
+	}
+	if (crypto_shash_descsize(trace->hash) != sizeof(struct sha256_state) ||
+	    crypto_shash_digestsize(trace->hash) != 32 ||
+	    wfc_fw_image_hash(trace, trace->digest))
+		goto free_hash;
+	put_unaligned_le32(5, data);
+	put_unaligned_le32(trace->device, data + 4);
+	put_unaligned_le32(trace->transaction, data + 8);
+	put_unaligned_le32(bytes, data + 12);
+	put_unaligned_le32(WFC_FW_SECTIONS, data + 16);
+	memcpy(data + 20, trace->digest, 32);
+	wfc_fw_image_emit(trace, data, sizeof(data));
+	return;
+
+free_hash:
+	crypto_free_shash(trace->hash);
+	trace->hash = NULL;
+fail:
+	wfc_fw_image_fail(trace);
+}
+
+void wfc_fw_image_section(struct wfc_fw_image *trace, u32 index)
+{
+	const u8 *section;
+	u8 data[36];
+
+	if (!trace->transaction)
+		return;
+	if (!wfc_fw_image_live(trace) || index != trace->next ||
+	    index >= WFC_FW_SECTIONS) {
+		wfc_fw_image_fail(trace);
+		return;
+	}
+	section = trace->buffer + 24 + index * 16;
+	put_unaligned_le32(6, data);
+	put_unaligned_le32(trace->device, data + 4);
+	put_unaligned_le32(trace->transaction, data + 8);
+	put_unaligned_le32(index, data + 12);
+	put_unaligned_le32(get_unaligned_le32(section), data + 16);
+	put_unaligned_le32(get_unaligned_le32(section + 8), data + 20);
+	put_unaligned_le32(get_unaligned_le32(section + 12), data + 24);
+	put_unaligned_le32(section[5], data + 28);
+	put_unaligned_le32(section[4], data + 32);
+	wfc_fw_image_emit(trace, data, sizeof(data));
+	trace->next++;
+}
+
+u32 wfc_fw_image_return(struct wfc_fw_image *trace, u32 status)
+{
+	u8 digest[32] __aligned(4);
+	u8 data[16];
+
+	if (trace->transaction) {
+		if (!wfc_fw_image_live(trace) ||
+		    (!status && trace->next != WFC_FW_SECTIONS) ||
+		    wfc_fw_image_hash(trace, digest) ||
+		    memcmp(trace->digest, digest, sizeof(digest))) {
+			wfc_fw_image_fail(trace);
+		} else {
+			put_unaligned_le32(7, data);
+			put_unaligned_le32(trace->device, data + 4);
+			put_unaligned_le32(trace->transaction, data + 8);
+			put_unaligned_le32(status, data + 12);
+			wfc_fw_image_emit(trace, data, sizeof(data));
+		}
+	}
+	if (trace->hash)
+		crypto_free_shash(trace->hash);
+	memzero_explicit(trace, sizeof(*trace));
+	memzero_explicit(digest, sizeof(digest));
+	return status;
+}
