@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _WFC_FW_CAPTURE_H
+#define _WFC_FW_CAPTURE_H
+
+#include <linux/types.h>
+
+#define WFC_FW_BYTES 411632U
+#define WFC_FW_SECTIONS 4U
+
+struct wfc_dma_trace;
+struct crypto_shash;
+
+/* Borrowed only from the synchronous, successful native mapping invocation. */
+struct wfc_fw_buffer {
+	const void *buffer;
+	u32 bytes;
+	u32 read_id;
+	u32 device;
