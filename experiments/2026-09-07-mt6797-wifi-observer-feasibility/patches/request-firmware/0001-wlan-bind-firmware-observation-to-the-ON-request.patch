From 66735f76121f2fe358ff4a75d8c8d9625af76a9c Mon Sep 17 00:00:00 2001
From: Gemini experiment archive <experiment@invalid.example>
Date: Thu, 10 Sep 2026 10:36:03 -0400
Subject: [PATCH] wlan: bind firmware observation to the ON request

Bind the native firmware read, divided-image entry and successful image
return to the captured ON worker. Require one consistent adapter/read
identity and reject missing, repeated or cross-task firmware events.
An already-on native shortcut cannot complete the observed ON scope.

Emit three bounded metadata records. Check entry before the existing
observer hash work and check return after the existing image record.
Preserve all native file, loader, crypto, EMI and request return behavior.

This unselected experiment adds no controller, hardware operation or
resource isolation. Boundary hashes still do not prove submitted-byte
identity. Full linking and device admission remain separate. The
synthetic archive author is non-certifying and supplies no DCO sign-off.
---
 .../common_main/core/wmt-request-capture.h    | 36 ++++++++++++++++++-
 .../connectivity/wlan/gen3/os/linux/gl_kal.c  |  3 ++
 .../linux/hif/ahb_sdioLike/hif_fw_capture.c   |  6 ++++
 include/linux/mt6797_wifi_capture.h           |  4 +++
 4 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/drivers/misc/mediatek/connectivity/common/common_main/core/wmt-request-capture.h b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt-request-capture.h
index 72256d9..f964a80 100644
--- a/drivers/misc/mediatek/connectivity/common/common_main/core/wmt-request-capture.h
+++ b/drivers/misc/mediatek/connectivity/common/common_main/core/wmt-request-capture.h
@@ -29,6 +29,9 @@ static struct task_struct *wfc_request_worker;
 static const void *wfc_request_op;
 static u32 wfc_request_id;
 static unsigned int wfc_request_common;
+static unsigned int wfc_request_firmware_stage;
+static u32 wfc_request_firmware_device;
+static u32 wfc_request_firmware_image;
 
 static void wfc_request_fail(void)
 {
@@ -197,6 +200,36 @@ void mt6797_wfc_request_common_end(void)
 	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
 }
 
+bool mt6797_wfc_request_firmware(unsigned int stage, u32 device, u32 image,
+				 int status)
+{
+	unsigned long flags;
+	bool accepted = false;
+	u32 words[] = {24 + stage, 0, device, image, status};
+
+	if (!ramoops_capture_active())
+		return false;
+	raw_spin_lock_irqsave(&wfc_request_lock, flags);
+	if (wfc_request_phase != WFC_REQ_WORKER || wfc_request_id != 1 ||
+	    wfc_request_worker != current || stage < 1 || stage > 3 ||
+	    stage != wfc_request_firmware_stage + 1 || !device || !image ||
+	    (stage != 3 && status) ||
+	    (stage != 1 && (device != wfc_request_firmware_device ||
+			   image != wfc_request_firmware_image))) {
+		wfc_request_fail();
+	} else {
+		wfc_request_firmware_device = device;
+		wfc_request_firmware_image = image;
+		wfc_request_firmware_stage = stage;
+		wfc_request_emit(words, stage == 3 ? 5 : 4);
+		if (status)
+			wfc_request_fail();
+		accepted = wfc_request_phase != WFC_REQ_FAILED;
+	}
+	raw_spin_unlock_irqrestore(&wfc_request_lock, flags);
+	return accepted;
+}
+
 static void wfc_request_worker_end(P_OSAL_OP op, int status)
 {
 	unsigned long flags;
@@ -215,7 +248,8 @@ static void wfc_request_worker_end(P_OSAL_OP op, int status)
 	} else {
 		wfc_request_phase = WFC_REQ_WORKER_DONE;
 		wfc_request_emit(words, ARRAY_SIZE(words));
-		if (status || wfc_request_common != (wfc_request_id == 2 ? 2 : 0))
+		if (status || wfc_request_common != (wfc_request_id == 2 ? 2 : 0) ||
+		    (wfc_request_id == 1 && wfc_request_firmware_stage != 3))
 			wfc_request_fail();
 		if (wfc_request_phase == WFC_REQ_WORKER_DONE) {
 			/* Matching current remains live; this is not its last task ref. */
diff --git a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_kal.c b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_kal.c
index 197b038..32acbe9 100644
--- a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_kal.c
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_kal.c
@@ -37,6 +37,7 @@
 #include "gl_wext.h"
 #include "precomp.h"
 #include <linux/pstore_ram.h>
+#include <linux/mt6797_wifi_capture.h>
 #include <asm/unaligned.h>
 #if CFG_SUPPORT_AGPS_ASSIST
 #include <net/netlink.h>
@@ -351,6 +352,8 @@ static void wfc_fw_read_begin(struct wfc_fw_read_trace *trace,
 		wfc_dma_abort();
 		return;
 	}
+	if (!mt6797_wfc_request_firmware(1, binding->device, transaction, 0))
+		return;
 	trace->binding = binding;
 	trace->device = binding->device;
 	trace->transaction = transaction;
diff --git a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
index 5d87f38..d21c144 100644
--- a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
@@ -2,6 +2,7 @@
 /* Isolated native MT6797 buffer/section observation, not a firmware loader. */
 #include <linux/err.h>
 #include <linux/pstore_ram.h>
+#include <linux/mt6797_wifi_capture.h>
 #include <linux/string.h>
 #include <crypto/hash.h>
 #include <crypto/sha.h>
@@ -59,6 +60,8 @@ void wfc_fw_image_begin(struct wfc_fw_image *trace,
 	    !buffer || buffer != read->buffer || buffer != header ||
 	    bytes != read->bytes || bytes != WFC_FW_BYTES)
 		goto fail;
+	if (!mt6797_wfc_request_firmware(2, read->device, read->read_id, 0))
+		goto fail;
 	trace->binding = binding;
 	trace->buffer = buffer;
 	trace->device = read->device;
@@ -146,6 +149,9 @@ u32 wfc_fw_image_return(struct wfc_fw_image *trace, u32 status)
 			put_unaligned_le32(trace->transaction, data + 8);
 			put_unaligned_le32(status, data + 12);
 			wfc_fw_image_emit(trace, data, sizeof(data));
+			if (trace->transaction)
+				mt6797_wfc_request_firmware(3, trace->device,
+							    trace->transaction, status);
 		}
 	}
 	if (trace->hash)
diff --git a/include/linux/mt6797_wifi_capture.h b/include/linux/mt6797_wifi_capture.h
index 516937e..d42233d 100644
--- a/include/linux/mt6797_wifi_capture.h
+++ b/include/linux/mt6797_wifi_capture.h
@@ -18,4 +18,8 @@ void mt6797_wfc_request_end(int status);
 bool mt6797_wfc_request_common_begin(void);
 void mt6797_wfc_request_common_end(void);
 
+/* Stages: 1 read entry, 2 divided-image entry, 3 divided-image return. */
+bool mt6797_wfc_request_firmware(unsigned int stage, u32 device, u32 image,
+				 int status);
+
 #endif
