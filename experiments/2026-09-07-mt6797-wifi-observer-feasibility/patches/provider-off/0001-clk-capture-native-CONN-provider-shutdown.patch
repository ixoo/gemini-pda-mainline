diff --git a/drivers/clk/mediatek/clk-mt6797-wfc.h b/drivers/clk/mediatek/clk-mt6797-wfc.h
new file mode 100644
index 0000000..29489bf
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6797-wfc.h
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* One native CONN OFF observation; no extra hardware reads or timeout. */
+#ifndef _MT6797_WFC_OFF_H
+#define _MT6797_WFC_OFF_H
+
+#include <linux/pstore_ram.h>
+#include <asm/unaligned.h>
+
+struct wfc_off_trace {
+	u32 transaction;
+	u64 primary_count;
+	u64 secondary_count;
+	u32 primary;
+	u32 secondary;
+	u32 primary_valid;
+	u32 secondary_valid;
+	u64 protect_count;
+	u32 protect_before;
+	u32 protect_store;
+	u32 protect_verify;
+	u32 protect_last;
+	u32 protect_valid;
+	u32 control[12];
+};
+
+static atomic_t wfc_off_attempts = ATOMIC_INIT(0);
+
+static void wfc_off_fail(struct wfc_off_trace *trace)
+{
+	u8 status[4];
+
+	if (trace)
+		trace->transaction = 0;
+	if (!ramoops_capture_active())
+		return;
+	put_unaligned_le32(2, status);
+	ramoops_capture_append(255, 0, status, sizeof(status));
+}
+
+static void wfc_off_emit(struct wfc_off_trace *trace, const u8 *data, size_t bytes)
+{
+	if (!trace || !trace->transaction)
+		return;
+	if (!ramoops_capture_active() ||
+	    ramoops_capture_append(9, trace->transaction, data, bytes))
+		wfc_off_fail(trace);
+}
+
+static void wfc_off_words(struct wfc_off_trace *trace, const u32 *words, size_t count)
+{
+	u8 data[48];
+	size_t i;
+
+	if (!trace || !trace->transaction)
+		return;
+	if (count > ARRAY_SIZE(data) / sizeof(u32)) {
+		wfc_off_fail(trace);
+		return;
+	}
+	for (i = 0; i < count; i++)
+		put_unaligned_le32(words[i], data + i * 4);
+	wfc_off_emit(trace, data, count * 4);
+}
+
+static void wfc_off_init(struct wfc_off_trace *trace, unsigned int id)
+{
+	memset(trace, 0, sizeof(*trace));
+	if (id != SYS_CONN || !ramoops_capture_active())
+		return;
+	trace->transaction = 1;
+	if (atomic_inc_return(&wfc_off_attempts) != 1)
+		wfc_off_fail(trace);
+}
+
+static void wfc_off_entry(struct wfc_off_trace *trace, u32 route, bool callback)
+{
+	u32 words[] = {3, 1, SYS_CONN, route, callback};
+
+	wfc_off_words(trace, words, ARRAY_SIZE(words));
+}
+
+static void wfc_off_poll(struct wfc_off_trace *trace, u32 stage, u32 reason)
+{
+	u8 data[44];
+
+	if (!trace || !trace->transaction)
+		return;
+	put_unaligned_le32(stage, data);
+	put_unaligned_le32(1, data + 4);
+	put_unaligned_le32(reason, data + 8);
+	put_unaligned_le64(trace->primary_count, data + 12);
+	put_unaligned_le64(trace->secondary_count, data + 20);
+	put_unaligned_le32(trace->primary, data + 28);
+	put_unaligned_le32(trace->secondary, data + 32);
+	put_unaligned_le32(trace->primary_valid, data + 36);
+	put_unaligned_le32(trace->secondary_valid, data + 40);
+	wfc_off_emit(trace, data, sizeof(data));
+}
+
+static u32 wfc_off_condition(struct wfc_off_trace *trace, bool secondary)
+{
+	u32 value = spm_read(secondary ? PWR_STATUS_2ND : PWR_STATUS);
+	u64 *count;
+
+	if (!trace || !trace->transaction)
+		return value;
+	if (!secondary) {
+		trace->secondary = 0;
+		trace->secondary_valid = 0;
+	}
+	count = secondary ? &trace->secondary_count : &trace->primary_count;
+	if (*count == ~(u64)0) {
+		trace->primary = 0;
+		trace->secondary = 0;
+		trace->primary_valid = 0;
+		trace->secondary_valid = 0;
+		wfc_off_poll(trace, 2, 3);
+		wfc_off_fail(trace);
+		return value;
+	}
+	(*count)++;
+	if (secondary) {
+		trace->secondary = value;
+		trace->secondary_valid = 1;
+	} else {
+		trace->primary = value;
+		trace->primary_valid = 1;
+	}
+	return value;
+}
+
+static u32 wfc_off_protect_condition(struct wfc_off_trace *trace)
+{
+	u32 value = spm_read(INFRA_TOPAXI_PROTECTSTA1);
+
+	if (trace && trace->transaction) {
+		/* Native count limit bounds this loop to 20001 condition reads. */
+		trace->protect_count++;
+		trace->protect_last = value;
+		trace->protect_valid = 1;
+	}
+	return value;
+}
+
+static void wfc_off_protection(struct wfc_off_trace *trace, u32 reason,
+			       bool returned, int status)
+{
+	u8 data[48];
+
+	if (!trace || !trace->transaction)
+		return;
+	put_unaligned_le32(7, data);
+	put_unaligned_le32(1, data + 4);
+	put_unaligned_le32(trace->protect_before, data + 8);
+	put_unaligned_le32(trace->protect_store, data + 12);
+	put_unaligned_le32(trace->protect_verify, data + 16);
+	put_unaligned_le32(reason, data + 20);
+	put_unaligned_le64(trace->protect_count, data + 24);
+	put_unaligned_le32(trace->protect_last, data + 32);
+	put_unaligned_le32(trace->protect_valid, data + 36);
+	put_unaligned_le32(returned, data + 40);
+	put_unaligned_le32(status, data + 44);
+	wfc_off_emit(trace, data, sizeof(data));
+}
+
+static void wfc_off_control(struct wfc_off_trace *trace, u32 index,
+			    u32 mask, bool set)
+{
+	u32 before = spm_read(CONN_PWR_CON);
+	u32 stored = set ? before | mask : before & ~mask;
+
+	spm_write(CONN_PWR_CON, stored);
+	if (!trace || !trace->transaction)
+		return;
+	trace->control[0] = 8;
+	trace->control[1] = 1;
+	trace->control[2 + index * 2] = before;
+	trace->control[3 + index * 2] = stored;
+}
+
+#endif
