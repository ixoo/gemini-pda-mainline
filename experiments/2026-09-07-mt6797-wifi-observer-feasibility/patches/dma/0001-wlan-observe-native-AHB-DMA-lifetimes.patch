index 0000000..56ef357
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_capture.c
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Experimental native DMA observation; no hardware control or retry. */
+#include <linux/atomic.h>
+#include <linux/errno.h>
+#include <linux/pstore_ram.h>
+#include <linux/string.h>
+#include <asm/unaligned.h>
+
+#include "hif_capture.h"
+
+static atomic_t wfc_devices = ATOMIC_INIT(0);
+static atomic_t wfc_transactions = ATOMIC_INIT(0);
+
+static bool wfc_active(void)
+{
+#if defined(CONFIG_PSTORE_RAM) && !defined(MODULE)
+	return ramoops_capture_active();
+#else
+	return false;
+#endif
+}
+
+static int wfc_append(u32 kind, u32 transaction, const u8 *data, size_t size)
+{
+#if defined(CONFIG_PSTORE_RAM) && !defined(MODULE)
+	return ramoops_capture_append(kind, transaction, data, size);
+#else
+	return -EPERM;
+#endif
+}
+
+static void wfc_fail(struct wfc_dma_trace *trace)
+{
+	u8 status[4];
+
+	trace->transaction = 0;
+	trace->fault = true;
+	put_unaligned_le32(2, status);
+	wfc_append(255, 0, status, sizeof(status));
+}
+
+static void wfc_emit(struct wfc_dma_trace *trace, u32 kind,
+		     const u8 *data, size_t size)
+{
+	if (trace->transaction && atomic_read(&trace->retired)) {
+		wfc_fail(trace);
+		return;
+	}
+	if (trace->transaction &&
+	    wfc_append(kind, trace->transaction, data, size))
+		trace->transaction = 0;
+}
+
+void wfc_dma_bind(struct wfc_dma_trace *trace, const void *device, u32 route)
+{
+	u8 data[16];
+	int ordinal;
+
+	memset(trace, 0, sizeof(*trace));
+	if (!wfc_active())
+		return;
+	ordinal = atomic_inc_return(&wfc_devices);
+	if (ordinal <= 0 || !device || (route != 1 && route != 2)) {
+		wfc_fail(trace);
+		return;
+	}
+	put_unaligned_le32(1, data);
+	put_unaligned_le32(ordinal, data + 4);
+	put_unaligned_le32(route, data + 8);
+	put_unaligned_le32(1, data + 12);
+	if (wfc_append(2, ordinal, data, sizeof(data)))
+		return;
+	trace->device = ordinal;
+	trace->bound_device = device;
+}
+
+void wfc_dma_abort(void)
+{
+	u8 status[4];
+
+	if (!wfc_active())
+		return;
+	put_unaligned_le32(2, status);
+	wfc_append(255, 0, status, sizeof(status));
+}
+
+void wfc_dma_unbind(struct wfc_dma_trace *trace)
+{
+	u8 data[12];
+	u32 pending;
+	int retired;
+
+	/* Do not take HifLock: a native timeout can retain it indefinitely. */
+	retired = atomic_xchg(&trace->retired, 1);
+	if (!trace->device || !wfc_active())
+		return;
+	if (retired) {
+		wfc_dma_abort();
+		return;
+	}
+	pending = READ_ONCE(trace->transaction);
+	put_unaligned_le32(2, data);
+	put_unaligned_le32(trace->device, data + 4);
+	put_unaligned_le32(pending, data + 8);
+	wfc_append(2, trace->device, data, sizeof(data));
+	if (pending)
+		wfc_dma_abort();
+}
+
+void wfc_dma_map(struct wfc_dma_trace *trace, const void *device, u32 direction,
+		 u32 requested, u32 rounded, u64 address, u32 port, u32 branch)
+{
+	u8 data[32];
+	int transaction;
+
+	if (!wfc_active()) {
+		trace->transaction = 0;
+		return;
+	}
+	if (atomic_read(&trace->retired) || !trace->device ||
+	    trace->bound_device != device ||
+	    trace->transaction || trace->fault) {
+		wfc_fail(trace);
+		return;
+	}
+	transaction = atomic_inc_return(&wfc_transactions);
+	if (transaction <= 0) {
+		wfc_fail(trace);
+		return;
+	}
+	trace->transaction = transaction;
+	memset(trace->setup, 0, sizeof(trace->setup));
+	memset(trace->shutdown, 0, sizeof(trace->shutdown));
+	trace->setup_seen = 0;
+	trace->shutdown_seen = 0;
+	trace->source = 0;
+	trace->destination = 0;
+	trace->reads = 0;
+	trace->last = 0;
+	trace->phase = 0;
+	trace->overflow = false;
+	put_unaligned_le32(trace->device, data);
+	put_unaligned_le32(direction, data + 4);
+	put_unaligned_le32(requested, data + 8);
+	put_unaligned_le32(rounded, data + 12);
+	put_unaligned_le64(address, data + 16);
+	put_unaligned_le32(port, data + 24);
+	put_unaligned_le32(branch, data + 28);
+	wfc_emit(trace, 3, data, sizeof(data));
+}
+
+void wfc_dma_config(struct wfc_dma_trace *trace, u64 source, u64 destination)
+{
+	if (!trace->transaction)
+		return;
+	trace->source = source;
+	trace->destination = destination;
+}
+
+void wfc_dma_sample(struct wfc_dma_trace *trace, u32 phase, u32 index, u32 value)
+{
+	u32 *values, *seen;
+
+	if (!trace->transaction)
+		return;
+	if ((phase != 1 && phase != 2) || index >= (phase == 1 ? 13 : 4)) {
+		trace->fault = true;
+		return;
+	}
+	values = phase == 1 ? trace->setup : trace->shutdown;
+	seen = phase == 1 ? &trace->setup_seen : &trace->shutdown_seen;
+	if (*seen & (1U << index))
+		trace->fault = true;
+	*seen |= 1U << index;
+	values[index] = value;
+}
+
+void wfc_dma_program(struct wfc_dma_trace *trace, u32 phase)
+{
+	u8 data[76] = { 0 };
+	unsigned int i;
+
+	if (!trace->transaction)
+		return;
+	if (trace->fault || (phase != 1 && phase != 2) ||
+	    (phase == 1 ? trace->setup_seen != 0x1fff :
+			  trace->shutdown_seen != 0xf)) {
+		wfc_fail(trace);
+		return;
+	}
+	put_unaligned_le32(trace->device, data);
+	put_unaligned_le32(phase, data + 4);
+	if (phase == 1) {
+		put_unaligned_le64(trace->source, data + 8);
+		put_unaligned_le64(trace->destination, data + 16);
+	}
+	for (i = 0; i < (phase == 1 ? 13 : 4); i++)
+		put_unaligned_le32(phase == 1 ? trace->setup[i] :
+				  trace->shutdown[i], data + 24 + 4 * i);
+	wfc_emit(trace, 4, data, sizeof(data));
+}
+
+void wfc_dma_poll_begin(struct wfc_dma_trace *trace, u32 phase)
+{
+	u8 data[32] = { 0 };
+
+	if (!trace->transaction)
+		return;
+	if (trace->phase || (phase != 1 && phase != 2)) {
+		wfc_fail(trace);
+		return;
+	}
+	trace->phase = phase;
+	trace->reads = 0;
+	trace->last = 0;
+	trace->overflow = false;
+	put_unaligned_le32(phase, data);
+	put_unaligned_le32(1, data + 4);
+	wfc_emit(trace, 5, data, sizeof(data));
+}
+
+void wfc_dma_poll_sample(struct wfc_dma_trace *trace, u32 phase, u32 value)
+{
+	if (!trace->transaction)
+		return;
+	if (trace->phase != phase) {
+		trace->fault = true;
+		return;
+	}
+	if (trace->reads == ~0ULL)
+		trace->overflow = true;
+	else
+		trace->reads++;
+	trace->last = value;
+}
+
+void wfc_dma_poll_end(struct wfc_dma_trace *trace, u32 phase, u32 reason)
+{
+	u8 data[32] = { 0 };
+
+	if (!trace->transaction)
+		return;
+	if (trace->fault || trace->phase != phase || reason < 1 || reason > 4) {
+		wfc_fail(trace);
+		return;
+	}
+	put_unaligned_le32(phase, data);
+	put_unaligned_le32(2, data + 4);
+	put_unaligned_le32(trace->overflow ? 5 : reason, data + 8);
+	put_unaligned_le64(trace->reads, data + 16);
+	put_unaligned_le32(trace->last, data + 24);
+	put_unaligned_le32(!!trace->reads, data + 28);
+	wfc_emit(trace, 5, data, sizeof(data));
+	trace->phase = 0;
+}
+
+void wfc_dma_unmap(struct wfc_dma_trace *trace, const void *device, u32 stage,
+		   u64 address, u32 rounded, u32 direction)
+{
+	u8 data[24];
+
+	if (!trace->transaction)
+		return;
+	if (trace->bound_device != device || (stage != 1 && stage != 2)) {
+		wfc_fail(trace);
+		return;
+	}
+	put_unaligned_le32(stage, data);
+	put_unaligned_le32(trace->device, data + 4);
+	put_unaligned_le64(address, data + 8);
+	put_unaligned_le32(rounded, data + 16);
+	put_unaligned_le32(direction, data + 20);
+	wfc_emit(trace, 6, data, sizeof(data));
+	if (stage == 2)
+		trace->transaction = 0;
+}
