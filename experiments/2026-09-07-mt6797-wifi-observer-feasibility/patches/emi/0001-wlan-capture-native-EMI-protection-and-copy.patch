@@ -873,23 +888,38 @@ wlanImageDividDownload(IN P_ADAPTER_T prAdapter,
 					prFwHead->arSection[i].u4Length,
 					fgEmiDownloaded);
 
-					if ((prFwHead->arSection[i].u4DestAddr & 0xfffff)
-							+ prFwHead->arSection[i].u4Length <= WIFI_EMI_MEM_SIZE) {
