 void wfc_fw_image_section(struct wfc_fw_image *trace, u32 index);
 u32 wfc_fw_image_return(struct wfc_fw_image *trace, u32 status);
 
+u32 wfc_fw_emi_begin(struct wfc_fw_image *trace, u32 index, u64 base);
+void wfc_fw_emi_mapping(struct wfc_fw_image *trace, u64 base,
+			u32 bytes, const void *mapping);
+void wfc_fw_emi_copy(struct wfc_fw_image *trace, u32 stage,
+		     const void *destination, const void *source, u32 bytes);
+
 #endif
diff --git a/drivers/misc/mediatek/emi_mpu/emi_reg_rw.c b/drivers/misc/mediatek/emi_mpu/emi_reg_rw.c
index 7d62aff..35eb004 100644
--- a/drivers/misc/mediatek/emi_mpu/emi_reg_rw.c
+++ b/drivers/misc/mediatek/emi_mpu/emi_reg_rw.c
@@ -12,6 +12,8 @@
  */
 
 #include <linux/kernel.h>
+#include <linux/pstore_ram.h>
+#include <asm/unaligned.h>
 #include <linux/module.h>
 #include <linux/interrupt.h>
 #include <linux/device.h>
@@ -71,14 +73,54 @@ unsigned int mt_emi_reg_read(unsigned int offset)
 	return 0;
 }
 
+static void emi_capture_protection(unsigned int transaction, unsigned int phase,
+				   unsigned int stage, unsigned int branch,
+				   u64 start, u64 end, u32 permission, int status)
+{
+	u8 data[40];
+
+	if (!transaction || !ramoops_capture_active())
+		return;
+	put_unaligned_le32(2, data);
+	put_unaligned_le32(phase, data + 4);
+	put_unaligned_le32(stage, data + 8);
+	put_unaligned_le32(branch, data + 12);
+	put_unaligned_le64(start, data + 16);
+	put_unaligned_le64(end, data + 24);
+	put_unaligned_le32(permission, data + 32);
+	put_unaligned_le32(status, data + 36);
+	ramoops_capture_append(8, transaction, data, sizeof(data));
+}
+
+int mt_emi_mpu_set_region_protection_capture(unsigned long long start,
+					     unsigned long long end,
+					     unsigned int region_permission,
+					     unsigned int transaction,
+					     unsigned int phase)
+{
+	int ret = 0;
+#if defined(CONFIG_ARM_PSCI) || defined(CONFIG_MTK_PSCI)
+	const u32 branch = 1;
+#else
+	const u32 branch = 2;
+#endif
+
+	emi_capture_protection(transaction, phase, 1, branch,
+			       start, end, region_permission, 0);
+#if defined(CONFIG_ARM_PSCI) || defined(CONFIG_MTK_PSCI)
+	ret = emi_mpu_smc_set(start, end, region_permission);
+#endif
+	emi_capture_protection(transaction, phase, 2, branch,
+			       start, end, region_permission, ret);
+	return ret;
+}
+
 int mt_emi_mpu_set_region_protection(unsigned long long start,
 				     unsigned long long end,
 				     unsigned int region_permission)
 {
-#if defined(CONFIG_ARM_PSCI) || defined(CONFIG_MTK_PSCI)
-	return emi_mpu_smc_set(start, end, region_permission);
-#endif
-	return 0;
+	return mt_emi_mpu_set_region_protection_capture(start, end,
+							region_permission, 0, 0);
 }
 
 void mt_emi_reg_base_set(void *base)
diff --git a/drivers/misc/mediatek/emi_mpu/mt6797/emi_mpu.c b/drivers/misc/mediatek/emi_mpu/mt6797/emi_mpu.c
index 9612821..3391dcb 100644
--- a/drivers/misc/mediatek/emi_mpu/mt6797/emi_mpu.c
+++ b/drivers/misc/mediatek/emi_mpu/mt6797/emi_mpu.c
@@ -1121,19 +1121,31 @@ void acquire_dram_setting(struct basic_dram_setting *pasrdpd)
  * @access_permission: EMI MPU access permission
  * Return 0 for success, otherwise negative status code.
  */
-int emi_mpu_set_region_protection(unsigned long long start,
-unsigned long long end, int region, unsigned int access_permission)
+int emi_mpu_set_region_protection_capture(unsigned long long start,
+					  unsigned long long end, int region,
+					  unsigned int access_permission,
+					  unsigned int transaction,
+					  unsigned int phase)
 {
-	int ret = 0;
 	unsigned long flags;
 
 	access_permission = access_permission & 0xFFFFFF;
-	access_permission = access_permission | ((region & 0x1F)<<27);
+	access_permission = access_permission | ((region & 0x1F) << 27);
 	spin_lock_irqsave(&emi_mpu_lock, flags);
-	mt_emi_mpu_set_region_protection(start, end, access_permission);
+	mt_emi_mpu_set_region_protection_capture(start, end, access_permission,
+						 transaction, phase);
 	spin_unlock_irqrestore(&emi_mpu_lock, flags);
 
-	return ret;
+	/* Preserve the native wrapper result; capture retains the lower status. */
+	return 0;
+}
+
+int emi_mpu_set_region_protection(unsigned long long start,
+				  unsigned long long end, int region,
+				  unsigned int access_permission)
+{
+	return emi_mpu_set_region_protection_capture(start, end, region,
+						     access_permission, 0, 0);
 }
 EXPORT_SYMBOL(emi_mpu_set_region_protection);
 
