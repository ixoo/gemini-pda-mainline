diff --git a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
index c1c75f7..5d87f38 100644
--- a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
@@ -154,3 +154,94 @@ u32 wfc_fw_image_return(struct wfc_fw_image *trace, u32 status)
 	memzero_explicit(digest, sizeof(digest));
 	return status;
 }
+
+/* The selected cycle has exactly two later sections and no retry. */
+static atomic_t wfc_emi_sections = ATOMIC_INIT(0);
+
+static void wfc_fw_emi_emit(struct wfc_fw_image *trace,
+			    const u8 *data, size_t bytes)
+{
+	if (!trace->transaction || !trace->emi_transaction)
+		return;
+	if (!wfc_fw_image_live(trace) ||
+	    ramoops_capture_append(8, trace->emi_transaction, data, bytes))
+		wfc_fw_image_fail(trace);
+}
+
+u32 wfc_fw_emi_begin(struct wfc_fw_image *trace, u32 index, u64 base)
+{
+	const u8 *section;
+	u32 transaction;
+	u8 data[40];
+
+	trace->emi_transaction = 0;
+	trace->emi_mapping = NULL;
+	if (!trace->transaction)
+		return 0;
+	if (!wfc_fw_image_live(trace) || index < 2 ||
+	    index >= WFC_FW_SECTIONS || trace->next != index + 1) {
+		wfc_fw_image_fail(trace);
+		return 0;
+	}
+	transaction = atomic_inc_return(&wfc_emi_sections);
+	if (transaction > 2) {
+		wfc_fw_image_fail(trace);
+		return 0;
+	}
+	trace->emi_transaction = transaction;
+	section = trace->buffer + 24 + index * 16;
+	put_unaligned_le32(1, data);
+	put_unaligned_le32(trace->device, data + 4);
+	put_unaligned_le32(trace->transaction, data + 8);
+	put_unaligned_le64(base, data + 12);
+	put_unaligned_le32(index, data + 20);
+	put_unaligned_le32(get_unaligned_le32(section), data + 24);
+	put_unaligned_le32(get_unaligned_le32(section + 8), data + 28);
+	put_unaligned_le32(get_unaligned_le32(section + 12), data + 32);
+	put_unaligned_le32(WFC_FW_BYTES, data + 36);
+	wfc_fw_emi_emit(trace, data, sizeof(data));
+	return trace->transaction ? transaction : 0;
+}
+
+void wfc_fw_emi_mapping(struct wfc_fw_image *trace, u64 base,
+			u32 bytes, const void *mapping)
+{
+	u8 data[20];
+
+	if (!trace->transaction || !trace->emi_transaction)
+		return;
+	trace->emi_mapping = mapping;
+	put_unaligned_le32(3, data);
+	put_unaligned_le32(mapping ? trace->emi_transaction : 0, data + 4);
+	put_unaligned_le64(base, data + 8);
+	put_unaligned_le32(bytes, data + 16);
+	wfc_fw_emi_emit(trace, data, sizeof(data));
+}
+
+void wfc_fw_emi_copy(struct wfc_fw_image *trace, u32 stage,
+		     const void *destination, const void *source, u32 bytes)
+{
+	unsigned long target = (unsigned long)destination;
+	unsigned long mapped = (unsigned long)trace->emi_mapping;
+	unsigned long input = (unsigned long)source;
+	unsigned long buffer = (unsigned long)trace->buffer;
+	u8 data[24];
+
+	if (!trace->transaction || !trace->emi_transaction)
+		return;
+	if (!trace->emi_mapping || target < mapped || input < buffer ||
+	    target - mapped > 512 * 1024 || input - buffer > WFC_FW_BYTES ||
+	    !bytes || bytes > 512 * 1024 - (target - mapped) ||
+	    bytes > WFC_FW_BYTES - (input - buffer) ||
+	    (stage != 1 && stage != 2)) {
+		wfc_fw_image_fail(trace);
+		return;
+	}
+	put_unaligned_le32(4, data);
+	put_unaligned_le32(stage, data + 4);
+	put_unaligned_le32(trace->emi_transaction, data + 8);
+	put_unaligned_le32(target - mapped, data + 12);
+	put_unaligned_le32(input - buffer, data + 16);
+	put_unaligned_le32(bytes, data + 20);
+	wfc_fw_emi_emit(trace, data, sizeof(data));
+}
