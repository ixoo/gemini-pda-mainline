--- a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_fw_capture.c
@@ -4,6 +4,8 @@
 #include <linux/pstore_ram.h>
 #include <linux/mt6797_wifi_capture.h>
 #include <linux/string.h>
+#include <linux/sched.h>
+#include <linux/kernel.h>
 #include <crypto/hash.h>
 #include <crypto/sha.h>
 #include <asm/unaligned.h>
@@ -62,6 +64,7 @@ void wfc_fw_image_begin(struct wfc_fw_image *trace,
 		goto fail;
 	if (!mt6797_wfc_request_firmware(2, read->device, read->read_id, 0))
 		goto fail;
+	trace->owner = current;
 	trace->binding = binding;
 	trace->buffer = buffer;
 	trace->device = read->device;
@@ -113,11 +116,19 @@ void wfc_fw_image_section(struct wfc_fw_image *trace, u32 index)
 
 	if (!trace->transaction)
 		return;
-	if (!wfc_fw_image_live(trace) || index != trace->next ||
+	if (!wfc_fw_image_live(trace) || current != trace->owner ||
+	    index != trace->next ||
 	    index >= WFC_FW_SECTIONS) {
 		wfc_fw_image_fail(trace);
 		return;
 	}
+	if (index && index <= 2 &&
+	    trace->tx_offset != get_unaligned_le32(trace->buffer +
+						 24 + (index - 1) * 16 + 8)) {
+		wfc_fw_image_fail(trace);
+		return;
+	}
+	trace->tx_offset = 0;
 	section = trace->buffer + 24 + index * 16;
 	put_unaligned_le32(6, data);
 	put_unaligned_le32(trace->device, data + 4);
@@ -138,8 +149,9 @@ u32 wfc_fw_image_return(struct wfc_fw_image *trace, u32 status)
 	u8 data[16];
 
 	if (trace->transaction) {
-		if (!wfc_fw_image_live(trace) ||
-		    (!status && trace->next != WFC_FW_SECTIONS) ||
+		if (!wfc_fw_image_live(trace) || current != trace->owner ||
+		    (!status && (trace->next != WFC_FW_SECTIONS ||
+				 trace->tx_chunks != 8)) ||
 		    wfc_fw_image_hash(trace, digest) ||
 		    memcmp(trace->digest, digest, sizeof(digest))) {
 			wfc_fw_image_fail(trace);
@@ -251,3 +263,190 @@ void wfc_fw_emi_copy(struct wfc_fw_image *trace, u32 stage,
 	put_unaligned_le32(bytes, data + 20);
 	wfc_fw_emi_emit(trace, data, sizeof(data));
 }
+
+static void wfc_fw_tx_fail(struct wfc_fw_tx *tx)
+{
+	if (tx && tx->image)
+		wfc_fw_image_fail(tx->image);
+	if (tx)
+		tx->phase = 0;
+}
+
+static bool wfc_fw_tx_ready(struct wfc_fw_tx *tx, u32 phase)
+{
+	if (!tx || !tx->image || !tx->image->transaction)
+		return false;
+	if (!wfc_fw_image_live(tx->image) ||
+	    current != tx->image->owner || tx->phase != phase) {
+		wfc_fw_tx_fail(tx);
+		return false;
+	}
+	return true;
+}
+
+static void wfc_fw_tx_emit(struct wfc_fw_tx *tx, const u8 *data, u32 bytes)
+{
+	if (ramoops_capture_append(7, tx->chunk, data, bytes))
+		wfc_fw_tx_fail(tx);
+}
+
+void wfc_fw_tx_begin(struct wfc_fw_tx *tx, struct wfc_fw_image *image,
+		     const void *source, u32 bytes)
+{
+	const u8 *section;
+	u32 offset, length;
+
+	memset(tx, 0, sizeof(*tx));
+	if (!image || !image->transaction)
+		return;
+	tx->image = image;
+	if (!wfc_fw_tx_ready(tx, 0))
+		return;
+	if (!image->next || image->next > 2 || image->tx_chunks >= 8)
+		goto fail;
+	section = image->buffer + 24 + (image->next - 1) * 16;
+	offset = get_unaligned_le32(section);
+	length = get_unaligned_le32(section + 8);
+	if (offset < 88 || offset > WFC_FW_BYTES || !length ||
+	    length > WFC_FW_BYTES - offset || image->tx_offset >= length ||
+	    !bytes || bytes > 2048 || bytes != min(2048U, length - image->tx_offset) ||
+	    source != image->buffer + offset + image->tx_offset)
+		goto fail;
+	tx->source = source;
+	tx->offset = offset + image->tx_offset;
+	tx->bytes = bytes;
+	tx->section = image->next - 1;
+	tx->chunk = image->tx_chunks + 1;
+	tx->phase = 1;
+	return;
+fail:
+	wfc_fw_tx_fail(tx);
+}
+
+void wfc_fw_tx_command(struct wfc_fw_tx *tx, const void *source, u32 bytes,
+		       const void *command, u32 logical)
+{
+	if (!wfc_fw_tx_ready(tx, 1))
+		return;
+	if (source != tx->source || bytes != tx->bytes || !command ||
+	    logical != bytes + 8) {
+		wfc_fw_tx_fail(tx);
+		return;
+	}
+	tx->command = command;
+	tx->phase = 2;
+}
+
+void wfc_fw_tx_staged(struct wfc_fw_tx *tx, const void *command, u32 logical,
+		      const void *buffer, u32 aligned, u32 capacity)
+{
+	if (!wfc_fw_tx_ready(tx, 2))
+		return;
+	if (command != tx->command || logical != tx->bytes + 8 || !buffer ||
+	    aligned != ALIGN(logical, 4) || aligned > capacity) {
+		wfc_fw_tx_fail(tx);
+		return;
+	}
+	tx->buffer = buffer;
+	tx->phase = 3;
+}
+
+void wfc_fw_tx_payload(struct wfc_fw_tx *tx, const struct wfc_dma_trace *binding,
+		       const void *buffer, u32 logical, u32 rounded,
+		       u32 capacity, u32 port)
+{
+	u8 context[sizeof(struct shash_desc) + sizeof(struct sha256_state)]
+		CRYPTO_MINALIGN_ATTR;
+	struct shash_desc *desc = (struct shash_desc *)context;
+	const u8 *packet = buffer;
+	u8 data[64];
+	int ret;
+
+	if (!wfc_fw_tx_ready(tx, 3))
+		return;
+	if (binding != tx->image->binding || binding->transaction || binding->fault ||
+	    buffer != tx->buffer || logical != tx->bytes + 8 ||
+	    rounded < logical || rounded > capacity || port != 0x34)
+		goto fail;
+	/* Only the already-bounded logical header and payload are read. */
+	if (get_unaligned_le16(packet) != logical ||
+	    get_unaligned_le16(packet + 2) != 0xc000 || packet[4] ||
+	    packet[5] != 0xa0 || packet[6])
+		goto fail;
+	memset(context, 0, sizeof(context));
+	desc->tfm = tx->image->hash;
+	ret = crypto_shash_digest(desc, packet + 8, tx->bytes, data + 32);
+	memzero_explicit(context, sizeof(context));
+	if (ret)
+		goto fail;
+	put_unaligned_le32(12, data);
+	put_unaligned_le32(tx->image->device, data + 4);
+	put_unaligned_le32(tx->image->transaction, data + 8);
+	put_unaligned_le32(tx->chunk, data + 12);
+	put_unaligned_le32(tx->section, data + 16);
+	put_unaligned_le32(tx->offset, data + 20);
+	put_unaligned_le32(tx->bytes, data + 24);
+	put_unaligned_le32(logical, data + 28);
+	tx->phase = 4;
+	wfc_fw_tx_emit(tx, data, sizeof(data));
+	return;
+fail:
+	wfc_fw_tx_fail(tx);
+}
+
+void wfc_fw_tx_dma(struct wfc_fw_tx *tx, const struct wfc_dma_trace *binding)
+{
+	u8 data[20];
+
+	if (!wfc_fw_tx_ready(tx, 4))
+		return;
+	if (binding != tx->image->binding || binding->fault || !binding->transaction) {
+		wfc_fw_tx_fail(tx);
+		return;
+	}
+	tx->dma = binding->transaction;
+	put_unaligned_le32(13, data);
+	put_unaligned_le32(tx->image->device, data + 4);
+	put_unaligned_le32(tx->image->transaction, data + 8);
+	put_unaligned_le32(tx->chunk, data + 12);
+	put_unaligned_le32(tx->dma, data + 16);
+	tx->phase = 5;
+	wfc_fw_tx_emit(tx, data, sizeof(data));
+}
+
+u8 wfc_fw_tx_port_return(struct wfc_fw_tx *tx, u8 status)
+{
+	u8 data[24];
+
+	if (!wfc_fw_tx_ready(tx, 5))
+		return status;
+	if (tx->image->binding->transaction || tx->image->binding->fault) {
+		wfc_fw_tx_fail(tx);
+		return status;
+	}
+	put_unaligned_le32(14, data);
+	put_unaligned_le32(tx->image->device, data + 4);
+	put_unaligned_le32(tx->image->transaction, data + 8);
+	put_unaligned_le32(tx->chunk, data + 12);
+	put_unaligned_le32(tx->dma, data + 16);
+	put_unaligned_le32(status, data + 20);
+	tx->phase = 6;
+	wfc_fw_tx_emit(tx, data, sizeof(data));
+	if (status != 1)
+		wfc_fw_tx_fail(tx);
+	return status;
+}
+
+u32 wfc_fw_tx_finish(struct wfc_fw_tx *tx, u32 status)
+{
+	if (wfc_fw_tx_ready(tx, 6)) {
+		if (status) {
+			wfc_fw_tx_fail(tx);
+		} else {
+			tx->image->tx_chunks++;
+			tx->image->tx_offset += tx->bytes;
+		}
+	}
+	memzero_explicit(tx, sizeof(*tx));
+	return status;
+}
