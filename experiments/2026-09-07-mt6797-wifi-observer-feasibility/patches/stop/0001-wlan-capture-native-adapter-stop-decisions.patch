index 0000000..fe37d04
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/hif/ahb_sdioLike/hif_stop_capture.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Observe one native adapter-stop invocation without changing its effects. */
+#include <linux/atomic.h>
+#include <linux/pstore_ram.h>
+#include <linux/string.h>
+#include <asm/unaligned.h>
+
+#include "hif_stop_capture.h"
+
+static atomic_t wfc_stops = ATOMIC_INIT(0);
+
+static void wfc_stop_fail(struct wfc_stop_trace *trace)
+{
+	trace->transaction = 0;
+	wfc_dma_abort();
+}
+
+static void wfc_stop_emit(struct wfc_stop_trace *trace, const u8 *data, size_t size)
+{
+	if (!trace->transaction)
+		return;
+	if (atomic_read(&trace->binding->retired)) {
+		wfc_stop_fail(trace);
+		return;
+	}
+#if defined(CONFIG_PSTORE_RAM) && !defined(MODULE)
+	if (ramoops_capture_append(7, trace->transaction, data, size))
+		trace->transaction = 0;
+#endif
+}
+
+void wfc_stop_begin(struct wfc_stop_trace *trace,
+		    const struct wfc_dma_trace *binding, u32 caller)
+{
+	int transaction;
+
+	memset(trace, 0, sizeof(*trace));
+#if defined(CONFIG_PSTORE_RAM) && !defined(MODULE)
+	if (!ramoops_capture_active())
+		return;
+#else
+	return;
+#endif
+	if (!binding->device || atomic_read(&binding->retired) ||
+	    (caller != 1 && caller != 2)) {
+		wfc_stop_fail(trace);
+		return;
+	}
+	transaction = atomic_inc_return(&wfc_stops);
+	if (transaction <= 0) {
+		wfc_stop_fail(trace);
+		return;
+	}
+	trace->binding = binding;
+	trace->device = binding->device;
+	trace->transaction = transaction;
+	trace->caller = caller;
+}
+
+void wfc_stop_entry(struct wfc_stop_trace *trace, bool hif, bool d0,
+		    bool no_ack, bool removed)
+{
+	u8 data[28];
+
+	put_unaligned_le32(1, data);
+	put_unaligned_le32(trace->device, data + 4);
+	put_unaligned_le32(trace->caller, data + 8);
+	put_unaligned_le32(hif, data + 12);
+	put_unaligned_le32(d0, data + 16);
+	put_unaligned_le32(no_ack, data + 20);
+	put_unaligned_le32(removed, data + 24);
+	wfc_stop_emit(trace, data, sizeof(data));
+}
+
+void wfc_stop_command(struct wfc_stop_trace *trace, bool owned,
+		      bool attempted, u32 status)
+{
+	u8 data[16];
+
+	put_unaligned_le32(2, data);
+	put_unaligned_le32(owned, data + 4);
+	put_unaligned_le32(attempted, data + 8);
+	put_unaligned_le32(status, data + 12);
+	wfc_stop_emit(trace, data, sizeof(data));
+}
+
+void wfc_stop_read_begin(struct wfc_stop_trace *trace, u32 *output)
+{
+	if (!trace->transaction)
+		return;
+	if (trace->requests == ~0ULL || trace->output || !output) {
+		wfc_stop_fail(trace);
+		return;
+	}
+	trace->requests++;
+	trace->request_dispatch = 0;
+	trace->output = output;
+}
+
+void wfc_stop_dispatch(struct wfc_stop_trace *trace, u32 dispatch)
+{
+	if (!trace || !trace->transaction)
+		return;
+	if (!trace->output || trace->request_dispatch ||
+	    (dispatch != 1 && dispatch != 2)) {
+		wfc_stop_fail(trace);
+		return;
+	}
+	trace->request_dispatch = dispatch;
+	if (!trace->dispatch)
+		trace->dispatch = dispatch;
+	else if (trace->dispatch != dispatch)
+		trace->dispatch = 3;
+}
+
+void wfc_stop_read_done(struct wfc_stop_trace *trace, u32 offset,
+			u32 *output, u32 value)
+{
+	if (!trace || !trace->transaction)
+		return;
+	if (offset || !output || trace->output != output ||
+	    trace->request_dispatch != 1 || trace->last_request == trace->requests ||
+	    trace->completions == ~0ULL) {
+		wfc_stop_fail(trace);
+		return;
+	}
+	trace->completions++;
+	trace->last_request = trace->requests;
+	trace->value = value;
+}
+
+void wfc_stop_read_end(struct wfc_stop_trace *trace, u32 consumed)
+{
+	if (!trace->transaction)
+		return;
+	if (!trace->output || !trace->request_dispatch) {
+		wfc_stop_fail(trace);
+		return;
+	}
+	trace->consumed = consumed;
+	trace->output = NULL;
+}
+
+void wfc_stop_fallback(struct wfc_stop_trace *trace)
+{
+	if (!trace->transaction)
+		return;
+	if (trace->fallbacks == ~0ULL) {
+		wfc_stop_fail(trace);
+		return;
+	}
+	trace->fallbacks++;
+}
+
+void wfc_stop_poll_end(struct wfc_stop_trace *trace, u32 reason)
+{
+	u8 data[56];
+
+	put_unaligned_le32(3, data);
+	put_unaligned_le32(trace->dispatch, data + 4);
+	put_unaligned_le32(reason, data + 8);
+	put_unaligned_le64(trace->requests, data + 12);
+	put_unaligned_le64(trace->completions, data + 20);
+	put_unaligned_le64(trace->last_request, data + 28);
+	put_unaligned_le64(trace->fallbacks, data + 36);
+	put_unaligned_le32(0, data + 44);
+	put_unaligned_le32(trace->value, data + 48);
+	put_unaligned_le32(trace->consumed, data + 52);
+	wfc_stop_emit(trace, data, sizeof(data));
+}
+
+void wfc_stop_return(struct wfc_stop_trace *trace, u32 status)
+{
+	u8 data[8];
+
+	put_unaligned_le32(4, data);
+	put_unaligned_le32(status, data + 4);
+	wfc_stop_emit(trace, data, sizeof(data));
+	trace->transaction = 0;
+}
