@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _HIF_STOP_CAPTURE_H
+#define _HIF_STOP_CAPTURE_H
+
+#include "hif_capture.h"
+
+/* Caller-owned synchronous state; never passed to the queued HIF worker. */
+struct wfc_stop_trace {
+	const struct wfc_dma_trace *binding;
+	u32 transaction;
+	u32 device;
+	u32 caller;
+	u32 dispatch;
+	u32 request_dispatch;
+	u32 value;
+	u32 consumed;
+	u32 *output;
+	u64 requests;
+	u64 completions;
+	u64 last_request;
+	u64 fallbacks;
