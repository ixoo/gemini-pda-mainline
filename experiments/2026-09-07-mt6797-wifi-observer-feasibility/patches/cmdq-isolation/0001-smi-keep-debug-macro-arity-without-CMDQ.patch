From 06da4d5989f2edb520a4ed8d850fe38797fb98b9 Mon Sep 17 00:00:00 2001
From: Gemini experiment archive <archive@example.invalid>
Date: Fri, 25 Sep 2026 15:25:00 -0400
Subject: [PATCH] smi: keep debug macro arity without CMDQ

The SMI debug call sites always pass the CMDQ output selector. Accept
and ignore it when CMDQ is disabled so the headless diagnostic kernel
can compile. CMDQ-enabled behavior is unchanged.

This archive has a synthetic identity and is not an upstream submission.
---
 drivers/misc/mediatek/smi/smi_common.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/misc/mediatek/smi/smi_common.h b/drivers/misc/mediatek/smi/smi_common.h
index c738473..0e3d569 100644
--- a/drivers/misc/mediatek/smi/smi_common.h
+++ b/drivers/misc/mediatek/smi/smi_common.h
@@ -38,7 +38,7 @@
 			SMIMSG(string, ##args);\
 	} while (0)
 #else
-#define SMIMSG3(string, args...) SMIMSG(string, ##args)
+#define SMIMSG3(onoff, string, args...) SMIMSG(string, ##args)
 #endif
 #define SMITMP(string, args...) pr_debug("[pid=%d]"string, current->tgid, ##args)
 
