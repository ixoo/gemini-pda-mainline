#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly PARENT_SOURCE_STATE=6a904f3dbbaf8c7946d6a11c13fe768e16e63db6dd5650f2ad3aa57c8b830209
readonly MTK_SOC_KCONFIG_SHA256=4ea0991f33434492320a4714e0adbbd2cb591f5404ace1ab2b7f7b0877e7675e
readonly MTK_SOC_MAKEFILE_SHA256=6b010c130ed5b28282e3e08a6fd6c562b9f1c3297a6e7031885e2c4317e0f7c9
readonly PARSER_C_SHA256=e173ecad2ed9eaf016a496b84ca411c22ba6d14d2273c55a2a5c40b2d62f80a7
readonly PARSER_H_SHA256=5acd2ab66e3c9a2d0bd0131893e0e22807253241f28ff3018b6405871c920579
readonly GEMINI_DTS_SHA256=78a9f4c22076e48c893697df5dc89a48aba3349d542669e7676aa03bd12aa164

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 3 ]] || die 'expected PROJECT_COMMIT SOURCE_ROOT OUTPUT_ROOT'
readonly project_commit=$1
readonly source_root=$2
readonly output_root=$3
[[ "$project_commit" =~ ^[0-9a-f]{40}$ ]] || die 'invalid project commit'
[[ "$source_root" == /workspace/gemini-pda/src/linux-7.1.3 ]] ||
	die 'unexpected managed source root'
[[ "$output_root" == /workspace/gemini-pda/* ]] || die 'unsafe output root'
[[ -f "$source_root/.gemini-source-state" && ! -L "$source_root/.gemini-source-state" ]] ||
	die 'prepared source state marker absent or unsafe'
[[ "$(<"$source_root/.gemini-source-state")" == "$PARENT_SOURCE_STATE" ]] ||
	die 'prepared parent source state changed'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
experiment_dir="$(cd -- "$script_dir/.." && pwd -P)"
repository_dir="$(cd -- "$experiment_dir/../.." && pwd -P)"
readonly script_dir experiment_dir repository_dir
[[ "$(git -C "$repository_dir" rev-parse HEAD)" == "$project_commit" ]] ||
	die 'project checkout does not match requested commit'
[[ -z "$(git -C "$repository_dir" status --porcelain)" ]] ||
	die 'project checkout is dirty'
for command in git perl python3 sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "missing command: $command"
done
python3 "$repository_dir/scripts/source-tree-integrity" verify "$source_root" |
	grep -E '^source_tree_integrity=[0-9a-f]{64}$' >/dev/null ||
	die 'prepared source integrity verification failed'

check_file() {
	local expected=$1
	local relative=$2
	printf '%s  %s\n' "$expected" "$source_root/$relative" |
		sha256sum --check --status || die "parent source changed: $relative"
}
check_file "$MTK_SOC_KCONFIG_SHA256" drivers/soc/mediatek/Kconfig
check_file "$MTK_SOC_MAKEFILE_SHA256" drivers/soc/mediatek/Makefile
check_file "$PARSER_C_SHA256" drivers/soc/mediatek/mtk-ram-console.c
check_file "$PARSER_H_SHA256" include/linux/soc/mediatek/mtk-ram-console.h
check_file "$GEMINI_DTS_SHA256" arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
[[ ! -e "$source_root/drivers/soc/mediatek/mtk-ram-console-reader.c" ]] ||
	die 'retained ram-console reader source unexpectedly exists'
[[ ! -e "$source_root/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-ram-console.yaml" ]] ||
	die 'retained ram-console binding unexpectedly exists'

readonly work_root=/workspace/gemini-pda/mtk-ram-console-copy-owner-work
readonly package="$output_root/mtk-ram-console-copy-owner-patches-${project_commit:0:12}"
readonly partial="${package}.partial.$$"
mkdir -p "$work_root" "$output_root"
[[ ! -e "$partial" ]] || die 'stale output partial exists'

if [[ -d "$package" && ! -L "$package" ]]; then
	grep -Fx "repository_commit=$project_commit" \
		"$package/provenance/generation.txt" >/dev/null ||
		die 'existing package commit mismatch'
	(cd "$package" && sha256sum --check --strict SHA256SUMS >/dev/null)
	printf 'Generated MTK ram-console copy-owner patch review at %s\n' "$package"
	exit 0
fi
[[ ! -e "$package" ]] || die 'unsafe existing package path'

work="$(mktemp -d "$work_root/generation.XXXXXX")"
readonly work
cleanup() {
	[[ ! -d "$work" || "$work" != "$work_root"/generation.* ]] || rm -rf -- "$work"
	[[ ! -d "$partial" || "$partial" != "$output_root"/*.partial.* ]] || rm -rf -- "$partial"
}
trap cleanup EXIT

mkdir -p "$work/source/drivers/soc/mediatek" \
	"$work/source/include/linux/soc/mediatek" \
	"$work/source/arch/arm64/boot/dts/mediatek"
cp -- "$source_root/drivers/soc/mediatek/Kconfig" \
	"$source_root/drivers/soc/mediatek/Makefile" \
	"$source_root/drivers/soc/mediatek/mtk-ram-console.c" \
	"$work/source/drivers/soc/mediatek/"
cp -- "$source_root/include/linux/soc/mediatek/mtk-ram-console.h" \
	"$work/source/include/linux/soc/mediatek/"
cp -- "$source_root/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts" \
	"$work/source/arch/arm64/boot/dts/mediatek/"
git -C "$work/source" init --quiet
git -C "$work/source" config user.name 'Gemini Mainline Experiment'
git -C "$work/source" config user.email gemini-mainline@example.invalid
git -C "$work/source" add -- arch drivers include
GIT_AUTHOR_DATE=2026-08-21T18:00:00Z \
GIT_COMMITTER_DATE=2026-08-21T18:00:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'MediaTek ram-console copy-owner source parent'
baseline_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly baseline_commit

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --phase binding
git -C "$work/source" add -- Documentation
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T18:01:00Z \
GIT_COMMITTER_DATE=2026-08-21T18:01:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'dt-bindings: soc: mediatek: document retained ram-console' \
		-m 'Describe one optional MT6797 consumer of an exact no-map retained-memory phandle.' \
		-m 'This experiment-only commit has no synthetic DCO sign-off and is not submission-ready.'

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --phase driver
git -C "$work/source" add -- drivers include
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T18:02:00Z \
GIT_COMMITTER_DATE=2026-08-21T18:02:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'soc: mediatek: add retained ram-console copy owner' \
		-m 'Copy one exact reserved-memory region through a transient WB mapping, unmap before parsing, and publish only one typed immutable snapshot.' \
		-m 'Add no reset classifier, secure-epoch authority, A34 caller, hardware write, boot candidate, or device action.'

PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/source_edits.py" \
	--source-root "$work/source" --phase dt
git -C "$work/source" add -- arch
git -C "$work/source" diff --cached --check
GIT_AUTHOR_NAME='Gemini Mainline Experiment' \
GIT_AUTHOR_EMAIL=gemini-mainline@example.invalid \
GIT_COMMITTER_NAME='Gemini Mainline Experiment' \
GIT_COMMITTER_EMAIL=gemini-mainline@example.invalid \
GIT_AUTHOR_DATE=2026-08-21T18:03:00Z \
GIT_COMMITTER_DATE=2026-08-21T18:03:00Z \
	git -C "$work/source" commit --quiet --no-gpg-sign \
		-m 'arm64: dts: mediatek: add Gemini ram-console reader' \
		-m 'Reference the exact existing 64 KiB no-map reservation from a disabled-by-default consumer.' \
		-m 'Enabling and device observation remain separate experiments.'

result_commit="$(git -C "$work/source" rev-parse HEAD)"
readonly result_commit
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/source"
git -C "$work/source" diff --check
[[ -z "$(git -C "$work/source" status --porcelain)" ]] ||
	die 'generated source is dirty'

mkdir -p "$partial/patches" "$partial/provenance"
mapfile -t generated < <(git -C "$work/source" format-patch -3 \
	--no-signature --output-directory "$partial/patches")
[[ "${#generated[@]}" -eq 3 ]] || die 'expected three generated patches'
readonly patch1=0305-dt-bindings-soc-mediatek-document-retained-ram-console.patch
readonly patch2=0306-soc-mediatek-add-retained-ram-console-copy-owner.patch
readonly patch3=0307-arm64-dts-mediatek-add-Gemini-ram-console-reader.patch
mv -- "${generated[0]}" "$partial/patches/$patch1"
mv -- "${generated[1]}" "$partial/patches/$patch2"
mv -- "${generated[2]}" "$partial/patches/$patch3"
printf '%s\n' "$patch1" "$patch2" "$patch3" >"$partial/patches/series"
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_patches.py" \
	--patch-dir "$partial/patches"

git clone --quiet "$work/source" "$work/verify"
git -C "$work/verify" checkout --quiet --detach "$baseline_commit"
git -C "$work/verify" config user.name 'Gemini Mainline Experiment'
git -C "$work/verify" config user.email gemini-mainline@example.invalid
git -C "$work/verify" am --quiet --committer-date-is-author-date \
	"$partial/patches/$patch1" "$partial/patches/$patch2" \
	"$partial/patches/$patch3"
[[ "$(git -C "$work/verify" rev-parse HEAD)" == "$result_commit" ]] ||
	die 'patch replay did not reproduce generated commits'
PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/validate_source.py" \
	--source-root "$work/verify"
[[ -z "$(git -C "$work/verify" status --porcelain)" ]] ||
	die 'verification source is dirty'

for patch in "$patch1" "$patch2" "$patch3"; do
	if ! perl "$source_root/scripts/checkpatch.pl" --no-tree --strict \
		--ignore MISSING_SIGN_OFF,FILE_PATH_CHANGES,COMMIT_LOG_LONG_LINE \
		"$partial/patches/$patch" >>"$partial/provenance/checkpatch.txt"; then
		cat "$partial/provenance/checkpatch.txt" >&2
		die "strict checkpatch rejected $patch"
	fi
done

cat >"$partial/provenance/generation.txt" <<EOF
purpose=experiment-only-mtk-retained-ram-console-copy-owner
repository_commit=$project_commit
parent_source_state=$PARENT_SOURCE_STATE
baseline_commit=$baseline_commit
result_commit=$result_commit
generated_patch_count=3
binding_patch_count=1
driver_patch_count=1
dt_patch_count=1
kunit_case_count=7
physical_map_call_count=1
physical_unmap_call_count=1
copy_attempt_limit=1
dt_default=disabled
raw_export=none
reset_classifier=none
secure_epoch_authority=none
a34_caller=none
opens_owner=false
hardware_write=none
cpu_on=false
cpu_off=false
device_action=none
boot_candidate=false
EOF
printf '%s\n' "$patch1" "$patch2" "$patch3" \
	>"$partial/provenance/patches.txt"
(
	cd "$partial"
	find patches provenance -type f -print0 | sort -z |
		xargs -0 sha256sum >SHA256SUMS
	sha256sum --check --strict SHA256SUMS >/dev/null
)
mv -- "$partial" "$package"
printf 'Generated MTK ram-console copy-owner patch review at %s\n' "$package"
