#!/bin/busybox sh
# shellcheck shell=dash

export PATH=/bin
readonly MARKER='GEMINI_MT6797_KERNEL_RESTART_20260720_AB'

# /dev/null is unavailable before devtmpfs. Keep this first mount unredirected.
if ! mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev; then
	printf '%s devtmpfs=failed; STATIC HOLD\n' "$MARKER"
	while :; do
		sleep 3600
	done
fi

procfs_status=failed
sysfs_status=failed
if mount -t proc -o ro,nosuid,nodev,noexec proc /proc 2>/dev/null; then
	procfs_status=mounted
fi
# Preserve Candidate AD's inherited read-only sysfs view for every existing
# console, keyboard, observation, and USB service.
if mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /sys 2>/dev/null; then
	sysfs_status=mounted-ro
fi

# AF alone uses this second, private writable sysfs mount for its one guarded
# CPU8 hotplug request. Existing services continue to use read-only /sys.
af_sysfs_status=failed
if /bin/busybox mkdir -p /run/af-sys 2>/dev/null && \
	mount -t sysfs -o rw,nosuid,nodev,noexec sysfs /run/af-sys 2>/dev/null; then
	af_sysfs_status=mounted-rw
fi

: >/run/x-status
: >/run/ac-status
/bin/ac-record 'entry profile=usb-gadget-ethernet baseline=candidate-AD storage_access=none runtime_networking=usb0-static'
/bin/x-record 'entry profile=mt6797-kernel-restart cpu_policy=maxcpus-8 candidate=AF cpu8_diagnostic=background'
/bin/x-record "procfs=$procfs_status sysfs=$sysfs_status af_private_sysfs=$af_sysfs_status marker_path=kmsg-console-ramoops"
if [ "$sysfs_status" != mounted-ro ]; then
	/bin/x-record 'diagnostic=invalid reason=sysfs-unavailable; STATIC HOLD'
	while :; do
		sleep 3600
	done
fi
if [ "$af_sysfs_status" != mounted-rw ]; then
	/bin/x-record 'af_private_sysfs=failed cpu8_request=withheld worker_will_fail-closed'
fi

online=unavailable
if [ -r /sys/devices/system/cpu/online ]; then
	online="$(cat /sys/devices/system/cpu/online 2>/dev/null || true)"
fi
/bin/x-record "cpu_online=${online:-unavailable} storage_access=none runtime_networking=usb0-static-10.15.19.82/24 service=nc-2323"

# Retain Candidate AD's console, keyboard, reboot, observation, and USB shell
# services byte-for-byte. Candidate AF adds one independent CPU8 worker as the
# sole userspace owner of /dev/watchdog0.
/bin/x-probe &
/bin/usb-net &
/bin/af-cpu8 &
/bin/x-record 'services=launched probe=independent tty1_shell=supervised clean_tty1_background=yes reboot_dispatch=env-alias watchdog_userspace=af-cpu8-one-ping keyboard_map=tty1-synchronous manual_reboot=busybox-no-sync-force usb_network=background-nc-2323 automatic_reset=watchdog-31s'
/bin/ac-record 'services=launched usb_network=background worker_wait_seconds=30 address=10.15.19.82/24 tcp_port=2323 local_console=unchanged watchdog_userspace=af-cpu8-one-ping'

exec /bin/busybox init
