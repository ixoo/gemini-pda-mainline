#!/bin/busybox sh
# shellcheck shell=dash

readonly MARKER='GEMINI_USB_GADGET_ETHERNET_20260721_AC'
line="$MARKER $*"

printf '%s\n' "$line" >>/run/ac-status 2>/dev/null || true
if [ -c /dev/kmsg ]; then
	printf '<6>%s\n' "$line" >/dev/kmsg 2>/dev/null || true
fi
output=/dev/ttyS0
if [ -c "$output" ]; then
	printf '%s\n' "$line" >"$output" 2>/dev/null || true
fi
