#!/usr/bin/env bash

# The cleanup function is invoked indirectly by the EXIT trap.
# shellcheck disable=SC2317

set -euo pipefail
export LC_ALL=C
export PYTHONDONTWRITEBYTECODE=1
umask 077

readonly PLACEHOLDER_PREFIX=REPLACE_AFTER_CALIBRATION_
readonly AC_RAW_SHA256=REPLACE_AFTER_CALIBRATION_AC_RAW_SHA256
readonly AC_RAW_SIZE=REPLACE_AFTER_CALIBRATION_AC_RAW_SIZE
readonly AC_PADDED_SHA256=REPLACE_AFTER_CALIBRATION_AC_PADDED_SHA256
readonly AC_INNER_INSTALLER_SHA256=REPLACE_AFTER_CALIBRATION_AC_INNER_INSTALLER_SHA256
readonly MATERIALIZER_SHA256=REPLACE_AFTER_CALIBRATION_MATERIALIZER_SHA256
readonly AB_DERIVER_SHA256=REPLACE_AFTER_CALIBRATION_AB_DERIVER_SHA256
readonly AC_DERIVER_SHA256=REPLACE_AFTER_CALIBRATION_AC_DERIVER_SHA256

readonly AA_R1_INSTALLER_SHA256=f081ef03b2dce68d28458eacdcc184a5550c88eeb75579fab61359e936a40f9f
readonly AB_INNER_INSTALLER_SHA256=260c7d907cdd7656b664d71a6564109a6ed03fcb95bf3e5c6da8bcc3bff4050c
readonly AB_RAW_SHA256=61c74592267466735164c19f8b831ea18db2892de95e32109f2aacd7ec5c5446
readonly AB_RAW_SIZE=7378944
readonly AB_PADDED_SHA256=b58c0347d34a3fd9031c74cb03447dd7a6fc630d5b8ea2b7eabc36827e754350

die() { printf 'error: %s\n' "$*" >&2; exit 2; }
usage() {
	cat <<'EOF'
usage: install-candidate-ac-boot2.sh \
  --repo-root DIR \
  --target USER@HOST \
  --candidate FILE \
  --backup-dir DIR

Reconstruct and verify the calibrated Candidate AC guarded installer, then
invoke it with an explicit repository root. The inner installer resolves the
live GPT logical boot2 partition, requires exact hardware-passed Candidate AB
as its predecessor, preserves and verifies a private full backup, writes only
boot2, and requires a matching full readback. It never reboots or selects a
slot.
EOF
}

# This gate precedes repository inspection, temporary-file creation, SSH,
# sudo, device discovery, backup creation, and every hardware write.
calibration_values=(
	AC_RAW_SHA256 AC_RAW_SIZE AC_PADDED_SHA256 AC_INNER_INSTALLER_SHA256
	MATERIALIZER_SHA256 AB_DERIVER_SHA256 AC_DERIVER_SHA256
)
for name in "${calibration_values[@]}"; do
	value=${!name}
	[[ "$value" != "$PLACEHOLDER_PREFIX"* ]] || \
		die "calibration placeholder remains: $name"
done
for name in AC_RAW_SHA256 AC_PADDED_SHA256 AC_INNER_INSTALLER_SHA256 \
	MATERIALIZER_SHA256 AB_DERIVER_SHA256 AC_DERIVER_SHA256 \
	AA_R1_INSTALLER_SHA256 AB_INNER_INSTALLER_SHA256 AB_RAW_SHA256 \
	AB_PADDED_SHA256; do
	value=${!name}
	[[ "$value" =~ ^[0-9a-f]{64}$ ]] || die "invalid calibrated SHA-256: $name"
done
[[ "$AC_RAW_SIZE" =~ ^[1-9][0-9]*$ && "$AC_RAW_SIZE" -le 16777216 ]] || \
	die 'invalid or oversized calibrated AC_RAW_SIZE'
[[ "$AB_RAW_SIZE" == 7378944 ]] || die 'exact Candidate AB raw size changed'
[[ "$AC_RAW_SHA256" != "$AB_RAW_SHA256" ]] || \
	die 'Candidate AC raw identity equals hardware-passed AB'
[[ "$AC_PADDED_SHA256" != "$AB_PADDED_SHA256" ]] || \
	die 'Candidate AC padded identity equals installed AB predecessor'

repo_root=
installer_args=()
while (($#)); do
	case "$1" in
	--repo-root)
		(($# >= 2)) || die '--repo-root requires a value'
		[[ -z "$repo_root" ]] || die '--repo-root was provided more than once'
		repo_root=$2
		shift 2
		;;
	--target|--candidate|--backup-dir)
		(($# >= 2)) || die "$1 requires a value"
		installer_args+=("$1" "$2")
		shift 2
		;;
	-h|--help)
		installer_args+=("$1")
		shift
		;;
	*)
		usage >&2
		die "unknown argument: $1"
		;;
	esac
done
[[ -n "$repo_root" ]] || {
	usage >&2
	die '--repo-root is required'
}
[[ "$repo_root" != *$'\n'* ]] || die 'repository root must be a single-line path'
[[ -d "$repo_root" && ! -L "$repo_root" ]] || \
	die 'repository root is missing or unsafe'
repo_root="$(cd -- "$repo_root" && pwd -P)"
readonly repo_root

materializer="$repo_root/experiments/2026-07-20-mt6797-kernel-restart-diagnostic/scripts/materialize-aa-r1-installer.py"
ab_deriver="$repo_root/experiments/2026-07-20-mt6797-kernel-restart-diagnostic/scripts/derive-installer.py"
ac_deriver="$repo_root/experiments/2026-07-21-usb-gadget-ethernet/scripts/derive-installer.py"
readonly materializer ab_deriver ac_deriver
for input in "$materializer" "$ab_deriver" "$ac_deriver"; do
	[[ -f "$input" && ! -L "$input" ]] || \
		die "installer reconstruction input is missing or unsafe: $input"
done
for command in awk bash mktemp python3 rm sha256sum; do
	command -v "$command" >/dev/null 2>&1 || die "required command missing: $command"
done
[[ "$(sha256sum "$materializer" | awk '{ print $1 }')" == \
	"$MATERIALIZER_SHA256" ]] || die 'AA r1 installer materializer changed'
[[ "$(sha256sum "$ab_deriver" | awk '{ print $1 }')" == \
	"$AB_DERIVER_SHA256" ]] || die 'Candidate AB inner-installer deriver changed'
[[ "$(sha256sum "$ac_deriver" | awk '{ print $1 }')" == \
	"$AC_DERIVER_SHA256" ]] || die 'Candidate AC inner-installer deriver changed'

workdir="$(mktemp -d /tmp/candidate-ac-installer.XXXXXX)"
cleanup() { [[ ! -d "$workdir" ]] || rm -rf -- "$workdir"; }
trap cleanup EXIT

aa_r1_installer="$workdir/install-candidate-aa-r1-boot2.sh"
python3 "$materializer" --output "$aa_r1_installer"
[[ "$(sha256sum "$aa_r1_installer" | awk '{ print $1 }')" == \
	"$AA_R1_INSTALLER_SHA256" ]] || die 'reconstructed AA r1 installer changed'

ab_inner="$workdir/install-candidate-ab-inner-boot2.sh"
python3 "$ab_deriver" --source "$aa_r1_installer" --output "$ab_inner" \
	--raw-sha256 "$AB_RAW_SHA256" --raw-size "$AB_RAW_SIZE" \
	--padded-sha256 "$AB_PADDED_SHA256"
bash -n "$ab_inner" || die 'derived Candidate AB installer failed syntax validation'
[[ "$(sha256sum "$ab_inner" | awk '{ print $1 }')" == \
	"$AB_INNER_INSTALLER_SHA256" ]] || die 'derived Candidate AB installer changed'

ac_inner="$workdir/install-candidate-ac-inner-boot2.sh"
python3 "$ac_deriver" --source "$ab_inner" --output "$ac_inner" \
	--raw-sha256 "$AC_RAW_SHA256" --raw-size "$AC_RAW_SIZE" \
	--padded-sha256 "$AC_PADDED_SHA256"
bash -n "$ac_inner" || die 'derived Candidate AC installer failed syntax validation'
[[ "$(sha256sum "$ac_inner" | awk '{ print $1 }')" == \
	"$AC_INNER_INSTALLER_SHA256" ]] || die 'derived Candidate AC installer changed'

export GEMINI_REPO_ROOT="$repo_root"
set +e
"$ac_inner" "${installer_args[@]}"
status=$?
set -e
exit "$status"
