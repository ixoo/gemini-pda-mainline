From c18c1f09acf191e922e2a07915dcd1849169c562 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 1 Sep 2026 02:09:00 +0000
Subject: [PATCH] soc: mediatek: chain CPU9 after exact CPU8 proof

Extend the one-shot live admission path with a separate CPU9
controller. It runs the unchanged CPU8 controller first, requires
its exact terminal proof, derives and publishes one CPU9
transaction, stages the CPU9 binder, and issues add_cpu(9) once.

Expose combined controller and binder diagnostics while retaining
CPU8/provider/cluster state on every CPU9 failure. Add no CPU_OFF,
retry, watchdog refresh, or repeated cluster effect.
---
 drivers/soc/mediatek/Kconfig                  |  32 +-
 drivers/soc/mediatek/Makefile                 |   2 +
 .../mt6797-a72-admission-controller.c         | 184 +++++++-
 ...7-a72-cpu9-admission-controller-internal.h |  75 ++++
 ...t6797-a72-cpu9-admission-controller-test.c | 408 ++++++++++++++++++
 .../mt6797-a72-cpu9-admission-controller.c    | 160 +++++++
 .../mt6797-a72-cpu9-binder-internal.h         |   3 +
 .../mediatek/mt6797-a72-cpu9-binder-test.c    |  15 +
 drivers/soc/mediatek/mt6797-a72-cpu9-binder.c |  62 +++
 .../soc/mediatek/mt6797-a72-cpu9-binder.h     |  43 ++
 10 files changed, 972 insertions(+), 12 deletions(-)
 create mode 100644 drivers/soc/mediatek/mt6797-a72-cpu9-admission-controller-internal.h
 create mode 100644 drivers/soc/mediatek/mt6797-a72-cpu9-admission-controller-test.c
 create mode 100644 drivers/soc/mediatek/mt6797-a72-cpu9-admission-controller.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index 245395a..fba9bd7 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -589,9 +589,39 @@ config MTK_MT6797_A72_ADMISSION_LIVE_TRIGGER
 
 	  This mode exists so USB/netcat can prove the exact kernel and CPU0-7
 	  baseline before any physical source, publication, or CPU8 request.
-	  CPU9, CPU_OFF, retry, reboot, and storage operations remain absent.
+	  CPU_OFF, retry, reboot, and storage operations remain absent. CPU9
+	  remains absent unless the separate same-boot successor is selected.
 	  If unsure, say N.
 
+config MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER
+	bool "MediaTek MT6797 same-boot CPU9 admission controller"
+	depends on MTK_MT6797_A72_ADMISSION_LIVE_TRIGGER
+	depends on MTK_MT6797_A72_CPU9_BINDER
+	default n
+	help
+	  Extend the exact one-shot userspace admission trigger so it runs the
+	  unchanged CPU8 controller, requires its terminal membership proof,
+	  derives and publishes one retained-cluster CPU9 transaction, stages
+	  the CPU9 binder, and makes one synchronous add_cpu(9) request.
+
+	  CPU8 failure or any missing proof prevents CPU9 derivation and request.
+	  CPU9 failure retains CPU8, P27, the provider, and the cluster until
+	  fixed watchdog recovery. No CPU_OFF, retry, cluster reacquisition,
+	  automatic probe action, or second trigger exists. If unsure, say N.
+
+config MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER_KUNIT_TEST
+	bool "KUnit tests for the MT6797 same-boot CPU9 controller"
+	depends on KUNIT=y
+	depends on MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER
+	default n
+	help
+	  Exercise exact same-task CPU8 proof, CPU9 derive/publish/prepare/request
+	  order, every stop boundary, one-shot closure, and zero CPU_OFF/retry
+	  behavior through injected operations only.
+
+	  No physical CPU, retained-RAM, watchdog, regulator, clock, MMIO, SMC,
+	  storage, reboot, or device action is performed.
+
 config MTK_MT6797_A72_PHYSICAL_SOURCE_KUNIT_TEST
 	bool "KUnit tests for MT6797 A72 direct physical-source observer"
 	depends on KUNIT=y
