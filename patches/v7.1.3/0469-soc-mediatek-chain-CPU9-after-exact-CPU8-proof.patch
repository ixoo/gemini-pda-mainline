+static void mt6797_a72_cpu9_binder_fill_diagnostic(
+	const struct mt6797_a72_cpu9_binder *binder,
+	struct mt6797_a72_cpu9_binder_diagnostic *snapshot)
+{
+	const struct mt6797_a72_cpu9_executor_result *result = &binder->result;
+
+	memset(snapshot, 0, sizeof(*snapshot));
+	snapshot->abi = MT6797_A72_CPU9_BINDER_DIAGNOSTIC_ABI;
+	snapshot->lifecycle = atomic_read_acquire(&binder->executor.lifecycle);
+	snapshot->terminal = result->terminal;
+	snapshot->last_stage = result->last_stage;
+	snapshot->stage_errno = result->stage_errno;
+	snapshot->checkpoint_errno = result->checkpoint_errno;
+	snapshot->attempted = result->attempted;
+	snapshot->cpu_on_accepted = result->cpu_on_accepted;
+	snapshot->membership_published = result->membership_published;
+	snapshot->cpu8_online = result->cpu8_online;
+	snapshot->cpu9_online = result->cpu9_online;
+	snapshot->cpu_requests = result->cpu_requests;
+	snapshot->cpu_off_requests = result->cpu_off_requests;
+	snapshot->retries = result->retries;
+	snapshot->checkpoints = result->checkpoints;
+	snapshot->terminal_commits = result->terminal_commits;
+	snapshot->retained_mask = result->retained_mask;
+	snapshot->prepared = atomic_read_acquire(&binder->prepared);
+	snapshot->boot_claimed = atomic_read_acquire(&binder->boot_claimed);
+	snapshot->cpu8_attempt_id = binder->request.cpu8_attempt_id;
+	snapshot->cpu9_attempt_id = binder->request.cpu9_attempt_id;
+	snapshot->p30e_prepare_attempted = binder->p30e_prepare_attempted;
+	snapshot->p30e_prepare_ret = binder->p30e_prepare_ret;
+	snapshot->p30e_arm_attempted = binder->p30e_arm_attempted;
+	snapshot->p30e_arm_ret = binder->p30e_arm_ret;
+	snapshot->p30e_armed = binder->p30e_armed;
+	snapshot->p30e_readback_attempted = binder->p30e_readback_attempted;
+	snapshot->p30e_readback_ret = binder->p30e_readback_ret;
+}
+
+int mt6797_a72_cpu9_binder_diagnostic_snapshot(
+	struct mt6797_a72_cpu9_binder_diagnostic *snapshot)
+{
+	int ret = 0;
+
+	if (!snapshot)
+		return -EINVAL;
+	memset(snapshot, 0, sizeof(*snapshot));
+	mutex_lock(&mt6797_a72_cpu9_binder_lock);
+	if (atomic_read_acquire(&mt6797_a72_cpu9_binder.prepared))
+		mt6797_a72_cpu9_binder_fill_diagnostic(
+			&mt6797_a72_cpu9_binder, snapshot);
+	else
+		ret = -EAGAIN;
+	mutex_unlock(&mt6797_a72_cpu9_binder_lock);
+	return ret;
+}
