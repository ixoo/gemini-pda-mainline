@@ -59,6 +59,8 @@ obj-$(CONFIG_MTK_MT6797_A72_PLATFORM_SNAPSHOT_OBSERVER) += mt6797-a72-platform-s
 obj-$(CONFIG_MTK_MT6797_A72_PLATFORM_SNAPSHOT_KUNIT_TEST) += mt6797-a72-platform-snapshot-observer-test.o
 obj-$(CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER) += mt6797-a72-physical-source-observer.o
 obj-$(CONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER) += mt6797-a72-admission-controller.o
