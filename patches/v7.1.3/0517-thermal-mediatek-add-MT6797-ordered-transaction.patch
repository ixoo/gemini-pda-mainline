From 40fac3fd87b51c87da5f43cf67561885bb3b1ca6 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 4 Sep 2026 12:11:00 +0000
Subject: [PATCH 1/2] thermal: mediatek: add MT6797 ordered transaction

Use one fail-closed executor for reset, idle, bank commit, first samples, and unwind.

Keep the AUXADC power bit untouched and leave IRQ timeout and DT activation out.
---
 drivers/thermal/mediatek/auxadc_thermal.c     | 490 +++++++++++++++---
 .../mediatek/auxadc_thermal_internal.h        | 187 +++++++
 2 files changed, 603 insertions(+), 74 deletions(-)

diff --git a/drivers/thermal/mediatek/auxadc_thermal.c b/drivers/thermal/mediatek/auxadc_thermal.c
index 4c934ae..67025c5 100644
--- a/drivers/thermal/mediatek/auxadc_thermal.c
+++ b/drivers/thermal/mediatek/auxadc_thermal.c
@@ -18,6 +18,7 @@
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 #include <linux/io.h>
