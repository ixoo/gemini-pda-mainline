+	struct kunit *test)
+{
+	unsigned int failure_call;
+
+	for (failure_call = 1; failure_call <= 8; failure_call++) {
+		struct mt6797_a72_cpu9_executor_request request =
+			mt6797_cpu9_binder_test_request();
