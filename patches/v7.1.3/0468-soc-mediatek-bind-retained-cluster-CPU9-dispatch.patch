+// SPDX-License-Identifier: GPL-2.0-only
+/* Production dispatch adapter for one retained-cluster MT6797 CPU9 transition. */
+
+#include <linux/errno.h>
+#include <linux/gemini_cpu9_transition_ledger.h>
