From 96bf87c1fba526d0538c47ccd1d9ccd3d4b945a9 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 1 Sep 2026 01:09:00 +0000
Subject: [PATCH] soc: mediatek: bind retained-cluster CPU9 dispatch

Add a separate CPU9 binder which maps the hardware-free executor
onto the existing CPU9 P30E slot, standard PSCI CPU_ON, generic
secondary completion, synchronous IPI, CPU9 membership, and the
independent retained ledger.

Keep the proven CPU8 binder unchanged and add no controller,
add_cpu caller, watchdog/cluster effect, CPU_OFF, or retry path.
---
 arch/arm64/kernel/mt6797_a72_membership.c     |  20 +-
 arch/arm64/kernel/mt6797_psci.c               |  25 +-
 drivers/soc/mediatek/Kconfig                  |  30 +
 drivers/soc/mediatek/Makefile                 |   2 +
 .../mt6797-a72-cpu9-binder-internal.h         |  87 +++
 .../mediatek/mt6797-a72-cpu9-binder-test.c    | 605 ++++++++++++++++++
 drivers/soc/mediatek/mt6797-a72-cpu9-binder.c | 590 +++++++++++++++++
 .../soc/mediatek/mt6797-a72-cpu9-binder.h     |  86 +++
 8 files changed, 1442 insertions(+), 3 deletions(-)
 create mode 100644 drivers/soc/mediatek/mt6797-a72-cpu9-binder-internal.h
 create mode 100644 drivers/soc/mediatek/mt6797-a72-cpu9-binder-test.c
 create mode 100644 drivers/soc/mediatek/mt6797-a72-cpu9-binder.c
 create mode 100644 include/linux/soc/mediatek/mt6797-a72-cpu9-binder.h

diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index aef8204..de9bf87 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -1460,6 +1460,7 @@ int mt6797_a72_membership_prepare_p30e_handoff(
 	unsigned long flags;
 	u64 operation;
 	bool cpu8_on_ready;
+	bool cpu9_on_ready;
 	int ret;
 
 	if (!transaction || !ready || !handoff)
@@ -1520,10 +1521,27 @@ int mt6797_a72_membership_prepare_p30e_handoff(
 		a72_owner.provider_state == MT6797_A72_PROVIDER_HELD &&
 		a72_owner.active.provider_acquire_valid &&
 		a72_owner.active.budgets.cpu_on == MT6797_A72_BUDGET_AVAILABLE;
+	cpu9_on_ready = identity->operation ==
+		ARM64_LATE_CPU_STARTUP_OP_CPU9_UP &&
+		a72_owner.phase == MT6797_A72_PHASE_ON_ISSUED &&
+		a72_owner.members == BIT(0) &&
+		a72_owner.provider_state == MT6797_A72_PROVIDER_HELD &&
+		a72_owner.provider_identity.generation &&
+		a72_owner.provider_identity.cookie &&
+		a72_owner.active.p17_p18_published &&
+		a72_owner.active.budgets.cpu_on == MT6797_A72_BUDGET_AVAILABLE &&
+		!a72_owner.active.p27_valid &&
+		!a72_owner.active.provider_acquire_valid &&
+		!a72_owner.active.provider_abort_valid &&
+		!a72_owner.active.p28_valid && !a72_owner.active.p29_valid &&
+		!memcmp(&a72_owner.active.provider_identity,
+			&a72_owner.provider_identity,
+			sizeof(a72_owner.provider_identity));
 	if (a72_owner.health != MT6797_A72_OWNER_AVAILABLE ||
 	    !a72_owner.active.valid || !a72_owner.active.a36_valid ||
 	    !a72_owner.active.p30_token_valid ||
-	    (a72_owner.phase != MT6797_A72_PHASE_FROZEN && !cpu8_on_ready) ||
+	    (a72_owner.phase != MT6797_A72_PHASE_FROZEN &&
+	     !cpu8_on_ready && !cpu9_on_ready) ||
 	    memcmp(&a72_owner.active.identity, identity,
 		   sizeof(a72_owner.active.identity)))
 		ret = -EBUSY;
diff --git a/arch/arm64/kernel/mt6797_psci.c b/arch/arm64/kernel/mt6797_psci.c
index d2899ea..c8011a7 100644
--- a/arch/arm64/kernel/mt6797_psci.c
+++ b/arch/arm64/kernel/mt6797_psci.c
@@ -17,6 +17,7 @@
 #include <linux/printk.h>
 #include <linux/string.h>
 #include <linux/soc/mediatek/mt6797-a72-binder.h>
+#include <linux/soc/mediatek/mt6797-a72-cpu9-binder.h>
 
 #include <asm/cpu_ops.h>
 #include <asm/cpufeature.h>
@@ -1755,8 +1756,11 @@ static int mt6797_psci_cpu_up_preflight(unsigned int cpu,
 	if (!mt6797_psci_is_a72(cpu))
 		return 0;
 
-	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER))
+	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER)) {
+		if (IS_ENABLED(CONFIG_MTK_MT6797_A72_CPU9_BINDER) && cpu == 9)
+			return mt6797_a72_cpu9_binder_preflight(cpu, target);
 		return mt6797_a72_binder_preflight(cpu, target);
+	}
 
 	return mt6797_a72_membership_preflight_up(cpu, target);
 }
@@ -1767,8 +1771,12 @@ static int mt6797_psci_cpu_up_validate(unsigned int cpu, int tasks_frozen,
 	if (!mt6797_psci_is_a72(cpu))
 		return 0;
 
-	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER))
+	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER)) {
+		if (IS_ENABLED(CONFIG_MTK_MT6797_A72_CPU9_BINDER) && cpu == 9)
+			return mt6797_a72_cpu9_binder_validate(
+				cpu, tasks_frozen, target);
 		return mt6797_a72_binder_validate(cpu, tasks_frozen, target);
+	}
 
 	return mt6797_a72_membership_validate_up(cpu, tasks_frozen, target);
 }
@@ -1789,6 +1797,12 @@ static int mt6797_psci_cpu_up_rollback(unsigned int cpu,
 		ret = mt6797_a72_binder_failure(cpu, error, &publish_p32);
 		if (ret || !publish_p32)
 			return ret;
+	} else if (IS_ENABLED(CONFIG_MTK_MT6797_A72_CPU9_BINDER) &&
+		   cpu == 9) {
+		ret = mt6797_a72_cpu9_binder_failure(
+			cpu, error, &publish_p32);
+		if (ret || !publish_p32)
+			return ret;
 	}
 
 	return mt6797_a72_membership_publish_p32(cpu, state, error, trace);
@@ -1831,12 +1845,16 @@ static int mt6797_psci_cpu_kill(unsigned int cpu)
 #ifdef CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER
 static int mt6797_psci_cpu_up_secondary_complete(unsigned int cpu)
 {
+	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_CPU9_BINDER) && cpu == 9)
+		return mt6797_a72_cpu9_binder_secondary_complete(cpu);
 	return mt6797_a72_binder_secondary_complete(cpu);
 }
 
 static int mt6797_psci_cpu_up_complete(unsigned int cpu,
 				       enum cpuhp_state target)
 {
+	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_CPU9_BINDER) && cpu == 9)
+		return mt6797_a72_cpu9_binder_complete(cpu, target);
 	return mt6797_a72_binder_complete(cpu, target);
 }
 #endif
@@ -1845,6 +1863,9 @@ static int mt6797_psci_cpu_boot(unsigned int cpu)
 {
 	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER) && cpu == 8)
 		return mt6797_a72_binder_cpu_boot(cpu, cpu_psci_ops.cpu_boot);
+	if (IS_ENABLED(CONFIG_MTK_MT6797_A72_CPU9_BINDER) && cpu == 9)
+		return mt6797_a72_cpu9_binder_cpu_boot(
+			cpu, cpu_psci_ops.cpu_boot);
 
 	pr_warn_ratelimited("CPU%u boot rejected: A72 power sequence inactive\n",
 			    cpu);
diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index ea4e89a..245395a 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -157,6 +157,36 @@ config MTK_MT6797_A72_CPU9_EXECUTOR_KUNIT_TEST
 	  Tests use injected memory-only callbacks and perform no hardware,
 	  CPU, retained-RAM, watchdog, regulator, clock, or device action.
 
+config MTK_MT6797_A72_CPU9_BINDER
+	bool "MediaTek MT6797 retained-cluster CPU9 dispatch binder"
+	depends on ARM64 && ARCH_MEDIATEK
+	depends on MTK_MT6797_A72_DEFAULT_OFF_BINDER
+	depends on MTK_MT6797_A72_CPU9_EXECUTOR
+	depends on ARM64_MT6797_A72_P30E_WIRE
+	default n
+	help
+	  Bind the separate CPU9 executor to the existing CPU9 P30E slot,
+	  standard PSCI CPU_ON, generic secondary completion, one synchronous
+	  IPI, CPU9 membership, and the independent retained ledger.
+
+	  The proven CPU8 binder remains separate. This option adds PSCI
+	  dispatch adapters but no controller, add_cpu caller, userspace
+	  trigger, watchdog action, cluster effect, CPU_OFF, or retry path.
+	  If unsure, say N.
+
+config MTK_MT6797_A72_CPU9_BINDER_KUNIT_TEST
+	bool "KUnit tests for the MT6797 retained-cluster CPU9 binder"
+	depends on KUNIT=y
+	depends on MTK_MT6797_A72_CPU9_BINDER
+	default n
+	help
+	  Exercise request staging, PSCI-shaped dispatch, exact P30E and
+	  membership sequencing, split completion, terminal mapping, failure
+	  publication, and the absence of CPU_OFF and retry behavior.
+
+	  Tests inject memory-only callbacks and perform no physical CPU,
+	  retained-RAM, watchdog, regulator, clock, or device action.
+
 config MTK_MT6797_A72_DEFAULT_OFF_BINDER
 	bool "MediaTek MT6797 Cortex-A72 default-off transition binder"
 	depends on ARM64 && ARCH_MEDIATEK && OF
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
index 00c31ce..dc65eb4 100644
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -38,6 +38,8 @@ obj-$(CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR) += mt6797-a72-transition.o
 obj-$(CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR_KUNIT_TEST) += mt6797-a72-transition-test.o
 obj-$(CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR) += mt6797-a72-cpu9-executor.o
 obj-$(CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR_KUNIT_TEST) += mt6797-a72-cpu9-executor-test.o
+obj-$(CONFIG_MTK_MT6797_A72_CPU9_BINDER) += mt6797-a72-cpu9-binder.o
+obj-$(CONFIG_MTK_MT6797_A72_CPU9_BINDER_KUNIT_TEST) += mt6797-a72-cpu9-binder-test.o
 obj-$(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER) += mt6797-a72-binder.o
 obj-$(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER_KUNIT_TEST) += mt6797-a72-binder-test.o
 obj-$(CONFIG_MTK_MT6797_A72_PLATFORM_STATE_KUNIT_TEST) += mt6797-a72-platform-state-test.o
diff --git a/drivers/soc/mediatek/mt6797-a72-cpu9-binder-internal.h b/drivers/soc/mediatek/mt6797-a72-cpu9-binder-internal.h
new file mode 100644
index 0000000..6f2eb82
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-a72-cpu9-binder-internal.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MT6797_A72_CPU9_BINDER_INTERNAL_H
+#define __MT6797_A72_CPU9_BINDER_INTERNAL_H
+
+#include <linux/atomic.h>
+#include <linux/cpuhotplug.h>
+#include <linux/smp.h>
+#include <linux/soc/mediatek/mt6797-a72-cpu9-binder.h>
+
+#include <asm/mt6797_a72_membership.h>
+#include <asm/mt6797_a72_p30e.h>
+
+#include "mt6797-a72-cpu9-executor-internal.h"
+
+struct mt6797_a72_cpu9_binder_backend_ops {
+	int (*ledger_begin)(u64 cpu8_attempt_id, u64 cpu9_attempt_id);
+	int (*ledger_checkpoint)(u64 cpu9_attempt_id, u32 phase, u32 stage,
+				 u32 terminal);
+	int (*membership_preflight)(void);
+	int (*membership_claim)(struct mt6797_a72_transaction *transaction);
+	int (*membership_reject)(struct mt6797_a72_transaction *transaction);
+	int (*membership_begin_cpu_on)(
+		struct mt6797_a72_transaction *transaction);
+	int (*p30e_prepare)(const struct mt6797_a72_transaction *transaction,
+			    struct mt6797_a72_p30e_handoff *handoff);
+	int (*p30e_arm)(unsigned int cpu,
+			const struct mt6797_a72_p30e_handoff *handoff);
+	int (*p30e_readback)(unsigned int cpu,
+			     const struct mt6797_a72_p30e_handoff *handoff,
+			     struct arm64_mt6797_a72_p30e_wire *copy);
+	int (*membership_publish_success)(
+		struct mt6797_a72_transaction *transaction);
+	int (*membership_finalize_success)(
+		struct mt6797_a72_transaction *transaction);
+	bool (*cpu_online)(unsigned int cpu);
+	int (*ipi_call)(unsigned int cpu, smp_call_func_t func, void *info,
+			int wait);
+};
+
+struct mt6797_a72_cpu9_binder {
+	const struct mt6797_a72_cpu9_binder_backend_ops *backend;
+	struct mt6797_a72_cpu9_executor_controller executor;
+	struct mt6797_a72_cpu9_executor_request request;
+	struct mt6797_a72_cpu9_executor_result result;
+	struct mt6797_a72_transaction transaction;
+	struct mt6797_a72_p30e_handoff p30e_handoff;
+	struct arm64_mt6797_a72_p30e_wire p30e_snapshot;
+	mt6797_a72_cpu_boot_fn cpu_boot;
+	atomic_t prepared;
+	atomic_t boot_claimed;
+	s32 p30e_prepare_ret;
+	s32 p30e_arm_ret;
+	s32 p30e_readback_ret;
+	bool ledger_begun;
+	bool p30e_prepare_attempted;
+	bool p30e_arm_attempted;
+	bool p30e_armed;
+	bool p30e_readback_attempted;
+};
+
+#if IS_ENABLED(CONFIG_MTK_MT6797_A72_CPU9_BINDER_KUNIT_TEST)
+void mt6797_a72_cpu9_binder_test_init(
+	struct mt6797_a72_cpu9_binder *binder,
+	const struct mt6797_a72_cpu9_binder_backend_ops *backend);
+int mt6797_a72_cpu9_binder_test_prepare(
+	struct mt6797_a72_cpu9_binder *binder,
+	const struct mt6797_a72_cpu9_executor_request *request);
+int mt6797_a72_cpu9_binder_test_preflight(struct mt6797_a72_cpu9_binder *binder,
+					  unsigned int cpu,
+					  enum cpuhp_state target);
+int mt6797_a72_cpu9_binder_test_validate(struct mt6797_a72_cpu9_binder *binder,
+					 unsigned int cpu, int tasks_frozen,
+					 enum cpuhp_state target);
+int mt6797_a72_cpu9_binder_test_boot(struct mt6797_a72_cpu9_binder *binder,
+				     unsigned int cpu,
+				     mt6797_a72_cpu_boot_fn cpu_boot);
+int mt6797_a72_cpu9_binder_test_secondary_complete(
+	struct mt6797_a72_cpu9_binder *binder, unsigned int cpu);
+int mt6797_a72_cpu9_binder_test_complete(struct mt6797_a72_cpu9_binder *binder,
+					 unsigned int cpu,
+					 enum cpuhp_state target);
+int mt6797_a72_cpu9_binder_test_failure(struct mt6797_a72_cpu9_binder *binder,
+					unsigned int cpu, int error,
+					bool *publish_p32);
+#endif
+
+#endif /* __MT6797_A72_CPU9_BINDER_INTERNAL_H */
diff --git a/drivers/soc/mediatek/mt6797-a72-cpu9-binder-test.c b/drivers/soc/mediatek/mt6797-a72-cpu9-binder-test.c
new file mode 100644
index 0000000..77dcf80
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-a72-cpu9-binder-test.c
@@ -0,0 +1,605 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Injected dispatch tests for the retained-cluster MT6797 CPU9 binder. */
+
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/gemini_cpu9_transition_ledger.h>
+#include <linux/gemini_transition_ledger.h>
+#include <linux/module.h>
+
+#include "mt6797-a72-cpu9-binder-internal.h"
+
+enum mt6797_cpu9_binder_test_failure {
+	MT6797_CPU9_BINDER_FAIL_NONE,
+	MT6797_CPU9_BINDER_FAIL_LEDGER_BEGIN,
+	MT6797_CPU9_BINDER_FAIL_PREFLIGHT,
+	MT6797_CPU9_BINDER_FAIL_CLAIM,
+	MT6797_CPU9_BINDER_FAIL_P30E_PREPARE,
+	MT6797_CPU9_BINDER_FAIL_CPU_ON_BEGIN,
+	MT6797_CPU9_BINDER_FAIL_P30E_ARM,
+	MT6797_CPU9_BINDER_FAIL_CPU_BOOT,
+	MT6797_CPU9_BINDER_FAIL_P30E_READBACK,
+	MT6797_CPU9_BINDER_FAIL_IPI,
+	MT6797_CPU9_BINDER_FAIL_PUBLISH,
+	MT6797_CPU9_BINDER_FAIL_FINALIZE,
+};
+
+struct mt6797_cpu9_binder_test_state {
+	enum mt6797_cpu9_binder_test_failure failure;
+	struct mt6797_a72_transaction transaction;
+	bool cpu8_online;
+	bool cpu9_online;
+	unsigned int ledger_begin_calls;
+	unsigned int ledger_checkpoint_calls;
+	unsigned int preflight_calls;
+	unsigned int claim_calls;
+	unsigned int reject_calls;
+	unsigned int cpu_on_begin_calls;
+	unsigned int p30e_prepare_calls;
+	unsigned int p30e_arm_calls;
+	unsigned int cpu_boot_calls;
+	unsigned int p30e_readback_calls;
+	unsigned int ipi_calls;
+	unsigned int publish_calls;
+	unsigned int finalize_calls;
+	u64 cpu8_attempt_id;
+	u64 cpu9_attempt_id;
+	u32 terminal_phase;
+	u32 terminal_stage;
+	u32 terminal_value;
+};
+
+static struct mt6797_cpu9_binder_test_state *mt6797_cpu9_binder_test_active;
+
+static int mt6797_cpu9_binder_test_ledger_begin(u64 cpu8_attempt_id,
+						u64 cpu9_attempt_id)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	state->ledger_begin_calls++;
+	state->cpu8_attempt_id = cpu8_attempt_id;
+	state->cpu9_attempt_id = cpu9_attempt_id;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_LEDGER_BEGIN ? -EIO :
+									0;
+}
+
+static int mt6797_cpu9_binder_test_ledger_checkpoint(u64 cpu9_attempt_id,
+						     u32 phase, u32 stage,
+						     u32 terminal)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	state->ledger_checkpoint_calls++;
+	if (phase == GEMINI_TRANSITION_LEDGER_TERMINAL) {
+		state->terminal_phase = phase;
+		state->terminal_stage = stage;
+		state->terminal_value = terminal;
+	}
+	return cpu9_attempt_id == state->cpu9_attempt_id ? 0 : -EPROTO;
+}
+
+static int mt6797_cpu9_binder_test_membership_preflight(void)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	state->preflight_calls++;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_PREFLIGHT ? -EIO : 0;
+}
+
+static int mt6797_cpu9_binder_test_membership_claim(
+	struct mt6797_a72_transaction *transaction)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	state->claim_calls++;
+	if (state->failure == MT6797_CPU9_BINDER_FAIL_CLAIM)
+		return -EIO;
+	*transaction = state->transaction;
+	return 0;
+}
+
+static int mt6797_cpu9_binder_test_membership_reject(
+	struct mt6797_a72_transaction *transaction)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	(void)transaction;
+	state->reject_calls++;
+	return 0;
+}
+
+static int mt6797_cpu9_binder_test_membership_begin_cpu_on(
+	struct mt6797_a72_transaction *transaction)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	(void)transaction;
+	state->cpu_on_begin_calls++;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_CPU_ON_BEGIN ? -EIO :
+									0;
+}
+
+static int mt6797_cpu9_binder_test_p30e_prepare(
+	const struct mt6797_a72_transaction *transaction,
+	struct mt6797_a72_p30e_handoff *handoff)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	(void)transaction;
+	state->p30e_prepare_calls++;
+	if (state->failure == MT6797_CPU9_BINDER_FAIL_P30E_PREPARE)
+		return -EIO;
+	handoff->target_cpu = MT6797_A72_CPU9_EXECUTOR_CPU9;
+	handoff->operation = ARM64_MT6797_A72_P30E_OPERATION_CPU9_UP;
+	return 0;
+}
+
+static int
+mt6797_cpu9_binder_test_p30e_arm(unsigned int cpu,
+				 const struct mt6797_a72_p30e_handoff *handoff)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	state->p30e_arm_calls++;
+	if (cpu != MT6797_A72_CPU9_EXECUTOR_CPU9 ||
+	    handoff->target_cpu != cpu ||
+	    handoff->operation != ARM64_MT6797_A72_P30E_OPERATION_CPU9_UP)
+		return -EPROTO;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_P30E_ARM ? -EIO : 0;
+}
+
+static int mt6797_cpu9_binder_test_p30e_readback(
+	unsigned int cpu, const struct mt6797_a72_p30e_handoff *handoff,
+	struct arm64_mt6797_a72_p30e_wire *copy)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	(void)copy;
+	state->p30e_readback_calls++;
+	if (cpu != MT6797_A72_CPU9_EXECUTOR_CPU9 || handoff->target_cpu != cpu)
+		return -EPROTO;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_P30E_READBACK ? -EIO :
+									 0;
+}
+
+static int mt6797_cpu9_binder_test_membership_publish(
+	struct mt6797_a72_transaction *transaction)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	(void)transaction;
+	state->publish_calls++;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_PUBLISH ? -EIO : 0;
+}
+
+static int mt6797_cpu9_binder_test_membership_finalize(
+	struct mt6797_a72_transaction *transaction)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	(void)transaction;
+	state->finalize_calls++;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_FINALIZE ? -EIO : 0;
+}
+
+static bool mt6797_cpu9_binder_test_cpu_online(unsigned int cpu)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	return cpu == MT6797_A72_CPU9_EXECUTOR_CPU8 ?
+		       state->cpu8_online :
+		       cpu == MT6797_A72_CPU9_EXECUTOR_CPU9 &&
+			       state->cpu9_online;
+}
+
+static int mt6797_cpu9_binder_test_ipi_call(unsigned int cpu,
+					    smp_call_func_t func, void *info,
+					    int wait)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	state->ipi_calls++;
+	if (cpu != MT6797_A72_CPU9_EXECUTOR_CPU9 || !func || !wait)
+		return -EPROTO;
+	func(info);
+	return state->failure == MT6797_CPU9_BINDER_FAIL_IPI ? -EIO : 0;
+}
+
+static int mt6797_cpu9_binder_test_cpu_boot(unsigned int cpu)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	state->cpu_boot_calls++;
+	if (cpu != MT6797_A72_CPU9_EXECUTOR_CPU9)
+		return -EPROTO;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_CPU_BOOT ? -EIO : 0;
+}
