From e9e0eeb2dc6f0c32a15cdbc21b9a34fd5b97c519 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 1 Sep 2026 20:11:00 +0000
Subject: [PATCH] pstore: add Gemini CPU9 pre-ledger progress

Add a third-record, exact-empty-only retained progress lane for
the unresolved CPU8-proof-to-CPU9-ledger boundary. Reuse the
proven two-copy CRC wire and require exact CPU8 terminal proof
before the first bounded progress commit.

Expose no production caller or CPU, CPU_OFF, retry, watchdog,
cluster, reset, storage, or boot action.
---
 fs/pstore/Kconfig                             |  28 +++
 fs/pstore/Makefile                            |   2 +
 fs/pstore/gemini_cpu9_progress_ledger.c       | 237 ++++++++++++++++++
 .../gemini_cpu9_progress_ledger_internal.h    |  23 ++
 fs/pstore/gemini_cpu9_progress_ledger_test.c  | 200 +++++++++++++++
 include/linux/gemini_cpu9_progress_ledger.h   |  37 +++
 6 files changed, 527 insertions(+)
 create mode 100644 fs/pstore/gemini_cpu9_progress_ledger.c
 create mode 100644 fs/pstore/gemini_cpu9_progress_ledger_internal.h
 create mode 100644 fs/pstore/gemini_cpu9_progress_ledger_test.c
 create mode 100644 include/linux/gemini_cpu9_progress_ledger.h

diff --git a/fs/pstore/Kconfig b/fs/pstore/Kconfig
index 3257394..8c90d88 100644
--- a/fs/pstore/Kconfig
+++ b/fs/pstore/Kconfig
@@ -482,6 +482,34 @@ config PSTORE_GEMINI_CPU9_TRANSITION_LEDGER
 	  watchdog action, SMC, cluster-power action, or boot policy. If
 	  unsure, say N.
 
+config PSTORE_GEMINI_CPU9_PROGRESS_LEDGER
+	bool "Gemini CPU9 pre-ledger progress ledger"
+	depends on PSTORE_GEMINI_CPU9_TRANSITION_LEDGER=y
+	default n
+	help
+	  Add one bounded mutable progress lane in the third exact Gemini
+	  ramoops dmesg record. It first requires the exact CRC-valid CPU8
+	  online terminal in record 0 and an exact logical-empty progress lane.
+
+	  Ten ordered boundaries use the existing alternating two-copy CRC
+	  wire. At most 20 record commits and 202 32-bit writes occur in the
+	  one owned record. The owner never clears, repairs, retries, or accepts
+	  a nonempty predecessor. This option adds no production caller, CPU
+	  request, watchdog, SMC, cluster effect, reset, storage, or boot policy.
+
+config PSTORE_GEMINI_CPU9_PROGRESS_LEDGER_KUNIT_TEST
+	bool "KUnit tests for the Gemini CPU9 progress ledger"
+	depends on KUNIT=y
+	depends on PSTORE_GEMINI_CPU9_PROGRESS_LEDGER=y
+	default n
+	help
+	  Test exact CPU8 proof, logical-empty ownership, all ten ordered
+	  boundaries, attempt binding, write bound, and refusal of replay,
+	  malformed, raw, or committed progress lanes in injected word arrays.
+
+	  No retained RAM, MMIO, CPU request, watchdog, SMC, regulator, clock,
+	  storage, reset, reboot, or device action is performed.
+
 config PSTORE_GEMINI_CPU9_TRANSITION_LEDGER_KUNIT_TEST
 	bool "KUnit tests for the Gemini CPU9 transition ledger"
 	depends on KUNIT=y
