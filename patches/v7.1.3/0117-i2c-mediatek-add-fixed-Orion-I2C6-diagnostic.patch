From 4938c640bea11c6113589dabc32acb61a01e9823 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 27 Jul 2026 14:50:29 -0400
Subject: [PATCH 117/117] i2c: mediatek: add fixed Orion I2C6 diagnostic

Add an experiment-only, root-only debugfs command for the exact
access-controlled MT6797 iDVFS instance. The one-shot command accepts
only a fixed token and performs nine fixed pointer-only reads at address
0x69.

Run packed-length FIFO first, then packed-length DMA and auxiliary-length
DMA. Serialize the run with the root-adapter lock, require a childless
and otherwise unused adapter, and reset both the controller and APDMA
before each mode.

Temporarily disable adapter retries while the bus is locked so each
sample represents exactly one physical transfer. Record the value before
and during the run, restore it on every transfer exit, and record the
restored value.

Stop at the first transport error. Retain bounded controller and I2C6
APDMA-channel state without exposing DMA addresses or arbitrary bus
controls.

---
 drivers/i2c/busses/Kconfig      |  12 +
 drivers/i2c/busses/i2c-mt65xx.c | 479 ++++++++++++++++++++++++++++++++
 2 files changed, 491 insertions(+)

diff --git a/drivers/i2c/busses/Kconfig b/drivers/i2c/busses/Kconfig
index 8c935f8..6ab257c 100644
--- a/drivers/i2c/busses/Kconfig
+++ b/drivers/i2c/busses/Kconfig
@@ -904,6 +904,18 @@ config I2C_MT65XX
 	  If you want to use MediaTek(R) I2C interface, say Y or M here.
 	  If unsure, say N.
 
+config I2C_MT65XX_ORION_DIAGNOSTIC
+	bool "MT6797 I2C6 fixed Orion diagnostic"
+	depends on I2C_MT65XX=y && DEBUG_FS
+	help
+	  Enable the experiment-only, one-shot Orion diagnostic for the
+	  access-controlled MT6797 iDVFS I2C instance. The root-only debugfs
+	  file accepts exactly "run" followed by a newline and performs a
+	  fixed sequence of pointer-only reads from address 0x69. It exposes
+	  no arbitrary address, register, data, length, or mode control.
+
+	  Say N outside the named Gemini Orion experiment.
+
 config I2C_MT7621
 	tristate "MT7621/MT7628 I2C Controller"
 	depends on (RALINK && (SOC_MT7620 || SOC_MT7621)) || ARCH_AIROHA || COMPILE_TEST
