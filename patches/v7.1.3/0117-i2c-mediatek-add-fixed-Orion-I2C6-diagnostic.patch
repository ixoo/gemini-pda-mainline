 				const struct i2c_msg *msgs)
 {
@@ -1130,6 +1295,7 @@ static int mtk_i2c_complete_pio(struct mtk_i2c *i2c,
 	rx_msg = i2c->op == I2C_MASTER_WRRD ? msgs + 1 : msgs;
