From 635109d07472c4e20960d567fe1ef89d2850c15e Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sat, 5 Sep 2026 02:00:00 +0000
Subject: [PATCH 1/1] arm64: bind Gemini thermal snapshot configuration

Accept the exact thermal snapshot config-input identity only under the explicitly enabled thermal observer. Preserve the previously accepted frequency observer and physical lifecycle configurations.
---
 arch/arm64/kernel/mt6797_psci.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/kernel/mt6797_psci.c b/arch/arm64/kernel/mt6797_psci.c
index 25348fa..bf0d0cd 100644
--- a/arch/arm64/kernel/mt6797_psci.c
+++ b/arch/arm64/kernel/mt6797_psci.c
@@ -67,10 +67,17 @@ static const u64 mt6797_a72_config_input_identity[ARM64_LATE_CPU_ID_WORDS] __ini
 #else
 #if IS_ENABLED(CONFIG_MTK_MT6797_A72_HOTPLUG_BINDING)
 #if IS_ENABLED(CONFIG_MTK_MT6797_A72_FREQUENCY_OBSERVER)
+#if IS_ENABLED(CONFIG_MTK_SOC_THERMAL_OBSERVER)
+static const u64 mt6797_a72_config_input_identity[ARM64_LATE_CPU_ID_WORDS] __initconst = {
+	0x8fe1675a22f82e9e, 0xfbc38a994a95eaae,
+	0xb32fbc46b6fad425, 0x61f3e01d3097b3a5,
+};
+#else
 static const u64 mt6797_a72_config_input_identity[ARM64_LATE_CPU_ID_WORDS] __initconst = {
 	0x18ded825be6993a5, 0xa403f8cd526e3682,
 	0x199cc55afce876f3, 0x6b7f194faced0b25,
 };
+#endif
 #else
 static const u64 mt6797_a72_config_input_identity[ARM64_LATE_CPU_ID_WORDS] __initconst = {
 	0x2e50cc09d2241006, 0xd819eeb0ed4151fb,
