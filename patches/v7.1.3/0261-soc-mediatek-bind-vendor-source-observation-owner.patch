From 0000000000000000000000000000000000000261 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 11 Aug 2026 01:10:00 -0400
Subject: [PATCH] soc: mediatek: bind vendor source observation to owner

Extend the experiment-only vendor integration boundary with a pinned,
read-only source registration and invalidate the source before forwarding
vendor lifecycle events. The owner supplies a runtime adapter context so a
source snapshot cannot survive a CPU or power transition. Identity remains
fail-closed.

Also admit the observation transaction site and model the CCI CSPM record as
having no physical limit word, matching the existing mainline decoder.
---
 drivers/soc/mediatek/mt6797-dvfsp-vendor-owner-test.c | 31 ++++++++++
 drivers/soc/mediatek/mt6797-dvfsp-vendor-owner.c      | 91 ++++++++++++++++++--
 include/linux/soc/mediatek/mt6797-dvfsp-vendor-owner.h |  6 +-
 include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h |  1 +
 drivers/soc/mediatek/mt6797-dvfsp-vendor-source.c     |  9 +-
 5 files changed, 128 insertions(+), 10 deletions(-)

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-vendor-owner.h b/include/linux/soc/mediatek/mt6797-dvfsp-vendor-owner.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-vendor-owner.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-vendor-owner.h
@@ -4,5 +4,6 @@
 #include <linux/types.h>
 
 #include <linux/soc/mediatek/mt6797-dvfsp-calibrated-provider.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-vendor-source.h>
 #include <linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h>
 #include <linux/soc/mediatek/mt6797-dvfsp-vendor-writer-bridge.h>
@@ -39,3 +39,3 @@ struct mt6797_dvfsp_vendor_owner_lifecycle_ops {
 };
 
-#define MT6797_DVFSP_VENDOR_INTEGRATION_ABI	1
+#define MT6797_DVFSP_VENDOR_INTEGRATION_ABI	2
@@ -61,5 +62,6 @@ struct mt6797_dvfsp_vendor_integration_ops {
 	int (*unregister_mainline_owner)(void *context, const void *bridge_ops,
 		void *bridge_context, const void *runtime_ops,
 		void *runtime_context, u64 owner_handle,
 		u64 transition_handle);
+	const void *source_registration;
 };
@@ -111,3 +113,4 @@ struct mt6797_dvfsp_vendor_owner {
 	struct mt6797_dvfsp_vendor_writer writer;
 	struct mt6797_dvfsp_vendor_writer_bridge writer_bridge;
+	struct mt6797_dvfsp_vendor_source source;
 	const struct mt6797_dvfsp_vendor_runtime_ops *writer_runtime_ops;
diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h b/include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h
@@ -45,5 +45,6 @@ enum mt6797_dvfsp_vendor_writer_site_id {
 	MT6797_DVFSP_VENDOR_WRITER_SITE_PTP_TABLE = 0,
 	MT6797_DVFSP_VENDOR_WRITER_SITE_VOLTAGE,
 	MT6797_DVFSP_VENDOR_WRITER_SITE_PPM,
+	MT6797_DVFSP_VENDOR_WRITER_SITE_OBSERVE,
 	MT6797_DVFSP_VENDOR_WRITER_SITE_COUNT,
 };
diff --git a/drivers/soc/mediatek/mt6797-dvfsp-vendor-source.c b/drivers/soc/mediatek/mt6797-dvfsp-vendor-source.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-vendor-source.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-vendor-source.c
@@ -263,8 +263,13 @@ static int mt6797_dvfsp_vendor_source_table_check(
 		const struct mt6797_dvfsp_vendor_source_cspm_cluster *cluster =
 			&snapshot->cspm[i];
 
-		if (cluster->is_on > 1 || !cluster->volt || !cluster->vsram ||
-			!cluster->ceiling || !cluster->floor ||
-			cluster->floor > cluster->ceiling)
+		if (cluster->is_on > 1 || !cluster->volt || !cluster->vsram)
+			return -EPROTO;
+		if (i < MT6797_DVFSP_VENDOR_SOURCE_MAX_CLUSTER &&
+		    (!cluster->ceiling || !cluster->floor ||
+		     cluster->floor > cluster->ceiling))
+			return -EPROTO;
+		if (i == MT6797_DVFSP_VENDOR_SOURCE_MAX_CLUSTER &&
+		    (cluster->ceiling || cluster->floor))
 			return -EPROTO;
 	}
diff --git a/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner.c b/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner.c
@@ -73,7 +73,7 @@ static int mt6797_dvfsp_vendor_owner_integration_ops_check(
 	if (!ops || ops->abi != MT6797_DVFSP_VENDOR_INTEGRATION_ABI ||
 	    !ops->bind_lifecycle || !ops->unbind_lifecycle ||
 	    !ops->register_mainline_owner ||
-	    !ops->unregister_mainline_owner)
+	    !ops->unregister_mainline_owner || !ops->source_registration)
 		return -EINVAL;
 	return 0;
 }
@@ -84,3 +85,23 @@ static const struct mt6797_dvfsp_vendor_writer_registration_ops
 static const struct mt6797_dvfsp_vendor_owner_lifecycle_ops
 	mt6797_dvfsp_vendor_owner_integration_lifecycle_ops;
 
+static int mt6797_dvfsp_vendor_owner_runtime_event(
+	void *context, unsigned int type, unsigned int cpu)
+{
+	struct mt6797_dvfsp_vendor_owner *owner = context;
+
+	if (!owner || !owner->writer_integration_bound ||
+	    !owner->source.initialized || !owner->ops.writer_runtime_ops ||
+	    !owner->ops.writer_runtime_ops->event)
+		return -ENODEV;
+	mt6797_dvfsp_vendor_source_invalidate(&owner->source);
+	return owner->ops.writer_runtime_ops->event(
+		owner->ops.writer_runtime_context, type, cpu);
+}
+
+static const struct mt6797_dvfsp_vendor_runtime_ops
+mt6797_dvfsp_vendor_owner_runtime_adapter_ops = {
+	.abi = MT6797_DVFSP_VENDOR_RUNTIME_EVENT_ABI,
+	.event = mt6797_dvfsp_vendor_owner_runtime_event,
+};
+
@@ -105,8 +124,8 @@ static int mt6797_dvfsp_vendor_owner_integration_register_owner(
 	    owner->ops.writer_registration_context != owner ||
 	    !owner->writer_integration_ops ||
 	    bridge_ops != mt6797_dvfsp_vendor_writer_bridge_ops() ||
 	    bridge_context != &owner->writer_bridge ||
-	    runtime_ops != owner->ops.writer_runtime_ops ||
-	    runtime_context != owner->ops.writer_runtime_context ||
+	    runtime_ops != &mt6797_dvfsp_vendor_owner_runtime_adapter_ops ||
+	    runtime_context != owner ||
 	    owner_handle != owner->owner_handle ||
 	    transition_handle != owner->transition_handle)
@@ -134,8 +153,8 @@ static int mt6797_dvfsp_vendor_owner_integration_unregister_owner(
 	    owner->ops.writer_registration_context != owner ||
 	    !owner->writer_integration_ops ||
 	    bridge_ops != mt6797_dvfsp_vendor_writer_bridge_ops() ||
 	    bridge_context != &owner->writer_bridge ||
-	    runtime_ops != owner->writer_runtime_ops ||
-	    runtime_context != owner->writer_runtime_context ||
+	    runtime_ops != &mt6797_dvfsp_vendor_owner_runtime_adapter_ops ||
+	    runtime_context != owner ||
 	    owner_handle != owner->owner_handle ||
 	    transition_handle != owner->transition_handle)
@@ -185,4 +204,5 @@ int mt6797_dvfsp_vendor_owner_bind_writer_integration(
 	const struct mt6797_dvfsp_vendor_integration_ops *integration_ops,
 	void *integration_context)
 {
+	const struct mt6797_dvfsp_vendor_source_registration *source_registration;
 	int ret;
@@ -205,6 +225,17 @@ int mt6797_dvfsp_vendor_owner_bind_writer_integration(
 	if (!owner->ops.writer_runtime_context)
 		return -EINVAL;
+	source_registration = integration_ops->source_registration;
+	if (!source_registration || !source_registration->ops ||
+	    !source_registration->context)
+		return -EINVAL;
 	ret = mt6797_dvfsp_vendor_writer_bridge_init(&owner->writer_bridge,
 		&owner->writer);
 	if (ret)
 		return ret;
+	ret = mt6797_dvfsp_vendor_source_init(&owner->source,
+		source_registration->ops, source_registration->context,
+		owner->owner_handle, owner->transition_handle);
+	if (ret) {
+		memset(&owner->writer_bridge, 0, sizeof(owner->writer_bridge));
+		return ret;
+	}
@@ -220,5 +251,5 @@ int mt6797_dvfsp_vendor_owner_bind_writer_integration(
 	ret = integration_ops->bind_lifecycle(integration_context,
 		mt6797_dvfsp_vendor_writer_bridge_ops(), &owner->writer_bridge,
-		owner->ops.writer_runtime_ops, owner->ops.writer_runtime_context,
+		&mt6797_dvfsp_vendor_owner_runtime_adapter_ops, owner,
 		&mt6797_dvfsp_vendor_owner_integration_lifecycle_ops, owner,
 		owner->owner_handle, owner->transition_handle);
@@ -226,3 +257,4 @@ int mt6797_dvfsp_vendor_owner_bind_writer_integration(
 		owner->ops.writer_registration_ops = NULL;
 		owner->ops.writer_registration_context = NULL;
+		mt6797_dvfsp_vendor_source_exit(&owner->source);
 		memset(&owner->writer_bridge, 0, sizeof(owner->writer_bridge));
@@ -250,5 +282,5 @@ int mt6797_dvfsp_vendor_owner_unbind_writer_integration(
 	ret = integration_ops->unbind_lifecycle(owner->writer_integration_context,
 		mt6797_dvfsp_vendor_writer_bridge_ops(), &owner->writer_bridge,
-		owner->ops.writer_runtime_ops, owner->ops.writer_runtime_context,
+		&mt6797_dvfsp_vendor_owner_runtime_adapter_ops, owner,
 		&mt6797_dvfsp_vendor_owner_integration_lifecycle_ops, owner,
 		owner->owner_handle, owner->transition_handle);
@@ -265,3 +297,4 @@ int mt6797_dvfsp_vendor_owner_unbind_writer_integration(
 	owner->ops.writer_registration_ops = NULL;
 	owner->ops.writer_registration_context = NULL;
+	mt6797_dvfsp_vendor_source_exit(&owner->source);
 	memset(&owner->writer_bridge, 0, sizeof(owner->writer_bridge));
@@ -393,5 +426,5 @@ int mt6797_dvfsp_vendor_owner_register_writer(
 	ops = owner->ops.writer_registration_ops;
 	if (!ops)
 		return -EOPNOTSUPP;
-	runtime_ops = owner->ops.writer_runtime_ops;
-	runtime_context = owner->ops.writer_runtime_context;
+	runtime_ops = &mt6797_dvfsp_vendor_owner_runtime_adapter_ops;
+	runtime_context = owner;
@@ -449,1 +482,1 @@
-	if (owner->writer_registered)
+	if (owner->writer_registered || owner->writer_integration_bound)
diff --git a/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner-test.c b/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner-test.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner-test.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-vendor-owner-test.c
@@ -8,5 +8,8 @@
 #include <linux/types.h>
 
 #include <linux/soc/mediatek/mt6797-dvfsp-vendor-owner.h>
 
+static const struct mt6797_dvfsp_vendor_source_registration
+mt6797_dvfsp_vendor_test_source_registration;
 
 struct mt6797_dvfsp_vendor_test_devices {
@@ -377,3 +377,29 @@ static const struct mt6797_dvfsp_vendor_integration_ops
 	.unregister_mainline_owner =
 		mt6797_dvfsp_vendor_test_integration_unregister_mainline,
+	.source_registration = &mt6797_dvfsp_vendor_test_source_registration,
 };
+static int mt6797_dvfsp_vendor_test_source_snapshot(
+	void *context, struct mt6797_dvfsp_vendor_source_snapshot *snapshot)
+{
+	return -EOPNOTSUPP;
+}
+
+static int mt6797_dvfsp_vendor_test_source_identity(
+	void *context, struct mt6797_dvfsp_vendor_source_identity *identity)
+{
+	return -EOPNOTSUPP;
+}
+
+static const struct mt6797_dvfsp_vendor_source_ops
+mt6797_dvfsp_vendor_test_source_ops = {
+	.abi = MT6797_DVFSP_VENDOR_SOURCE_ABI,
+	.snapshot = mt6797_dvfsp_vendor_test_source_snapshot,
+	.read_identity = mt6797_dvfsp_vendor_test_source_identity,
+};
+
+static unsigned int mt6797_dvfsp_vendor_test_source_context;
+static const struct mt6797_dvfsp_vendor_source_registration
+mt6797_dvfsp_vendor_test_source_registration = {
+	.ops = &mt6797_dvfsp_vendor_test_source_ops,
+	.context = &mt6797_dvfsp_vendor_test_source_context,
+};
@@ -544,6 +563,12 @@ static void mt6797_dvfsp_vendor_owner_integrates_lifecycle(
 	KUNIT_EXPECT_EQ(test, integration.register_calls, 1U);
 	KUNIT_EXPECT_PTR_EQ(test, integration.bridge_ops,
 		mt6797_dvfsp_vendor_writer_bridge_ops());
-	KUNIT_EXPECT_PTR_EQ(test, integration.runtime_ops,
-		&mt6797_dvfsp_vendor_test_runtime_ops);
-	KUNIT_EXPECT_PTR_EQ(test, integration.runtime_context, &registration);
+	KUNIT_EXPECT_PTR_EQ(test, integration.runtime_context, &owner);
+	KUNIT_EXPECT_TRUE(test, owner.source.initialized);
+	KUNIT_ASSERT_EQ(test,
+		((const struct mt6797_dvfsp_vendor_runtime_ops *)
+		 integration.runtime_ops)->event(integration.runtime_context,
+		 MT6797_DVFSP_VENDOR_RUNTIME_CPU_ONLINE,
+		 MT6797_DVFSP_VENDOR_RUNTIME_CPU_NONE), 0);
+	KUNIT_EXPECT_TRUE(test, owner.source.invalidated);
+	KUNIT_EXPECT_EQ(test, registration.runtime_event_calls, 1U);
@@ -569,3 +591,4 @@ static void mt6797_dvfsp_vendor_owner_integrates_lifecycle(
 	KUNIT_EXPECT_FALSE(test, integration.bound);
 	KUNIT_EXPECT_EQ(test, integration.unbind_calls, 1U);
+	KUNIT_EXPECT_FALSE(test, owner.source.initialized);
 	KUNIT_ASSERT_EQ(test, mt6797_dvfsp_vendor_owner_unbind(&owner), 0);
