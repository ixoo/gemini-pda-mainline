 	int ret;
 
-	if (!owner || !handoff || !ptp_state || !readback || !input ||
+	if (!owner || !handoff || !ptp_state || !ppm || !policy ||
+	    !readback || !input ||
 	    !owner->source_ops || !owner->source_ops->read_identity ||
 	    !owner->source_ops->fill_calibration)
@@ -136,6 +139,6 @@ static int mt6797_dvfsp_owner_fill_calibration(
 		return ret;
 
 	ret = owner->source_ops->fill_calibration(owner->source_context,
-			handoff, ptp_state, readback, &identity, input);
+			handoff, ptp_state, ppm, policy, readback, &identity, input);
 	if (ret)
 		return ret;
@@ -146,2 +149,5 @@ static int mt6797_dvfsp_owner_fill_calibration(
 	    input->provenance.calibration_handle)
 		return -EPROTO;
+	ret = mt6797_dvfsp_ppm_policy_validate(policy);
+	if (ret)
+		return ret;

diff --git a/drivers/thermal/mediatek/auxadc_thermal.c b/drivers/thermal/mediatek/auxadc_thermal.c
--- a/drivers/thermal/mediatek/auxadc_thermal.c
+++ b/drivers/thermal/mediatek/auxadc_thermal.c
@@ -1180,6 +1180,6 @@ static int mt6797_eem_calibration_ppm_check(
 	unsigned int bank_index;
 	int ret;
 
-	if (!input || !input->ppm_snapshot)
+	if (!input || !input->ppm_snapshot || !input->ppm_policy)
 		return -EINVAL;
 	ret = mt6797_dvfsp_ppm_snapshot_validate(input->ppm_snapshot);
@@ -1189,6 +1189,21 @@ static int mt6797_eem_calibration_ppm_check(
 		input->ppm_snapshot->table_epoch)
 		return -EAGAIN;
+	ret = mt6797_dvfsp_ppm_policy_validate(input->ppm_policy);
+	if (ret)
+		return ret;
+	if (input->provenance.table_epoch != input->ppm_policy->table_epoch)
+		return -EAGAIN;
+	for (bank_index = 0;
+	     bank_index < MT6797_DVFSP_PPM_POLICY_BANK_COUNT; bank_index++) {
+		unsigned int row;
+
+		for (row = 0; row < MT6797_DVFSP_PPM_POLICY_TABLE_ENTRIES; row++)
+			if (input->frequency_khz[bank_index][row] !=
+				    input->ppm_policy->frequency_khz[bank_index][row] ||
+			    input->ppm_limit_khz[bank_index][row] !=
+				    input->ppm_policy->limit_khz[bank_index][row])
+				return -EAGAIN;
+	}
 
 	for (bank_index = 0;
 	     bank_index < MT6797_DVFSP_PPM_CLUSTER_COUNT; bank_index++) {
