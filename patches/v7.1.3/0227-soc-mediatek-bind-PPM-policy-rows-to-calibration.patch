 drivers/soc/mediatek/mt6797-dvfsp-ppm-policy.c |  79 ++++++++++++++++
 drivers/soc/mediatek/mt6797-dvfsp-state-owner-source.c |  22 +++-
 drivers/soc/mediatek/mt6797-dvfsp-state-source.c |  10 +-
 drivers/thermal/mediatek/auxadc_thermal.c      |  18 ++++
 include/linux/soc/mediatek/mt6797-dvfsp-ppm-policy.h |  38 +++++++
 include/linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h |  8 +-
 include/linux/soc/mediatek/mt6797-dvfsp-state-source.h |  6 +-
 include/linux/soc/mediatek/mt6797-eem-calibration.h |  2 +
 9 files changed, 173 insertions(+), 10 deletions(-)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-ppm-policy.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-ppm-policy.h

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-ppm-policy.h b/include/linux/soc/mediatek/mt6797-dvfsp-ppm-policy.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-ppm-policy.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_MEDIATEK_MT6797_DVFSP_PPM_POLICY_H
+#define __LINUX_SOC_MEDIATEK_MT6797_DVFSP_PPM_POLICY_H
+
+#include <linux/types.h>
+
+#define MT6797_DVFSP_PPM_POLICY_ABI		1
+#define MT6797_DVFSP_PPM_POLICY_BANK_COUNT	4
+#define MT6797_DVFSP_PPM_POLICY_TABLE_ENTRIES	16
+#define MT6797_DVFSP_PPM_POLICY_BANK_BIG	0
+#define MT6797_DVFSP_PPM_POLICY_BANK_L		1
+#define MT6797_DVFSP_PPM_POLICY_BANK_2L	2
+#define MT6797_DVFSP_PPM_POLICY_BANK_CCI	3
+
+/*
+ * Provider-owned PPM policy rows in EEM's packed bank order. The CCI bank
+ * is intentional: the vendor three-cluster snapshot has no CCI limit table,
+ * so a provider must supply this row set rather than infer one.
+ */
+struct mt6797_dvfsp_ppm_policy_snapshot {
+	u32 abi;
+	u32 reserved;
+	u64 table_epoch;
+	u32 frequency_khz[MT6797_DVFSP_PPM_POLICY_BANK_COUNT]
+		[MT6797_DVFSP_PPM_POLICY_TABLE_ENTRIES];
+	u32 limit_khz[MT6797_DVFSP_PPM_POLICY_BANK_COUNT]
+		[MT6797_DVFSP_PPM_POLICY_TABLE_ENTRIES];
+};
+
+int mt6797_dvfsp_ppm_policy_validate(
+	const struct mt6797_dvfsp_ppm_policy_snapshot *policy);
+
+#endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_PPM_POLICY_H */

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-ppm-policy.c b/drivers/soc/mediatek/mt6797-dvfsp-ppm-policy.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-dvfsp-ppm-policy.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Validate provider-owned MT6797 PPM policy rows.
+ *
+ * This object contains no vendor transport and performs no I/O. A real
+ * provider must copy all four banks, including CCI, while holding the PPM
+ * policy lock and the external clock/rail transition lock.
+ */
+
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-ppm-policy.h>
+
+static int mt6797_dvfsp_ppm_policy_bank_check(
+	const struct mt6797_dvfsp_ppm_policy_snapshot *policy,
+	u32 bank)
+{
+	u32 previous_frequency = ~0U;
+	u32 row;
+
+	for (row = 0; row < MT6797_DVFSP_PPM_POLICY_TABLE_ENTRIES; row++) {
+		if (!policy->frequency_khz[bank][row] ||
+		    policy->frequency_khz[bank][row] >= previous_frequency ||
+		    !policy->limit_khz[bank][row])
+			return -EPROTO;
+		previous_frequency = policy->frequency_khz[bank][row];
+	}
+
+	return 0;
+}
+
+int mt6797_dvfsp_ppm_policy_validate(
+	const struct mt6797_dvfsp_ppm_policy_snapshot *policy)
+{
+	u32 bank;
+	int ret;
+
+	if (!policy || policy->abi != MT6797_DVFSP_PPM_POLICY_ABI ||
+	    policy->reserved || !policy->table_epoch)
+		return -EPROTO;
+
+	for (bank = 0; bank < MT6797_DVFSP_PPM_POLICY_BANK_COUNT; bank++) {
+		ret = mt6797_dvfsp_ppm_policy_bank_check(policy, bank);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_ppm_policy_validate);
+
+MODULE_DESCRIPTION("MT6797 provider-owned PPM policy contract");
+MODULE_LICENSE("GPL");

diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
