From 469633cd25f74d0335bbba3c542f18206a2b76f9 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Wed, 2 Sep 2026 02:41:00 +0000
Subject: [PATCH] arm64: mediatek: avoid CPU9 membership-begin lock recursion

The CPU9 CPU_ON substage ledger proves P30E preparation returns
and membership begin is entered but does not return. The binder
runs inside _cpu_up() while the generic CPU-hotplug write lock is
already held, so the ordinary helper recursively takes its read
side before the existing owner state transition.

Add a lock-held membership-begin entry point that asserts the
contract and calls the existing state transition directly. Keep
the ordinary lock-taking helper unchanged for other contexts.

This changes no CPU request, CPU_OFF, retry, cluster, reset, or
storage path.
---
 arch/arm64/include/asm/mt6797_a72_membership.h | 1 +
 arch/arm64/kernel/mt6797_a72_membership.c      | 7 +++++++
 drivers/soc/mediatek/mt6797-a72-cpu9-binder.c  | 2 +-
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/include/asm/mt6797_a72_membership.h b/arch/arm64/include/asm/mt6797_a72_membership.h
index cbc9768..d3a360a 100644
--- a/arch/arm64/include/asm/mt6797_a72_membership.h
+++ b/arch/arm64/include/asm/mt6797_a72_membership.h
@@ -777,6 +777,7 @@ int mt6797_a72_membership_claim_cpu9(struct mt6797_a72_transaction *transaction)
 int mt6797_a72_claim_cpu9_locked(struct mt6797_a72_transaction *transaction);
 int mt6797_a72_membership_reject_cpu9(struct mt6797_a72_transaction *transaction);
 int mt6797_a72_membership_begin_cpu9_on(struct mt6797_a72_transaction *transaction);
+int mt6797_a72_begin_cpu9_on_locked(struct mt6797_a72_transaction *transaction);
 int mt6797_a72_membership_publish_cpu9_success(struct mt6797_a72_transaction *transaction);
 int mt6797_a72_membership_finalize_cpu9_success(struct mt6797_a72_transaction *transaction);
 #endif
diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index d9b43ba..177bde1 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -2981,6 +2981,13 @@ mt6797_a72_begin_cpu9_on_state(struct mt6797_a72_transaction *transaction,
 	return ret;
 }
 
+int mt6797_a72_begin_cpu9_on_locked(struct mt6797_a72_transaction *transaction)
+{
+	lockdep_assert_cpus_held();
+	return mt6797_a72_begin_cpu9_on_state(transaction,
+					     cpu_online(8), cpu_online(9));
+}
+
 int mt6797_a72_membership_begin_cpu9_on(struct mt6797_a72_transaction *transaction)
 {
 	int ret;
diff --git a/drivers/soc/mediatek/mt6797-a72-cpu9-binder.c b/drivers/soc/mediatek/mt6797-a72-cpu9-binder.c
index 71bdaa6..6949426 100644
--- a/drivers/soc/mediatek/mt6797-a72-cpu9-binder.c
+++ b/drivers/soc/mediatek/mt6797-a72-cpu9-binder.c
@@ -151,7 +151,7 @@ static const struct mt6797_a72_cpu9_binder_backend_ops
 		.membership_preflight = mt6797_a72_membership_preflight_cpu9,
 		.membership_claim = mt6797_a72_claim_cpu9_locked,
 		.membership_reject = mt6797_a72_membership_reject_cpu9,
-		.membership_begin_cpu_on = mt6797_a72_membership_begin_cpu9_on,
+		.membership_begin_cpu_on = mt6797_a72_begin_cpu9_on_locked,
 		.p30e_prepare = mt6797_a72_cpu9_binder_p30e_prepare,
 		.p30e_arm = mt6797_a72_cpu9_binder_p30e_arm,
 		.p30e_readback = mt6797_a72_cpu9_binder_p30e_readback,
