From df6eac17f242f69d0f8406eb8332334524d94333 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 21 Aug 2026 18:02:00 +0000
Subject: [PATCH 2/4] dt-bindings: mediatek: add MT6797 A72 state source

Describe the named MCUCFG and CCI resources, SPM syscon, and TOPRGU PWRAP reset consumed by the default-off read-only source.
---
 .../mediatek,mt6797-a72-platform-state.yaml   | 62 +++++++++++++++++++
 1 file changed, 62 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-state.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-state.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-state.yaml
new file mode 100644
index 0000000..d6ed823
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-state.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-a72-platform-state.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 Cortex-A72 platform-state source
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description: |
+  The MT6797 Cortex-A72 cluster uses SoC-specific SPM, TOPRGU, MCUCFG, and an
+  additional CCI port. This node describes a read-only snapshot source for
+  those resources. It does not control power or CCI state and does not provide
+  serialization against PSCI operations.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-a72-platform-state
+
+  reg:
+    minItems: 2
+    maxItems: 2
+
+  reg-names:
+    items:
+      - const: mcucfg
+      - const: cci
+
+  mediatek,spm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the MT6797 SPM syscon.
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: pwrap
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - mediatek,spm
+  - resets
+  - reset-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/reset/mt6797-resets.h>
+
+    platform-state@10222000 {
+        compatible = "mediatek,mt6797-a72-platform-state";
+        reg = <0x10222000 0x1000>, <0x10390000 0x10000>;
+        reg-names = "mcucfg", "cci";
+        mediatek,spm = <&scpsys>;
+        resets = <&watchdog MT6797_TOPRGU_PWRAP_SPI_CTL_RST>;
+        reset-names = "pwrap";
+    };
