From 5eb582611a1bd703e909d304ed4dc0dcd1d03f6a Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 21 Aug 2026 18:03:00 +0000
Subject: [PATCH 3/3] arm64: dts: mediatek: add Gemini ram-console reader

Reference the exact existing 64 KiB no-map reservation from a disabled-by-default consumer.

Enabling and device observation remain separate experiments.
---
 arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
index 75d34c5..59d4f73 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -49,6 +49,12 @@
 		reg = <0 0x40000000 1 0>;
 	};
 
+	ram-console {
+		compatible = "mediatek,mt6797-ram-console";
+		memory-region = <&ram_console_reserved>;
+		status = "disabled";
+	};
+
 	reserved-memory {
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -59,7 +65,7 @@
 			no-map;
 		};
 
-		memory@44400000 {
+		ram_console_reserved: memory@44400000 {
 			reg = <0 0x44400000 0 0x10000>;
 			no-map;
 		};
