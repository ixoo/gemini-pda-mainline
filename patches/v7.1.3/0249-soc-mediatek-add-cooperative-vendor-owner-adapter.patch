 drivers/soc/mediatek/mt6797-dvfsp-vendor-owner.c                  | 105 +++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-vendor-owner.h            |  49 ++++
 6 files changed, 410 insertions(+)
