+++ b/arch/arm64/kernel/mt6797_psci.c
@@ -66,10 +66,17 @@ static const u64 mt6797_a72_config_input_identity[ARM64_LATE_CPU_ID_WORDS] __ini
 };
 #else
 #if IS_ENABLED(CONFIG_MTK_MT6797_A72_HOTPLUG_BINDING)
