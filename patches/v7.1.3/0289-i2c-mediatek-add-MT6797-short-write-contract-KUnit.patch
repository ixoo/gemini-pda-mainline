From b0c1e3c4f0ac5ebb59aaf8a7ae1ac379e18c9c19 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Wed, 19 Aug 2026 12:02:00 +0000
Subject: [PATCH 2/2] i2c: mediatek: add MT6797 short-write contract KUnit

Execute the production helpers with sentinel bytes and fake state.

Cover exact completion, every failure class, and one-call EAGAIN.

Register no adapter, client, MMIO range, runtime trigger, or device.
---
 drivers/i2c/busses/Kconfig                    |  13 +
 drivers/i2c/busses/Makefile                   |   1 +
 .../i2c/busses/i2c-mt65xx-gemini-write-test.c | 333 ++++++++++++++++++
 3 files changed, 347 insertions(+)
 create mode 100644 drivers/i2c/busses/i2c-mt65xx-gemini-write-test.c

diff --git a/drivers/i2c/busses/Kconfig b/drivers/i2c/busses/Kconfig
index d87aa01..3f0c26d 100644
--- a/drivers/i2c/busses/Kconfig
+++ b/drivers/i2c/busses/Kconfig
@@ -972,6 +972,19 @@ config I2C_MT65XX_GEMINI_ENTRY_LEDGER
 	  regulator consumer, or CPU action, and is intended only for the named
 	  Gemini Gate-6 attribution experiment. Say N otherwise.
 
+config I2C_MT65XX_GEMINI_WRITE_TRANSPORT_KUNIT_TEST
+	bool "KUnit tests for the MT6797 I2C6 short-write contract"
+	depends on KUNIT=y
+	depends on I2C_MT65XX=y
+	help
+	  Exercise the production-coupled MT6797 iDVFS one-message two-byte
+	  FIFO plan, completion classes, no-retry wrapper, and transfer-lease
+	  result precedence with an in-memory fake adapter.
+
+	  The suite registers no adapter or client, maps no MMIO, writes no
+	  START register, performs no physical transfer, and is only for the
+	  hardware-free Gemini Gate-6 B2 experiment. Say N otherwise.
+
 config I2C_MT7621
 	tristate "MT7621/MT7628 I2C Controller"
 	depends on (RALINK && (SOC_MT7620 || SOC_MT7621)) || ARCH_AIROHA || COMPILE_TEST
