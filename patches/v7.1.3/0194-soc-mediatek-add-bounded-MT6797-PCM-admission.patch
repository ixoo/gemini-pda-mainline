+	if (hold_active && phase_before_fault >=
+	    MT6797_DVFSP_PCM_PHASE_RESOURCES_HELD)
+		ops->teardown(handoff->pcm_adapter_context,
+			      &handoff->pcm_adapter_identity,
+			      phase_before_fault);
