+	mutex_lock(&handoff->pcm_adapter_lock);
+	ops = handoff->pcm_adapter_ops;
+	if (!ops || handoff->pcm_adapter_phase !=
+	    MT6797_DVFSP_PCM_PHASE_LEASE_REGISTERED) {
+		ret = -EHOSTDOWN;
+		goto out_unlock;
