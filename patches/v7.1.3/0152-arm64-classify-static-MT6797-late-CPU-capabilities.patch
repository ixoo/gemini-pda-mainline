+static bool __init
+mt6797_a72_bitmap_exact(const unsigned long *bitmap, const u16 *caps,
+			unsigned int count)
+{
+	unsigned int i;
+
+	if (bitmap_weight(bitmap, ARM64_NCAPS) != count)
+		return false;
+	for (i = 0; i < count; i++)
+		if (!test_bit(caps[i], bitmap))
+			return false;
+
+	return true;
+}
