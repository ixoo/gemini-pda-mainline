From 17092dc7227bc9f061e6024b842ff3e7010a83b0 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 27 Aug 2026 11:01:00 +0000
Subject: [PATCH 1/2] arm64: add CPU-up lifecycle completion bridge

Add no-op operation hooks at secondary and full CPUHP completion
and split the injected MT6797 executor at those boundaries.
---
 arch/arm64/include/asm/cpu_ops.h              |   7 +
 arch/arm64/kernel/smp.c                       |  28 +++
 .../mediatek/mt6797-a72-transition-internal.h |  39 +++-
 .../soc/mediatek/mt6797-a72-transition-test.c |  14 +-
 drivers/soc/mediatek/mt6797-a72-transition.c  | 190 +++++++++++++++---
 include/linux/cpu.h                           |   2 +
 kernel/cpu.c                                  |  17 ++
 7 files changed, 258 insertions(+), 39 deletions(-)

diff --git a/arch/arm64/include/asm/cpu_ops.h b/arch/arm64/include/asm/cpu_ops.h
index 3e96667..6292f87 100644
--- a/arch/arm64/include/asm/cpu_ops.h
+++ b/arch/arm64/include/asm/cpu_ops.h
@@ -30,6 +30,10 @@ struct cpu_up_rollback_trace;
  *		outer transition locks.
  * @cpu_up_rollback: Optional controller-side publication before generic CPUHP
  *		outer rollback. It receives the failing callback state, result, and trace.
+ * @cpu_up_secondary_complete: Optional controller callback immediately after
+ *		a successful architecture secondary completion.
+ * @cpu_up_complete: Optional controller callback after the full requested
+ *		generic CPUHP target completes.
  * @cpu_boot:	Boots a cpu into the kernel.
  * @cpu_postboot: Optionally, perform any post-boot cleanup or necessary
  *		synchronisation. Called from the cpu being booted.
@@ -52,6 +56,9 @@ struct cpu_operations {
 					   enum cpuhp_state target);
 	int		(*cpu_up_rollback)(unsigned int cpu, enum cpuhp_state state,
 					   int error, const struct cpu_up_rollback_trace *trace);
+	int		(*cpu_up_secondary_complete)(unsigned int cpu);
+	int		(*cpu_up_complete)(unsigned int cpu,
+					   enum cpuhp_state target);
 	int		(*cpu_boot)(unsigned int);
 	void		(*cpu_postboot)(void);
 #ifdef CONFIG_HOTPLUG_CPU
diff --git a/arch/arm64/kernel/smp.c b/arch/arm64/kernel/smp.c
index 3e0144f..4554476 100644
--- a/arch/arm64/kernel/smp.c
+++ b/arch/arm64/kernel/smp.c
@@ -127,6 +127,34 @@ int arch_cpu_up_validate(unsigned int cpu, int tasks_frozen,
 	return 0;
 }
 
+int arch_cpu_up_secondary_complete(unsigned int cpu)
+{
+	const struct cpu_operations *ops;
+
+	if (cpu >= nr_cpu_ids)
+		return 0;
+
+	ops = get_cpu_ops(cpu);
+	if (ops && ops->cpu_up_secondary_complete)
+		return ops->cpu_up_secondary_complete(cpu);
+
+	return 0;
+}
+
+int arch_cpu_up_complete(unsigned int cpu, enum cpuhp_state target)
+{
+	const struct cpu_operations *ops;
+
+	if (cpu >= nr_cpu_ids)
+		return 0;
+
+	ops = get_cpu_ops(cpu);
+	if (ops && ops->cpu_up_complete)
+		return ops->cpu_up_complete(cpu, target);
+
+	return 0;
+}
+
 int arch_cpu_up_rollback(unsigned int cpu, enum cpuhp_state state, int error,
 				 const struct cpu_up_rollback_trace *trace)
 {
diff --git a/drivers/soc/mediatek/mt6797-a72-transition-internal.h b/drivers/soc/mediatek/mt6797-a72-transition-internal.h
index 37da196..bbb3ba1 100644
--- a/drivers/soc/mediatek/mt6797-a72-transition-internal.h
+++ b/drivers/soc/mediatek/mt6797-a72-transition-internal.h
@@ -8,7 +8,6 @@
 
 #define MT6797_A72_TRANSITION_CPU8 8U
 #define MT6797_A72_TRANSITION_CPU9 9U
-#define MT6797_A72_TRANSITION_CPU_ON_WAIT_MS 10000U
 #define MT6797_A72_TRANSITION_RECOVERY_MS 15000U
 
 #define MT6797_A72_TRANSITION_OWNED_P27 BIT(0)
@@ -43,12 +42,24 @@ enum mt6797_a72_transition_terminal {
 	MT6797_A72_TRANSITION_CPU8_ONLINE_PROOF,
 };
 
+enum mt6797_a72_transition_lifecycle {
+	MT6797_A72_TRANSITION_LIFECYCLE_IDLE,
+	MT6797_A72_TRANSITION_LIFECYCLE_STARTING,
+	MT6797_A72_TRANSITION_LIFECYCLE_CPU_ON_ACCEPTED,
+	MT6797_A72_TRANSITION_LIFECYCLE_SECONDARY_INFLIGHT,
+	MT6797_A72_TRANSITION_LIFECYCLE_SECONDARY_COMPLETE,
+	MT6797_A72_TRANSITION_LIFECYCLE_FINAL_INFLIGHT,
+	MT6797_A72_TRANSITION_LIFECYCLE_TERMINAL,
+};
+
 struct mt6797_a72_transition_controller {
 	atomic_t consumed;
+	atomic_t lifecycle;
 };
 
 #define MT6797_A72_TRANSITION_CONTROLLER_INIT \
-	{ .consumed = ATOMIC_INIT(0) }
+	{ .consumed = ATOMIC_INIT(0), \
+	  .lifecycle = ATOMIC_INIT(MT6797_A72_TRANSITION_LIFECYCLE_IDLE) }
 
 struct mt6797_a72_transition_request {
 	unsigned int cpu;
@@ -67,6 +78,7 @@ struct mt6797_a72_transition_result {
 	bool watchdog_armed;
 	bool isolation_attempted;
 	bool isolation_crossed;
+	bool cpu_on_accepted;
 	bool p27_owned;
 	bool provider_owned;
 	bool cpu8_online;
@@ -94,12 +106,31 @@ struct mt6797_a72_transition_ops {
 	int (*isolation_clear)(void *context);
 	int (*sram_enable)(void *context);
 	int (*cpu_on)(void *context, unsigned int cpu);
-	int (*online_wait)(void *context, unsigned int cpu,
-			   unsigned int timeout_ms);
+	int (*secondary_complete)(void *context, unsigned int cpu);
 	int (*ipi_proof)(void *context, unsigned int cpu);
 	int (*dcm_update)(void *context);
 };
 
+int mt6797_a72_transition_begin(struct mt6797_a72_transition_controller *controller,
+				const struct mt6797_a72_transition_ops *ops,
+				void *context,
+				const struct mt6797_a72_transition_request *request,
+				struct mt6797_a72_transition_result *result);
+int mt6797_a72_transition_secondary_complete(struct mt6797_a72_transition_controller *controller,
+					     const struct mt6797_a72_transition_ops *ops,
+					     void *context, unsigned int cpu,
+					     bool cpu8_online, bool cpu9_online,
+					     struct mt6797_a72_transition_result *result);
+int mt6797_a72_transition_complete(struct mt6797_a72_transition_controller *controller,
+				   const struct mt6797_a72_transition_ops *ops,
+				   void *context, unsigned int cpu,
+				   bool cpu8_online, bool cpu9_online,
+				   struct mt6797_a72_transition_result *result);
+int mt6797_a72_transition_fail(struct mt6797_a72_transition_controller *controller,
+			       const struct mt6797_a72_transition_ops *ops,
+			       void *context, unsigned int cpu,
+			       bool cpu8_online, bool cpu9_online, int error,
+			       struct mt6797_a72_transition_result *result);
 int mt6797_a72_transition_run(struct mt6797_a72_transition_controller *controller,
 			      const struct mt6797_a72_transition_ops *ops,
 			      void *context,
