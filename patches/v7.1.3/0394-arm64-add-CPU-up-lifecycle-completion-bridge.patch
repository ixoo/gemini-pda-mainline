+		mt6797_a72_transition_checkpoint(ops, context, result,
+						 MT6797_A72_TRANSITION_BEFORE,
+						 MT6797_A72_TRANSITION_STAGE_ONLINE_WAIT);
+	return mt6797_a72_transition_postiso_fault(controller, result, error);
