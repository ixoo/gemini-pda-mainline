From 369ba0f889cba4161e2905b38f051b41e7eb4b7a Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 20 Aug 2026 23:01:00 +0000
Subject: [PATCH] arm64: add A72 A34 eligibility evaluator

Evaluate only an immutable exact-zero tuple carrying explicit platform or external reset provenance and owner-safe private replay-zero proof.

Add no production caller or state mutation; keep the owner, admission, provider, P27/P28, P30, CPU_ON, CPU_OFF, and device effects closed.
---
 arch/arm64/Kconfig                            |  15 ++
 arch/arm64/Kconfig.platforms                  |  12 ++
 .../arm64/include/asm/mt6797_a72_membership.h |  61 +++++-
 arch/arm64/kernel/Makefile                    |   1 +
 .../kernel/mt6797_a72_a34_evaluator_test.c    | 183 ++++++++++++++++++
 arch/arm64/kernel/mt6797_a72_membership.c     |  53 +++++
 6 files changed, 323 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm64/kernel/mt6797_a72_a34_evaluator_test.c

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 5d4f026..604f25e 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2570,6 +2570,21 @@ config ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST
 	  publish or mutate P30, or make a CPU_ON transaction reachable. They
 	  also cover the read-only public and internal admission checks.
 
+config ARM64_MT6797_A72_A34_ELIGIBILITY_KUNIT_TEST
+	bool "KUnit tests for the MT6797 A72 A34 eligibility evaluator"
+	depends on KUNIT=y
+	depends on HOTPLUG_CPU
+	depends on ARM64_MT6797_A72_P30_PROTOCOL_MODEL
+	select ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
+	select ARM64_MT6797_A72_P24_ADMISSION_HOOKS
+	select ARM64_MT6797_A72_P24_OWNER_TEST_SEED
+	select ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR
+	help
+	  Exercise both accepted reset-provenance values, null input, every
+	  byte mutation, explicit missing provenance, and unchanged CLOSED
+	  admission without hardware or CPU operations. The suite has no
+	  production hook.
+
 config ARM64_MT6797_A72_PROVIDER_OWNER
 	bool "MT6797 A72 provider-owner callback boundary"
 	depends on ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 6165ad6..4542beb 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -223,6 +223,18 @@ config ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
 	  opener. It rejects before P31/A38, allocates no token, and cannot issue
 	  CPU_ON.
 
+config ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR
+	bool "Evaluate the exact MT6797 A72 A34 zero-state tuple"
+	depends on ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
+	help
+	  Add a pure, default-off evaluator for the frozen A34 tuple. Its
+	  immutable input must carry explicit platform/external-reset
+	  provenance and owner-safe private replay-zero proof.
+
+	  This option has no production caller and cannot open the owner,
+	  initialize an attempt, call a provider, perform a hardware effect,
+	  arm P30, or issue CPU_ON or CPU_OFF.
+
 config ARM64_MT6797_A72_P24_ADMISSION_HOOKS
 	bool "Install closed MT6797 A72 CPU-up admission hooks"
 	depends on ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
diff --git a/arch/arm64/include/asm/mt6797_a72_membership.h b/arch/arm64/include/asm/mt6797_a72_membership.h
index b5e6cbe..2928da1 100644
--- a/arch/arm64/include/asm/mt6797_a72_membership.h
+++ b/arch/arm64/include/asm/mt6797_a72_membership.h
@@ -18,11 +18,15 @@
  * token only in an explicitly opened test state; A36 only validates an
  * immutable caller-supplied prestate record. A dormant P17/P18 ledger may
  * advance only the C phase to ON_ISSUED. The explicitly isolated provider
- * callback seam can return a read-only refusal, but it has no bootstrap,
- * CPUHP effect, P30 handoff, P14/P15, hardware mutation, or CPU_ON operation.
+ * callback seam can return a read-only refusal. A default-off A34 pure
+ * evaluator has no production caller and cannot bootstrap the owner, perform
+ * a CPUHP effect, hand off P30, mutate hardware, or issue CPU_ON.
  */
 #define MT6797_A72_TRANSACTION_ABI 2
 #define MT6797_A72_OPERATION_SLOTS 4
+#define MT6797_A72_A34_ELIGIBILITY_ABI 1
+#define MT6797_A72_A34_FIRST_GENERATION 1ULL
+#define MT6797_A72_A34_FIRST_COOKIE 0xa7200001ULL
 
 enum mt6797_a72_owner_health {
 	MT6797_A72_OWNER_CLOSED,
@@ -475,6 +479,59 @@ struct mt6797_a72_owner_snapshot {
 	u32 controller_present;
 };
 
+enum mt6797_a72_a34_reset_provenance {
+	MT6797_A72_A34_RESET_UNKNOWN,
+	MT6797_A72_A34_RESET_PLATFORM,
+	MT6797_A72_A34_RESET_EXTERNAL,
+	MT6797_A72_A34_RESET_ORDINARY_LINUX,
+};
+
+enum mt6797_a72_a34_private_replay_proof {
+	MT6797_A72_A34_PRIVATE_REPLAY_UNKNOWN,
+	MT6797_A72_A34_PRIVATE_REPLAY_OWNER_SAFE_ZERO,
+};
+
+struct mt6797_a72_a34_observation {
+	u32 abi;
+	u32 reset_provenance;
+	u32 private_replay_proof;
+	u32 private_replay_value;
+	u32 max_cpus;
+	u32 nr_cpus;
+	u32 possible_count;
+	u32 present_count;
+	u32 online_count;
+	u32 possible_mask;
+	u32 present_mask;
+	u32 online_mask;
+	u32 cpu8_method_valid;
+	u32 cpu9_method_valid;
+	u32 cpuhp_state_cpu8;
+	u32 cpuhp_state_cpu9;
+	u64 cpu8_mpidr;
+	u64 cpu9_mpidr;
+	struct mt6797_a72_owner_snapshot owner;
+	u64 owner_next_generation;
+	u64 owner_next_cookie;
+	u64 first_generation;
+	u64 first_cookie;
+	struct arm64_late_cpu_startup_snapshot p30;
+};
+
+#ifdef CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR
+int
+mt6797_a72_a34_evaluate(const struct mt6797_a72_a34_observation
+			      *observation);
+#else
+static inline int
+mt6797_a72_a34_evaluate(const struct mt6797_a72_a34_observation
+			      *observation)
+{
+	(void)observation;
+	return -EOPNOTSUPP;
+}
+#endif
+
 #ifdef CONFIG_ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
 int
 mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index eac7f00..adf2ad4 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -51,6 +51,7 @@ obj-$(CONFIG_ARM64_LATE_CPU_STARTUP_FAILSTOP) += late_cpu_startup.o
 obj-$(CONFIG_ARM64_LATE_CPU_STARTUP_KUNIT_TEST) += late_cpu_startup_test.o
 obj-$(CONFIG_ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL) += mt6797_a72_membership.o
 obj-$(CONFIG_ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST) += mt6797_a72_membership_test.o
+obj-$(CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_KUNIT_TEST) += mt6797_a72_a34_evaluator_test.o
 obj-$(CONFIG_HAVE_STATIC_CALL)		+= static_call.o
 obj-$(CONFIG_ARM64_MT6797_A72_P30E_WIRE)	+= mt6797_a72_p30e.o
 obj-$(CONFIG_ARM64_MT6797_A72_P30E_WIRE)	+= mt6797_a72_p30e_asm.o
diff --git a/arch/arm64/kernel/mt6797_a72_a34_evaluator_test.c b/arch/arm64/kernel/mt6797_a72_a34_evaluator_test.c
new file mode 100644
index 0000000..827b9fc
--- /dev/null
+++ b/arch/arm64/kernel/mt6797_a72_a34_evaluator_test.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include <asm/mt6797_a72_membership.h>
+
+struct mt6797_a34_test_state {
+	struct mt6797_a72_a34_observation *observation;
+	struct mt6797_a72_owner_snapshot *before;
+	struct mt6797_a72_owner_snapshot *after;
+};
+
+static void
+mt6797_a34_fill_valid(struct mt6797_a72_a34_observation *observation)
+{
+	memset(observation, 0, sizeof(*observation));
+	observation->abi = MT6797_A72_A34_ELIGIBILITY_ABI;
+	observation->reset_provenance = MT6797_A72_A34_RESET_PLATFORM;
+	observation->private_replay_proof =
+		MT6797_A72_A34_PRIVATE_REPLAY_OWNER_SAFE_ZERO;
+	observation->max_cpus = 8;
+	observation->nr_cpus = 10;
+	observation->possible_count = 10;
+	observation->present_count = 10;
+	observation->online_count = 8;
+	observation->possible_mask = GENMASK(9, 0);
+	observation->present_mask = GENMASK(9, 0);
+	observation->online_mask = GENMASK(7, 0);
+	observation->cpu8_method_valid = 1;
+	observation->cpu9_method_valid = 1;
+	observation->cpuhp_state_cpu8 = CPUHP_OFFLINE;
+	observation->cpuhp_state_cpu9 = CPUHP_OFFLINE;
+	observation->cpu8_mpidr = 0x200;
+	observation->cpu9_mpidr = 0x201;
+	observation->owner.diagnostic_blockers = MT6797_A72_BLOCK_MASK;
+	observation->owner.abi = MT6797_A72_TRANSACTION_ABI;
+	observation->owner.health = MT6797_A72_OWNER_CLOSED;
+	observation->owner.phase = MT6797_A72_PHASE_UNINITIALIZED;
+	observation->owner.provider_state = MT6797_A72_PROVIDER_NONE;
+	observation->first_generation = MT6797_A72_A34_FIRST_GENERATION;
+	observation->first_cookie = MT6797_A72_A34_FIRST_COOKIE;
+}
+
+static int mt6797_a34_test_init(struct kunit *test)
+{
+	struct mt6797_a34_test_state *state;
+
+	state = kunit_kzalloc(test, sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	state->observation = kunit_kzalloc(test, sizeof(*state->observation),
+					   GFP_KERNEL);
+	if (!state->observation)
+		return -ENOMEM;
+	state->before = kunit_kzalloc(test, sizeof(*state->before), GFP_KERNEL);
+	if (!state->before)
+		return -ENOMEM;
+	state->after = kunit_kzalloc(test, sizeof(*state->after), GFP_KERNEL);
+	if (!state->after)
+		return -ENOMEM;
+	test->priv = state;
+	mt6797_a72_membership_test_reset();
+	mt6797_a34_fill_valid(state->observation);
+	return 0;
+}
+
+static void mt6797_a34_test_exit(struct kunit *test)
+{
+	(void)test;
+	mt6797_a72_membership_test_reset();
+}
+
+static void
+mt6797_a34_expect_result_unchanged(struct kunit *test,
+				   struct mt6797_a34_test_state *state,
+				   int expected)
+{
+	int ret;
+
+	mt6797_a72_membership_snapshot(state->before);
+	ret = mt6797_a72_a34_evaluate(state->observation);
+	mt6797_a72_membership_snapshot(state->after);
+	KUNIT_EXPECT_EQ(test, ret, expected);
+	KUNIT_EXPECT_MEMEQ(test, state->before, state->after,
+			   sizeof(*state->before));
+}
+
+static void mt6797_a34_exact_provenance_test(struct kunit *test)
+{
+	struct mt6797_a34_test_state *state = test->priv;
+	u32 provenance;
+
+	for (provenance = MT6797_A72_A34_RESET_PLATFORM;
+	     provenance <= MT6797_A72_A34_RESET_EXTERNAL; provenance++) {
+		mt6797_a34_fill_valid(state->observation);
+		state->observation->reset_provenance = provenance;
+		mt6797_a34_expect_result_unchanged(test, state, 0);
+	}
+}
+
+static void mt6797_a34_null_test(struct kunit *test)
+{
+	struct mt6797_a34_test_state *state = test->priv;
+	int ret;
+
+	mt6797_a72_membership_snapshot(state->before);
+	ret = mt6797_a72_a34_evaluate(NULL);
+	mt6797_a72_membership_snapshot(state->after);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	KUNIT_EXPECT_MEMEQ(test, state->before, state->after,
+			   sizeof(*state->before));
+}
+
+static void mt6797_a34_every_byte_mutation_test(struct kunit *test)
+{
+	struct mt6797_a34_test_state *state = test->priv;
+	u8 *bytes = (u8 *)state->observation;
+	size_t offset;
+	int ret;
+
+	mt6797_a72_membership_snapshot(state->before);
+	for (offset = 0; offset < sizeof(*state->observation); offset++) {
+		mt6797_a34_fill_valid(state->observation);
+		bytes[offset] ^= 1;
+		ret = mt6797_a72_a34_evaluate(state->observation);
+		KUNIT_EXPECT_EQ_MSG(test, ret, -EPERM,
+				    "mutation offset %zu", offset);
+	}
+	mt6797_a72_membership_snapshot(state->after);
+	KUNIT_EXPECT_MEMEQ(test, state->before, state->after,
+			   sizeof(*state->before));
+}
+
+static void mt6797_a34_missing_provenance_test(struct kunit *test)
+{
+	struct mt6797_a34_test_state *state = test->priv;
+
+	state->observation->reset_provenance =
+		MT6797_A72_A34_RESET_ORDINARY_LINUX;
+	mt6797_a34_expect_result_unchanged(test, state, -EPERM);
+	mt6797_a34_fill_valid(state->observation);
+	state->observation->private_replay_proof =
+		MT6797_A72_A34_PRIVATE_REPLAY_UNKNOWN;
+	mt6797_a34_expect_result_unchanged(test, state, -EPERM);
+}
+
+static void mt6797_a34_admission_remains_closed_test(struct kunit *test)
+{
+	struct mt6797_a34_test_state *state = test->priv;
+	int ret;
+
+	mt6797_a34_expect_result_unchanged(test, state, 0);
+	mt6797_a72_membership_snapshot(state->after);
+	KUNIT_EXPECT_EQ(test, state->after->health, MT6797_A72_OWNER_CLOSED);
+	KUNIT_EXPECT_EQ(test, state->after->phase,
+			MT6797_A72_PHASE_UNINITIALIZED);
+	KUNIT_EXPECT_EQ(test, state->after->attempts_available, 0U);
+	ret = mt6797_a72_membership_preflight_up(8, CPUHP_ONLINE);
+	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
+}
+
+static struct kunit_case mt6797_a34_test_cases[] = {
+	KUNIT_CASE(mt6797_a34_exact_provenance_test),
+	KUNIT_CASE(mt6797_a34_null_test),
+	KUNIT_CASE(mt6797_a34_every_byte_mutation_test),
+	KUNIT_CASE(mt6797_a34_missing_provenance_test),
+	KUNIT_CASE(mt6797_a34_admission_remains_closed_test),
+	{}
+};
+
+static struct kunit_suite mt6797_a34_test_suite = {
+	.name = "mt6797-a72-a34-eligibility",
+	.init = mt6797_a34_test_init,
+	.exit = mt6797_a34_test_exit,
+	.test_cases = mt6797_a34_test_cases,
+};
+
+kunit_test_suite(mt6797_a34_test_suite);
+
+MODULE_LICENSE("GPL");
diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index 7da7399..bcf75e6 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -20,6 +20,7 @@
 #include <linux/mutex.h>
 #include <linux/sched.h>
 #include <linux/spinlock.h>
+#include <linux/stddef.h>
 #include <linux/string.h>
 
 #include <asm/memory.h>
@@ -139,6 +140,58 @@ static struct mt6797_a72_owner_state a72_owner = {
 	.provider_state = MT6797_A72_PROVIDER_NONE,
 };
 
+#ifdef CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR
+static const struct mt6797_a72_a34_observation a34_expected = {
+	.abi = MT6797_A72_A34_ELIGIBILITY_ABI,
+	.private_replay_proof =
+		MT6797_A72_A34_PRIVATE_REPLAY_OWNER_SAFE_ZERO,
+	.max_cpus = 8,
+	.nr_cpus = 10,
+	.possible_count = 10,
+	.present_count = 10,
+	.online_count = 8,
+	.possible_mask = GENMASK(9, 0),
+	.present_mask = GENMASK(9, 0),
+	.online_mask = GENMASK(7, 0),
+	.cpu8_method_valid = 1,
+	.cpu9_method_valid = 1,
+	.cpuhp_state_cpu8 = CPUHP_OFFLINE,
+	.cpuhp_state_cpu9 = CPUHP_OFFLINE,
+	.cpu8_mpidr = 0x200,
+	.cpu9_mpidr = 0x201,
+	.owner = {
+		.diagnostic_blockers = MT6797_A72_BLOCK_MASK,
+		.abi = MT6797_A72_TRANSACTION_ABI,
+		.health = MT6797_A72_OWNER_CLOSED,
+		.phase = MT6797_A72_PHASE_UNINITIALIZED,
+		.provider_state = MT6797_A72_PROVIDER_NONE,
+	},
+	.first_generation = MT6797_A72_A34_FIRST_GENERATION,
+	.first_cookie = MT6797_A72_A34_FIRST_COOKIE,
+};
+
+int
+mt6797_a72_a34_evaluate(const struct mt6797_a72_a34_observation
+			      *observation)
+{
+	size_t tail = offsetof(struct mt6797_a72_a34_observation,
+			       private_replay_proof);
+
+	if (!observation)
+		return -EINVAL;
+	if (observation->abi != MT6797_A72_A34_ELIGIBILITY_ABI ||
+	    (observation->reset_provenance !=
+		MT6797_A72_A34_RESET_PLATFORM &&
+	     observation->reset_provenance !=
+		MT6797_A72_A34_RESET_EXTERNAL) ||
+	    memcmp((const u8 *)observation + tail,
+		   (const u8 *)&a34_expected + tail,
+		   sizeof(*observation) - tail))
+		return -EPERM;
+	return 0;
+}
+#endif
+
 static bool
 mt6797_a72_p32_target_locked(unsigned int cpu)
 {
