-	       expected->id_isar2 == aarch32->reg_id_isar2 &&
-	       expected->id_isar3 == aarch32->reg_id_isar3 &&
-	       expected->id_isar4 == aarch32->reg_id_isar4 &&
-	       expected->id_isar5 == aarch32->reg_id_isar5 &&
-	       expected->id_mmfr0 == aarch32->reg_id_mmfr0 &&
-	       expected->id_mmfr1 == aarch32->reg_id_mmfr1 &&
-	       expected->id_mmfr2 == aarch32->reg_id_mmfr2 &&
-	       expected->id_mmfr3 == aarch32->reg_id_mmfr3 &&
-	       expected->id_pfr0 == aarch32->reg_id_pfr0 &&
-	       expected->id_pfr1 == aarch32->reg_id_pfr1;
+	late_expected_target_compare(pair->mpidr[target], mpidr,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_MPIDR, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->midr, info->reg_midr,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_MIDR, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->revidr, info->reg_revidr,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_REVIDR, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->cntfrq, info->reg_cntfrq,
