-int arm64_mt6797_a72_p30e_target_checkpoint(u64 checkpoint)
+static int
+p30e_target_checkpoint(u64 checkpoint, u64 details,
+		       u64 expected, u64 observed)
 {
 	struct arm64_mt6797_a72_p30e_slot *slot;
 	struct arm64_mt6797_a72_p30e_wire *wire;
@@ -283,7 +286,11 @@ int arm64_mt6797_a72_p30e_target_checkpoint(u64 checkpoint)
 	int cpu, ret = 0;
 
 	if (checkpoint < ARM64_MT6797_A72_P30E_CHECKPOINT_TASK_READY ||
-	    checkpoint > ARM64_MT6797_A72_P30E_CHECKPOINT_IRQ_READY)
+	    checkpoint > ARM64_MT6797_A72_P30E_CHECKPOINT_IRQ_READY ||
+	    (!!details != (checkpoint ==
+			    ARM64_MT6797_A72_P30E_CHECKPOINT_EXPECTATION_FAILED)) ||
+	    (details & ~ARM64_LATE_CPU_EXPECT_MISMATCH_ALLOWED_MASK) ||
+	    (!details && (expected || observed)))
 		return -EINVAL;
 	cpu = p30e_current_cpu();
 	if (cpu < 0)
@@ -298,7 +305,10 @@ int arm64_mt6797_a72_p30e_target_checkpoint(u64 checkpoint)
 	    ARM64_MT6797_A72_P30E_ARMED ||
 	    p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_STATE_WORD) !=
 	    ARM64_MT6797_A72_P30E_TARGET_CLAIMED ||
-	    p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_SEQUENCE_WORD) != 0) {
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_SEQUENCE_WORD) != 0 ||
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_EFFECTS_WORD) != 0 ||
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_ENTRY_PC_WORD) != 0 ||
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_ENTRY_SP_WORD) != 0) {
 		ret = -EAGAIN;
 		goto out_unlock;
 	}
@@ -307,6 +317,14 @@ int arm64_mt6797_a72_p30e_target_checkpoint(u64 checkpoint)
 		ret = -EALREADY;
 		goto out_unlock;
 	}
+	if (details) {
+		p30e_put(wire, ARM64_MT6797_A72_P30E_TARGET_EFFECTS_WORD,
+			 details);
+		p30e_put(wire, ARM64_MT6797_A72_P30E_TARGET_ENTRY_PC_WORD,
+			 expected);
+		p30e_put(wire, ARM64_MT6797_A72_P30E_TARGET_ENTRY_SP_WORD,
+			 observed);
+	}
 	p30e_put(wire, ARM64_MT6797_A72_P30E_TARGET_REASON_WORD, checkpoint);
 	p30e_clean_slot(slot);
 
@@ -315,6 +333,18 @@ out_unlock:
 	return ret;
 }
 
+int arm64_mt6797_a72_p30e_target_checkpoint(u64 checkpoint)
+{
+	return p30e_target_checkpoint(checkpoint, 0, 0, 0);
+}
