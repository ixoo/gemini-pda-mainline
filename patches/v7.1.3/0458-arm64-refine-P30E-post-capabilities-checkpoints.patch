 }
 
-int arm64_validate_late_cpu_expected_target(unsigned int cpu)
+int arm64_validate_late_cpu_expected_target(unsigned int cpu, u64 *mismatches,
+					    u64 *expected_value,
+					    u64 *observed_value)
 {
 	const struct arm64_late_cpu_expected_pair *expected;
 	const struct cpuinfo_arm64 *info;
 	unsigned int target;
 
+	if (!mismatches || !expected_value || !observed_value)
+		return -EINVAL;
+	*mismatches = 0;
+	*expected_value = 0;
+	*observed_value = 0;
+
 	/* Pairs with READY publication of late_plan and late_receipt. */
 	if (smp_load_acquire(&late_receipt.state) !=
 	    ARM64_LATE_CPU_PROFILE_READY)
 		return 0;
 	if (!cpumask_test_cpu(cpu, &late_plan.target_cpus))
 		return 0;
-	if (cpu != smp_processor_id() || !arm64_late_cpu_expected_pair_complete(&late_plan))
+	if (cpu != smp_processor_id()) {
+		*mismatches = ARM64_LATE_CPU_EXPECT_MISMATCH_CURRENT_CPU;
+		*expected_value = cpu;
+		*observed_value = smp_processor_id();
+		return -EINVAL;
+	}
+	if (!arm64_late_cpu_expected_pair_complete(&late_plan)) {
+		*mismatches = ARM64_LATE_CPU_EXPECT_MISMATCH_PAIR_CONTRACT;
+		*expected_value = 1;
 		return -EINVAL;
+	}
 
 	for (target = 0; target < ARM64_LATE_CPU_MAX_TARGETS; target++)
 		if (late_plan.evidence.target_cpu[target] == cpu)
 			break;
-	if (target == ARM64_LATE_CPU_MAX_TARGETS)
+	if (target == ARM64_LATE_CPU_MAX_TARGETS) {
+		*mismatches = ARM64_LATE_CPU_EXPECT_MISMATCH_TARGET_SLOT;
+		*expected_value = cpu;
+		*observed_value = U64_MAX;
 		return -EINVAL;
+	}
 
 	expected = &late_plan.evidence.expected_pair;
 	info = this_cpu_ptr(&cpu_data);
-	return late_expected_target_matches(expected, target, info) ? 0 : -ERANGE;
+	*mismatches = late_expected_target_mismatches(expected, target, info,
+						      expected_value,
+						      observed_value);
+	return *mismatches ? -ERANGE : 0;
 }
 
 const struct arm64_late_cpu_ready_token *
