+	late_expected_target_compare(pair->id_mmfr1, aarch32->reg_id_mmfr1,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_MMFR1, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_mmfr2, aarch32->reg_id_mmfr2,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_MMFR2, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_mmfr3, aarch32->reg_id_mmfr3,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_MMFR3, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_pfr0, aarch32->reg_id_pfr0,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_PFR0, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_pfr1, aarch32->reg_id_pfr1,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_PFR1, &mismatches,
