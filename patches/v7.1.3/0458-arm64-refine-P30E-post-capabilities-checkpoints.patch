+static void
+late_expected_target_compare(u64 expected, u64 observed, u64 bit,
+			     u64 *mismatches, u64 *first_expected,
+			     u64 *first_observed)
+{
+	if (expected == observed)
+		return;
+	if (!*mismatches) {
+		*first_expected = expected;
+		*first_observed = observed;
+	}
+	*mismatches |= bit;
+}
+
