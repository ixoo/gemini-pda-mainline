+	late_expected_target_compare(pair->ctr, read_cpuid_cachetype(),
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_CTR, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->dczid, info->reg_dczid,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_DCZID, &mismatches,
