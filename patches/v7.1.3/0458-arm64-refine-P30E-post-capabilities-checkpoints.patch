+	late_expected_target_compare(pair->id_isar2, aarch32->reg_id_isar2,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_ISAR2, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_isar3, aarch32->reg_id_isar3,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_ISAR3, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_isar4, aarch32->reg_id_isar4,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_ISAR4, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_isar5, aarch32->reg_id_isar5,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_ISAR5, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_mmfr0, aarch32->reg_id_mmfr0,
