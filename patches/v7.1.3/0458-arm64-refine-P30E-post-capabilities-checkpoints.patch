+	late_expected_target_compare(pair->id_aa64dfr0, info->reg_id_aa64dfr0,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_AA64DFR0, &mismatches,
+				     first_expected, first_observed);
+	late_expected_target_compare(pair->id_aa64isar0, info->reg_id_aa64isar0,
+				     ARM64_LATE_CPU_EXPECT_MISMATCH_AA64ISAR0, &mismatches,
