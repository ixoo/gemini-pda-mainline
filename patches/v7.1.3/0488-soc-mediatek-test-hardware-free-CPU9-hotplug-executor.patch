+static struct kunit_suite mt6797_hotplug_suite = {
+	.name = "mt6797-a72-hotplug-executor",
+	.init = mt6797_hotplug_test_init,
+	.test_cases = mt6797_hotplug_cases,
+};
+
+kunit_test_suite(mt6797_hotplug_suite);
