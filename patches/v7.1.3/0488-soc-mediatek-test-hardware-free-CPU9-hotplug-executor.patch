+	KUNIT_CASE(mt6797_hotplug_readback_rejections),
+	KUNIT_CASE(mt6797_hotplug_postcommit_callback_fault),
+	KUNIT_CASE(mt6797_hotplug_order_and_one_shot),
+	{}
+};
