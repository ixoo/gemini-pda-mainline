From 0000000000000000000000000000000000000546 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 25 Sep 2026 21:40:00 +0000
Subject: [PATCH] soc: mediatek: observe MT6797 CONSYS handoff fields

Read the existing infracfg syscon's CONN bus-protection status, shared
remap and EMI selector twice at late init. Compare the remap's common
field with the live no-map CONSYS reservation. Report movement and
mismatch without inferring ownership or activating the radio.

Internal experiment only; synthetic author, no DCO certification.
---
 drivers/soc/mediatek/Kconfig                    |  12 +++
 drivers/soc/mediatek/Makefile                   |   1 +
 drivers/soc/mediatek/mt6797-consys-handoff.c | 121 ++++++++++++++++++++++
 3 files changed, 134 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-consys-handoff.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -1 +1,13 @@
+config MTK_MT6797_CONSYS_HANDOFF_SNAPSHOT
+	bool "MediaTek MT6797 passive CONSYS handoff snapshot"
+	depends on ARM64 && ARCH_MEDIATEK && OF && OF_RESERVED_MEM
+	depends on MFD_SYSCON && REGMAP
+	default n
+	help
+	  On the Gemini PDA, read the already mapped infracfg syscon's CONN
+	  protection, shared remap and EMI selector fields twice at late init.
+	  Report the boot's live CONSYS reservation and a bounded classification.
+	  This diagnostic writes no register, loads no firmware and grants no
+	  resource ownership.
+
 config MTK_MT6797_A72_RESTORE_EXECUTOR
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -1 +1,2 @@
 obj-$(CONFIG_MTK_MT6797_CONSYS_STATUS_SNAPSHOT) += mt6797-consys-status.o
+obj-$(CONFIG_MTK_MT6797_CONSYS_HANDOFF_SNAPSHOT) += mt6797-consys-handoff.o
diff --git a/drivers/soc/mediatek/mt6797-consys-handoff.c b/drivers/soc/mediatek/mt6797-consys-handoff.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-consys-handoff.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* One passive snapshot of the Gemini CONSYS shared handoff fields. */
+#include <linux/bitops.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/printk.h>
+#include <linux/regmap.h>
+
+#define MT6797_INFRA_PROTECTSTA	0x228
+#define MT6797_INFRA_REMAP	0x340
+#define MT6797_INFRA_SELECTOR	0xf00
+#define MT6797_CONN_PROTECTION	GENMASK(18, 17)
+#define MT6797_COMMON_REMAP	GENMASK(12, 0)
+#define MT6797_COMMON_ENABLE	BIT(12)
+#define MT6797_SELECTOR_BIT	BIT(13)
+
+static int __init mt6797_consys_handoff_init(void)
+{
+	const struct reserved_mem *reserved;
+	struct device_node *memory, *infra_node;
+	struct regmap *infra;
+	u32 protect[2], remap[2], selector[2], expected;
+	const char *state;
+	unsigned int reads = 0;
+	u64 base;
+	int error, i;
+
+	if (!of_machine_is_compatible("planet,gemini-pda"))
+		return 0;
+
+	memory = of_find_compatible_node(NULL, NULL,
+					 "mediatek,consys-reserve-memory");
+	if (!memory) {
+		pr_info("mt6797-consys-handoff: state=unavailable reason=memory-node\n");
+		return 0;
+	}
+	reserved = of_reserved_mem_lookup(memory);
+	if (!of_device_is_available(memory) ||
+	    !of_property_read_bool(memory, "no-map") ||
+	    of_property_read_bool(memory, "reusable") ||
+	    !reserved || reserved->ops || reserved->priv) {
+		of_node_put(memory);
+		pr_info("mt6797-consys-handoff: state=unavailable reason=reservation\n");
+		return 0;
+	}
+	base = reserved->base;
+	if (!base || (base & 0x1fffff) || reserved->size != 0x200000 ||
+	    base > 0xffffffffULL - 0xfffffULL) {
+		of_node_put(memory);
+		pr_info("mt6797-consys-handoff: state=unavailable reason=range\n");
+		return 0;
+	}
+	of_node_put(memory);
+
+	infra_node = of_find_compatible_node(NULL, NULL, "mediatek,mt6797-infracfg");
+	if (!infra_node) {
+		pr_info("mt6797-consys-handoff: state=unavailable reason=infra-node\n");
+		return 0;
+	}
+	if (!of_device_is_available(infra_node) ||
+	    !of_device_is_compatible(infra_node, "syscon")) {
+		of_node_put(infra_node);
+		pr_info("mt6797-consys-handoff: state=unavailable reason=infra-syscon\n");
+		return 0;
+	}
+	infra = syscon_node_to_regmap(infra_node);
+	of_node_put(infra_node);
+	if (IS_ERR(infra)) {
+		pr_info("mt6797-consys-handoff: state=unavailable reason=map error=%ld\n",
+			PTR_ERR(infra));
+		return 0;
+	}
+
+	for (i = 0; i < 2; i++) {
+		error = regmap_read(infra, MT6797_INFRA_PROTECTSTA,
+				    &protect[i]);
+		if (error)
+			goto unavailable;
+		reads++;
+		error = regmap_read(infra, MT6797_INFRA_REMAP, &remap[i]);
+		if (error)
+			goto unavailable;
+		reads++;
+		error = regmap_read(infra, MT6797_INFRA_SELECTOR,
+				    &selector[i]);
+		if (error)
+			goto unavailable;
+		reads++;
+	}
+
+	expected = (u32)(base >> 20) | MT6797_COMMON_ENABLE;
+	if (((protect[0] ^ protect[1]) & MT6797_CONN_PROTECTION) ||
+	    remap[0] != remap[1] ||
+	    ((selector[0] ^ selector[1]) & MT6797_SELECTOR_BIT))
+		state = "moved";
+	else if ((protect[1] & MT6797_CONN_PROTECTION) !=
+		 MT6797_CONN_PROTECTION)
+		state = "unprotected";
+	else if (!(remap[1] & MT6797_COMMON_ENABLE))
+		state = "disabled";
+	else if ((remap[1] & MT6797_COMMON_REMAP) == expected)
+		state = "matching";
+	else
+		state = "mismatch";
+
+	pr_info("mt6797-consys-handoff: state=%s base=0x%llx size=0x%llx remap=0x%08x expected=0x%04x protect=0x%05x selector=%u samples=2 reads=%u power=0 reset=0 remap_write=0 protection_write=0 firmware=0 radio=0 dma=0\n",
+		state, (unsigned long long)base,
+		(unsigned long long)reserved->size, remap[1], expected,
+		protect[1] & MT6797_CONN_PROTECTION,
+		!!(selector[1] & MT6797_SELECTOR_BIT), reads);
+	return 0;
+
+unavailable:
+	pr_info("mt6797-consys-handoff: state=unavailable reason=read error=%d reads=%u\n",
+		error, reads);
+	return 0;
+}
+late_initcall(mt6797_consys_handoff_init);
-- 
2.54.0
