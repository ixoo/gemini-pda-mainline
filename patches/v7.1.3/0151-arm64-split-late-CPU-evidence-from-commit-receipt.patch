 arch/arm64/kernel/cpufeature.c            |  69 ++--
 arch/arm64/kernel/late_cpu_profile.c      | 382 ++++++++++++----------
 arch/arm64/kernel/mt6797_psci.c           |  98 ++----
 4 files changed, 559 insertions(+), 309 deletions(-)

