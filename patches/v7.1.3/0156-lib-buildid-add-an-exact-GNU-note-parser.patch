From 15d862a4fc495505104d1732b3c97f0ad0aa867c Mon Sep 17 00:00:00 2001
From: Gemini Mainline Project <noreply@invalid>
Date: Wed, 5 Aug 2026 14:29:55 -0400
Subject: [PATCH] lib/buildid: add an exact GNU note parser

Add a bounded helper that scans the complete note buffer and accepts
exactly one nonzero GNU build ID of the requested size. Keep the legacy
parser unchanged, make success safe for overlapping input/output buffers,
and zero the output on every representable failure.

Cover the strict contract with a default-off KUnit suite, including
malformed, duplicate, overflow, unaligned, and aliasing cases.

This experiment-only change has no certifying sign-off and is not
submission-ready.
---
 include/linux/buildid.h |   2 +
 lib/Kconfig.debug       |  11 ++
 lib/Makefile            |   1 +
 lib/buildid.c           |  77 +++++++++
 lib/buildid_test.c      | 359 ++++++++++++++++++++++++++++++++++++++++
 5 files changed, 450 insertions(+)
 create mode 100644 lib/buildid_test.c

diff --git a/include/linux/buildid.h b/include/linux/buildid.h
index 7acc06b22..38a451111 100644
--- a/include/linux/buildid.h
+++ b/include/linux/buildid.h
@@ -13,6 +13,8 @@ int build_id_parse(struct vm_area_struct *vma, unsigned char *build_id, __u32 *s
 int build_id_parse_file(struct file *file, unsigned char *build_id, __u32 *size);
 int build_id_parse_nofault(struct vm_area_struct *vma, unsigned char *build_id, __u32 *size);
 int build_id_parse_buf(const void *buf, unsigned char *build_id, u32 buf_size);
+int build_id_parse_buf_exact(const void *buf, unsigned char *build_id,
+			     u32 buf_size, u32 expected_size);
 
 #if IS_ENABLED(CONFIG_STACKTRACE_BUILD_ID) || IS_ENABLED(CONFIG_VMCORE_INFO)
 extern unsigned char vmlinux_build_id[BUILD_ID_SIZE_MAX];
diff --git a/lib/Kconfig.debug b/lib/Kconfig.debug
index 8ff5adcfe..48564e9ca 100644
--- a/lib/Kconfig.debug
+++ b/lib/Kconfig.debug
@@ -2942,6 +2942,17 @@ config CMDLINE_KUNIT_TEST
 
 	  If unsure, say N.
 
+config BUILDID_KUNIT_TEST
