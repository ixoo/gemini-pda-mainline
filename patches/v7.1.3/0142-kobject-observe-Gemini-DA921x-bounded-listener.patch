From 2e6d4499adfdd9f94731cce1c5b89842974786ab Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 1 Aug 2026 10:00:00 -0400
Subject: [PATCH 142/142] kobject: observe Gemini DA921x bounded listener

The named Gemini reached stage 20 after the normal untagged delivery loop
observed one socket and no group-1 listener, then returned zero without skb
allocation or broadcast. The exact event, unbound client, zero-I2C, and
serviceability baseline passed.

Add the next experiment-only split. Retain a reference to the exact target
after stage 20 and expose a one-shot, exact-token sysfs trigger. A
temporary
userspace listener can bind group 1 before that trigger replays the same
KOBJ_ADD event. Revalidate and serialize the event, traverse the socket
list,
and advance to stage 21 only for the runtime-proven one-socket topology
with
exactly one listener. Consume the skb before broadcast as before.

The trigger is one-shot and fails closed unless stage 20 and the exact
target
are retained. This adds no driver, provider, I2C transfer, register access,
printk, storage path, or multicast delivery.
---
 drivers/i2c/Kconfig     | 18 ++++++++++
 include/linux/kobject.h |  8 +++++
 kernel/ksysfs.c         | 30 +++++++++++++++++
 lib/kobject_uevent.c    | 89 ++++++++++++++++++++++++++++++++++++++++++++++---
 4 files changed, 140 insertions(+), 5 deletions(-)

diff --git a/drivers/i2c/Kconfig b/drivers/i2c/Kconfig
--- a/drivers/i2c/Kconfig
+++ b/drivers/i2c/Kconfig
@@ -262,6 +262,23 @@ config I2C_GEMINI_DA921X_UEVENT_NO_LISTENER_DELIVERY_DIAGNOSTIC
 
 	  Say N outside the named no-listener delivery experiment.
 
+config I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC
+	bool "Gemini DA921x bounded uevent-listener discriminator"
+	depends on I2C_GEMINI_DA921X_UEVENT_NO_LISTENER_DELIVERY_DIAGNOSTIC
+	help
+	  Retain the exact target after stage 20 and expose a one-shot trigger at
+	  /sys/kernel/gemini_da921x_uevent_bounded_listener. With one temporary
+	  userspace group-1 listener already bound, replay and revalidate the same
+	  add-event, traverse the normal socket list, and advance to stage 21 only
+	  for exactly one listener on the runtime-proven one-socket topology.
+
+	  The serialized skb remains consumed before broadcast. The trigger fails
+	  closed unless the exact stage-20 target is retained and accepts only the
+	  exact token "probe". It adds no driver, provider, transfer, register
+	  access, printk, storage path, or multicast delivery.
+
+	  Say N outside the named bounded-listener experiment.
+
 config I2C_BOARDINFO
 	bool
 	default y
diff --git a/include/linux/kobject.h b/include/linux/kobject.h
--- a/include/linux/kobject.h
+++ b/include/linux/kobject.h
@@ -80,6 +80,15 @@ extern atomic_t gemini_da921x_no_listener_broadcast_count;
 extern atomic_t gemini_da921x_no_listener_retval;
 #endif
 
+#ifdef CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC
+extern atomic_t gemini_da921x_bounded_listener_attempts;
+extern atomic_t gemini_da921x_bounded_listener_baseline_socket_count;
+extern atomic_t gemini_da921x_bounded_listener_socket_count;
+extern atomic_t gemini_da921x_bounded_listener_listener_count;
+extern atomic_t gemini_da921x_bounded_listener_broadcast_count;
+int gemini_da921x_trigger_bounded_listener(void);
+#endif
+
 /*
  * The actions here must match the index to the string array
  * in lib/kobject_uevent.c
diff --git a/kernel/ksysfs.c b/kernel/ksysfs.c
--- a/kernel/ksysfs.c
+++ b/kernel/ksysfs.c
@@ -138,6 +138,39 @@ gemini_da921x_uevent_no_listener_state_show(struct kobject *kobj,
 KERNEL_ATTR_RO(gemini_da921x_uevent_no_listener_state);
 #endif
 
+#ifdef CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC
+static ssize_t
+gemini_da921x_bounded_listener_show(struct kobject *kobj,
+				    struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf,
+		"attempts=%d baseline_sockets=%d sockets=%d listeners=%d broadcasts=%d\n",
+		atomic_read(&gemini_da921x_bounded_listener_attempts),
+		atomic_read(&gemini_da921x_bounded_listener_baseline_socket_count),
+		atomic_read(&gemini_da921x_bounded_listener_socket_count),
+		atomic_read(&gemini_da921x_bounded_listener_listener_count),
+		atomic_read(&gemini_da921x_bounded_listener_broadcast_count));
+}
+
+static ssize_t
+gemini_da921x_bounded_listener_store(struct kobject *kobj,
+				     struct kobj_attribute *attr,
+				     const char *buf, size_t count)
+{
+	int ret;
+
+	if (count != sizeof("probe\n") - 1 || memcmp(buf, "probe\n", count))
+		return -EINVAL;
+	ret = gemini_da921x_trigger_bounded_listener();
+	return ret ?: count;
+}
+
+static struct kobj_attribute gemini_da921x_uevent_bounded_listener_attr =
+	__ATTR(gemini_da921x_uevent_bounded_listener, 0644,
+	       gemini_da921x_bounded_listener_show,
+	       gemini_da921x_bounded_listener_store);
+#endif
+
 /* cpu byteorder */
 static ssize_t cpu_byteorder_show(struct kobject *kobj,
 				  struct kobj_attribute *attr, char *buf)
@@ -299,5 +326,8 @@ static struct attribute * kernel_attrs[] = {
 	&gemini_da921x_uevent_no_listener_state_attr.attr,
 #endif
+#ifdef CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC
+	&gemini_da921x_uevent_bounded_listener_attr.attr,
+#endif
 	&cpu_byteorder_attr.attr,
 	&address_bits_attr.attr,
 #ifdef CONFIG_UEVENT_HELPER
diff --git a/lib/kobject_uevent.c b/lib/kobject_uevent.c
--- a/lib/kobject_uevent.c
+++ b/lib/kobject_uevent.c
@@ -70,6 +70,17 @@ atomic_t gemini_da921x_no_listener_broadcast_count = ATOMIC_INIT(-1);
 atomic_t gemini_da921x_no_listener_retval = ATOMIC_INIT(-1);
 #endif
 
+#ifdef CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC
+atomic_t gemini_da921x_bounded_listener_attempts = ATOMIC_INIT(0);
+atomic_t gemini_da921x_bounded_listener_baseline_socket_count = ATOMIC_INIT(-1);
+atomic_t gemini_da921x_bounded_listener_socket_count = ATOMIC_INIT(-1);
+atomic_t gemini_da921x_bounded_listener_listener_count = ATOMIC_INIT(-1);
+atomic_t gemini_da921x_bounded_listener_broadcast_count = ATOMIC_INIT(-1);
+
+static DEFINE_MUTEX(gemini_da921x_bounded_listener_lock);
+static struct kobject *gemini_da921x_bounded_listener_target;
+#endif
+
 #ifdef CONFIG_UEVENT_HELPER
 char uevent_helper[UEVENT_HELPER_PATH_LEN] = CONFIG_UEVENT_HELPER_PATH;
 #endif
@@ -511,6 +523,69 @@ gemini_da921x_no_listener(struct kobj_uevent_env *env,
 }
 #endif
 
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC)
+static int gemini_da921x_arm_bounded_listener(struct kobject *kobj)
+{
+	int ret = 0;
+
+	mutex_lock(&gemini_da921x_bounded_listener_lock);
+	if (gemini_da921x_bounded_listener_target ||
+	    atomic_read(&gemini_da921x_bounded_listener_attempts))
+		ret = -EALREADY;
+	else
+		gemini_da921x_bounded_listener_target = kobject_get(kobj);
+	mutex_unlock(&gemini_da921x_bounded_listener_lock);
+	return ret;
+}
+
+static int gemini_da921x_validate_bounded_listener(void)
+{
+	int baseline_sockets =
+		atomic_read(&gemini_da921x_no_listener_socket_count);
+	int sockets = atomic_read(&gemini_da921x_uevent_socket_count);
+	int listeners = atomic_read(&gemini_da921x_uevent_listener_count);
+
+	if (atomic_read(&gemini_da921x_bounded_listener_attempts) != 1 ||
+	    baseline_sockets != 1 ||
+	    atomic_read(&gemini_da921x_no_listener_listener_count) ||
+	    atomic_read(&gemini_da921x_no_listener_allocation_count) ||
+	    atomic_read(&gemini_da921x_no_listener_broadcast_count) ||
+	    atomic_read(&gemini_da921x_no_listener_retval) ||
+	    sockets != baseline_sockets || listeners != 1)
+		return -EINVAL;
+
+	atomic_set(&gemini_da921x_bounded_listener_baseline_socket_count,
+		   baseline_sockets);
+	atomic_set(&gemini_da921x_bounded_listener_socket_count, sockets);
+	atomic_set(&gemini_da921x_bounded_listener_listener_count, listeners);
+	atomic_set(&gemini_da921x_bounded_listener_broadcast_count, 0);
+	atomic_set(&gemini_da921x_dual_modalias_stage, 21);
+	return 0;
+}
+
+int gemini_da921x_trigger_bounded_listener(void)
+{
+	struct kobject *kobj;
+	int ret;
+
+	if (atomic_read(&gemini_da921x_dual_modalias_stage) != 20)
+		return -EAGAIN;
+	if (atomic_cmpxchg(&gemini_da921x_bounded_listener_attempts, 0, 1))
+		return -EALREADY;
+
+	mutex_lock(&gemini_da921x_bounded_listener_lock);
+	kobj = gemini_da921x_bounded_listener_target;
+	gemini_da921x_bounded_listener_target = NULL;
+	mutex_unlock(&gemini_da921x_bounded_listener_lock);
+	if (!kobj)
+		return -ENODEV;
+
+	ret = kobject_uevent(kobj, KOBJ_ADD);
+	kobject_put(kobj);
+	return ret;
+}
+#endif
+
 static int uevent_net_broadcast_tagged(struct sock *usk,
 				       struct kobj_uevent_env *env,
 				       const char *action_string,
@@ -817,6 +888,9 @@ int kobject_uevent_env(struct kobject *kobj, enum kobject_action action,
 	const struct kset_uevent_ops *uevent_ops;
 	int i = 0;
 	int retval = 0;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC)
+	int gemini_da921x_previous_stage = -1;
+#endif
 
 	/*
 	 * Mark "remove" event done regardless of result, for some subsystems
@@ -981,6 +1055,10 @@ int kobject_uevent_env(struct kobject *kobj, enum kobject_action action,
 	if (retval)
 		goto exit;
 
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC)
+	gemini_da921x_previous_stage =
+		atomic_read(&gemini_da921x_dual_modalias_stage);
+#endif
 	retval = gemini_da921x_pre_dispatch(kobj, action, subsystem, devpath, env);
 	if (retval < 0)
 		goto exit;
@@ -996,7 +1074,29 @@ int kobject_uevent_env(struct kobject *kobj, enum kobject_action action,
-#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_UEVENT_NO_LISTENER_DELIVERY_DIAGNOSTIC)
-		retval = gemini_da921x_no_listener(env, action_string, devpath);
-		if (retval)
-			goto exit;
-#endif
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC)
+		if (gemini_da921x_previous_stage > 20) {
+			atomic_set(&gemini_da921x_dual_modalias_stage,
+				   gemini_da921x_previous_stage);
+			retval = -EALREADY;
+			goto exit;
+		}
+#endif
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_UEVENT_BOUNDED_LISTENER_DIAGNOSTIC)
+		if (gemini_da921x_previous_stage < 20) {
+			retval = gemini_da921x_no_listener(env, action_string,
+							   devpath);
+			if (retval)
+				goto exit;
+			retval = gemini_da921x_arm_bounded_listener(kobj);
+			if (retval)
+				goto exit;
+		} else {
+			retval = gemini_da921x_validate_bounded_listener();
+			if (retval)
+				goto exit;
+		}
+#elif IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_UEVENT_NO_LISTENER_DELIVERY_DIAGNOSTIC)
+		retval = gemini_da921x_no_listener(env, action_string, devpath);
+		if (retval)
+			goto exit;
+#endif
 		/* The exact target skb is consumed above; never broadcast it from
 		 * this experiment-only path.
-- 
2.47.3
