 		"addresses=0x69,0x68 passes=2 "
 		"transfer_order=69:05,69:06,69:47,68:d3,68:5e,68:d9,68:da "
-		"expected_signature=d9,d0,c0 board_control_register=d3 "
-		"board_control_expected=1f "
