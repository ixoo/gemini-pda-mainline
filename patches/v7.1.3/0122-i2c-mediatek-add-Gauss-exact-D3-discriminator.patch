 		goto out_restore_retries;
@@ -2659,14 +2659,14 @@ mtk_i2c_quasar_emit_snapshot(char *buf, int len, const char *name,
 	return len;
 }
 
-#ifdef CONFIG_I2C_MT65XX_CURIE_DIAGNOSTIC
+#ifdef CONFIG_I2C_MT65XX_FERMI_DIAGNOSTIC
