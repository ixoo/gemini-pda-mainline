 #endif
@@ -2687,14 +2687,14 @@ static ssize_t mtk_i2c_quasar_read(struct file *file,
 		return -ENOMEM;
 
 	mutex_lock(&diag->lock);
-#ifdef CONFIG_I2C_MT65XX_CURIE_DIAGNOSTIC
+#ifdef CONFIG_I2C_MT65XX_FERMI_DIAGNOSTIC
 	len += scnprintf(buf + len, MTK_I2C_QUASAR_RESULT_SIZE - len,
