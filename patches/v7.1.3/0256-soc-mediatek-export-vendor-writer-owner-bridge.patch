From 0000000000000000000000000000000000000256 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 11 Aug 2026 00:30:00 -0400
Subject: [PATCH] soc: mediatek: export vendor writer owner bridge

Expose a source-independent callback table for the existing MT6797 vendor
writer bridge.  The table maps the pinned vendor begin/commit/abort and
identity callbacks to the already-bound mainline writer, validates site and
generation on every finish, and pins the callback identities to the same
resource-owner lock and generation.

The adapter is deliberately not a vendor caller and does not register a
callback by itself.  It performs no MMIO, provider registration, firmware
operation, device action, or CPU8/CPU9 admission; a separately reviewed
vendor-side registration may consume its exact callback table.
---
 drivers/soc/mediatek/Kconfig                                      |  11 ++++
 drivers/soc/mediatek/Makefile                                     |   2 +
 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer-bridge-kunit-test.c | 103 ++++++++++++
 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer-bridge.c          | 125 +++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer-bridge.h    |  56 ++++++
 5 files changed, 297 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer-bridge-kunit-test.c
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer-bridge.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer-bridge.h

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -153,6 +153,17 @@ config MTK_MT6797_DVFSP_VENDOR_WRITER_KUNIT_TEST
 	  Exercise generation, abort, overflow, and provenance validation using
 	  fake callbacks and a fake mutex. No vendor callback or registration API
 	  is invoked.
 
+config MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE
+	bool "MediaTek MT6797 vendor writer owner bridge"
+	depends on ARM64 && ARCH_MEDIATEK && OF
+	depends on MTK_MT6797_DVFSP_VENDOR_WRITER
+	help
+	  Export the exact callback table consumed by a separately reviewed
+	  vendor-side writer binding. The adapter shares the writer's owner,
+	  transition handle, mutex, and generation and is dormant by default.
+
+config MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE_KUNIT_TEST
+	bool "KUnit tests for the MT6797 vendor writer owner bridge"
+	depends on KUNIT=y
+	depends on MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE
+	default n
+
 config MTK_MT6797_DVFSP_CLOCK_BACKEND
 	bool "MediaTek MT6797 protected CPU clock readback transport"
 	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -17,6 +17,8 @@ obj-$(CONFIG_MTK_MT6797_DVFSP_VENDOR_OWNER_KUNIT_TEST) += mt6797-dvfsp-vendor-owner-test.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_VENDOR_WRITER) += mt6797-dvfsp-vendor-writer.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_VENDOR_WRITER_KUNIT_TEST) += mt6797-dvfsp-vendor-writer-kunit-test.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE) += mt6797-dvfsp-vendor-writer-bridge.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE_KUNIT_TEST) += mt6797-dvfsp-vendor-writer-bridge-kunit-test.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_RESOURCE_OWNER) += mt6797-dvfsp-calibrated-provider.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-snapshot.o
