From 0000000000000000000000000000000000000250 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 20:00:00 -0400
Subject: [PATCH] soc: mediatek: add vendor writer transition owner

Give a vendor-aware MT6797 writer one explicit transition mutex and monotonic
generation to use while it chains the legacy PTP, voltage, and PPM callback
slots. The writer owns no vendor callback slot and never calls a legacy setter;
the integration at those writers must call begin, invoke the existing callback
chain, then commit or abort.

Expose the writer generation callback in the same shape consumed by the live
source adapter. Provenance remains an explicit vendor callback and is checked
before publication. The transition mutex is supplied by the existing resource
owner, so the writer and the read-only state provider can share one lock and
generation rather than inventing a second observer lock.

This is an experiment-only cooperation contract. It is default-off and adds no
platform match, provider registration, MMIO, clock or rail operation, firmware
call, device action, or CPU8/CPU9 admission.
---
 drivers/soc/mediatek/Kconfig                                      |  19 ++++
 drivers/soc/mediatek/Makefile                                     |   2 +
 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer-kunit-test.c      | 122 ++++++++++++
 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer.c                 | 147 +++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h          |  53 ++++++
 5 files changed, 343 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer-kunit-test.c
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-vendor-writer.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-vendor-writer.h

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -134,6 +134,25 @@ config MTK_MT6797_DVFSP_VENDOR_OWNER_KUNIT_TEST
 	  Exercise the hardware-free cooperative callback binding and unbind
 	  lifecycle. The fixture invokes no vendor callback or registration API.
 
+config MTK_MT6797_DVFSP_VENDOR_WRITER
+	bool "MediaTek MT6797 vendor writer transition owner"
+	depends on ARM64 && ARCH_MEDIATEK && OF
+	depends on MTK_MT6797_DVFSP_VENDOR_OWNER
+	help
+	  Provide one explicit transition mutex and monotonic generation for a
+	  vendor-aware writer that chains its existing PTP, voltage, and PPM
+	  callback slots. The integration must supply provenance and must call
+	  begin/commit or begin/abort around its existing writer path.
+
+config MTK_MT6797_DVFSP_VENDOR_WRITER_KUNIT_TEST
+	bool "KUnit tests for the MT6797 vendor writer transition owner"
+	depends on KUNIT=y
+	depends on MTK_MT6797_DVFSP_VENDOR_WRITER
+	help
+	  Exercise generation, abort, overflow, and provenance validation using
+	  fake callbacks and a fake mutex. No vendor callback or registration API
+	  is invoked.
+
 config MTK_MT6797_DVFSP_CLOCK_BACKEND
 	bool "MediaTek MT6797 protected CPU clock readback transport"
 	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
