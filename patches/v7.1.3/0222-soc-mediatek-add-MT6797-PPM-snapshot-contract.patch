From 0000000000000000000000000000000000000222 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 04:00:00 -0400
Subject: [PATCH] soc: mediatek: add MT6797 PPM snapshot contract

The pinned MT6797 vendor PPM source owns three physical clusters (LL, L, and
B), installs a descending 16-entry DVFS table for each, and protects its
mutable client limits with the private ppm_main_info.lock. Add a strict
read-only snapshot contract that preserves that ordering and maps the vendor
index limits to a current frequency floor and ceiling.

This boundary does not reach into the vendor private lock or emulate its
internal ABI. A future owner must copy the snapshot while holding that lock
and the external clock/rail transition lock, then provide an authoritative
table epoch. The vendor PPM object has no CCI limit table and no per-row PPM
limit source; this decoder therefore exposes neither as a guessed value and
cannot by itself complete the calibration provider. No MMIO, regulator or
clock operation, secure call, provider registration, device boot, or CPU8/CPU9
admission is added. This patch is experiment-only and not submission-ready.
---
 drivers/soc/mediatek/Makefile                  |   1 +
 drivers/soc/mediatek/mt6797-dvfsp-ppm.c        | 116 ++++++++++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-ppm.h  |  65 ++++++++++
 3 files changed, 182 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-ppm.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-ppm.h

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-ppm.h b/include/linux/soc/mediatek/mt6797-dvfsp-ppm.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-ppm.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_MEDIATEK_MT6797_DVFSP_PPM_H
+#define __LINUX_SOC_MEDIATEK_MT6797_DVFSP_PPM_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+#define MT6797_DVFSP_PPM_SOURCE_ABI		1
+#define MT6797_DVFSP_PPM_CLUSTER_COUNT		3
+#define MT6797_DVFSP_PPM_TABLE_ENTRIES		16
+#define MT6797_DVFSP_PPM_TABLE_TYPE_FY		0
+#define MT6797_DVFSP_PPM_TABLE_TYPE_SB		1
+#define MT6797_DVFSP_PPM_TABLE_TYPE_MB		2
+#define MT6797_DVFSP_PPM_CLUSTER_LL		0
+#define MT6797_DVFSP_PPM_CLUSTER_L		1
+#define MT6797_DVFSP_PPM_CLUSTER_B		2
+#define MT6797_DVFSP_PPM_LL_CPU_ID		0
+#define MT6797_DVFSP_PPM_L_CPU_ID		4
+#define MT6797_DVFSP_PPM_B_CPU_ID		8
+#define MT6797_DVFSP_PPM_LL_CORE_COUNT		4
+#define MT6797_DVFSP_PPM_L_CORE_COUNT		4
+#define MT6797_DVFSP_PPM_B_CORE_COUNT		2
+
+/*
+ * This is the copied shape of the vendor ppm_cluster_info plus its current
+ * ppm_client_req limit. frequency_khz[] retains the vendor's OPP order:
+ * index zero is the highest frequency.
+ */
+struct mt6797_dvfsp_ppm_cluster_snapshot {
+	u32 cluster_id;
+	u32 cpu_id;
+	u32 core_num;
+	u32 dvfs_opp_num;
+	u32 frequency_khz[MT6797_DVFSP_PPM_TABLE_ENTRIES];
+	s32 min_cpufreq_idx;
+	s32 max_cpufreq_idx;
+	u32 min_cpu_core;
+	u32 max_cpu_core;
+	u32 has_advise_freq;
+	s32 advise_cpufreq_idx;
+	u32 has_advise_core;
+	s32 advise_cpu_core;
+};
+
+struct mt6797_dvfsp_ppm_snapshot {
+	u32 abi;
+	u32 reserved;
+	u32 cluster_num;
+	u32 dvfs_tbl_type;
+	u32 root_cluster;
+	u32 is_ptp_policy_activate;
+	u64 table_epoch;
+	struct mt6797_dvfsp_ppm_cluster_snapshot
+		cluster[MT6797_DVFSP_PPM_CLUSTER_COUNT];
+};
+
+int mt6797_dvfsp_ppm_snapshot_validate(
+	const struct mt6797_dvfsp_ppm_snapshot *snapshot);
+
+/* Map the vendor index interval to the current frequency interval. */
+int mt6797_dvfsp_ppm_snapshot_current_limit(
+	const struct mt6797_dvfsp_ppm_snapshot *snapshot,
+	u32 cluster_id, u32 *floor_khz, u32 *ceiling_khz);
+
+#endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_PPM_H */

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-ppm.c b/drivers/soc/mediatek/mt6797-dvfsp-ppm.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-dvfsp-ppm.c
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Validate a copied MT6797 vendor PPM snapshot.
+ *
+ * The real owner must copy this object while holding the vendor
+ * ppm_main_info.lock and the external clock/rail transition lock. This file
+ * intentionally has no access to either private owner and performs no I/O.
+ */
+
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-ppm.h>
+
+static int mt6797_dvfsp_ppm_cluster_check(
+	const struct mt6797_dvfsp_ppm_cluster_snapshot *cluster,
+	u32 expected_id, u32 expected_cpu, u32 expected_cores)
+{
+	u32 previous_frequency = ~0U;
+	u32 i;
+
+	if (!cluster || cluster->cluster_id != expected_id ||
+	    cluster->cpu_id != expected_cpu ||
+	    cluster->core_num != expected_cores ||
+	    cluster->dvfs_opp_num != MT6797_DVFSP_PPM_TABLE_ENTRIES ||
+	    cluster->min_cpufreq_idx < 0 ||
+	    cluster->max_cpufreq_idx < 0 ||
+	    cluster->max_cpufreq_idx > cluster->min_cpufreq_idx ||
+    cluster->min_cpufreq_idx >= MT6797_DVFSP_PPM_TABLE_ENTRIES ||
+    cluster->max_cpufreq_idx >= MT6797_DVFSP_PPM_TABLE_ENTRIES ||
+    cluster->min_cpu_core > cluster->max_cpu_core ||
+    cluster->max_cpu_core > expected_cores ||
+    cluster->has_advise_freq > 1 || cluster->has_advise_core > 1)
+		return -EPROTO;
+
+	if (!cluster->has_advise_freq && cluster->advise_cpufreq_idx != -1)
+		return -EPROTO;
+	if (cluster->has_advise_freq &&
+	    (cluster->advise_cpufreq_idx < 0 ||
+    cluster->advise_cpufreq_idx >= MT6797_DVFSP_PPM_TABLE_ENTRIES))
+		return -EPROTO;
+	if (!cluster->has_advise_core && cluster->advise_cpu_core != -1)
+		return -EPROTO;
+	if (cluster->has_advise_core &&
+	    (cluster->advise_cpu_core < 0 ||
+    cluster->advise_cpu_core > expected_cores))
+		return -EPROTO;
+
+	for (i = 0; i < MT6797_DVFSP_PPM_TABLE_ENTRIES; i++) {
+		if (!cluster->frequency_khz[i] ||
+		    cluster->frequency_khz[i] >= previous_frequency)
+			return -EPROTO;
+		previous_frequency = cluster->frequency_khz[i];
+	}
+
+	return 0;
+}
+
+int mt6797_dvfsp_ppm_snapshot_validate(
+	const struct mt6797_dvfsp_ppm_snapshot *snapshot)
+{
+	int ret;
+
+	if (!snapshot || snapshot->abi != MT6797_DVFSP_PPM_SOURCE_ABI ||
+	    snapshot->reserved ||
+	    snapshot->cluster_num != MT6797_DVFSP_PPM_CLUSTER_COUNT ||
+	    snapshot->dvfs_tbl_type > MT6797_DVFSP_PPM_TABLE_TYPE_MB ||
+	    snapshot->root_cluster >= MT6797_DVFSP_PPM_CLUSTER_COUNT ||
+	    snapshot->is_ptp_policy_activate > 1 || !snapshot->table_epoch)
+		return -EPROTO;
+
+	ret = mt6797_dvfsp_ppm_cluster_check(
+		&snapshot->cluster[MT6797_DVFSP_PPM_CLUSTER_LL],
+		MT6797_DVFSP_PPM_CLUSTER_LL, MT6797_DVFSP_PPM_LL_CPU_ID,
+		MT6797_DVFSP_PPM_LL_CORE_COUNT);
+	if (ret)
+		return ret;
+	ret = mt6797_dvfsp_ppm_cluster_check(
+		&snapshot->cluster[MT6797_DVFSP_PPM_CLUSTER_L],
+		MT6797_DVFSP_PPM_CLUSTER_L, MT6797_DVFSP_PPM_L_CPU_ID,
+		MT6797_DVFSP_PPM_L_CORE_COUNT);
+	if (ret)
+		return ret;
+
+	return mt6797_dvfsp_ppm_cluster_check(
+		&snapshot->cluster[MT6797_DVFSP_PPM_CLUSTER_B],
+		MT6797_DVFSP_PPM_CLUSTER_B, MT6797_DVFSP_PPM_B_CPU_ID,
+		MT6797_DVFSP_PPM_B_CORE_COUNT);
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_ppm_snapshot_validate);
+
+int mt6797_dvfsp_ppm_snapshot_current_limit(
+	const struct mt6797_dvfsp_ppm_snapshot *snapshot,
+	u32 cluster_id, u32 *floor_khz, u32 *ceiling_khz)
+{
+	const struct mt6797_dvfsp_ppm_cluster_snapshot *cluster;
+	int ret;
+
+	if (!floor_khz || !ceiling_khz ||
+	    cluster_id >= MT6797_DVFSP_PPM_CLUSTER_COUNT)
+		return -EINVAL;
+	ret = mt6797_dvfsp_ppm_snapshot_validate(snapshot);
+	if (ret)
+		return ret;
+
+	cluster = &snapshot->cluster[cluster_id];
+	*floor_khz = cluster->frequency_khz[cluster->min_cpufreq_idx];
+	*ceiling_khz = cluster->frequency_khz[cluster->max_cpufreq_idx];
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_ppm_snapshot_current_limit);
+
+MODULE_DESCRIPTION("MT6797 PPM snapshot contract");
+MODULE_LICENSE("GPL");

diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -7,2 +7,3 @@ obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-handoff.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND) += mt6797-dvfsp-clock-backend.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND) += mt6797-dvfsp-cspm-state.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-ppm.o
-- 
