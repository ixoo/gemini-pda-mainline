From 0000000000000000000000000000000000000213 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sun, 9 Aug 2026 20:00:00 -0400
Subject: [PATCH] soc: mediatek: decode MT6797 PTP handoff state

The retained LK M_HW_RES payload is now a validated read-only source, but
passing it as opaque words still lets a future calibration owner ignore the
silicon-selected EEM detector state. Decode the exact public MT6797
eem_devinfo layout for the BIG, L, 2L, and CCI detectors: INIT/MON enable,
DVFS level, and bin selection. Require all four calibrated detectors to be
enabled before the owner callback is reached.

This is a pure conversion boundary. It performs no MMIO, EEM phase change,
efuse read, regulator or clock operation, secure call, provider registration,
firmware action, device boot, or CPU8/CPU9 admission. The future owner still
supplies the efuse variant, PPM limits, live rails, clocks, generations, and
transition lock. A nonzero variant identity is now mandatory provenance.
This patch is experiment-only and not submission-ready.
---
 drivers/soc/mediatek/Makefile                          |  1 +
 drivers/soc/mediatek/mt6797-dvfsp-ptp.c                | 82 ++++++++++++++++++
 drivers/soc/mediatek/mt6797-dvfsp-state-source.c       | 10 +++-
 drivers/soc/mediatek/mt6797-dvfsp-handoff.c            |  2 +-
 drivers/thermal/mediatek/auxadc_thermal.c              |  2 +-
 include/linux/soc/mediatek/mt6797-dvfsp-ptp.h          | 30 +++++++
 include/linux/soc/mediatek/mt6797-dvfsp-state-source.h |  2 +
 7 files changed, 125 insertions(+), 4 deletions(-)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-ptp.c

diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -3,1 +3,2 @@
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-source-backends.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-ptp.o

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-ptp.h b/include/linux/soc/mediatek/mt6797-dvfsp-ptp.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-ptp.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-ptp.h
@@ -7,9 +7,39 @@
+#include <linux/bitops.h>
 
 #define MT6797_DVFSP_PTP_HANDOFF_ABI		1
 #define MT6797_DVFSP_PTP_HANDOFF_WORDS		19
+#define MT6797_DVFSP_PTP_STATE_ABI		1
+#define MT6797_DVFSP_PTP_BANK_MASK_BIG		BIT(0)
+#define MT6797_DVFSP_PTP_BANK_MASK_L		BIT(1)
+#define MT6797_DVFSP_PTP_BANK_MASK_2L		BIT(2)
+#define MT6797_DVFSP_PTP_BANK_MASK_CCI		BIT(3)
+#define MT6797_DVFSP_PTP_BANK_MASK_ALL		GENMASK(3, 0)
+#define MT6797_DVFSP_PTP_BANK_BIG		0
+#define MT6797_DVFSP_PTP_BANK_L		3
+#define MT6797_DVFSP_PTP_BANK_2L		4
+#define MT6797_DVFSP_PTP_BANK_CCI		5
 
 struct mt6797_dvfsp_ptp_handoff {
 	u32 abi;
 	u32 m_hw_res[MT6797_DVFSP_PTP_HANDOFF_WORDS];
 };
+
+struct mt6797_dvfsp_ptp_bank_state {
+	u32 bank;
+	u32 init_enable;
+	u32 mon_enable;
+	u32 dvfs_level;
+	u32 bin_spec;
+};
+
+struct mt6797_dvfsp_ptp_state {
+	u32 abi;
+	u32 bank_mask;
+	struct mt6797_dvfsp_ptp_bank_state
+		bank[4];
+};
+
+int mt6797_dvfsp_ptp_decode(
+	const struct mt6797_dvfsp_ptp_handoff *handoff,
+	struct mt6797_dvfsp_ptp_state *state);
 
 #endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_PTP_H */

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-ptp.c b/drivers/soc/mediatek/mt6797-dvfsp-ptp.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-dvfsp-ptp.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Decode the read-only MT6797 LK M_HW_RES detector handoff.
+ *
+ * The bit positions mirror the public MT6797 eem_devinfo structure. This
+ * helper is deliberately pure: the caller owns the handoff storage and no
+ * detector or hardware state is changed here.
+ */
+
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/bitops.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-ptp.h>
+
+static void mt6797_dvfsp_ptp_decode_bank(
+	struct mt6797_dvfsp_ptp_bank_state *bank, u32 bank_id,
+	u32 enable_word, u32 init_shift, u32 mon_shift,
+	u32 dvfs_shift, u32 bin_shift)
+{
+	bank->bank = bank_id;
+	bank->init_enable = (enable_word >> init_shift) & 0x1;
+	bank->mon_enable = (enable_word >> mon_shift) & 0x1;
+	bank->dvfs_level = (enable_word >> dvfs_shift) & 0x3;
+	bank->bin_spec = (enable_word >> bin_shift) & 0x7;
+}
+
+int mt6797_dvfsp_ptp_decode(
+	const struct mt6797_dvfsp_ptp_handoff *handoff,
+	struct mt6797_dvfsp_ptp_state *state)
+{
+	if (!handoff || !state ||
+	    handoff->abi != MT6797_DVFSP_PTP_HANDOFF_ABI)
+		return -EINVAL;
+
+	memset(state, 0, sizeof(*state));
+	state->abi = MT6797_DVFSP_PTP_STATE_ABI;
+	state->bank_mask = MT6797_DVFSP_PTP_BANK_MASK_ALL;
+
+	/* M_HW_RES1: BIG_INITEN/MONEN/DVFS_L/BIN_SPEC. */
+	mt6797_dvfsp_ptp_decode_bank(&state->bank[0],
+		MT6797_DVFSP_PTP_BANK_BIG, handoff->m_hw_res[1], 0, 1, 2, 5);
+	/* M_HW_RES7: CPU_L_INITEN/MONEN/DVFS_L/BIN_SPEC. */
+	mt6797_dvfsp_ptp_decode_bank(&state->bank[1],
+		MT6797_DVFSP_PTP_BANK_L, handoff->m_hw_res[7], 0, 1, 2, 5);
+	/* M_HW_RES9 low fields: CPU_2L_INITEN/MONEN/DVFS_L/BIN_SPEC. */
+	mt6797_dvfsp_ptp_decode_bank(&state->bank[2],
+		MT6797_DVFSP_PTP_BANK_2L, handoff->m_hw_res[9], 0, 1, 2, 5);
+	/* M_HW_RES9 high fields: CCI_INITEN/MONEN/DVFS_L/BIN_SPEC. */
+	mt6797_dvfsp_ptp_decode_bank(&state->bank[3],
+		MT6797_DVFSP_PTP_BANK_CCI, handoff->m_hw_res[9], 8, 9, 10, 13);
+
+	if (!state->bank[0].init_enable || !state->bank[0].mon_enable ||
+	    !state->bank[1].init_enable || !state->bank[1].mon_enable ||
+	    !state->bank[2].init_enable || !state->bank[2].mon_enable ||
+	    !state->bank[3].init_enable || !state->bank[3].mon_enable)
+		return -EAGAIN;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_ptp_decode);
+
+MODULE_DESCRIPTION("MT6797 read-only PTP handoff decoder");
+MODULE_LICENSE("GPL");

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-state-source.c b/drivers/soc/mediatek/mt6797-dvfsp-state-source.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-state-source.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-state-source.c
@@ -39,6 +39,7 @@ int mt6797_dvfsp_state_source_snapshot(
 	struct mt6797_eem_readback eem_readback;
 	struct mt6797_dvfsp_ptp_handoff ptp_handoff;
+	struct mt6797_dvfsp_ptp_state ptp_state;
 	struct mt6797_dvfsp_clock_state clock_state;
 	struct mt6797_eem_calibration_input calibration_input;
@@ -72,8 +73,15 @@ int mt6797_dvfsp_state_source_snapshot(
 	if (ret)
 		return ret;
 
+	ret = mt6797_dvfsp_ptp_decode(&ptp_handoff, &ptp_state);
+	if (ret)
+		return ret;
+
 	memset(&calibration_input, 0, sizeof(calibration_input));
-	ret = ops->fill_calibration(context, &ptp_handoff, &eem_readback,
+	ret = ops->fill_calibration(context, &ptp_handoff, &ptp_state,
+					    &eem_readback,
 					    &calibration_input);
 	if (ret)
 		return ret;

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-state-source.h b/include/linux/soc/mediatek/mt6797-dvfsp-state-source.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-state-source.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-state-source.h
@@ -45,6 +45,7 @@ struct mt6797_dvfsp_state_source_ops {
 	int (*fill_calibration)(void *context,
 				const struct mt6797_dvfsp_ptp_handoff *handoff,
+				const struct mt6797_dvfsp_ptp_state *ptp_state,
 				const struct mt6797_eem_readback *readback,
 				struct mt6797_eem_calibration_input *input);

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-handoff.c b/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
@@ -1580,7 +1580,7 @@ mt6797_dvfsp_state_provenance_check(
 	    provenance->source_mask !=
 		MT6797_DVFSP_STATE_PROVENANCE_SOURCE_ALL ||
-	    !provenance->table_epoch || !provenance->calibration_handle)
+	    !provenance->variant_id || !provenance->table_epoch ||
+	    !provenance->calibration_handle)
 		return -EPROTO;

diff --git a/drivers/thermal/mediatek/auxadc_thermal.c b/drivers/thermal/mediatek/auxadc_thermal.c
--- a/drivers/thermal/mediatek/auxadc_thermal.c
+++ b/drivers/thermal/mediatek/auxadc_thermal.c
@@ -1078,7 +1078,7 @@ mt6797_eem_calibration_provenance_check(
 	    provenance->abi != MT6797_DVFSP_STATE_PROVENANCE_ABI ||
 	    provenance->source_mask != MT6797_DVFSP_STATE_PROVENANCE_SOURCE_ALL ||
-	    !provenance->table_epoch || !provenance->calibration_handle)
+	    !provenance->variant_id || !provenance->table_epoch ||
+	    !provenance->calibration_handle)
 		return -EPROTO;

