From eb0d1b1039df31328c564c5ae4a1b745d36135ff Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 4 Sep 2026 13:02:00 +0000
Subject: [PATCH 2/2] arm64: dts: mediatek: add Gemini thermal serviceability

Enable only the MT6797 thermal consumer in a dedicated board DT.

Add one trip-free zone and leave standalone AUXADC disabled.
---
 arch/arm64/boot/dts/mediatek/Makefile         |  1 +
 ...6797-gemini-pda-thermal-serviceability.dts | 22 +++++++++++++++++++
 2 files changed, 23 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-thermal-serviceability.dts

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index 2b77bae..ee0a80d 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -6,6 +6,7 @@ dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-gemini-pda.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-gemini-pda-thermal-serviceability.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-gemini-pda-clock-backend-entry.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-gemini-pda-protected-readback.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-gemini-pda-a72-physical-source.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-thermal-serviceability.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-thermal-serviceability.dts
new file mode 100644
index 0000000..662256f
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-thermal-serviceability.dts
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 Julien Etienne
+ */
+
+#include "mt6797-gemini-pda.dts"
+
+/ {
+	model = "Planet Computers Gemini PDA (thermal serviceability)";
+
+	thermal-zones {
+		soc-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <1000>;
+			thermal-sensors = <&thermal>;
+		};
+	};
+};
+
+&thermal {
+	status = "okay";
+};
