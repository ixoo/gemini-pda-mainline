From 5d292ed53ee64ef995f8e324858b1e514842ae84 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 25 Aug 2026 19:01:00 +0000
Subject: [PATCH 1/3] soc: mediatek: defer A72 platform/provider until provider
 ready

Require an explicit bound DA9214 endpoint before any platform read or retained checkpoint, hold both device references through the one-shot capture, and retain the existing read-only ceiling.
---
 ...form-provider-snapshot-observer-internal.h |  1 +
 ...-a72-platform-provider-snapshot-observer.c | 44 ++++++++++++++++++-
 2 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-internal.h b/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-internal.h
index ca1b106..11111b2 100644
--- a/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-internal.h
+++ b/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-internal.h
@@ -22,6 +22,7 @@ struct mt6797_a72_platform_provider_observer_ops {
 };
 
 int mt6797_a72_pp_capture(struct device *platform,
+			  struct device *provider,
 			  const struct mt6797_a72_platform_provider_observer_ops *ops,
 			  void *context,
 			  struct mt6797_a72_platform_provider_snapshot *snapshot);
diff --git a/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer.c b/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer.c
index 5ddeb15..8990710 100644
--- a/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer.c
+++ b/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer.c
@@ -4,6 +4,7 @@
 #include <linux/device.h>
 #include <linux/err.h>
 #include <linux/errno.h>
+#include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/mt6797-a72-provider.h>
 #include <linux/of.h>
@@ -47,6 +48,7 @@ mt6797_a72_platform_provider_ops = {
 };
 
 int mt6797_a72_pp_capture(struct device *platform,
+			  struct device *provider,
 			  const struct mt6797_a72_platform_provider_observer_ops *ops,
 			  void *context,
 			  struct mt6797_a72_platform_provider_snapshot *snapshot)
@@ -56,6 +58,8 @@ int mt6797_a72_pp_capture(struct device *platform,
 	if (!snapshot)
 		return -EINVAL;
 	memset(snapshot, 0, sizeof(*snapshot));
+	if (!provider)
+		return -EPROBE_DEFER;
 	if (!platform || !ops || !ops->platform || !ops->checkpoint ||
 	    !ops->provider)
 		return -EINVAL;
@@ -112,6 +116,31 @@ mt6797_a72_platform_provider_get_device(struct device *dev)
 	return &source->dev;
 }
 
+static struct device *
+mt6797_a72_platform_provider_get_provider(struct device *dev)
+{
+	struct i2c_client *provider;
+	struct device_node *node;
+
+	node = of_parse_phandle(dev->of_node, "mediatek,provider", 0);
+	if (!node)
+		return ERR_PTR(-EINVAL);
+	if (!of_device_is_compatible(node, "dlg,da9214-legacy")) {
+		of_node_put(node);
+		return ERR_PTR(-EINVAL);
+	}
+	provider = of_find_i2c_device_by_node(node);
+	of_node_put(node);
+	if (!provider)
+		return ERR_PTR(-EPROBE_DEFER);
+	if (!device_is_bound(&provider->dev)) {
+		put_device(&provider->dev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
+	return &provider->dev;
+}
+
 static void mt6797_a72_pp_log(struct device *dev,
 			      const struct mt6797_a72_platform_provider_snapshot *snapshot)
 {
@@ -141,7 +170,8 @@ static void mt6797_a72_pp_log(struct device *dev,
 		 provider->vbuckb_b);
 	dev_info(dev,
 		 MT6797_A72_PLATFORM_PROVIDER_TAG
-		 " state=complete platform_calls=1 platform_samples=2"
+		 " state=complete provider_ready_gate=passed"
+		 " platform_calls=1 platform_samples=2"
 		 " platform_register_observations=26 retained_writes=2"
 		 " provider_snapshots=1 provider_samples=2 provider_i2c_reads=10"
 		 " provider_i2c_writes=0 observer_retries=0"
@@ -154,6 +184,7 @@ static int mt6797_a72_platform_provider_probe(struct platform_device *pdev)
 {
 	struct mt6797_a72_platform_provider_snapshot snapshot;
 	struct device *platform;
+	struct device *provider;
 	struct device *dev = &pdev->dev;
 	int ret;
 
@@ -162,13 +193,22 @@ static int mt6797_a72_platform_provider_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(platform),
 				     "platform-state source unavailable\n");
 
-	ret = mt6797_a72_pp_capture(platform,
+	provider = mt6797_a72_platform_provider_get_provider(dev);
+	if (IS_ERR(provider)) {
+		ret = dev_err_probe(dev, PTR_ERR(provider),
+				    "provider unavailable\n");
+		goto out_put_platform;
+	}
+
+	ret = mt6797_a72_pp_capture(platform, provider,
 				    &mt6797_a72_platform_provider_ops,
 				    NULL, &snapshot);
 	if (ret)
 		dev_err_probe(dev, ret, "platform/provider snapshot failed\n");
 	else
 		mt6797_a72_pp_log(dev, &snapshot);
+	put_device(provider);
+out_put_platform:
 	put_device(platform);
 
 	return ret;
