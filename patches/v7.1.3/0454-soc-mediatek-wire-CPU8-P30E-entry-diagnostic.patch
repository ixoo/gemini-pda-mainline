From 7abe377aeb341bf69bc3dd612ef18280f51c71b3 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 31 Aug 2026 15:01:00 +0000
Subject: [PATCH] soc: mediatek: wire CPU8 P30E entry diagnostic

The exact CPU8 power transaction now reaches a zero-returning
CPU_ON callback but times out waiting for generic arm64 secondary
completion. The existing P30E wire can distinguish whether the
target reached secondary_entry, but no controller arms it.

Prepare and arm the existing CPU8-only P30E object immediately
before CPU_ON, then take one controller readback on an error or
rollback. Expose EMPTY, CLAIMED, and PUBLISHED states through the
existing read-only admission status. Keep CPU9, CPU_OFF, retries,
and all power-sequence calls unchanged.
---
 arch/arm64/kernel/mt6797_a72_membership.c     |  13 +-
 .../mt6797-a72-admission-controller.c         |  26 ++-
 .../soc/mediatek/mt6797-a72-binder-internal.h |  23 +++
 drivers/soc/mediatek/mt6797-a72-binder-test.c | 150 +++++++++++++++++
 drivers/soc/mediatek/mt6797-a72-binder.c      | 157 ++++++++++++++++--
 .../linux/soc/mediatek/mt6797-a72-binder.h    |  13 +-
 6 files changed, 361 insertions(+), 21 deletions(-)

diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index ecd3380..45442a2 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -1459,6 +1459,7 @@ int mt6797_a72_membership_prepare_p30e_handoff(
 	unsigned int cpu;
 	unsigned long flags;
 	u64 operation;
+	bool cpu8_on_ready;
 	int ret;
 
 	if (!transaction || !ready || !handoff)
@@ -1509,10 +1510,20 @@ int mt6797_a72_membership_prepare_p30e_handoff(
 
 	mutex_lock(&a72_transition_lock);
 	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	cpu8_on_ready = identity->operation ==
+		ARM64_LATE_CPU_STARTUP_OP_CPU8_UP &&
+		a72_owner.phase == MT6797_A72_PHASE_ON_ISSUED &&
+		a72_owner.active.p17_p18_published &&
+		a72_owner.active.p27_valid && a72_owner.active.p28_valid &&
+		a72_owner.active.p28_preparation.stage ==
+			MT6797_A72_P28_STAGE_COMPLETE &&
+		a72_owner.provider_state == MT6797_A72_PROVIDER_HELD &&
+		a72_owner.active.provider_acquire_valid &&
+		a72_owner.active.budgets.cpu_on == MT6797_A72_BUDGET_AVAILABLE;
 	if (a72_owner.health != MT6797_A72_OWNER_AVAILABLE ||
-	    a72_owner.phase != MT6797_A72_PHASE_FROZEN ||
 	    !a72_owner.active.valid || !a72_owner.active.a36_valid ||
 	    !a72_owner.active.p30_token_valid ||
+	    (a72_owner.phase != MT6797_A72_PHASE_FROZEN && !cpu8_on_ready) ||
 	    memcmp(&a72_owner.active.identity, identity,
 		   sizeof(a72_owner.active.identity)))
 		ret = -EBUSY;
diff --git a/drivers/soc/mediatek/mt6797-a72-admission-controller.c b/drivers/soc/mediatek/mt6797-a72-admission-controller.c
index 83a6d77..76662b7 100644
--- a/drivers/soc/mediatek/mt6797-a72-admission-controller.c
+++ b/drivers/soc/mediatek/mt6797-a72-admission-controller.c
@@ -416,11 +416,29 @@ static ssize_t status_show(struct device *dev, struct device_attribute *attr,
 			     (unsigned long long)diagnostic.sram_attempt_id,
 			     (unsigned long long)diagnostic.sram_cookie,
 			     diagnostic.sram_error);
+	len += sysfs_emit_at(buf, len,
+			     "sram_effect_attempted=%u sram_verified=%u sram_sealed=%u ",
+			     diagnostic.sram_effect_attempted,
+			     diagnostic.sram_verified,
+			     diagnostic.sram_sealed);
+	len += sysfs_emit_at(buf, len,
+			     "p30e_prepare_attempted=%u p30e_prepare_ret=%d ",
+			     diagnostic.p30e_prepare_attempted,
+			     diagnostic.p30e_prepare_ret);
+	len += sysfs_emit_at(buf, len,
+			     "p30e_arm_attempted=%u p30e_arm_ret=%d p30e_armed=%u ",
+			     diagnostic.p30e_arm_attempted,
+			     diagnostic.p30e_arm_ret, diagnostic.p30e_armed);
+	len += sysfs_emit_at(buf, len,
+			     "p30e_readback_attempted=%u p30e_readback_ret=%d ",
+			     diagnostic.p30e_readback_attempted,
+			     diagnostic.p30e_readback_ret);
 	return len + sysfs_emit_at(buf, len,
-				   "sram_effect_attempted=%u sram_verified=%u sram_sealed=%u\n",
-				   diagnostic.sram_effect_attempted,
-				   diagnostic.sram_verified,
-				   diagnostic.sram_sealed);
+				   "p30e_controller_state=%u p30e_target_state=%u p30e_target_sequence=%u p30e_controller_sequence=%u\n",
+				   diagnostic.p30e_controller_state,
+				   diagnostic.p30e_target_state,
+				   diagnostic.p30e_target_sequence,
+				   diagnostic.p30e_controller_sequence);
 }
 
 static ssize_t trigger_store(struct device *dev,
