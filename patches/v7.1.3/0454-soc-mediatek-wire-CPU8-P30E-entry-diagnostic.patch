+#ifdef CONFIG_ARM64_MT6797_A72_P30E_WIRE
+	.p30e_prepare = mt6797_binder_test_p30e_prepare,
+	.p30e_arm = mt6797_binder_test_p30e_arm,
+	.p30e_readback = mt6797_binder_test_p30e_readback,
+#endif
 	.membership_publish_success = mt6797_binder_test_publish_success,
 	.membership_finalize_success = mt6797_binder_test_finalize_success,
 	.watchdog_takeover = mt6797_binder_test_watchdog,
@@ -529,6 +610,17 @@ static void mt6797_binder_success_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, state->terminal_checkpoints, 1U);
 	KUNIT_EXPECT_EQ(test, state->membership_publishes, 1U);
 	KUNIT_EXPECT_EQ(test, state->membership_finalizes, 1U);
+#ifdef CONFIG_ARM64_MT6797_A72_P30E_WIRE
+	KUNIT_EXPECT_EQ(test, state->p30e_prepares, 1U);
+	KUNIT_EXPECT_EQ(test, state->p30e_arms, 1U);
+	KUNIT_EXPECT_EQ(test, state->p30e_readbacks, 0U);
+	KUNIT_EXPECT_LT(test, mt6797_binder_test_find(state,
+					      TEST_EVENT_P30E_PREPARE),
+			mt6797_binder_test_find(state, TEST_EVENT_P30E_ARM));
+	KUNIT_EXPECT_LT(test, mt6797_binder_test_find(state,
+					      TEST_EVENT_P30E_ARM),
+			mt6797_binder_test_find(state, TEST_EVENT_CPU_ON));
+#endif
 	KUNIT_EXPECT_EQ(test, state->binder.result.cpu_off_requests, 0U);
 	KUNIT_EXPECT_EQ(test, state->binder.result.retries, 0U);
 	KUNIT_EXPECT_LT(test, mt6797_binder_test_find(state,
@@ -717,6 +809,61 @@ static void mt6797_binder_sram_selector_mask_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, state->cpu_boots, 0U);
 }
 
+#ifdef CONFIG_ARM64_MT6797_A72_P30E_WIRE
+static void mt6797_binder_p30e_readback_test(struct kunit *test)
+{
+	static const u32 target_states[] = {
+		ARM64_MT6797_A72_P30E_EMPTY,
+		ARM64_MT6797_A72_P30E_TARGET_CLAIMED,
+		ARM64_MT6797_A72_P30E_TARGET_PUBLISHED,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(target_states); i++) {
+		struct mt6797_binder_test_state *state;
+		struct mt6797_a72_binder_diagnostic diagnostic;
+		bool publish_p32 = false;
+		int ret;
+
+		state = kunit_kzalloc(test, sizeof(*state), GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, state);
+		mt6797_binder_test_active = state;
+		mt6797_a72_binder_test_init(&state->binder,
+					    &mt6797_binder_test_ops);
+		KUNIT_ASSERT_EQ(test, mt6797_a72_binder_test_boot(
+			&state->binder, 8, mt6797_binder_test_cpu_boot), 0);
+		state->p30e_target_state = target_states[i];
+		ret = mt6797_a72_binder_test_failure(&state->binder, 8, -EIO,
+					     &publish_p32);
+		KUNIT_ASSERT_EQ(test, ret, 0);
+		KUNIT_EXPECT_TRUE(test, publish_p32);
+		mt6797_a72_binder_test_diagnostic(&state->binder, &diagnostic);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_prepare_attempted, 1U);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_prepare_ret, 0);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_arm_attempted, 1U);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_arm_ret, 0);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_armed, 1U);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_readback_attempted, 1U);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_readback_ret,
+			target_states[i] >= ARM64_MT6797_A72_P30E_TARGET_PUBLISHED ?
+			0 : -EAGAIN);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_controller_state,
+				ARM64_MT6797_A72_P30E_ARMED);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_target_state,
+				target_states[i]);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_target_sequence,
+				target_states[i] >=
+				ARM64_MT6797_A72_P30E_TARGET_PUBLISHED);
+		KUNIT_EXPECT_EQ(test, diagnostic.p30e_controller_sequence, 1U);
+		KUNIT_EXPECT_EQ(test, state->p30e_readbacks, 1U);
+		ret = mt6797_a72_binder_test_failure(&state->binder, 8, -EIO,
+					     &publish_p32);
+		KUNIT_EXPECT_EQ(test, ret, 0);
+		KUNIT_EXPECT_EQ(test, state->p30e_readbacks, 1U);
+	}
+}
+#endif
+
 static void mt6797_binder_one_shot_test(struct kunit *test)
 {
 	struct mt6797_binder_test_state *state = test->priv;
@@ -748,6 +895,9 @@ static struct kunit_case mt6797_binder_test_cases[] = {
 	KUNIT_CASE(mt6797_binder_p27_diagnostic_test),
 	KUNIT_CASE(mt6797_binder_sram_diagnostic_test),
 	KUNIT_CASE(mt6797_binder_sram_selector_mask_test),
+#ifdef CONFIG_ARM64_MT6797_A72_P30E_WIRE
+	KUNIT_CASE(mt6797_binder_p30e_readback_test),
+#endif
 	KUNIT_CASE(mt6797_binder_one_shot_test),
 	{}
 };
