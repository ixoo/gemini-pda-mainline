+#ifdef CONFIG_ARM64_MT6797_A72_P30E_WIRE
+static int
+mt6797_binder_test_p30e_prepare(
+	const struct mt6797_a72_transaction *transaction,
+	struct mt6797_a72_p30e_handoff *handoff)
+{
+	struct mt6797_binder_test_state *state = mt6797_binder_test_active;
+
+	if (!transaction || !transaction->p28_valid || !handoff)
+		return -EPROTO;
+	memset(handoff, 0, sizeof(*handoff));
+	handoff->target_cpu = 8;
+	handoff->slot_pa = SZ_2K;
+	handoff->entry_pa = SZ_4K;
+	handoff->operation = ARM64_MT6797_A72_P30E_OPERATION_CPU8_UP;
+	handoff->generation = TEST_GENERATION;
+	handoff->cookie = TEST_COOKIE;
+	handoff->wire_boot_identity[0] = 1;
+	handoff->target_boot_identity[0] = 1;
+	state->p30e_prepares++;
+	mt6797_binder_test_event(TEST_EVENT_P30E_PREPARE);
+	return 0;
+}
+
+static int
+mt6797_binder_test_p30e_arm(
+	unsigned int cpu, const struct mt6797_a72_p30e_handoff *handoff)
+{
+	struct mt6797_binder_test_state *state = mt6797_binder_test_active;
+
+	if (!handoff || cpu != 8 || handoff->target_cpu != 8 ||
+	    handoff->operation != ARM64_MT6797_A72_P30E_OPERATION_CPU8_UP ||
+	    handoff->generation != TEST_GENERATION ||
+	    handoff->cookie != TEST_COOKIE)
+		return -EPROTO;
+	state->p30e_arms++;
+	mt6797_binder_test_event(TEST_EVENT_P30E_ARM);
+	return 0;
+}
+
+static int
+mt6797_binder_test_p30e_readback(
+	unsigned int cpu, const struct mt6797_a72_p30e_handoff *handoff,
+	struct arm64_mt6797_a72_p30e_wire *copy)
+{
+	struct mt6797_binder_test_state *state = mt6797_binder_test_active;
+	u32 target = state->p30e_target_state;
+
+	if (!handoff || !copy || cpu != 8 || handoff->target_cpu != 8)
+		return -EPROTO;
+	memset(copy, 0, sizeof(*copy));
+	copy->word[ARM64_MT6797_A72_P30E_CONTROLLER_STATE_WORD] =
+		cpu_to_le64(ARM64_MT6797_A72_P30E_ARMED);
+	copy->word[ARM64_MT6797_A72_P30E_TARGET_STATE_WORD] =
+		cpu_to_le64(target);
+	copy->word[ARM64_MT6797_A72_P30E_CONTROLLER_SEQUENCE_WORD] =
+		cpu_to_le64(1);
+	copy->word[ARM64_MT6797_A72_P30E_TARGET_SEQUENCE_WORD] =
+		cpu_to_le64(target >= ARM64_MT6797_A72_P30E_TARGET_PUBLISHED);
+	state->p30e_readbacks++;
+	mt6797_binder_test_event(TEST_EVENT_P30E_READBACK);
+	return target >= ARM64_MT6797_A72_P30E_TARGET_PUBLISHED ? 0 : -EAGAIN;
+}
+#endif
+
 static int mt6797_binder_test_publish_success(struct mt6797_a72_transaction *transaction)
 {
 	struct mt6797_binder_test_state *state = mt6797_binder_test_active;
@@ -455,6 +531,11 @@ static const struct mt6797_a72_binder_backend_ops mt6797_binder_test_ops = {
 	.membership_complete_p28 = mt6797_binder_test_complete_p28,
