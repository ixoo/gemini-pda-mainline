From 0000000000000000000000000000000000000243 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 20:00:00 -0400
Subject: [PATCH] soc: mediatek: bind runtime invalidation to provider

Expose a callback form of the existing generation-tagged runtime ledger and
route those validated lifecycle events to the calibrated provider's explicit
invalidation path. This keeps CPU hotplug and suspend events fail-closed
without registering notifier hooks or requiring an active handoff owner.

The ledger still rejects malformed, replayed, and non-monotonic events before
the provider is invalidated. No MMIO, regulator or clock operation, secure
call, provider registration, device boot, or CPU8/CPU9 admission is added.
This is experiment-only and not submission-ready.
---
 drivers/soc/mediatek/mt6797-dvfsp-calibrated-provider.c | 18 ++++++++++++++++++
 drivers/soc/mediatek/mt6797-dvfsp-runtime.c             | 33 +++++++++++++++++++++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-calibrated-provider.h |  6 ++++++
 include/linux/soc/mediatek/mt6797-dvfsp-runtime.h       |  7 +++++++
 4 files changed, 64 insertions(+)

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-runtime.h b/include/linux/soc/mediatek/mt6797-dvfsp-runtime.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-runtime.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-runtime.h
@@ -39,4 +39,11 @@ int mt6797_dvfsp_runtime_event_apply(
 	const struct mt6797_dvfsp_runtime_event *event,
 	struct mt6797_dvfsp_runtime_ledger *ledger);
+
+int mt6797_dvfsp_runtime_event_apply_invalidator(
+	const struct mt6797_dvfsp_runtime_event *event,
+	struct mt6797_dvfsp_runtime_ledger *ledger,
+	void (*invalidate)(void *context,
+				enum mt6797_dvfsp_state_invalidation_reason reason),
+	void *context);
 
 #endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_RUNTIME_H */

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-calibrated-provider.h b/include/linux/soc/mediatek/mt6797-dvfsp-calibrated-provider.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-calibrated-provider.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-calibrated-provider.h
@@ -9,4 +9,5 @@
 #include <linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h>
 #include <linux/soc/mediatek/mt6797-dvfsp-identity-source.h>
 #include <linux/soc/mediatek/mt6797-dvfsp-live-source.h>
 #include <linux/soc/mediatek/mt6797-dvfsp-ppm-source.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-runtime.h>
@@ -132,3 +133,8 @@ int mt6797_dvfsp_calibrated_provider_bind_sources(
 	void *source_context, u64 owner_handle, u64 transition_handle);
+
+int mt6797_dvfsp_calibrated_provider_apply_runtime_event(
+	struct mt6797_dvfsp_calibrated_provider *provider,
+	const struct mt6797_dvfsp_runtime_event *event,
+	struct mt6797_dvfsp_runtime_ledger *ledger);
 
 #endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_CALIBRATED_PROVIDER_H */

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-runtime.c b/drivers/soc/mediatek/mt6797-dvfsp-runtime.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-runtime.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-runtime.c
@@ -82,5 +82,38 @@ int mt6797_dvfsp_runtime_event_apply(
 }
 EXPORT_SYMBOL_GPL(mt6797_dvfsp_runtime_event_apply);
 
+int mt6797_dvfsp_runtime_event_apply_invalidator(
+	const struct mt6797_dvfsp_runtime_event *event,
+	struct mt6797_dvfsp_runtime_ledger *ledger,
+	void (*invalidate)(void *context,
+				enum mt6797_dvfsp_state_invalidation_reason reason),
+	void *context)
+{
+	enum mt6797_dvfsp_state_invalidation_reason reason;
+	int ret;
+
+	if (!ledger || !invalidate)
+		return -EINVAL;
+	ret = mt6797_dvfsp_runtime_event_check(event);
+	if (ret)
+		return ret;
+	if ((ledger->abi && ledger->abi != MT6797_DVFSP_RUNTIME_ABI) ||
+	    ledger->reserved)
+		return -EPROTO;
+	if (ledger->last_sequence >= event->sequence ||
+	    ledger->invalidated_generation >= event->generation)
+		return -EALREADY;
+	ret = mt6797_dvfsp_runtime_reason(event->type, &reason);
+	if (ret)
+		return ret;
+
+	invalidate(context, reason);
+	ledger->abi = MT6797_DVFSP_RUNTIME_ABI;
+	ledger->last_sequence = event->sequence;
+	ledger->invalidated_generation = event->generation;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_runtime_event_apply_invalidator);
+
 MODULE_DESCRIPTION("MT6797 DVFSP runtime invalidation conversion");
 MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-dvfsp-calibrated-provider.c b/drivers/soc/mediatek/mt6797-dvfsp-calibrated-provider.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-calibrated-provider.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-calibrated-provider.c
@@ -233,5 +233,23 @@ int mt6797_dvfsp_calibrated_provider_invalidate(
 }
 EXPORT_SYMBOL_GPL(mt6797_dvfsp_calibrated_provider_invalidate);
 
+static void mt6797_dvfsp_calibrated_provider_runtime_invalidate(
+	void *context, enum mt6797_dvfsp_state_invalidation_reason reason)
+{
+	mt6797_dvfsp_calibrated_provider_invalidate(context, reason);
+}
+
+int mt6797_dvfsp_calibrated_provider_apply_runtime_event(
+	struct mt6797_dvfsp_calibrated_provider *provider,
+	const struct mt6797_dvfsp_runtime_event *event,
+	struct mt6797_dvfsp_runtime_ledger *ledger)
+{
+	if (!provider)
+		return -EINVAL;
+	return mt6797_dvfsp_runtime_event_apply_invalidator(event, ledger,
+			mt6797_dvfsp_calibrated_provider_runtime_invalidate, provider);
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_calibrated_provider_apply_runtime_event);
+
 int mt6797_dvfsp_calibrated_provider_bind_sources(
 	struct mt6797_dvfsp_calibrated_provider *provider,
-- 
2.43.0
