From b5a647092ab7a73a87b294a750ba4312c0d55d3d Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Wed, 26 Aug 2026 02:12:00 +0000
Subject: [PATCH 2/2] soc: mediatek: test A72 platform-state movement

Prove read bounds, CCI-busy precedence, every movement bit, masked
noise exclusion, and composed propagation with injected memory.
---
 drivers/soc/mediatek/Kconfig                  |  11 +
 drivers/soc/mediatek/Makefile                 |   1 +
 ...72-platform-provider-clock-observer-test.c |  55 +++--
 .../mediatek/mt6797-a72-platform-state-test.c | 211 ++++++++++++++++++
 4 files changed, 264 insertions(+), 14 deletions(-)
 create mode 100644 drivers/soc/mediatek/mt6797-a72-platform-state-test.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index 5c881ef..802a353 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -14,6 +14,17 @@ config MTK_MT6797_A72_PLATFORM_PROVIDER_CLOCK_OBSERVER
 	  BigiDVFS or secure call, provider action, publisher, owner mutation, CPU
 	  request, reset, or power action. If unsure, say N.
 
+config MTK_MT6797_A72_PLATFORM_STATE_KUNIT_TEST
+	bool "KUnit tests for MT6797 A72 platform-state movement"
+	depends on KUNIT=y
+	depends on MTK_MT6797_A72_PLATFORM_STATE
+	default n
+	help
+	  Exercise the exact two-sample transaction, read-error bounds, CCI-busy
+	  precedence, all nine movement bits, and masked-noise exclusion with
+	  injected memory only. No physical hardware access occurs, and no
+	  retained write, provider action, clock call, or CPU request is made.
+
 config MTK_MT6797_A72_PLATFORM_PROVIDER_CLOCK_KUNIT_TEST
 	bool "KUnit tests for MT6797 A72 platform/provider/clock observer"
 	depends on KUNIT=y
