+	KUNIT_EXPECT_EQ(test,
+			arm64_late_cpu_startup_arm_before_cpu_on(&cpu8_token),
+			-ESHUTDOWN);
+	KUNIT_ASSERT_EQ(test,
+			arm64_late_cpu_startup_park(
+				&cpu8_target, ARM64_LATE_CPU_STARTUP_BRANCH_U,
+				0xa00, ARM64_LATE_CPU_EFFECT_MM),
