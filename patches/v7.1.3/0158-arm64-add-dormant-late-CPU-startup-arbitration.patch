+	KUNIT_ASSERT_EQ(test,
+			arm64_late_cpu_startup_park(
+				&cpu8_target, ARM64_LATE_CPU_STARTUP_BRANCH_U,
+				0xa01, ARM64_LATE_CPU_EFFECT_MM),
