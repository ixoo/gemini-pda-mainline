+static const struct arm64_late_cpu_up_token cpu9_token = {
+	.abi = ARM64_LATE_CPU_STARTUP_ABI,
+	.owner = ARM64_LATE_CPU_STARTUP_OWNER_MEMBERSHIP,
+	.operation = ARM64_LATE_CPU_STARTUP_OP_CPU9_UP,
+	.target_cpu = 9,
+	.target_mpidr = 0x201,
+	.generation = 7,
