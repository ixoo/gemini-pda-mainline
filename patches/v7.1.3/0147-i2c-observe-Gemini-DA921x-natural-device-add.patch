From 38eb0f22e48c3e8dbe49fd0ac8571ea20e9575db Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 1 Aug 2026 21:35:00 -0400
Subject: [PATCH 147/147] i2c: observe Gemini DA921x natural device add

The named Gemini reached stage 25 after the exact retained event traversed
the ordinary kobject_uevent_env() network-broadcast call site and public
return. That result remained a post-serviceability replay.

Add the next experiment-only boundary. Arm observation before the exact
OF-created I2C client enters device_register(). After the existing event
validators and zero-listener preflight pass during its boot-time
add event, leave the experiment branch through the ordinary namespace and
network-broadcast call site. Record its public return and the later return
from device_register().

Advance to stage 26 only for one exact device-register entry and return,
one call-site entry and return, one public return, one namespace check, one
untagged route, one socket, zero listeners, allocations, and broadcasts,
and return zero throughout. Expose the counters read-only. This adds no
trigger, replay, driver, provider, I2C transfer, register access, printk,
usermode helper, or storage path.
---
 drivers/i2c/Kconfig             |  19 ++++
 drivers/i2c/i2c-core-base.c     |  15 ++++
 include/linux/kobject.h         |  22 +++++
 kernel/ksysfs.c                 |  31 +++++++
 lib/kobject_uevent.c            | 155 +++++++++++++++++++++++++++++++-
 5 files changed, 241 insertions(+), 1 deletion(-)

diff --git a/drivers/i2c/Kconfig b/drivers/i2c/Kconfig
--- a/drivers/i2c/Kconfig
+++ b/drivers/i2c/Kconfig
@@ -350,6 +350,25 @@ config I2C_GEMINI_DA921X_UEVENT_NORMAL_FALLTHROUGH_DIAGNOSTIC
 
 	  Say N outside the named normal-fallthrough experiment.
 
+config I2C_GEMINI_DA921X_NATURAL_DEVICE_ADD_DIAGNOSTIC
+	bool "Gemini DA921x natural device-add discriminator"
+	depends on I2C_GEMINI_DA921X_UEVENT_NORMAL_FALLTHROUGH_DIAGNOSTIC
+	help
+	  Observe the exact OF-created legacy DA921x client from immediately
+	  before its boot-time device_register() call through the natural add
+	  uevent and the return from device registration. Leave the exact event
+	  through the ordinary namespace and network-broadcast call site after
+	  the proven zero-listener preflight.
+
+	  Exactly one device-register entry and return, one uevent call-site entry
+	  and return, one public return, one namespace check, one untagged route,
+	  one socket, zero listeners, allocations, and broadcasts, and return zero
+	  throughout advances the read-only validation stage to 26.
+
+	  This experiment adds no trigger, replay, driver, provider, transfer,
+	  register access, printk, usermode helper, or storage path. Say N outside
+	  the named natural device-add experiment.
+
 config I2C_BOARDINFO
 	bool
 	default y
diff --git a/drivers/i2c/i2c-core-base.c b/drivers/i2c/i2c-core-base.c
--- a/drivers/i2c/i2c-core-base.c
+++ b/drivers/i2c/i2c-core-base.c
@@ -1130,6 +1130,9 @@ i2c_new_client_device(struct i2c_adapter *adap, struct i2c_board_info const *info)
 	struct i2c_client *client;
 	bool need_put = false;
 	int status;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_NATURAL_DEVICE_ADD_DIAGNOSTIC)
+	bool gemini_da921x_natural_device_add = false;
+#endif
 
 	client = kzalloc_obj(*client);
 	if (!client)
@@ -1183,7 +1186,19 @@ i2c_new_client_device(struct i2c_adapter *adap, struct i2c_board_info const *info)
 	}
 
 	i2c_dev_set_name(adap, client, info);
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_NATURAL_DEVICE_ADD_DIAGNOSTIC)
+	if (adap->nr == 1 && client->addr == 0x68 &&
+	    !strcmp(client->name, "da9214-legacy") && client->dev.of_node &&
+	    of_device_is_compatible(client->dev.of_node,
+				    "dlg,da9214-legacy"))
+		gemini_da921x_natural_device_add =
+			gemini_da921x_natural_device_add_begin(&client->dev.kobj);
+#endif
 	status = device_register(&client->dev);
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_NATURAL_DEVICE_ADD_DIAGNOSTIC)
+	if (gemini_da921x_natural_device_add)
+		gemini_da921x_natural_device_add_end(&client->dev.kobj, status);
+#endif
 	if (status)
 		goto out_remove_swnode;
 
