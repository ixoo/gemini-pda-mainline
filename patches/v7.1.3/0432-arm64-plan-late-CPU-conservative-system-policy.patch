From 8cd80eeb8b64d5fe86028db25468f7b38c2ded67 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sun, 30 Aug 2026 00:31:00 +0000
Subject: [PATCH] arm64: plan conservative late CPU system policy

Record the two unused early GIC capabilities from the current
system and keep a present state unresolved without target controller
evidence. Derive the recovered Cortex-A72 Spectre state only from the
field-valid expected MIDR/PFR pair, choosing vulnerable no-callback
effects when firmware workaround results remain unknown.

Activate no expected pair, publish no READY token, and request no CPU.
---
 arch/arm64/include/asm/late_cpu_profile.h |  26 +++-
 arch/arm64/kernel/cpufeature.c            |  40 ++++-
 arch/arm64/kernel/late_cpu_profile.c      |   2 +
 arch/arm64/kernel/mt6797_psci.c           |  65 ++++++---
 arch/arm64/kernel/proton-pack.c           | 169 +++++++++++++++++++++-
 5 files changed, 278 insertions(+), 24 deletions(-)

diff --git a/arch/arm64/include/asm/late_cpu_profile.h b/arch/arm64/include/asm/late_cpu_profile.h
index 1826c56..1b2b20b 100644
--- a/arch/arm64/include/asm/late_cpu_profile.h
+++ b/arch/arm64/include/asm/late_cpu_profile.h
@@ -380,10 +380,12 @@ struct arm64_late_cpu_target_cap_evidence {
 #define ARM64_LATE_CPU_SYSTEM_CAP_CTR_VALID	BIT(0)
 #define ARM64_LATE_CPU_SYSTEM_CAP_SSBS_VALID	BIT(1)
 #define ARM64_LATE_CPU_SYSTEM_CAP_EFFECTS_VALID	BIT(2)
+#define ARM64_LATE_CPU_SYSTEM_CAP_EARLY_LOCAL_VALID	BIT(3)
 #define ARM64_LATE_CPU_SYSTEM_CAP_VALID_MASK				\
 	(ARM64_LATE_CPU_SYSTEM_CAP_CTR_VALID |				\
 	 ARM64_LATE_CPU_SYSTEM_CAP_SSBS_VALID |				\
-	 ARM64_LATE_CPU_SYSTEM_CAP_EFFECTS_VALID)
+	 ARM64_LATE_CPU_SYSTEM_CAP_EFFECTS_VALID |			\
+	 ARM64_LATE_CPU_SYSTEM_CAP_EARLY_LOCAL_VALID)
 
 struct arm64_late_cpu_system_cap_evidence {
 	u32 valid;
@@ -395,6 +397,8 @@ struct arm64_late_cpu_system_cap_evidence {
 	u8 bhb_state;
 	u8 bhb_matcher_loop_count;
 	u8 bhb_system_method;
+	u8 gicv5_legacy;
+	u8 ich_hcr_tdir;
 };
 
 enum arm64_late_cpu_binding_origin {
@@ -597,6 +601,10 @@ bool __init
 arm64_late_cpu_cap_uses_multi_entry_match(const struct arm64_cpu_capabilities *cap);
 bool __init arm64_late_cpu_target_impl_override_active(void);
 enum arm64_late_cpu_cap_state __init
+arm64_late_cpu_early_system_cap_state(const struct arm64_cpu_capabilities *cap,
+				      const struct arm64_cpu_capabilities *match,
+				      const struct arm64_late_cpu_system_cap_evidence *system);
+enum arm64_late_cpu_cap_state __init
 arm64_late_cpu_gicv5_legacy_state(
 	const struct arm64_cpu_capabilities *cap,
 	const struct arm64_cpu_capabilities *match,
@@ -641,6 +649,22 @@ int __init arm64_late_cpu_a72_bhb_effect(
 	const struct arm64_late_cpu_target_policy_evidence *policy,
 	u8 system_v2_state,
 	struct arm64_late_cpu_target_effect_plan *effects);
+enum arm64_late_cpu_cap_state __init
+arm64_late_cpu_expected_v2_state(const struct arm64_cpu_capabilities *cap,
+				 const struct arm64_cpu_capabilities *match,
+				 const struct arm64_late_cpu_expected_pair *expected);
+enum arm64_late_cpu_cap_state __init
+arm64_late_cpu_expected_v4_state(const struct arm64_cpu_capabilities *cap,
+				 const struct arm64_cpu_capabilities *match,
+				 const struct arm64_late_cpu_expected_pair *expected);
+enum arm64_late_cpu_cap_state __init
+arm64_late_cpu_expected_bhb_state(const struct arm64_cpu_capabilities *cap,
+				  const struct arm64_cpu_capabilities *match,
+				  const struct arm64_late_cpu_expected_pair *expected);
+int __init
+arm64_late_cpu_expected_effects(const struct arm64_late_cpu_expected_pair *expected,
+				const struct arm64_late_cpu_target_policy_evidence *policy,
+				struct arm64_late_cpu_target_effect_plan *effects);
 void __init arm64_verify_late_cpu_profile_system(void);
 void __init arm64_finalize_late_cpu_profile_user(void);
 const struct arm64_late_cpu_ready_token *
diff --git a/arch/arm64/kernel/cpufeature.c b/arch/arm64/kernel/cpufeature.c
index c5bf8f7..77f77bb 100644
--- a/arch/arm64/kernel/cpufeature.c
+++ b/arch/arm64/kernel/cpufeature.c
@@ -2421,8 +2421,12 @@ arm64_late_cpu_collect_system(struct arm64_late_cpu_system_cap_evidence *system)
 	system->ctr_sys_val = arm64_ftr_reg_ctrel0.sys_val;
 	system->ctr_strict_mask = arm64_ftr_reg_ctrel0.strict_mask;
 	system->ssbs = !!ssbs;
+	system->gicv5_legacy = cpus_have_cap(ARM64_HAS_GICV5_LEGACY);
+	system->ich_hcr_tdir =
+		cpus_have_cap(ARM64_HAS_ICH_HCR_EL2_TDIR);
 	system->valid = ARM64_LATE_CPU_SYSTEM_CAP_CTR_VALID |
-			ARM64_LATE_CPU_SYSTEM_CAP_SSBS_VALID;
+			ARM64_LATE_CPU_SYSTEM_CAP_SSBS_VALID |
+			ARM64_LATE_CPU_SYSTEM_CAP_EARLY_LOCAL_VALID;
 
 	return 0;
 }
@@ -2580,6 +2584,40 @@ late_cpu_ich_descriptor_valid(const struct arm64_cpu_capabilities *cap,
 	       !cap->cpus;
 }
 
+enum arm64_late_cpu_cap_state __init
+arm64_late_cpu_early_system_cap_state(const struct arm64_cpu_capabilities *cap,
+				      const struct arm64_cpu_capabilities *match,
+				      const struct arm64_late_cpu_system_cap_evidence *system)
+{
+	bool present;
+
+	if (!system ||
+	    !(system->valid & ARM64_LATE_CPU_SYSTEM_CAP_EARLY_LOCAL_VALID) ||
+	    system->valid & ~ARM64_LATE_CPU_SYSTEM_CAP_VALID_MASK ||
+	    system->gicv5_legacy > 1 || system->ich_hcr_tdir > 1 ||
+	    !cpucap_late_cpu_permitted(cap))
+		return ARM64_LATE_CPU_CAP_UNRESOLVED;
+
+	switch (cap->capability) {
+	case ARM64_HAS_GICV5_LEGACY:
+		if (!late_cpu_gic_descriptor_valid(cap, match))
+			return ARM64_LATE_CPU_CAP_UNRESOLVED;
+		present = system->gicv5_legacy;
+		break;
+	case ARM64_HAS_ICH_HCR_EL2_TDIR:
+		if (!late_cpu_ich_descriptor_valid(cap, match))
+			return ARM64_LATE_CPU_CAP_UNRESOLVED;
+		present = system->ich_hcr_tdir;
+		break;
+	default:
+		return ARM64_LATE_CPU_CAP_UNRESOLVED;
+	}
+
+	/* A present system capability still needs target controller evidence. */
+	return present ? ARM64_LATE_CPU_CAP_UNRESOLVED :
+			 ARM64_LATE_CPU_CAP_ABSENT;
+}
+
 static enum arm64_late_cpu_cap_state __init
 late_cpu_gicv5_legacy_evidence_state(
 	const struct arm64_late_cpu_target_cap_evidence *target)
diff --git a/arch/arm64/kernel/late_cpu_profile.c b/arch/arm64/kernel/late_cpu_profile.c
index 4bbd319..ebb1e1a 100644
--- a/arch/arm64/kernel/late_cpu_profile.c
+++ b/arch/arm64/kernel/late_cpu_profile.c
@@ -354,6 +354,8 @@ late_canonical_update_system_cap(struct sha256_ctx *ctx,
 	late_canonical_update_u8(ctx, system->bhb_state);
 	late_canonical_update_u8(ctx, system->bhb_matcher_loop_count);
 	late_canonical_update_u8(ctx, system->bhb_system_method);
+	late_canonical_update_u8(ctx, system->gicv5_legacy);
+	late_canonical_update_u8(ctx, system->ich_hcr_tdir);
 }
 
 static void __init
