From 0000000000000000000000000000000000000210 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sun, 9 Aug 2026 12:00:00 -0400
Subject: [PATCH] soc: mediatek: add protected state source adapter

The protected clock and BigiDVFS transports, EEM calibration builder, and
four-cluster snapshot assembler are individually validated but still leave a
future owner to compose them ad hoc. Add one callback-only source adapter that
orders those conversions, keeps the raw-source and derived generations in one
snapshot attempt, and hands the final live fields to the existing assembler.

The adapter requires callers to hold their transition lock for the entire
sequence. It has no platform driver, registration side effect, MMIO, secure
call, regulator/clock operation, firmware action, or CPU_ON path. Missing
sources and every conversion failure are returned without publishing a
snapshot. It is experiment-only and not submission-ready.
---
 drivers/soc/mediatek/Makefile                          |   1 +
 drivers/soc/mediatek/mt6797-dvfsp-state-source.c       | 109 ++++++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-state-source.h |  57 ++++++++
 3 files changed, 167 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-state-source.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-state-source.h

diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -2,1 +2,2 @@
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-runtime.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-source.o

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-state-source.h b/include/linux/soc/mediatek/mt6797-dvfsp-state-source.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-state-source.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_MEDIATEK_MT6797_DVFSP_STATE_SOURCE_H
+#define __LINUX_SOC_MEDIATEK_MT6797_DVFSP_STATE_SOURCE_H
+
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-bigidvfs-backend.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-clock-state.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-state-snapshot.h>
+#include <linux/soc/mediatek/mt6797-eem-calibration.h>
+#include <linux/soc/mediatek/mt6797-eem-readback.h>
+
+#define MT6797_DVFSP_STATE_SOURCE_ABI		1
+
+/*
+ * The caller owns and holds the transition lock while this source is used.
+ * These fields are the only live values that the adapter accepts from it;
+ * the adapter supplies the decoded clock and calibration object pointers.
+ */
+struct mt6797_dvfsp_state_source_live {
+	u64 generation;
+	u64 owner_handle;
+	u64 transition_handle;
+	struct mt6797_dvfsp_state_provenance provenance;
+	u32 state_flags[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 opp_id[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 frequency_khz[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 voltage_uv[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 vsram_uv[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 ceiling_khz[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 floor_khz[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 clock_state[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+	u32 rail_state[MT6797_DVFSP_STATE_CLUSTER_COUNT];
+};
+
+struct mt6797_dvfsp_state_source_ops {
+	u32 abi;
+	int (*read_clock)(void *context,
+			 struct mt6797_dvfsp_clock_readback *readback);
+	int (*read_big)(void *context,
+		       struct mt6797_bigidvfs_readback *readback);
+	int (*read_eem)(void *context,
+		       struct mt6797_eem_readback *readback);
+	int (*fill_calibration)(void *context,
+				const struct mt6797_eem_readback *readback,
+				struct mt6797_eem_calibration_input *input);
+	int (*fill_live)(void *context,
+				const struct mt6797_dvfsp_clock_state *clock,
+				const struct mt6797_dvfsp_calibration_state *calibration,
+				struct mt6797_dvfsp_state_source_live *live);
+};
+
+int mt6797_dvfsp_state_source_snapshot(
+	const struct mt6797_dvfsp_state_source_ops *ops, void *context,
+	struct mt6797_dvfsp_state_snapshot *snapshot);
+
+#endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_STATE_SOURCE_H */

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-state-source.c b/drivers/soc/mediatek/mt6797-dvfsp-state-source.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-dvfsp-state-source.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Compose the validated MT6797 protected-state source pipeline.
+ *
+ * No callback is registered here. A real owner supplies the callbacks and
+ * holds its transition lock around this complete sequence. This object only
+ * orders raw readback, pure conversion, and final snapshot assembly.
+ */
+
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-state-source.h>
+
+static int mt6797_dvfsp_state_source_check(
+	const struct mt6797_dvfsp_state_source_ops *ops)
+{
+	if (!ops || ops->abi != MT6797_DVFSP_STATE_SOURCE_ABI ||
+	    !ops->read_clock || !ops->read_big || !ops->read_eem ||
+	    !ops->fill_calibration || !ops->fill_live)
+		return -EINVAL;
+
+	return 0;
+}
+
+int mt6797_dvfsp_state_source_snapshot(
+	const struct mt6797_dvfsp_state_source_ops *ops, void *context,
+	struct mt6797_dvfsp_state_snapshot *snapshot)
+{
+	struct mt6797_dvfsp_clock_readback clock_readback;
+	struct mt6797_bigidvfs_readback big_readback;
+	struct mt6797_eem_readback eem_readback;
+	struct mt6797_dvfsp_clock_state clock_state;
+	struct mt6797_eem_calibration_input calibration_input;
+	struct mt6797_dvfsp_calibration_state calibration_state;
+	struct mt6797_dvfsp_state_source_live live;
+	struct mt6797_dvfsp_state_snapshot_input input;
+	int ret;
+
+	if (!snapshot)
+		return -EINVAL;
+	ret = mt6797_dvfsp_state_source_check(ops);
+	if (ret)
+		return ret;
+
+	memset(&clock_readback, 0, sizeof(clock_readback));
+	ret = ops->read_clock(context, &clock_readback);
+	if (ret)
+		return ret;
+
+	memset(&big_readback, 0, sizeof(big_readback));
+	ret = ops->read_big(context, &big_readback);
+	if (ret)
+		return ret;
+
+	ret = mt6797_dvfsp_clock_state_decode(&clock_readback, &big_readback,
+						      &clock_state);
+	if (ret)
+		return ret;
+
+	memset(&eem_readback, 0, sizeof(eem_readback));
+	ret = ops->read_eem(context, &eem_readback);
+	if (ret)
+		return ret;
+
+	memset(&calibration_input, 0, sizeof(calibration_input));
+	ret = ops->fill_calibration(context, &eem_readback,
+					    &calibration_input);
+	if (ret)
+		return ret;
+	calibration_input.readback = &eem_readback;
+	ret = mt6797_eem_calibration_build(&calibration_input,
+					   &calibration_state);
+	if (ret)
+		return ret;
+
+	memset(&live, 0, sizeof(live));
+	ret = ops->fill_live(context, &clock_state, &calibration_state, &live);
+	if (ret)
+		return ret;
+
+	memset(&input, 0, sizeof(input));
+	input.abi = MT6797_DVFSP_STATE_SNAPSHOT_ABI;
+	input.generation = live.generation;
+	input.owner_handle = live.owner_handle;
+	input.transition_handle = live.transition_handle;
+	input.clock = &clock_state;
+	input.calibration = &calibration_state;
+	input.provenance = live.provenance;
+	memcpy(input.state_flags, live.state_flags, sizeof(input.state_flags));
+	memcpy(input.opp_id, live.opp_id, sizeof(input.opp_id));
+	memcpy(input.frequency_khz, live.frequency_khz,
+	       sizeof(input.frequency_khz));
+	memcpy(input.voltage_uv, live.voltage_uv, sizeof(input.voltage_uv));
+	memcpy(input.vsram_uv, live.vsram_uv, sizeof(input.vsram_uv));
+	memcpy(input.ceiling_khz, live.ceiling_khz,
+	       sizeof(input.ceiling_khz));
+	memcpy(input.floor_khz, live.floor_khz, sizeof(input.floor_khz));
+	memcpy(input.clock_state, live.clock_state, sizeof(input.clock_state));
+	memcpy(input.rail_state, live.rail_state, sizeof(input.rail_state));
+
+	return mt6797_dvfsp_state_snapshot_assemble(&input, snapshot);
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_state_source_snapshot);
+
+MODULE_DESCRIPTION("MT6797 protected state source adapter");
+MODULE_LICENSE("GPL");
--
2.43.0
