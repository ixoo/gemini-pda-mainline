From eabfc5b1cd5ca327ba374656aee5db0b2a341604 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 4 Sep 2026 19:01:00 +0000
Subject: [PATCH 1/2] soc: mediatek: add bounded MT6797 A72 frequency observer

Expose at most three read-only raw and decoded samples per boot.

Reuse the stable protected-clock transports without CPU or policy action.
---
 drivers/soc/mediatek/Kconfig                  |  15 ++
 drivers/soc/mediatek/Makefile                 |   1 +
 .../mt6797-a72-frequency-observer-internal.h  |  69 +++++++
 .../mediatek/mt6797-a72-frequency-observer.c  | 188 ++++++++++++++++++
 .../mt6797-a72-hotplug-snapshot-internal.h    |   2 +
 .../mediatek/mt6797-a72-hotplug-snapshot.c    |   5 +
 6 files changed, 280 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-a72-frequency-observer-internal.h
 create mode 100644 drivers/soc/mediatek/mt6797-a72-frequency-observer.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index fbdc7af..8a06454 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -796,6 +796,21 @@ config MTK_MT6797_A72_HOTPLUG_SNAPSHOT_KUNIT_TEST
 	  operations only. No device, MMIO, I2C, SMC, retained-memory, CPU,
 	  watchdog, or network action occurs.
 
+
+config MTK_MT6797_A72_FREQUENCY_OBSERVER
+	bool "MediaTek MT6797 bounded A72 frequency observer"
+	depends on MTK_MT6797_A72_HOTPLUG_SNAPSHOT
+	depends on MTK_MT6797_DVFSP_STATE_DECODERS
+	default n
+	help
+	  Add one read-only attribute to the existing snapshot adapter. At most
+	  three reads per boot take bounded protected-clock and stable BigiDVFS
+	  samples, then publish raw register values and decoded cluster rates.
+
+	  The observer does not request a CPU, change voltage or frequency, select
+	  a policy, write retained memory, or add a Device Tree node. The protected
+	  clock transport retains its documented bounded semaphore writes.
+
 config MTK_MT6797_A72_RESTORE_EXECUTOR
 	bool "MediaTek MT6797 disconnected CPU9 restore executor"
 	depends on ARM64 && ARCH_MEDIATEK
