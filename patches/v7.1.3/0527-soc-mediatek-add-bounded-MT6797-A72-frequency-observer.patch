 	struct device *clock;
 	struct device *bigidvfs;
 	const struct mt6797_a72_hotplug_snapshot_ops *ops;
+	struct mt6797_a72_frequency_observer_controller frequency_observer;
 };
 
 struct mt6797_a72_hotplug_snapshot_trace {
diff --git a/drivers/soc/mediatek/mt6797-a72-hotplug-snapshot.c b/drivers/soc/mediatek/mt6797-a72-hotplug-snapshot.c
index 0a578f6..5a74a62 100644
--- a/drivers/soc/mediatek/mt6797-a72-hotplug-snapshot.c
+++ b/drivers/soc/mediatek/mt6797-a72-hotplug-snapshot.c
@@ -62,6 +62,7 @@ void mt6797_a72_hotplug_snapshot_source_init(
 	source->clock = clock;
 	source->bigidvfs = bigidvfs;
 	source->ops = &mt6797_hotplug_ops;
