 }
 
 static bool mt6797_hotplug_provider_valid(
@@ -305,7 +306,11 @@ static int mt6797_a72_hotplug_snapshot_probe(struct platform_device *pdev)
 		return ret;
 	source->bigidvfs = dependency;
 	source->ops = &mt6797_hotplug_ops;
