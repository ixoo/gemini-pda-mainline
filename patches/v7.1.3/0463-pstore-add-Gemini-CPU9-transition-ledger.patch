From 5210d734433d5608a16c0e074ba6fa29219f9fa6 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 1 Sep 2026 00:11:00 +0000
Subject: [PATCH] pstore: add Gemini CPU9 transition ledger

Reserve the existing second ramoops dmesg record for an
independent, one-shot CPU9 transition ledger. Require the exact
CRC-valid CPU8 online terminal and attempt identity before the
CPU9 lane can open, and reject every prior CPU9 record.

Reuse the proven two-copy wire owner without changing record 0.
Add focused in-memory tests and no CPU, firmware, watchdog, or
cluster-power caller.
---
 fs/pstore/Kconfig                             |  28 ++
 fs/pstore/Makefile                            |   2 +
 fs/pstore/gemini_cpu9_transition_ledger.c     | 276 ++++++++++++++
 .../gemini_cpu9_transition_ledger_internal.h  |  28 ++
 .../gemini_cpu9_transition_ledger_test.c      | 344 ++++++++++++++++++
 include/linux/gemini_cpu9_transition_ledger.h |  44 +++
 6 files changed, 722 insertions(+)
 create mode 100644 fs/pstore/gemini_cpu9_transition_ledger.c
 create mode 100644 fs/pstore/gemini_cpu9_transition_ledger_internal.h
 create mode 100644 fs/pstore/gemini_cpu9_transition_ledger_test.c
 create mode 100644 include/linux/gemini_cpu9_transition_ledger.h

diff --git a/fs/pstore/Kconfig b/fs/pstore/Kconfig
index 03ed720..3257394 100644
--- a/fs/pstore/Kconfig
+++ b/fs/pstore/Kconfig
@@ -467,6 +467,34 @@ config PSTORE_GEMINI_TRANSITION_LEDGER
 	  This option adds no caller, CPU request, watchdog action, SMC, device
 	  trigger, or boot policy. If unsure, say N.
 
+config PSTORE_GEMINI_CPU9_TRANSITION_LEDGER
+	bool "Gemini independent CPU9 transition ledger"
+	depends on PSTORE_GEMINI_TRANSITION_LEDGER=y
+	default n
+	help
+	  Add a one-shot API for the second exact Gemini ramoops dmesg
+	  record. The owner accepts an empty record only after record 0
+	  contains the expected CRC-valid CPU8 online terminal from the
+	  caller-supplied CPU8 attempt.
+
+	  The lane reuses the proven two-copy wire format but has independent
+	  physical ownership and sealing. It adds no caller, CPU request,
+	  watchdog action, SMC, cluster-power action, or boot policy. If
+	  unsure, say N.
+
+config PSTORE_GEMINI_CPU9_TRANSITION_LEDGER_KUNIT_TEST
+	bool "KUnit tests for the Gemini CPU9 transition ledger"
+	depends on KUNIT=y
+	depends on PSTORE_GEMINI_CPU9_TRANSITION_LEDGER=y
+	default n
+	help
+	  Test the CPU8 terminal gate, exact attempt binding, empty-only CPU9
+	  ownership, raw-header commit, five-stage sequence, and terminal
+	  sealing in injected word arrays.
+
+	  No retained RAM, MMIO, CPU request, watchdog, SMC, regulator, clock,
+	  or cluster-power operation is used.
+
 config PSTORE_GEMINI_ADMISSION_TRACE
 	bool "Gemini immutable CPU8 admission trace"
 	depends on PSTORE_GEMINI_TRANSITION_LEDGER=y
