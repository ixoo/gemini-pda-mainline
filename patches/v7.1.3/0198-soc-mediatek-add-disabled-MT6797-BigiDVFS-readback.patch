 .../boot/dts/mediatek/mt6797.dtsi                  |   6 +
 drivers/soc/mediatek/Kconfig                       |  14 ++
 drivers/soc/mediatek/Makefile                      |   1 +
 .../soc/mediatek/mt6797-bigidvfs-backend.c         | 153 +++++++++++++++++++++
 .../soc/mediatek/mt6797-bigidvfs-backend.h         |  29 ++++
 6 files changed, 246 insertions(+)
