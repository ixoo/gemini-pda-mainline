index 34136b5a1..e3c8e942d 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2554,10 +2554,12 @@ config ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST
 	depends on KUNIT=y
 	depends on ARM64_MT6797_A72_P30_PROTOCOL_MODEL
 	select ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
+	select ARM64_MT6797_A72_P24_ADMISSION_HOOKS
 	help
 	  Exercise the lifecycle-closed owner boundary. The tests verify that
 	  CPU8 and CPU9 probes cannot consume an attempt, allocate a token,
-	  publish or mutate P30, or make a CPU_ON transaction reachable.
+	  publish or mutate P30, or make a CPU_ON transaction reachable. They
