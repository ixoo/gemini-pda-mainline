diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 1e2b5515c..b2d88686d 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -219,8 +219,19 @@ config ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
 	depends on ARM64_MT6797_A72_P30_PROTOCOL_MODEL
 	help
 	  Build the lifecycle-closed owner for future P17/P18/P24 membership
-	  transactions. The owner has no production caller or opener. It rejects
-	  before P31/A38, allocates no token, and cannot issue CPU_ON.
+	  transactions. The transaction-begin path has no production caller or
+	  opener. It rejects before P31/A38, allocates no token, and cannot issue
+	  CPU_ON.
+
+config ARM64_MT6797_A72_P24_ADMISSION_HOOKS
+	bool "Install closed MT6797 A72 CPU-up admission hooks"
+	depends on ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
+	help
+	  Install public and leaf-only internal CPU-up checks for MT6797 CPU8
+	  and CPU9. Both hooks are read-only denials: they do not begin a
+	  transaction, change P30, or make the existing CPU boot veto reachable.
+	  CPU0 through CPU7 and methods without admission callbacks retain their
+	  existing behavior. This option adds no owner opener or success path.
 
 config ARCH_MESON
 	bool "Amlogic Platforms"
