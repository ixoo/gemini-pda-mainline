From ebc68affe698eab0b265d584a4b55750e172a55b Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 31 Aug 2026 00:01:00 +0000
Subject: [PATCH 1/2] soc: mediatek: retain live CPU8 admission failure stage

The first live CPU8 trigger returned EPERM after the one-shot
core was consumed but before a CPU request. Existing trace
storage could not retain the exact rejecting stage.

Retain the controller stage and the first derived-admission
substage in the read-only terminal status. Do not change any
predicate, effect, request order, or retry behavior.
---
 .../arm64/include/asm/mt6797_a72_membership.h | 34 ++++++++++++-
 arch/arm64/kernel/mt6797_a72_membership.c     | 50 +++++++++++++++----
 ...mt6797-a72-admission-controller-internal.h |  2 +
 .../mt6797-a72-admission-controller-test.c    |  2 +
 .../mt6797-a72-admission-controller.c         | 17 +++++--
 5 files changed, 89 insertions(+), 16 deletions(-)

diff --git a/arch/arm64/include/asm/mt6797_a72_membership.h b/arch/arm64/include/asm/mt6797_a72_membership.h
index 6811f1a..36f6096 100644
--- a/arch/arm64/include/asm/mt6797_a72_membership.h
+++ b/arch/arm64/include/asm/mt6797_a72_membership.h
@@ -61,6 +61,25 @@ enum mt6797_a72_membership_operation {
 	MT6797_A72_OPERATION_CPU8_LAST_OFF,
 };
 
+enum mt6797_a72_cpu8_derive_stage {
+	MT6797_A72_DERIVE_NONE,
+	MT6797_A72_DERIVE_TOPOLOGY,
+	MT6797_A72_DERIVE_READY_TOKEN,
+	MT6797_A72_DERIVE_BOOTSTRAP_OWNER,
+	MT6797_A72_DERIVE_BOOTSTRAP_REPLAY,
+	MT6797_A72_DERIVE_DIRECT_STATE,
+	MT6797_A72_DERIVE_A34,
+	MT6797_A72_DERIVE_P30_CLAIM,
+	MT6797_A72_DERIVE_BOOTSTRAP_FINALIZE,
+	MT6797_A72_DERIVE_P30_RELEASE,
+	MT6797_A72_DERIVE_P31_CONSUME,
+	MT6797_A72_DERIVE_ENTRY_VALIDATE,
+	MT6797_A72_DERIVE_TOKEN_MINT,
+	MT6797_A72_DERIVE_PRESTATE_VALIDATE,
+	MT6797_A72_DERIVE_PRESTATE_BIND,
+	MT6797_A72_DERIVE_COMPLETE,
+};
+
 enum mt6797_a72_provider_state {
 	MT6797_A72_PROVIDER_NONE,
 	MT6797_A72_PROVIDER_ACQUIRE_INFLIGHT,
@@ -622,16 +641,27 @@ mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
 int
 mt6797_a72_membership_derive_cpu8(const struct arm64_late_cpu_ready_token *ready,
 				  struct mt6797_a72_transaction *transaction);
+int
+mt6797_a72_membership_derive_cpu8_diagnostic(const struct arm64_late_cpu_ready_token *ready, struct mt6797_a72_transaction *transaction, u32 *derive_stage);
 #else
 static inline int
-mt6797_a72_membership_derive_cpu8(const struct arm64_late_cpu_ready_token *ready,
-				  struct mt6797_a72_transaction *transaction)
+mt6797_a72_membership_derive_cpu8_diagnostic(const struct arm64_late_cpu_ready_token *ready, struct mt6797_a72_transaction *transaction, u32 *derive_stage)
 {
 	(void)ready;
 	if (transaction)
 		memset(transaction, 0, sizeof(*transaction));
+	if (derive_stage)
+		*derive_stage = MT6797_A72_DERIVE_NONE;
 	return -EOPNOTSUPP;
 }
+
+static inline int
+mt6797_a72_membership_derive_cpu8(const struct arm64_late_cpu_ready_token *ready,
+				  struct mt6797_a72_transaction *transaction)
+{
+	return mt6797_a72_membership_derive_cpu8_diagnostic(ready, transaction,
+							    NULL);
+}
 #endif
 #ifdef CONFIG_ARM64_MT6797_A72_DERIVED_ADMISSION_KUNIT_TEST
 int
diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index 144b044..9f3952d 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -616,11 +616,18 @@ out:
 	return ret;
 }
 
+static void mt6797_a72_derive_stage_set(u32 *stage, u32 value)
+{
+	if (stage)
+		*stage = value;
+}
+
 static int
