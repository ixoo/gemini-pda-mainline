 	cpus_read_lock();
 	mutex_lock(&a72_transition_lock);
 	ret = mt6797_a72_membership_derive_cpu8_locked(topology, ready,
-						       transaction);
+						       transaction, NULL);
 	mutex_unlock(&a72_transition_lock);
 	cpus_read_unlock();
 	return ret;
