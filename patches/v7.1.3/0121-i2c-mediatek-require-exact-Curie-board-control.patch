 	  arbitrary address, register, data, length, mode, retry, or reset
 	  control. Say N outside the named Gemini Quasar experiment.
 
-config I2C_MT65XX_FERMI_DIAGNOSTIC
-	bool "MT6797 I2C6 fixed Fermi topology fingerprint"
+config I2C_MT65XX_CURIE_DIAGNOSTIC
+	bool "MT6797 I2C6 fixed Curie board-control tuple"
 	depends on I2C_MT65XX=y && DEBUG_FS
 	depends on !I2C_MT65XX_ORION_DIAGNOSTIC
 	depends on !I2C_MT65XX_QUASAR_DIAGNOSTIC
 	help
-	  Enable the experiment-only, one-shot Fermi topology fingerprint for
+	  Enable the experiment-only, one-shot Curie board-control tuple for
 	  the access-controlled MT6797 iDVFS I2C instance. The root-only
 	  debugfs file accepts exactly "run" followed by a newline and performs
 	  two fixed passes of seven pointer-only reads across addresses 0x69
@@ -944,7 +944,7 @@ config I2C_MT65XX_FERMI_DIAGNOSTIC
 
 	  The diagnostic supplies no length or engine override and exposes no
 	  arbitrary address, register, data, length, mode, retry, or reset
-	  control. Say N outside the named Gemini Fermi experiment.
+	  control. Say N outside the named Gemini Curie experiment.
 
 config I2C_MT7621
 	tristate "MT7621/MT7628 I2C Controller"
