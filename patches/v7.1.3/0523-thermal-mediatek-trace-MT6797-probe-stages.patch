+static int mt6797_test_trace(void *data, u32 operation, u32 phase,
+			      u32 index, int result)
+{
+	struct mt6797_test_context *context = data;
+	unsigned int ordinal = context->trace_count++;
+
+	context->trace_events[ordinal].operation = operation;
+	context->trace_events[ordinal].phase = phase;
+	context->trace_events[ordinal].index = index;
+	context->trace_events[ordinal].result = result;
+
+	return ordinal == context->trace_fail_at ? -ECANCELED : 0;
+}
