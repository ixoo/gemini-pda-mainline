+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-dvfsp-handoff.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 stopped DVFSP firmware handoff
+
+maintainers:
+  - Gemini Mainline Experiment <gemini-mainline@example.invalid>
+
+description: |
+  This device receives a one-way handoff from a stopped MT6797 CPU-DVFS
+  firmware instance. It validates a stable CSPM reset state, temporarily
+  acquires the shared I2C_APPM clock through the common clock framework,
+  balances that reference, and independently verifies that the physical
+  gate became closed without changing the firmware state.
+
+  The device does not start, stop, pause, reset, or load DVFSP firmware. It
+  does not directly write CSPM or infracfg registers. It is not a complete
+  DVFSP coordination provider and does not by itself authorize an I2C6
+  controller, regulator, or CPU-voltage consumer.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-dvfsp-handoff
+
+  reg:
+    maxItems: 1
+    description: CSPM register window used for read-only validation.
+
+  clocks:
+    maxItems: 1
+    description: Shared I2C_APPM clock normalized through the clock framework.
+
+  clock-names:
+    const: i2c
+
+  mediatek,infracfg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to infracfg for independent I2C_APPM gate-status readback.
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - mediatek,infracfg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt6797-clk.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        dvfsp-handoff@11015000 {
+            compatible = "mediatek,mt6797-dvfsp-handoff";
+            reg = <0x0 0x11015000 0x0 0x1000>;
+            clocks = <&infrasys CLK_INFRA_I2C_APPM>;
+            clock-names = "i2c";
+            mediatek,infracfg = <&infrasys>;
+        };
+    };
