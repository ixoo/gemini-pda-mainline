From 0000000000000000000000000000000000000193 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 6 Aug 2026 13:30:00 -0400
Subject: [PATCH] soc: mediatek: add MT6797 state-owner transition hold

The state-owner snapshot and validation callbacks identify a stable
generation, but a PCM start sequence has multiple sleepable checkpoints
between validation and the PCM kick. Define a private transition-hold token
that the authoritative owner can use to keep that generation and cluster mask
valid across those checkpoints. A hold is single-owner, exact-token, and
unregister-safe; a malformed or stale hold never becomes active, and a failed
release remains sticky.

This patch adds no clock provider, register access, regulator operation,
secure-monitor call, firmware image, PCM start, callback registration, or
CPU_ON path. It is an experiment-only contract and is not submission-ready.
---
 drivers/soc/mediatek/mt6797-dvfsp-handoff.c       | 108 ++++++++++++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-handoff.h |  32 +++++++
 2 files changed, 140 insertions(+)

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-handoff.h b/include/linux/soc/mediatek/mt6797-dvfsp-handoff.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-handoff.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-handoff.h
@@ -75,6 +75,13 @@ struct mt6797_dvfsp_state_snapshot {
 		cluster[MT6797_DVFSP_STATE_CLUSTER_COUNT];
 };
 
+struct mt6797_dvfsp_state_hold {
+	u64 generation;
+	u32 cluster_mask;
+	u32 reserved;
+	u64 owner_handle;
+};
+
 enum mt6797_dvfsp_state_invalidation_reason {
 	MT6797_DVFSP_STATE_INVALID_OWNER_REMOVED,
 	MT6797_DVFSP_STATE_INVALID_CLOCK_TRANSITION,
@@ -111,5 +119,10 @@ struct mt6797_dvfsp_state_owner_ops {
 	int (*validate)(void *context,
 			       const struct mt6797_dvfsp_state_snapshot *snapshot);
+	int (*hold)(void *context,
+		    const struct mt6797_dvfsp_state_snapshot *snapshot,
+		    struct mt6797_dvfsp_state_hold *hold);
+	int (*release)(void *context,
+		      const struct mt6797_dvfsp_state_hold *hold);
 	void (*invalidate)(void *context,
 			   enum mt6797_dvfsp_state_invalidation_reason reason);
 };
@@ -173,5 +187,12 @@ int mt6797_dvfsp_handoff_state_validate(
 	struct mt6797_dvfsp_handoff *handoff,
 	const struct mt6797_dvfsp_state_snapshot *snapshot);
+int mt6797_dvfsp_handoff_state_hold(
+	struct mt6797_dvfsp_handoff *handoff,
+	const struct mt6797_dvfsp_state_snapshot *snapshot,
+	struct mt6797_dvfsp_state_hold *hold);
+int mt6797_dvfsp_handoff_state_release(
+	struct mt6797_dvfsp_handoff *handoff,
+	const struct mt6797_dvfsp_state_hold *hold);
 void mt6797_dvfsp_handoff_state_invalidate(
 	struct mt6797_dvfsp_handoff *handoff,
 	enum mt6797_dvfsp_state_invalidation_reason reason);
@@ -286,6 +306,23 @@ mt6797_dvfsp_handoff_state_validate(
 	return -ENODEV;
 }
 
+static inline int
+mt6797_dvfsp_handoff_state_hold(
+	struct mt6797_dvfsp_handoff *handoff,
+	const struct mt6797_dvfsp_state_snapshot *snapshot,
+	struct mt6797_dvfsp_state_hold *hold)
+{
+	return -ENODEV;
+}
+
+static inline int
+mt6797_dvfsp_handoff_state_release(
+	struct mt6797_dvfsp_handoff *handoff,
+	const struct mt6797_dvfsp_state_hold *hold)
+{
+	return -ENODEV;
+}
+
 static inline void
 mt6797_dvfsp_handoff_state_invalidate(
 	struct mt6797_dvfsp_handoff *handoff,
diff --git a/drivers/soc/mediatek/mt6797-dvfsp-handoff.c b/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
--- a/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
@@ -149,6 +149,8 @@ struct mt6797_dvfsp_handoff {
 	struct mutex state_owner_lock;
 	const struct mt6797_dvfsp_state_owner_ops *state_owner_ops;
 	void *state_owner_context;
+	bool state_hold_active;
+	struct mt6797_dvfsp_state_hold state_hold;
 	struct completion terminal;
 	struct delayed_work late_work;
 	struct mt6797_dvfsp_snapshot samples[MT6797_DVFSP_SAMPLE_COUNT];
@@ -159,5 +161,5 @@ int mt6797_dvfsp_handoff_state_owner_register(
 	int ret = 0;
 
 	if (!handoff || !ops || !ops->snapshot || !ops->validate ||
-	    !ops->invalidate)
+	    !ops->hold || !ops->release || !ops->invalidate)
 		return -EINVAL;
@@ -184,5 +187,7 @@ int mt6797_dvfsp_handoff_state_owner_unregister(
 
 	mutex_lock(&handoff->state_owner_lock);
-	if (handoff->state_owner_ops != ops ||
+	if (handoff->state_hold_active) {
+		ret = -EBUSY;
+	} else if (handoff->state_owner_ops != ops ||
 	    handoff->state_owner_context != context) {
 		ret = -ENOENT;
@@ -245,6 +250,104 @@ int mt6797_dvfsp_handoff_state_validate(
 }
 EXPORT_SYMBOL_GPL(mt6797_dvfsp_handoff_state_validate);
 
+static int
+mt6797_dvfsp_state_hold_check(
+	const struct mt6797_dvfsp_state_snapshot *snapshot,
+	const struct mt6797_dvfsp_state_hold *hold)
+{
+	if (!hold->generation || hold->generation != snapshot->generation ||
+	    hold->cluster_mask != snapshot->cluster_mask ||
+	    hold->reserved || !hold->owner_handle)
+		return -EPROTO;
+
+	return 0;
+}
+
+int mt6797_dvfsp_handoff_state_hold(
+	struct mt6797_dvfsp_handoff *handoff,
+	const struct mt6797_dvfsp_state_snapshot *snapshot,
+	struct mt6797_dvfsp_state_hold *hold)
+{
+	const struct mt6797_dvfsp_state_owner_ops *ops;
+	void *context;
+	int ret;
+
+	if (!handoff || !snapshot || !hold)
+		return -EINVAL;
+
+	ret = mt6797_dvfsp_state_snapshot_check(snapshot);
+	if (ret)
+		return ret;
+
+	mutex_lock(&handoff->state_owner_lock);
+	if (!handoff->state_owner_ops) {
+		ret = -EOPNOTSUPP;
+		goto out_unlock;
+	}
+	if (handoff->state_hold_active) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	ops = handoff->state_owner_ops;
+	context = handoff->state_owner_context;
+	memset(hold, 0, sizeof(*hold));
+	ret = ops->hold(context, snapshot, hold);
+	if (!ret) {
+		ret = mt6797_dvfsp_state_hold_check(snapshot, hold);
+		if (!ret) {
+			handoff->state_hold = *hold;
+			handoff->state_hold_active = true;
+		}
+	}
+
+out_unlock:
+	mutex_unlock(&handoff->state_owner_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_handoff_state_hold);
+
+int mt6797_dvfsp_handoff_state_release(
+	struct mt6797_dvfsp_handoff *handoff,
+	const struct mt6797_dvfsp_state_hold *hold)
+{
+	const struct mt6797_dvfsp_state_owner_ops *ops;
+	void *context;
+	int ret;
+
+	if (!handoff || !hold)
+		return -EINVAL;
+
+	mutex_lock(&handoff->state_owner_lock);
+	if (!handoff->state_hold_active) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	if (memcmp(&handoff->state_hold, hold, sizeof(*hold))) {
+		ret = -EPERM;
+		goto out_unlock;
+	}
+	if (!handoff->state_owner_ops) {
+		ret = -EHOSTDOWN;
+		goto out_unlock;
+	}
+
+	ops = handoff->state_owner_ops;
+	context = handoff->state_owner_context;
+	ret = ops->release(context, hold);
+	if (!ret) {
+		memset(&handoff->state_hold, 0, sizeof(handoff->state_hold));
+		handoff->state_hold_active = false;
+	} else {
+		ops->invalidate(context, MT6797_DVFSP_STATE_INVALID_PCM_FAULT);
+	}
+
+out_unlock:
+	mutex_unlock(&handoff->state_owner_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_handoff_state_release);
+
 void mt6797_dvfsp_handoff_state_invalidate(
 	struct mt6797_dvfsp_handoff *handoff,
 	enum mt6797_dvfsp_state_invalidation_reason reason)
-- 
2.43.0
