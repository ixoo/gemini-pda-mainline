From d884007d829ef72497fb3a1b4ccc14a32184274f Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 25 Aug 2026 23:11:00 +0000
Subject: [PATCH 1/4] pstore: add Gemini A72 platform/provider/clock ledger

Bracket only the third protected-clock reader after the passed platform/provider prefix with exact two-record attribution and no clear or retry.
---
 fs/pstore/Kconfig                            | 32 +++++++++++++++++++-
 fs/pstore/gemini_protected_readback_ledger.c | 18 +++++++++--
 2 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/fs/pstore/Kconfig b/fs/pstore/Kconfig
index cfe81ca..9d6d9f0 100644
--- a/fs/pstore/Kconfig
+++ b/fs/pstore/Kconfig
@@ -265,10 +265,40 @@ config PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION
 	  call, owner registration, CPU request, storage, reset, or power action.
 	  If unsure, say N.
 
+config PSTORE_GEMINI_A72_PLATFORM_PROVIDER_CLOCK_LEDGER
+	bool "Gemini A72 platform/provider/protected-clock retained ledger"
+	depends on PSTORE_GEMINI_PROTECTED_READBACK_LEDGER=y
+	depends on MTK_MT6797_A72_PLATFORM_PROVIDER_CLOCK_OBSERVER=y
+	depends on !PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER
+	depends on !PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER
+	depends on !PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER
+	depends on !PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER
+	depends on !PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER
+	depends on !PSTORE_GEMINI_A72_PHYSICAL_SOURCE_PRECAPTURE_LEDGER
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_PROBE_GATE_LEDGER
+	depends on !PSTORE_GEMINI_CLOCK_BACKEND_ENTRY_LEDGER
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_RAW_ENTRY_LEDGER
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_FIRST_DMESG_WRITE_QUALIFICATION
+	depends on !PSTORE_GEMINI_CLOCK_BACKEND_FIRST_DMESG_ENTRY_QUALIFICATION
+	depends on !PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION
+	default n
+	help
+	  Give the candidate-only three-source observer one retained record after
+	  its platform and provider snapshots and immediately before its sole
+	  protected-clock call, then one record only after that call returns.
+
+	  Reuse the qualified signature-last, full-readback, two-write, no-clear,
+	  and no-retry protocol. The protected-clock call retains its bounded clock
+	  gate and CSPM power-on/semaphore writes. This mode adds no BigiDVFS,
+	  provider action, publisher, owner mutation, or CPU request. If unsure,
+	  say N.
+
 config PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER
 	bool "Gemini A72 platform/provider-snapshot retained ledger"
 	depends on PSTORE_GEMINI_PROTECTED_READBACK_LEDGER=y
 	depends on MTK_MT6797_A72_PLATFORM_PROVIDER_SNAPSHOT_OBSERVER=y
+	depends on !PSTORE_GEMINI_A72_PLATFORM_PROVIDER_CLOCK_LEDGER
 	depends on !PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER
 	depends on !PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER
 	depends on !PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER
@@ -419,7 +449,7 @@ config PSTORE_GEMINI_PROTECTED_READBACK_LEDGER
 	bool "Gemini protected-readback retained call ledger"
 	depends on PSTORE_RAM=y
 	depends on ARM64 && ARCH_MEDIATEK && OF
-	depends on MTK_MT6797_PROTECTED_READBACK_OBSERVER=y || MTK_MT6797_A72_PLATFORM_SNAPSHOT_OBSERVER=y || MTK_MT6797_A72_PLATFORM_PROVIDER_SNAPSHOT_OBSERVER=y || MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y || MTK_MT6797_DVFSP_CLOCK_BACKEND=y || PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL=y
+	depends on MTK_MT6797_PROTECTED_READBACK_OBSERVER=y || MTK_MT6797_A72_PLATFORM_SNAPSHOT_OBSERVER=y || MTK_MT6797_A72_PLATFORM_PROVIDER_SNAPSHOT_OBSERVER=y || MTK_MT6797_A72_PLATFORM_PROVIDER_CLOCK_OBSERVER=y || MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y || MTK_MT6797_DVFSP_CLOCK_BACKEND=y || PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL=y
 	depends on !PSTORE_GEMINI_PRE_RAMOOPS_LEDGER
 	depends on !PSTORE_GEMINI_ARM64_ENTRY_LEDGER
 	default n
diff --git a/fs/pstore/gemini_protected_readback_ledger.c b/fs/pstore/gemini_protected_readback_ledger.c
index f12485e..1d0b213 100644
--- a/fs/pstore/gemini_protected_readback_ledger.c
+++ b/fs/pstore/gemini_protected_readback_ledger.c
@@ -17,6 +17,7 @@
 #if defined(CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_FIRST_DMESG_WRITE_QUALIFICATION) || \
 	defined(CONFIG_PSTORE_GEMINI_CLOCK_BACKEND_FIRST_DMESG_ENTRY_QUALIFICATION) || \
 	defined(CONFIG_PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION) || \
+	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_CLOCK_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER) || \
@@ -149,7 +150,16 @@ static void gemini_prb_capture_map_control(void __iomem *ledger)
 
 static bool gemini_prb_armed;
 
-#ifdef CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER
+#ifdef CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_CLOCK_LEDGER
+static const char * const gemini_prb_records[] = {
+	"====0.000000-D\n"
+	"GEMINI_A72_PLATFORM_PROVIDER_CLOCK_SNAPSHOT_V1 token=GAPC-20260825-A "
+	"checkpoint=before-clock slot=1 crc32=7a63713c\n",
+	"====0.000000-D\n"
+	"GEMINI_A72_PLATFORM_PROVIDER_CLOCK_SNAPSHOT_V1 token=GAPC-20260825-A "
+	"checkpoint=after-clock slot=2 crc32=5773d4f6\n",
+};
+#elif defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER)
 static const char * const gemini_prb_records[] = {
 	"====0.000000-D\n"
 	"GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_V1 token=GAPP-20260825-A "
@@ -280,7 +290,8 @@ static bool gemini_prb_slot_empty(void __iomem *slot)
 
 static bool gemini_prb_slot_available(void __iomem *slot)
 {
-#if defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER) || \
+#if defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_CLOCK_LEDGER) || \
+	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER) || \
@@ -331,7 +342,8 @@ static bool gemini_prb_write(void __iomem *slot, const char *record)
 	writel(len, (u8 __iomem *)slot + 4);
 	wmb(); /* Commit start before size. */
 	writel(len, (u8 __iomem *)slot + 8);
-#if defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER) || \
+#if defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_CLOCK_LEDGER) || \
+	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER) || \
