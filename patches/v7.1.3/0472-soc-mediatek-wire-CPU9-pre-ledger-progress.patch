 #include <linux/bitops.h>
 #include <linux/errno.h>
+#include <linux/gemini_cpu9_progress_ledger.h>
 #include <linux/string.h>
 
 #include "mt6797-a72-cpu9-admission-controller-internal.h"
@@ -12,6 +13,7 @@ static bool mt6797_a72_cpu9_admission_ops_valid(
 {
 	return ops && ops->run_cpu8 && ops->cpu8_proof && ops->ready_token &&
 	       ops->derive_cpu9 && ops->publish_cpu9 && ops->prepare_cpu9 &&
+	       ops->progress_begin && ops->progress_checkpoint &&
 	       ops->add_cpu;
 }
 
@@ -69,6 +71,20 @@ static int mt6797_a72_cpu9_admission_terminal(
 	return ret;
 }
 
+static int mt6797_a72_cpu9_admission_progress(
+	struct mt6797_a72_cpu9_admission_state *state,
+	const struct mt6797_a72_cpu9_admission_ops *ops, void *context,
+	u64 cpu8_attempt_id, u32 stage, bool begin)
+{
+	state->progress_stage = stage;
+	state->progress_ret = begin ?
+		ops->progress_begin(context, cpu8_attempt_id) :
+		ops->progress_checkpoint(context, cpu8_attempt_id, stage);
+	return state->progress_ret ? mt6797_a72_cpu9_admission_terminal(
+		state, MT6797_A72_CPU9_ADMISSION_FAILURE_PROGRESS,
+		state->progress_ret) : 0;
+}
+
 void mt6797_a72_cpu9_admission_state_init(
 	struct mt6797_a72_cpu9_admission_state *state)
 {
@@ -105,12 +121,22 @@ int mt6797_a72_cpu9_admission_run(
 			state, MT6797_A72_CPU9_ADMISSION_FAILURE_CPU8_PROOF,
 			state->cpu8_proof_ret ?: -EPROTO);
 	state->cpu8_requests = proof.cpu_requests;
+	ret = mt6797_a72_cpu9_admission_progress(
+		state, ops, context, proof.attempt_id,
+		GEMINI_CPU9_PROGRESS_CPU8_PROOF, true);
+	if (ret)
+		return ret;
 
 	ready = ops->ready_token(context);
 	if (!ready)
 		return mt6797_a72_cpu9_admission_terminal(
 			state, MT6797_A72_CPU9_ADMISSION_FAILURE_READY_TOKEN,
 			-EAGAIN);
+	ret = mt6797_a72_cpu9_admission_progress(
+		state, ops, context, proof.attempt_id,
+		GEMINI_CPU9_PROGRESS_READY_TOKEN, false);
+	if (ret)
+		return ret;
 
 	ret = ops->derive_cpu9(context, ready, &state->cpu9_transaction,
 			       &state->derive_stage);
@@ -123,6 +149,11 @@ int mt6797_a72_cpu9_admission_run(
 		return mt6797_a72_cpu9_admission_terminal(
 			state, MT6797_A72_CPU9_ADMISSION_FAILURE_DERIVE,
 			-EPROTO);
+	ret = mt6797_a72_cpu9_admission_progress(
+		state, ops, context, proof.attempt_id,
+		GEMINI_CPU9_PROGRESS_DERIVE, false);
+	if (ret)
+		return ret;
 
 	ret = ops->publish_cpu9(context, &state->cpu9_transaction);
 	if (ret || !mt6797_a72_cpu9_admission_transaction_valid(
@@ -130,6 +161,11 @@ int mt6797_a72_cpu9_admission_run(
 		return mt6797_a72_cpu9_admission_terminal(
 			state, MT6797_A72_CPU9_ADMISSION_FAILURE_PUBLISH,
 			ret ?: -EPROTO);
+	ret = mt6797_a72_cpu9_admission_progress(
+		state, ops, context, proof.attempt_id,
+		GEMINI_CPU9_PROGRESS_PUBLISH, false);
+	if (ret)
+		return ret;
 
 	state->cpu9_request = (struct mt6797_a72_cpu9_executor_request){
 		.cpu = MT6797_A72_CPU9_EXECUTOR_CPU9,
@@ -148,13 +184,29 @@ int mt6797_a72_cpu9_admission_run(
 	if (ret)
 		return mt6797_a72_cpu9_admission_terminal(
 			state, MT6797_A72_CPU9_ADMISSION_FAILURE_PREPARE, ret);
+	ret = mt6797_a72_cpu9_admission_progress(
+		state, ops, context, proof.attempt_id,
+		GEMINI_CPU9_PROGRESS_PREPARE, false);
+	if (ret)
+		return ret;
+	ret = mt6797_a72_cpu9_admission_progress(
+		state, ops, context, proof.attempt_id,
+		GEMINI_CPU9_PROGRESS_ADD_CPU_DISPATCH, false);
+	if (ret)
+		return ret;
 
 	state->cpu9_requests = 1;
-	ret = ops->add_cpu(context, MT6797_A72_CPU9_EXECUTOR_CPU9);
+	state->cpu9_request_ret =
+		ops->add_cpu(context, MT6797_A72_CPU9_EXECUTOR_CPU9);
+	ret = mt6797_a72_cpu9_admission_progress(
+		state, ops, context, proof.attempt_id,
+		GEMINI_CPU9_PROGRESS_ADD_CPU_RETURN, false);
 	if (ret)
+		return ret;
+	if (state->cpu9_request_ret)
 		return mt6797_a72_cpu9_admission_terminal(
 			state, MT6797_A72_CPU9_ADMISSION_FAILURE_CPU9_REQUEST,
-			ret);
+			state->cpu9_request_ret);
 	return mt6797_a72_cpu9_admission_terminal(
 		state, MT6797_A72_CPU9_ADMISSION_FAILURE_NONE, 0);
 }
