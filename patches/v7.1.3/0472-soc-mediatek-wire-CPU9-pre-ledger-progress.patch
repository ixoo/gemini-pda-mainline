+	u32 progress_stages[GEMINI_CPU9_PROGRESS_ADD_CPU_RETURN];
+	u32 progress_count;
+	u32 fail_progress_stage;
 	unsigned int requested_cpu;
 	bool same_task;
 	struct task_struct *task;
@@ -146,6 +151,36 @@ static int mt6797_a72_cpu9_admission_test_prepare(
 								       0;
 }
 
+static int mt6797_a72_cpu9_admission_test_progress_record(
+	struct mt6797_a72_cpu9_admission_test_context *context, u32 stage)
+{
+	if (context->progress_count < ARRAY_SIZE(context->progress_stages))
+		context->progress_stages[context->progress_count++] = stage;
+	return context->failure == MT6797_CPU9_ADMISSION_FAIL_PROGRESS &&
+	       context->fail_progress_stage == stage ? -EIO : 0;
+}
+
+static int mt6797_a72_cpu9_admission_test_progress_begin(
+	void *data, u64 cpu8_attempt_id)
+{
+	struct mt6797_a72_cpu9_admission_test_context *context = data;
+
+	if (cpu8_attempt_id != context->proof.attempt_id)
+		return -EPROTO;
+	return mt6797_a72_cpu9_admission_test_progress_record(
+		context, GEMINI_CPU9_PROGRESS_CPU8_PROOF);
+}
+
+static int mt6797_a72_cpu9_admission_test_progress_checkpoint(
+	void *data, u64 cpu8_attempt_id, u32 stage)
+{
+	struct mt6797_a72_cpu9_admission_test_context *context = data;
+
+	if (cpu8_attempt_id != context->proof.attempt_id)
+		return -EPROTO;
+	return mt6797_a72_cpu9_admission_test_progress_record(context, stage);
+}
+
 static int mt6797_a72_cpu9_admission_test_add_cpu(void *data,
 						  unsigned int cpu)
 {
@@ -154,6 +189,12 @@ static int mt6797_a72_cpu9_admission_test_add_cpu(void *data,
 	mt6797_a72_cpu9_admission_test_event(
 		context, MT6797_CPU9_ADMISSION_ADD_CPU);
 	context->requested_cpu = cpu;
+	mt6797_a72_cpu9_admission_test_progress_record(
+		context, GEMINI_CPU9_PROGRESS_BINDER_ENTRY);
+	mt6797_a72_cpu9_admission_test_progress_record(
+		context, GEMINI_CPU9_PROGRESS_LEDGER_BEGIN_ENTER);
+	mt6797_a72_cpu9_admission_test_progress_record(
+		context, GEMINI_CPU9_PROGRESS_LEDGER_BEGIN_RETURN);
 	return context->failure == MT6797_CPU9_ADMISSION_FAIL_ADD_CPU ? -EIO :
 								       0;
 }
@@ -166,6 +207,10 @@ static const struct mt6797_a72_cpu9_admission_ops
 		.derive_cpu9 = mt6797_a72_cpu9_admission_test_derive,
 		.publish_cpu9 = mt6797_a72_cpu9_admission_test_publish,
 		.prepare_cpu9 = mt6797_a72_cpu9_admission_test_prepare,
+		.progress_begin =
+			mt6797_a72_cpu9_admission_test_progress_begin,
+		.progress_checkpoint =
+			mt6797_a72_cpu9_admission_test_progress_checkpoint,
 		.add_cpu = mt6797_a72_cpu9_admission_test_add_cpu,
 	};
 
@@ -234,6 +279,11 @@ static void mt6797_a72_cpu9_admission_success_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, context->prepared.provider_retained);
 	KUNIT_EXPECT_TRUE(test, context->prepared.cpu8_online);
 	KUNIT_EXPECT_FALSE(test, context->prepared.cpu9_online);
+	KUNIT_EXPECT_EQ(test, context->progress_count,
+			GEMINI_CPU9_PROGRESS_ADD_CPU_RETURN);
+	for (ret = 0; ret < context->progress_count; ret++)
+		KUNIT_EXPECT_EQ(test, context->progress_stages[ret],
+				(u32)ret + 1);
 }
 
 static void mt6797_a72_cpu9_admission_invalid_repeat_test(struct kunit *test)
@@ -386,6 +436,28 @@ static void mt6797_a72_cpu9_admission_request_failure_test(struct kunit *test)
 			(u32)MT6797_A72_CPU9_ADMISSION_FAILURE_CPU9_REQUEST);
 }
 
+static void mt6797_a72_cpu9_admission_progress_failures_test(
+	struct kunit *test)
+{
+	u32 stage;
+
+	for (stage = GEMINI_CPU9_PROGRESS_CPU8_PROOF;
+	     stage <= GEMINI_CPU9_PROGRESS_ADD_CPU_DISPATCH; stage++) {
+		struct mt6797_a72_cpu9_admission_test_context *context =
+			mt6797_a72_cpu9_admission_test_context(test);
+
+		KUNIT_ASSERT_NOT_NULL(test, context);
+		context->failure = MT6797_CPU9_ADMISSION_FAIL_PROGRESS;
+		context->fail_progress_stage = stage;
+		KUNIT_EXPECT_EQ(test, mt6797_a72_cpu9_admission_run(
+			&context->controller,
+			&mt6797_a72_cpu9_admission_test_ops, context), -EIO);
+		KUNIT_EXPECT_EQ(test, context->controller.progress_stage, stage);
+		KUNIT_EXPECT_EQ(test, context->controller.cpu9_requests, 0U);
+		KUNIT_EXPECT_EQ(test, context->requested_cpu, 0U);
+	}
+}
+
 static struct kunit_case mt6797_a72_cpu9_admission_controller_cases[] = {
 	KUNIT_CASE(mt6797_a72_cpu9_admission_success_test),
 	KUNIT_CASE(mt6797_a72_cpu9_admission_invalid_repeat_test),
@@ -395,6 +467,7 @@ static struct kunit_case mt6797_a72_cpu9_admission_controller_cases[] = {
 	KUNIT_CASE(mt6797_a72_cpu9_admission_publish_failure_test),
 	KUNIT_CASE(mt6797_a72_cpu9_admission_prepare_failure_test),
 	KUNIT_CASE(mt6797_a72_cpu9_admission_request_failure_test),
+	KUNIT_CASE(mt6797_a72_cpu9_admission_progress_failures_test),
 	{ }
 };
 
