+static int mt6797_cpu9_binder_test_progress_checkpoint(
+	u64 cpu8_attempt_id, u32 stage)
+{
+	struct mt6797_cpu9_binder_test_state *state =
+		mt6797_cpu9_binder_test_active;
+
+	if (state->progress_checkpoint_calls <
+	    ARRAY_SIZE(state->progress_stages))
+		state->progress_stages[state->progress_checkpoint_calls++] =
+			stage;
+	if (cpu8_attempt_id !=
+	    mt6797_cpu9_binder_test_request().cpu8_attempt_id)
+		return -EPROTO;
+	return state->failure == MT6797_CPU9_BINDER_FAIL_PROGRESS &&
+	       state->fail_progress_stage == stage ? -EIO : 0;
+}
 
