 	MT6797_A72_CPU9_ADMISSION_FAILURE_CPU9_REQUEST,
 };
 
@@ -48,6 +49,9 @@ struct mt6797_a72_cpu9_admission_ops {
 	int (*prepare_cpu9)(
 		void *context,
 		const struct mt6797_a72_cpu9_executor_request *request);
+	int (*progress_begin)(void *context, u64 cpu8_attempt_id);
+	int (*progress_checkpoint)(void *context, u64 cpu8_attempt_id,
