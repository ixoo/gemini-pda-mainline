@@ -50,6 +55,25 @@ struct mt6797_cpu9_binder_test_state {
 };
 
 static struct mt6797_cpu9_binder_test_state *mt6797_cpu9_binder_test_active;
+static struct mt6797_a72_cpu9_executor_request
