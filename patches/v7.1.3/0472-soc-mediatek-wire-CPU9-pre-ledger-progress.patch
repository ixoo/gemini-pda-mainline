From 6b58ed4c31c1a211a46a57ab247d3f0acd42b456 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 1 Sep 2026 21:21:00 +0000
Subject: [PATCH] soc: mediatek: wire CPU9 pre-ledger progress

Record each CPU8-proof-to-CPU9-ledger boundary in the bounded
third-record progress lane. Require durable stages 1 through 6
before dispatch, stages 7 through 9 in the binder, and stage 10
only after add_cpu() returns.

Keep the single existing CPU9 request and add no CPU_OFF, retry,
watchdog, cluster, reset, storage, or automatic boot action.
---
 drivers/soc/mediatek/Kconfig                  |  6 +-
 .../mt6797-a72-admission-controller.c         | 22 ++++++
 ...7-a72-cpu9-admission-controller-internal.h |  7 ++
 ...t6797-a72-cpu9-admission-controller-test.c | 73 +++++++++++++++++++
 .../mt6797-a72-cpu9-admission-controller.c    | 56 +++++++++++++-
 .../mt6797-a72-cpu9-binder-internal.h         |  1 +
 .../mediatek/mt6797-a72-cpu9-binder-test.c    | 65 +++++++++++++++++
 drivers/soc/mediatek/mt6797-a72-cpu9-binder.c | 21 +++++-
 8 files changed, 245 insertions(+), 6 deletions(-)

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index fba9bd7..2ff59fe 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -563,7 +563,7 @@ config MTK_MT6797_A72_ADMISSION_CONTROLLER
 	depends on ARM64_MT6797_A72_DERIVED_ADMISSION
 	depends on MTK_MT6797_A72_DEFAULT_OFF_BINDER
 	depends on MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER
-	depends on PSTORE_GEMINI_ADMISSION_TRACE=y
+	depends on PSTORE_GEMINI_ADMISSION_TRACE=y || PSTORE_GEMINI_CPU9_PROGRESS_LEDGER=y
 	default n
 	help
 	  Build the candidate-only controller that consumes one boot-local
@@ -597,12 +597,14 @@ config MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER
 	bool "MediaTek MT6797 same-boot CPU9 admission controller"
 	depends on MTK_MT6797_A72_ADMISSION_LIVE_TRIGGER
 	depends on MTK_MT6797_A72_CPU9_BINDER
+	depends on PSTORE_GEMINI_CPU9_PROGRESS_LEDGER=y
 	default n
 	help
 	  Extend the exact one-shot userspace admission trigger so it runs the
 	  unchanged CPU8 controller, requires its terminal membership proof,
 	  derives and publishes one retained-cluster CPU9 transaction, stages
-	  the CPU9 binder, and makes one synchronous add_cpu(9) request.
+	  the CPU9 binder, and makes one synchronous add_cpu(9) request. Ten
+	  ordered retained progress boundaries cover the pre-ledger path.
 
 	  CPU8 failure or any missing proof prevents CPU9 derivation and request.
 	  CPU9 failure retains CPU8, P27, the provider, and the cluster until
