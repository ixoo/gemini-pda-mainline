 mt6797_a72_cpu9_admission_production_ops = {
 	.run_cpu8 = mt6797_a72_admission_run_cpu8,
@@ -376,6 +391,8 @@ mt6797_a72_cpu9_admission_production_ops = {
 	.derive_cpu9 = mt6797_a72_admission_derive_cpu9,
 	.publish_cpu9 = mt6797_a72_admission_publish_cpu9,
 	.prepare_cpu9 = mt6797_a72_admission_prepare_cpu9,
+	.progress_begin = mt6797_a72_admission_progress_begin,
+	.progress_checkpoint = mt6797_a72_admission_progress_checkpoint,
 	.add_cpu = mt6797_a72_admission_add_cpu,
 };
 #endif
@@ -428,6 +445,11 @@ static ssize_t mt6797_a72_admission_cpu9_status(
 			     "cpu9_failure_stage=%u cpu9_derive_stage=%u ",
 		READ_ONCE(controller->cpu9.failure_stage),
 		READ_ONCE(controller->cpu9.derive_stage));
+	len += sysfs_emit_at(
+		buf, len,
+		"cpu9_progress_stage=%u cpu9_progress_ret=%d ",
+		READ_ONCE(controller->cpu9.progress_stage),
+		READ_ONCE(controller->cpu9.progress_ret));
 	len += sysfs_emit_at(
 		buf, len,
 		"cpu9_binder_snapshot_ret=%d cpu9_abi=%u cpu9_lifecycle=%u ",
diff --git a/drivers/soc/mediatek/mt6797-a72-cpu9-admission-controller-internal.h b/drivers/soc/mediatek/mt6797-a72-cpu9-admission-controller-internal.h
