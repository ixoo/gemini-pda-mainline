 /* Fallible profile inputs. A partial record is never published as a plan. */
@@ -312,8 +389,8 @@ struct arm64_late_cpu_evidence {
 	u32 observed_target_revidr[ARM64_LATE_CPU_MAX_TARGETS];
 	struct arm64_late_cpu_target_cap_evidence
 		target_cap[ARM64_LATE_CPU_MAX_TARGETS];
-	struct arm64_late_cpu_target_method_evidence
