From 57d36fd59821b7de2fd81c938414e7f3c5a54229 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Project <noreply@invalid>
Date: Wed, 5 Aug 2026 11:57:34 -0400
Subject: [PATCH] arm64: evaluate MT6797 late-CPU fixture evidence

Add a pure source-only evaluator for the six evidence-dependent late
Cortex-A72 capability rows and their typed CTR, Spectre-v2, Spectre-v4,
and BHB effects. Keep fixture provenance, the unavailable commit path,
and all existing admission vetoes fail closed.

This experiment-only change has no certifying sign-off and is not
submission-ready.
---
 arch/arm64/Kconfig.platforms              |  10 +
 arch/arm64/include/asm/late_cpu_profile.h | 158 ++++-
 arch/arm64/kernel/cpu_errata.c            |  54 ++
 arch/arm64/kernel/cpufeature.c            | 636 +++++++++++++++++-
 arch/arm64/kernel/late_cpu_profile.c      | 129 ++--
 arch/arm64/kernel/mt6797_psci.c           | 780 +++++++++++++++++++++-
 arch/arm64/kernel/proton-pack.c           | 401 +++++++++++
 7 files changed, 2056 insertions(+), 112 deletions(-)

diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 50f67e765..c51788d6a 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -194,6 +194,16 @@ config ARM64_MT6797_A72_CAPABILITY_PROFILE
 	  enables nor admits a CPU boot path; an independent early veto remains
 	  required.
 
+config ARM64_MT6797_A72_FIXTURE_EVIDENCE
+	bool "Exercise the MT6797 late Cortex-A72 evaluator with fixtures"
+	depends on ARM64_MT6797_A72_CAPABILITY_PROFILE
+	default n
+	help
+	  Supply immutable synthetic records to the late Cortex-A72 capability
+	  evaluator. The records are marked FIXTURE and retain the runtime and
+	  unavailable-commit blockers. This option is for source validation only;
+	  it neither describes hardware nor enables a CPU boot path.
+
 config ARCH_MESON
 	bool "Amlogic Platforms"
 	help
