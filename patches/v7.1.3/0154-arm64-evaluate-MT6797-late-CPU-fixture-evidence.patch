+		effects->ctr_mismatch.alternative = 1;
+	}
+
+	effects->spectre_v2.required = !!v2_mask;
+	effects->spectre_v2.target_mask = v2_mask;
+	first_target = -1;
+	for (target = 0; target < ARM64_LATE_CPU_MAX_TARGETS; target++) {
+		if (!(v2_mask & BIT(target)))
+			continue;
+		if (first_target < 0) {
+			first_target = target;
+			continue;
+		}
