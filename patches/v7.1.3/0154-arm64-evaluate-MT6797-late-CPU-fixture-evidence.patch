+static u8 __init
+mt6797_a72_target_mask(const struct arm64_late_cpu_plan *plan, int cap)
+{
+	unsigned int target;
+	u8 mask = 0;
+
+	for (target = 0; target < ARM64_LATE_CPU_MAX_TARGETS; target++)
+		if (test_bit(cap, plan->target[target].local_caps))
+			mask |= BIT(target);
+
+	return mask;
+}
