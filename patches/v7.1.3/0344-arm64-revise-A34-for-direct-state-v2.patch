 int
-mt6797_a72_a34_evaluate(const struct mt6797_a72_a34_observation
-			      *observation)
+mt6797_a72_a34_evaluate(const struct mt6797_a72_a34_observation *observation)
 {
-	size_t tail = offsetof(struct mt6797_a72_a34_observation,
-			       private_replay_proof);
-
 	if (!observation)
 		return -EINVAL;
-	if (observation->abi != MT6797_A72_A34_ELIGIBILITY_ABI ||
-	    (observation->reset_provenance !=
-		MT6797_A72_A34_RESET_PLATFORM &&
-	     observation->reset_provenance !=
-		MT6797_A72_A34_RESET_EXTERNAL) ||
-	    memcmp((const u8 *)observation + tail,
-		   (const u8 *)&a34_expected + tail,
-		   sizeof(*observation) - tail))
+	if (memcmp(observation, &a34_expected, sizeof(*observation)))
 		return -EPERM;
 	return 0;
 }
