From 2473e240ec5dd9d2adae7bc503538b687a8547a0 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 24 Aug 2026 03:03:00 +0000
Subject: [PATCH 3/3] arm64: revise A34 for direct-state v2

Replace duplicated caller fields and reset provenance with one exact direct-state-v2 record and one typed applicable primary-BL31 replay-clear record. Keep the over-strict evaluator pure, default-off, and without a production caller.
---
 arch/arm64/Kconfig                            |  7 +-
 arch/arm64/Kconfig.platforms                  | 14 +--
 .../arm64/include/asm/mt6797_a72_membership.h | 49 +++-------
 .../kernel/mt6797_a72_a34_evaluator_test.c    | 87 ++++++++++--------
 arch/arm64/kernel/mt6797_a72_membership.c     | 92 +++++++++++--------
 5 files changed, 129 insertions(+), 120 deletions(-)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 90ff9b1..57dd31a 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2580,9 +2580,10 @@ config ARM64_MT6797_A72_A34_ELIGIBILITY_KUNIT_TEST
 	select ARM64_MT6797_A72_P24_OWNER_TEST_SEED
 	select ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR
 	help
-	  Exercise both accepted reset-provenance values, null input, every
-	  byte mutation, explicit missing provenance, and unchanged CLOSED
-	  admission without hardware or CPU operations. The suite has no
+	  Exercise the exact direct-state-v2 and typed primary-BL31 replay
+	  fixture, null input, every-byte mutation, missing replay authority,
+	  and unchanged CLOSED admission without hardware or CPU operations.
+	  The over-strict fixture is not physical evidence and the suite has no
 	  production hook.
 
 config ARM64_MT6797_A72_DIRECT_STATE_KUNIT_TEST
diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 052a501..86a9583 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -238,16 +238,16 @@ config ARM64_MT6797_A72_DIRECT_STATE_COMPOSITOR
 	  hardware operation, CPU_ON, or CPU_OFF. If unsure, say N.
 
 config ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR
-	bool "Evaluate the exact MT6797 A72 A34 zero-state tuple"
+	bool "Evaluate exact MT6797 A72 direct and replay state"
 	depends on ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL
 	help
-	  Add a pure, default-off evaluator for the frozen A34 tuple. Its
-	  immutable input must carry explicit platform/external-reset
-	  provenance and owner-safe private replay-zero proof.
+	  Add a pure, default-off evaluator for one exact direct-state-v2
+	  record and one typed applicable primary-BL31 replay-clear record.
+	  The evaluator has no production caller or physical source binding.
 
-	  This option has no production caller and cannot open the owner,
-	  initialize an attempt, call a provider, perform a hardware effect,
-	  arm P30, or issue CPU_ON or CPU_OFF.
+	  This option cannot open the owner, initialize an attempt, call a
+	  provider, perform a hardware effect, arm P30, or issue CPU_ON or
+	  CPU_OFF.
 
 config ARM64_MT6797_A72_P24_ADMISSION_HOOKS
 	bool "Install closed MT6797 A72 CPU-up admission hooks"
diff --git a/arch/arm64/include/asm/mt6797_a72_membership.h b/arch/arm64/include/asm/mt6797_a72_membership.h
index dae61f2..2076a46 100644
--- a/arch/arm64/include/asm/mt6797_a72_membership.h
+++ b/arch/arm64/include/asm/mt6797_a72_membership.h
@@ -25,9 +25,7 @@
  */
 #define MT6797_A72_TRANSACTION_ABI 2
 #define MT6797_A72_OPERATION_SLOTS 4
-#define MT6797_A72_A34_ELIGIBILITY_ABI 1
-#define MT6797_A72_A34_FIRST_GENERATION 1ULL
-#define MT6797_A72_A34_FIRST_COOKIE 0xa7200001ULL
+#define MT6797_A72_A34_ELIGIBILITY_ABI 2
 
 enum mt6797_a72_owner_health {
 	MT6797_A72_OWNER_CLOSED,
@@ -550,43 +548,26 @@ int mt6797_a72_direct_state_test_snapshot(const struct mt6797_a72_direct_topolog
 					  struct mt6797_a72_direct_state_snapshot *snapshot);
 #endif
 
-enum mt6797_a72_a34_reset_provenance {
-	MT6797_A72_A34_RESET_UNKNOWN,
-	MT6797_A72_A34_RESET_PLATFORM,
-	MT6797_A72_A34_RESET_EXTERNAL,
-	MT6797_A72_A34_RESET_ORDINARY_LINUX,
+#define MT6797_A72_A34_REPLAY_ABI 1
+
+enum mt6797_a72_a34_replay_proof {
+	MT6797_A72_A34_REPLAY_UNKNOWN,
+	MT6797_A72_A34_REPLAY_APPLICABLE_PRIMARY_BL31_CLEAR,
 };
 
-enum mt6797_a72_a34_private_replay_proof {
-	MT6797_A72_A34_PRIVATE_REPLAY_UNKNOWN,
-	MT6797_A72_A34_PRIVATE_REPLAY_OWNER_SAFE_ZERO,
+struct mt6797_a72_a34_replay {
+	u32 abi;
+	u32 valid;
+	u32 proof;
+	u32 private_replay_value;
+	u32 reserved[4];
 };
 
 struct mt6797_a72_a34_observation {
 	u32 abi;
-	u32 reset_provenance;
-	u32 private_replay_proof;
-	u32 private_replay_value;
-	u32 max_cpus;
-	u32 nr_cpus;
-	u32 possible_count;
-	u32 present_count;
-	u32 online_count;
-	u32 possible_mask;
-	u32 present_mask;
-	u32 online_mask;
-	u32 cpu8_method_valid;
-	u32 cpu9_method_valid;
-	u32 cpuhp_state_cpu8;
-	u32 cpuhp_state_cpu9;
-	u64 cpu8_mpidr;
-	u64 cpu9_mpidr;
-	struct mt6797_a72_owner_snapshot owner;
-	u64 owner_next_generation;
-	u64 owner_next_cookie;
-	u64 first_generation;
-	u64 first_cookie;
-	struct arm64_late_cpu_startup_snapshot p30;
+	u32 reserved[3];
+	struct mt6797_a72_direct_state_snapshot direct;
+	struct mt6797_a72_a34_replay replay;
 };
 
 #ifdef CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR
