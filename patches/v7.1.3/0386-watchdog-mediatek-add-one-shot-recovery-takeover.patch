From 1b2da02199f25d3b314b548218c35c05a083ab42 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 27 Aug 2026 01:11:00 +0000
Subject: [PATCH 1/2] watchdog: mediatek: add one-shot recovery takeover

Add a default-off MT6797-only 15-second recovery owner that blocks
ordinary watchdog mutations after irreversible takeover.
---
 drivers/watchdog/Kconfig   |  15 +++
 drivers/watchdog/mtk_wdt.c | 268 ++++++++++++++++++++++++++++++++-----
 include/linux/mtk_wdt.h    |  26 ++++
 3 files changed, 279 insertions(+), 30 deletions(-)

diff --git a/drivers/watchdog/Kconfig b/drivers/watchdog/Kconfig
index 5423cdb..9325ddb 100644
--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -926,6 +926,21 @@ config MEDIATEK_WATCHDOG
 	  To compile this driver as a module, choose M here: the
 	  module will be called mtk_wdt.
 
+config MEDIATEK_WATCHDOG_RECOVERY_TAKEOVER
+	bool "MediaTek MT6797 one-shot recovery watchdog takeover"
+	depends on ARM64 && ARCH_MEDIATEK
+	depends on OF
+	depends on WATCHDOG=y && MEDIATEK_WATCHDOG=y
+	default n
+	help
+	  Add a private MT6797-only API that irreversibly takes ownership of
+	  the TOPRGU watchdog for one exact 15-second reset deadline. After
+	  takeover, ordinary ping, timeout, pretimeout, start, and stop calls
+	  are rejected before MMIO so no kicker can extend the deadline.
+
+	  This option adds no caller, trigger, CPU operation, retained-memory
+	  write, or boot policy. If unsure, say N.
+
 config MEDIATEK_WATCHDOG_BOOT_STATUS_CAPTURE
 	bool "Capture raw MediaTek watchdog boot status"
 	depends on MEDIATEK_WATCHDOG=y
