 #endif
 
 #define WDT_MAX_TIMEOUT		31
 #define WDT_MIN_TIMEOUT		2
 #define WDT_LENGTH_TIMEOUT(n)	((n) << 5)
+#define WDT_LENGTH_TIMEOUT_MASK	GENMASK(15, 5)
 
 #define WDT_LENGTH		0x04
 #define WDT_LENGTH_KEY		0x8
@@ -59,6 +63,10 @@
 #define WDT_MODE_DUAL_EN	(1 << 6)
 #define WDT_MODE_CNT_SEL	(1 << 8)
 #define WDT_MODE_KEY		0x22000000
+#define WDT_MODE_RECOVERY_DISABLE_MASK (WDT_MODE_IRQ_EN | WDT_MODE_DUAL_EN)
+#define WDT_MODE_RECOVERY_ENABLE_MASK (WDT_MODE_EN | WDT_MODE_AUTO_START)
+#define WDT_MODE_RECOVERY_MASK (WDT_MODE_RECOVERY_DISABLE_MASK | WDT_MODE_RECOVERY_ENABLE_MASK)
+#define MTK_WDT_RECOVERY_TIMEOUT_SECONDS	15U
 
 #define WDT_SWRST		0x14
 #define WDT_SWRST_KEY		0x1209
