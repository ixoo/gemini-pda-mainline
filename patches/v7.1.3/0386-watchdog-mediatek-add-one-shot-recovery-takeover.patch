 }
 
+#if IS_ENABLED(CONFIG_MEDIATEK_WATCHDOG_RECOVERY_TAKEOVER)
+static int
+mtk_wdt_recovery_execute(struct mtk_wdt_recovery_owner *owner,
+			 const struct mtk_wdt_recovery_register_ops *ops,
+			 void *context, unsigned int timeout_ms,
+			 struct mtk_wdt_recovery_result *result)
+{
+	u32 length;
+	u32 mode;
+
+	if (!result)
+		return -EINVAL;
+	*result = (struct mtk_wdt_recovery_result){};
+	if (!owner || !ops || !ops->read || !ops->write ||
+	    !ops->next_identity || timeout_ms != MTK_WDT_RECOVERY_TIMEOUT_MS)
+		return -EINVAL;
+	if (owner->owned) {
+		result->identity = owner->identity;
+		result->owned = 1;
+		return -EALREADY;
+	}
+
+	result->mode_before = ops->read(context, WDT_MODE);
+	owner->identity = ops->next_identity(context);
+	if (!owner->identity)
+		return -EOVERFLOW;
+
+	owner->owned = true;
+	result->identity = owner->identity;
+	result->owned = 1;
+	length = WDT_LENGTH_TIMEOUT(MTK_WDT_RECOVERY_TIMEOUT_SECONDS << 6);
+	mode = result->mode_before & ~(WDT_MODE_IRQ_EN | WDT_MODE_DUAL_EN);
+	mode |= WDT_MODE_EN | WDT_MODE_AUTO_START;
+	ops->write(context, WDT_LENGTH, length | WDT_LENGTH_KEY);
+	ops->write(context, WDT_MODE, mode | WDT_MODE_KEY);
+	ops->write(context, WDT_RST, WDT_RST_RELOAD);
+	result->length_after = ops->read(context, WDT_LENGTH);
+	result->mode_after = ops->read(context, WDT_MODE);
+
+	if ((result->length_after & WDT_LENGTH_TIMEOUT_MASK) != length ||
+	    (result->mode_after & WDT_MODE_RECOVERY_MASK) !=
+		    (WDT_MODE_EN | WDT_MODE_AUTO_START))
+		return -EIO;
+
+	return 0;
+}
+
+static u32 mtk_wdt_recovery_read(void *context, u32 offset)
+{
+	struct mtk_wdt_dev *mtk_wdt = context;
+
+	return ioread32(mtk_wdt->wdt_base + offset);
+}
+
+static void mtk_wdt_recovery_write(void *context, u32 offset, u32 value)
+{
+	struct mtk_wdt_dev *mtk_wdt = context;
+
+	iowrite32(value, mtk_wdt->wdt_base + offset);
+}
+
+static u64 mtk_wdt_recovery_next_identity(void *context)
+{
+	u64 identity;
+
+	(void)context;
+	identity = (u64)atomic64_inc_return(&mtk_wdt_recovery_identity);
+	if (!identity)
+		identity = (u64)atomic64_inc_return(&mtk_wdt_recovery_identity);
+	return identity;
+}
+
+static const struct mtk_wdt_recovery_register_ops
+mtk_wdt_recovery_ops = {
+	.read = mtk_wdt_recovery_read,
+	.write = mtk_wdt_recovery_write,
+	.next_identity = mtk_wdt_recovery_next_identity,
+};
+
+int mtk_wdt_recovery_takeover(struct device *dev, unsigned int timeout_ms,
+			      struct mtk_wdt_recovery_result *result)
+{
+	struct mtk_wdt_dev *mtk_wdt;
+	unsigned long flags;
+	int ret;
+
+	if (!result)
+		return -EINVAL;
+	*result = (struct mtk_wdt_recovery_result){};
+	if (!dev)
+		return -EINVAL;
+	mtk_wdt = dev_get_drvdata(dev);
+	if (!mtk_wdt)
+		return -ENODEV;
+	if (!mtk_wdt->recovery_supported)
+		return -EOPNOTSUPP;
+
+	spin_lock_irqsave(&mtk_wdt->recovery_lock, flags);
+	ret = mtk_wdt_recovery_execute(&mtk_wdt->recovery,
+				       &mtk_wdt_recovery_ops, mtk_wdt,
+				       timeout_ms, result);
+	if (result->owned) {
+		mtk_wdt->wdt_dev.timeout = MTK_WDT_RECOVERY_TIMEOUT_SECONDS;
+		mtk_wdt->wdt_dev.pretimeout = 0;
+		set_bit(WDOG_HW_RUNNING, &mtk_wdt->wdt_dev.status);
+	}
+	spin_unlock_irqrestore(&mtk_wdt->recovery_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wdt_recovery_takeover);
+#endif
+
+static int mtk_wdt_mutation_begin(struct mtk_wdt_dev *mtk_wdt,
+				  unsigned long *flags)
+{
+#if IS_ENABLED(CONFIG_MEDIATEK_WATCHDOG_RECOVERY_TAKEOVER)
+	spin_lock_irqsave(&mtk_wdt->recovery_lock, *flags);
+	if (mtk_wdt->recovery.owned) {
+		spin_unlock_irqrestore(&mtk_wdt->recovery_lock, *flags);
+		return -EBUSY;
+	}
+#else
+	(void)mtk_wdt;
+	*flags = 0;
+#endif
+	return 0;
+}
+
+static void mtk_wdt_mutation_end(struct mtk_wdt_dev *mtk_wdt,
+				 unsigned long flags)
+{
+#if IS_ENABLED(CONFIG_MEDIATEK_WATCHDOG_RECOVERY_TAKEOVER)
+	spin_unlock_irqrestore(&mtk_wdt->recovery_lock, flags);
+#else
+	(void)mtk_wdt;
+	(void)flags;
+#endif
+}
