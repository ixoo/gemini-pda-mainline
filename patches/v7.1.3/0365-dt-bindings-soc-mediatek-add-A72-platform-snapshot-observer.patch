From 156bdcd1af7d096c9880cc610b6bd7a6d9676eea Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 25 Aug 2026 00:13:00 +0000
Subject: [PATCH 3/4] dt-bindings: soc: mediatek: add A72 platform-snapshot
 observer

Describe the candidate-only observer and its sole platform-state phandle without making it a state owner or transition consumer.
---
 ...mt6797-a72-platform-snapshot-observer.yaml | 36 +++++++++++++++++++
 1 file changed, 36 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-snapshot-observer.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-snapshot-observer.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-snapshot-observer.yaml
new file mode 100644
index 0000000..e9cae0b
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-snapshot-observer.yaml
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-a72-platform-snapshot-observer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 Cortex-A72 platform-snapshot observer
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description: |
+  Candidate-only one-shot observer for one stable read-only snapshot from the
+  MT6797 Cortex-A72 platform-state source. It does not own or change power,
+  clock, reset, regulator, CCI, secure-firmware, or CPU state.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-a72-platform-snapshot-observer
+
+  mediatek,platform-state:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the bound MT6797 A72 platform-state source.
+
+required:
+  - compatible
+  - mediatek,platform-state
+
+additionalProperties: false
+
+examples:
+  - |
+    a72-platform-snapshot-observer {
+        compatible = "mediatek,mt6797-a72-platform-snapshot-observer";
+        mediatek,platform-state = <&a72_platform_state>;
+    };
