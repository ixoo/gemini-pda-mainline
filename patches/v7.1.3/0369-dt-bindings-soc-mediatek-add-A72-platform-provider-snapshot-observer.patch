From 7578632c13e3b49ce2e25bbbdf2bca423afb0115 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 25 Aug 2026 01:13:00 +0000
Subject: [PATCH 3/4] dt-bindings: soc: mediatek: add A72 platform/provider
 observer

Describe the candidate-only observer and its sole platform-state phandle without making it a state owner or transition consumer.
---
 ...2-platform-provider-snapshot-observer.yaml | 36 +++++++++++++++++++
 1 file changed, 36 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-provider-snapshot-observer.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-provider-snapshot-observer.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-provider-snapshot-observer.yaml
new file mode 100644
index 0000000..9613016
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-platform-provider-snapshot-observer.yaml
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-a72-platform-provider-snapshot-observer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 Cortex-A72 platform and provider snapshot observer
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description: |
+  Candidate-only one-shot observer for one stable read-only platform snapshot
+  followed by one stable read-only provider snapshot. It does not own or
+  change power, clock, reset, regulator, CCI, secure-firmware, or CPU state.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-a72-platform-provider-snapshot-observer
+
+  mediatek,platform-state:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the bound MT6797 A72 platform-state source.
+
+required:
+  - compatible
+  - mediatek,platform-state
+
+additionalProperties: false
+
+examples:
+  - |
+    a72-platform-provider-snapshot-observer {
+        compatible = "mediatek,mt6797-a72-platform-provider-snapshot-observer";
+        mediatek,platform-state = <&a72_platform_state>;
+    };
