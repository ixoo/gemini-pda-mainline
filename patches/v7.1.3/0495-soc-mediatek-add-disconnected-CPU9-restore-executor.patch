From 39e9379556d99c0263fb8bb2e94573cf6906fa42 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 3 Sep 2026 05:01:00 +0000
Subject: [PATCH 1/2] soc: mediatek: add disconnected CPU9 restore executor

Add a one-shot, operation-injected state machine for the exact
retired CPU9-down parent. Consume one CPU_ON budget only after
its durable checkpoint and require secondary plus full restore
completion, while keeping all physical operations disconnected.
---
 drivers/soc/mediatek/Kconfig                  |  17 +
 drivers/soc/mediatek/Makefile                 |   1 +
 .../mt6797-a72-restore-executor-internal.h    | 167 +++++++
 .../mediatek/mt6797-a72-restore-executor.c    | 429 ++++++++++++++++++
 4 files changed, 614 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-a72-restore-executor-internal.h
 create mode 100644 drivers/soc/mediatek/mt6797-a72-restore-executor.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index 6d98642..564b7f1 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -782,6 +782,23 @@ config MTK_MT6797_A72_HOTPLUG_SNAPSHOT_KUNIT_TEST
 	  operations only. No device, MMIO, I2C, SMC, retained-memory, CPU,
 	  watchdog, or network action occurs.
 
+config MTK_MT6797_A72_RESTORE_EXECUTOR
+	bool "MediaTek MT6797 disconnected CPU9 restore executor"
+	depends on ARM64 && ARCH_MEDIATEK
+	depends on ARM64_MT6797_A72_CPU9_MEMBERSHIP
+	depends on MTK_MT6797_A72_HOTPLUG_EXECUTOR
+	default n
+	help
+	  Build a disconnected operation-injected state machine for one
+	  parent-linked CPU9 restore after an exact CPU9-off transaction.
+	  It requires one CPU_ON budget, secondary completion, full CPUHP
+	  completion, terminal membership verification, and restore-owned
+	  rollback routing.
+
+	  This option binds no production callback and contains no direct
+	  CPU, PSCI, MMIO, watchdog, retained-memory, network, storage, or
+	  device operation. If unsure, say N.
+
 config MTK_MT6797_A72_CPU8_OBSERVER
 	bool "MediaTek MT6797 retained-CPU8 hotplug observer"
 	depends on SMP
