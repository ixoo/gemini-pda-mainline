From 0000000000000000000000000000000000000230 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 11:35:00 -0400
Subject: [PATCH] soc: mediatek: add MT6797 resource-only transition owner

Add the first concrete owner lifecycle for the MT6797 protected readback
resources. The resource owner retains the four backend device references,
provides one externally-held transition mutex and a monotonic generation, and
offers an arbitration-ops adapter for a future calibrated state provider.
Attach and detach are explicit and fail closed; detach waits for an active
transition hold before releasing the borrowed devices.

This is the resource-only gate: it has no platform match, consumer binding,
clock or regulator operation, register write, firmware operation, state-owner
registration, or CPU admission. Writes are represented as permanently
disabled in this lifecycle. A later provider must supply the PPM/CCI, EEM/PTP,
live-rail, and clock callbacks before any owner registration can succeed.
This patch is experiment-only and not submission-ready.
---
 drivers/soc/mediatek/Makefile                            |   1 +
 drivers/soc/mediatek/mt6797-dvfsp-resource-owner.c      | 262 +++++++++++++++++++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-resource-owner.h |  53 +++++++
 3 files changed, 316 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-resource-owner.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-resource-owner.h

diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -4,6 +4,7 @@ obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-source-backends.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-ptp.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-source.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-arbitration.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-resource-owner.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-snapshot.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-runtime-bind.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND) += mt6797-dvfsp-clock-state.o
diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-resource-owner.h b/include/linux/soc/mediatek/mt6797-dvfsp-resource-owner.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-resource-owner.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_MEDIATEK_MT6797_DVFSP_RESOURCE_OWNER_H
+#define __LINUX_SOC_MEDIATEK_MT6797_DVFSP_RESOURCE_OWNER_H
+
+#include <linux/mutex.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h>
+
+#define MT6797_DVFSP_RESOURCE_OWNER_ABI	1
+
+/*
+ * This object owns resource lifetime and serialization only. It is not a
+ * state provider and never registers the handoff owner by itself.
+ */
+struct mt6797_dvfsp_resource_owner {
+	struct mutex lifecycle_lock;
+	struct mutex transition_lock;
+	struct mt6797_dvfsp_state_source_devices devices;
+	u64 generation;
+	u64 transition_handle;
+	bool initialized;
+	bool attached;
+	bool source_bound;
+	bool writes_disabled;
+};
+
+int mt6797_dvfsp_resource_owner_init(
+	struct mt6797_dvfsp_resource_owner *owner, u64 transition_handle);
+
+int mt6797_dvfsp_resource_owner_attach(
+	struct mt6797_dvfsp_resource_owner *owner,
+	const struct mt6797_dvfsp_state_source_devices *devices);
+
+int mt6797_dvfsp_resource_owner_detach(
+	struct mt6797_dvfsp_resource_owner *owner);
+
+/* Bind a calibrated source before borrowing the attached device tuple. */
+int mt6797_dvfsp_resource_owner_bind_source(
+	struct mt6797_dvfsp_resource_owner *owner);
+
+int mt6797_dvfsp_resource_owner_unbind_source(
+	struct mt6797_dvfsp_resource_owner *owner);
+
+/* The caller must hold the owner transition lock while advancing the epoch. */
+int mt6797_dvfsp_resource_owner_advance_generation(
+	struct mt6797_dvfsp_resource_owner *owner);
+
+int mt6797_dvfsp_resource_owner_arbitration_ops_init(
+	const struct mt6797_dvfsp_resource_owner *owner,
+	struct mt6797_dvfsp_state_owner_arbitration_ops *ops);
+
+#endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_RESOURCE_OWNER_H */
diff --git a/drivers/soc/mediatek/mt6797-dvfsp-resource-owner.c b/drivers/soc/mediatek/mt6797-dvfsp-resource-owner.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-dvfsp-resource-owner.c
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MT6797 DVFSP resource-only owner.
+ *
+ * This object provides only device lifetime, one transition mutex, and an
+ * epoch for a future source provider. It intentionally has no hardware
+ * operation and no handoff registration path.
+ */
+
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-resource-owner.h>
+
+static int mt6797_dvfsp_resource_devices_check(
+	const struct mt6797_dvfsp_state_source_devices *devices)
+{
+	if (!devices || !devices->clock_backend ||
+	    !devices->bigidvfs_backend || !devices->thermal ||
+	    !devices->calibration_source)
+		return -ENODEV;
+
+	return 0;
+}
+
+static void mt6797_dvfsp_resource_devices_release(
+	struct mt6797_dvfsp_state_source_devices *devices)
+{
+	if (!devices)
+		return;
+
+	if (devices->calibration_source)
+		put_device(devices->calibration_source);
+	if (devices->thermal)
+		put_device(devices->thermal);
+	if (devices->bigidvfs_backend)
+		put_device(devices->bigidvfs_backend);
+	if (devices->clock_backend)
+		put_device(devices->clock_backend);
+	memset(devices, 0, sizeof(*devices));
+}
+
+static int mt6797_dvfsp_resource_devices_retain(
+	struct mt6797_dvfsp_state_source_devices *held,
+	const struct mt6797_dvfsp_state_source_devices *devices)
+{
+	memset(held, 0, sizeof(*held));
+	held->clock_backend = get_device(devices->clock_backend);
+	if (!held->clock_backend)
+		goto err;
+	held->bigidvfs_backend = get_device(devices->bigidvfs_backend);
+	if (!held->bigidvfs_backend)
+		goto err;
+	held->thermal = get_device(devices->thermal);
+	if (!held->thermal)
+		goto err;
+	held->calibration_source = get_device(devices->calibration_source);
+	if (!held->calibration_source)
+		goto err;
+	return 0;
+
+err:
+	mt6797_dvfsp_resource_devices_release(held);
+	return -ENODEV;
+}
+
+int mt6797_dvfsp_resource_owner_init(
+	struct mt6797_dvfsp_resource_owner *owner, u64 transition_handle)
+{
+	if (!owner || !transition_handle)
+		return -EINVAL;
+
+	memset(owner, 0, sizeof(*owner));
+	mutex_init(&owner->lifecycle_lock);
+	mutex_init(&owner->transition_lock);
+	owner->transition_handle = transition_handle;
+	owner->writes_disabled = true;
+	owner->initialized = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_resource_owner_init);
+
+int mt6797_dvfsp_resource_owner_attach(
+	struct mt6797_dvfsp_resource_owner *owner,
+	const struct mt6797_dvfsp_state_source_devices *devices)
+{
+	struct mt6797_dvfsp_state_source_devices held;
+	int ret;
+
+	if (!owner || !owner->initialized)
+		return -EINVAL;
+	ret = mt6797_dvfsp_resource_devices_check(devices);
+	if (ret)
+		return ret;
+
+	mutex_lock(&owner->lifecycle_lock);
+	if (owner->attached) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	mutex_lock(&owner->transition_lock);
+	ret = mt6797_dvfsp_resource_devices_retain(&held, devices);
+	if (!ret) {
+		owner->devices = held;
+		owner->generation = 1;
+		owner->attached = true;
+	}
+	mutex_unlock(&owner->transition_lock);
+
+out_unlock:
+	mutex_unlock(&owner->lifecycle_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_resource_owner_attach);
+
+int mt6797_dvfsp_resource_owner_detach(
+	struct mt6797_dvfsp_resource_owner *owner)
+{
+	struct mt6797_dvfsp_state_source_devices held;
+
+	if (!owner || !owner->initialized)
+		return -EINVAL;
+
+	mutex_lock(&owner->lifecycle_lock);
+	if (!owner->attached) {
+		mutex_unlock(&owner->lifecycle_lock);
+		return -ENOENT;
+	}
+	if (owner->source_bound) {
+		mutex_unlock(&owner->lifecycle_lock);
+		return -EBUSY;
+	}
+
+	mutex_lock(&owner->transition_lock);
+	owner->attached = false;
+	if (owner->generation != U64_MAX)
+		owner->generation++;
+	held = owner->devices;
+	memset(&owner->devices, 0, sizeof(owner->devices));
+	mutex_unlock(&owner->transition_lock);
+	mutex_unlock(&owner->lifecycle_lock);
+
+	mt6797_dvfsp_resource_devices_release(&held);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_resource_owner_detach);
+
+int mt6797_dvfsp_resource_owner_bind_source(
+	struct mt6797_dvfsp_resource_owner *owner)
+{
+	if (!owner || !owner->initialized)
+		return -EINVAL;
+
+	mutex_lock(&owner->lifecycle_lock);
+	if (!owner->attached) {
+		mutex_unlock(&owner->lifecycle_lock);
+		return -ENODEV;
+	}
+	if (owner->source_bound) {
+		mutex_unlock(&owner->lifecycle_lock);
+		return -EBUSY;
+	}
+	owner->source_bound = true;
+	mutex_unlock(&owner->lifecycle_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_resource_owner_bind_source);
+
+int mt6797_dvfsp_resource_owner_unbind_source(
+	struct mt6797_dvfsp_resource_owner *owner)
+{
+	if (!owner || !owner->initialized)
+		return -EINVAL;
+
+	mutex_lock(&owner->lifecycle_lock);
+	if (!owner->source_bound) {
+		mutex_unlock(&owner->lifecycle_lock);
+		return -ENOENT;
+	}
+	mutex_lock(&owner->transition_lock);
+	owner->source_bound = false;
+	mutex_unlock(&owner->transition_lock);
+	mutex_unlock(&owner->lifecycle_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_resource_owner_unbind_source);
+
+int mt6797_dvfsp_resource_owner_advance_generation(
+	struct mt6797_dvfsp_resource_owner *owner)
+{
+	if (!owner || !owner->initialized)
+		return -EINVAL;
+	if (!owner->attached)
+		return -ENODEV;
+	if (owner->generation == U64_MAX)
+		return -EOVERFLOW;
+
+	owner->generation++;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_resource_owner_advance_generation);
+
+static int mt6797_dvfsp_resource_owner_lock(void *context)
+{
+	struct mt6797_dvfsp_resource_owner *owner = context;
+
+	if (!owner || !owner->initialized)
+		return -EINVAL;
+	mutex_lock(&owner->transition_lock);
+	if (!owner->attached) {
+		mutex_unlock(&owner->transition_lock);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static void mt6797_dvfsp_resource_owner_unlock(void *context)
+{
+	struct mt6797_dvfsp_resource_owner *owner = context;
+
+	if (owner && owner->initialized)
+		mutex_unlock(&owner->transition_lock);
+}
+
+static int mt6797_dvfsp_resource_owner_read_generation(
+	void *context, u64 *generation)
+{
+	struct mt6797_dvfsp_resource_owner *owner = context;
+
+	if (!owner || !generation || !owner->initialized)
+		return -EINVAL;
+	if (!owner->attached || !owner->generation)
+		return -ENODEV;
+
+	*generation = owner->generation;
+	return 0;
+}
+
+int mt6797_dvfsp_resource_owner_arbitration_ops_init(
+	const struct mt6797_dvfsp_resource_owner *owner,
+	struct mt6797_dvfsp_state_owner_arbitration_ops *ops)
+{
+	if (!owner || !ops || !owner->initialized)
+		return -EINVAL;
+
+	memset(ops, 0, sizeof(*ops));
+	ops->abi = MT6797_DVFSP_STATE_OWNER_ARBITRATION_ABI;
+	ops->lock = mt6797_dvfsp_resource_owner_lock;
+	ops->unlock = mt6797_dvfsp_resource_owner_unlock;
+	ops->read_generation = mt6797_dvfsp_resource_owner_read_generation;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_resource_owner_arbitration_ops_init);
+
+MODULE_DESCRIPTION("MT6797 DVFSP resource-only transition owner");
+MODULE_LICENSE("GPL");
--
2.43.0
	struct mt6797_dvfsp_state_source_devices devices;
	u64 generation;
	u64 transition_handle;
	bool initialized;
	bool attached;
	bool writes_disabled;
};
 
