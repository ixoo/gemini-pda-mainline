From 8dde54d7e89ca56a9f325a1d01da610594a0f722 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Fri, 31 Jul 2026 14:10:00 -0400
Subject: [PATCH 135/135] kobject: expose Gemini DA921x validation stage

The root-path-corrected discriminator remained pending on a console-
serviceable boot, so its one-bit state cannot identify the next failed
comparison. Add an experiment-only integer stage that records the last
successful validation boundary and expose it read-only below /sys/kernel.

Stages distinguish target identity, devpath, envelope shape, every ordered
entry, final packed layout, sequence presence and numeric content, and full
validation. Keep the existing state, no-printk behavior, target transport
suppression, and normal cleanup. This adds no driver, transfer, provider,
register access, or storage path.
---
 drivers/i2c/Kconfig     | 14 ++++++++++++++
 include/linux/kobject.h |  5 +++++
 kernel/ksysfs.c         | 14 ++++++++++++++
 lib/kobject_uevent.c    | 30 ++++++++++++++++++++++++++++++
 4 files changed, 63 insertions(+)

diff --git a/drivers/i2c/Kconfig b/drivers/i2c/Kconfig
--- a/drivers/i2c/Kconfig
+++ b/drivers/i2c/Kconfig
@@ -155,6 +155,20 @@ config I2C_GEMINI_DA921X_ROOT_PATH_CORRECTION_DIAGNOSTIC
 
 	  Say N outside the named root-path correction experiment.
 
+config I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC
+	bool "Gemini DA921x ordered validation stage discriminator"
+	depends on I2C_GEMINI_DA921X_ROOT_PATH_CORRECTION_DIAGNOSTIC
+	help
+	  Record the last successful comparison in the experiment-only exact
+	  Gemini DA921x add-event validator and expose the integer stage through
+	  /sys/kernel/gemini_da921x_dual_modalias_stage.
+
+	  This retains the existing no-printk state observation, target transport
+	  suppression, and normal cleanup. It does not add a driver, provider,
+	  transfer, register access, or storage path.
+
+	  Say N outside the named ordered-stage experiment.
+
 config I2C_BOARDINFO
 	bool
 	default y
diff --git a/include/linux/kobject.h b/include/linux/kobject.h
--- a/include/linux/kobject.h
+++ b/include/linux/kobject.h
@@ -45,6 +45,11 @@ extern atomic64_t uevent_seqnum;
 extern atomic_t gemini_da921x_dual_modalias_state;
 #endif
 
+#ifdef CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC
+/* experiment-only last successful exact-event validation stage */
+extern atomic_t gemini_da921x_dual_modalias_stage;
+#endif
+
 /*
  * The actions here must match the index to the string array
  * in lib/kobject_uevent.c
diff --git a/kernel/ksysfs.c b/kernel/ksysfs.c
--- a/kernel/ksysfs.c
+++ b/kernel/ksysfs.c
@@ -56,6 +56,17 @@ gemini_da921x_dual_modalias_state_show(struct kobject *kobj,
 KERNEL_ATTR_RO(gemini_da921x_dual_modalias_state);
 #endif
 
+#ifdef CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC
+static ssize_t
+gemini_da921x_dual_modalias_stage_show(struct kobject *kobj,
+				       struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n",
+			  atomic_read(&gemini_da921x_dual_modalias_stage));
+}
+KERNEL_ATTR_RO(gemini_da921x_dual_modalias_stage);
+#endif
+
 /* cpu byteorder */
 static ssize_t cpu_byteorder_show(struct kobject *kobj,
 				  struct kobj_attribute *attr, char *buf)
@@ -207,6 +217,9 @@ static struct attribute * kernel_attrs[] = {
 #ifdef CONFIG_I2C_GEMINI_DA921X_DUAL_MODALIAS_STATE_DIAGNOSTIC
 	&gemini_da921x_dual_modalias_state_attr.attr,
 #endif
+#ifdef CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC
+	&gemini_da921x_dual_modalias_stage_attr.attr,
+#endif
 	&cpu_byteorder_attr.attr,
 	&address_bits_attr.attr,
 #ifdef CONFIG_UEVENT_HELPER
diff --git a/lib/kobject_uevent.c b/lib/kobject_uevent.c
--- a/lib/kobject_uevent.c
+++ b/lib/kobject_uevent.c
@@ -34,6 +34,9 @@ atomic64_t uevent_seqnum;
 #ifdef CONFIG_I2C_GEMINI_DA921X_DUAL_MODALIAS_STATE_DIAGNOSTIC
 atomic_t gemini_da921x_dual_modalias_state = ATOMIC_INIT(0);
 #endif
+#ifdef CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC
+atomic_t gemini_da921x_dual_modalias_stage = ATOMIC_INIT(0);
+#endif
 
 #ifdef CONFIG_UEVENT_HELPER
 char uevent_helper[UEVENT_HELPER_PATH_LEN] = CONFIG_UEVENT_HELPER_PATH;
@@ -508,13 +511,22 @@ static int gemini_da921x_pre_dispatch(struct kobject *kobj,
 	if (action != KOBJ_ADD || strcmp(subsystem, "i2c") ||
 	    strcmp(kobject_name(kobj), "1-0068"))
 		return 0;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+	atomic_set(&gemini_da921x_dual_modalias_stage, 1);
+#endif
 	if (strcmp(devpath, expected_devpath))
 		return -EINVAL;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+	atomic_set(&gemini_da921x_dual_modalias_stage, 2);
+#endif
 	if (env->envp_idx != ARRAY_SIZE(expected) + 1 ||
 	    env->envp_idx >= ARRAY_SIZE(env->envp) ||
 	    env->buflen <= 0 || env->buflen > sizeof(env->buf) ||
 	    env->envp[env->envp_idx])
 		return -EINVAL;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+	atomic_set(&gemini_da921x_dual_modalias_stage, 3);
+#endif
 
 	for (i = 0; i < env->envp_idx; i++) {
 		entry = env->envp[i];
@@ -529,24 +541,42 @@ static int gemini_da921x_pre_dispatch(struct kobject *kobj,
 		if (i < ARRAY_SIZE(expected)) {
 			if (strcmp(entry, expected[i]))
 				return -EINVAL;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+			atomic_set(&gemini_da921x_dual_modalias_stage, 4 + i);
+#endif
 			continue;
 		}
 		if (strncmp(entry, "SEQNUM=", sizeof("SEQNUM=") - 1))
 			return -EINVAL;
 		seqnum = entry + sizeof("SEQNUM=") - 1;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+		atomic_set(&gemini_da921x_dual_modalias_stage, 13);
+#endif
 	}
 	if (env->envp[env->envp_idx - 1] +
 	    strlen(env->envp[env->envp_idx - 1]) + 1 !=
 	    env->buf + env->buflen)
 		return -EINVAL;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+	atomic_set(&gemini_da921x_dual_modalias_stage, 14);
+#endif
 	if (!seqnum || !*seqnum)
 		return -EINVAL;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+	atomic_set(&gemini_da921x_dual_modalias_stage, 15);
+#endif
 	for (entry = seqnum; *entry; entry++)
 		if (!isdigit(*entry))
 			return -EINVAL;
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+	atomic_set(&gemini_da921x_dual_modalias_stage, 16);
+#endif
 
 #if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_DUAL_MODALIAS_STATE_DIAGNOSTIC)
 	atomic_set(&gemini_da921x_dual_modalias_state, 1);
+#if IS_ENABLED(CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC)
+	atomic_set(&gemini_da921x_dual_modalias_stage, 17);
+#endif
 #else
 	pr_info("GEMINI_DA921X_DUAL_MODALIAS_PRE_DISPATCH full_env=validated envp_idx=%d buflen=%d of_modalias=present i2c_modalias=present seqnum=present transport=skipped return=success cleanup=normal\n",
 		env->envp_idx, env->buflen);
-- 
