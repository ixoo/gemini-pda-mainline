From e11f2f80f3fa36c18ac417ce88c0bcaaeaaeaee7 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 3 Sep 2026 02:11:00 +0000
Subject: [PATCH 1/2] soc: mediatek: add hardware-free CPU9 hotplug executor

Add a disconnected, operation-injected state machine for the
split controller, target CPU9, and retained CPU8 lifecycle. It
authorizes one CPU_OFF and validates one affinity result without
binding callbacks or issuing PSCI, MMIO, watchdog, or CPU calls.
---
 drivers/soc/mediatek/Kconfig                  |  27 ++
 drivers/soc/mediatek/Makefile                 |   2 +
 .../mt6797-a72-hotplug-executor-internal.h    | 197 ++++++++
 .../mediatek/mt6797-a72-hotplug-executor.c    | 458 ++++++++++++++++++
 4 files changed, 684 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-a72-hotplug-executor-internal.h
 create mode 100644 drivers/soc/mediatek/mt6797-a72-hotplug-executor.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index 2ff59fe..5ebd1c3 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -726,6 +726,33 @@ config MTK_REGULATOR_COUPLER
 	default ARCH_MEDIATEK
 	depends on REGULATOR
 
+config MTK_MT6797_A72_HOTPLUG_EXECUTOR
+	bool "MediaTek MT6797 CPU9 physical-hotplug executor"
+	depends on ARM64 && ARCH_MEDIATEK
+	default n
+	help
+	  Build a disconnected, operation-injected state machine for one CPU9
+	  physical-off transaction while CPU8 remains online. It validates an
+	  inherited recovery watchdog, one CPU_OFF authorization, one active
+	  affinity call, independent power readback, and shared-state invariance.
+
+	  This option binds no production callback, leaves CPU hotplug vetoed,
+	  and contains no PSCI, MMIO, watchdog, retained-memory, CPU request, or
+	  device operation. If unsure, say N.
+
+config MTK_MT6797_A72_HOTPLUG_EXECUTOR_KUNIT_TEST
+	bool "KUnit tests for the MT6797 CPU9 hotplug executor"
+	depends on KUNIT=y
+	depends on MTK_MT6797_A72_HOTPLUG_EXECUTOR
+	default n
+	help
+	  Exercise the split controller/target lifecycle, exact call budgets,
+	  readback classifier, reversible pre-commit rejection, terminal
+	  post-commit failure, and atomic one-shot behavior in memory only.
+
+	  These tests perform no CPU, PSCI, MMIO, watchdog, retained-memory, or
+	  device action. If unsure, say N.
+
 config MTK_MMSYS
 	tristate "MediaTek MMSYS Support"
 	default ARCH_MEDIATEK
