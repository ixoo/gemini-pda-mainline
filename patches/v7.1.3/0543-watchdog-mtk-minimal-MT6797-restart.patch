From 2a8e8dbb91e5a9df3fbc79090c0e71f2e1d3a4c5 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sun, 6 Sep 2026 08:30:00 +0000
Subject: [PATCH] watchdog: mtk: narrow MT6797 restart diagnostic

Keep the MT6797 firmware auto-start contract on the software restart path,
but do not mutate it while adopting an already-running firmware watchdog or
arming an ordinary watchdog.  Use restart priority 130, immediately ahead of
the arm64 PSCI priority 129.

This is an experiment-only delta.  The reset-controller, boot-status,
recovery-takeover, recovery-validation, and mutation-lock paths are unchanged.
---
 drivers/watchdog/mtk_wdt.c | 16 +++-------------
 1 file changed, 2 insertions(+), 14 deletions(-)

diff --git a/drivers/watchdog/mtk_wdt.c b/drivers/watchdog/mtk_wdt.c
index e7b26be..5d11c4a 100644
--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -108,11 +108,11 @@ static const struct mtk_wdt_data mt6795_data = {
 };
 
 static const struct mtk_wdt_data mt6797_data = {
 	.toprgu_sw_rst_num = MT6797_TOPRGU_SW_RST_NUM,
 	.has_boot_status = true,
 	.recovery_takeover = true,
 	.use_auto_restart = true,
-	.restart_priority = 255,
+	.restart_priority = 130,
 };
 
 static const struct mtk_wdt_data mt8195_data = {
@@ -589,20 +589,10 @@ static void mtk_wdt_init(struct watchdog_device *wdt_dev)
 {
 	struct mtk_wdt_dev *mtk_wdt = watchdog_get_drvdata(wdt_dev);
 	void __iomem *wdt_base;
-	u32 reg;
 
 	wdt_base = mtk_wdt->wdt_base;
 
-	reg = readl(wdt_base + WDT_MODE);
-	if (reg & WDT_MODE_EN) {
-		if (mtk_wdt->use_auto_restart) {
-			if (wdt_dev->pretimeout)
-				reg |= WDT_MODE_IRQ_EN | WDT_MODE_DUAL_EN;
-			else
-				reg &= ~(WDT_MODE_IRQ_EN | WDT_MODE_DUAL_EN);
-			writel(reg | WDT_MODE_AUTO_START | WDT_MODE_KEY,
-			       wdt_base + WDT_MODE);
-		}
+	if (readl(wdt_base + WDT_MODE) & WDT_MODE_EN) {
 		set_bit(WDOG_HW_RUNNING, &wdt_dev->status);
 		mtk_wdt_set_timeout(wdt_dev, wdt_dev->timeout);
 	}
@@ -626,7 +618,5 @@ static int mtk_wdt_start(struct watchdog_device *wdt_dev)
 	if (mtk_wdt->reset_by_toprgu)
 		reg |= WDT_MODE_CNT_SEL;
-	if (mtk_wdt->use_auto_restart)
-		reg |= WDT_MODE_AUTO_START;
 	reg |= WDT_MODE_EN | WDT_MODE_KEY;
 	iowrite32(reg, mtk_wdt->wdt_base + WDT_MODE);
 	mtk_wdt_mutation_end(mtk_wdt, flags);
-- 
