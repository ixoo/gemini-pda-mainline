-		if (i2c->dev_comp->aux_len_reg) {
-			mtk_i2c_writew(i2c, msgs->len, OFFSET_TRANSFER_LEN);
-			mtk_i2c_writew(i2c, (msgs + 1)->len,
-					    OFFSET_TRANSFER_LEN_AUX);
-		} else {
-			mtk_i2c_writew(i2c, msgs->len | ((msgs + 1)->len) << 8,
-					    OFFSET_TRANSFER_LEN);
-		}
+		ret = mtk_i2c_program_wrrd_len(i2c, msgs);
+		if (ret)
+			return ret;
 		mtk_i2c_writew(i2c, I2C_WRRD_TRANAC_VALUE, OFFSET_TRANSAC_LEN);
 	} else {
 		mtk_i2c_writew(i2c, msgs->len, OFFSET_TRANSFER_LEN);
@@ -1110,7 +1235,9 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 	}
 
 	/* Prepare buffer data to start transfer */
-	if (i2c->op == I2C_MASTER_RD) {
+	if (!use_dma) {
+		mtk_i2c_prepare_pio(i2c, msgs);
+	} else if (i2c->op == I2C_MASTER_RD) {
 		writel(I2C_DMA_INT_FLAG_NONE, i2c->pdmabase + OFFSET_INT_FLAG);
 		writel(I2C_DMA_CON_RX | dma_sync, i2c->pdmabase + OFFSET_CON);
 
@@ -1209,9 +1336,11 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 		writel((msgs + 1)->len, i2c->pdmabase + OFFSET_RX_LEN);
 	}
 
-	if (i2c->dvfsp_handoff)
-		atomic_inc(&i2c->dma_start_count);
-	writel(I2C_DMA_START_EN, i2c->pdmabase + OFFSET_EN);
+	if (use_dma) {
+		if (i2c->dvfsp_handoff)
+			atomic_inc(&i2c->dma_start_count);
+		writel(I2C_DMA_START_EN, i2c->pdmabase + OFFSET_EN);
+	}
 
 	if (!i2c->auto_restart) {
 		start_reg = I2C_TRANSAC_START;
@@ -1231,17 +1360,17 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 	mtk_i2c_writew(i2c, ~(restart_flag | I2C_HS_NACKERR | I2C_ACKERR |
 			    I2C_ARB_LOST | I2C_TRANSAC_COMP), OFFSET_INTR_MASK);
 
-	if (i2c->op == I2C_MASTER_WR) {
+	if (use_dma && i2c->op == I2C_MASTER_WR) {
 		dma_unmap_single(i2c->dev, wpaddr,
 				 msgs->len, DMA_TO_DEVICE);
 
 		i2c_put_dma_safe_msg_buf(dma_wr_buf, msgs, true);
-	} else if (i2c->op == I2C_MASTER_RD) {
+	} else if (use_dma && i2c->op == I2C_MASTER_RD) {
 		dma_unmap_single(i2c->dev, rpaddr,
 				 msgs->len, DMA_FROM_DEVICE);
 
 		i2c_put_dma_safe_msg_buf(dma_rd_buf, msgs, true);
-	} else {
+	} else if (use_dma) {
 		dma_unmap_single(i2c->dev, wpaddr, msgs->len,
 				 DMA_TO_DEVICE);
 		dma_unmap_single(i2c->dev, rpaddr, (msgs + 1)->len,
@@ -1251,6 +1380,13 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 		i2c_put_dma_safe_msg_buf(dma_rd_buf, (msgs + 1), true);
 	}
 
+	if (i2c->dev_comp == &mt6797_idvfs_compat &&
+	    i2c->irq_stat & I2C_ARB_LOST) {
+		dev_dbg(i2c->dev, "addr: %x, arbitration lost\n", msgs->addr);
+		mtk_i2c_init_hw(i2c);
+		return -EAGAIN;
+	}
+
 	if (ret == 0) {
 		dev_dbg(i2c->dev, "addr: %x, transfer timeout\n", msgs->addr);
 		i2c_dump_register(i2c);
@@ -1264,6 +1400,22 @@ static int mtk_i2c_do_transfer(struct mtk_i2c *i2c, struct i2c_msg *msgs,
 		return -ENXIO;
 	}
 
+	if (i2c->dev_comp == &mt6797_idvfs_compat &&
+	    i2c->irq_stat != I2C_TRANSAC_COMP) {
+		dev_dbg(i2c->dev, "addr: %x, incomplete transaction: 0x%x\n",
