From 48c05261b521a5257921f87afc26e606f9de367e Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 29 Jul 2026 11:36:48 -0400
Subject: [PATCH 123/125] dt-bindings: regulator: add legacy direct-address
 DA921x

Describe the fixed primary/page2 address tuple separately from the paged DA9211-family interface. Keep regulator outputs optional so identification-only board descriptions do not expose providers.
---
 .../bindings/regulator/dlg,da9213-legacy.yaml | 117 ++++++++++++++++++
 1 file changed, 117 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/dlg,da9213-legacy.yaml

diff --git a/Documentation/devicetree/bindings/regulator/dlg,da9213-legacy.yaml b/Documentation/devicetree/bindings/regulator/dlg,da9213-legacy.yaml
new file mode 100644
index 0000000..8df9976
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/dlg,da9213-legacy.yaml
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/dlg,da9213-legacy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Dialog Semiconductor DA9213-DA9215 legacy direct-address regulators
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description:
+  The legacy DA9213, DA9214, and DA9215 interface exposes its primary and
+  secondary register banks at fixed I2C addresses.  This binding is distinct
+  from dlg,da9211.yaml, whose driver selects paged registers through PAGE_CON.
+  A regulators child describes the physical outputs, but is optional so a
+  board can first bind an identification-only driver without exposing rails.
+
+properties:
+  compatible:
+    enum:
+      - dlg,da9213-legacy
+      - dlg,da9214-legacy
+      - dlg,da9215-legacy
+
+  reg:
+    items:
+      - description:
+          Primary register-bank address. The legacy interface fixes this at
+          0x68.
+      - description:
+          Secondary register-bank address. The legacy interface fixes this at
+          0x69.
+
+  reg-names:
+    items:
+      - const: primary
+      - const: page2
+
+  interrupts:
+    maxItems: 1
+
+  regulators:
+    type: object
+    additionalProperties: false
+    description:
+      Physical buck outputs.  An identification-only integration omits this
+      node until provider behavior has been validated separately.
+
+    patternProperties:
+      "^BUCK[AB]$":
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+        description:
+          Properties for one physical buck output.
+
+        properties:
+          regulator-initial-mode:
+            items:
+              enum: [ 1, 2, 3 ]
+            description:
+              Defined in include/dt-bindings/regulator/dlg,da9211-regulator.h
+
+          regulator-allowed-modes:
+            items:
+              enum: [ 1, 2, 3 ]
+            description:
+              Defined in include/dt-bindings/regulator/dlg,da9211-regulator.h
+
+          enable-gpios:
+            maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: dlg,da9213-legacy
+    then:
+      properties:
+        regulators:
+          properties:
+            BUCKB: false
+  - if:
+      properties:
+        compatible:
+          enum:
+            - dlg,da9214-legacy
+            - dlg,da9215-legacy
+    then:
+      properties:
+        regulators:
+          required:
+            - BUCKA
+            - BUCKB
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        regulator@68 {
+            compatible = "dlg,da9214-legacy";
+            reg = <0x68>, <0x69>;
+            reg-names = "primary", "page2";
+        };
+    };
+
+...
