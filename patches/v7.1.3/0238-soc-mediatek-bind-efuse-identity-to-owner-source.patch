From 0000000000000000000000000000000000000238 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 02:00:00 -0400
Subject: [PATCH] soc: mediatek: bind efuse identity to owner source

Connect the read-only efuse/PTP identity cell to the dormant calibrated
owner-source seam. Decode the silicon-selected variant through the existing
PTP identity conversion, then require explicit provider callbacks for the
table epoch and calibration handle instead of fabricating either value.

Widen the owner-source epoch field to u64 so it can exactly match the PPM and
shared-generation contracts. The bridge only reads the existing NVMEM source
and validates its inputs; it does not register an owner, access MMIO, write a
rail, construct an OPP table, or admit CPU8/CPU9. This is experiment-only and
not submission-ready.
---
 drivers/soc/mediatek/Makefile                          |  1 +
 drivers/soc/mediatek/mt6797-dvfsp-identity-source.c   | 81 +++++++++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-identity-source.h | 38 +++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h |  4 +-
 4 files changed, 122 insertions(+), 2 deletions(-)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-identity-source.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-identity-source.h

diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -3,7 +3,8 @@ obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-source-backends.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-ptp.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-source.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-identity-source.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-arbitration.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-resource-owner.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_RESOURCE_OWNER) += mt6797-dvfsp-resource-provider.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_RESOURCE_OWNER) += mt6797-dvfsp-calibrated-provider.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-snapshot.o

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h b/include/linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h
--- a/include/linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h
@@ -14,11 +14,11 @@ struct mt6797_dvfsp_handoff;
 
-#define MT6797_DVFSP_STATE_OWNER_SOURCE_ABI	5
+#define MT6797_DVFSP_STATE_OWNER_SOURCE_ABI	6
 
 /* This identity is read from the selected silicon/PTP source, never guessed. */
 struct mt6797_dvfsp_state_owner_source_identity {
 	u32 abi;
 	u32 variant_id;
-	u32 table_epoch;
+	u64 table_epoch;
 	u64 calibration_handle;
 };
 
diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-identity-source.h b/include/linux/soc/mediatek/mt6797-dvfsp-identity-source.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-identity-source.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_MEDIATEK_MT6797_DVFSP_IDENTITY_SOURCE_H
+#define __LINUX_SOC_MEDIATEK_MT6797_DVFSP_IDENTITY_SOURCE_H
+
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-ptp.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-state-owner-source.h>
+
+#define MT6797_DVFSP_IDENTITY_SOURCE_ABI	1
+
+/*
+ * These callbacks are the provider's provenance boundary. The bridge never
+ * invents an epoch or calibration handle and never reads a mutable table
+ * without the provider's explicit source contract.
+ */
+struct mt6797_dvfsp_identity_provenance_ops {
+	u32 abi;
+	int (*read_table_epoch)(void *context,
+				const struct mt6797_dvfsp_ptp_identity *identity,
+				u64 *table_epoch);
+	int (*read_calibration_handle)(void *context,
+					const struct mt6797_dvfsp_ptp_identity *identity,
+					u64 *calibration_handle);
+};
+
+/* Device pointers are borrowed and remain owned by the caller. */
+struct mt6797_dvfsp_identity_source {
+	struct mt6797_dvfsp_state_source_devices devices;
+	const struct mt6797_dvfsp_identity_provenance_ops *provenance_ops;
+	void *provenance_context;
+};
+
+int mt6797_dvfsp_identity_source_read(
+	void *context, const struct mt6797_dvfsp_ptp_state *ptp_state,
+	struct mt6797_dvfsp_state_owner_source_identity *identity);
+
+#endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_IDENTITY_SOURCE_H */

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-identity-source.c b/drivers/soc/mediatek/mt6797-dvfsp-identity-source.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-dvfsp-identity-source.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bind read-only MT6797 efuse/PTP identity to owner provenance.
+ *
+ * The table epoch and calibration handle remain explicit provider callbacks;
+ * this bridge only decodes the selected variant and validates provenance.
+ */
+
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-identity-source.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-ptp.h>
+
+static int mt6797_dvfsp_identity_source_check(
+	const struct mt6797_dvfsp_identity_source *source,
+	const struct mt6797_dvfsp_ptp_state *ptp_state)
+{
+	if (!source || !ptp_state ||
+	    ptp_state->abi != MT6797_DVFSP_PTP_STATE_ABI ||
+	    ptp_state->bank_mask != MT6797_DVFSP_PTP_BANK_MASK_ALL ||
+	    !source->devices.calibration_source || !source->provenance_ops ||
+	    source->provenance_ops->abi != MT6797_DVFSP_IDENTITY_SOURCE_ABI ||
+	    !source->provenance_ops->read_table_epoch ||
+	    !source->provenance_ops->read_calibration_handle)
+		return -EINVAL;
+
+	return 0;
+}
+
+int mt6797_dvfsp_identity_source_read(
+	void *context, const struct mt6797_dvfsp_ptp_state *ptp_state,
+	struct mt6797_dvfsp_state_owner_source_identity *identity)
+{
+	struct mt6797_dvfsp_identity_source *source = context;
+	struct mt6797_dvfsp_efuse_identity raw;
+	struct mt6797_dvfsp_ptp_identity decoded;
+	u64 table_epoch;
+	u64 calibration_handle;
+	int ret;
+
+	if (!identity)
+		return -EINVAL;
+	ret = mt6797_dvfsp_identity_source_check(source, ptp_state);
+	if (ret)
+		return ret;
+
+	memset(&raw, 0, sizeof(raw));
+	ret = mt6797_dvfsp_state_source_backend_read_ptp_identity(
+		&source->devices, &raw);
+	if (ret)
+		return ret;
+	ret = mt6797_dvfsp_ptp_identity_decode(&raw, &decoded);
+	if (ret || !decoded.variant_id)
+		return ret ? ret : -EPROTO;
+
+	table_epoch = 0;
+	ret = source->provenance_ops->read_table_epoch(
+		source->provenance_context, &decoded, &table_epoch);
+	if (ret || !table_epoch)
+		return ret ? ret : -EPROTO;
+
+	calibration_handle = 0;
+	ret = source->provenance_ops->read_calibration_handle(
+		source->provenance_context, &decoded, &calibration_handle);
+	if (ret || !calibration_handle)
+		return ret ? ret : -EPROTO;
+
+	memset(identity, 0, sizeof(*identity));
+	identity->abi = MT6797_DVFSP_STATE_OWNER_SOURCE_ABI;
+	identity->variant_id = decoded.variant_id;
+	identity->table_epoch = table_epoch;
+	identity->calibration_handle = calibration_handle;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_identity_source_read);
+
+MODULE_DESCRIPTION("MT6797 read-only efuse identity source bridge");
+MODULE_LICENSE("GPL");
-- 
2.43.0
