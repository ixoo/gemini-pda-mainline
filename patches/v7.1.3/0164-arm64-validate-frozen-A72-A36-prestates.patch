From 816311d70172e6bbb8267c9fc78c19a5f6ee90f8 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 5 Aug 2026 19:39:36 -0400
Subject: [PATCH] arm64: validate frozen A72 A36 prestates

Validate A36 prestate records after frozen-token minting.

Bind CPU8/CPU9 prerequisites to the exact transaction.

Reject mismatches as terminal no-effect and retain no production caller.

This experiment-only change has no hardware or CPU_ON effects.

P17/P18, build, device, and submission remain absent.
---
 .../arm64/include/asm/mt6797_a72_membership.h |  60 ++++++-
 arch/arm64/kernel/mt6797_a72_membership.c     | 149 +++++++++++++++++-
 .../arm64/kernel/mt6797_a72_membership_test.c | 141 +++++++++++++++--
 3 files changed, 333 insertions(+), 17 deletions(-)

diff --git a/arch/arm64/include/asm/mt6797_a72_membership.h b/arch/arm64/include/asm/mt6797_a72_membership.h
index fd66fc47e..5571ed8b9 100644
--- a/arch/arm64/include/asm/mt6797_a72_membership.h
+++ b/arch/arm64/include/asm/mt6797_a72_membership.h
@@ -13,9 +13,10 @@
 /*
  * Version of a dormant C owner-model layout, not a P17/P18/P24 token ABI or
  * wire/hardware ABI. This slice consumes a P31 attempt and can mint a frozen
- * token only in an explicitly opened test state; it implements no bootstrap,
- * A36 prestate, provider or CPUHP effect, P30 handoff, P14/P15, hardware
- * mutation, or CPU_ON operation.
+ * token only in an explicitly opened test state; A36 only validates an
+ * immutable caller-supplied prestate record. It implements no bootstrap,
+ * provider or CPUHP effect, P30 handoff, P14/P15, hardware mutation, or
+ * CPU_ON operation.
  */
 #define MT6797_A72_TRANSACTION_ABI 1
 #define MT6797_A72_OPERATION_SLOTS 4
@@ -90,6 +91,15 @@ enum mt6797_a72_owner_fault {
 #define MT6797_A72_OBSERVER_WINDOW_CLOSED 0
 #define MT6797_A72_OBSERVER_WINDOW_OPEN 1
 
+/* A36 is an immutable prestate record, not a hardware access interface. */
+#define MT6797_A72_A36_PRESTATE_ABI 1
+#define MT6797_A72_A36_CALL_SHAPE_NONE 0
+#define MT6797_A72_A36_CALL_SHAPE_TWO_ARG 1
+#define MT6797_A72_A36_DA921X_PAGE 0x80
+#define MT6797_A72_A36_BUCKB_VSEL 0x46
+#define MT6797_A72_A36_SPM_218 0x00010132
+#define MT6797_A72_A36_SPM_290 0x00000002
+
 /* Diagnostic only: this non-exhaustive list can never authorize a request. */
 #define MT6797_A72_BLOCK_A34_BOOTSTRAP BIT_ULL(0)
 #define MT6797_A72_BLOCK_A41_READY BIT_ULL(1)
@@ -144,16 +154,45 @@ struct mt6797_a72_entry_snapshot {
 	u64 cpu9_mpidr;
 };
 
+struct mt6797_a72_a36_prestate {
+	u32 abi;
+	u32 operation;
+	u32 observer_window;
+	u32 call_shape;
+	u32 cpu8_online;
+	u32 cpu9_online;
+	u32 da921x_page;
+	u32 buckb_enabled;
+	u32 buckb_vsel;
+	u32 spm_218;
+	u32 spm_290;
+	u32 toprgu_pwrap_reset;
+	u32 mp2_dcm;
+	u32 secure_sentinels_stable;
+	u32 protected_clock_valid;
+	u32 pstore_console_available;
+	u32 watchdog_owned;
+	u32 cpu8_cluster_dcm_published;
+	u32 shared_write_set;
+	u32 reserved;
+	u64 target_mpidr;
+	u64 secondary_entry_pa;
+	u64 generation;
+	u64 cookie;
+};
+
 struct mt6797_a72_transaction {
 	struct mt6797_a72_transaction_identity identity;
 	struct mt6797_a72_call_budgets budgets;
 	struct mt6797_a72_entry_snapshot entry;
+	struct mt6797_a72_a36_prestate a36_prestate;
 	struct arm64_late_cpu_up_token p30_token;
 	u64 controller_cookie;
 	u64 effect_prefix;
 	u32 mint_source;
 	u32 p30_token_valid;
 	u32 public_preflight;
+	u32 a36_valid;
 	u32 freeze_release_count;
 	u32 valid;
 };
@@ -191,7 +230,11 @@ mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
 			       u32 attempt,
 			       const struct mt6797_a72_entry_snapshot *entry,
 			       const struct arm64_late_cpu_ready_token *ready,
+			       const struct mt6797_a72_a36_prestate *prestate,
 			       struct mt6797_a72_transaction *transaction);
+int
+mt6797_a72_membership_validate_up_prestate(const struct mt6797_a72_transaction *transaction,
+					   const struct mt6797_a72_a36_prestate *prestate);
 int mt6797_a72_membership_validate_entry(unsigned int cpu,
 					 enum cpuhp_state target, u32 attempt,
 					 const struct mt6797_a72_entry_snapshot *entry);
@@ -209,16 +252,27 @@ mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
 			       u32 attempt,
 			       const struct mt6797_a72_entry_snapshot *entry,
 			       const struct arm64_late_cpu_ready_token *ready,
+			       const struct mt6797_a72_a36_prestate *prestate,
 			       struct mt6797_a72_transaction *transaction)
 {
 	(void)attempt;
 	(void)entry;
 	(void)ready;
+	(void)prestate;
 	if (transaction)
 		memset(transaction, 0, sizeof(*transaction));
 	return -EOPNOTSUPP;
 }
 
+static inline int
+mt6797_a72_membership_validate_up_prestate(const struct mt6797_a72_transaction *transaction,
+					   const struct mt6797_a72_a36_prestate *prestate)
+{
+	(void)transaction;
+	(void)prestate;
+	return -EOPNOTSUPP;
+}
+
 static inline int mt6797_a72_membership_validate_entry(unsigned int cpu,
 						 enum cpuhp_state target, u32 attempt,
 						 const struct mt6797_a72_entry_snapshot *entry)
diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index 924b6619d..cf3044b54 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -5,8 +5,9 @@
  * The transaction-begin path deliberately has no production caller or opener.
  * Read-only admission callbacks may inspect CLOSED. A dormant P31 ledger
  * consumes a one-shot attempt only in a test-seeded AVAILABLE state, then
- * retains the transition lock across A28 and frozen-token minting. A36,
- * P17/P18, and all hardware/CPU_ON effects remain absent.
+ * retains the transition lock across A28, frozen-token minting, and the
+ * immutable A36 prestate check. P17/P18 and all hardware/CPU_ON effects
+ * remain absent.
  */
 
 #include <linux/compiler.h>
@@ -17,7 +18,9 @@
 #include <linux/spinlock.h>
 #include <linux/string.h>
 
+#include <asm/memory.h>
 #include <asm/mt6797_a72_membership.h>
+#include <asm/smp.h>
 
 static DEFINE_MUTEX(a72_transition_lock);
 static DEFINE_RAW_SPINLOCK(a72_state_lock);
@@ -179,6 +182,74 @@ mt6797_a72_membership_p31_consume_attempt(unsigned int cpu,
 	return ret;
 }
 
+int
+mt6797_a72_membership_validate_up_prestate(const struct mt6797_a72_transaction *transaction,
+					   const struct mt6797_a72_a36_prestate *prestate)
+{
+	const struct mt6797_a72_transaction_identity *identity;
+	u64 expected_mpidr;
+
+	if (!transaction || !prestate)
+		return -EAGAIN;
+	identity = &transaction->identity;
+	if (!transaction->valid || !transaction->p30_token_valid ||
+	    identity->abi != MT6797_A72_TRANSACTION_ABI ||
+	    identity->owner != ARM64_LATE_CPU_STARTUP_OWNER_MEMBERSHIP ||
+	    identity->cpuhp_target != CPUHP_ONLINE ||
+	    (identity->operation != ARM64_LATE_CPU_STARTUP_OP_CPU8_UP &&
+	     identity->operation != ARM64_LATE_CPU_STARTUP_OP_CPU9_UP))
+		return -EPERM;
+
+	expected_mpidr = identity->operation ==
+		ARM64_LATE_CPU_STARTUP_OP_CPU8_UP ? 0x200 : 0x201;
+	if (prestate->abi != MT6797_A72_A36_PRESTATE_ABI ||
+	    prestate->operation != identity->operation ||
+	    prestate->observer_window != MT6797_A72_OBSERVER_WINDOW_OPEN ||
+	    prestate->call_shape != MT6797_A72_A36_CALL_SHAPE_TWO_ARG ||
+	    prestate->reserved ||
+	    prestate->target_mpidr != expected_mpidr ||
+	    prestate->secondary_entry_pa != __pa_symbol(secondary_entry) ||
+	    identity->cpu_on_entry_pa != prestate->secondary_entry_pa ||
+	    prestate->generation != identity->generation ||
+	    prestate->cookie != identity->cookie ||
+	    identity->target_mpidr != expected_mpidr ||
+	    transaction->p30_token.operation != identity->operation ||
+	    transaction->p30_token.target_cpu != identity->target_cpu ||
+	    transaction->p30_token.target_mpidr != expected_mpidr)
+		return -EPERM;
+
+	if (identity->operation == ARM64_LATE_CPU_STARTUP_OP_CPU8_UP) {
+		if (prestate->cpu8_online || prestate->cpu9_online ||
+		    prestate->da921x_page != MT6797_A72_A36_DA921X_PAGE ||
+		    prestate->buckb_enabled ||
+		    prestate->buckb_vsel != MT6797_A72_A36_BUCKB_VSEL ||
+		    prestate->spm_218 != MT6797_A72_A36_SPM_218 ||
+		    prestate->spm_290 != MT6797_A72_A36_SPM_290 ||
+		    prestate->toprgu_pwrap_reset || prestate->mp2_dcm ||
+		    prestate->secure_sentinels_stable != 1 ||
+		    prestate->protected_clock_valid != 1 ||
+		    prestate->pstore_console_available != 1 ||
+		    prestate->watchdog_owned != 1 ||
+		    prestate->cpu8_cluster_dcm_published ||
+		    prestate->shared_write_set)
+			return -EPERM;
+	} else {
+		if (prestate->cpu8_online != 1 || prestate->cpu9_online ||
+		    prestate->da921x_page || prestate->buckb_enabled ||
+		    prestate->buckb_vsel || prestate->spm_218 ||
+		    prestate->spm_290 || prestate->toprgu_pwrap_reset ||
+		    prestate->mp2_dcm || prestate->secure_sentinels_stable ||
+		    prestate->protected_clock_valid ||
+		    prestate->pstore_console_available ||
+		    prestate->watchdog_owned != 1 ||
+		    prestate->cpu8_cluster_dcm_published != 1 ||
+		    prestate->shared_write_set)
+			return -EPERM;
+	}
+
+	return 0;
+}
+
 static void
 mt6797_a72_init_up_budgets(enum mt6797_a72_membership_operation operation,
 			   struct mt6797_a72_call_budgets *budgets)
@@ -250,6 +321,7 @@ mt6797_a72_membership_mint_up_token(unsigned int cpu,
 		minted.identity.target_cpu = cpu;
 		minted.identity.cpuhp_target = target;
 		minted.identity.target_mpidr = target_mpidr;
+		minted.identity.cpu_on_entry_pa = __pa_symbol(secondary_entry);
 		minted.identity.generation = generation;
 		minted.identity.cookie = cookie;
 		mt6797_a72_init_up_budgets(operation, &minted.budgets);
@@ -279,6 +351,62 @@ mt6797_a72_membership_mint_up_token(unsigned int cpu,
 	return ret;
 }
 
+static int
+mt6797_a72_membership_bind_a36_prestate(const struct mt6797_a72_transaction_identity *identity,
+					const struct mt6797_a72_a36_prestate *prestate,
+					struct mt6797_a72_transaction *transaction)
+{
+	unsigned long flags;
+	int ret = -EPERM;
+
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	if (a72_owner.health == MT6797_A72_OWNER_AVAILABLE &&
+	    a72_owner.phase == MT6797_A72_PHASE_FROZEN &&
+	    a72_owner.active.valid &&
+	    !memcmp(&a72_owner.active.identity, identity,
+		    sizeof(a72_owner.active.identity))) {
+		a72_owner.active.a36_prestate = *prestate;
+		a72_owner.active.a36_valid = 1;
+		*transaction = a72_owner.active;
+		ret = 0;
+	}
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+
+	return ret;
+}
+
+static int
+mt6797_a72_membership_reject_frozen(const struct mt6797_a72_transaction_identity *identity)
+{
+	unsigned int slot;
+	unsigned long flags;
+	int ret = -EPERM;
+
+	if (!identity || identity->operation <
+			ARM64_LATE_CPU_STARTUP_OP_CPU8_UP ||
+	    identity->operation > ARM64_LATE_CPU_STARTUP_OP_CPU9_UP)
+		return -EINVAL;
+	slot = identity->operation - ARM64_LATE_CPU_STARTUP_OP_CPU8_UP;
+
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	if (a72_owner.health == MT6797_A72_OWNER_AVAILABLE &&
+	    a72_owner.phase == MT6797_A72_PHASE_FROZEN &&
+	    a72_owner.active.valid &&
+	    !memcmp(&a72_owner.active.identity, identity,
+		    sizeof(a72_owner.active.identity))) {
+		a72_owner.retired[slot] = a72_owner.active;
+		a72_owner.retired_mask |= BIT(slot);
+		memset(&a72_owner.active, 0, sizeof(a72_owner.active));
+		a72_owner.controller = NULL;
+		a72_owner.controller_cookie = 0;
+		a72_owner.phase = MT6797_A72_PHASE_REJECTED;
+		ret = 0;
+	}
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+
+	return ret;
+}
+
 static int
 mt6797_a72_membership_check_up(unsigned int cpu, int tasks_frozen,
 			       enum cpuhp_state target)
@@ -382,6 +510,7 @@ mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
 			       u32 attempt,
 			       const struct mt6797_a72_entry_snapshot *entry,
 			       const struct arm64_late_cpu_ready_token *ready,
+			       const struct mt6797_a72_a36_prestate *prestate,
 			       struct mt6797_a72_transaction *transaction)
 {
 	int ret;
@@ -402,6 +531,22 @@ mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
 
 	ret = mt6797_a72_membership_mint_up_token(cpu, target, attempt, entry,
 						  ready, transaction);
+	if (ret)
+		goto out_unlock;
+
+	ret = mt6797_a72_membership_validate_up_prestate(transaction, prestate);
+	if (ret) {
+		mt6797_a72_membership_reject_frozen(&transaction->identity);
+		memset(transaction, 0, sizeof(*transaction));
+		goto out_unlock;
+	}
+
+	ret = mt6797_a72_membership_bind_a36_prestate(&transaction->identity,
+						      prestate, transaction);
+	if (ret) {
+		mt6797_a72_membership_reject_frozen(&transaction->identity);
+		memset(transaction, 0, sizeof(*transaction));
+	}
 
 out_unlock:
 	mutex_unlock(&a72_transition_lock);
diff --git a/arch/arm64/kernel/mt6797_a72_membership_test.c b/arch/arm64/kernel/mt6797_a72_membership_test.c
index 90bba2a32..2b8d62704 100644
--- a/arch/arm64/kernel/mt6797_a72_membership_test.c
+++ b/arch/arm64/kernel/mt6797_a72_membership_test.c
@@ -6,7 +6,9 @@
 #include <linux/string.h>
 
 #include <asm/cpu_ops.h>
+#include <asm/memory.h>
 #include <asm/mt6797_a72_membership.h>
+#include <asm/smp.h>
 
 extern const struct cpu_operations mt6797_psci_ops;
 
@@ -57,6 +59,38 @@ mt6797_a72_entry_for_up_closed_window(unsigned int cpu)
 	return entry;
 }
 
+static struct mt6797_a72_a36_prestate
+mt6797_a72_prestate_for_up(unsigned int cpu)
+{
+	struct mt6797_a72_a36_prestate prestate = {
+		.abi = MT6797_A72_A36_PRESTATE_ABI,
+		.observer_window = MT6797_A72_OBSERVER_WINDOW_OPEN,
+		.call_shape = MT6797_A72_A36_CALL_SHAPE_TWO_ARG,
+		.da921x_page = MT6797_A72_A36_DA921X_PAGE,
+		.buckb_vsel = MT6797_A72_A36_BUCKB_VSEL,
+		.spm_218 = MT6797_A72_A36_SPM_218,
+		.spm_290 = MT6797_A72_A36_SPM_290,
+		.secure_sentinels_stable = 1,
+		.protected_clock_valid = 1,
+		.pstore_console_available = 1,
+		.watchdog_owned = 1,
+		.secondary_entry_pa = __pa_symbol(secondary_entry),
+		.generation = 1,
+		.cookie = 0xa7200001,
+	};
+
+	if (cpu == 8) {
+		prestate.operation = ARM64_LATE_CPU_STARTUP_OP_CPU8_UP;
+		prestate.target_mpidr = 0x200;
+	} else {
+		prestate.operation = ARM64_LATE_CPU_STARTUP_OP_CPU9_UP;
+		prestate.cpu8_online = 1;
+		prestate.cpu8_cluster_dcm_published = 1;
+		prestate.target_mpidr = 0x201;
+	}
+	return prestate;
+}
+
 static struct arm64_late_cpu_ready_token
 mt6797_a72_ready_token_for_up(void)
 {
@@ -163,7 +197,7 @@ static void mt6797_a72_owner_cpu8_denied(struct kunit *test)
 	memset(&transaction, 0xa5, sizeof(transaction));
 	ret = mt6797_a72_membership_begin_up(8, CPUHP_ONLINE,
 					     MT6797_A72_ATTEMPT_CPU8_UP,
-					     &entry, NULL, &transaction);
+					     &entry, NULL, NULL, &transaction);
 	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
 	KUNIT_EXPECT_TRUE(test, mt6797_a72_transaction_empty(&transaction));
 	owner_observe(&after);
@@ -182,7 +216,7 @@ static void mt6797_a72_owner_cpu9_denied(struct kunit *test)
 	memset(&transaction, 0x5a, sizeof(transaction));
 	ret = mt6797_a72_membership_begin_up(9, CPUHP_ONLINE,
 					     MT6797_A72_ATTEMPT_CPU9_UP,
-					     &entry, NULL, &transaction);
+					     &entry, NULL, NULL, &transaction);
 	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
 	KUNIT_EXPECT_TRUE(test, mt6797_a72_transaction_empty(&transaction));
 	owner_observe(&after);
@@ -241,7 +275,7 @@ static void mt6797_a72_owner_non_target_invalid(struct kunit *test)
 	int ret;
 
 	ret = mt6797_a72_membership_begin_up(7, CPUHP_ONLINE, 0, NULL, NULL,
-					     &transaction);
+					     NULL, &transaction);
 	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
 	KUNIT_EXPECT_TRUE(test, mt6797_a72_transaction_empty(&transaction));
 }
@@ -252,7 +286,7 @@ static void mt6797_a72_owner_intermediate_target_invalid(struct kunit *test)
 	int ret;
 
 	ret = mt6797_a72_membership_begin_up(8, CPUHP_AP_ONLINE, 0, NULL, NULL,
-					     &transaction);
+					     NULL, &transaction);
 	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
 	KUNIT_EXPECT_TRUE(test, mt6797_a72_transaction_empty(&transaction));
 }
@@ -268,11 +302,11 @@ static void mt6797_a72_owner_repeat_is_diagnostic(struct kunit *test)
 	owner_observe(&before);
 	ret = mt6797_a72_membership_begin_up(8, CPUHP_ONLINE,
 					     MT6797_A72_ATTEMPT_CPU8_UP,
-					     &entry, NULL, &transaction);
+					     &entry, NULL, NULL, &transaction);
 	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
 	ret = mt6797_a72_membership_begin_up(8, CPUHP_ONLINE,
 					     MT6797_A72_ATTEMPT_CPU8_UP,
-					     &entry, NULL, &transaction);
+					     &entry, NULL, NULL, &transaction);
 	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
 	owner_observe(&after);
 	expect_unchanged(test, &before, &after);
@@ -361,6 +395,8 @@ static void mt6797_a72_owner_p31_consumes_once(struct kunit *test)
 	struct mt6797_a72_entry_snapshot entry = mt6797_a72_entry_for_up(8);
 	struct mt6797_a72_entry_snapshot malformed = entry;
 	struct arm64_late_cpu_ready_token ready = mt6797_a72_ready_token_for_up();
+	struct mt6797_a72_a36_prestate prestate = mt6797_a72_prestate_for_up(8);
+	struct mt6797_a72_a36_prestate prestate9 = mt6797_a72_prestate_for_up(9);
 	struct arm64_late_cpu_ready_token bad_ready;
 	struct mt6797_a72_transaction transaction;
 	bool owns_token;
@@ -371,7 +407,7 @@ static void mt6797_a72_owner_p31_consumes_once(struct kunit *test)
 	owner_observe(&before);
 	ret = mt6797_a72_membership_begin_up(8, CPUHP_ONLINE,
 					     MT6797_A72_ATTEMPT_CPU8_UP,
-					     &entry, &ready, &transaction);
+					     &entry, &ready, &prestate, &transaction);
 	KUNIT_EXPECT_EQ(test, ret, 0);
 	KUNIT_EXPECT_FALSE(test, mt6797_a72_transaction_empty(&transaction));
 	KUNIT_EXPECT_EQ(test, transaction.identity.abi,
@@ -380,6 +416,8 @@ static void mt6797_a72_owner_p31_consumes_once(struct kunit *test)
 			(u16)ARM64_LATE_CPU_STARTUP_OP_CPU8_UP);
 	KUNIT_EXPECT_EQ(test, transaction.identity.target_cpu, (u32)8);
 	KUNIT_EXPECT_EQ(test, transaction.identity.target_mpidr, (u64)0x200);
+	KUNIT_EXPECT_EQ(test, transaction.identity.cpu_on_entry_pa,
+			(u64)__pa_symbol(secondary_entry));
 	KUNIT_EXPECT_EQ(test, transaction.identity.generation, (u64)1);
 	KUNIT_EXPECT_EQ(test, transaction.identity.cookie, (u64)0xa7200001);
 	KUNIT_EXPECT_EQ(test, transaction.budgets.preparation,
@@ -391,6 +429,9 @@ static void mt6797_a72_owner_p31_consumes_once(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, transaction.budgets.affinity,
 			(u8)MT6797_A72_BUDGET_NONE);
 	KUNIT_EXPECT_TRUE(test, transaction.p30_token_valid);
+	KUNIT_EXPECT_TRUE(test, transaction.a36_valid);
+	KUNIT_EXPECT_EQ(test, transaction.a36_prestate.spm_218,
+			(u32)MT6797_A72_A36_SPM_218);
 	KUNIT_EXPECT_TRUE(test, transaction.valid);
 	KUNIT_EXPECT_EQ(test, transaction.p30_token.plan_identity[0],
 			(u64)1);
@@ -413,7 +454,7 @@ static void mt6797_a72_owner_p31_consumes_once(struct kunit *test)
 
 	ret = mt6797_a72_membership_begin_up(8, CPUHP_ONLINE,
 					     MT6797_A72_ATTEMPT_CPU8_UP,
