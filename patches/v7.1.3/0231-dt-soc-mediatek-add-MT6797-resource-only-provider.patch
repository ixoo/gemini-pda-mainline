From 0000000000000000000000000000000000000231 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 12:20:00 -0400
Subject: [PATCH] soc: mediatek: add MT6797 resource-only provider

Add a disabled-by-default platform provider for the MT6797 resource-only
owner. The provider resolves the four reviewed resource phandles, holds
temporary OF/device references while attaching, and releases them after the
owner takes its own references. Removal detaches the owner before devm frees
the provider object.

The provider intentionally performs no state readback, register or firmware
operation, secure call, clock or rail change, handoff-owner registration, or
CPU admission. A calibrated PPM/CCI, EEM/PTP, live-rail, and clock provider
remains a separate required step.
This patch is experiment-only and not submission-ready.
---
 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-resource-owner.yaml | 64 +++++++++++
 arch/arm64/boot/dts/mediatek/mt6797.dtsi                 |  9 +++
 drivers/soc/mediatek/Kconfig                             | 12 +++
 drivers/soc/mediatek/Makefile                            |  1 +
 drivers/soc/mediatek/mt6797-dvfsp-resource-provider.c    | 145 +++++++++++++++++++++++
 5 files changed, 231 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-resource-owner.yaml
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-resource-provider.c

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-resource-owner.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-resource-owner.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-resource-owner.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-dvfsp-resource-owner.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 DVFSP resource-only owner
+
+maintainers:
+  - Gemini Mainline Experiment <gemini-mainline@example.invalid>
+
+description: |
+  This optional node binds only the resource-lifetime owner for a future
+  MT6797 DVFSP state provider. It retains the four referenced device objects,
+  serializes a future transition, and tracks a monotonic generation. It does
+  not read clocks, rails, EEM, PTP, or PPM state; it does not access registers,
+  call firmware, change clocks or rails, or register a DVFSP state owner.
+  Keep the node disabled until every referenced backend has an independently
+  reviewed provider contract.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-dvfsp-resource-owner
+
+  mediatek,clock-backend:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Protected CPU clock resource object.
+
+  mediatek,bigidvfs-backend:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: BigiDVFS resource object.
+
+  mediatek,thermal:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: EEM/thermal resource object.
+
+  mediatek,calibration-source:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Read-only calibration source resource object.
+
+  status:
+    enum: [ disabled, okay ]
+
+required:
+  - compatible
+  - mediatek,clock-backend
+  - mediatek,bigidvfs-backend
+  - mediatek,thermal
+  - mediatek,calibration-source
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+      dvfsp_resource_owner: dvfsp-resource-owner {
+        compatible = "mediatek,mt6797-dvfsp-resource-owner";
+        mediatek,clock-backend = <&dvfsp_clock_backend>;
+        mediatek,bigidvfs-backend = <&dvfsp_bigidvfs_backend>;
+        mediatek,thermal = <&thermal>;
+        mediatek,calibration-source = <&dvfsp_handoff>;
+        status = "disabled";
+      };
+    };
diff --git a/arch/arm64/boot/dts/mediatek/mt6797.dtsi b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
--- a/arch/arm64/boot/dts/mediatek/mt6797.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
@@ -690,7 +690,16 @@
 	dvfsp_bigidvfs_backend: dvfsp-bigidvfs-backend {
 		compatible = "mediatek,mt6797-bigidvfs-backend";
 		method = "smc";
 		status = "disabled";
 	};
+
+	dvfsp_resource_owner: dvfsp-resource-owner {
+		compatible = "mediatek,mt6797-dvfsp-resource-owner";
+		mediatek,clock-backend = <&dvfsp_clock_backend>;
+		mediatek,bigidvfs-backend = <&dvfsp_bigidvfs_backend>;
+		mediatek,thermal = <&thermal>;
+		mediatek,calibration-source = <&dvfsp_handoff>;
+		status = "disabled";
+	};
 
 	i2c7: i2c@11010000 {
 		compatible = "mediatek,mt6797-i2c",
 			     "mediatek,mt6577-i2c";
diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -85,6 +85,18 @@ config MTK_MT6797_DVFSP_HANDOFF
 
 	  This option is for bounded Gemini PDA bring-up experiments only.
 
+config MTK_MT6797_DVFSP_RESOURCE_OWNER
+	bool "MediaTek MT6797 DVFSP resource-only owner"
+	depends on ARM64 && ARCH_MEDIATEK && OF
+	depends on MTK_MT6797_DVFSP_HANDOFF
+	help
+	  Bind only the MT6797 DVFSP resource-lifetime owner. The provider
+	  resolves four Device Tree resources, retains their device references,
+	  and exposes no readback, hardware operation, firmware call, secure
+	  service, clock or regulator operation, state-owner registration, or
+	  CPU admission. Keep its Device Tree node disabled until a calibrated
+	  provider contract exists.
+
 config MTK_MT6797_DVFSP_CLOCK_BACKEND
 	bool "MediaTek MT6797 protected CPU clock readback transport"
 	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -6,6 +6,7 @@ obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-ptp.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-source.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-arbitration.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-resource-owner.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_RESOURCE_OWNER) += mt6797-dvfsp-resource-provider.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-snapshot.o
