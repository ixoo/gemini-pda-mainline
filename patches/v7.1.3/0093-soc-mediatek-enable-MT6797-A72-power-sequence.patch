+	ret = mt6797_a72_power_preflight(power, cpu, first_prepare);
+	if (ret) {
+		if (first_prepare) {
+			spin_lock_irqsave(&power->state_lock, flags);
+			power->sequence_in_progress = false;
+			spin_unlock_irqrestore(&power->state_lock, flags);
+		}
+		goto unlock_sequence;
+	}
+
+	if (first_prepare)
+		ret = mt6797_a72_power_prepare_first(power, cpu);
+	else
+		ret = 0;
+	goto unlock_sequence;
+
+unlock_state:
+	spin_unlock_irqrestore(&power->state_lock, flags);
+unlock_sequence:
+	mutex_unlock(&power->sequence_lock);
+	return ret;
+}
+
+static int mt6797_a72_power_cpu_teardown(unsigned int cpu)
+{
+	struct mt6797_a72_power *power;
+	int affinity;
+
+	power = mt6797_a72_power_get();
+	if (!power || !cpumask_test_cpu(cpu, &power->cpu_mask))
+		return 0;
