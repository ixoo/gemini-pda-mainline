+	value = readl(power->mcucfg + MCUCFG_MP2_SYNC_DCM);
+	value &= ~MP2_SYNC_DCM_MASK;
+	value |= MP2_SYNC_DCM_ON | MP2_SYNC_DCM_DIV4;
+	writel(value | MP2_SYNC_DCM_TOGGLE,
+	       power->mcucfg + MCUCFG_MP2_SYNC_DCM);
+	readl(power->mcucfg + MCUCFG_MP2_SYNC_DCM);
+	writel(value, power->mcucfg + MCUCFG_MP2_SYNC_DCM);
+	power->mp2_sync_dcm = readl(power->mcucfg + MCUCFG_MP2_SYNC_DCM);
+
+	spin_lock_irqsave(&power->state_lock, flags);
+	power->psci_inflight = false;
+	spin_unlock_irqrestore(&power->state_lock, flags);
+}
+
+void mt6797_a72_power_cpu_on_failed(unsigned int cpu, int psci_ret)
+{
+	struct mt6797_a72_power *power;
+	int affinity;
+
+	power = mt6797_a72_power_get();
+	if (!power || !cpumask_test_cpu(cpu, &power->cpu_mask))
+		return;
+
+	affinity = mt6797_a72_power_affinity_info(cpu);
+	dev_err(power->dev,
+		"CPU%u PSCI CPU_ON failed: %d (affinity=%d)\n",
+		cpu, psci_ret, affinity);
+	mt6797_a72_set_fault(power, cpu, affinity, "PSCI CPU_ON failure");
+}
