+	 * There is no audited inverse sequence, so retain power and reject retry.
+	 */
+	affinity = mt6797_a72_power_affinity_info(cpu);
+	mt6797_a72_set_fault(power, cpu, affinity, "CPUHP teardown after A72 prepare");
+	return 0;
+}
+
+int mt6797_a72_power_cpu_boot_ready(unsigned int cpu)
+{
+	struct mt6797_a72_power *power;
+	unsigned long flags;
+	int ret = 0;
+
+	power = mt6797_a72_power_get();
+	if (!power || !cpumask_test_cpu(cpu, &power->cpu_mask))
+		return -EAGAIN;
+
+	/*
+	 * Take a second live snapshot of the retained AF watchdog fd as close as
+	 * possible to generic PSCI CPU_ON.
+	 */
+	if (!mtk_wdt_is_userspace_armed(power->watchdog_np))
+		return -EACCES;
+
+	spin_lock_irqsave(&power->state_lock, flags);
+	if (!power->hooks_armed || !power->integration_ready ||
+	    !power->prepared || power->faulted || power->sequence_in_progress ||
+	    power->psci_inflight) {
+		ret = -EIO;
+	} else {
+		power->psci_inflight = true;
+	}
+	spin_unlock_irqrestore(&power->state_lock, flags);
+
+	return ret;
+}
+
+void mt6797_a72_power_cpu_on_complete(unsigned int cpu)
+{
+	struct mt6797_a72_power *power;
+	unsigned long flags;
+	u32 value;
+
+	power = mt6797_a72_power_get();
+	if (WARN_ON_ONCE(!power || !cpumask_test_cpu(cpu, &power->cpu_mask)))
+		return;
