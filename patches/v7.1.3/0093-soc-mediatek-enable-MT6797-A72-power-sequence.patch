+	mutex_lock(&power->sequence_lock);
+	spin_lock_irqsave(&power->state_lock, flags);
+	if (!power->hooks_armed || !power->integration_ready || power->faulted) {
+		ret = -EIO;
+		goto unlock_state;
+	}
+	if (power->sequence_in_progress) {
+		ret = -EBUSY;
+		goto unlock_state;
+	}
+	first_prepare = !power->prepared;
+	if (first_prepare)
+		power->sequence_in_progress = true;
+	spin_unlock_irqrestore(&power->state_lock, flags);
