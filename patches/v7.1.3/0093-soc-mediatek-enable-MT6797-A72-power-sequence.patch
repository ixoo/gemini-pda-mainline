+static void mt6797_a72_power_put_node(void *data)
+{
+	of_node_put(data);
+}
+
+static int mt6797_a72_power_parse_watchdog(struct device *dev,
+					   struct mt6797_a72_power *power)
+{
+	struct of_phandle_args spec;
+	int ret;
+
+	ret = of_parse_phandle_with_args(dev->of_node, "resets", "#reset-cells", 0, &spec);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to parse PWRAP reset specifier\n");
+
+	if (spec.args_count != 1 ||
+	    spec.args[0] != MT6797_TOPRGU_PWRAP_SPI_CTL_RST) {
+		of_node_put(spec.np);
+		return dev_err_probe(dev, -EINVAL,
+				     "unexpected PWRAP reset specifier\n");
+	}
+
+	power->watchdog_np = spec.np;
+	return devm_add_action_or_reset(dev, mt6797_a72_power_put_node,
+					power->watchdog_np);
+}
+
 static int mt6797_a72_power_parse_cpus(struct device *dev,
-					  struct mt6797_a72_power *power)
+				       struct mt6797_a72_power *power)
 {
 	struct device_node *cpu_node;
+	const char *enable_method;
 	int count;
 	int cpu;
+	int ret;
 	int i;
 
 	count = of_count_phandle_with_args(dev->of_node, "cpus", NULL);
@@ -154,6 +256,19 @@ static int mt6797_a72_power_parse_cpus(struct device *dev,
 		if (!cpu_node)
 			return dev_err_probe(dev, -EINVAL,
 					     "failed to parse CPU phandle %d\n", i);
+		if (!of_device_is_compatible(cpu_node, "arm,cortex-a72")) {
+			of_node_put(cpu_node);
+			return dev_err_probe(dev, -EINVAL,
+					     "CPU phandle %d is not Cortex-A72\n", i);
+		}
+		ret = of_property_read_string(cpu_node, "enable-method",
+					      &enable_method);
+		if (ret || strcmp(enable_method, "mediatek,mt6797-psci")) {
+			of_node_put(cpu_node);
+			return dev_err_probe(dev, -EINVAL,
+					     "CPU phandle %d has unsafe enable-method\n",
+					     i);
+		}
 		cpu = of_cpu_node_to_id(cpu_node);
 		of_node_put(cpu_node);
 		if (cpu < 0 || cpu >= nr_cpu_ids)
@@ -168,20 +283,374 @@ static int mt6797_a72_power_parse_cpus(struct device *dev,
 	return 0;
 }
 
+static void mt6797_a72_set_fault(struct mt6797_a72_power *power,
+				 unsigned int cpu, int affinity,
+				 const char *reason)
+{
+	unsigned long flags;
+	bool first;
+
+	spin_lock_irqsave(&power->state_lock, flags);
+	first = !power->faulted;
+	power->faulted = true;
+	power->sequence_in_progress = false;
+	power->psci_inflight = false;
+	spin_unlock_irqrestore(&power->state_lock, flags);
+
+	if (first)
+		dev_err(power->dev,
+			"CPU%u provider faulted: %s (PSCI affinity=%d); retry denied\n",
+			cpu, reason, affinity);
+}
+
+static int mt6797_a72_power_affinity_info(unsigned int cpu)
+{
+	if (!psci_ops.affinity_info)
+		return -EOPNOTSUPP;
+
+	return psci_ops.affinity_info(cpu_logical_map(cpu), 0);
+}
+
+static int mt6797_a72_power_preflight(struct mt6797_a72_power *power,
+				      unsigned int cpu, bool first_prepare)
+{
+	unsigned int member;
+	int enabled;
+	int uv;
+
+	if (!cpu_possible(1) || !cpu_online(1)) {
+		dev_err(power->dev, "CPU%u rejected: CPU1 is not online\n", cpu);
+		return -EPERM;
+	}
+
+	if (cpu_online(cpu))
+		return -EBUSY;
+
+	if (first_prepare) {
+		for_each_cpu(member, &power->cpu_mask) {
+			if (cpu_online(member)) {
+				dev_err(power->dev,
+					"CPU%u rejected: first prepare with CPU%u online\n",
+					cpu, member);
+				return -EBUSY;
+			}
+		}
+	}
+
+	enabled = regulator_is_enabled(power->vproc_big);
+	if (enabled < 0)
+		return enabled;
+
+	uv = regulator_get_voltage(power->vproc_big);
+	if (uv < 0)
+		return uv;
+	if (uv != MT6797_A72_VPROC_UV) {
+		dev_err(power->dev,
+			"CPU%u rejected: Vproc is %duV, expected %duV\n",
+			cpu, uv, MT6797_A72_VPROC_UV);
+		return -ERANGE;
+	}
+
+	power->vproc_enabled = enabled;
+	power->vproc_uv = uv;
+
+	/*
+	 * This is a live snapshot, not an fd pin.  AF retains its watchdog fd
+	 * across the CPU request, making the snapshot stable for this experiment.
+	 * Keep this as the final check immediately before the first write.
+	 */
+	if (!mtk_wdt_is_userspace_armed(power->watchdog_np)) {
+		dev_err(power->dev,
+			"CPU%u rejected: userspace-owned watchdog is not armed\n",
+			cpu);
+		return -EACCES;
+	}
+
+	return 0;
+}
+
+static int mt6797_a72_power_prepare_first(struct mt6797_a72_power *power,
+					  unsigned int cpu)
+{
+	struct arm_smccc_res smc_res;
+	bool regulator_enabled = false;
+	bool reset_asserted = false;
+	bool isolation_attempted = false;
+	s32 smc_ret;
+	u32 value;
+	int cleanup_ret;
+	int ret;
+
+	ret = regmap_update_bits(power->spm, SPM_CA7_CPU1_PWR_CON,
+				 SPM_CA7_CPU1_PWR_RST_B,
+				 SPM_CA7_CPU1_PWR_RST_B);
+	if (ret)
+		goto fail;
+	ret = regmap_read(power->spm, SPM_CA7_CPU1_PWR_CON, &value);
+	if (ret)
+		goto fail;
+	power->spm_poweron_config = value;
+	if (!(value & SPM_CA7_CPU1_PWR_RST_B)) {
+		ret = -EIO;
+		goto fail;
+	}
+
+	/* The working downstream sequence requires this ordering-only read. */
+	power->big_armpll_con0 =
+		readl(power->mcucfg + MCUCFG_BIG_ARMPLL_CON0);
+
+	reset_asserted = true;
+	ret = reset_control_assert(power->pwrap_reset);
+	if (ret)
+		goto fail;
+
+	ret = regulator_enable(power->vproc_big);
+	if (ret)
+		goto fail;
+	regulator_enabled = true;
+	usleep_range(1000, 1100);
+
+	/* A failure from this point leaves the shared rail and SPM state on. */
+	isolation_attempted = true;
+	ret = regmap_update_bits(power->spm, SPM_MCU_PWR_CON,
+				 SPM_EXT_BUCK_ISO_MASK, 0);
+	if (ret)
+		goto fail;
+	ret = regmap_read(power->spm, SPM_MCU_PWR_CON, &value);
+	if (ret)
+		goto fail;
+	power->spm_ext_buck_iso = value;
+	if (value & SPM_EXT_BUCK_ISO_MASK) {
+		ret = -EIO;
+		goto fail;
+	}
+
+	ret = reset_control_deassert(power->pwrap_reset);
+	if (ret)
+		goto fail;
+	reset_asserted = false;
+	usleep_range(240, 260);
+
+	arm_smccc_smc(MT6797_SIP_SRAM_LDO_SET, MT6797_A72_SRAM_LDO_ARG,
+		      0, 0, 0, 0, 0, 0, &smc_res);
+	smc_ret = (s32)smc_res.a0;
+	if (smc_ret < 0) {
+		ret = smc_ret;
+		goto fail;
+	}
+	usleep_range(240, 260);
+
+	spin_lock_irq(&power->state_lock);
+	power->prepared = true;
+	power->sequence_in_progress = false;
+	spin_unlock_irq(&power->state_lock);
+
+	dev_info(power->dev,
+		 "CPU%u fixed-state A72 power sequence prepared\n", cpu);
+	return 0;
+
+fail:
+	cleanup_ret = 0;
+	if (reset_asserted) {
+		cleanup_ret = reset_control_deassert(power->pwrap_reset);
+		if (cleanup_ret)
+			dev_err(power->dev,
+				"failed to deassert PWRAP reset during cleanup: %d\n",
+				cleanup_ret);
+	}
+
+	if (!isolation_attempted && regulator_enabled) {
+		int disable_ret = regulator_disable(power->vproc_big);
+
+		if (disable_ret) {
+			dev_err(power->dev,
+				"failed to balance Vproc enable during cleanup: %d\n",
+				disable_ret);
+			cleanup_ret = disable_ret;
+		}
+	}
+
+	if (isolation_attempted || cleanup_ret) {
+		const char *reason = "power sequence crossed safe rollback boundary";
+
+		mt6797_a72_set_fault(power, cpu, -EINPROGRESS, reason);
+	} else {
+		spin_lock_irq(&power->state_lock);
+		power->sequence_in_progress = false;
+		spin_unlock_irq(&power->state_lock);
+	}
