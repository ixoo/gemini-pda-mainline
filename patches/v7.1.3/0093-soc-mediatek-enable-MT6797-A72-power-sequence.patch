 drivers/soc/mediatek/Kconfig                  |  21 +-
 drivers/soc/mediatek/mt6797-a72-power.c       | 549 +++++++++++++++++-
 drivers/watchdog/mtk_wdt.c                    |  44 ++
 drivers/watchdog/watchdog_core.h              |   8 +
 include/linux/soc/mediatek/mt6797-a72-power.h |  27 +
 include/linux/soc/mediatek/mtk-wdt.h          |  23 +
 7 files changed, 656 insertions(+), 41 deletions(-)
 create mode 100644 include/linux/soc/mediatek/mt6797-a72-power.h
 create mode 100644 include/linux/soc/mediatek/mtk-wdt.h

diff --git a/arch/arm64/kernel/mt6797_psci.c b/arch/arm64/kernel/mt6797_psci.c
index 6a4e999..6a25a14 100644
--- a/arch/arm64/kernel/mt6797_psci.c
+++ b/arch/arm64/kernel/mt6797_psci.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Observer-stage PSCI gate for the MT6797 Cortex-A72 cluster
+ * Sequenced PSCI operations for the MT6797 Cortex-A72 cluster
  *
  * Copyright (c) 2026 Julien Etienne
  */
@@ -8,6 +8,7 @@
 #define pr_fmt(fmt) "mt6797-psci: " fmt
 
 #include <linux/errno.h>
+#include <linux/soc/mediatek/mt6797-a72-power.h>
 #include <linux/printk.h>
 
 #include <asm/cpu_ops.h>
@@ -26,16 +27,30 @@ static int __init mt6797_psci_cpu_prepare(unsigned int cpu)
 
 static int mt6797_psci_cpu_boot(unsigned int cpu)
 {
-	pr_warn_ratelimited("CPU%u boot rejected: A72 power sequence inactive\n",
-			    cpu);
+	int ret;
+
+	ret = mt6797_a72_power_cpu_boot_ready(cpu);
+	if (ret) {
+		pr_warn_ratelimited("CPU%u boot rejected by A72 power provider: %d\n",
+				    cpu, ret);
+		return ret;
+	}
+
+	ret = cpu_psci_ops.cpu_boot(cpu);
+	if (ret) {
+		mt6797_a72_power_cpu_on_failed(cpu, ret);
+		return ret;
+	}
 
-	return -EAGAIN;
+	/* The audited hardware sequence requires DCM immediately after CPU_ON. */
+	mt6797_a72_power_cpu_on_complete(cpu);
+	return 0;
 }
 
 #ifdef CONFIG_HOTPLUG_CPU
 static bool mt6797_psci_cpu_can_disable(unsigned int cpu)
 {
-	return cpu_psci_ops.cpu_can_disable(cpu);
+	return false;
 }
 
 static int mt6797_psci_cpu_disable(unsigned int cpu)
diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index b35689d..c79cf26 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -46,19 +46,22 @@ config MTK_INFRACFG
 	  directly associated to any device.
 
 config MTK_MT6797_A72_POWER
-	bool "MediaTek MT6797 Cortex-A72 power resource observer"
-	depends on ARM64 && ARCH_MEDIATEK && OF
+	bool "MediaTek MT6797 Cortex-A72 fixed-state power sequencing"
+	depends on ARM64 && ARCH_MEDIATEK && OF && SMP && HOTPLUG_CPU
+	depends on ARM_PSCI_FW
 	depends on REGULATOR && RESET_CONTROLLER
+	depends on MEDIATEK_WATCHDOG=y
 	select MFD_SYSCON
 	help
-	  Build the resource observer for the MT6797 Cortex-A72 cluster power
-	  path.  It verifies that the external processor regulator, TOPRGU
-	  reset, SPM syscon, and MCUCFG resources are available and publishes
-	  a read-only snapshot in sysfs.
+	  Reproduce the fixed-voltage power-on sequence required before PSCI can
+	  start either Cortex-A72 on MT6797.  The provider coordinates the
+	  external processor regulator, TOPRGU PWRAP reset, SPM isolation,
+	  secure firmware SRAM voltage service, and the MP2 DCM register.
 
-	  This initial implementation never changes power state and never
-	  authorizes CPU_ON.  It is groundwork for a later provider that can
-	  reproduce the hardware power sequence.
+	  This is deliberately not a DVFS implementation.  It holds Vproc at
+	  1.0V and asks secure firmware for the audited fixed SRAM setting.  A
+	  live snapshot of a userspace-open, active hardware watchdog is a
+	  mandatory precondition for the experimental CPU-start request.
 
 config MTK_PMIC_WRAP
 	tristate "MediaTek PMIC Wrapper Support"
