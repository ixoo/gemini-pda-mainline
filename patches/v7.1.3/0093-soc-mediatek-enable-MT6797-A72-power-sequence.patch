+bool mtk_wdt_is_userspace_armed(struct device_node *np)
+{
+	struct platform_device *pdev;
+	struct mtk_wdt_dev *mtk_wdt;
+	bool armed = false;
+
+	pdev = of_find_device_by_node(np);
+	if (!pdev)
+		return false;
+
+	/*
+	 * This lock stabilizes driver data against unbind.  It does not pin
+	 * watchdog character-device ownership; callers receive a live snapshot.
+	 */
+	device_lock(&pdev->dev);
+	if (pdev->dev.driver != &mtk_wdt_driver.driver)
+		goto unlock;
+
+	mtk_wdt = platform_get_drvdata(pdev);
+	if (!mtk_wdt)
+		goto unlock;
+
+	armed = watchdog_dev_open(&mtk_wdt->wdt_dev) &&
+		watchdog_active(&mtk_wdt->wdt_dev) &&
+		watchdog_hw_running(&mtk_wdt->wdt_dev) &&
+		(readl(mtk_wdt->wdt_base + WDT_MODE) & WDT_MODE_EN);
+
+	/* Narrow the close race window without claiming to pin the owner. */
+	armed = armed && watchdog_dev_open(&mtk_wdt->wdt_dev) &&
+		 watchdog_active(&mtk_wdt->wdt_dev) &&
+		 watchdog_hw_running(&mtk_wdt->wdt_dev);
+unlock:
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+	return armed;
+}
+EXPORT_SYMBOL_GPL(mtk_wdt_is_userspace_armed);
