@@ -119,12 +191,12 @@ static int mt6797_a72_power_snapshot(struct mt6797_a72_power *power)
 	if (power->vproc_uv < 0)
 		return power->vproc_uv;
 
-	ret = regmap_read(power->spm, SPM_POWERON_CONFIG_EN,
+	ret = regmap_read(power->spm, SPM_CA7_CPU1_PWR_CON,
 			  &power->spm_poweron_config);
 	if (ret)
 		return ret;
 
-	ret = regmap_read(power->spm, SPM_EXT_BUCK_ISO,
+	ret = regmap_read(power->spm, SPM_MCU_PWR_CON,
 			  &power->spm_ext_buck_iso);
 	if (ret)
 		return ret;
@@ -135,12 +207,42 @@ static int mt6797_a72_power_snapshot(struct mt6797_a72_power *power)
