From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Wed, 7 Oct 2026 19:00:00 +0000
Subject: [PATCH] pinctrl: mediatek: eint: add a read-only register snapshot

The Gemini lid on GPIO66 follows the magnet while EINT5 never fires, and
MT6797 kernels have no /dev/mem to inspect the controller. Behind a
default-off experiment option, add one root-only debugfs file that reads
the status, mask, sensitivity, polarity, soft and domain registers of
EINT ports 0 and 5, and the EINT4-7 debounce word: 13 reads per read of
the file. It writes nothing and never touches an acknowledge, set or
clear register. Status is acknowledged through its own register, so
reading it does not clear it.

Unsigned experiment draft; archive identity is non-certifying.
---
 drivers/pinctrl/mediatek/Kconfig    | 12 +++++++++
 drivers/pinctrl/mediatek/mtk-eint.c | 39 +++++++++++++++++++++++++++++
 2 files changed, 51 insertions(+)

diff --git a/drivers/pinctrl/mediatek/Kconfig b/drivers/pinctrl/mediatek/Kconfig
index 4819617d9..ea0c3203a 100644
--- a/drivers/pinctrl/mediatek/Kconfig
+++ b/drivers/pinctrl/mediatek/Kconfig
@@ -10,6 +10,18 @@ config EINT_MTK
 	default y if PINCTRL_MTK || PINCTRL_MTK_MOORE
 	default PINCTRL_MTK_PARIS
 
+config EINT_MTK_SNAPSHOT
+	bool "Read-only EINT register snapshot in debugfs (experiment)"
+	depends on EINT_MTK && DEBUG_FS
+	help
+	  Experiment-only diagnostic for the MT6797 Gemini lid. Adds a root-only
+	  debugfs file that reads the status, mask, sensitivity, polarity, soft
+	  and domain registers of EINT ports 0 and 5, and the debounce word for
+	  EINT4-7, once per read. It writes nothing and touches no acknowledge,
+	  set or clear register.
+
+	  If unsure, say N.
+
 config PINCTRL_MTK
 	bool
 	depends on OF
diff --git a/drivers/pinctrl/mediatek/mtk-eint.c b/drivers/pinctrl/mediatek/mtk-eint.c
index 2a3c04eed..f0e7c7112 100644
--- a/drivers/pinctrl/mediatek/mtk-eint.c
+++ b/drivers/pinctrl/mediatek/mtk-eint.c
@@ -11,6 +11,7 @@
  *
  */
 
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/gpio/driver.h>
@@ -20,6 +21,7 @@
 #include <linux/module.h>
 #include <linux/of_irq.h>
 #include <linux/platform_device.h>
+#include <linux/seq_file.h>
 
 #include "mtk-eint.h"
 
@@ -509,6 +511,42 @@ int mtk_eint_find_irq(struct mtk_eint *eint, unsigned long eint_n)
 }
 EXPORT_SYMBOL_GPL(mtk_eint_find_irq);
 
+#ifdef CONFIG_EINT_MTK_SNAPSHOT
+/*
+ * Fixed read-only snapshot of EINT ports 0 and 5 and the EINT4-7 debounce
+ * word: 13 readl per read of the file, no write, no ACK/SET/CLR register.
+ */
+static int mtk_eint_snapshot_show(struct seq_file *m, void *unused)
+{
+	const struct mtk_eint *eint = m->private;
+	const struct mtk_eint_regs *r = eint->regs;
+	void __iomem *base = eint->base[0];
+	static const unsigned int ports[] = { 0, 5 };
+	unsigned int i, off;
+
+	for (i = 0; i < ARRAY_SIZE(ports); i++) {
+		off = ports[i] * 4;
+		seq_printf(m, "port%u stat=%08x mask=%08x sens=%08x pol=%08x soft=%08x dom=%08x\n",
+			   ports[i], readl(base + r->stat + off),
+			   readl(base + r->mask + off), readl(base + r->sens + off),
+			   readl(base + r->pol + off), readl(base + r->soft + off),
+			   readl(base + r->dom_en + off));
+	}
+	seq_printf(m, "dbnc_ctrl_eint4_7=%08x\n", readl(base + r->dbnc_ctrl + 4));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_eint_snapshot);
+
+static void mtk_eint_snapshot_init(struct mtk_eint *eint)
+{
+	if (eint->nbase == 1 && eint->hw->ap_num >= 192)
+		debugfs_create_file("mtk-eint-snapshot", 0400, NULL, eint,
+				    &mtk_eint_snapshot_fops);
+}
+#else
+static inline void mtk_eint_snapshot_init(struct mtk_eint *eint) {}
+#endif
+
 int mtk_eint_do_init(struct mtk_eint *eint, struct mtk_eint_pin *eint_pin)
 {
 	unsigned int size, i, port, virq, inst = 0;
@@ -600,6 +638,7 @@ int mtk_eint_do_init(struct mtk_eint *eint, struct mtk_eint_pin *eint_pin)
 
 	irq_set_chained_handler_and_data(eint->irq, mtk_eint_irq_handler,
 					 eint);
+	mtk_eint_snapshot_init(eint);
 
 	return 0;
 
