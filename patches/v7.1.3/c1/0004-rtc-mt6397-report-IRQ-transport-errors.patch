From 98df7b1371e434b3c6dd1486bc8ba889ad7d175a Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sun, 4 Oct 2026 13:48:12 -0400
Subject: [PATCH] rtc: mt6397: report IRQ transport failures

Report failed status reads, alarm-enable updates and write triggers
from the alarm handler. Preserve event delivery, IRQ return values,
alarm-only mask changes and transaction counts; do not retry a failed
operation or claim physical recovery. The trigger helper retains its
existing busy-poll error diagnostic.

Unsigned experiment draft; archive identity is non-certifying.
---
 drivers/rtc/rtc-mt6397.c | 30 ++++++++++++++++++++----------
 1 file changed, 20 insertions(+), 10 deletions(-)

diff --git a/drivers/rtc/rtc-mt6397.c b/drivers/rtc/rtc-mt6397.c
index d1f2f18..7747e36 100644
--- a/drivers/rtc/rtc-mt6397.c
+++ b/drivers/rtc/rtc-mt6397.c
@@ -40,22 +40,32 @@ static int mtk_rtc_write_trigger(struct mt6397_rtc *rtc)
 static irqreturn_t mtk_rtc_irq_handler_thread(int irq, void *data)
 {
 	struct mt6397_rtc *rtc = data;
+	struct device *dev = rtc->rtc_dev->dev.parent;
 	u32 irqsta;
 	int ret;
 
 	ret = regmap_read(rtc->regmap, rtc->addr_base + RTC_IRQ_STA, &irqsta);
-	if ((ret >= 0) && (irqsta & RTC_IRQ_STA_AL)) {
-		rtc_update_irq(rtc->rtc_dev, 1, RTC_IRQF | RTC_AF);
-		mutex_lock(&rtc->lock);
-		if (regmap_update_bits(rtc->regmap, rtc->addr_base + RTC_IRQ_EN,
-				       RTC_IRQ_EN_AL, 0) == 0)
-			mtk_rtc_write_trigger(rtc);
-		mutex_unlock(&rtc->lock);
-
-		return IRQ_HANDLED;
+	if (ret < 0) {
+		dev_err_ratelimited(dev, "Failed to read IRQ status: %d\n", ret);
+		return IRQ_NONE;
 	}
+	if (!(irqsta & RTC_IRQ_STA_AL))
+		return IRQ_NONE;
 
-	return IRQ_NONE;
+	rtc_update_irq(rtc->rtc_dev, 1, RTC_IRQF | RTC_AF);
+	mutex_lock(&rtc->lock);
+	ret = regmap_update_bits(rtc->regmap, rtc->addr_base + RTC_IRQ_EN,
+				 RTC_IRQ_EN_AL, 0);
+	if (ret < 0) {
+		dev_err_ratelimited(dev, "Failed to disable alarm IRQ: %d\n", ret);
+	} else {
+		ret = mtk_rtc_write_trigger(rtc);
+		if (ret < 0)
+			dev_err_ratelimited(dev, "Failed to latch alarm disable: %d\n", ret);
+	}
+	mutex_unlock(&rtc->lock);
+
+	return IRQ_HANDLED;
 }
 
 static int __mtk_rtc_read_time(struct mt6397_rtc *rtc,
