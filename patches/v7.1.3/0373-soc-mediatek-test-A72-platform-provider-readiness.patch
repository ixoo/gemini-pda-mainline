From 1a59241f9cf9c7d4f88212694772257df2ea5c5b Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 25 Aug 2026 19:03:00 +0000
Subject: [PATCH 3/3] soc: mediatek: test A72 platform/provider readiness

Prove a missing provider defers with zero platform, checkpoint, and provider calls while preserving the exact ready success sequence.
---
 ...platform-provider-snapshot-observer-test.c | 46 ++++++++++++++++---
 1 file changed, 39 insertions(+), 7 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-test.c b/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-test.c
index 25db710..4c96974 100644
--- a/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-test.c
+++ b/drivers/soc/mediatek/mt6797-a72-platform-provider-snapshot-observer-test.c
@@ -88,15 +88,35 @@ mt6797_platform_provider_success_state(void)
 	};
 }
 
+static void mt6797_platform_provider_not_ready_test(struct kunit *test)
+{
+	struct mt6797_a72_platform_provider_test_state state =
+		mt6797_platform_provider_success_state();
+	struct mt6797_a72_platform_provider_snapshot snapshot;
+	struct device platform = { };
+	int ret;
+
+	memset(&snapshot, 0xff, sizeof(snapshot));
+	ret = mt6797_a72_pp_capture(&platform, NULL, &test_ops, &state,
+				    &snapshot);
+	KUNIT_EXPECT_EQ(test, ret, -EPROBE_DEFER);
+	KUNIT_EXPECT_EQ(test, state.platform_calls, 0U);
+	KUNIT_EXPECT_EQ(test, state.provider_calls, 0U);
+	KUNIT_EXPECT_EQ(test, state.event_count, 0U);
+	mt6797_pp_expect_zero(test, &snapshot);
+}
+
 static void mt6797_platform_provider_success_test(struct kunit *test)
 {
 	struct mt6797_a72_platform_provider_test_state state =
 		mt6797_platform_provider_success_state();
 	struct mt6797_a72_platform_provider_snapshot snapshot;
 	struct device platform = { };
+	struct device provider = { };
 	int ret;
 
-	ret = mt6797_a72_pp_capture(&platform, &test_ops, &state, &snapshot);
+	ret = mt6797_a72_pp_capture(&platform, &provider, &test_ops, &state,
+				    &snapshot);
 	KUNIT_EXPECT_EQ(test, ret, 0);
 	KUNIT_EXPECT_TRUE(test, snapshot.valid);
 	KUNIT_EXPECT_TRUE(test, snapshot.platform.valid);
@@ -121,10 +141,12 @@ static void mt6797_platform_provider_platform_error_test(struct kunit *test)
 		mt6797_platform_provider_success_state();
 	struct mt6797_a72_platform_provider_snapshot snapshot;
 	struct device platform = { };
+	struct device provider = { };
 	int ret;
 
 	state.platform_ret = -EAGAIN;
-	ret = mt6797_a72_pp_capture(&platform, &test_ops, &state, &snapshot);
+	ret = mt6797_a72_pp_capture(&platform, &provider, &test_ops, &state,
+				    &snapshot);
 	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
 	KUNIT_EXPECT_EQ(test, state.platform_calls, 1U);
 	KUNIT_EXPECT_EQ(test, state.provider_calls, 0U);
@@ -138,10 +160,12 @@ static void mt6797_platform_provider_platform_invalid_test(struct kunit *test)
 		mt6797_platform_provider_success_state();
 	struct mt6797_a72_platform_provider_snapshot snapshot;
 	struct device platform = { };
+	struct device provider = { };
 	int ret;
 
 	state.platform_valid = false;
-	ret = mt6797_a72_pp_capture(&platform, &test_ops, &state, &snapshot);
+	ret = mt6797_a72_pp_capture(&platform, &provider, &test_ops, &state,
+				    &snapshot);
 	KUNIT_EXPECT_EQ(test, ret, -ENODATA);
 	KUNIT_EXPECT_EQ(test, state.provider_calls, 0U);
 	KUNIT_EXPECT_EQ(test, state.event_count, 1U);
@@ -154,10 +178,12 @@ static void mt6797_platform_provider_before_failure_test(struct kunit *test)
 		mt6797_platform_provider_success_state();
 	struct mt6797_a72_platform_provider_snapshot snapshot;
 	struct device platform = { };
+	struct device provider = { };
 	int ret;
 
 	state.checkpoint_result[0] = false;
-	ret = mt6797_a72_pp_capture(&platform, &test_ops, &state, &snapshot);
+	ret = mt6797_a72_pp_capture(&platform, &provider, &test_ops, &state,
+				    &snapshot);
 	KUNIT_EXPECT_EQ(test, ret, -EIO);
 	KUNIT_EXPECT_EQ(test, state.provider_calls, 0U);
 	KUNIT_ASSERT_EQ(test, state.event_count, 2U);
@@ -171,10 +197,12 @@ static void mt6797_platform_provider_provider_failure_test(struct kunit *test)
 		mt6797_platform_provider_success_state();
 	struct mt6797_a72_platform_provider_snapshot snapshot;
 	struct device platform = { };
+	struct device provider = { };
 	int ret;
 
 	state.provider_ret = -EIO;
-	ret = mt6797_a72_pp_capture(&platform, &test_ops, &state, &snapshot);
+	ret = mt6797_a72_pp_capture(&platform, &provider, &test_ops, &state,
+				    &snapshot);
 	KUNIT_EXPECT_EQ(test, ret, -EIO);
 	KUNIT_EXPECT_EQ(test, state.provider_calls, 1U);
 	KUNIT_EXPECT_EQ(test, state.event_count, 3U);
@@ -182,7 +210,8 @@ static void mt6797_platform_provider_provider_failure_test(struct kunit *test)
 
 	state = mt6797_platform_provider_success_state();
 	state.provider_valid = false;
-	ret = mt6797_a72_pp_capture(&platform, &test_ops, &state, &snapshot);
+	ret = mt6797_a72_pp_capture(&platform, &provider, &test_ops, &state,
+				    &snapshot);
 	KUNIT_EXPECT_EQ(test, ret, -ENODATA);
 	KUNIT_EXPECT_EQ(test, state.provider_calls, 1U);
 	mt6797_pp_expect_zero(test, &snapshot);
@@ -194,10 +223,12 @@ static void mt6797_platform_provider_after_failure_test(struct kunit *test)
 		mt6797_platform_provider_success_state();
 	struct mt6797_a72_platform_provider_snapshot snapshot;
 	struct device platform = { };
+	struct device provider = { };
 	int ret;
 
 	state.checkpoint_result[1] = false;
-	ret = mt6797_a72_pp_capture(&platform, &test_ops, &state, &snapshot);
+	ret = mt6797_a72_pp_capture(&platform, &provider, &test_ops, &state,
+				    &snapshot);
 	KUNIT_EXPECT_EQ(test, ret, -EIO);
 	KUNIT_EXPECT_EQ(test, state.provider_calls, 1U);
 	KUNIT_EXPECT_EQ(test, state.event_count, 4U);
@@ -205,6 +236,7 @@ static void mt6797_platform_provider_after_failure_test(struct kunit *test)
 }
 
 static struct kunit_case mt6797_a72_platform_provider_cases[] = {
+	KUNIT_CASE(mt6797_platform_provider_not_ready_test),
 	KUNIT_CASE(mt6797_platform_provider_success_test),
 	KUNIT_CASE(mt6797_platform_provider_platform_error_test),
 	KUNIT_CASE(mt6797_platform_provider_platform_invalid_test),
