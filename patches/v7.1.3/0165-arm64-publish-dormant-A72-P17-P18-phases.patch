From 07b50996f5a6ecc2e7b4423c5ae89ae30bfde6e1 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 5 Aug 2026 19:51:13 -0400
Subject: [PATCH] arm64: publish dormant A72 P17 P18 phases

Bind frozen CPU8 and CPU9 transactions to pre-effect publication.

Require provider NONE for P17 and the durable M01 identity for P18.

This experiment-only ledger has no provider call, CPUHP effect, or CPU_ON.

Build, device, and submission remain absent.
---
 .../arm64/include/asm/mt6797_a72_membership.h | 23 +++--
 arch/arm64/kernel/mt6797_a72_membership.c     | 89 ++++++++++++++++++-
 .../arm64/kernel/mt6797_a72_membership_test.c | 89 ++++++++++++++++++-
 3 files changed, 192 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/include/asm/mt6797_a72_membership.h b/arch/arm64/include/asm/mt6797_a72_membership.h
index 5571ed8b9..8e7cb87f8 100644
--- a/arch/arm64/include/asm/mt6797_a72_membership.h
+++ b/arch/arm64/include/asm/mt6797_a72_membership.h
@@ -14,9 +14,10 @@
  * Version of a dormant C owner-model layout, not a P17/P18/P24 token ABI or
  * wire/hardware ABI. This slice consumes a P31 attempt and can mint a frozen
  * token only in an explicitly opened test state; A36 only validates an
- * immutable caller-supplied prestate record. It implements no bootstrap,
- * provider or CPUHP effect, P30 handoff, P14/P15, hardware mutation, or
- * CPU_ON operation.
+ * immutable caller-supplied prestate record. A dormant P17/P18 ledger may
+ * advance only the C phase to ON_ISSUED. It implements no bootstrap, provider
+ * call, CPUHP effect, P30 handoff, P14/P15, hardware mutation, or CPU_ON
+ * operation.
  */
 #define MT6797_A72_TRANSACTION_ABI 1
 #define MT6797_A72_OPERATION_SLOTS 4
@@ -186,6 +187,7 @@ struct mt6797_a72_transaction {
 	struct mt6797_a72_call_budgets budgets;
 	struct mt6797_a72_entry_snapshot entry;
 	struct mt6797_a72_a36_prestate a36_prestate;
+	struct mt6797_a72_provider_identity provider_identity;
 	struct arm64_late_cpu_up_token p30_token;
 	u64 controller_cookie;
 	u64 effect_prefix;
@@ -193,6 +195,7 @@ struct mt6797_a72_transaction {
 	u32 p30_token_valid;
 	u32 public_preflight;
 	u32 a36_valid;
+	u32 p17_p18_published;
 	u32 freeze_release_count;
 	u32 valid;
 };
@@ -234,7 +237,8 @@ mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
 			       struct mt6797_a72_transaction *transaction);
 int
 mt6797_a72_membership_validate_up_prestate(const struct mt6797_a72_transaction *transaction,
-					   const struct mt6797_a72_a36_prestate *prestate);
+						   const struct mt6797_a72_a36_prestate *prestate);
+int mt6797_a72_membership_publish_up(struct mt6797_a72_transaction *transaction);
 int mt6797_a72_membership_validate_entry(unsigned int cpu,
 					 enum cpuhp_state target, u32 attempt,
 					 const struct mt6797_a72_entry_snapshot *entry);
@@ -266,13 +270,21 @@ mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
 
 static inline int
 mt6797_a72_membership_validate_up_prestate(const struct mt6797_a72_transaction *transaction,
-					   const struct mt6797_a72_a36_prestate *prestate)
+						   const struct mt6797_a72_a36_prestate *prestate)
 {
 	(void)transaction;
 	(void)prestate;
 	return -EOPNOTSUPP;
 }
 
+static inline int
+mt6797_a72_membership_publish_up(struct mt6797_a72_transaction *transaction)
+{
+	if (transaction)
+		memset(transaction, 0, sizeof(*transaction));
+	return -EOPNOTSUPP;
+}
+
 static inline int mt6797_a72_membership_validate_entry(unsigned int cpu,
 						 enum cpuhp_state target, u32 attempt,
 						 const struct mt6797_a72_entry_snapshot *entry)
@@ -322,6 +334,7 @@ mt6797_a72_membership_snapshot(struct mt6797_a72_owner_snapshot *snapshot)
 #ifdef CONFIG_ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST
 void mt6797_a72_membership_test_reset(void);
 void mt6797_a72_membership_test_seed_available(void);
+void mt6797_a72_membership_test_seed_available_cpu9(void);
 #endif
 
 #endif /* __ASM_MT6797_A72_MEMBERSHIP_H */
diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index cf3044b54..da4f8d3a4 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -6,8 +6,9 @@
  * Read-only admission callbacks may inspect CLOSED. A dormant P31 ledger
  * consumes a one-shot attempt only in a test-seeded AVAILABLE state, then
  * retains the transition lock across A28, frozen-token minting, and the
- * immutable A36 prestate check. P17/P18 and all hardware/CPU_ON effects
- * remain absent.
+ * immutable A36 prestate check. A dormant P17/P18 publication ledger may
+ * advance only the C phase to ON_ISSUED; provider calls and all hardware,
+ * CPUHP, and CPU_ON effects remain absent.
  */
 
 #include <linux/compiler.h>
@@ -85,6 +86,13 @@ mt6797_a72_identity_nonzero(const u64 identity[ARM64_LATE_CPU_ID_WORDS])
 	return false;
 }
 
+static bool
+mt6797_a72_provider_identity_valid(const struct mt6797_a72_provider_identity *identity)
+{
+	return identity && identity->generation && identity->cookie &&
+		identity->generation != ~0ULL && identity->cookie != ~0ULL;
+}
+
 static int
 mt6797_a72_ready_token_validate(unsigned int cpu,
 				const struct arm64_late_cpu_ready_token *ready)
@@ -306,7 +314,14 @@ mt6797_a72_membership_mint_up_token(unsigned int cpu,
 	} else if (attempt != (operation == MT6797_A72_OPERATION_CPU8_UP ?
 				MT6797_A72_ATTEMPT_CPU8_UP :
 				MT6797_A72_ATTEMPT_CPU9_UP) ||
-			 !(a72_owner.attempts_consumed & attempt)) {
+				 !(a72_owner.attempts_consumed & attempt)) {
+		ret = -EPERM;
+	} else if (operation == MT6797_A72_OPERATION_CPU8_UP &&
+		   a72_owner.provider_state != MT6797_A72_PROVIDER_NONE) {
+		ret = -EPERM;
+	} else if (operation == MT6797_A72_OPERATION_CPU9_UP &&
+		   (a72_owner.provider_state != MT6797_A72_PROVIDER_HELD ||
+		    !mt6797_a72_provider_identity_valid(&a72_owner.provider_identity))) {
 		ret = -EPERM;
 	} else if (!a72_owner.next_generation || !a72_owner.next_cookie ||
 		   a72_owner.next_generation == ~0ULL ||
@@ -326,6 +341,8 @@ mt6797_a72_membership_mint_up_token(unsigned int cpu,
 		minted.identity.cookie = cookie;
 		mt6797_a72_init_up_budgets(operation, &minted.budgets);
 		minted.entry = *entry;
+		if (operation == MT6797_A72_OPERATION_CPU9_UP)
+			minted.provider_identity = a72_owner.provider_identity;
 		minted.p30_token.abi = ARM64_LATE_CPU_STARTUP_ABI;
 		minted.p30_token.owner = ARM64_LATE_CPU_STARTUP_OWNER_MEMBERSHIP;
 		minted.p30_token.operation = startup_operation;
@@ -407,6 +424,57 @@ mt6797_a72_membership_reject_frozen(const struct mt6797_a72_transaction_identity
 	return ret;
 }
 
+int mt6797_a72_membership_publish_up(struct mt6797_a72_transaction *transaction)
+{
+	unsigned long flags;
+	int ret = -EPERM;
+
+	if (!transaction)
+		return -EINVAL;
+
+	mutex_lock(&a72_transition_lock);
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	if (a72_owner.health != MT6797_A72_OWNER_AVAILABLE ||
+	    a72_owner.phase != MT6797_A72_PHASE_FROZEN ||
+	    !a72_owner.active.valid || !a72_owner.active.a36_valid ||
+	    !a72_owner.active.p30_token_valid ||
+	    a72_owner.active.p17_p18_published ||
+	    memcmp(&a72_owner.active.identity, &transaction->identity,
+		   sizeof(a72_owner.active.identity))) {
+		ret = -EBUSY;
+		goto out_state;
+	}
+
+	switch (a72_owner.active.identity.operation) {
+	case ARM64_LATE_CPU_STARTUP_OP_CPU8_UP:
+		if (a72_owner.provider_state != MT6797_A72_PROVIDER_NONE ||
+		    a72_owner.active.provider_identity.generation ||
+		    a72_owner.active.provider_identity.cookie)
+			goto out_state;
+		break;
+	case ARM64_LATE_CPU_STARTUP_OP_CPU9_UP:
+		if (a72_owner.provider_state != MT6797_A72_PROVIDER_HELD ||
+		    !mt6797_a72_provider_identity_valid(&a72_owner.provider_identity) ||
+		    memcmp(&a72_owner.active.provider_identity,
+			   &a72_owner.provider_identity,
+			   sizeof(a72_owner.provider_identity)))
+			goto out_state;
+		break;
+	default:
+		goto out_state;
+	}
+
+	a72_owner.active.p17_p18_published = 1;
+	a72_owner.phase = MT6797_A72_PHASE_ON_ISSUED;
+	*transaction = a72_owner.active;
+	ret = 0;
+
+out_state:
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+	mutex_unlock(&a72_transition_lock);
+	return ret;
+}
+
 static int
 mt6797_a72_membership_check_up(unsigned int cpu, int tasks_frozen,
 			       enum cpuhp_state target)
@@ -662,4 +730,19 @@ void mt6797_a72_membership_test_seed_available(void)
 	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
 	mutex_unlock(&a72_transition_lock);
 }
+
+void mt6797_a72_membership_test_seed_available_cpu9(void)
+{
+	unsigned long flags;
+
+	mt6797_a72_membership_test_seed_available();
+	mutex_lock(&a72_transition_lock);
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	/* Harness-only durable M01 identity; no provider call is made. */
+	a72_owner.provider_state = MT6797_A72_PROVIDER_HELD;
+	a72_owner.provider_identity.generation = 1;
+	a72_owner.provider_identity.cookie = 0xa72000f0;
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+	mutex_unlock(&a72_transition_lock);
+}
 #endif
diff --git a/arch/arm64/kernel/mt6797_a72_membership_test.c b/arch/arm64/kernel/mt6797_a72_membership_test.c
index 2b8d62704..899bed6d7 100644
--- a/arch/arm64/kernel/mt6797_a72_membership_test.c
+++ b/arch/arm64/kernel/mt6797_a72_membership_test.c
@@ -584,7 +584,7 @@ static void mt6797_a72_owner_cpu9_mints_distinct_token(struct kunit *test)
 	struct mt6797_a72_transaction transaction;
 	int ret;
 
-	mt6797_a72_membership_test_seed_available();
+	mt6797_a72_membership_test_seed_available_cpu9();
 	ret = mt6797_a72_membership_begin_up(9, CPUHP_ONLINE,
 					     MT6797_A72_ATTEMPT_CPU9_UP,
 					     &entry, &ready, &prestate, &transaction);
@@ -602,6 +602,90 @@ static void mt6797_a72_owner_cpu9_mints_distinct_token(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, transaction.budgets.cpu_on,
 			(u8)MT6797_A72_BUDGET_AVAILABLE);
 	KUNIT_EXPECT_TRUE(test, transaction.p30_token_valid);
+	KUNIT_EXPECT_EQ(test, transaction.provider_identity.generation,
+			(u64)1);
+	KUNIT_EXPECT_EQ(test, transaction.provider_identity.cookie,
+			(u64)0xa72000f0);
+}
+
+static void mt6797_a72_owner_p17_cpu8_publishes_once(struct kunit *test)
+{
+	struct mt6797_a72_entry_snapshot entry = mt6797_a72_entry_for_up(8);
+	struct arm64_late_cpu_ready_token ready = mt6797_a72_ready_token_for_up();
+	struct mt6797_a72_a36_prestate prestate = mt6797_a72_prestate_for_up(8);
+	struct mt6797_a72_transaction transaction;
+	struct owner_observation before;
+	struct owner_observation after;
+	int ret;
+
+	mt6797_a72_membership_test_seed_available();
+	ret = mt6797_a72_membership_begin_up(8, CPUHP_ONLINE,
+					     MT6797_A72_ATTEMPT_CPU8_UP,
+					     &entry, &ready, &prestate, &transaction);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ret = mt6797_a72_membership_publish_up(&transaction);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_TRUE(test, transaction.p17_p18_published);
+	KUNIT_EXPECT_EQ(test, transaction.provider_identity.generation,
+			(u64)0);
+	owner_observe(&after);
+	KUNIT_EXPECT_EQ(test, after.owner.phase,
+			(u32)MT6797_A72_PHASE_ON_ISSUED);
+	KUNIT_EXPECT_TRUE(test, after.owner.active.p17_p18_published);
+	KUNIT_EXPECT_EQ(test, after.owner.provider_state,
+			(u32)MT6797_A72_PROVIDER_NONE);
+
+	owner_observe(&before);
+	ret = mt6797_a72_membership_publish_up(&transaction);
+	KUNIT_EXPECT_EQ(test, ret, -EBUSY);
+	owner_observe(&after);
+	expect_unchanged(test, &before, &after);
+}
+
+static void mt6797_a72_owner_p18_cpu9_preserves_provider(struct kunit *test)
+{
+	struct mt6797_a72_entry_snapshot entry = mt6797_a72_entry_for_up(9);
+	struct arm64_late_cpu_ready_token ready = mt6797_a72_ready_token_for_up();
+	struct mt6797_a72_a36_prestate prestate = mt6797_a72_prestate_for_up(9);
+	struct mt6797_a72_transaction transaction;
+	struct mt6797_a72_owner_snapshot snapshot;
+	int ret;
+
+	mt6797_a72_membership_test_seed_available_cpu9();
+	ret = mt6797_a72_membership_begin_up(9, CPUHP_ONLINE,
+					     MT6797_A72_ATTEMPT_CPU9_UP,
+					     &entry, &ready, &prestate, &transaction);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ret = mt6797_a72_membership_publish_up(&transaction);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_TRUE(test, transaction.p17_p18_published);
+	mt6797_a72_membership_snapshot(&snapshot);
+	KUNIT_EXPECT_EQ(test, snapshot.phase,
+			(u32)MT6797_A72_PHASE_ON_ISSUED);
+	KUNIT_EXPECT_EQ(test, snapshot.provider_state,
+			(u32)MT6797_A72_PROVIDER_HELD);
+	KUNIT_EXPECT_EQ(test, snapshot.provider_identity.generation,
+			(u64)1);
+	KUNIT_EXPECT_EQ(test, snapshot.provider_identity.cookie,
+			(u64)0xa72000f0);
+	KUNIT_EXPECT_EQ(test, snapshot.active.provider_identity.cookie,
+			(u64)0xa72000f0);
+}
+
+static void mt6797_a72_owner_p18_without_provider_rejected(struct kunit *test)
+{
+	struct mt6797_a72_entry_snapshot entry = mt6797_a72_entry_for_up(9);
+	struct arm64_late_cpu_ready_token ready = mt6797_a72_ready_token_for_up();
+	struct mt6797_a72_a36_prestate prestate = mt6797_a72_prestate_for_up(9);
+	struct mt6797_a72_transaction transaction;
+	int ret;
+
+	mt6797_a72_membership_test_seed_available();
+	ret = mt6797_a72_membership_begin_up(9, CPUHP_ONLINE,
+					     MT6797_A72_ATTEMPT_CPU9_UP,
+					     &entry, &ready, &prestate, &transaction);
+	KUNIT_EXPECT_EQ(test, ret, -EPERM);
+	KUNIT_EXPECT_TRUE(test, mt6797_a72_transaction_empty(&transaction));
 }
 
 static void mt6797_a72_owner_forged_token_rejected(struct kunit *test)
@@ -659,6 +743,9 @@ static struct kunit_case mt6797_a72_owner_cases[] = {
 	KUNIT_CASE(mt6797_a72_owner_a36_rejects_without_rearm),
 	KUNIT_CASE(mt6797_a72_owner_a36_prestate_mutations_rejected),
 	KUNIT_CASE(mt6797_a72_owner_cpu9_mints_distinct_token),
+	KUNIT_CASE(mt6797_a72_owner_p17_cpu8_publishes_once),
+	KUNIT_CASE(mt6797_a72_owner_p18_cpu9_preserves_provider),
+	KUNIT_CASE(mt6797_a72_owner_p18_without_provider_rejected),
 	KUNIT_CASE(mt6797_a72_owner_forged_token_rejected),
 	KUNIT_CASE(mt6797_a72_owner_no_live_token),
 	{ }
-- 
