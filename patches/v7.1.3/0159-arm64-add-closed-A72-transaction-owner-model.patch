diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
new file mode 100644
index 000000000..e894e7944
--- /dev/null
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Lifecycle-closed transaction owner for future MT6797 A72 membership.
+ *
+ * This object deliberately has no production caller or opener. CLOSED is a
+ * meta/lifecycle boundary before P31/A38, not an early substitute for the
+ * future P31 -> A28 -> mint -> A36 ordering.
+ */
+
+#include <linux/compiler.h>
+#include <linux/errno.h>
+#include <linux/mutex.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+
+#include <asm/mt6797_a72_membership.h>
+
+static DEFINE_MUTEX(a72_transition_lock);
+static DEFINE_RAW_SPINLOCK(a72_state_lock);
+
+struct mt6797_a72_owner_state {
+	struct mt6797_a72_transaction active;
+	struct mt6797_a72_transaction retired[MT6797_A72_OPERATION_SLOTS];
+	struct mt6797_a72_provider_identity provider_identity;
+	struct mt6797_a72_fault_record first_fault;
+	struct task_struct *controller;
+	u64 diagnostic_blockers;
+	u64 controller_cookie;
+	u32 health;
+	u32 phase;
+	u32 members;
+	u32 provider_state;
+	u32 bootstrap_valid;
+	u32 members_valid;
+	u32 attempts_available;
+	u32 attempts_consumed;
+	u32 retired_mask;
+};
+
+static struct mt6797_a72_owner_state a72_owner = {
+	.diagnostic_blockers = MT6797_A72_BLOCK_MASK,
+	.health = MT6797_A72_OWNER_CLOSED,
+	.phase = MT6797_A72_PHASE_UNINITIALIZED,
+	.provider_state = MT6797_A72_PROVIDER_NONE,
+};
+
+static enum mt6797_a72_membership_operation
+mt6797_a72_up_operation(unsigned int cpu)
+{
+	switch (cpu) {
+	case 8:
+		return MT6797_A72_OPERATION_CPU8_UP;
+	case 9:
+		return MT6797_A72_OPERATION_CPU9_UP;
+	default:
+		return MT6797_A72_OPERATION_NONE;
+	}
+}
+
+static bool
+mt6797_a72_up_token_equal(const struct arm64_late_cpu_up_token *left,
+			  const struct arm64_late_cpu_up_token *right)
+{
+	return !memcmp(left, right, sizeof(*left));
+}
+
+int
+mt6797_a72_membership_begin_up(unsigned int cpu, enum cpuhp_state target,
+			       struct mt6797_a72_transaction *transaction)
+{
+	enum mt6797_a72_membership_operation operation;
+	unsigned long flags;
+	int ret;
+
+	if (!transaction)
+		return -EINVAL;
+	memset(transaction, 0, sizeof(*transaction));
+
+	operation = mt6797_a72_up_operation(cpu);
+	if (operation == MT6797_A72_OPERATION_NONE || target != CPUHP_ONLINE)
+		return -EINVAL;
+
+	/*
+	 * There is intentionally no production CLOSED -> AVAILABLE writer.
+	 * The pre-P31 denial changes no attempt, generation, token, or ledger.
+	 */
+	if (READ_ONCE(a72_owner.health) == MT6797_A72_OWNER_CLOSED)
+		return -EAGAIN;
+
+	mutex_lock(&a72_transition_lock);
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	switch (a72_owner.health) {
+	case MT6797_A72_OWNER_CLOSED:
+		ret = -EAGAIN;
+		break;
+	case MT6797_A72_OWNER_FAULTED:
+		ret = -ESHUTDOWN;
+		break;
+	case MT6797_A72_OWNER_AVAILABLE:
+		/* Future code must begin with P31, not bypass it here. */
+		ret = -EOPNOTSUPP;
+		break;
+	default:
+		ret = -EPROTO;
+		break;
+	}
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+	mutex_unlock(&a72_transition_lock);
+
+	return ret;
+}
+
+bool
+mt6797_a72_membership_owns_up_token(const struct arm64_late_cpu_up_token *token)
+{
+	unsigned long flags;
+	bool owned;
+
+	if (!token)
+		return false;
+
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	owned = a72_owner.health == MT6797_A72_OWNER_AVAILABLE &&
+		a72_owner.bootstrap_valid && a72_owner.active.valid &&
+		a72_owner.active.p30_token_valid &&
+		mt6797_a72_up_token_equal(&a72_owner.active.p30_token, token);
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+
+	return owned;
+}
+
+int mt6797_a72_membership_copy_up_token(struct arm64_late_cpu_up_token *token)
+{
+	unsigned long flags;
+	int ret = -ENOENT;
+
+	if (!token)
+		return -EINVAL;
+	memset(token, 0, sizeof(*token));
+
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	if (a72_owner.health == MT6797_A72_OWNER_FAULTED) {
+		ret = -ESHUTDOWN;
+	} else if (a72_owner.health == MT6797_A72_OWNER_AVAILABLE &&
+		   a72_owner.bootstrap_valid && a72_owner.active.valid &&
+		   a72_owner.active.p30_token_valid) {
+		*token = a72_owner.active.p30_token;
+		ret = 0;
+	}
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+
+	return ret;
+}
+
+void mt6797_a72_membership_snapshot(struct mt6797_a72_owner_snapshot *snapshot)
+{
+	unsigned long flags;
+
+	if (!snapshot)
+		return;
+
+	memset(snapshot, 0, sizeof(*snapshot));
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	snapshot->active = a72_owner.active;
+	memcpy(snapshot->retired, a72_owner.retired,
+	       sizeof(snapshot->retired));
+	snapshot->provider_identity = a72_owner.provider_identity;
+	snapshot->first_fault = a72_owner.first_fault;
+	snapshot->diagnostic_blockers = a72_owner.diagnostic_blockers;
+	snapshot->controller_cookie = a72_owner.controller_cookie;
+	snapshot->abi = MT6797_A72_TRANSACTION_ABI;
+	snapshot->health = a72_owner.health;
+	snapshot->phase = a72_owner.phase;
+	snapshot->members = a72_owner.members;
+	snapshot->provider_state = a72_owner.provider_state;
+	snapshot->bootstrap_valid = a72_owner.bootstrap_valid;
+	snapshot->members_valid = a72_owner.members_valid;
+	snapshot->attempts_available = a72_owner.attempts_available;
+	snapshot->attempts_consumed = a72_owner.attempts_consumed;
+	snapshot->retired_mask = a72_owner.retired_mask;
+	snapshot->controller_present = !!a72_owner.controller;
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+}
+
+#ifdef CONFIG_ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST
+void mt6797_a72_membership_test_reset(void)
+{
+	unsigned long flags;
+
+	mutex_lock(&a72_transition_lock);
+	raw_spin_lock_irqsave(&a72_state_lock, flags);
+	memset(&a72_owner, 0, sizeof(a72_owner));
+	a72_owner.diagnostic_blockers = MT6797_A72_BLOCK_MASK;
+	a72_owner.health = MT6797_A72_OWNER_CLOSED;
+	a72_owner.phase = MT6797_A72_PHASE_UNINITIALIZED;
+	a72_owner.provider_state = MT6797_A72_PROVIDER_NONE;
+	raw_spin_unlock_irqrestore(&a72_state_lock, flags);
+	mutex_unlock(&a72_transition_lock);
+}
+#endif
diff --git a/arch/arm64/kernel/mt6797_a72_membership_test.c b/arch/arm64/kernel/mt6797_a72_membership_test.c
new file mode 100644
index 000000000..0f1fc0fc9
--- /dev/null
+++ b/arch/arm64/kernel/mt6797_a72_membership_test.c
@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include <asm/mt6797_a72_membership.h>
+
+struct owner_observation {
+	struct mt6797_a72_owner_snapshot owner;
+	struct arm64_late_cpu_startup_snapshot p30;
+};
+
+static bool
+mt6797_a72_transaction_empty(const struct mt6797_a72_transaction *transaction)
+{
+	const struct mt6797_a72_transaction empty = { };
+
+	return !memcmp(transaction, &empty, sizeof(empty));
+}
+
+static void
+owner_observe(struct owner_observation *observation)
+{
+	mt6797_a72_membership_snapshot(&observation->owner);
+	arm64_late_cpu_startup_snapshot(&observation->p30);
+}
+
+static void
+expect_unchanged(struct kunit *test,
+		 const struct owner_observation *before,
+		 const struct owner_observation *after)
+{
+	int difference;
+
+	difference = memcmp(&before->owner, &after->owner,
+			    sizeof(before->owner));
+	KUNIT_EXPECT_EQ(test, difference, 0);
+	difference = memcmp(&before->p30, &after->p30,
+			    sizeof(before->p30));
+	KUNIT_EXPECT_EQ(test, difference, 0);
+}
+
+static int mt6797_a72_owner_test_init(struct kunit *test)
+{
+	(void)test;
+	mt6797_a72_membership_test_reset();
+	return 0;
+}
+
+static void mt6797_a72_owner_initial_closed(struct kunit *test)
+{
+	const struct mt6797_a72_transaction empty_transaction = { };
+	const struct mt6797_a72_provider_identity empty_provider = { };
+	const struct mt6797_a72_fault_record empty_fault = { };
+	struct mt6797_a72_owner_snapshot snapshot;
+	unsigned int slot;
+	int difference;
+
+	mt6797_a72_membership_snapshot(&snapshot);
+	KUNIT_EXPECT_EQ(test, snapshot.abi,
+			(u32)MT6797_A72_TRANSACTION_ABI);
+	KUNIT_EXPECT_EQ(test, snapshot.health,
+			(u32)MT6797_A72_OWNER_CLOSED);
+	KUNIT_EXPECT_EQ(test, snapshot.phase,
+			(u32)MT6797_A72_PHASE_UNINITIALIZED);
+	KUNIT_EXPECT_FALSE(test, snapshot.bootstrap_valid);
+	KUNIT_EXPECT_FALSE(test, snapshot.members_valid);
+	KUNIT_EXPECT_EQ(test, snapshot.members, (u32)0);
+	KUNIT_EXPECT_EQ(test, snapshot.provider_state,
+			(u32)MT6797_A72_PROVIDER_NONE);
+	KUNIT_EXPECT_EQ(test, snapshot.attempts_available, (u32)0);
+	KUNIT_EXPECT_EQ(test, snapshot.attempts_consumed, (u32)0);
+	KUNIT_EXPECT_EQ(test, snapshot.retired_mask, (u32)0);
+	KUNIT_EXPECT_FALSE(test, snapshot.controller_present);
+	KUNIT_EXPECT_EQ(test, snapshot.controller_cookie, (u64)0);
+	KUNIT_EXPECT_EQ(test, snapshot.diagnostic_blockers,
+			(u64)MT6797_A72_BLOCK_MASK);
+	difference = memcmp(&snapshot.active, &empty_transaction,
+			    sizeof(empty_transaction));
+	KUNIT_EXPECT_EQ(test, difference, 0);
+	for (slot = 0; slot < MT6797_A72_OPERATION_SLOTS; slot++) {
+		difference = memcmp(&snapshot.retired[slot], &empty_transaction,
+				    sizeof(empty_transaction));
+		KUNIT_EXPECT_EQ(test, difference, 0);
+	}
+	difference = memcmp(&snapshot.provider_identity, &empty_provider,
+			    sizeof(empty_provider));
+	KUNIT_EXPECT_EQ(test, difference, 0);
+	difference = memcmp(&snapshot.first_fault, &empty_fault,
+			    sizeof(empty_fault));
+	KUNIT_EXPECT_EQ(test, difference, 0);
