From 646bbbe6cbcc966f21141880b283598ec6169e2e Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 4 Sep 2026 13:01:00 +0000
Subject: [PATCH 1/2] arm64: dts: mediatek: add MT6797 thermal reset

Describe the source-proven infracfg reset input.

Keep the reusable SoC thermal consumer disabled by default.
---
 arch/arm64/boot/dts/mediatek/mt6797.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6797.dtsi b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
index 15a92c4..0e68b9e 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
@@ -829,6 +829,7 @@
 		clocks = <&infrasys CLK_INFRA_THERM>,
 			 <&infrasys CLK_INFRA_AUXADC>;
 		clock-names = "therm", "auxadc";
+		resets = <&infrasys MT6797_INFRA_THERM_CTRL_RST>;
 		mediatek,auxadc = <&auxadc>;
 		mediatek,apmixedsys = <&apmixedsys>;
 		#thermal-sensor-cells = <0>;
