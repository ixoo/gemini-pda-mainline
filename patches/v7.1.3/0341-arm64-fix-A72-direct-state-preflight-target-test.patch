From 1ee2d4e8006d4ecddd66c7cc7df948d3c6eb0a8a Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 24 Aug 2026 00:31:00 +0000
Subject: [PATCH] arm64: fix A72 direct-state preflight target test

Probe the closed admission contract with CPUHP_ONLINE, the only target accepted by the preflight API, before and after the read-only compositor call.
---
 arch/arm64/kernel/mt6797_a72_direct_state_test.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/kernel/mt6797_a72_direct_state_test.c b/arch/arm64/kernel/mt6797_a72_direct_state_test.c
index fc2fac5..4a0c844 100644
--- a/arch/arm64/kernel/mt6797_a72_direct_state_test.c
+++ b/arch/arm64/kernel/mt6797_a72_direct_state_test.c
@@ -193,7 +193,7 @@ static void direct_snapshot_success(struct kunit *test)
 	KUNIT_ASSERT_EQ(test, direct_register(test, state), 0);
 	mt6797_a72_membership_snapshot(&state->owner_before);
 	arm64_late_cpu_startup_snapshot(&state->p30_before);
-	preflight_before = mt6797_a72_membership_preflight_up(8, CPUHP_OFFLINE);
+	preflight_before = mt6797_a72_membership_preflight_up(8, CPUHP_ONLINE);
 	memset(observed, 0xa5, sizeof(*observed));
 	ret = mt6797_a72_direct_state_test_snapshot(&topology, observed);
 	KUNIT_ASSERT_EQ(test, ret, 0);
@@ -211,7 +211,7 @@ static void direct_snapshot_success(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, state->calls, 1U);
 	mt6797_a72_membership_snapshot(&state->owner_after);
 	arm64_late_cpu_startup_snapshot(&state->p30_after);
-	preflight_after = mt6797_a72_membership_preflight_up(8, CPUHP_OFFLINE);
+	preflight_after = mt6797_a72_membership_preflight_up(8, CPUHP_ONLINE);
 	KUNIT_EXPECT_EQ(test,
 			memcmp(&state->owner_before,
 			       &state->owner_after,
