+static bool mt6797_a72_binder_backend_valid(
+	const struct mt6797_a72_binder_backend_ops *ops);
+
+static void mt6797_a72_binder_copy_parent_identity(
+	struct mt6797_a72_binder_parent_identity *destination,
+	const struct mt6797_a72_transaction_identity *source)
+{
+	destination->abi = source->abi;
+	destination->owner = source->owner;
+	destination->operation = source->operation;
+	destination->target_cpu = source->target_cpu;
+	destination->cpuhp_target = source->cpuhp_target;
+	destination->target_mpidr = source->target_mpidr;
+	destination->cpu_on_entry_pa = source->cpu_on_entry_pa;
+	destination->generation = source->generation;
+	destination->cookie = source->cookie;
+}
+
+static int mt6797_a72_binder_parent_proof_locked(
+	const struct mt6797_a72_binder *binder,
+	struct mt6797_a72_binder_parent_proof *proof)
+{
+	struct mt6797_a72_initial_parent_proof membership = { };
+	struct mtk_wdt_recovery_validation watchdog = { };
+	const struct mt6797_a72_transition_result *result = &binder->result;
+	const u32 retained = MT6797_A72_TRANSITION_OWNED_P27 |
+		MT6797_A72_TRANSITION_OWNED_PROVIDER |
+		MT6797_A72_TRANSITION_OWNED_CPU8;
+	u64 observed_ns;
+	u32 online_count;
+	u32 online_mask = 0;
+	unsigned int cpu;
+	int ret;
+
+	memset(proof, 0, sizeof(*proof));
+	if (!mt6797_a72_binder_backend_valid(binder->backend))
+		return -EPROTO;
+	ret = binder->backend->membership_parent_proof(&membership);
+	if (ret)
+		return ret;
+	for (cpu = 0; cpu <= MT6797_A72_TRANSITION_CPU9; cpu++)
+		if (binder->backend->cpu_online(cpu))
+			online_mask |= BIT(cpu);
+	online_count = binder->backend->cpu_online_count();
+	ret = binder->backend->watchdog_validate(
+		binder->watchdog, result->watchdog_identity, &watchdog);
+	if (ret)
+		return ret;
+	observed_ns = binder->backend->monotonic_ns();
+
+	if (membership.abi != MT6797_A72_INITIAL_PARENT_PROOF_ABI ||
+	    membership.exact != 1 ||
+	    membership.health != MT6797_A72_OWNER_AVAILABLE ||
+	    membership.owner_phase != MT6797_A72_PHASE_IDLE ||
+	    membership.hotplug_phase != MT6797_A72_HOTPLUG_IDLE ||
+	    membership.members != (BIT(0) | BIT(1)) ||
+	    membership.retired_mask != (BIT(0) | BIT(1)) ||
+	    membership.hotplug_retired_mask ||
+	    membership.provider_state != MT6797_A72_PROVIDER_HELD ||
+	    membership.controller_present || membership.active_present ||
+	    membership.hotplug_active_present ||
+	    atomic_read(&binder->boot_claimed) != 1 ||
+	    atomic_read(&binder->transition.consumed) != 1 ||
+	    atomic_read_acquire(&binder->transition.lifecycle) !=
+		    MT6797_A72_TRANSITION_LIFECYCLE_TERMINAL ||
+	    result->terminal != MT6797_A72_TRANSITION_CPU8_ONLINE_PROOF ||
+	    result->last_stage != MT6797_A72_TRANSITION_STAGE_MEMBERSHIP ||
+	    result->stage_errno || result->rollback_errno ||
+	    result->checkpoint_errno || !result->attempted ||
+	    !result->watchdog_armed || !result->p27_owned ||
+	    !result->provider_owned || !result->membership_published ||
+	    !result->cpu8_online || result->cpu9_online ||
+	    result->rollback_mask || result->retained_mask != retained ||
+	    result->cpu_requests != 1 || result->cpu_off_requests ||
+	    result->retries || result->terminal_commits != 1 ||
+	    !binder->transaction.valid ||
+	    !binder->transaction.cpu8_success_published ||
+	    memcmp(&binder->transaction.identity, &membership.cpu8,
+		   sizeof(membership.cpu8)) ||
+	    memcmp(&binder->transaction.provider_identity,
+		   &membership.provider_identity,
+		   sizeof(membership.provider_identity)) ||
+	    online_mask != MT6797_A72_BINDER_PARENT_ONLINE_MASK ||
+	    online_count != 10 || !result->watchdog_identity ||
+	    !binder->watchdog_takeover_ns ||
+	    watchdog.identity != result->watchdog_identity ||
+	    watchdog.owned != 1 || observed_ns < binder->watchdog_takeover_ns)
+		return -EPROTO;
+	if (observed_ns - binder->watchdog_takeover_ns >
+	    MT6797_A72_BINDER_PARENT_MAX_AGE_MS * 1000000ULL)
+		return -ETIME;
+
+	proof->abi = MT6797_A72_BINDER_PARENT_PROOF_ABI;
+	proof->exact = 1;
+	proof->health = membership.health;
+	proof->owner_phase = membership.owner_phase;
+	proof->hotplug_phase = membership.hotplug_phase;
+	proof->members = membership.members;
+	proof->retired_mask = membership.retired_mask;
+	proof->hotplug_retired_mask = membership.hotplug_retired_mask;
+	proof->provider_state = membership.provider_state;
+	proof->controller_present = membership.controller_present;
+	proof->active_present = membership.active_present;
+	proof->hotplug_active_present = membership.hotplug_active_present;
+	proof->online_mask = online_mask;
+	proof->online_count = online_count;
+	mt6797_a72_binder_copy_parent_identity(&proof->cpu8,
+					       &membership.cpu8);
+	mt6797_a72_binder_copy_parent_identity(&proof->cpu9,
+					       &membership.cpu9);
+	proof->provider_generation = membership.provider_identity.generation;
+	proof->provider_cookie = membership.provider_identity.cookie;
+	proof->watchdog_identity = result->watchdog_identity;
+	proof->watchdog_takeover_ns = binder->watchdog_takeover_ns;
+	proof->observed_ns = observed_ns;
+	proof->watchdog_age_ns = observed_ns - binder->watchdog_takeover_ns;
+	return 0;
+}
+
+int mt6797_a72_binder_parent_proof(
+	struct mt6797_a72_binder_parent_proof *proof)
+{
+	struct mt6797_a72_binder *binder;
+	int ret;
+
+	if (!proof)
+		return -EINVAL;
+	memset(proof, 0, sizeof(*proof));
+	mutex_lock(&mt6797_a72_binder_publish_lock);
+	binder = mt6797_a72_binder_ready();
+	ret = binder ? mt6797_a72_binder_parent_proof_locked(binder, proof) :
+		-EAGAIN;
+	mutex_unlock(&mt6797_a72_binder_publish_lock);
+	return ret;
+}
