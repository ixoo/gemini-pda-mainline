+static int mt6797_binder_test_parent_proof(
+	struct mt6797_a72_initial_parent_proof *proof)
+{
+	struct mt6797_binder_test_state *state = mt6797_binder_test_active;
+	const struct mt6797_a72_transaction_identity *cpu8 =
+		&state->binder.transaction.identity;
+
+	memset(proof, 0, sizeof(*proof));
+	if (!state->parent_available)
+		return -EPERM;
+	proof->abi = MT6797_A72_INITIAL_PARENT_PROOF_ABI;
+	proof->exact = 1;
+	proof->health = MT6797_A72_OWNER_AVAILABLE;
+	proof->owner_phase = MT6797_A72_PHASE_IDLE;
+	proof->hotplug_phase = MT6797_A72_HOTPLUG_IDLE;
+	proof->members = BIT(0) | BIT(1);
+	proof->retired_mask = BIT(0) | BIT(1);
+	proof->provider_state = MT6797_A72_PROVIDER_HELD;
+	proof->cpu8 = *cpu8;
+	proof->cpu9.abi = MT6797_A72_TRANSACTION_ABI;
+	proof->cpu9.owner = ARM64_LATE_CPU_STARTUP_OWNER_MEMBERSHIP;
+	proof->cpu9.operation = ARM64_LATE_CPU_STARTUP_OP_CPU9_UP;
+	proof->cpu9.target_cpu = 9;
+	proof->cpu9.cpuhp_target = CPUHP_ONLINE;
+	proof->cpu9.target_mpidr = 0x201;
+	proof->cpu9.generation = TEST_CPU9_GENERATION;
+	proof->cpu9.cookie = TEST_CPU9_COOKIE;
+	proof->provider_identity = state->binder.transaction.provider_identity;
+	return 0;
+}
+
+static int mt6797_binder_test_watchdog_validate(
+	struct device *dev, u64 identity,
+	struct mtk_wdt_recovery_validation *validation)
+{
+	struct mt6797_binder_test_state *state = mt6797_binder_test_active;
+
+	(void)dev;
+	memset(validation, 0, sizeof(*validation));
+	state->watchdog_validations++;
+	if (identity != TEST_WATCHDOG_IDENTITY)
+		return -EACCES;
+	validation->identity = identity;
+	validation->owned = 1;
+	return 0;
+}
+
+static u64 mt6797_binder_test_monotonic_ns(void)
+{
+	return mt6797_binder_test_active->monotonic_ns ?:
+		TEST_TAKEOVER_NS;
+}
+
+static unsigned int mt6797_binder_test_online_count(void)
+{
+	struct mt6797_binder_test_state *state = mt6797_binder_test_active;
+
+	return 8 + state->cpu8_online + state->cpu9_online;
+}
+
 static bool mt6797_binder_test_owns_token(const struct arm64_late_cpu_up_token *token)
