+	result->identity = state->malformed == TEST_MALFORMED_WATCHDOG ?
+		0 : TEST_WATCHDOG_IDENTITY;
 	result->owned = 1;
 	mt6797_binder_test_event(TEST_EVENT_WATCHDOG);
 	return timeout_ms == MTK_WDT_RECOVERY_TIMEOUT_MS ? 0 : -EINVAL;
@@ -513,7 +585,14 @@ static int mt6797_binder_test_dcm(struct device *dev,
 
 static bool mt6797_binder_test_cpu_online(unsigned int cpu)
 {
-	return cpu == 8 && mt6797_binder_test_active->cpu8_online;
+	struct mt6797_binder_test_state *state =
+		mt6797_binder_test_active;
+
+	if (cpu < 8)
+		return true;
+	if (cpu == 8)
+		return state->cpu8_online;
+	return cpu == 9 && state->cpu9_online;
 }
 
 static int mt6797_binder_test_ipi(unsigned int cpu, smp_call_func_t func,
@@ -550,13 +629,17 @@ static const struct mt6797_a72_binder_backend_ops mt6797_binder_test_ops = {
 #endif
 	.membership_publish_success = mt6797_binder_test_publish_success,
 	.membership_finalize_success = mt6797_binder_test_finalize_success,
+	.membership_parent_proof = mt6797_binder_test_parent_proof,
 	.watchdog_takeover = mt6797_binder_test_watchdog,
+	.watchdog_validate = mt6797_binder_test_watchdog_validate,
+	.monotonic_ns = mt6797_binder_test_monotonic_ns,
 	.p27_acquire = mt6797_binder_test_p27,
 	.p27_release = mt6797_binder_test_p27_release,
 	.isolation_clear = mt6797_binder_test_isolation,
 	.sram_enable = mt6797_binder_test_sram,
 	.dcm_update = mt6797_binder_test_dcm,
 	.cpu_online = mt6797_binder_test_cpu_online,
+	.cpu_online_count = mt6797_binder_test_online_count,
 	.ipi_call = mt6797_binder_test_ipi,
 };
 
@@ -579,6 +662,7 @@ static int mt6797_binder_test_init(struct kunit *test)
 	if (!state)
 		return -ENOMEM;
 	mt6797_binder_test_active = state;
+	state->monotonic_ns = TEST_TAKEOVER_NS;
 	mt6797_a72_binder_test_init(&state->binder, &mt6797_binder_test_ops);
 	test->priv = state;
 	return 0;
@@ -894,6 +978,71 @@ static void mt6797_binder_p30e_readback_test(struct kunit *test)
 }
 #endif
 
+static void mt6797_binder_parent_proof_test(struct kunit *test)
+{
+	struct mt6797_binder_test_state *state = test->priv;
+	struct mt6797_a72_binder_parent_proof proof;
+	struct mt6797_a72_binder before;
+	int ret;
+
+	KUNIT_ASSERT_EQ(test, mt6797_binder_test_run_to_completion(state), 0);
+	state->cpu9_online = true;
+	state->parent_available = true;
+	state->monotonic_ns = TEST_TAKEOVER_NS + 2000000000ULL;
+	before = state->binder;
+	ret = mt6797_a72_binder_test_parent_proof(&state->binder, &proof);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, proof.abi,
+			MT6797_A72_BINDER_PARENT_PROOF_ABI);
+	KUNIT_EXPECT_EQ(test, proof.exact, 1U);
+	KUNIT_EXPECT_EQ(test, proof.members, (u32)(BIT(0) | BIT(1)));
+	KUNIT_EXPECT_EQ(test, proof.online_mask,
+			MT6797_A72_BINDER_PARENT_ONLINE_MASK);
+	KUNIT_EXPECT_EQ(test, proof.online_count, 10U);
+	KUNIT_EXPECT_EQ(test, proof.cpu8.target_cpu, 8U);
+	KUNIT_EXPECT_EQ(test, proof.cpu8.target_mpidr, 0x200ULL);
+	KUNIT_EXPECT_EQ(test, proof.cpu9.target_cpu, 9U);
+	KUNIT_EXPECT_EQ(test, proof.cpu9.target_mpidr, 0x201ULL);
+	KUNIT_EXPECT_EQ(test, proof.provider_generation,
+			TEST_PROVIDER_GENERATION);
+	KUNIT_EXPECT_EQ(test, proof.provider_cookie, TEST_PROVIDER_COOKIE);
+	KUNIT_EXPECT_EQ(test, proof.watchdog_identity,
+			TEST_WATCHDOG_IDENTITY);
+	KUNIT_EXPECT_EQ(test, proof.watchdog_takeover_ns, TEST_TAKEOVER_NS);
+	KUNIT_EXPECT_EQ(test, proof.watchdog_age_ns, 2000000000ULL);
+	KUNIT_EXPECT_EQ(test, state->watchdog_validations, 1U);
+	KUNIT_EXPECT_EQ(test, memcmp(&before, &state->binder,
+				     sizeof(before)), 0);
+
+	state->cpu9_online = false;
+	memset(&proof, 0xa5, sizeof(proof));
+	ret = mt6797_a72_binder_test_parent_proof(&state->binder, &proof);
+	KUNIT_EXPECT_EQ(test, ret, -EPROTO);
+	KUNIT_EXPECT_EQ(test, proof.exact, 0U);
+	state->cpu9_online = true;
+
+	state->monotonic_ns = TEST_TAKEOVER_NS + 5000000001ULL;
+	memset(&proof, 0xa5, sizeof(proof));
+	ret = mt6797_a72_binder_test_parent_proof(&state->binder, &proof);
+	KUNIT_EXPECT_EQ(test, ret, -ETIME);
+	KUNIT_EXPECT_EQ(test, proof.exact, 0U);
+	state->monotonic_ns = TEST_TAKEOVER_NS + 2000000000ULL;
+
+	state->parent_available = false;
+	memset(&proof, 0xa5, sizeof(proof));
+	ret = mt6797_a72_binder_test_parent_proof(&state->binder, &proof);
+	KUNIT_EXPECT_EQ(test, ret, -EPERM);
+	KUNIT_EXPECT_EQ(test, proof.exact, 0U);
+	state->parent_available = true;
+
+	state->binder.result.terminal =
+		MT6797_A72_TRANSITION_FAULT_RETAIN_POSTISO;
+	memset(&proof, 0xa5, sizeof(proof));
+	ret = mt6797_a72_binder_test_parent_proof(&state->binder, &proof);
+	KUNIT_EXPECT_EQ(test, ret, -EPROTO);
+	KUNIT_EXPECT_EQ(test, proof.exact, 0U);
+}
+
 static void mt6797_binder_one_shot_test(struct kunit *test)
 {
 	struct mt6797_binder_test_state *state = test->priv;
@@ -928,6 +1077,7 @@ static struct kunit_case mt6797_binder_test_cases[] = {
 #ifdef CONFIG_ARM64_MT6797_A72_P30E_WIRE
 	KUNIT_CASE(mt6797_binder_p30e_readback_test),
 #endif
+	KUNIT_CASE(mt6797_binder_parent_proof_test),
 	KUNIT_CASE(mt6797_binder_one_shot_test),
 	{}
 };
