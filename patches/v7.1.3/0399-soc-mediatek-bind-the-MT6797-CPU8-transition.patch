+	memset(binder, 0, sizeof(*binder));
+	binder->backend = backend;
+	atomic_set(&binder->transition.consumed, 0);
+	atomic_set(&binder->transition.lifecycle,
+		   MT6797_A72_TRANSITION_LIFECYCLE_IDLE);
+	atomic_set(&binder->boot_claimed, 0);
+}
