+	int ret;
+
+	mutex_lock(&mt6797_a72_binder_publish_lock);
+	binder = mt6797_a72_binder_ready();
+	if (binder)
+		ret = binder->backend->membership_validate(cpu, tasks_frozen,
+							   target);
+	else
+		ret = -EAGAIN;
+	mutex_unlock(&mt6797_a72_binder_publish_lock);
