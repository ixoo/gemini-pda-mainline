 		ret = mt6797_a72_binder_test_failure(&state->binder, 8, -EIO,
 					     &publish_p32);
 		KUNIT_ASSERT_EQ(test, ret, 0);
@@ -851,6 +857,8 @@ static void mt6797_binder_p30e_readback_test(struct kunit *test)
