From 144c3d5c9f535821b0bba9d639f624fd3446bbe6 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 28 Aug 2026 00:31:00 +0000
Subject: [PATCH 1/1] arm64: mediatek: move MT6797 A72 owner KUnit state off
 stack

Allocate one KUnit-managed scratch object per owner case.

Keep large observations, transactions, and snapshots off the 16 KiB arm64 task stack after QEMU exposed deterministic overflow.
---
 .../arm64/kernel/mt6797_a72_membership_test.c | 768 +++++++++---------
 1 file changed, 370 insertions(+), 398 deletions(-)

diff --git a/arch/arm64/kernel/mt6797_a72_membership_test.c b/arch/arm64/kernel/mt6797_a72_membership_test.c
index a6a404d..6e35af3 100644
--- a/arch/arm64/kernel/mt6797_a72_membership_test.c
+++ b/arch/arm64/kernel/mt6797_a72_membership_test.c
@@ -17,12 +17,19 @@ struct owner_observation {
 	struct arm64_late_cpu_startup_snapshot p30;
 };
 
+struct mt6797_a72_owner_test_state {
+	struct owner_observation before;
+	struct owner_observation after;
+	struct mt6797_a72_transaction transaction;
+	struct mt6797_a72_owner_snapshot snapshot;
+};
+
+static const struct mt6797_a72_transaction mt6797_a72_empty_transaction;
+
 static bool
 mt6797_a72_transaction_empty(const struct mt6797_a72_transaction *transaction)
 {
-	const struct mt6797_a72_transaction empty = { };
-
-	return !memcmp(transaction, &empty, sizeof(empty));
+	return !memchr_inv(transaction, 0, sizeof(*transaction));
 }
 
 static struct mt6797_a72_entry_snapshot
@@ -136,101 +143,100 @@ expect_unchanged(struct kunit *test,
 
 static int mt6797_a72_owner_test_init(struct kunit *test)
 {
-	(void)test;
+	struct mt6797_a72_owner_test_state *state;
+
+	state = kunit_kzalloc(test, sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	test->priv = state;
 	mt6797_a72_membership_test_reset();
 	return 0;
 }
 
