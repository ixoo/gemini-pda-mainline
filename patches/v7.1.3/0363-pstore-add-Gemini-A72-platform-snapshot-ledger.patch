From 1f63d62083637c81f3ed1f0904f65adcb94c8dce Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 25 Aug 2026 00:11:00 +0000
Subject: [PATCH 1/4] pstore: add Gemini A72 platform-snapshot ledger

Bracket one stable platform-state snapshot with exact first-dmesg records, signature-last commit, full readback, two-write ceiling, and no clear or retry.
---
 fs/pstore/Kconfig                            | 28 +++++++++++++++++++-
 fs/pstore/gemini_protected_readback_ledger.c | 18 ++++++++++---
 2 files changed, 42 insertions(+), 4 deletions(-)

diff --git a/fs/pstore/Kconfig b/fs/pstore/Kconfig
index 2a6e9e8..937ac01 100644
--- a/fs/pstore/Kconfig
+++ b/fs/pstore/Kconfig
@@ -265,6 +265,32 @@ config PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION
 	  call, owner registration, CPU request, storage, reset, or power action.
 	  If unsure, say N.
 
+config PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER
+	bool "Gemini A72 platform-snapshot retained ledger"
+	depends on PSTORE_GEMINI_PROTECTED_READBACK_LEDGER=y
+	depends on MTK_MT6797_A72_PLATFORM_SNAPSHOT_OBSERVER=y
+	depends on !PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER
+	depends on !PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER
+	depends on !PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER
+	depends on !PSTORE_GEMINI_A72_PHYSICAL_SOURCE_PRECAPTURE_LEDGER
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_PROBE_GATE_LEDGER
+	depends on !PSTORE_GEMINI_CLOCK_BACKEND_ENTRY_LEDGER
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_RAW_ENTRY_LEDGER
+	depends on !PSTORE_GEMINI_PROTECTED_READBACK_FIRST_DMESG_WRITE_QUALIFICATION
+	depends on !PSTORE_GEMINI_CLOCK_BACKEND_FIRST_DMESG_ENTRY_QUALIFICATION
+	depends on !PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION
+	default n
+	help
+	  Give the candidate-only platform-snapshot observer one retained record
+	  immediately before its first platform read and one only after one stable
+	  two-sample result. Require both raw headers to be all ones before writing.
+
+	  Reuse the qualified signature-last, full-readback, two-write, no-clear,
+	  and no-retry protocol. This mode adds no storage, register-data write,
+	  provider, clock, BigiDVFS, owner, publisher, or CPU action. If unsure,
+	  say N.
+
 config PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER
 	bool "Gemini A72 physical-source retained ledger"
 	depends on PSTORE_GEMINI_PROTECTED_READBACK_LEDGER=y
@@ -367,7 +393,7 @@ config PSTORE_GEMINI_PROTECTED_READBACK_LEDGER
 	bool "Gemini protected-readback retained call ledger"
 	depends on PSTORE_RAM=y
 	depends on ARM64 && ARCH_MEDIATEK && OF
-	depends on MTK_MT6797_PROTECTED_READBACK_OBSERVER=y || MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y || MTK_MT6797_DVFSP_CLOCK_BACKEND=y || PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL=y
+	depends on MTK_MT6797_PROTECTED_READBACK_OBSERVER=y || MTK_MT6797_A72_PLATFORM_SNAPSHOT_OBSERVER=y || MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y || MTK_MT6797_DVFSP_CLOCK_BACKEND=y || PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL=y
 	depends on !PSTORE_GEMINI_PRE_RAMOOPS_LEDGER
 	depends on !PSTORE_GEMINI_ARM64_ENTRY_LEDGER
 	default n
diff --git a/fs/pstore/gemini_protected_readback_ledger.c b/fs/pstore/gemini_protected_readback_ledger.c
index ea0a836..888aebf 100644
--- a/fs/pstore/gemini_protected_readback_ledger.c
+++ b/fs/pstore/gemini_protected_readback_ledger.c
@@ -17,6 +17,7 @@
 #if defined(CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_FIRST_DMESG_WRITE_QUALIFICATION) || \
 	defined(CONFIG_PSTORE_GEMINI_CLOCK_BACKEND_FIRST_DMESG_ENTRY_QUALIFICATION) || \
 	defined(CONFIG_PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION) || \
+	defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_PRECAPTURE_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER) || \
@@ -147,7 +148,16 @@ static void gemini_prb_capture_map_control(void __iomem *ledger)
 
 static bool gemini_prb_armed;
 
-#ifdef CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER
+#ifdef CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER
+static const char * const gemini_prb_records[] = {
+	"====0.000000-D\n"
+	"GEMINI_A72_PLATFORM_SNAPSHOT_V1 token=GAPS-20260824-A "
+	"checkpoint=before-platform slot=1 crc32=a8bf2262\n",
+	"====0.000000-D\n"
+	"GEMINI_A72_PLATFORM_SNAPSHOT_V1 token=GAPS-20260824-A "
+	"checkpoint=after-platform slot=2 crc32=ca566ccf\n",
+};
+#elif defined(CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER)
 static const char * const gemini_prb_records[] = {
 	"====0.000000-D\n"
 	"GEMINI_A72_EARLY_INIT_V1 token=GAEI-20260824-A "
@@ -260,7 +270,8 @@ static bool gemini_prb_slot_empty(void __iomem *slot)
 
 static bool gemini_prb_slot_available(void __iomem *slot)
 {
-#if defined(CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER) || \
+#if defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER) || \
+	defined(CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_PRECAPTURE_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER) || \
@@ -309,7 +320,8 @@ static bool gemini_prb_write(void __iomem *slot, const char *record)
 	writel(len, (u8 __iomem *)slot + 4);
 	wmb(); /* Commit start before size. */
 	writel(len, (u8 __iomem *)slot + 8);
-#if defined(CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER) || \
+#if defined(CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER) || \
+	defined(CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_PRECAPTURE_LEDGER) || \
 	defined(CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER) || \
