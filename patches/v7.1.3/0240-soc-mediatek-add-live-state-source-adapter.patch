From 0000000000000000000000000000000000000240 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 10 Aug 2026 04:30:00 -0400
Subject: [PATCH] soc: mediatek: add live state source adapter

Define the dormant source boundary for the live MT6797 transition state. A
provider must return one shared generation with the owner and transition
handles, echo the calibrated provenance, and supply each cluster's current
frequency, OPP, clock state, rail state, and policy floor/ceiling. The adapter
compares the frequency to the protected clock sample and the three physical
PPM tables, compares raw VPROC/VSRAM codes to the protected CSPM sample, and
uses only the reviewed pure code-to-microvolt converters.

The state owner continues to hold the outer transition lock while invoking
this callback. No callback is registered here, and this patch performs no
MMIO, regulator or clock operation, secure call, provider registration,
device boot, or CPU8/CPU9 admission. It is experiment-only and not
submission-ready.
---
 drivers/soc/mediatek/Makefile                         |   1 +
 drivers/soc/mediatek/mt6797-dvfsp-live-source.c      | 167 +++++++++++++++++
 include/linux/soc/mediatek/mt6797-dvfsp-live-source.h |  63 +++++++
 3 files changed, 231 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-dvfsp-live-source.c
 create mode 100644 include/linux/soc/mediatek/mt6797-dvfsp-live-source.h

diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -4,6 +4,7 @@ obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-source-backends.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-ptp.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-source.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-identity-source.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-ppm-source.o
+obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-live-source.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-state-owner-arbitration.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_HANDOFF) += mt6797-dvfsp-resource-owner.o
 obj-$(CONFIG_MTK_MT6797_DVFSP_RESOURCE_OWNER) += mt6797-dvfsp-resource-provider.o

diff --git a/include/linux/soc/mediatek/mt6797-dvfsp-live-source.h b/include/linux/soc/mediatek/mt6797-dvfsp-live-source.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6797-dvfsp-live-source.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_MEDIATEK_MT6797_DVFSP_LIVE_SOURCE_H
+#define __LINUX_SOC_MEDIATEK_MT6797_DVFSP_LIVE_SOURCE_H
+
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-cspm-state.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-ppm.h>
+#include <linux/soc/mediatek/mt6797-dvfsp-state-source.h>
+
+#define MT6797_DVFSP_LIVE_SOURCE_ADAPTER_ABI	1
+#define MT6797_DVFSP_LIVE_SOURCE_CLUSTER_COUNT	4
+
+/* One callback result for a cluster, with no default or inferred field. */
+struct mt6797_dvfsp_live_source_cluster {
+	u32 state_flags;
+	u32 opp_id;
+	u32 frequency_khz;
+	u32 vproc_code;
+	u32 vsram_code;
+	u32 vproc_uv;
+	u32 vsram_uv;
+	u32 floor_khz;
+	u32 ceiling_khz;
+	u32 clock_state;
+	u32 rail_state;
+};
+
+struct mt6797_dvfsp_live_source_ops {
+	u32 abi;
+
+	/* Called while the state owner's outer transition lock is held. */
+	int (*read_generation)(void *context,
+				       const struct mt6797_dvfsp_clock_state *clock,
+				       const struct mt6797_dvfsp_calibration_state *calibration,
+				       const struct mt6797_dvfsp_cspm_state *cspm,
+				       const struct mt6797_dvfsp_ppm_snapshot *ppm,
+				       u64 *generation, u64 *owner_handle,
+				       u64 *transition_handle,
+				       struct mt6797_dvfsp_state_provenance *provenance);
+	int (*read_cluster)(void *context, unsigned int cluster,
+				   const struct mt6797_dvfsp_clock_state *clock,
+				   const struct mt6797_dvfsp_calibration_state *calibration,
+				   const struct mt6797_dvfsp_cspm_state *cspm,
+				   const struct mt6797_dvfsp_ppm_snapshot *ppm,
+				   struct mt6797_dvfsp_live_source_cluster *state);
+};
+
+/* Device and provider references remain borrowed by the caller. */
+struct mt6797_dvfsp_live_source {
+	const struct mt6797_dvfsp_live_source_ops *ops;
+	void *context;
+};
+
+/* Populate the existing state-owner fill_live callback; never registers it. */
+int mt6797_dvfsp_live_source_fill(
+	void *context, const struct mt6797_dvfsp_clock_state *clock,
+	const struct mt6797_dvfsp_calibration_state *calibration,
+	const struct mt6797_dvfsp_cspm_state *cspm,
+	const struct mt6797_dvfsp_ppm_snapshot *ppm,
+	struct mt6797_dvfsp_state_source_live *live);
+
+#endif /* __LINUX_SOC_MEDIATEK_MT6797_DVFSP_LIVE_SOURCE_H */

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-live-source.c b/drivers/soc/mediatek/mt6797-dvfsp-live-source.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-dvfsp-live-source.c
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Adapt explicit live clock/rail callbacks to the dormant state-source seam.
+ *
+ * No I/O occurs here. The caller owns the outer transition lock and supplies
+ * samples that were captured under the same owner generation.
+ */
+
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <linux/soc/mediatek/mt6797-dvfsp-live-source.h>
+
+static const u32 mt6797_dvfsp_live_ppm_cluster[] = {
+	MT6797_DVFSP_PPM_CLUSTER_LL,
+	MT6797_DVFSP_PPM_CLUSTER_L,
+	MT6797_DVFSP_PPM_CLUSTER_B,
+};
+
+static int mt6797_dvfsp_live_source_check(
+	const struct mt6797_dvfsp_live_source *source)
+{
+	if (!source || !source->ops ||
+	    source->ops->abi != MT6797_DVFSP_LIVE_SOURCE_ADAPTER_ABI ||
+	    !source->ops->read_generation || !source->ops->read_cluster)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int mt6797_dvfsp_live_frequency_check(
+	const struct mt6797_dvfsp_clock_state *clock,
+	const struct mt6797_dvfsp_ppm_snapshot *ppm,
+	unsigned int cluster, u32 frequency_khz)
+{
+	unsigned int row;
+
+	if (!frequency_khz ||
+	    frequency_khz != clock->cluster[cluster].frequency_khz)
+		return -EAGAIN;
+
+	if (cluster == MT6797_DVFSP_PPM_CLUSTER_COUNT)
+		return 0;
+
+	for (row = 0; row < MT6797_DVFSP_PPM_TABLE_ENTRIES; row++)
+		if (ppm->cluster[mt6797_dvfsp_live_ppm_cluster[cluster]]
+			    .frequency_khz[row] == frequency_khz)
+			return 0;
+
+	return -EAGAIN;
+}
+
+static int mt6797_dvfsp_live_cluster_check(
+	const struct mt6797_dvfsp_clock_state *clock,
+	const struct mt6797_dvfsp_calibration_state *calibration,
+	const struct mt6797_dvfsp_cspm_state *cspm,
+	const struct mt6797_dvfsp_ppm_snapshot *ppm, unsigned int cluster,
+	struct mt6797_dvfsp_live_source_cluster *state)
+{
+	u32 vproc_uv;
+	u32 vsram_uv;
+	int ret;
+
+	if (!state || cluster >= MT6797_DVFSP_LIVE_SOURCE_CLUSTER_COUNT ||
+	    state->state_flags &
+	    ~(MT6797_DVFSP_STATE_FLAG_PRESENT | MT6797_DVFSP_STATE_FLAG_ON) ||
+	    !(state->state_flags & MT6797_DVFSP_STATE_FLAG_PRESENT) ||
+	    !state->floor_khz || !state->ceiling_khz ||
+	    state->floor_khz > state->ceiling_khz ||
+	    state->frequency_khz < state->floor_khz ||
+    state->frequency_khz > state->ceiling_khz)
+		return -EPROTO;
+
+	ret = mt6797_dvfsp_live_frequency_check(clock, ppm, cluster,
+						state->frequency_khz);
+	if (ret)
+		return ret;
+
+	if (state->vproc_code != cspm->cluster[cluster].voltage_code ||
+	    state->vsram_code != cspm->cluster[cluster].vsram_code)
+		return -EAGAIN;
+	ret = mt6797_dvfsp_cspm_vproc_code_to_uv(state->vproc_code,
+						&vproc_uv);
+	if (ret)
+		return ret;
+	ret = mt6797_dvfsp_cspm_vsram_code_to_uv(state->vsram_code,
+						&vsram_uv);
+	if (ret)
+		return ret;
+
+	if (cluster < MT6797_DVFSP_PPM_CLUSTER_COUNT &&
+	    calibration->cluster[cluster].table_count == 0)
+		return -EPROTO;
+
+	state->vproc_uv = vproc_uv;
+	state->vsram_uv = vsram_uv;
+	return 0;
+}
+
+int mt6797_dvfsp_live_source_fill(
+	void *context, const struct mt6797_dvfsp_clock_state *clock,
+	const struct mt6797_dvfsp_calibration_state *calibration,
+	const struct mt6797_dvfsp_cspm_state *cspm,
+	const struct mt6797_dvfsp_ppm_snapshot *ppm,
+	struct mt6797_dvfsp_state_source_live *live)
+{
+	struct mt6797_dvfsp_live_source *source = context;
+	struct mt6797_dvfsp_live_source_cluster state;
+	u64 generation;
+	u64 owner_handle;
+	u64 transition_handle;
+	unsigned int cluster;
+	int ret;
+
+	if (!clock || !calibration || !cspm || !ppm || !live)
+		return -EINVAL;
+	ret = mt6797_dvfsp_live_source_check(source);
+	if (ret)
+		return ret;
+
+	memset(live, 0, sizeof(*live));
+	memset(&state, 0, sizeof(state));
+	ret = source->ops->read_generation(source->context, clock,
+						calibration, cspm, ppm, &generation,
+						&owner_handle, &transition_handle,
+						&live->provenance);
+	if (ret)
+		return ret;
+	if (!generation || !owner_handle || !transition_handle ||
+	    memcmp(&live->provenance, &calibration->provenance,
+		   sizeof(live->provenance)) ||
+	    generation != calibration->source_generation)
+		return -EAGAIN;
+
+	live->generation = generation;
+	live->owner_handle = owner_handle;
+	live->transition_handle = transition_handle;
+	for (cluster = 0; cluster < MT6797_DVFSP_LIVE_SOURCE_CLUSTER_COUNT;
+	     cluster++) {
+		memset(&state, 0, sizeof(state));
+		ret = source->ops->read_cluster(source->context, cluster, clock,
+						calibration, cspm, ppm, &state);
+		if (ret)
+			return ret;
+		ret = mt6797_dvfsp_live_cluster_check(clock, calibration, cspm,
+						ppm, cluster, &state);
+		if (ret)
+			return ret;
+		live->state_flags[cluster] = state.state_flags;
+		live->opp_id[cluster] = state.opp_id;
+		live->frequency_khz[cluster] = state.frequency_khz;
+		live->voltage_uv[cluster] = state.vproc_uv;
+		live->vsram_uv[cluster] = state.vsram_uv;
+		live->floor_khz[cluster] = state.floor_khz;
+		live->ceiling_khz[cluster] = state.ceiling_khz;
+		live->clock_state[cluster] = state.clock_state;
+		live->rail_state[cluster] = state.rail_state;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_dvfsp_live_source_fill);
+
+MODULE_DESCRIPTION("MT6797 live clock and rail source adapter");
+MODULE_LICENSE("GPL");
-- 
2.43.0
