From 46eb5a76533262733c155228aa544c9323badeb1 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 3 Sep 2026 12:02:00 +0000
Subject: [PATCH 2/2] soc: mediatek: test disconnected A72 hotplug binder core

Cover exact parent linkage, same-task and one-shot ownership,
ordered checkpoints, precommit rejection, postcommit and restore
faults, terminal publication, and injected operation counts.
---
 drivers/soc/mediatek/Kconfig                  |  13 +
 drivers/soc/mediatek/Makefile                 |   1 +
 .../mt6797-a72-hotplug-binder-core-test.c     | 486 ++++++++++++++++++
 3 files changed, 500 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-a72-hotplug-binder-core-test.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index 9ee605e..0ddd473 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -831,6 +831,19 @@ config MTK_MT6797_A72_HOTPLUG_BINDER_CORE
 	  CPU, PSCI, MMIO, watchdog, retained-memory, network, storage, or device
 	  operation. If unsure, say N.
 
+config MTK_MT6797_A72_HOTPLUG_BINDER_CORE_KUNIT_TEST
+	bool "KUnit tests for the MT6797 A72 hotplug binder core"
+	depends on KUNIT=y
+	depends on MTK_MT6797_A72_HOTPLUG_BINDER_CORE
+	default n
+	help
+	  Exercise same-task ownership, exact parent/down/restore validation,
+	  checkpoint ordering, precommit rejection, postcommit fault handling,
+	  terminal publication, and one-shot behavior with injected operations.
+
+	  These tests issue no CPU request, PSCI, MMIO, retained-memory,
+	  watchdog, network, storage, or device action. If unsure, say N.
+
 config MTK_MT6797_A72_CPU8_OBSERVER
 	bool "MediaTek MT6797 retained-CPU8 hotplug observer"
 	depends on SMP
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
