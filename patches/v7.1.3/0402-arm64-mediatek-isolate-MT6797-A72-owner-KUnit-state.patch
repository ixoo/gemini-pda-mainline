From 371f9e3f0285bd076bf88d1fdfec19294b7699c2 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 28 Aug 2026 00:51:00 +0000
Subject: [PATCH 1/1] arm64: mediatek: isolate MT6797 A72 owner KUnit state

Reset the coupled P30 fixture whenever membership state is reseeded.

Keep PSCI-hook expectations valid with or without the default-off binder.
---
 .../arm64/kernel/mt6797_a72_membership_test.c | 66 +++++++++++++------
 1 file changed, 45 insertions(+), 21 deletions(-)

diff --git a/arch/arm64/kernel/mt6797_a72_membership_test.c b/arch/arm64/kernel/mt6797_a72_membership_test.c
index 6e35af3..c9ede08 100644
--- a/arch/arm64/kernel/mt6797_a72_membership_test.c
+++ b/arch/arm64/kernel/mt6797_a72_membership_test.c
@@ -141,6 +141,24 @@ expect_unchanged(struct kunit *test,
 	KUNIT_EXPECT_EQ(test, difference, 0);
 }
 
+static void mt6797_a72_owner_reset_state(void)
+{
+	arm64_late_cpu_startup_test_reset();
+	mt6797_a72_membership_test_reset();
+}
+
+static void mt6797_a72_owner_seed_available(void)
+{
+	arm64_late_cpu_startup_test_reset();
+	mt6797_a72_membership_test_seed_available();
+}
+
+static void mt6797_a72_owner_seed_available_cpu9(void)
+{
+	arm64_late_cpu_startup_test_reset();
+	mt6797_a72_membership_test_seed_available_cpu9();
+}
+
 static int mt6797_a72_owner_test_init(struct kunit *test)
 {
 	struct mt6797_a72_owner_test_state *state;
@@ -149,7 +167,7 @@ static int mt6797_a72_owner_test_init(struct kunit *test)
 	if (!state)
 		return -ENOMEM;
 	test->priv = state;
-	mt6797_a72_membership_test_reset();
+	mt6797_a72_owner_reset_state();
 	return 0;
 }
 
@@ -246,7 +264,9 @@ static void mt6797_a72_owner_public_hook_denied(struct kunit *test)
 	ret = mt6797_psci_ops.cpu_up_preflight(9, CPUHP_ONLINE);
 	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
 	ret = mt6797_psci_ops.cpu_up_preflight(8, CPUHP_AP_ONLINE);
-	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	KUNIT_EXPECT_EQ(test, ret,
+			IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER) ?
+				-EAGAIN : -EINVAL);
 	owner_observe(&state->after);
 	expect_unchanged(test, &state->before, &state->after);
 }
@@ -267,9 +287,13 @@ static void mt6797_a72_owner_internal_hook_denied(struct kunit *test)
 	ret = mt6797_psci_ops.cpu_up_validate(9, 0, CPUHP_ONLINE);
 	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
 	ret = mt6797_psci_ops.cpu_up_validate(8, 1, CPUHP_ONLINE);
-	KUNIT_EXPECT_EQ(test, ret, -EPERM);
+	KUNIT_EXPECT_EQ(test, ret,
+			IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER) ?
+				-EAGAIN : -EPERM);
 	ret = mt6797_psci_ops.cpu_up_validate(9, 0, CPUHP_AP_ONLINE);
-	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	KUNIT_EXPECT_EQ(test, ret,
+			IS_ENABLED(CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER) ?
+				-EAGAIN : -EINVAL);
 	owner_observe(&state->after);
 	expect_unchanged(test, &state->before, &state->after);
 }
