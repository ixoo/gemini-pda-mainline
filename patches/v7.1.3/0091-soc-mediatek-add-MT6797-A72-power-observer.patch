From 0000000000000000000000000000000000000091 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 21 Jul 2026 20:18:00 -0400
Subject: [PATCH] soc: mediatek: add MT6797 A72 power observer

The MT6797 Cortex-A72 cluster is not brought up by PSCI alone.  Before
requesting CPU_ON, the working 3.18 kernel coordinates an external DA9214
rail, TOPRGU PWRAP reset, SPM isolation, MCUCFG DCM, and private
secure-firmware services.  Its optional dynamic voltage path additionally
uses DVFSP arbitration and the iDVFS APB bridge.

Add the minimum resource description and a deliberately read-only
observer driver.  It acquires the fixed-voltage path resources, reads a
fixed snapshot, and exposes observer state and snapshot attributes.  It
does not assert reset, enable a regulator, write MMIO, issue an SMC, or
register a CPU-hotplug callback.  In particular, observer resource
availability is never reported as authorization to start an A72.

Make the existing legacy MT6797 SCPSYS node a syscon as well as a power-domain
provider so the observer can share its SPM register window without claiming a
duplicate resource.  Enable the observer only on Gemini, where BUCKB is wired
as the big-cluster Vproc supply.

This is an evidence gate, not Cortex-A72 support.  A following patch installs
a rejecting CPU-method gate for CPU8 and CPU9, while the diagnostic
configuration retains maxcpus=8.

---
 .../power/mediatek,mt6797-scpsys.yaml         |   6 +-
 .../soc/mediatek/mediatek,mt6797-a72-power.yaml |  67 ++++++
 .../boot/dts/mediatek/mt6797-gemini-pda.dts   |   5 +
 arch/arm64/boot/dts/mediatek/mt6797.dtsi      |  12 +-
 drivers/soc/mediatek/Kconfig                  |  15 ++
 drivers/soc/mediatek/Makefile                 |   1 +
 drivers/soc/mediatek/mt6797-a72-power.c       | 242 +++++++++++++++++++++
 7 files changed, 345 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/mediatek,mt6797-scpsys.yaml b/Documentation/devicetree/bindings/power/mediatek,mt6797-scpsys.yaml
--- a/Documentation/devicetree/bindings/power/mediatek,mt6797-scpsys.yaml
+++ b/Documentation/devicetree/bindings/power/mediatek,mt6797-scpsys.yaml
@@ -21,7 +21,9 @@ properties:
     pattern: '^power-controller(@[0-9a-f]+)?$'
 
   compatible:
-    const: mediatek,mt6797-scpsys
+    items:
+      - const: mediatek,mt6797-scpsys
+      - const: syscon
 
   reg:
     maxItems: 1
@@ -65,6 +67,6 @@ examples:
 
         scpsys: power-controller@10006000 {
-            compatible = "mediatek,mt6797-scpsys";
+            compatible = "mediatek,mt6797-scpsys", "syscon";
             #power-domain-cells = <1>;
             reg = <0 0x10006000 0 0x1000>;
             infracfg = <&infracfg>;
diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-power.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-power.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-power.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-a72-power.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 Cortex-A72 cluster power coordination
+
+maintainers:
+  - Gemini Mainline Experiment <gemini-mainline@example.invalid>
+
+description: |
+  The MT6797 Cortex-A72 cluster requires coordination between the external
+  processor regulator, SPM isolation, MCUCFG clock controls, TOPRGU reset,
+  and secure firmware before PSCI can start a CPU in that cluster.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-a72-power
+
+  reg:
+    maxItems: 1
+    description: MCUCFG2 and big-cluster DCM registers.
+
+  mediatek,spm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the MT6797 SCPSYS/SPM syscon.
+
+  cpus:
+    minItems: 2
+    maxItems: 2
+    description: Phandles to the two CPUs powered through this resource path.
+
+  vproc-big-supply:
+    description: External processor supply for the Cortex-A72 cluster.
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: pwrap
+
+required:
+  - compatible
+  - reg
+  - mediatek,spm
+  - cpus
+  - vproc-big-supply
+  - resets
+  - reset-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/reset/mt6797-resets.h>
+
+    a72-power@10222000 {
+        compatible = "mediatek,mt6797-a72-power";
+        reg = <0x10222000 0x1000>;
+        mediatek,spm = <&scpsys>;
+        cpus = <&cpu8>, <&cpu9>;
+        vproc-big-supply = <&da9214_buckb>;
+        resets = <&watchdog MT6797_TOPRGU_PWRAP_SPI_CTL_RST>;
+        reset-names = "pwrap";
+    };
+...
diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -248,6 +248,11 @@ da9214_buckb: BUCKB {
 	};
 };
 
+&a72_power {
+	vproc-big-supply = <&da9214_buckb>;
+	status = "okay";
+};
+
 &i2c7 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c7_pins_a>;
diff --git a/arch/arm64/boot/dts/mediatek/mt6797.dtsi b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
--- a/arch/arm64/boot/dts/mediatek/mt6797.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
@@ -312,7 +312,7 @@ pio: pinctrl@10005000 {
 	};
 
 	scpsys: power-controller@10006000 {
-		compatible = "mediatek,mt6797-scpsys";
+		compatible = "mediatek,mt6797-scpsys", "syscon";
 		#power-domain-cells = <1>;
 		reg = <0 0x10006000 0 0x1000>;
 		clocks = <&topckgen CLK_TOP_MUX_MFG>,
@@ -323,6 +323,16 @@ scpsys: power-controller@10006000 {
 		infracfg = <&infrasys>;
 	};
 
+	a72_power: a72-power@10222000 {
+		compatible = "mediatek,mt6797-a72-power";
+		reg = <0 0x10222000 0 0x1000>;
+		mediatek,spm = <&scpsys>;
+		cpus = <&cpu8>, <&cpu9>;
+		resets = <&watchdog MT6797_TOPRGU_PWRAP_SPI_CTL_RST>;
+		reset-names = "pwrap";
+		status = "disabled";
+	};
+
 	mfgsys: syscon@13000000 {
 		compatible = "mediatek,mt6797-mfgsys", "syscon";
 		reg = <0 0x13000000 0 0x1000>;
diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -34,6 +34,21 @@ config MTK_INFRACFG
 	  INFRACFG controller contains various infrastructure registers not
 	  directly associated to any device.
 
+config MTK_MT6797_A72_POWER
+	bool "MediaTek MT6797 Cortex-A72 power resource observer"
+	depends on ARM64 && ARCH_MEDIATEK && OF
+	depends on REGULATOR && RESET_CONTROLLER
+	select MFD_SYSCON
+	help
+	  Build the resource observer for the MT6797 Cortex-A72 cluster power
+	  path.  It verifies that the external processor regulator, TOPRGU
+	  reset, SPM syscon, and MCUCFG resources are available and publishes
+	  a read-only snapshot in sysfs.
+
+	  This initial implementation never changes power state and never
+	  authorizes CPU_ON.  It is groundwork for a later provider that can
+	  reproduce the hardware power sequence.
+
 config MTK_PMIC_WRAP
 	tristate "MediaTek PMIC Wrapper Support"
 	depends on RESET_CONTROLLER
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -4,6 +4,7 @@ obj-$(CONFIG_MTK_CMDQ) += mtk-cmdq-helper.o
 obj-$(CONFIG_MTK_DEVAPC) += mtk-devapc.o
 obj-$(CONFIG_MTK_DVFSRC) += mtk-dvfsrc.o
 obj-$(CONFIG_MTK_INFRACFG) += mtk-infracfg.o
+obj-$(CONFIG_MTK_MT6797_A72_POWER) += mt6797-a72-power.o
 obj-$(CONFIG_MTK_PMIC_WRAP) += mtk-pmic-wrap.o
 obj-$(CONFIG_MTK_REGULATOR_COUPLER) += mtk-regulator-coupler.o
 obj-$(CONFIG_MTK_MMSYS) += mtk-mmsys.o
diff --git a/drivers/soc/mediatek/mt6797-a72-power.c b/drivers/soc/mediatek/mt6797-a72-power.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-a72-power.c
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only MT6797 Cortex-A72 power resource observer
+ *
+ * Copyright (c) 2026 Julien Etienne
+ */
+
+#include <linux/cpu.h>
+#include <linux/cpumask.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/reset.h>
+#include <linux/mfd/syscon.h>
+
+#define SPM_POWERON_CONFIG_EN		0x218
+#define SPM_EXT_BUCK_ISO		0x290
+
+#define MCUCFG_MP2_SYNC_DCM		0x274
+#define MCUCFG_BIG_ARMPLL_CON0		0x4a0
+
+struct mt6797_a72_power {
+	struct regulator *vproc_big;
+	struct reset_control *pwrap_reset;
+	struct regmap *spm;
+	void __iomem *mcucfg;
+	int vproc_enabled;
+	int vproc_uv;
+	u32 spm_poweron_config;
+	u32 spm_ext_buck_iso;
+	u32 mp2_sync_dcm;
+	u32 big_armpll_con0;
+	unsigned int cpus[2];
+	cpumask_t cpu_mask;
+	bool resources_ready;
+};
+
+static ssize_t ready_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	return sysfs_emit(buf, "0\n");
+}
+static DEVICE_ATTR_RO(ready);
+
+static ssize_t resources_ready_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct mt6797_a72_power *power = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", power->resources_ready);
+}
+static DEVICE_ATTR_RO(resources_ready);
+
+static ssize_t abi_show(struct device *dev, struct device_attribute *attr,
+			char *buf)
+{
+	return sysfs_emit(buf, "observer-v1\n");
+}
+static DEVICE_ATTR_RO(abi);
+
+static ssize_t hooks_armed_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "0\n");
+}
+static DEVICE_ATTR_RO(hooks_armed);
+
+static ssize_t provider_mode_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "observe-only\n");
+}
+static DEVICE_ATTR_RO(provider_mode);
+
+static ssize_t snapshot_show(struct device *dev,
+			     struct device_attribute *attr, char *buf)
+{
+	struct mt6797_a72_power *power = dev_get_drvdata(dev);
+	ssize_t len = 0;
+
+	len += sysfs_emit_at(buf, len, "cpus=%u,%u pwrap_reset_acquired=1\n",
+			     power->cpus[0], power->cpus[1]);
+	len += sysfs_emit_at(buf, len, "vproc_enabled=%d vproc_uv=%d\n",
+			     power->vproc_enabled, power->vproc_uv);
+	len += sysfs_emit_at(buf, len, "spm_poweron=0x%08x spm_ext_buck_iso=0x%08x\n",
+			     power->spm_poweron_config,
+			     power->spm_ext_buck_iso);
+	len += sysfs_emit_at(buf, len, "mp2_sync_dcm=0x%08x big_armpll=0x%08x\n",
+			     power->mp2_sync_dcm, power->big_armpll_con0);
+
+	return len;
+}
+static DEVICE_ATTR_RO(snapshot);
+
+static struct attribute *mt6797_a72_power_attrs[] = {
+	&dev_attr_ready.attr,
+	&dev_attr_resources_ready.attr,
+	&dev_attr_abi.attr,
+	&dev_attr_hooks_armed.attr,
+	&dev_attr_provider_mode.attr,
+	&dev_attr_snapshot.attr,
+	NULL,
+};
+
+static const struct attribute_group mt6797_a72_power_group = {
+	.attrs = mt6797_a72_power_attrs,
+};
+
+static int mt6797_a72_power_snapshot(struct mt6797_a72_power *power)
+{
+	int ret;
+
+	power->vproc_enabled = regulator_is_enabled(power->vproc_big);
+	if (power->vproc_enabled < 0)
+		return power->vproc_enabled;
+
+	power->vproc_uv = regulator_get_voltage(power->vproc_big);
+	if (power->vproc_uv < 0)
+		return power->vproc_uv;
+
+	ret = regmap_read(power->spm, SPM_POWERON_CONFIG_EN,
+			  &power->spm_poweron_config);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(power->spm, SPM_EXT_BUCK_ISO,
+			  &power->spm_ext_buck_iso);
+	if (ret)
+		return ret;
+
+	power->mp2_sync_dcm = readl(power->mcucfg + MCUCFG_MP2_SYNC_DCM);
+	power->big_armpll_con0 = readl(power->mcucfg + MCUCFG_BIG_ARMPLL_CON0);
+
+	return 0;
+}
+
+static int mt6797_a72_power_parse_cpus(struct device *dev,
+				       struct mt6797_a72_power *power)
+{
+	struct device_node *cpu_node;
+	int count;
+	int cpu;
+	int i;
+
+	count = of_count_phandle_with_args(dev->of_node, "cpus", NULL);
+	if (count != ARRAY_SIZE(power->cpus))
+		return dev_err_probe(dev, -EINVAL,
+				     "expected exactly two CPU phandles\n");
+
+	cpumask_clear(&power->cpu_mask);
+	for (i = 0; i < count; i++) {
+		cpu_node = of_parse_phandle(dev->of_node, "cpus", i);
+		if (!cpu_node)
+			return dev_err_probe(dev, -EINVAL,
+					     "failed to parse CPU phandle %d\n", i);
+		cpu = of_cpu_node_to_id(cpu_node);
+		of_node_put(cpu_node);
+		if (cpu < 0 || cpu >= nr_cpu_ids)
+			return dev_err_probe(dev, -EINVAL,
+					     "invalid logical CPU for phandle %d\n", i);
+		if (cpumask_test_and_set_cpu(cpu, &power->cpu_mask))
+			return dev_err_probe(dev, -EINVAL,
+					     "duplicate CPU phandle %d\n", i);
+		power->cpus[i] = cpu;
+	}
+
+	return 0;
+}
+
+static int mt6797_a72_power_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6797_a72_power *power;
+	int ret;
+
+	power = devm_kzalloc(dev, sizeof(*power), GFP_KERNEL);
+	if (!power)
+		return -ENOMEM;
+
+	ret = mt6797_a72_power_parse_cpus(dev, power);
+	if (ret)
+		return ret;
+
+	power->vproc_big = devm_regulator_get_exclusive(dev, "vproc-big");
+	if (IS_ERR(power->vproc_big))
+		return dev_err_probe(dev, PTR_ERR(power->vproc_big),
+				     "failed to get big-cluster regulator\n");
+
+	power->pwrap_reset = devm_reset_control_get_exclusive(dev, "pwrap");
+	if (IS_ERR(power->pwrap_reset))
+		return dev_err_probe(dev, PTR_ERR(power->pwrap_reset),
+				     "failed to get PWRAP reset\n");
+
+	power->spm = syscon_regmap_lookup_by_phandle(dev->of_node,
+						   "mediatek,spm");
+	if (IS_ERR(power->spm))
+		return dev_err_probe(dev, PTR_ERR(power->spm),
+				     "failed to get SPM syscon\n");
+
+	power->mcucfg = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(power->mcucfg))
+		return PTR_ERR(power->mcucfg);
+
+	ret = mt6797_a72_power_snapshot(power);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read resource snapshot\n");
+
+	power->resources_ready = true;
+	platform_set_drvdata(pdev, power);
+	ret = devm_device_add_group(dev, &mt6797_a72_power_group);
+	if (ret)
+		return ret;
+
+	dev_info(dev,
+		 "observer resources ready: vproc=%duV enabled=%d; CPU_ON denied\n",
+		 power->vproc_uv, power->vproc_enabled);
+
+	return 0;
+}
+
+static const struct of_device_id mt6797_a72_power_of_match[] = {
+	{ .compatible = "mediatek,mt6797-a72-power" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6797_a72_power_of_match);
+
+static struct platform_driver mt6797_a72_power_driver = {
+	.probe = mt6797_a72_power_probe,
+	.driver = {
+		.name = "mt6797-a72-power",
+		.of_match_table = mt6797_a72_power_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(mt6797_a72_power_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6797 Cortex-A72 power resource observer");
+MODULE_LICENSE("GPL");
-- 
2.43.0
