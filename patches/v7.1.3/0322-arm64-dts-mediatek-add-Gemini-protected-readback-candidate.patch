From ef547e6ff822784429fc06facfeeb2dd3bffec5a Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 21 Aug 2026 23:33:00 +0000
Subject: [PATCH 3/3] arm64: dts: mediatek: add Gemini protected readback
 candidate

Add a separate Gemini DTB derivative that enables only the two protected readback transports and their bounded one-shot observer.

Leave the base Gemini DTB, transition owner, and CPU8/CPU9 admission unchanged.
---
 arch/arm64/boot/dts/mediatek/Makefile         |  1 +
 .../mt6797-gemini-pda-protected-readback.dts  | 25 +++++++++++++++++++
 2 files changed, 26 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-protected-readback.dts

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index f8f578c..c18cdbc 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -6,6 +6,7 @@ dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-gemini-pda.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-gemini-pda-protected-readback.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-x20-dev.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7622-rfb1.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7622-bananapi-bpi-r64.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-protected-readback.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-protected-readback.dts
new file mode 100644
index 0000000..4f27a68
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-protected-readback.dts
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 Julien Etienne
+ */
+
+#include "mt6797-gemini-pda.dts"
+
+/ {
+	model = "Planet Computers Gemini PDA (protected readback observer)";
+
+	protected-readback-observer {
+		compatible = "mediatek,mt6797-protected-readback-observer";
+		mediatek,clock-backend = <&dvfsp_clock_backend>;
+		mediatek,bigidvfs-backend = <&dvfsp_bigidvfs_backend>;
+		status = "okay";
+	};
+};
+
+&dvfsp_clock_backend {
+	status = "okay";
+};
+
+&dvfsp_bigidvfs_backend {
+	status = "okay";
+};
