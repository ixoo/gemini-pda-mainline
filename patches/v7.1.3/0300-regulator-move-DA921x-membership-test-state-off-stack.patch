From bff6f876db4e7677686428887ab014620836562a Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 20 Aug 2026 20:06:00 +0000
Subject: [PATCH 1/1] regulator: move DA921x membership test state off stack

Allocate one KUnit-managed state object per case.

Keep large owner snapshots out of the arm64 kernel stack.
---
 .../regulator/da9213-legacy-membership-test.c | 340 ++++++++++--------
 1 file changed, 191 insertions(+), 149 deletions(-)

diff --git a/drivers/regulator/da9213-legacy-membership-test.c b/drivers/regulator/da9213-legacy-membership-test.c
index 3325a76..5146d14 100644
--- a/drivers/regulator/da9213-legacy-membership-test.c
+++ b/drivers/regulator/da9213-legacy-membership-test.c
@@ -46,6 +46,18 @@ struct da9213_membership_synthetic {
 	u8 release_entry_abort_budget;
 	bool release_entry_handle_exact;
 	struct mt6797_a72_provider_handle handle;
+	struct mt6797_a72_owner_snapshot snapshot;
+};
+
+struct da9213_membership_test_state {
+	struct da9213_legacy_provider_endpoint endpoint;
+	struct da9213_membership_fake fake;
+	struct da9213_membership_synthetic synthetic;
+	struct mt6797_a72_provider_response response;
+	struct mt6797_a72_p29_rollback_proof rollback;
+	struct mt6797_a72_owner_snapshot snapshot;
+	struct mt6797_a72_transaction stale;
+	struct mt6797_a72_transaction transaction;
 };
 
 static struct da9213_membership_fake *active_fake;
@@ -362,18 +374,18 @@ da9213_membership_synthetic_release(void *context,
 				    struct mt6797_a72_provider_response *response)
 {
 	struct da9213_membership_synthetic *synthetic = context;
-	struct mt6797_a72_owner_snapshot snapshot;
 
 	synthetic->release_calls++;
-	mt6797_a72_membership_snapshot(&snapshot);
-	synthetic->release_entry_provider_state = snapshot.provider_state;
+	mt6797_a72_membership_snapshot(&synthetic->snapshot);
+	synthetic->release_entry_provider_state = synthetic->snapshot.provider_state;
 	synthetic->release_entry_abort_budget =
-		snapshot.active.budgets.provider_abort;
+		synthetic->snapshot.active.budgets.provider_abort;
 	synthetic->release_entry_handle_exact =
-		snapshot.provider_identity.generation == handle->generation &&
-		snapshot.provider_identity.cookie == handle->cookie &&
-		snapshot.active.provider_identity.generation == handle->generation &&
-		snapshot.active.provider_identity.cookie == handle->cookie;
+		synthetic->snapshot.provider_identity.generation == handle->generation &&
+		synthetic->snapshot.provider_identity.cookie == handle->cookie &&
+		synthetic->snapshot.active.provider_identity.generation ==
+			handle->generation &&
+		synthetic->snapshot.active.provider_identity.cookie == handle->cookie;
 	*response = (struct mt6797_a72_provider_response) {
 		.abi = MT6797_A72_PROVIDER_CALL_ABI,
 		.returned = 1,
@@ -417,116 +429,143 @@ static void da9213_membership_unregister_synthetic(void)
 	registered_synthetic = NULL;
 }
 
-static void expect_fault(struct kunit *test, u32 cause)
+static int
+da9213_membership_register_state(struct da9213_membership_test_state *state)
 {
-	struct mt6797_a72_owner_snapshot snapshot;
+	return da9213_membership_register_endpoint(&state->endpoint,
+						    &state->fake);
+}
+
+static int
+da9213_membership_run_acquire(struct da9213_membership_test_state *state)
+{
+	return mt6797_a72_membership_run_provider_acquire(&state->transaction,
+							 &state->response);
+}
+
+static int
+da9213_membership_run_abort(struct da9213_membership_test_state *state)
+{
+	return mt6797_a72_membership_run_provider_abort(&state->transaction,
+						       &state->response);
+}
+
+static int
+da9213_membership_complete_p29(struct da9213_membership_test_state *state)
+{
+	return mt6797_a72_membership_complete_p29_rollback(&state->transaction,
+							  &state->rollback);
+}
 
-	mt6797_a72_membership_snapshot(&snapshot);
-	KUNIT_EXPECT_EQ(test, snapshot.health,
+static void expect_fault(struct kunit *test,
+			 struct mt6797_a72_owner_snapshot *snapshot, u32 cause)
+{
+	mt6797_a72_membership_snapshot(snapshot);
+	KUNIT_EXPECT_EQ(test, snapshot->health,
 			(u32)MT6797_A72_OWNER_FAULTED);
-	KUNIT_EXPECT_EQ(test, snapshot.phase, (u32)MT6797_A72_PHASE_FAULT);
-	KUNIT_EXPECT_EQ(test, snapshot.provider_state,
+	KUNIT_EXPECT_EQ(test, snapshot->phase, (u32)MT6797_A72_PHASE_FAULT);
+	KUNIT_EXPECT_EQ(test, snapshot->provider_state,
 			(u32)MT6797_A72_PROVIDER_FAULT_UNKNOWN);
-	KUNIT_EXPECT_TRUE(test, snapshot.first_fault.valid);
-	KUNIT_EXPECT_EQ(test, snapshot.first_fault.cause, cause);
-	KUNIT_EXPECT_EQ(test, snapshot.active.budgets.provider_acquire,
+	KUNIT_EXPECT_TRUE(test, snapshot->first_fault.valid);
+	KUNIT_EXPECT_EQ(test, snapshot->first_fault.cause, cause);
+	KUNIT_EXPECT_EQ(test, snapshot->active.budgets.provider_acquire,
 			(u8)MT6797_A72_BUDGET_CONSUMED);
 }
 
