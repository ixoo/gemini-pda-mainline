index 000000000000..000000000000
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-clock-backend.yaml
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-dvfsp-clock-backend.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 protected CPU clock readback transport
+
+description: |
+  The MT6797 LL/L/CCI CPU PLL and divider window is shared by Linux, SPM,
+  and ATF. This optional transport describes the MCUMIXED and CSPM windows
+  plus the I2C_APPM clock needed by the documented hardware semaphore. The
+  node is disabled unless a separately reviewed experiment enables it. The
+  transport is read-only with respect to CPU clock state and is not a clock
+  provider, DVFSP state owner, regulator, or B-cluster secure backend.
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+properties:
+  compatible:
+    const: mediatek,mt6797-dvfsp-clock-backend
+
+  reg:
+    items:
+      - description: MCUMIXED CPU PLL and divider window
+      - description: CSPM semaphore and internal clock window
+
+  reg-names:
+    items:
+      - const: mcumixed
+      - const: cspm
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: i2c
+
+  status:
+    enum: [ disabled, okay ]
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+      dvfsp_clock_backend: dvfsp-clock-backend@1001a000 {
+        compatible = "mediatek,mt6797-dvfsp-clock-backend";
+        reg = <0 0x1001a000 0 0x1000>,
+              <0 0x11015000 0 0x1000>;
+        reg-names = "mcumixed", "cspm";
+        clocks = <&infrasys CLK_INFRA_I2C_APPM>;
+        clock-names = "i2c";
+        status = "disabled";
+      };
+    };
diff --git a/arch/arm64/boot/dts/mediatek/mt6797.dtsi b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
--- a/arch/arm64/boot/dts/mediatek/mt6797.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
@@ -674,5 +674,15 @@
 		mediatek,infracfg = <&infrasys>;
 		status = "disabled";
 	};
+
+	dvfsp_clock_backend: dvfsp-clock-backend@1001a000 {
+		compatible = "mediatek,mt6797-dvfsp-clock-backend";
+		reg = <0 0x1001a000 0 0x1000>,
+		      <0 0x11015000 0 0x1000>;
+		reg-names = "mcumixed", "cspm";
+		clocks = <&infrasys CLK_INFRA_I2C_APPM>;
+		clock-names = "i2c";
+		status = "disabled";
+	};
 
 	i2c7: i2c@11010000 {
diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -88,4 +88,20 @@ config MTK_MT6797_DVFSP_HANDOFF
 
 	This option is for bounded Gemini PDA bring-up experiments only.
 
+config MTK_MT6797_DVFSP_CLOCK_BACKEND
+	bool "MediaTek MT6797 protected CPU clock readback transport"
+	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
+	select MTK_INFRACFG
+	help
+	  Build the disabled-only MCUMIXED/DVFSP transport used to read the
+	  MT6797 LL/L/CCI CPU clock window under its documented CSPM hardware
+	  semaphore. The helper has a bounded acquire/release path and turns
+	  a timeout or release failure into a sticky fault.
+
+	  This transport does not write a CPU PLL, divider, regulator, or
+	  SRAM-LDO; it does not call the secure monitor, load firmware, or
+	  register a DVFSP state owner or clock provider. Its Device Tree
+	  node is disabled by default and the B-cluster BigiDVFS path remains
+	  separate.
+
 config MTK_PMIC_WRAP
