diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-clock-backend.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-dvfsp-clock-backend.yaml
