diff --git a/arch/arm64/kernel/late_cpu_profile.c b/arch/arm64/kernel/late_cpu_profile.c
new file mode 100644
index 000000000..c611c2846
--- /dev/null
+++ b/arch/arm64/kernel/late_cpu_profile.c
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Fail-closed arm64 profile for CPUs expected after capability finalization.
+ *
+ * A profile callback must complete every fallible check before prepare()
+ * returns success. A successful profile is then committed infallibly by its
+ * architecture owner before normal system capability and alternatives setup.
+ * This lifecycle attests that work; it does not admit a CPU_ON request.
+ */
+
+#define pr_fmt(fmt) "arm64-late-cpu-profile: " fmt
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/panic.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+
+#include <asm/late_cpu_profile.h>
+
+static struct arm64_late_cpu_profile late_profile __initdata;
+static bool late_profile_active __initdata;
+static cpumask_t late_profile_targets __initdata;
+static bool late_profile_registration_fault __initdata;
+
+static struct arm64_late_cpu_attestation late_attestation __ro_after_init = {
+	.abi = ARM64_LATE_CPU_ATTESTATION_ABI,
+	.state = ARM64_LATE_CPU_PROFILE_NONE,
+};
+
+static void __init late_profile_block(u64 blockers, const char *reason)
+{
+	if (!late_attestation.profile_id[0])
+		strscpy(late_attestation.profile_id, "invalid-registration",
+			sizeof(late_attestation.profile_id));
+	late_attestation.blocker_mask |= blockers;
+	/* Publish the complete blocker record before exposing BLOCKED. */
+	smp_store_release(&late_attestation.state,
+			  ARM64_LATE_CPU_PROFILE_BLOCKED);
+	pr_warn("%.*s blocked: %s (proof mask %#llx)\n",
+		ARM64_LATE_CPU_PROFILE_ID_LEN, late_attestation.profile_id, reason,
+		late_attestation.blocker_mask);
+}
+
+static bool __init
+late_profile_identity_matches(const struct arm64_late_cpu_attestation *before,
+			      const struct arm64_late_cpu_attestation *after)
+{
+	return before->abi == after->abi &&
+	       !memcmp(before->profile_id, after->profile_id,
+		       sizeof(before->profile_id)) &&
+	       cpumask_equal(&before->target_cpus, &after->target_cpus) &&
+	       !memcmp(before->source_parent_identity,
+		       after->source_parent_identity,
+		       sizeof(before->source_parent_identity)) &&
+	       !memcmp(before->config_input_identity,
+		       after->config_input_identity,
+		       sizeof(before->config_input_identity)) &&
+	       !memcmp(before->evidence_identity, after->evidence_identity,
+		       sizeof(before->evidence_identity)) &&
+	       !memcmp(before->expected_target_mpidr,
+		       after->expected_target_mpidr,
+		       sizeof(before->expected_target_mpidr)) &&
+	       !memcmp(before->expected_target_midr,
+		       after->expected_target_midr,
+		       sizeof(before->expected_target_midr)) &&
+	       !memcmp(before->observed_target_midr,
+		       after->observed_target_midr,
+		       sizeof(before->observed_target_midr)) &&
+	       !memcmp(before->observed_target_revidr,
+		       after->observed_target_revidr,
+		       sizeof(before->observed_target_revidr)) &&
+	       bitmap_equal(before->required_local_caps,
+			    after->required_local_caps, ARM64_NCAPS) &&
+	       before->blocker_mask == after->blocker_mask &&
+	       before->ctr_raw == after->ctr_raw &&
+	       before->ctr_effective == after->ctr_effective &&
+	       !memcmp(before->expected_elf_hwcap,
+		       after->expected_elf_hwcap,
+		       sizeof(before->expected_elf_hwcap)) &&
+	       before->expected_compat_hwcap == after->expected_compat_hwcap &&
+	       before->expected_compat_hwcap2 == after->expected_compat_hwcap2 &&
+	       before->smccc_wa1 == after->smccc_wa1 &&
+	       before->smccc_wa2 == after->smccc_wa2 &&
+	       before->asid_bits == after->asid_bits &&
+	       before->page_shift == after->page_shift &&
+	       before->va_bits == after->va_bits &&
+	       before->bhb_method == after->bhb_method &&
+	       before->bhb_loop_count == after->bhb_loop_count &&
+	       before->gic_sre_usable == after->gic_sre_usable &&
+	       before->strict_caps_verified == after->strict_caps_verified &&
+	       !memcmp(before->observed_target_registers_valid,
+		       after->observed_target_registers_valid,
+		       sizeof(before->observed_target_registers_valid)) &&
+	       before->smccc_wa1_valid == after->smccc_wa1_valid &&
+	       before->smccc_wa2_valid == after->smccc_wa2_valid &&
+	       before->cookie == after->cookie;
+}
+
+static bool __init
+late_profile_descriptor_matches(const struct arm64_late_cpu_profile *profile)
+{
+	return profile && profile->name && profile->prepare &&
+	       strnlen(profile->name, ARM64_LATE_CPU_PROFILE_ID_LEN) <
+		       ARM64_LATE_CPU_PROFILE_ID_LEN &&
+	       late_profile_active &&
+	       !strcmp(late_profile.name, profile->name) &&
+	       late_profile.target_count == profile->target_count &&
+	       late_profile.prepare == profile->prepare &&
+	       late_profile.verify_system == profile->verify_system &&
+	       late_profile.finalize_user == profile->finalize_user;
+}
+
+static bool __init
+late_profile_core_matches(const struct arm64_late_cpu_attestation *draft)
+{
+	return draft->abi == ARM64_LATE_CPU_ATTESTATION_ABI &&
+	       draft->state == ARM64_LATE_CPU_PROFILE_REGISTERED &&
+	       !memcmp(draft->profile_id, late_attestation.profile_id,
+		       sizeof(draft->profile_id)) &&
+	       cpumask_equal(&draft->target_cpus, &late_profile_targets) &&
+	       !draft->strict_caps_verified &&
+	       !draft->alternatives_finalized &&
+	       !draft->user_hwcaps_finalized;
+}
+
+void __init
+arm64_activate_late_cpu_profile(const struct arm64_late_cpu_profile *profile)
+{
+	if (!profile || !profile->name || !profile->prepare ||
+	    !profile->target_count ||
+	    profile->target_count > ARM64_LATE_CPU_MAX_TARGETS) {
+		late_profile_registration_fault = true;
+		return;
+	}
+
+	if (!late_profile_active) {
+		if (strscpy(late_attestation.profile_id, profile->name,
+			    sizeof(late_attestation.profile_id)) < 0) {
+			late_profile_registration_fault = true;
+			return;
+		}
+		late_profile = *profile;
+		late_profile.name = late_attestation.profile_id;
+		late_profile_active = true;
+		WRITE_ONCE(late_attestation.state,
+			   ARM64_LATE_CPU_PROFILE_REGISTERED);
+	} else if (!late_profile_descriptor_matches(profile)) {
+		late_profile_registration_fault = true;
+	}
+}
+
+void __init
+arm64_register_late_cpu_target(const struct arm64_late_cpu_profile *profile,
+			       unsigned int cpu)
+{
+	if (!late_profile_descriptor_matches(profile) || cpu >= nr_cpu_ids) {
+		late_profile_registration_fault = true;
+		return;
+	}
+
+	if (cpumask_test_and_set_cpu(cpu, &late_profile_targets))
+		late_profile_registration_fault = true;
+}
+
+void __init arm64_prepare_late_cpu_profile(void)
+{
+	struct arm64_late_cpu_attestation draft;
+	int ret;
+
+	if (!late_profile_active && !late_profile_registration_fault)
+		return;
+
+	if (late_profile_registration_fault) {
+		late_profile_block(ARM64_LATE_CPU_BLOCK_REGISTRATION,
+				   "registration identity changed");
+		return;
+	}
+	if (cpumask_weight(&late_profile_targets) != late_profile.target_count) {
+		cpumask_copy(&late_attestation.target_cpus,
+			     &late_profile_targets);
+		late_profile_block(ARM64_LATE_CPU_BLOCK_REGISTRATION,
+				   "target registrations are incomplete");
+		return;
+	}
+
+	if (READ_ONCE(late_attestation.state) !=
+	    ARM64_LATE_CPU_PROFILE_REGISTERED) {
+		late_profile_block(ARM64_LATE_CPU_BLOCK_REGISTRATION,
+				   "invalid prepare state");
+		return;
+	}
+
+	cpumask_copy(&late_attestation.target_cpus, &late_profile_targets);
+	draft = late_attestation;
+	ret = late_profile.prepare(&draft, &late_profile_targets);
+	if (!late_profile_core_matches(&draft)) {
+		late_profile_block(ARM64_LATE_CPU_BLOCK_CAP_INVENTORY,
+				   "prepare altered core identity");
+		return;
+	}
+	if (ret || draft.blocker_mask) {
+		u64 blockers = draft.blocker_mask ?:
+			       ARM64_LATE_CPU_BLOCK_CAP_INVENTORY;
+
+		late_attestation = draft;
+		late_profile_block(blockers,
+				   "required evidence is incomplete");
+		return;
+	}
+	if (!draft.cookie) {
+		late_profile_block(ARM64_LATE_CPU_BLOCK_CAP_INVENTORY,
+				   "prepared identity is incomplete");
+		return;
+	}
+
+	late_attestation = draft;
+	/* Publish the complete plan before exposing PREPARED. */
+	smp_store_release(&late_attestation.state,
+			  ARM64_LATE_CPU_PROFILE_PREPARED);
+	pr_info("%s prepared with cookie %#llx\n",
+		late_attestation.profile_id, late_attestation.cookie);
+}
+
+void __init arm64_verify_late_cpu_profile_system(void)
+{
+	struct arm64_late_cpu_attestation before;
+	struct arm64_late_cpu_attestation draft;
+	int ret;
+
+	if (READ_ONCE(late_attestation.state) == ARM64_LATE_CPU_PROFILE_BLOCKED)
+		return;
+	if (!late_profile_active)
+		return;
+
+	if (READ_ONCE(late_attestation.state) !=
+	    ARM64_LATE_CPU_PROFILE_PREPARED || !late_profile.verify_system)
+		panic("late CPU profile reached system finalization out of order");
+
+	before = late_attestation;
+	draft = before;
+	ret = late_profile.verify_system(&draft);
+	if (ret || draft.state != ARM64_LATE_CPU_PROFILE_PREPARED ||
+	    draft.blocker_mask ||
+	    !late_profile_identity_matches(&before, &draft) ||
+	    draft.alternatives_finalized || draft.user_hwcaps_finalized)
+		panic("late CPU profile system verification failed: %d", ret);
+
+	late_attestation = draft;
+	late_attestation.strict_caps_verified = 1;
+	late_attestation.alternatives_finalized = 1;
+	/* Publish the system assertions before exposing SYSTEM_VERIFIED. */
+	smp_store_release(&late_attestation.state,
+			  ARM64_LATE_CPU_PROFILE_SYSTEM_VERIFIED);
+}
+
+void __init arm64_finalize_late_cpu_profile_user(void)
+{
+	struct arm64_late_cpu_attestation before;
+	struct arm64_late_cpu_attestation draft;
+	int ret;
+
+	if (READ_ONCE(late_attestation.state) == ARM64_LATE_CPU_PROFILE_BLOCKED)
+		return;
+	if (!late_profile_active)
+		return;
+
+	if (READ_ONCE(late_attestation.state) !=
+	    ARM64_LATE_CPU_PROFILE_SYSTEM_VERIFIED ||
+	    !late_profile.finalize_user)
+		panic("late CPU profile reached user finalization out of order");
+
+	before = late_attestation;
+	draft = before;
+	ret = late_profile.finalize_user(&draft);
+	if (ret || draft.state != ARM64_LATE_CPU_PROFILE_SYSTEM_VERIFIED ||
+	    draft.blocker_mask ||
+	    !late_profile_identity_matches(&before, &draft) ||
+	    !draft.strict_caps_verified || !draft.alternatives_finalized ||
+	    draft.user_hwcaps_finalized)
+		panic("late CPU profile user verification failed: %d", ret);
+
+	late_attestation = draft;
+	late_attestation.user_hwcaps_finalized = 1;
+	/* Publish every user feature assertion before exposing READY. */
+	smp_store_release(&late_attestation.state,
+			  ARM64_LATE_CPU_PROFILE_READY);
+	pr_info("%s ready with cookie %#llx\n",
+		late_attestation.profile_id, late_attestation.cookie);
+}
+
+const struct arm64_late_cpu_attestation *
+arm64_get_late_cpu_attestation(void)
+{
+	/* A36 consumers may observe the record only after READY publication. */
+	if (smp_load_acquire(&late_attestation.state) !=
+	    ARM64_LATE_CPU_PROFILE_READY)
+		return NULL;
+
+	return &late_attestation;
+}
diff --git a/arch/arm64/kernel/smp.c b/arch/arm64/kernel/smp.c
index 1aa324104..6f760ec29 100644
--- a/arch/arm64/kernel/smp.c
+++ b/arch/arm64/kernel/smp.c
@@ -44,6 +44,7 @@
 #include <asm/cpu_ops.h>
 #include <asm/daifflags.h>
 #include <asm/kvm_mmu.h>
+#include <asm/late_cpu_profile.h>
 #include <asm/mmu_context.h>
 #include <asm/numa.h>
 #include <asm/processor.h>
@@ -439,8 +440,11 @@ void __init smp_cpus_done(unsigned int max_cpus)
 {
 	pr_info("SMP: Total of %d processors activated.\n", num_online_cpus());
 	hyp_mode_check();
+	arm64_prepare_late_cpu_profile();
 	setup_system_features();
+	arm64_verify_late_cpu_profile_system();
 	setup_user_features();
+	arm64_finalize_late_cpu_profile_user();
 	mark_linear_text_alias_ro();
 }
 
