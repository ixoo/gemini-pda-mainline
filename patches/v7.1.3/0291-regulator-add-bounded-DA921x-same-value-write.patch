From e94a983222cb31eca85f4dd610bf07367fbba6ea Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 20 Aug 2026 00:02:00 +0000
Subject: [PATCH 2/3] regulator: add bounded DA921x same-value write

Run the exact twelve-transfer Gate-6 action under one root lock.

Stop without retry or inverse write on every error or mismatch.
---
 drivers/regulator/Kconfig                     |  14 +
 drivers/regulator/da9213-legacy-regulator.c   | 328 +++++++++++++++++-
 .../regulator/da9213-legacy-write-contract.h  |  47 +++
 3 files changed, 388 insertions(+), 1 deletion(-)
 create mode 100644 drivers/regulator/da9213-legacy-write-contract.h

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index 845d9e6..60e140b 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -474,6 +474,20 @@ config REGULATOR_DA9213_LEGACY_RUNTIME_PREFLIGHT
 	  write, PAGE_CON access, consumer, retry, firmware-owner claim, or CPU
 	  action. Say N outside the named Gemini runtime experiment.
 
+config REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE
+	bool "Dialog legacy DA921x one-shot same-value write"
+	depends on REGULATOR_DA9213_LEGACY_RUNTIME_PREFLIGHT
+	depends on I2C_MT65XX_GEMINI_ENTRY_LEDGER
+	help
+	  Replace the read-only runtime trigger with one exact-token Gate-6
+	  action. Under one root-adapter lock it verifies the exact 20-entry
+	  startup ledger, forces retries to zero, performs five exact preflight
+	  reads, writes [0xda, 0x46] once, and performs six exact readbacks.
+
+	  Every mismatch stops without retry, inverse write, PAGE_CON access,
+	  regulator consumer, or CPU request. This option is only for the named
+	  Gemini same-value-write experiment and must remain N otherwise.
+
 config REGULATOR_DA9213_LEGACY_OBSERVER_KUNIT_TEST
 	bool "KUnit tests for the legacy DA921x read-only observer"
 	depends on KUNIT=y
diff --git a/drivers/regulator/da9213-legacy-regulator.c b/drivers/regulator/da9213-legacy-regulator.c
index 2f1893e..17c1072 100644
--- a/drivers/regulator/da9213-legacy-regulator.c
+++ b/drivers/regulator/da9213-legacy-regulator.c
@@ -7,13 +7,17 @@
  * transcript; it never exposes a writable regulator operation or A72 consumer.
  */
 
+#include <linux/cpu.h>
+#include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/i2c-mt65xx-gemini-ledger.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/regulator/driver.h>
 
 #include "da9213-legacy-observer.h"
+#include "da9213-legacy-write-contract.h"
 #if IS_ENABLED(CONFIG_ARM64_MT6797_A72_PROVIDER_OWNER)
 #include <linux/mt6797-a72-provider.h>
 #endif
@@ -96,6 +100,9 @@ struct da9213_legacy {
 	enum da9213_legacy_preflight_state runtime_preflight_state;
 	unsigned int runtime_preflight_attempts;
 	int runtime_preflight_error;
+#if IS_ENABLED(CONFIG_REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE)
+	struct da9213_legacy_same_value_result same_value_result;
+#endif
 #endif
 #endif
 #endif
@@ -462,6 +469,320 @@ static void da9213_legacy_preflight_publish(struct da9213_legacy *chip)
 		 (unsigned int)safe_prestate);
 }
 
+#if IS_ENABLED(CONFIG_REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE)
+const char *da9213_legacy_same_value_state_name(enum da9213_legacy_same_value_state state)
+{
+	switch (state) {
+	case DA9213_LEGACY_SAME_VALUE_IDLE:
+		return "idle";
+	case DA9213_LEGACY_SAME_VALUE_RUNNING:
+		return "running";
+	case DA9213_LEGACY_SAME_VALUE_PASSED:
+		return "passed";
+	case DA9213_LEGACY_SAME_VALUE_FAILED_NO_WRITE:
+		return "failed-no-write";
+	case DA9213_LEGACY_SAME_VALUE_FAULTED:
+		return "faulted-no-further-i2c";
+	default:
+		return "invalid";
+	}
+}
+
+int da9213_legacy_same_value_admit(struct da9213_legacy_same_value_result *result,
+				   bool token_valid, bool preconditions_valid)
+{
+	if (!result || !token_valid)
+		return -EINVAL;
+	if (result->state != DA9213_LEGACY_SAME_VALUE_IDLE)
+		return -EALREADY;
+
+	result->attempts = 1;
+	if (!preconditions_valid) {
+		result->state = DA9213_LEGACY_SAME_VALUE_FAILED_NO_WRITE;
+		result->error = -EPROTO;
+		return -EPROTO;
+	}
+
+	result->state = DA9213_LEGACY_SAME_VALUE_RUNNING;
+	return 0;
+}
+
+static int da9213_legacy_same_value_read(struct i2c_adapter *adapter,
+					 u16 address, u8 reg, u8 *value,
+	const struct da9213_legacy_same_value_ops *ops,
+	struct da9213_legacy_same_value_result *result)
+{
+	struct i2c_msg messages[2] = { };
+	u8 data = 0;
+	int ret;
+
+	messages[0].addr = address;
+	messages[0].len = 1;
+	messages[0].buf = &reg;
+	messages[1].addr = address;
+	messages[1].flags = I2C_M_RD;
+	messages[1].len = 1;
+	messages[1].buf = &data;
+
+	ret = ops->transfer(adapter, messages, ARRAY_SIZE(messages));
+	result->action_transfers++;
+	if (ret < 0)
+		return ret;
+	if (ret != ARRAY_SIZE(messages))
+		return -EIO;
+
+	*value = data;
+	return 0;
+}
+
+static int da9213_legacy_same_value_write(struct i2c_adapter *adapter,
+					  u16 address,
+				     const struct da9213_legacy_same_value_ops *ops,
+	struct da9213_legacy_same_value_result *result)
+{
+	u8 payload[2] = { 0xda, 0x46 };
+	struct i2c_msg message = {
+		.addr = address,
+		.len = ARRAY_SIZE(payload),
+		.buf = payload,
+	};
+	int ret;
+
+	result->write_attempts = 1;
+	ret = ops->transfer(adapter, &message, 1);
+	result->action_transfers++;
+	if (ret < 0)
+		return ret;
+	if (ret != 1)
+		return -EIO;
+
+	return 0;
+}
+
+int da9213_legacy_same_value_execute(struct i2c_adapter *adapter, u16 address,
+				     const struct da9213_legacy_same_value_ops *ops,
+				     struct da9213_legacy_same_value_result *result)
+{
+	static const u8 preflight_regs[] = { 0x56, 0x51, 0x5e, 0xd9, 0xda };
+	static const u8 preflight_expected[] = { 0x7b, 0xc1, 0x00, 0x46, 0x46 };
+	static const u8 poststate_regs[] = { 0x56, 0x51, 0x5e, 0xd9 };
+	static const u8 poststate_expected[] = { 0x7b, 0xc1, 0x00, 0x46 };
+	unsigned int saved_retries = 0;
+	bool retries_saved = false;
+	unsigned int i;
+	int ret;
+
+	if (!adapter || !ops || !ops->verify_ledger || !ops->transfer ||
+	    !ops->delay || !result ||
+	    result->state != DA9213_LEGACY_SAME_VALUE_RUNNING ||
+	    !adapter->lock_ops || !adapter->lock_ops->lock_bus ||
+	    !adapter->lock_ops->unlock_bus)
+		return -EINVAL;
+
+	i2c_lock_bus(adapter, I2C_LOCK_ROOT_ADAPTER);
+	ret = ops->verify_ledger(adapter);
+	if (ret)
+		goto out_finish;
+
+	saved_retries = adapter->retries;
+	retries_saved = true;
+	adapter->retries = 0;
+
+	for (i = 0; i < ARRAY_SIZE(preflight_regs); i++) {
+		ret = da9213_legacy_same_value_read(adapter, address,
+						    preflight_regs[i], &result->preflight[i],
+						    ops, result);
+		if (ret)
+			goto out_restore;
+		if (result->preflight[i] != preflight_expected[i]) {
+			ret = -ERANGE;
+			goto out_restore;
+		}
+	}
+
+	ret = da9213_legacy_same_value_write(adapter, address, ops, result);
+	if (ret)
+		goto out_restore;
+
+	ret = da9213_legacy_same_value_read(adapter, address, 0xda,
+					    &result->immediate_readback, ops, result);
+	if (ret)
+		goto out_restore;
+	if (result->immediate_readback != 0x46) {
+		ret = -ERANGE;
+		goto out_restore;
+	}
+
+	ops->delay(10000, 11000);
+	ret = da9213_legacy_same_value_read(adapter, address, 0xda,
+					    &result->delayed_readback, ops, result);
+	if (ret)
+		goto out_restore;
+	if (result->delayed_readback != 0x46) {
+		ret = -ERANGE;
+		goto out_restore;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(poststate_regs); i++) {
+		ret = da9213_legacy_same_value_read(adapter, address,
+						    poststate_regs[i], &result->poststate[i],
+						    ops, result);
+		if (ret)
+			goto out_restore;
+		if (result->poststate[i] != poststate_expected[i]) {
+			ret = -ERANGE;
+			goto out_restore;
+		}
+	}
+
+	ret = 0;
+
+out_restore:
+	adapter->retries = saved_retries;
+out_finish:
+	if (retries_saved && adapter->retries != saved_retries)
+		adapter->retries = saved_retries;
+	result->error = ret;
+	if (!ret)
+		result->state = DA9213_LEGACY_SAME_VALUE_PASSED;
+	else if (!result->write_attempts)
+		result->state = DA9213_LEGACY_SAME_VALUE_FAILED_NO_WRITE;
+	else
+		result->state = DA9213_LEGACY_SAME_VALUE_FAULTED;
+	i2c_unlock_bus(adapter, I2C_LOCK_ROOT_ADAPTER);
+
+	return ret;
+}
+
+#endif
+
+#if IS_ENABLED(CONFIG_REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE)
+#define DA9213_LEGACY_SAME_VALUE_TOKEN \
+	"run-same-value-write-20260819-a"
+
+static const struct mtk_i2c_gemini_read_expectation
+da9213_legacy_startup_ledger[] = {
+	{ 0x69, 0x05 }, { 0x69, 0x06 }, { 0x69, 0x47 },
+	{ 0x68, 0xd3 }, { 0x68, 0x5e }, { 0x68, 0xd9 }, { 0x68, 0xda },
+	{ 0x69, 0x05 }, { 0x69, 0x06 }, { 0x69, 0x47 },
+	{ 0x68, 0xd3 }, { 0x68, 0x5e }, { 0x68, 0xd9 }, { 0x68, 0xda },
+	{ 0x68, 0xd7 }, { 0x68, 0xd9 },
+	{ 0x68, 0xd7 }, { 0x68, 0x5d }, { 0x68, 0xd9 }, { 0x68, 0x5e },
+};
+
+static int da9213_legacy_verify_startup_ledger(struct i2c_adapter *adapter)
+{
+	return mtk_i2c_gemini_verify_read_ledger(adapter,
+					 da9213_legacy_startup_ledger,
+		ARRAY_SIZE(da9213_legacy_startup_ledger));
+}
+
+static const struct da9213_legacy_same_value_ops
+da9213_legacy_same_value_production_ops = {
+	.verify_ledger = da9213_legacy_verify_startup_ledger,
+	.transfer = __i2c_transfer,
+	.delay = usleep_range,
+};
+
+static bool da9213_legacy_same_value_cpu_baseline(void)
+{
+	unsigned int cpu;
+
+	if (nr_cpu_ids <= 9)
+		return false;
+	for (cpu = 0; cpu < 8; cpu++)
+		if (!cpu_online(cpu))
+			return false;
+
+	return !cpu_online(8) && !cpu_online(9) && num_online_cpus() == 8;
+}
+
+static bool da9213_legacy_same_value_preconditions(struct da9213_legacy *chip)
+{
+	return chip->observation.valid &&
+		chip->observation.provider_count == DA9213_LEGACY_BUCK_COUNT &&
+		chip->observation.provider_read_completed == 4 &&
+		!chip->observation.register_data_writes &&
+		chip->phase_reads[DA9213_LEGACY_READ_REGISTRATION] == 2 &&
+		chip->phase_reads[DA9213_LEGACY_READ_OBSERVER] == 4 &&
+		!chip->phase_reads[DA9213_LEGACY_READ_PREFLIGHT] &&
+		da9213_legacy_same_value_cpu_baseline();
+}
+
+static ssize_t same_value_write_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct da9213_legacy *chip = dev_get_drvdata(dev);
+	const struct da9213_legacy_same_value_result *result =
+		&chip->same_value_result;
+	ssize_t len;
+
+	mutex_lock(&chip->runtime_preflight_lock);
+	len = sysfs_emit(buf,
+			 "same_value_write=v1 state=%s attempts=%u last_error=%d\n",
+			 da9213_legacy_same_value_state_name(result->state),
+			 result->attempts, result->error);
+	len += sysfs_emit_at(buf, len,
+			     "action_transfers=%u write_attempts=%u\n",
+			     result->action_transfers, result->write_attempts);
+	len += sysfs_emit_at(buf, len, "trigger_token=%s\n",
+			     DA9213_LEGACY_SAME_VALUE_TOKEN);
+	len += sysfs_emit_at(buf, len,
+			     "preflight=%02x,%02x,%02x,%02x,%02x immediate=%02x ",
+			     result->preflight[0], result->preflight[1],
+			     result->preflight[2], result->preflight[3],
+			     result->preflight[4], result->immediate_readback);
+	len += sysfs_emit_at(buf, len,
+			     "delayed=%02x poststate=%02x,%02x,%02x,%02x\n",
+			     result->delayed_readback, result->poststate[0],
+			     result->poststate[1], result->poststate[2],
+			     result->poststate[3]);
+	len += sysfs_emit_at(buf, len,
+			     "cpu_online=0-7 cpu_offline=8-9 page_con_accesses=0 ");
+	len += sysfs_emit_at(buf, len,
+			     "consumer_requests=0 cpu_requests=0 second_writes=0\n");
+	mutex_unlock(&chip->runtime_preflight_lock);
+
+	return len;
+}
+
+static ssize_t same_value_write_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct da9213_legacy *chip = dev_get_drvdata(dev);
+	bool token_valid = sysfs_streq(buf, DA9213_LEGACY_SAME_VALUE_TOKEN);
+	int ret;
+
+	mutex_lock(&chip->runtime_preflight_lock);
+	ret = da9213_legacy_same_value_admit(&chip->same_value_result,
+					     token_valid,
+					     da9213_legacy_same_value_preconditions(chip));
+	if (!ret)
+		ret = da9213_legacy_same_value_execute(chip->client->adapter,
+						       chip->client->addr,
+						       &da9213_legacy_same_value_production_ops,
+						       &chip->same_value_result);
+	if (!ret)
+		dev_info(chip->dev,
+			 "same-value Gate-6 action passed with 12 transfers\n");
+	mutex_unlock(&chip->runtime_preflight_lock);
+
+	return ret ? ret : count;
+}
+
+static DEVICE_ATTR_RW(same_value_write);
+
+static struct attribute *da9213_legacy_same_value_attrs[] = {
+	&dev_attr_same_value_write.attr,
+	NULL,
+};
+
+static const struct attribute_group da9213_legacy_same_value_group = {
+	.attrs = da9213_legacy_same_value_attrs,
+};
+#endif
+
 #if IS_ENABLED(CONFIG_REGULATOR_DA9213_LEGACY_RUNTIME_PREFLIGHT)
 #define DA9213_LEGACY_RUNTIME_PREFLIGHT_TOKEN \
 	"run-readonly-preflight-20260818-a"
@@ -850,11 +1171,16 @@ out_unlock:
 #endif
 #if IS_ENABLED(CONFIG_REGULATOR_DA9213_LEGACY_RUNTIME_PREFLIGHT)
 	chip->read_phase = DA9213_LEGACY_READ_PHASE_COUNT;
+#if IS_ENABLED(CONFIG_REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE)
+	ret = devm_device_add_group(chip->dev,
+				    &da9213_legacy_same_value_group);
+#else
 	ret = devm_device_add_group(chip->dev,
 				    &da9213_legacy_runtime_preflight_group);
+#endif
 	if (ret)
 		return dev_err_probe(&client->dev, ret,
-				     "failed to add read-only preflight trigger\n");
+				     "failed to add Gate-6 runtime trigger\n");
 #endif
 #if IS_ENABLED(CONFIG_ARM64_MT6797_A72_PROVIDER_OWNER)
 	ret = da9213_legacy_register_owner(chip);
diff --git a/drivers/regulator/da9213-legacy-write-contract.h b/drivers/regulator/da9213-legacy-write-contract.h
new file mode 100644
index 0000000..2e8d019
--- /dev/null
+++ b/drivers/regulator/da9213-legacy-write-contract.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __DA9213_LEGACY_WRITE_CONTRACT_H
+#define __DA9213_LEGACY_WRITE_CONTRACT_H
+
+#include <linux/types.h>
+
+struct i2c_adapter;
+struct i2c_msg;
+
+#define DA9213_LEGACY_SAME_VALUE_PREFLIGHT_COUNT	5
+#define DA9213_LEGACY_SAME_VALUE_POSTSTATE_COUNT	4
+
+enum da9213_legacy_same_value_state {
+	DA9213_LEGACY_SAME_VALUE_IDLE,
+	DA9213_LEGACY_SAME_VALUE_RUNNING,
+	DA9213_LEGACY_SAME_VALUE_PASSED,
+	DA9213_LEGACY_SAME_VALUE_FAILED_NO_WRITE,
+	DA9213_LEGACY_SAME_VALUE_FAULTED,
+};
+
+struct da9213_legacy_same_value_result {
+	enum da9213_legacy_same_value_state state;
+	unsigned int attempts;
+	unsigned int action_transfers;
+	unsigned int write_attempts;
+	int error;
+	u8 preflight[DA9213_LEGACY_SAME_VALUE_PREFLIGHT_COUNT];
+	u8 immediate_readback;
+	u8 delayed_readback;
+	u8 poststate[DA9213_LEGACY_SAME_VALUE_POSTSTATE_COUNT];
+};
+
+struct da9213_legacy_same_value_ops {
+	int (*verify_ledger)(struct i2c_adapter *adapter);
+	int (*transfer)(struct i2c_adapter *adapter,
+			struct i2c_msg *messages, int count);
+	void (*delay)(unsigned long minimum, unsigned long maximum);
+};
+
+const char *da9213_legacy_same_value_state_name(enum da9213_legacy_same_value_state state);
+int da9213_legacy_same_value_admit(struct da9213_legacy_same_value_result *result,
+				   bool token_valid, bool preconditions_valid);
+int da9213_legacy_same_value_execute(struct i2c_adapter *adapter, u16 address,
+				     const struct da9213_legacy_same_value_ops *ops,
+				     struct da9213_legacy_same_value_result *result);
+
+#endif /* __DA9213_LEGACY_WRITE_CONTRACT_H */
