diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index b4f823a..88cf5af 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -498,6 +498,24 @@ config MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER
 	  mutation, CPU request, retry, storage, reset, or power action.
 	  If unsure, say N.
 
+config MTK_MT6797_A72_ADMISSION_CONTROLLER
+	bool "MediaTek MT6797 one-shot CPU8 admission controller"
+	depends on ARM64 && ARCH_MEDIATEK && OF && HOTPLUG_CPU
+	depends on ARM64_MT6797_A72_DERIVED_ADMISSION
+	depends on MTK_MT6797_A72_DEFAULT_OFF_BINDER
+	depends on MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER
+	default n
+	help
+	  Build the candidate-only controller that consumes one boot-local
+	  attempt before owner mutation, derives the CPU8 transaction from
+	  the registered physical source, publishes P17/P18, and makes one
+	  synchronous add_cpu(8) request from the same task.
+
+	  Supplier absence and READY-token refusal happen before consumption.
+	  Every later result is terminal and cannot cause driver-core retry.
+	  The base Gemini Device Tree has no controller or binder node.
+	  If unsure, say N.
+
 config MTK_MT6797_A72_PHYSICAL_SOURCE_KUNIT_TEST
 	bool "KUnit tests for MT6797 A72 direct physical-source observer"
 	depends on KUNIT=y
