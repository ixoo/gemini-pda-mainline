+{
+	const struct mt6797_a72_direct_source_ops *ops =
+		&mt6797_a72_physical_source_ops;
+
+	return mt6797_a72_direct_source_register(ops, context);
+}
+
+void
+mt6797_a72_source_unregister(struct mt6797_a72_physical_source_context *context)
