diff --git a/arch/arm64/include/asm/mt6797_a72_p30e.h b/arch/arm64/include/asm/mt6797_a72_p30e.h
new file mode 100644
--- /dev/null
+++ b/arch/arm64/include/asm/mt6797_a72_p30e.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ASM_MT6797_A72_P30E_H
+#define __ASM_MT6797_A72_P30E_H
+
+#define ARM64_MT6797_A72_P30E_WIRE_WORDS	20
+#define ARM64_MT6797_A72_P30E_WIRE_BYTES	160
+#define ARM64_MT6797_A72_P30E_SLOT_BYTES	2048
+#define ARM64_MT6797_A72_P30E_MAGIC		0x5033304557495245
+#define ARM64_MT6797_A72_P30E_ABI_AND_SIZE	0x0000000100000014
+#define ARM64_MT6797_A72_P30E_CRC64_POLY	0x42f0e1eba9ea3693
+
+#define ARM64_MT6797_A72_P30E_CPU8		8
+#define ARM64_MT6797_A72_P30E_CPU9		9
+#define ARM64_MT6797_A72_P30E_MPIDR_CPU8	0x200
+#define ARM64_MT6797_A72_P30E_MPIDR_CPU9	0x201
+#define ARM64_MT6797_A72_P30E_OPERATION_CPU8_UP	1
+#define ARM64_MT6797_A72_P30E_OPERATION_CPU9_UP	2
+
+#define ARM64_MT6797_A72_P30E_EMPTY		0
+#define ARM64_MT6797_A72_P30E_ARMED		1
+#define ARM64_MT6797_A72_P30E_TARGET_CLAIMED	2
+#define ARM64_MT6797_A72_P30E_TARGET_PUBLISHED	3
+#define ARM64_MT6797_A72_P30E_FAILED		4
+#define ARM64_MT6797_A72_P30E_PARKED		5
+#define ARM64_MT6797_A72_P30E_PANICKED	6
+
+#define ARM64_MT6797_A72_P30E_MAGIC_WORD	0
+#define ARM64_MT6797_A72_P30E_ABI_WORD	1
+#define ARM64_MT6797_A72_P30E_BOOT_ID0_WORD	2
+#define ARM64_MT6797_A72_P30E_BOOT_ID1_WORD	3
+#define ARM64_MT6797_A72_P30E_BOOT_ID2_WORD	4
+#define ARM64_MT6797_A72_P30E_BOOT_ID3_WORD	5
+#define ARM64_MT6797_A72_P30E_OPERATION_WORD	6
+#define ARM64_MT6797_A72_P30E_TARGET_CPU_WORD	7
+#define ARM64_MT6797_A72_P30E_TARGET_MPIDR_WORD	8
+#define ARM64_MT6797_A72_P30E_GENERATION_WORD	9
+#define ARM64_MT6797_A72_P30E_COOKIE_WORD	10
+#define ARM64_MT6797_A72_P30E_CONTROLLER_STATE_WORD	11
+#define ARM64_MT6797_A72_P30E_TARGET_STATE_WORD	12
+#define ARM64_MT6797_A72_P30E_TARGET_SEQUENCE_WORD	13
+#define ARM64_MT6797_A72_P30E_CONTROLLER_SEQUENCE_WORD	14
+#define ARM64_MT6797_A72_P30E_TARGET_REASON_WORD	15
+#define ARM64_MT6797_A72_P30E_TARGET_EFFECTS_WORD	16
+#define ARM64_MT6797_A72_P30E_TARGET_ENTRY_PC_WORD	17
+#define ARM64_MT6797_A72_P30E_TARGET_ENTRY_SP_WORD	18
+#define ARM64_MT6797_A72_P30E_CRC64_WORD	19
+
+#define ARM64_MT6797_A72_P30E_MAGIC_OFF	0
+#define ARM64_MT6797_A72_P30E_ABI_OFF	8
+#define ARM64_MT6797_A72_P30E_OPERATION_OFF	48
+#define ARM64_MT6797_A72_P30E_TARGET_CPU_OFF	56
+#define ARM64_MT6797_A72_P30E_TARGET_MPIDR_OFF	64
+#define ARM64_MT6797_A72_P30E_GENERATION_OFF	72
+#define ARM64_MT6797_A72_P30E_COOKIE_OFF	80
+#define ARM64_MT6797_A72_P30E_CONTROLLER_STATE_OFF	88
+#define ARM64_MT6797_A72_P30E_TARGET_STATE_OFF	96
+#define ARM64_MT6797_A72_P30E_TARGET_SEQUENCE_OFF	104
+#define ARM64_MT6797_A72_P30E_CONTROLLER_SEQUENCE_OFF	112
+#define ARM64_MT6797_A72_P30E_TARGET_REASON_OFF	120
+#define ARM64_MT6797_A72_P30E_TARGET_EFFECTS_OFF	128
+#define ARM64_MT6797_A72_P30E_TARGET_ENTRY_PC_OFF	136
+#define ARM64_MT6797_A72_P30E_TARGET_ENTRY_SP_OFF	144
+#define ARM64_MT6797_A72_P30E_CRC64_OFF	152
+
+#ifndef __ASSEMBLER__
+
+#include <linux/sizes.h>
+#include <linux/types.h>
+
+struct arm64_mt6797_a72_p30e_wire {
+	__le64 word[ARM64_MT6797_A72_P30E_WIRE_WORDS];
+};
+
+struct arm64_mt6797_a72_p30e_slot {
+	struct arm64_mt6797_a72_p30e_wire wire;
+	u8 reserved[ARM64_MT6797_A72_P30E_SLOT_BYTES -
+		    ARM64_MT6797_A72_P30E_WIRE_BYTES];
+};
+
+struct arm64_mt6797_a72_p30e_request {
+	u64 boot_identity[4];
+	u64 operation;
+	u64 generation;
+	u64 cookie;
+};
+
+extern struct arm64_mt6797_a72_p30e_slot
+arm64_mt6797_a72_p30e_cpu8_slot;
+extern struct arm64_mt6797_a72_p30e_slot
+arm64_mt6797_a72_p30e_cpu9_slot;
+
+int arm64_mt6797_a72_p30e_arm(unsigned int cpu,
+				      const struct arm64_mt6797_a72_p30e_request *request);
+int arm64_mt6797_a72_p30e_readback(unsigned int cpu,
+					 const struct arm64_mt6797_a72_p30e_request *request,
+					 struct arm64_mt6797_a72_p30e_wire *copy);
+
+/* MMU-off primitives; no current caller or CPU_ON path is installed. */
+int arm64_mt6797_a72_p30e_target_claim(void);
+int arm64_mt6797_a72_p30e_target_publish(u64 state, u64 reason,
+						 u64 effects, u64 entry_pc,
+						 u64 entry_sp);
+
+#endif /* !__ASSEMBLER__ */
+#endif /* __ASM_MT6797_A72_P30E_H */
diff --git a/arch/arm64/kernel/mt6797_a72_p30e.c b/arch/arm64/kernel/mt6797_a72_p30e.c
new file mode 100644
--- /dev/null
+++ b/arch/arm64/kernel/mt6797_a72_p30e.c
@@ -0,0 +1,212 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Dormant MT6797 A72 P30E MMU-off-visible wire object.
+ *
+ * This file deliberately has no production caller. It supplies the reviewed
+ * controller-side storage and cache protocol for a later P17/P18/P24 owner.
+ */
+
+#include <linux/bitops.h>
+#include <linux/byteorder/little_endian.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/barrier.h>
+#include <asm/cacheflush.h>
+#include <asm/mt6797_a72_p30e.h>
+
+static_assert(sizeof(struct arm64_mt6797_a72_p30e_wire) ==
+	      ARM64_MT6797_A72_P30E_WIRE_BYTES);
+static_assert(sizeof(struct arm64_mt6797_a72_p30e_slot) ==
+	      ARM64_MT6797_A72_P30E_SLOT_BYTES);
+
+struct arm64_mt6797_a72_p30e_slot arm64_mt6797_a72_p30e_cpu8_slot
+	__used __section(".mmuoff.data.bidirectional")
+	__aligned(ARM64_MT6797_A72_P30E_SLOT_BYTES) = {};
+struct arm64_mt6797_a72_p30e_slot arm64_mt6797_a72_p30e_cpu9_slot
+	__used __section(".mmuoff.data.bidirectional")
+	__aligned(ARM64_MT6797_A72_P30E_SLOT_BYTES) = {};
+
+static DEFINE_RAW_SPINLOCK(p30e_lock);
+
+static struct arm64_mt6797_a72_p30e_slot *p30e_slot(unsigned int cpu)
+{
+	switch (cpu) {
+	case ARM64_MT6797_A72_P30E_CPU8:
+		return &arm64_mt6797_a72_p30e_cpu8_slot;
+	case ARM64_MT6797_A72_P30E_CPU9:
+		return &arm64_mt6797_a72_p30e_cpu9_slot;
+	default:
+		return NULL;
+	}
+}
+
+static u64 p30e_mpidr(unsigned int cpu)
+{
+	return cpu == ARM64_MT6797_A72_P30E_CPU8 ?
+		ARM64_MT6797_A72_P30E_MPIDR_CPU8 :
+		ARM64_MT6797_A72_P30E_MPIDR_CPU9;
+}
+
+static u64 p30e_word(const struct arm64_mt6797_a72_p30e_wire *wire,
+			     unsigned int index)
+{
+	return le64_to_cpu(READ_ONCE(wire->word[index]));
+}
+
+static void p30e_put(struct arm64_mt6797_a72_p30e_wire *wire,
+			 unsigned int index, u64 value)
+{
+	WRITE_ONCE(wire->word[index], cpu_to_le64(value));
+}
+
+static u64 p30e_crc64(const struct arm64_mt6797_a72_p30e_wire *wire)
+{
+	const u8 *bytes = (const u8 *)wire;
+	u64 crc = 0;
+	unsigned int i, bit;
+
+	for (i = 0; i < ARM64_MT6797_A72_P30E_CRC64_OFF; i++) {
+		crc ^= (u64)bytes[i] << 56;
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc << 1) ^
+				((crc & BIT_ULL(63)) ?
+				 ARM64_MT6797_A72_P30E_CRC64_POLY : 0);
+	}
+
+	return crc;
+}
+
+static void p30e_clean_slot(struct arm64_mt6797_a72_p30e_slot *slot)
+{
+	dcache_clean_poc((unsigned long)slot,
+			 (unsigned long)slot + ARM64_MT6797_A72_P30E_SLOT_BYTES);
+	dsb(sy);
+}
+
+static void p30e_invalidate_slot(struct arm64_mt6797_a72_p30e_slot *slot)
+{
+	dcache_inval_poc((unsigned long)slot,
+			  (unsigned long)slot + ARM64_MT6797_A72_P30E_SLOT_BYTES);
+}
+
+static bool p30e_request_matches(unsigned int cpu,
+					const struct arm64_mt6797_a72_p30e_request *request,
+					const struct arm64_mt6797_a72_p30e_wire *wire)
+{
+	unsigned int i;
+
+	if (p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_CPU_WORD) != cpu ||
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_TARGET_MPIDR_WORD) !=
+	    p30e_mpidr(cpu) ||
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_OPERATION_WORD) !=
+	    request->operation ||
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_GENERATION_WORD) !=
+	    request->generation ||
+	    p30e_word(wire, ARM64_MT6797_A72_P30E_COOKIE_WORD) != request->cookie)
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(request->boot_identity); i++)
+		if (p30e_word(wire, ARM64_MT6797_A72_P30E_BOOT_ID0_WORD + i) !=
+		    request->boot_identity[i])
+			return false;
+
+	return true;
+}
+
+int arm64_mt6797_a72_p30e_arm(unsigned int cpu,
+				      const struct arm64_mt6797_a72_p30e_request *request)
+{
+	struct arm64_mt6797_a72_p30e_slot *slot;
+	unsigned long flags;
+	unsigned int i;
+
+	if (!request || !p30e_slot(cpu) ||
+	    (request->operation != ARM64_MT6797_A72_P30E_OPERATION_CPU8_UP &&
+	     request->operation != ARM64_MT6797_A72_P30E_OPERATION_CPU9_UP) ||
+	    (cpu == ARM64_MT6797_A72_P30E_CPU8 &&
+	     request->operation != ARM64_MT6797_A72_P30E_OPERATION_CPU8_UP) ||
+	    (cpu == ARM64_MT6797_A72_P30E_CPU9 &&
+	     request->operation != ARM64_MT6797_A72_P30E_OPERATION_CPU9_UP) ||
+	    !request->generation || !request->cookie)
+		return -EINVAL;
+
+	slot = p30e_slot(cpu);
+	raw_spin_lock_irqsave(&p30e_lock, flags);
+	if (p30e_word(&slot->wire,
+		       ARM64_MT6797_A72_P30E_CONTROLLER_STATE_WORD) !=
+	    ARM64_MT6797_A72_P30E_EMPTY ||
+	    p30e_word(&slot->wire,
+		       ARM64_MT6797_A72_P30E_TARGET_STATE_WORD) !=
+	    ARM64_MT6797_A72_P30E_EMPTY) {
+		raw_spin_unlock_irqrestore(&p30e_lock, flags);
+		return -EBUSY;
+	}
+
+	memset(&slot->wire, 0, sizeof(slot->wire));
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_MAGIC_WORD,
+		 ARM64_MT6797_A72_P30E_MAGIC);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_ABI_WORD,
+		 ARM64_MT6797_A72_P30E_ABI_AND_SIZE);
+	for (i = 0; i < ARRAY_SIZE(request->boot_identity); i++)
+		p30e_put(&slot->wire,
+			 ARM64_MT6797_A72_P30E_BOOT_ID0_WORD + i,
+			 request->boot_identity[i]);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_OPERATION_WORD,
+		 request->operation);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_TARGET_CPU_WORD, cpu);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_TARGET_MPIDR_WORD,
+		 p30e_mpidr(cpu));
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_GENERATION_WORD,
+		 request->generation);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_COOKIE_WORD,
+		 request->cookie);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_CONTROLLER_STATE_WORD,
+		 ARM64_MT6797_A72_P30E_ARMED);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_CONTROLLER_SEQUENCE_WORD, 1);
+	p30e_put(&slot->wire, ARM64_MT6797_A72_P30E_CRC64_WORD,
+		 p30e_crc64(&slot->wire));
+
+	p30e_clean_slot(slot);
+	dsb(sy);
+	smp_store_release((u64 *)&slot->wire.word[
+			 ARM64_MT6797_A72_P30E_CONTROLLER_STATE_WORD],
+			 cpu_to_le64(ARM64_MT6797_A72_P30E_ARMED));
+	p30e_clean_slot(slot);
+	raw_spin_unlock_irqrestore(&p30e_lock, flags);
+	return 0;
+}
+
+int arm64_mt6797_a72_p30e_readback(
+	unsigned int cpu,
+	const struct arm64_mt6797_a72_p30e_request *request,
+	struct arm64_mt6797_a72_p30e_wire *copy)
+{
+	struct arm64_mt6797_a72_p30e_slot *slot;
+	unsigned long flags;
+	u64 state, sequence;
+	int ret = 0;
+
+	if (!request || !copy || !p30e_slot(cpu))
+		return -EINVAL;
+	slot = p30e_slot(cpu);
+	raw_spin_lock_irqsave(&p30e_lock, flags);
+	dsb(sy);
+	p30e_invalidate_slot(slot);
+	memcpy(copy, &slot->wire, sizeof(*copy));
+	raw_spin_unlock_irqrestore(&p30e_lock, flags);
+
+	state = p30e_word(copy, ARM64_MT6797_A72_P30E_TARGET_STATE_WORD);
+	sequence = p30e_word(copy,
+				     ARM64_MT6797_A72_P30E_TARGET_SEQUENCE_WORD);
+	if (state < ARM64_MT6797_A72_P30E_TARGET_PUBLISHED ||
+	    state > ARM64_MT6797_A72_P30E_PANICKED || sequence != 1 ||
+	    !p30e_request_matches(cpu, request, copy))
+		ret = -EAGAIN;
+
+	return ret;
+}
diff --git a/arch/arm64/kernel/mt6797_a72_p30e_asm.S b/arch/arm64/kernel/mt6797_a72_p30e_asm.S
new file mode 100644
--- /dev/null
+++ b/arch/arm64/kernel/mt6797_a72_p30e_asm.S
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Dormant MT6797 A72 P30E MMU-off claim/publication primitives.
+ *
+ * This file is not connected to secondary_entry. Its symbols are a reviewed
+ * implementation seam for a later owner that can prove the complete P17/P18
+ * and P24 lifecycle.
+ */
+
+#include <linux/linkage.h>
+
+#include <asm/assembler.h>
+#include <asm/cputype.h>
+#include <asm/errno.h>
+#include <asm/mt6797_a72_p30e.h>
+
+	.section ".idmap.text", "a"
+
+SYM_FUNC_START_LOCAL(p30e_select_slot)
+	mrs	x0, mpidr_el1
+	mov_q	x2, MPIDR_HWID_BITMASK
+	and	x0, x0, x2
+	adr_l	x1, arm64_mt6797_a72_p30e_cpu8_slot
+	cmp	x0, #ARM64_MT6797_A72_P30E_MPIDR_CPU8
+	b.eq	.Lp30e_cpu8
+	adr_l	x1, arm64_mt6797_a72_p30e_cpu9_slot
+	cmp	x0, #ARM64_MT6797_A72_P30E_MPIDR_CPU9
+	b.eq	.Lp30e_cpu9
+	mov	x0, #-ENODEV
+	ret
+.Lp30e_cpu8:
+	mov	x2, #ARM64_MT6797_A72_P30E_CPU8
+	ret
+.Lp30e_cpu9:
+	mov	x2, #ARM64_MT6797_A72_P30E_CPU9
+	ret
+SYM_FUNC_END(p30e_select_slot)
+
+/* x1 = selected slot; the cache routine corrupts x0-x3 only. */
+SYM_FUNC_START_LOCAL(p30e_clean_slot)
+	mov	x0, x1
+	add	x1, x1, #ARM64_MT6797_A72_P30E_SLOT_BYTES
+	adr_l	x2, dcache_clean_inval_poc
+	blr	x2
+	dsb	sy
+	ret
+SYM_FUNC_END(p30e_clean_slot)
+
+/* Return x0 = 0 for a matching CRC64-ECMA value, 1 otherwise. */
+SYM_FUNC_START_LOCAL(p30e_crc_bad)
+	mov	x5, xzr
+	mov	x6, #0
+	mov_q	x11, ARM64_MT6797_A72_P30E_CRC64_POLY
+.Lp30e_crc_word:
+	ldr	x7, [x1, x6, lsl #3]
+	mov	x8, #8
+.Lp30e_crc_byte:
+	and	x9, x7, #0xff
+	lsl	x9, x9, #56
+	eor	x5, x5, x9
+	mov	x10, #8
+.Lp30e_crc_bit:
+	tbz	x5, #63, .Lp30e_crc_zero
+	lsl	x5, x5, #1
+	eor	x5, x5, x11
+	b	.Lp30e_crc_next
+.Lp30e_crc_zero:
