diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2562,5 +2562,17 @@ config ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST
 	  also cover the read-only public and internal admission checks.
 
+config ARM64_MT6797_A72_P30E_WIRE
+	bool "Build the dormant MT6797 A72 P30E MMU-off wire object"
+	depends on ARM64_MT6797_A72_P30_PROTOCOL_MODEL
+	depends on !CPU_BIG_ENDIAN
+	help
+	  Build the default-off P30E wire object and MMU-off target primitives
