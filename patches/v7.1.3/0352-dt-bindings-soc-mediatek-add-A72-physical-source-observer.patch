From 25ec04428138eb02615de07253ad5766ebe23932 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 24 Aug 2026 20:03:00 +0000
Subject: [PATCH 3/5] dt-bindings: soc: mediatek: add A72 physical-source
 observer

Describe the candidate-only observer and its three bound component phandles without making it a state owner or transition consumer.
---
 ...k,mt6797-a72-physical-source-observer.yaml | 44 +++++++++++++++++++
 1 file changed, 44 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-physical-source-observer.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-physical-source-observer.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-physical-source-observer.yaml
new file mode 100644
index 0000000..ea7c4a9
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-a72-physical-source-observer.yaml
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-a72-physical-source-observer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 A72 direct physical-source observer
+
+description: |
+  Candidate-only one-shot observer that composes the disabled platform-state,
+  protected clock, secure BigiDVFS, and separately registered DA921x read-only
+  sources through the closed A72 direct-state boundary. It does not publish a
+  transition decision or request a CPU, clock, regulator, or firmware change.
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+properties:
+  compatible:
+    const: mediatek,mt6797-a72-physical-source-observer
+
+  mediatek,platform-state:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: MT6797 A72 platform-state source
+
+  mediatek,clock-backend:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: MT6797 protected clock readback transport
+
+  mediatek,bigidvfs-backend:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: MT6797 secure BigiDVFS readback transport
+
+  status:
+    enum: [ disabled, okay ]
+
+required:
+  - compatible
+  - mediatek,platform-state
+  - mediatek,clock-backend
+  - mediatek,bigidvfs-backend
+
+additionalProperties: false
+...
