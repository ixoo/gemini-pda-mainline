From df45ac40874a217566f9ffab0b1083c89ce761c7 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Fri, 21 Aug 2026 21:01:00 +0000
Subject: [PATCH 1/3] arm64: add read-only provider state snapshot

Extend the platform-private provider registry with an optional typed state callback. Validate and publish only one complete record while leaving every error destination all-zero.

Add no provider write, lifecycle caller, CPU operation, boot candidate, or device action.
---
 arch/arm64/kernel/mt6797_a72_membership.c | 35 +++++++++++++++++++++++
 include/linux/mt6797-a72-provider.h       | 15 ++++++++++
 2 files changed, 50 insertions(+)

diff --git a/arch/arm64/kernel/mt6797_a72_membership.c b/arch/arm64/kernel/mt6797_a72_membership.c
index bcf75e6..6ba613f 100644
--- a/arch/arm64/kernel/mt6797_a72_membership.c
+++ b/arch/arm64/kernel/mt6797_a72_membership.c
@@ -112,6 +112,41 @@ int mt6797_a72_provider_release(
 }
 EXPORT_SYMBOL_GPL(mt6797_a72_provider_release);
 
+int mt6797_a72_provider_snapshot(struct mt6797_a72_provider_state *state)
+{
+	struct mt6797_a72_provider_state observed = { };
+	u32 raw;
+	int ret;
+
+	if (!state)
+		return -EINVAL;
+	memset(state, 0, sizeof(*state));
+
+	mutex_lock(&a72_provider_registry_lock);
+	if (!a72_provider_ops)
+		ret = -ENODEV;
+	else if (!a72_provider_ops->snapshot)
+		ret = -EOPNOTSUPP;
+	else
+		ret = a72_provider_ops->snapshot(a72_provider_context,
+						 &observed);
+	if (!ret) {
+		raw = observed.control_a | observed.status_b |
+			observed.buckb_cont | observed.vbuckb_a |
+			observed.vbuckb_b;
+		if (observed.abi != MT6797_A72_PROVIDER_STATE_ABI ||
+		    observed.valid != 1 || observed.reserved ||
+		    (raw & ~0xffU))
+			ret = -EPROTO;
+		else
+			*state = observed;
+	}
+	mutex_unlock(&a72_provider_registry_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_a72_provider_snapshot);
+
 struct mt6797_a72_owner_state {
 	struct mt6797_a72_transaction active;
 	struct mt6797_a72_transaction retired[MT6797_A72_OPERATION_SLOTS];
diff --git a/include/linux/mt6797-a72-provider.h b/include/linux/mt6797-a72-provider.h
index 1ade142..0d78bbd 100644
--- a/include/linux/mt6797-a72-provider.h
+++ b/include/linux/mt6797-a72-provider.h
@@ -15,6 +15,7 @@
 #define MT6797_A72_PROVIDER_CALL_SETTLE_US	1000
 #define MT6797_A72_PROVIDER_CALL_DA921X_PAGE	0x80
 #define MT6797_A72_PROVIDER_CALL_BUCKB_VSEL	0x46
+#define MT6797_A72_PROVIDER_STATE_ABI		1
 
 struct mt6797_a72_provider_handle {
 	u64 generation;
@@ -48,6 +49,17 @@ struct mt6797_a72_provider_response {
 	struct mt6797_a72_provider_handle held_handle;
 };
 
+struct mt6797_a72_provider_state {
+	u32 abi;
+	u32 valid;
+	u32 control_a;
+	u32 status_b;
+	u32 buckb_cont;
+	u32 vbuckb_a;
+	u32 vbuckb_b;
+	u32 reserved;
+};
+
 struct mt6797_a72_provider_ops {
 	int (*acquire)(void *context,
 			const struct mt6797_a72_provider_request *request,
@@ -55,6 +67,8 @@ struct mt6797_a72_provider_ops {
 	int (*release)(void *context,
 			const struct mt6797_a72_provider_handle *handle,
 			struct mt6797_a72_provider_response *response);
+	int (*snapshot)(void *context,
+			struct mt6797_a72_provider_state *state);
 };
 
 int mt6797_a72_provider_register(const struct mt6797_a72_provider_ops *ops,
@@ -65,5 +79,6 @@ int mt6797_a72_provider_acquire(const struct mt6797_a72_provider_request *reques
 					struct mt6797_a72_provider_response *response);
 int mt6797_a72_provider_release(const struct mt6797_a72_provider_handle *handle,
 					struct mt6797_a72_provider_response *response);
+int mt6797_a72_provider_snapshot(struct mt6797_a72_provider_state *state);
 
 #endif /* __LINUX_MT6797_A72_PROVIDER_H */
