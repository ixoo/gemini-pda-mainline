+static bool
+da9213_provider_read_transport_valid(const struct da9213_legacy_provider_endpoint
+				     *endpoint)
+{
+	return endpoint && endpoint->adapter && endpoint->read_transfer &&
+		endpoint->adapter->lock_ops &&
+		endpoint->adapter->lock_ops->lock_bus &&
+		endpoint->adapter->lock_ops->unlock_bus;
+}
+
+static int
+da9213_provider_snapshot_read(struct da9213_legacy_provider_endpoint *endpoint,
+			      u8 reg, u8 *value)
+{
+	struct i2c_msg messages[2] = { };
+	u8 data = 0;
+	int ret;
+
+	messages[0].addr = endpoint->address;
+	messages[0].len = 1;
+	messages[0].buf = &reg;
+	messages[1].addr = endpoint->address;
+	messages[1].flags = I2C_M_RD;
+	messages[1].len = 1;
+	messages[1].buf = &data;
+
+	ret = endpoint->read_transfer(endpoint->adapter, messages,
+				      ARRAY_SIZE(messages));
+	if (ret < 0)
+		return ret;
+	if (ret != ARRAY_SIZE(messages))
+		return -EIO;
+
+	*value = data;
+	return 0;
+}
+
+static int
+da9213_provider_snapshot_sample(struct da9213_legacy_provider_endpoint *endpoint,
+				struct da9213_legacy_provider_snapshot *snapshot)
+{
+	u8 *values = (u8 *)snapshot;
+	unsigned int i;
+	int ret;
+
+	BUILD_BUG_ON(sizeof(*snapshot) !=
+		     ARRAY_SIZE(da9213_legacy_provider_snapshot_regs));
+	for (i = 0; i < ARRAY_SIZE(da9213_legacy_provider_snapshot_regs);
+	     i++) {
+		ret = da9213_provider_snapshot_read(endpoint,
+						    da9213_legacy_provider_snapshot_regs[i],
+						    &values[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int
+da9213_provider_snapshot(void *context,
+			 struct mt6797_a72_provider_snapshot *state)
+{
+	struct da9213_legacy_provider_endpoint *endpoint = context;
+	struct da9213_legacy_provider_snapshot first = { };
+	struct da9213_legacy_provider_snapshot second = { };
+	unsigned int saved_retries;
+	int ret;
+
+	if (!state)
+		return -EINVAL;
+	memset(state, 0, sizeof(*state));
+	if (!da9213_provider_read_transport_valid(endpoint))
+		return -EINVAL;
+
+	mutex_lock(&endpoint->lock);
+	i2c_lock_bus(endpoint->adapter, I2C_LOCK_ROOT_ADAPTER);
+	saved_retries = endpoint->adapter->retries;
+	endpoint->adapter->retries = 0;
+
+	ret = da9213_provider_snapshot_sample(endpoint, &first);
+	if (ret)
+		goto out;
+	ret = da9213_provider_snapshot_sample(endpoint, &second);
+	if (ret)
+		goto out;
+	if (memcmp(&first, &second, sizeof(first))) {
+		ret = -EAGAIN;
+		goto out;
+	}
+
+	*state = (struct mt6797_a72_provider_snapshot) {
+		.abi = MT6797_A72_PROVIDER_STATE_ABI,
+		.valid = 1,
+		.control_a = second.control_a,
+		.status_b = second.status_b,
+		.buckb_cont = second.buckb_cont,
+		.vbuckb_a = second.vbuckb_a,
+		.vbuckb_b = second.vbuckb_b,
+	};
+	ret = 0;
+
+out:
+	endpoint->adapter->retries = saved_retries;
+	i2c_unlock_bus(endpoint->adapter, I2C_LOCK_ROOT_ADAPTER);
+	mutex_unlock(&endpoint->lock);
+	return ret;
+}
