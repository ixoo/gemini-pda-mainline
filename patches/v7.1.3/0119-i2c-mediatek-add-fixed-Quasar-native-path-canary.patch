From 13118dd9f454f8aad0146d7bdd868a5af2cb5f7d Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 27 Jul 2026 20:30:00 -0400
Subject: [PATCH 119/119] i2c: mediatek: add fixed Quasar native-path canary

Vega established that the MT6797 iDVFS controller returns the previously
observed d9,d0,c0 tuple with packed WRRD lengths through either FIFO or
APDMA, while the auxiliary-length negative control does not complete its
receive side.  The next experiment must exercise the ordinary controller
policy without Orion's mode overrides or per-mode reset.

Add an experiment-only Quasar canary which is mutually exclusive with the
Orion diagnostic.  Its root-only one-shot file accepts only "run\n" and
issues two ordered passes over fixed read-only offsets 05, 06, and 47 at
address 0x69.  Each receive buffer has a distinct sentinel.  Stop at the
first transport, native-policy, counter, or expected-value mismatch.

Hold the root-adapter lock around the complete run, require a childless
adapter, ready handoff, zero transfer counters, and adapter retries equal
to one.  Use __i2c_transfer() with retries temporarily set to zero, then
restore one on every exit.  Do not select a length encoding or transfer
engine and do not request a controller or APDMA reset.

Record the controller and channel state after programming, in the IRQ,
after completion, and after FIFO extraction.  Keep attempted, transport
completed, and value-validated counts distinct.  A successful run requires
packed 0x0101 lengths, FIFO for every 1+1 transfer, completion-only IRQs,
one received then zero queued FIFO bytes, no controller DMA enable, no
APDMA start, exact 6/0/6/6 counter deltas, and no hardware-initialization
counter delta.

This is a fixed read canary, not a device provider.  It exposes no
arbitrary address, register, length, data, mode, retry, or reset input.

---
 drivers/i2c/busses/Kconfig      |  14 +
 drivers/i2c/busses/i2c-mt65xx.c | 663 +++++++++++++++++++++++++++++++-
 2 files changed, 677 insertions(+), 1 deletion(-)

diff --git a/drivers/i2c/busses/Kconfig b/drivers/i2c/busses/Kconfig
--- a/drivers/i2c/busses/Kconfig
+++ b/drivers/i2c/busses/Kconfig
@@ -916,6 +916,20 @@ config I2C_MT65XX_ORION_DIAGNOSTIC
 
 	  Say N outside the named Gemini Orion experiment.
 
+config I2C_MT65XX_QUASAR_DIAGNOSTIC
+	bool "MT6797 I2C6 fixed Quasar native-path canary"
+	depends on I2C_MT65XX=y && DEBUG_FS
+	depends on !I2C_MT65XX_ORION_DIAGNOSTIC
+	help
+	  Enable the experiment-only, one-shot Quasar native-path canary for
+	  the access-controlled MT6797 iDVFS I2C instance. The root-only
+	  debugfs file accepts exactly "run" followed by a newline and performs
+	  two fixed passes of pointer-only reads from address 0x69.
+
+	  The canary supplies no length or engine override and exposes no
+	  arbitrary address, register, data, length, mode, retry, or reset
+	  control. Say N outside the named Gemini Quasar experiment.
+
 config I2C_MT7621
 	tristate "MT7621/MT7628 I2C Controller"
 	depends on (RALINK && (SOC_MT7620 || SOC_MT7621)) || ARCH_AIROHA || COMPILE_TEST
diff --git a/drivers/i2c/busses/i2c-mt65xx.c b/drivers/i2c/busses/i2c-mt65xx.c
--- a/drivers/i2c/busses/i2c-mt65xx.c
+++ b/drivers/i2c/busses/i2c-mt65xx.c
@@ -207,6 +207,86 @@ struct mtk_i2c_orion_diag {
 };
 #endif
 
+#ifdef CONFIG_I2C_MT65XX_QUASAR_DIAGNOSTIC
+#define MTK_I2C_QUASAR_PASS_COUNT	2
+#define MTK_I2C_QUASAR_REGISTER_COUNT	3
+#define MTK_I2C_QUASAR_SAMPLE_COUNT	\
+	(MTK_I2C_QUASAR_PASS_COUNT * MTK_I2C_QUASAR_REGISTER_COUNT)
+
+enum mtk_i2c_quasar_state {
+	MTK_I2C_QUASAR_READY,
+	MTK_I2C_QUASAR_RUNNING,
+	MTK_I2C_QUASAR_DONE,
+};
+
+struct mtk_i2c_quasar_snapshot {
+	u16 transfer_len;
+	u16 transfer_len_aux;
+	u16 transac_len;
+	u16 control;
+	u16 start;
+	u16 intr_stat;
+	u16 fifo_stat;
+	u32 dma_en;
+	u32 dma_con;
+	u32 dma_int_flag;
+	u32 dma_tx_len;
+	u32 dma_rx_len;
+};
+
+struct mtk_i2c_quasar_sample {
+	struct mtk_i2c_quasar_snapshot pre;
+	struct mtk_i2c_quasar_snapshot irq;
+	struct mtk_i2c_quasar_snapshot post;
+	struct mtk_i2c_quasar_snapshot drained;
+	unsigned int pass;
+	unsigned int index;
+	u8 reg;
+	u8 expected;
+	u8 prefill;
+	u8 value;
+	int ret;
+	int validation_error;
+	bool programmed;
+	bool transport_completed;
+	bool value_validated;
+	bool use_dma;
+	u16 irq_stat;
+	u16 fifo_stat;
+	u16 fifo_count;
+	u16 fifo_count_drained;
+};
+
+struct mtk_i2c_quasar_diag {
+	struct mutex lock; /* Serializes one-shot state and result reads. */
+	struct mtk_i2c_quasar_sample samples[MTK_I2C_QUASAR_SAMPLE_COUNT];
+	struct mtk_i2c_quasar_sample *active_sample;
+	enum mtk_i2c_quasar_state state;
+	int run_error;
+	unsigned int attempted;
+	unsigned int transport_completed;
+	unsigned int value_validated;
+	unsigned int failure_pass;
+	unsigned int failure_index;
+	bool mismatch;
+	unsigned int retries_before;
+	unsigned int retries_during;
+	unsigned int retries_after;
+	int init_attempts_before;
+	int init_attempts_after;
+	int init_successes_before;
+	int init_successes_after;
+	int transfer_attempts_before;
+	int transfer_attempts_after;
+	int dma_starts_before;
+	int dma_starts_after;
+	int nonzero_starts_before;
+	int nonzero_starts_after;
+	int irqs_before;
+	int irqs_after;
+};
+#endif
+
 enum I2C_REGS_OFFSET {
 	OFFSET_DATA_PORT,
 	OFFSET_SLAVE_ADDR,
@@ -404,6 +484,9 @@ struct mtk_i2c {
 #ifdef CONFIG_I2C_MT65XX_ORION_DIAGNOSTIC
 	struct mtk_i2c_orion_diag orion;
