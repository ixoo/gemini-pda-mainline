diff --git a/drivers/soc/mediatek/mt6797-wmt-version-io.h b/drivers/soc/mediatek/mt6797-wmt-version-io.h
new file mode 100644
index 0000000..8d23052
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-wmt-version-io.h
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_WMT_VERSION_IO_H
+#define MT6797_WMT_VERSION_IO_H
+#include <linux/completion.h>
+#include <linux/errno.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include "wmt-identity-read.h"
+#include "wmt-version-reply.h"
+#include "wmt-full-stp-tx.h"
+
+#define WMT_VERSION_SERVICES 64U
+#define WMT_VERSION_RX_BYTES 22U
+#define WMT_VERSION_RX_QUOTA 8U
+
+/* Checked pre-negotiation register read. Persistent CONSYS-owned storage,
+ * retained clocks, idle DMA, normal bank and empty FIFOs are caller gates.
+ * No retry, reset, resynchronization, flush or power cleanup. A timeout never
+ * establishes identity; only the exact complete reply can return success.
+ */
+struct mt6797_wmt_version_io {
+	void __iomem *btif;
+	unsigned char command[26], received[WMT_VERSION_RX_BYTES];
+	struct wmt_full_tx tx;
+	unsigned int rx_count, tx_count, services, ordinal;
+	unsigned long deadline;
+	/* Serializes FIFO progress, terminal state and timeout retirement. */
+	spinlock_t lock;
+	struct completion done;
+	int irq, prepared, attempted, armed, terminal, result;
+};
+
+static int mt6797_wmt_version_prepare(struct mt6797_wmt_version_io *io,
+				      void __iomem *btif, int irq, unsigned int ordinal,
+				      unsigned long deadline)
+{
+	unsigned long now = jiffies;
+
+	if (!io || !btif || irq <= 0 || ordinal >= 3 || time_after_eq(now, deadline) ||
+	    deadline - now > msecs_to_jiffies(500))
+		return -EINVAL;
+	if (io->prepared)
+		return -EBUSY;
+	memset(io, 0, sizeof(*io));
+	io->prepared = 1;
+	io->btif = btif;
+	io->irq = irq;
+	io->ordinal = ordinal;
+	io->deadline = deadline;
+	init_completion(&io->done);
+	spin_lock_init(&io->lock);
+	wmt_identity_read(ordinal, io->command, sizeof(io->command));
+	/* Reuse bounded byte accounting, not full-STP frame validation. */
+	io->tx.frame = io->command;
+	io->tx.length = sizeof(io->command);
+	return 0;
+}
+
+/* Lock held. Resources/storage remain retained after IRQ retirement. */
+static void mt6797_wmt_version_retire(struct mt6797_wmt_version_io *io, int result)
+{
+	if (io->terminal)
+		return;
+	writel(0, io->btif + 4);
+	io->result = result;
+	io->terminal = 1;
+	if (io->armed) {
+		disable_irq_nosync(io->irq);
+		io->armed = 0;
+	}
+	complete(&io->done);
+}
+
+static void mt6797_wmt_version_service(struct mt6797_wmt_version_io *io, int initial)
+{
+	const unsigned char *bytes;
+	unsigned int iir, quota = 0, actual = 0;
+	int offered;
+
+	if (io->terminal)
+		return;
+	if (time_after_eq(jiffies, io->deadline) ||
+	    io->services == WMT_VERSION_SERVICES) {
+		mt6797_wmt_version_retire(io, -ETIMEDOUT);
+		return;
+	}
+	if (initial && (io->services ||
+			(readl(io->btif + 0x14) & 0x61) != 0x60)) {
+		mt6797_wmt_version_retire(io, -EBUSY);
+		return;
+	}
+	io->services++;
+	iir = readl(io->btif + 8);
+	if ((initial && (iir & 0x44)) || (!initial && !(iir & 0x46)) ||
+	    ((iir & 0x44) && !wmt_full_tx_done(&io->tx))) {
+		mt6797_wmt_version_retire(io, -EPROTO);
+		return;
+	}
+	while ((iir & 0x44) && quota < WMT_VERSION_RX_QUOTA) {
+		if (io->rx_count == sizeof(io->received)) {
+			mt6797_wmt_version_retire(io, -EPROTO);
+			return;
+		}
+		if (time_after_eq(jiffies, io->deadline)) {
+			mt6797_wmt_version_retire(io, -ETIMEDOUT);
+			return;
+		}
+		io->received[io->rx_count++] = readb(io->btif);
+		quota++;
+		if (time_after_eq(jiffies, io->deadline)) {
+			mt6797_wmt_version_retire(io, -ETIMEDOUT);
+			return;
+		}
+		iir = readl(io->btif + 8);
+	}
+	if (time_after_eq(jiffies, io->deadline)) {
+		mt6797_wmt_version_retire(io, -ETIMEDOUT);
+		return;
+	}
+	/* The last IIR observation must show no queued trailing receive data. */
+	if (io->rx_count == sizeof(io->received)) {
+		if ((iir & 0x44) ||
+		    !wmt_version_reply(io->ordinal, io->received, io->rx_count))
+			mt6797_wmt_version_retire(io, -EPROTO);
+		else
+			mt6797_wmt_version_retire(io, 0);
+		return;
+	}
+	if (!wmt_full_tx_done(&io->tx)) {
+		offered = wmt_full_tx_batch(&io->tx, readl(io->btif + 0x14),
+					    time_after_eq(jiffies, io->deadline), &bytes);
+		if (offered < 0) {
+			mt6797_wmt_version_retire(io, -ETIMEDOUT);
+			return;
+		}
+		while (actual < (unsigned int)offered &&
+		       !time_after_eq(jiffies, io->deadline)) {
+			writeb(bytes[actual++], io->btif);
+			io->tx_count++;
+		}
+		if (offered && wmt_full_tx_commit(&io->tx, actual,
+						  time_after_eq(jiffies, io->deadline))) {
+			mt6797_wmt_version_retire(io, -ETIMEDOUT);
+			return;
+		}
+		if (wmt_full_tx_done(&io->tx))
+			writel(1, io->btif + 4);
+	}
+}
+
+static irqreturn_t mt6797_wmt_version_irq(int irq, void *data)
+{
+	struct mt6797_wmt_version_io *io = data;
+	unsigned long flags;
+
+	if (irq != io->irq)
+		return IRQ_NONE;
+	spin_lock_irqsave(&io->lock, flags);
+	mt6797_wmt_version_service(io, 0);
+	spin_unlock_irqrestore(&io->lock, flags);
+	return IRQ_HANDLED;
+}
+
+/* Process context, one attempt even if IRQ registration fails. Only a zero
+ * result admits the next selected read; every failure retains resources.
+ */
+static int mt6797_wmt_version_exchange(struct mt6797_wmt_version_io *io)
+{
+	unsigned long flags, now, remaining;
+	int ret;
+
+	if (!io || !io->prepared || io->attempted)
+		return -EINVAL;
+	io->attempted = 1;
+	ret = request_irq(io->irq, mt6797_wmt_version_irq, IRQF_NO_AUTOEN,
+			  "mt6797-wmt-version", io);
+	if (ret) {
+		io->result = ret;
+		io->terminal = 1;
+		complete(&io->done);
+		return ret;
+	}
+	spin_lock_irqsave(&io->lock, flags);
+	writel(3, io->btif + 4);
+	mt6797_wmt_version_service(io, 1);
+	if (!io->terminal)
+		io->armed = 1;
+	spin_unlock_irqrestore(&io->lock, flags);
+	if (io->armed) {
+		enable_irq(io->irq);
+		now = jiffies;
+		remaining = time_after_eq(now, io->deadline) ? 0 : io->deadline - now;
+		wait_for_completion_timeout(&io->done, remaining);
+		spin_lock_irqsave(&io->lock, flags);
+		if (!io->terminal)
+			mt6797_wmt_version_retire(io, -ETIMEDOUT);
+		spin_unlock_irqrestore(&io->lock, flags);
+	}
+	synchronize_irq(io->irq);
+	ret = io->result;
+	free_irq(io->irq, io);
+	return ret;
+}
+#endif
diff --git a/drivers/soc/mediatek/mt6797-wmt-versions.h b/drivers/soc/mediatek/mt6797-wmt-versions.h
new file mode 100644
index 0000000..6d33608
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-wmt-versions.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_WMT_VERSIONS_H
+#define MT6797_WMT_VERSIONS_H
+#include "mt6797-wmt-version-io.h"
+
+#define WMT_VERSIONS_BUDGET_MS 1500U
+
+/* Persistent caller-owned storage, with shared CONSYS mutex held and the
+ * reviewed BTIF setup complete. Three separate exclusive IRQ lifetimes;
+ * no setup repetition, clock acquisition, reset, negotiation or continuation.
+ */
+struct mt6797_wmt_versions {
+	struct mt6797_wmt_version_io reads[3];
+	void __iomem *btif;
+	unsigned long deadline;
+	unsigned int completed;
+	int irq, clocks_held, attempted, result;
+};
+
+static int mt6797_wmt_versions_once(struct mt6797_wmt_versions *owner)
+{
+	unsigned long end;
+	unsigned int ordinal;
+	int ret;
+
+	if (!owner || !owner->btif || owner->irq <= 0 || !owner->clocks_held)
+		return -EINVAL;
+	if (owner->attempted || owner->completed || owner->reads[0].prepared ||
+	    owner->reads[1].prepared || owner->reads[2].prepared)
+		return -EALREADY;
+	owner->attempted = 1;
+	owner->deadline = jiffies + msecs_to_jiffies(WMT_VERSIONS_BUDGET_MS);
+	for (ordinal = 0; ordinal < 3; ordinal++) {
+		if (time_after_eq(jiffies, owner->deadline)) {
+			ret = -ETIMEDOUT;
+			goto out;
+		}
+		end = jiffies + msecs_to_jiffies(500);
+		if (time_before(owner->deadline, end))
+			end = owner->deadline;
+		ret = mt6797_wmt_version_prepare(&owner->reads[ordinal], owner->btif,
+						 owner->irq, ordinal, end);
+		if (!ret)
+			ret = mt6797_wmt_version_exchange(&owner->reads[ordinal]);
+		if (ret)
+			goto out;
+		if (time_after_eq(jiffies, owner->deadline)) {
+			ret = -ETIMEDOUT;
+			goto out;
+		}
+		owner->completed++;
+	}
+	ret = 0;
+out:
+	owner->result = ret;
+	return ret;
+}
+
+#endif
diff --git a/drivers/soc/mediatek/wmt-version-reply.h b/drivers/soc/mediatek/wmt-version-reply.h
new file mode 100644
index 0000000..bce92dd
--- /dev/null
+++ b/drivers/soc/mediatek/wmt-version-reply.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef GEMINI_WMT_VERSION_REPLY_H
+#define GEMINI_WMT_VERSION_REPLY_H
+
+/* Chip format/value are measured. HW/ROM use the same read-event contract
+ * with their echoed addresses and the vendor-reported 0x8a00 expectations.
+ * Those two variants remain inference until attributable live exchanges.
+ * Never accept another tuple, length, status, count or mandatory header.
+ */
+static inline int wmt_version_reply(unsigned int ordinal,
+				    const unsigned char *wire, unsigned int length)
+{
+	static const unsigned char offsets[3] = { 8, 0, 4 };
+	static const unsigned char values[3][2] = { { 0x79, 0x02 },
+		{ 0x00, 0x8a }, { 0x00, 0x8a } };
+	static const unsigned char frame[22] = {
+		0x80, 0x40, 0x10, 0x00,
+		0x02, 0x08, 0x0c, 0x00, 0x00, 0x00, 0x00, 0x01,
+		0x00, 0x00, 0x00, 0x80,
+		0x00, 0x00, 0x00, 0x00,
+		0x00, 0x00
+	};
+	unsigned int i;
+	unsigned char expected;
+
+	if (ordinal >= 3 || !wire || length != sizeof(frame))
+		return 0;
+	for (i = 0; i < sizeof(frame); i++) {
+		expected = i == 12 ? offsets[ordinal] :
+			   i == 16 ? values[ordinal][0] :
+			   i == 17 ? values[ordinal][1] : frame[i];
+		if (wire[i] != expected)
+			return 0;
+	}
+	return 1;
+}
+
+#endif
