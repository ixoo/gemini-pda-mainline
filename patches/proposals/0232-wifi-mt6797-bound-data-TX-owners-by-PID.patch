diff --git a/drivers/net/wireless/mediatek/mt6797/join-depth.h b/drivers/net/wireless/mediatek/mt6797/join-depth.h
new file mode 100644
index 0000000..8d44395
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/join-depth.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_JOIN_DEPTH_H
+#define MT6797_JOIN_DEPTH_H
+
+#ifdef CONFIG_MT6797_CCMP_TX_DEPTH
+#define MT6797_DATA_DEPTH CONFIG_MT6797_CCMP_TX_DEPTH
+#else
+#define MT6797_DATA_DEPTH 1U
+#endif
+
+struct mt6797_data_owner {
+	void *frame;
+	unsigned long long deadline;
+	unsigned char pid;
+};
+
+struct mt6797_data_slots {
+	struct mt6797_data_owner owner[MT6797_DATA_DEPTH];
+	unsigned int count;
+};
+
+static inline bool
+mt6797_data_room(const struct mt6797_data_slots *s, unsigned int pages,
+		 unsigned int free_pages)
+{
+	return s->count < MT6797_DATA_DEPTH && pages && pages <= free_pages;
+}
+
+static inline struct mt6797_data_owner *
+mt6797_data_find(struct mt6797_data_slots *s, unsigned char pid)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame && s->owner[i].pid == pid)
+			return &s->owner[i];
+	return NULL;
+}
+
+static inline bool
+mt6797_data_put(struct mt6797_data_slots *s, unsigned char pid, void *frame,
+		unsigned long long deadline)
+{
+	unsigned int i;
+
+	if (!frame || !pid || pid >= 127 || s->count >= MT6797_DATA_DEPTH ||
+	    mt6797_data_find(s, pid))
+		return false;
+	for (i = 0; i < MT6797_DATA_DEPTH; i++) {
+		if (!s->owner[i].frame) {
+			s->owner[i] = (struct mt6797_data_owner){frame, deadline, pid};
+			s->count++;
+			return true;
+		}
+	}
+	return false;
+}
+
+static inline void *mt6797_data_take(struct mt6797_data_slots *s, unsigned char pid)
+{
+	struct mt6797_data_owner *o = mt6797_data_find(s, pid);
+	void *frame;
+
+	if (!o)
+		return NULL;
+	frame = o->frame;
+	*o = (struct mt6797_data_owner){0};
+	s->count--;
+	return frame;
+}
+
+static inline void *mt6797_data_pop(struct mt6797_data_slots *s)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame)
+			return mt6797_data_take(s, s->owner[i].pid);
+	return NULL;
+}
+
+static inline bool
+mt6797_data_expired(const struct mt6797_data_slots *s, unsigned long long now)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame && now >= s->owner[i].deadline)
+			return true;
+	return false;
+}
+
+#endif
