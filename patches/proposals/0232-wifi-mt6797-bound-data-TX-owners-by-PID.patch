 drivers/net/wireless/mediatek/mt6797/hif.c    |   1 +
 drivers/net/wireless/mediatek/mt6797/hif.h    |   1 +
 .../net/wireless/mediatek/mt6797/join-depth.h |  93 ++++++++++++
 .../wireless/mediatek/mt6797/join-submit.h    |   2 +
 drivers/net/wireless/mediatek/mt6797/mac.c    | 140 ++++++++++++++----
 6 files changed, 218 insertions(+), 29 deletions(-)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/join-depth.h

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index e328c4e..5f245c9 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -196,3 +196,13 @@ config MT6797_CCMP_TX_PUMP
 	  interval. Idle polls retain 20 ms. This changes scheduling only, not
 	  in-flight depth, credit accounting, PID ownership, deadlines or join
 	  admission. Enable only in the dedicated throughput measurement profile.
+
+config MT6797_CCMP_TX_DEPTH
+	int "MT6797 maximum outstanding ordinary data frames"
+	depends on MT6797_CCMP_TX_PUMP
+	range 1 4
+	default 1
+	help
+	  Bound ordinary data TX owners by PID, with the existing TC1 ledger.
+	  Management, security and reserved frames retain their single owner.
+	  Use four only in the dedicated throughput measurement profile.
