From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 19:51:14 -0500
Subject: [PATCH 568/568] media: mediatek: mt6797-seninf: add a capture node

Replace the debugfs capture with a video node and a media graph, sensor to
receiver to CAMSV0. Buffers come from vb2-dma-contig, one in frame buffer control
at a time, and the interrupt completes each when the write count moves.

CAMSV0 still bypasses M4U through its larb2 bit. Only the receiver status stays in
debugfs.
---
 .../media/platform/mediatek/seninf/Kconfig    |    6 +-
 .../platform/mediatek/seninf/mt6797-seninf.c  | 1016 ++++++++++-------
 2 files changed, 636 insertions(+), 386 deletions(-)

diff --git a/drivers/media/platform/mediatek/seninf/Kconfig b/drivers/media/platform/mediatek/seninf/Kconfig
index 9b86b2264..f5cecb049 100644
--- a/drivers/media/platform/mediatek/seninf/Kconfig
+++ b/drivers/media/platform/mediatek/seninf/Kconfig
@@ -2,12 +2,14 @@
 config VIDEO_MT6797_SENINF
 	tristate "MediaTek MT6797 sensor interface"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
-	depends on COMMON_CLK && OF && VIDEO_DEV
+	depends on COMMON_CLK && OF && VIDEO_DEV && MEDIA_CONTROLLER
 	select V4L2_FWNODE
 	select VIDEO_V4L2_SUBDEV_API
+	select VIDEOBUF2_DMA_CONTIG
 	help
 	  The MT6797 sensor interface: the master clocks it drives to camera
-	  sensors, and a two-lane CSI-2 receiver. There is no capture path yet.
+	  sensors, a two-lane CSI-2 receiver, and capture to memory through the
+	  first camera SV block.
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called mt6797-seninf.
diff --git a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
index b813b41af..a6e536d61 100644
--- a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
+++ b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
@@ -4,7 +4,10 @@
  *
  * Each of the block's timing generators drives one master clock pad, divided
  * from the CAMTG clock. The second interface's CSI-2 receiver takes two lanes
- * through to the interface's mux. Nothing takes the data from there yet.
+ * through to the interface's mux, and the first camera SV block writes it to memory.
+ *
+ * CAMSV0 reaches memory through larb2 with its port's M4U translation switched off,
+ * so buffers are physically contiguous and below 4 GiB until M4U is in use here.
  *
  * The analog and calibration values below follow what the vendor's camera
  * library writes. Their meaning is not documented publicly, so they are named
@@ -30,12 +33,16 @@
 #include <linux/pm_runtime.h>
 #include <linux/property.h>
 #include <linux/spinlock.h>
-#include <linux/vmalloc.h>
 
+#include <media/media-device.h>
+#include <media/media-entity.h>
 #include <media/v4l2-async.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-fwnode.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/videobuf2-dma-contig.h>
 #include <media/v4l2-subdev.h>
 
 #define SENINF_TOP_CTRL			0x0000
@@ -173,26 +180,23 @@
 #define CAMSV_TG_SUB_PERIOD		0x574
 #define CAMSV_DMA_FRAME_HEADER_EN	0xc00
 
-#define VIEW_WIDTH			1080
-#define VIEW_HEIGHT			2160
-#define VIEW_SIZE			(VIEW_WIDTH * VIEW_HEIGHT * 4)
-#define VIEW_BLACK			64
+#define CAMSV_INT_HW_PASS1_DON		BIT(10)
+#define CAMSV_INT_ERRORS		(BIT(4) | BIT(5) | BIT(16) | BIT(17))
 
-#define MMSYS_BASE			0x14000000
-#define MMSYS_CG_CON0			0x100
-#define MMSYS_CG0_SMI_COMMON		BIT(0)
+#define CAMSV_FBC_CTL2_WCNT		GENMASK(21, 16)
 
-#define LARB2_BASE			0x1a001000
 #define LARB_MMU_EN			0xfc0
 #define LARB2_PORT_CAM_SV0		BIT(6)
 
-#define CAPTURE_WIDTH			2592
-#define CAPTURE_HEIGHT			1944
-#define CAPTURE_STRIDE			(CAPTURE_WIDTH * 10 / 8)
-#define CAPTURE_SIZE			(CAPTURE_STRIDE * CAPTURE_HEIGHT)
-#define CAPTURE_GUARD			4096
-#define CAPTURE_GUARD_BYTE		0x5a
-#define CAPTURE_FILL_BYTE		0xa5
+#define CAPTURE_MAX_WIDTH		2592
+#define CAPTURE_MAX_HEIGHT		1944
+#define CAPTURE_BYTESPERLINE(w)		((w) * 10 / 8)
+#define CAPTURE_MBUS_CODE		MEDIA_BUS_FMT_SGRBG10_1X10
+/* Longer than a frame at the slowest rate the sensor's default mode runs. */
+#define CAPTURE_STOP_MS			40
+
+#define SENINF_PAD_SINK			0
+#define SENINF_PAD_SOURCE		1
 
 #define SENINF_RX_IF			1	/* The second interface. */
 #define SENINF_RX_LANES			2
@@ -223,6 +227,11 @@ struct seninf_mclk {
 	unsigned int tg;
 };
 
+struct seninf_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+};
+
 struct mt6797_seninf {
 	struct device *dev;
 	void __iomem *base;
@@ -243,12 +252,25 @@ struct mt6797_seninf {
 
 	void __iomem *camsv;
 	struct clk *camsv_clk, *larb_clk;
-	u32 *view;
-	struct debugfs_blob_wrapper view_blob;
-	u32 view_flip;
-	void *frame;
-	dma_addr_t frame_dma;
-	struct debugfs_blob_wrapper frame_blob;
+	void __iomem *larb;
+	struct clk *smi_clk;
+	int irq;
+
+	struct media_device mdev;
+	struct media_pad pads[2];
+	struct media_pad video_pad;
+	struct media_pipeline pipe;
+	struct video_device vdev;
+	struct vb2_queue queue;
+	struct mutex video_lock;	/* The video node and its queue. */
+	struct v4l2_pix_format fmt;
+	bool registered;
+
+	spinlock_t buf_lock;		/* The two below and the sequence. */
+	struct list_head buffers;
+	struct seninf_buffer *cur;
+	u32 last_wcnt;
+	u32 sequence;
 };
 
 static void seninf_update(struct mt6797_seninf *seninf, u32 reg, u32 mask, u32 val)
@@ -476,10 +498,506 @@ static const struct v4l2_subdev_video_ops seninf_video_ops = {
 	.s_stream = seninf_s_stream,
 };
 
+static const struct v4l2_mbus_framefmt seninf_default_fmt = {
+	.width = CAPTURE_MAX_WIDTH,
+	.height = CAPTURE_MAX_HEIGHT,
+	.code = CAPTURE_MBUS_CODE,
+	.field = V4L2_FIELD_NONE,
+	.colorspace = V4L2_COLORSPACE_RAW,
+};
+
+static int seninf_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SINK) = seninf_default_fmt;
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SOURCE) = seninf_default_fmt;
+	return 0;
+}
+
+static int seninf_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = CAPTURE_MBUS_CODE;
+	return 0;
+}
+
+static int seninf_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *format = &fmt->format;
+
+	/* The source follows the sink. */
+	if (fmt->pad == SENINF_PAD_SOURCE)
+		return v4l2_subdev_get_fmt(sd, state, fmt);
+
+	format->code = CAPTURE_MBUS_CODE;
+	format->width = clamp_t(u32, ALIGN_DOWN(format->width, 4), 4, CAPTURE_MAX_WIDTH);
+	format->height = clamp_t(u32, ALIGN_DOWN(format->height, 2), 2, CAPTURE_MAX_HEIGHT);
+	format->field = V4L2_FIELD_NONE;
+	format->colorspace = V4L2_COLORSPACE_RAW;
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SINK) = *format;
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SOURCE) = *format;
+	return 0;
+}
+
+static const struct v4l2_subdev_pad_ops seninf_pad_ops = {
+	.enum_mbus_code = seninf_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = seninf_set_fmt,
+	.link_validate = v4l2_subdev_link_validate_default,
+};
+
+static const struct v4l2_subdev_internal_ops seninf_internal_ops = {
+	.init_state = seninf_init_state,
+};
+
+static const struct media_entity_operations seninf_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
 static const struct v4l2_subdev_ops seninf_subdev_ops = {
 	.video = &seninf_video_ops,
+	.pad = &seninf_pad_ops,
+};
+
+static struct seninf_buffer *to_seninf_buffer(struct vb2_v4l2_buffer *vb)
+{
+	return container_of(vb, struct seninf_buffer, vb);
+}
+
+/* Give frame buffer control the next buffer. Called with buf_lock held. */
+static void camsv_arm_next(struct mt6797_seninf *seninf)
+{
+	void __iomem *sv = seninf->camsv;
+	struct seninf_buffer *buf;
+
+	if (seninf->cur)
+		return;
+	buf = list_first_entry_or_null(&seninf->buffers, struct seninf_buffer, list);
+	if (!buf)
+		return;
+	list_del(&buf->list);
+	seninf->cur = buf;
+	writel(lower_32_bits(vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0)),
+	       sv + CAMSV_FBC_IMGO_ENQ_ADDR);
+	writel(readl(sv + CAMSV_IMGO_FBC) | CAMSV_IMGO_FBC_RCNT_INC, sv + CAMSV_IMGO_FBC);
+}
+
+/*
+ * One buffer at a time: the hardware takes a buffer at a frame start and counts it
+ * written at the frame's end, and with none it drops the frame and counts that.
+ */
+static irqreturn_t camsv_irq(int irq, void *data)
+{
+	struct mt6797_seninf *seninf = data;
+	void __iomem *sv = seninf->camsv;
+	u32 status = readl(sv + CAMSV_INT_STATUS);
+	struct seninf_buffer *done = NULL;
+	u32 wcnt;
+
+	if (status & CAMSV_INT_ERRORS)
+		dev_warn_ratelimited(seninf->dev, "camsv status %08x, dma %08x\n", status,
+				     readl(sv + CAMSV_IMGO_ERR_STAT));
+	if (!(status & CAMSV_INT_HW_PASS1_DON))
+		return status ? IRQ_HANDLED : IRQ_NONE;
+
+	spin_lock(&seninf->buf_lock);
+	wcnt = FIELD_GET(CAMSV_FBC_CTL2_WCNT, readl(sv + CAMSV_FBC_IMGO_CTL2));
+	if (seninf->cur && wcnt != seninf->last_wcnt) {
+		done = seninf->cur;
+		seninf->cur = NULL;
+		seninf->last_wcnt = wcnt;
+		done->vb.sequence = seninf->sequence;
+	}
+	seninf->sequence++;
+	camsv_arm_next(seninf);
+	spin_unlock(&seninf->buf_lock);
+
+	if (done) {
+		done->vb.vb2_buf.timestamp = ktime_get_ns();
+		done->vb.field = V4L2_FIELD_NONE;
+		vb2_set_plane_payload(&done->vb.vb2_buf, 0, seninf->fmt.sizeimage);
+		vb2_buffer_done(&done->vb.vb2_buf, VB2_BUF_STATE_DONE);
+	}
+	return IRQ_HANDLED;
+}
+
+static int camsv_reset(struct mt6797_seninf *seninf)
+{
+	void __iomem *sv = seninf->camsv;
+	u32 val;
+	int ret;
+
+	writel(CAMSV_SW_CTL_SW_RST, sv + CAMSV_SW_CTL);
+	writel(0, sv + CAMSV_SW_CTL);
+	writel(CAMSV_SW_CTL_RST_TRIG, sv + CAMSV_SW_CTL);
+	ret = readl_poll_timeout(sv + CAMSV_SW_CTL, val,
+				 val == (CAMSV_SW_CTL_RST_TRIG | CAMSV_SW_CTL_RST_STA),
+				 100, 100000);
+	writel(0, sv + CAMSV_SW_CTL);
+	return ret;
+}
+
+static void camsv_start(struct mt6797_seninf *seninf)
+{
+	void __iomem *sv = seninf->camsv;
+	u32 width = seninf->fmt.width, height = seninf->fmt.height;
+	u32 val;
+	unsigned int i;
+
+	/* All the CAMSV inputs take this interface's mux. */
+	val = readl(seninf->base + SENINF_TOP_CAM_MUX);
+	for (i = 2; i < 8; i++)
+		val = (val & ~SENINF_TOP_CAM_MUX_SEL(i)) | (SENINF_RX_IF << (4 * i));
+	writel(val, seninf->base + SENINF_TOP_CAM_MUX);
+
+	writel(CAMSV_CLK_EN_VAL, sv + CAMSV_CLK_EN);
+	writel(readl(sv + CAMSV_TG_SEN_MODE) & ~CAMSV_TG_SEN_MODE_CLR, sv + CAMSV_TG_SEN_MODE);
+	writel(0, sv + CAMSV_TG_SUB_PERIOD);
+	writel(width << 16, sv + CAMSV_TG_SEN_GRAB_PXL);
+	writel(height << 16, sv + CAMSV_TG_SEN_GRAB_LIN);
+	writel(CAMSV_FMT_SEL_BAYER10, sv + CAMSV_FMT_SEL);
+	writel((readl(sv + CAMSV_PAK) & ~CAMSV_PAK_MASK) | CAMSV_PAK_RAW10, sv + CAMSV_PAK);
+	writel(0, sv + CAMSV_DMA_FRAME_HEADER_EN);
+	writel(readl(sv + CAMSV_DMA_RSV1) & ~BIT(31), sv + CAMSV_DMA_RSV1);
+	writel(0xffffffff, sv + CAMSV_DMA_RSV6);
+	writel(readl(sv + CAMSV_SPECIAL_FUN_EN) | CAMSV_SPECIAL_FUN_VAL, sv + CAMSV_SPECIAL_FUN_EN);
+
+	writel(0, sv + CAMSV_IMGO_OFST_ADDR);
+	writel(seninf->fmt.bytesperline - 1, sv + CAMSV_IMGO_XSIZE);
+	writel(height - 1, sv + CAMSV_IMGO_YSIZE);
+	writel(seninf->fmt.bytesperline | CAMSV_IMGO_STRIDE_BUS16, sv + CAMSV_IMGO_STRIDE);
+	writel(0, sv + CAMSV_IMGO_CROP);
+
+	/* Queue mode: only an enqueued buffer is written. No subsampling. */
+	writel(0, sv + CAMSV_FBC_IMGO_CTL1);
+	writel(CAMSV_FBC_IMGO_CTL1_MODE_QUEUE, sv + CAMSV_FBC_IMGO_CTL1);
+	writel(CAMSV_FBC_IMGO_CTL1_MODE_QUEUE | CAMSV_FBC_IMGO_CTL1_EN, sv + CAMSV_FBC_IMGO_CTL1);
+
+	spin_lock_irq(&seninf->buf_lock);
+	seninf->sequence = 0;
+	seninf->last_wcnt = 0;
+	camsv_arm_next(seninf);
+	if (seninf->cur)
+		writel(lower_32_bits(vb2_dma_contig_plane_dma_addr(&seninf->cur->vb.vb2_buf, 0)),
+		       sv + CAMSV_IMGO_BASE_ADDR);
+	spin_unlock_irq(&seninf->buf_lock);
+
+	writel(CAMSV_MODULE_EN_TG | CAMSV_MODULE_EN_PAK | CAMSV_MODULE_EN_IMGO |
+	       CAMSV_MODULE_EN_DB, sv + CAMSV_MODULE_EN);
+	writel(CAMSV_INT_HW_PASS1_DON | CAMSV_INT_ERRORS, sv + CAMSV_INT_EN);
+	readl(sv + CAMSV_INT_STATUS);
+	enable_irq(seninf->irq);
+
+	writel(readl(sv + CAMSV_TG_SEN_MODE) | CAMSV_TG_SEN_MODE_CMOS_EN, sv + CAMSV_TG_SEN_MODE);
+	writel((readl(sv + CAMSV_TG_VF_CON) & ~CAMSV_TG_VF_CON_SINGLE) | CAMSV_TG_VF_CON_EN,
+	       sv + CAMSV_TG_VF_CON);
+}
+
+/* Returns with the DMA idle, so buffers can go back to their owner. */
+static void camsv_stop(struct mt6797_seninf *seninf)
+{
+	void __iomem *sv = seninf->camsv;
+
+	writel(readl(sv + CAMSV_TG_VF_CON) & ~CAMSV_TG_VF_CON_EN, sv + CAMSV_TG_VF_CON);
+	writel(readl(sv + CAMSV_TG_SEN_MODE) & ~CAMSV_TG_SEN_MODE_CMOS_EN, sv + CAMSV_TG_SEN_MODE);
+	msleep(CAPTURE_STOP_MS);
+	writel(0, sv + CAMSV_INT_EN);
+	disable_irq(seninf->irq);
+	writel(0, sv + CAMSV_MODULE_EN);
+	if (camsv_reset(seninf))
+		dev_warn(seninf->dev, "camsv reset timed out on stop\n");
+}
+
+static void camsv_return_buffers(struct mt6797_seninf *seninf, enum vb2_buffer_state state)
+{
+	struct seninf_buffer *buf, *tmp;
+	LIST_HEAD(buffers);
+
+	spin_lock_irq(&seninf->buf_lock);
+	list_splice_init(&seninf->buffers, &buffers);
+	if (seninf->cur)
+		list_add_tail(&seninf->cur->list, &buffers);
+	seninf->cur = NULL;
+	spin_unlock_irq(&seninf->buf_lock);
+
+	list_for_each_entry_safe(buf, tmp, &buffers, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+}
+
+static int seninf_queue_setup(struct vb2_queue *q, unsigned int *num_buffers,
+			      unsigned int *num_planes, unsigned int sizes[],
+			      struct device *alloc_devs[])
+{
+	struct mt6797_seninf *seninf = vb2_get_drv_priv(q);
+
+	if (*num_planes)
+		return sizes[0] < seninf->fmt.sizeimage ? -EINVAL : 0;
+	*num_planes = 1;
+	sizes[0] = seninf->fmt.sizeimage;
+	return 0;
+}
+
+static int seninf_buf_prepare(struct vb2_buffer *vb)
+{
+	struct mt6797_seninf *seninf = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (vb2_plane_size(vb, 0) < seninf->fmt.sizeimage)
+		return -EINVAL;
+	/* The DMA address register is 32 bits wide. */
+	if (upper_32_bits(vb2_dma_contig_plane_dma_addr(vb, 0)))
+		return -EINVAL;
+	return 0;
+}
+
+static void seninf_buf_queue(struct vb2_buffer *vb)
+{
+	struct mt6797_seninf *seninf = vb2_get_drv_priv(vb->vb2_queue);
+	struct seninf_buffer *buf = to_seninf_buffer(to_vb2_v4l2_buffer(vb));
+	unsigned long flags;
+
+	spin_lock_irqsave(&seninf->buf_lock, flags);
+	list_add_tail(&buf->list, &seninf->buffers);
+	if (vb2_is_streaming(vb->vb2_queue))
+		camsv_arm_next(seninf);
+	spin_unlock_irqrestore(&seninf->buf_lock, flags);
+}
+
+static int seninf_check_format(struct mt6797_seninf *seninf)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = SENINF_PAD_SOURCE,
+	};
+	int ret;
+
+	ret = v4l2_subdev_call_state_active(&seninf->sd, pad, get_fmt, &fmt);
+	if (ret)
+		return ret;
+	if (fmt.format.width != seninf->fmt.width || fmt.format.height != seninf->fmt.height)
+		return -EPIPE;
+	return 0;
+}
+
+static int seninf_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct mt6797_seninf *seninf = vb2_get_drv_priv(q);
+	u32 val;
+	int ret;
+
+	ret = video_device_pipeline_start(&seninf->vdev, &seninf->pipe);
+	if (ret)
+		goto err_return;
+	ret = seninf_check_format(seninf);
+	if (ret)
+		goto err_pipeline;
+
+	ret = v4l2_subdev_call(&seninf->sd, video, s_stream, 1);
+	if (ret)
+		goto err_pipeline;
+
+	ret = clk_prepare_enable(seninf->smi_clk);
+	if (ret)
+		goto err_stream;
+	ret = clk_prepare_enable(seninf->larb_clk);
+	if (ret)
+		goto err_smi;
+	ret = clk_prepare_enable(seninf->camsv_clk);
+	if (ret)
+		goto err_larb;
+
+	/* The larb's state does not survive the domain powering off. */
+	val = readl(seninf->larb + LARB_MMU_EN) & ~LARB2_PORT_CAM_SV0;
+	writel(val, seninf->larb + LARB_MMU_EN);
+	if (readl(seninf->larb + LARB_MMU_EN) & LARB2_PORT_CAM_SV0) {
+		dev_err(seninf->dev, "larb2 will not bypass M4U\n");
+		ret = -EIO;
+		goto err_camsv;
+	}
+
+	/* Let the stream settle, so the first frame starts clean. */
+	msleep(100);
+
+	ret = camsv_reset(seninf);
+	if (ret) {
+		dev_err(seninf->dev, "camsv reset timed out\n");
+		goto err_camsv;
+	}
+	camsv_start(seninf);
+	return 0;
+
+err_camsv:
+	clk_disable_unprepare(seninf->camsv_clk);
+err_larb:
+	clk_disable_unprepare(seninf->larb_clk);
+err_smi:
+	clk_disable_unprepare(seninf->smi_clk);
+err_stream:
+	v4l2_subdev_call(&seninf->sd, video, s_stream, 0);
+err_pipeline:
+	video_device_pipeline_stop(&seninf->vdev);
+err_return:
+	camsv_return_buffers(seninf, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void seninf_stop_streaming(struct vb2_queue *q)
+{
+	struct mt6797_seninf *seninf = vb2_get_drv_priv(q);
+
+	camsv_stop(seninf);
+	clk_disable_unprepare(seninf->camsv_clk);
+	clk_disable_unprepare(seninf->larb_clk);
+	clk_disable_unprepare(seninf->smi_clk);
+	v4l2_subdev_call(&seninf->sd, video, s_stream, 0);
+	video_device_pipeline_stop(&seninf->vdev);
+	camsv_return_buffers(seninf, VB2_BUF_STATE_ERROR);
+}
+
+static const struct vb2_ops seninf_vb2_ops = {
+	.queue_setup = seninf_queue_setup,
+	.buf_prepare = seninf_buf_prepare,
+	.buf_queue = seninf_buf_queue,
+	.start_streaming = seninf_start_streaming,
+	.stop_streaming = seninf_stop_streaming,
+};
+
+static int seninf_querycap(struct file *file, void *fh, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, "mt6797-seninf", sizeof(cap->driver));
+	strscpy(cap->card, "MT6797 CAMSV0", sizeof(cap->card));
+	return 0;
+}
+
+static int seninf_enum_fmt(struct file *file, void *fh, struct v4l2_fmtdesc *f)
