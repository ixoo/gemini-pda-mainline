+static void seninf_fill_fmt(struct v4l2_pix_format *fmt)
+{
+	fmt->pixelformat = V4L2_PIX_FMT_MTISP_SGRBG10;
+	fmt->width = clamp_t(u32, ALIGN_DOWN(fmt->width, 4), 4, CAPTURE_MAX_WIDTH);
+	fmt->height = clamp_t(u32, ALIGN_DOWN(fmt->height, 2), 2, CAPTURE_MAX_HEIGHT);
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->bytesperline = CAPTURE_BYTESPERLINE(fmt->width);
+	fmt->sizeimage = fmt->bytesperline * fmt->height;
