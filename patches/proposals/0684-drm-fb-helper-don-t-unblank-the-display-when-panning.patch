From 32a81b4eac1fd4b00d6e4c0e401177598c33bb3b Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 10 Nov 2026 17:48:38 -0500
Subject: [PATCH] drm/fb-helper: don't unblank the display when panning

An atomic pan commits the client's modesets with the CRTC active. fbcon pans
whenever it redraws, which includes the redraw after a system resume, so a
display that was blanked through fbdev comes back on: with a rotated console the
redraw always pans.

While the display is blanked, record the offsets without committing. The unblank
commits the modesets, offsets included.
---
 drivers/gpu/drm/drm_fb_helper.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/gpu/drm/drm_fb_helper.c b/drivers/gpu/drm/drm_fb_helper.c
index 1541fc8..b51cde4 100644
--- a/drivers/gpu/drm/drm_fb_helper.c
+++ b/drivers/gpu/drm/drm_fb_helper.c
@@ -1190,6 +1190,16 @@ static int pan_display_atomic(struct fb_var_screeninfo *var,
 	dy = var->yoffset - info->var.yoffset;
 	pan_set(fb_helper, dx, dy);
 
+	/*
+	 * A commit would make the CRTC active again. While blanked, only record the
+	 * offsets: the unblank commits them.
+	 */
+	if (info->blank != FB_BLANK_UNBLANK) {
+		info->var.xoffset = var->xoffset;
+		info->var.yoffset = var->yoffset;
+		return 0;
+	}
+
 	ret = drm_client_modeset_commit_locked(&fb_helper->client);
 	if (!ret) {
 		info->var.xoffset = var->xoffset;
