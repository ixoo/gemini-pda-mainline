From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 18 Nov 2026 21:03:24 -0500
Subject: [PATCH] soc: mediatek: mt6797-spm-sleep: wait for IM ready, not IM
 empty

PCM_FSM_STA's IM state is one-hot. The vendor's CPU-DVFS SPM driver, on
the same PCM block, names bits 7, 8 and 9 IM empty, filling and ready,
and spins on IM ready after its IM kick. 0827's poll waited for the
idle value, which is IM empty after the PCM reset and never returns after
an IM kick, so it refused every period whatever the fetch did.

Wait for bit 9 (IM ready) instead (stage D5q).
---
 drivers/soc/mediatek/mt6797-spm-sleep.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-spm-sleep.c b/drivers/soc/mediatek/mt6797-spm-sleep.c
index 2872ed1cf..0c49b0d98 100644
--- a/drivers/soc/mediatek/mt6797-spm-sleep.c
+++ b/drivers/soc/mediatek/mt6797-spm-sleep.c
@@ -150,7 +150,8 @@ static const u8 sodi_fw_sha256[SHA256_DIGEST_SIZE] = {
 /* event lock, SRAM isolation and sleep, non-replace IM, MIF and SCP APB */
 #define PCM_CON1_INIT		0x5c48
 #define PCM_FSM_STA_DEF		0x48490
-#define PCM_FSM_IM_STATE(v)	(((v) >> 7) & 7)
+/* PCM_FSM_STA's IM state is one-hot: empty, filling, ready */
+#define PCM_FSM_IM_REDY		BIT(9)
 /* How long the IM fetch may take before the PCM kick (D5q) */
 #define SODI_IM_WAIT_US		200
 #define PCM_RF_SYNC_R0		BIT(16)
@@ -241,7 +242,7 @@ MODULE_PARM_DESC(sodi_pcm_wdt, "SODI: the PCM watchdog ends a stuck test period
 
 static bool sodi_im_wait;
 module_param(sodi_im_wait, bool, 0644);
-MODULE_PARM_DESC(sodi_im_wait, "SODI: refuse a test period whose IM fetch has not settled before the kick");
+MODULE_PARM_DESC(sodi_im_wait, "SODI: refuse a test period whose IM fetch is not ready before the kick");
 
 static bool sodi_im_reuse;
 module_param(sodi_im_reuse, bool, 0644);
@@ -328,7 +329,7 @@ struct spm_wake {
 	u32 wfi_loops;
 	u32 fsm;		/* PCM_FSM_STA after the wait */
 	u32 im_fsm0, im_fsm1;	/* after the IM kick, before the PCM kick */
-	u32 im_us;		/* polls until IM_STATE settled */
+	u32 im_us;		/* polls until IM ready */
 	u32 on_val0, on_val1;	/* r0 and r7 start values, at entry */
 	u32 r0, r7;		/* after the return */
 	bool im_reused, im_stuck;
@@ -941,12 +942,11 @@ static int spm_run(const struct spm_scen *sc)
 	spm_wr(SPM_SW_RSV_0, 0);
 	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) | SPM_LOCK_INFRA_DCM);
 
-	/* D5q: has the IM fetch settled? Refuse the period if not */
+	/* D5q: is the IM fetch ready? Refuse the period if not */
 	for (i = 0; ; i++) {
 		s.wake.im_fsm1 = spm_rd(PCM_FSM_STA);
 		if (!sc->im_wait || i >= SODI_IM_WAIT_US ||
-		    PCM_FSM_IM_STATE(s.wake.im_fsm1) ==
-		    PCM_FSM_IM_STATE(PCM_FSM_STA_DEF))
+		    (s.wake.im_fsm1 & PCM_FSM_IM_REDY))
 			break;
 		udelay(1);
 	}
-- 
2.43.0

