From 6fa0a699465dc996430c1ee53c0fe2f0a4ba3886 Mon Sep 17 00:00:00 2001
From: Gemini PDA experiment <experiment.invalid>
Date: Tue, 29 Sep 2026 19:40:40 -0400
Subject: [PATCH 2/3] soc: mediatek: defer WLAN START until WMT setup

Keep active resources idle at probe. Admit one root-triggered firmware
start only after a separate one-shot WMT setup and a fresh OFF-domain,
region and remap readback. The host can preserve the private window
before clearing it.

Internal experiment only; synthetic non-certifying author, no DCO.
---
 .../boot/dts/mediatek/mt6797-gemini-pda.dts   |  15 ++-
 drivers/soc/mediatek/mt6797-consys.c          | 102 +++++++++++++++---
 2 files changed, 102 insertions(+), 15 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
index 830a9a3..df06404 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -78,9 +78,20 @@
 
 	consys@10001340 {
 		compatible = "mediatek,mt6797-consys";
-		reg = <0 0x10001340 0 4>;
-		reg-names = "remap";
+		reg = <0 0x10001340 0 4>, <0 0x10001350 0 4>,
+		      <0 0x18070008 0 4>, <0 0x18070110 0 4>,
+		      <0 0x180f0000 0 0x1100>, <0 0x10001f00 0 4>;
+		reg-names = "remap", "conn2ap-sleep-mask", "chip-id", "mcu-acr",
+			    "wifi-hif", "emi-selector";
+		mediatek,one-shot-power-probe;
+		mediatek,one-shot-chip-id-probe;
+		mediatek,one-shot-reset-release-probe;
+		mediatek,one-shot-hif-probe;
+		mediatek,one-shot-emi-set-probe;
+		mediatek,one-shot-emi-copy-probe;
+		mediatek,one-shot-firmware-start-probe;
 		mediatek,one-shot-region19-observe;
+		mediatek,deferred-wmt-firmware-start;
 		memory-region = <&consys_reserved>;
 		vcn18-supply = <&mt6351_vcn18_reg>;
 		vcn28-supply = <&mt6351_vcn28_reg>;
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index a36c117..465e2b0 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -96,6 +96,9 @@ struct mt6797_consys {
 	struct mt6797_hif *fw_hif;
 	bool fw_start_attempted;
 	bool wmt_init_attempted;
+	bool wmt_init_complete;
+	bool deferred_start_armed;
+	bool deferred_start_attempted;
 };
 
 static DEFINE_MUTEX(mt6797_consys_lock);
@@ -331,12 +334,10 @@ static BIN_ATTR_ADMIN_RO(region19_snapshot, SZ_512K);
 
 static u32 mt6797_consys_read_emi(u32 offset);
 
-/* A root-triggered, single-use memory setup; no CONN power or firmware action. */
-static ssize_t region19_prepare_store(struct device *dev,
-				      struct device_attribute *attr,
-				      const char *buf, size_t count)
+/* Called with the owner lock held; no CONN power or firmware action. */
+static int mt6797_consys_prepare_wmt(struct device *dev,
+				    struct mt6797_consys *owner)
 {
-	struct mt6797_consys *owner = dev_get_drvdata(dev);
 	struct arm_smccc_res res;
 	phys_addr_t start, end;
 	u32 remap_before, remap_after, requested, expected_range;
@@ -345,9 +346,6 @@ static ssize_t region19_prepare_store(struct device *dev,
 	unsigned int i;
 	int ret;
 
-	if (count != 2 || memcmp(buf, "1\n", 2))
-		return -EINVAL;
-	mutex_lock(&mt6797_consys_lock);
 	if (owner != &mt6797_consys || !owner->bound ||
 	    !owner->region19_window || owner->wmt_init_attempted) {
 		ret = -ENODEV;
@@ -425,16 +423,30 @@ static ssize_t region19_prepare_store(struct device *dev,
 	}
 	dev_info(dev, "one-shot WMT setup complete: clear=%u verified, CONN held off\n",
 		 MT6797_WMT_CLEAR_BYTES);
-	ret = count;
+	owner->wmt_init_complete = true;
+	ret = 0;
 	goto out;
 
 stopped:
 	dev_err(dev, "one-shot WMT setup stopped (%d); state retained\n", ret);
 out:
-	mutex_unlock(&mt6797_consys_lock);
 	return ret;
 }
 
+static ssize_t region19_prepare_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	int ret;
+
+	if (count != 2 || memcmp(buf, "1\n", 2))
+		return -EINVAL;
+	mutex_lock(&mt6797_consys_lock);
+	ret = mt6797_consys_prepare_wmt(dev, dev_get_drvdata(dev));
+	mutex_unlock(&mt6797_consys_lock);
+	return ret ?: count;
+}
+
 static DEVICE_ATTR_WO(region19_prepare);
 
 /* Associate with CONN only after acquiring the independent shared resources. */
@@ -1190,6 +1202,54 @@ held:
 	dev_err(dev, "one-shot CONN power probe stopped (%d); state retained\n", ret);
 }
 
+/* One root request after the caller preserved and prepared the WMT window. */
+static ssize_t firmware_start_after_wmt_store(struct device *dev,
+					      struct device_attribute *attr,
+					      const char *buf, size_t count)
+{
+	struct mt6797_consys *owner = dev_get_drvdata(dev);
+	int ret;
+
+	if (count != 2 || memcmp(buf, "1\n", 2))
+		return -EINVAL;
+	mutex_lock(&mt6797_consys_lock);
+	if (owner != &mt6797_consys || !owner->bound ||
+	    !owner->deferred_start_armed || !owner->wmt_init_complete ||
+	    owner->deferred_start_attempted) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = mtk_pm_domain_confirmed_off(owner->conn_domain);
+	if (ret)
+		goto out;
+	if (mt6797_consys_read_emi(MT6797_EMI_REGION19_RANGE) !=
+	    (((u32)((owner->reservation.start + SZ_512K) >> 16) << 16) |
+	     (u32)((owner->reservation.start + SZ_1M - 1) >> 16)) ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION19_POLICY) !=
+						MT6797_EMI_COPY_POLICY ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION1_RANGE) != 0x44604460 ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION18_RANGE) ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION18_POLICY) ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION23_RANGE) ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION23_POLICY) ||
+	    readl(owner->remap) !=
+		(MT6797_REMAP_OFF_VALUE |
+		 ((u32)owner->reservation.start >> 20) | BIT(12))) {
+		ret = -EBUSY;
+		goto out;
+	}
+	owner->deferred_start_attempted = true;
+	dev_info(dev, "one-shot WLAN after WMT: prepower admission passed\n");
+	mt6797_consys_probe_power_on(dev, owner, true, true, true, true,
+				     true, true);
+	ret = 0;
+out:
+	mutex_unlock(&mt6797_consys_lock);
+	return ret ?: count;
+}
+
+static DEVICE_ATTR_WO(firmware_start_after_wmt);
+
 static int mt6797_consys_probe(struct platform_device *pdev)
 {
 	struct resource *remap_resource, *sleep_resource, *chip_resource, *acr_resource;
@@ -1203,7 +1263,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	void __iomem *hif = NULL, *emi_selector = NULL;
 	bool power_probe, chip_id_probe, reset_release_probe, hif_probe;
 	bool emi_set_probe, emi_copy_probe, firmware_start_probe;
-	bool region19_observe;
+	bool region19_observe, deferred_start;
 	struct resource reservation = {};
 	int ret;
 
@@ -1224,7 +1284,14 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 						   "mediatek,one-shot-firmware-start-probe");
 	region19_observe = of_property_read_bool(pdev->dev.of_node,
 						 "mediatek,one-shot-region19-observe");
-	if (region19_observe && power_probe) {
+	deferred_start = of_property_read_bool(pdev->dev.of_node,
+						"mediatek,deferred-wmt-firmware-start");
+	if (region19_observe && power_probe && !deferred_start) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (deferred_start && (!region19_observe || !power_probe ||
+			       !firmware_start_probe)) {
 		ret = -EINVAL;
 		goto out_unlock;
 	}
@@ -1401,6 +1468,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	mt6797_consys.conmcu_reset = conmcu_reset;
 	mt6797_consys.conn_domain = conn_domain;
 	mt6797_consys.bound = true;
+	mt6797_consys.deferred_start_armed = deferred_start;
 	platform_set_drvdata(pdev, &mt6797_consys);
 	ret = devm_of_platform_populate(&pdev->dev);
 	if (ret) {
@@ -1432,9 +1500,17 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 				"one-shot region 19 private export failed (%d)\n", observed);
 		}
 	}
+	if (deferred_start && mt6797_consys.region19_window) {
+		ret = device_create_file(&pdev->dev,
+					 &dev_attr_firmware_start_after_wmt);
+		if (ret)
+			dev_err(&pdev->dev,
+				"one-shot WMT firmware trigger unavailable (%d)\n", ret);
+		ret = 0;
+	}
 	dev_info(&pdev->dev,
 		 "bound boot CONSYS reserve, remap, VCN, CONMCU reset and checked-OFF CONN domain; populated passive children\n");
-	if (power_probe)
+	if (power_probe && !deferred_start)
 		mt6797_consys_probe_power_on(&pdev->dev, &mt6797_consys,
 					    chip_id_probe, reset_release_probe,
 					    hif_probe, emi_set_probe,
