+	mt6797_consys.bt_hci = bt_hci;
 	mt6797_consys.common_init.antenna_mode = antenna_mode;
 	mt6797_consys.conmcu_reset = conmcu_reset;
 	mt6797_consys.conn_domain = conn_domain;
diff --git a/include/linux/soc/mediatek/mt6797-bt.h b/include/linux/soc/mediatek/mt6797-bt.h
new file mode 100644
index 000000000..d1e432924
--- /dev/null
+++ b/include/linux/soc/mediatek/mt6797-bt.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __SOC_MEDIATEK_MT6797_BT_H
+#define __SOC_MEDIATEK_MT6797_BT_H
+
+#include <linux/types.h>
+
+/*
+ * Bluetooth client of the MT6797 CONSYS persistent STP link (task 0).
+ * rx runs in hard IRQ context under the link lock: it must not sleep, must
+ * copy the payload and return nonzero to refuse it (the peer then resends).
+ * failed runs in process context once, after the link stops.
+ */
+struct mt6797_bt_ops {
+	int (*rx)(void *context, const u8 *payload, unsigned int length);
+	void (*failed)(void *context);
+};
+
+int mt6797_consys_bt_attach(const struct mt6797_bt_ops *ops, void *context);
+void mt6797_consys_bt_detach(void);
+int mt6797_consys_bt_send(const u8 *h4, unsigned int length);
+
+#endif
