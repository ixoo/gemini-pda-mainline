From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 17:28:49 -0500
Subject: [PATCH 558/558] media: mediatek: mt6797-seninf: DIAGNOSTIC, capture
 one frame through debugfs

Bring-up only. Run the first CAMSV in single mode into a coherent buffer, bounded
by its size registers, with a guard after the buffer and the frame readable
through debugfs. Register use follows the vendor library, with names from the
vendor kernel. Not exercised on hardware.
---
 .../platform/mediatek/seninf/mt6797-seninf.c  | 226 ++++++++++++++++++
 1 file changed, 226 insertions(+)

diff --git a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
index 424082bec..130b21f22 100644
--- a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
+++ b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
@@ -19,7 +19,9 @@
 #include <linux/clk-provider.h>
 #include <linux/debugfs.h>
 #include <linux/delay.h>
+#include <linux/dma-mapping.h>
 #include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/overflow.h>
@@ -111,6 +113,58 @@
 #define MIPI_RX_CON80			0x80
 #define MIPI_RX_CON80_MASK		GENMASK(7, 4)
 
+#define SENINF_TOP_CAM_MUX		0x0010
+#define SENINF_TOP_CAM_MUX_SEL(n)	(GENMASK(3, 0) << (4 * (n)))
+
+/* CAMSV register names are the ones in the vendor kernel's camera_isp.c. */
+#define CAMSV_MODULE_EN			0x010
+#define CAMSV_MODULE_EN_TG		BIT(0)
+#define CAMSV_MODULE_EN_PAK		BIT(2)
+#define CAMSV_MODULE_EN_IMGO		BIT(4)
+#define CAMSV_MODULE_EN_DB		BIT(30)
+#define CAMSV_FMT_SEL			0x014
+#define CAMSV_FMT_SEL_BAYER10		1
+#define CAMSV_INT_EN			0x018
+#define CAMSV_INT_STATUS		0x01c
+#define CAMSV_SW_CTL			0x020
+#define CAMSV_SW_CTL_RST_TRIG		BIT(0)
+#define CAMSV_SW_CTL_RST_STA		BIT(1)
+#define CAMSV_SW_CTL_SW_RST		BIT(2)
+#define CAMSV_CLK_EN			0x030
+#define CAMSV_CLK_EN_VAL		(BIT(0) | BIT(2) | BIT(15))
+#define CAMSV_PAK			0x04c
+#define CAMSV_PAK_MASK			GENMASK(5, 0)
+#define CAMSV_PAK_RAW10			1
+#define CAMSV_SPECIAL_FUN_EN		0x218
+#define CAMSV_SPECIAL_FUN_VAL		0x61000000
+#define CAMSV_IMGO_BASE_ADDR		0x220
+#define CAMSV_IMGO_OFST_ADDR		0x228
+#define CAMSV_IMGO_XSIZE		0x230
+#define CAMSV_IMGO_YSIZE		0x234
+#define CAMSV_IMGO_STRIDE		0x238
+#define CAMSV_IMGO_STRIDE_BUS16		0x1010000
+#define CAMSV_IMGO_CROP			0x248
+#define CAMSV_DMA_RSV1			0x470
+#define CAMSV_DMA_RSV6			0x484
+#define CAMSV_TG_SEN_MODE		0x500
+#define CAMSV_TG_SEN_MODE_CMOS_EN	BIT(0)
+#define CAMSV_TG_SEN_MODE_CLR		(BIT(1) | BIT(13) | BIT(17) | BIT(18))
+#define CAMSV_TG_VF_CON			0x504
+#define CAMSV_TG_VF_CON_EN		BIT(0)
+#define CAMSV_TG_VF_CON_SINGLE		BIT(1)
+#define CAMSV_TG_SEN_GRAB_PXL		0x508
+#define CAMSV_TG_SEN_GRAB_LIN		0x50c
+#define CAMSV_TG_SUB_PERIOD		0x574
+#define CAMSV_DMA_FRAME_HEADER_EN	0xc00
+
+#define CAPTURE_WIDTH			2592
+#define CAPTURE_HEIGHT			1944
+#define CAPTURE_STRIDE			(CAPTURE_WIDTH * 10 / 8)
+#define CAPTURE_SIZE			(CAPTURE_STRIDE * CAPTURE_HEIGHT)
+#define CAPTURE_GUARD			4096
+#define CAPTURE_GUARD_BYTE		0x5a
+#define CAPTURE_FILL_BYTE		0xa5
+
 #define SENINF_RX_IF			1	/* The second interface. */
 #define SENINF_RX_LANES			2
 #define SENINF_SETTLE_NS		14
@@ -157,6 +211,12 @@ struct mt6797_seninf {
 	bool hsrx_delay;
 	bool streaming;
 	struct dentry *debugfs;
+
+	void __iomem *camsv;
+	struct clk *camsv_clk, *larb_clk, *smi_clk;
+	void *frame;
+	dma_addr_t frame_dma;
+	struct debugfs_blob_wrapper frame_blob;
 };
 
 static void seninf_update(struct mt6797_seninf *seninf, u32 reg, u32 mask, u32 val)
@@ -450,6 +510,22 @@ static int seninf_rx_init(struct mt6797_seninf *seninf)
 		return PTR_ERR(seninf->mipi_rx);
 	}
 
+	seninf->camsv_clk = devm_clk_get_optional(dev, "camsv0");
+	seninf->larb_clk = devm_clk_get_optional(dev, "larb2");
+	seninf->smi_clk = devm_clk_get_optional(dev, "smi");
+	if (IS_ERR(seninf->camsv_clk) || IS_ERR(seninf->larb_clk) || IS_ERR(seninf->smi_clk)) {
+		fwnode_handle_put(ep);
+		return dev_err_probe(dev, -EPROBE_DEFER, "waiting for capture clocks\n");
+	}
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 2);
+	if (res) {
+		seninf->camsv = devm_ioremap_resource(dev, res);
+		if (IS_ERR(seninf->camsv)) {
+			fwnode_handle_put(ep);
+			return PTR_ERR(seninf->camsv);
+		}
+	}
+
 	seninf->settle = DIV_ROUND_UP(SENINF_SETTLE_NS * SENINF_CLK_RATE_MHZ, 1000);
 	seninf->hsrx_delay = true;
 
@@ -568,6 +644,152 @@ static int seninf_dbg_status_show(struct seq_file *s, void *unused)
 }
 DEFINE_SHOW_ATTRIBUTE(seninf_dbg_status);
 
+static void seninf_camsv_dump(struct mt6797_seninf *seninf, const char *when)
+{
+	void __iomem *sv = seninf->camsv;
+
+	dev_info(seninf->dev,
+		 "camsv %s: en %08x status %08x vf %08x mode %08x pxl %08x lin %08x\n",
+		 when, readl(sv + CAMSV_MODULE_EN), readl(sv + CAMSV_INT_STATUS),
+		 readl(sv + CAMSV_TG_VF_CON), readl(sv + CAMSV_TG_SEN_MODE),
+		 readl(sv + CAMSV_TG_SEN_GRAB_PXL), readl(sv + CAMSV_TG_SEN_GRAB_LIN));
+}
+
+/*
+ * One frame into a bounded buffer. The generator runs in single mode, and the
+ * DMA's size registers bound the write. A guard after the buffer shows whether
+ * it was overrun. The larb is left in its reset state, with no M4U.
+ */
+static int seninf_capture_once(struct mt6797_seninf *seninf)
+{
+	void __iomem *sv = seninf->camsv;
+	unsigned int i, unwritten = 0, guard_bad = 0;
+	u8 *bytes = seninf->frame;
+	u32 val;
+	int ret;
+
+	if (!sv || !seninf->camsv_clk || !seninf->larb_clk || !seninf->sensor)
+		return -ENODEV;
+	if (seninf->streaming)
+		return -EBUSY;
+
+	if (!seninf->frame) {
+		ret = dma_set_mask_and_coherent(seninf->dev, DMA_BIT_MASK(32));
+		if (ret)
+			return ret;
+		seninf->frame = dma_alloc_coherent(seninf->dev,
+						   CAPTURE_SIZE + CAPTURE_GUARD,
+						   &seninf->frame_dma, GFP_KERNEL);
+		if (!seninf->frame)
+			return -ENOMEM;
+		bytes = seninf->frame;
+		seninf->frame_blob.data = seninf->frame;
+		seninf->frame_blob.size = CAPTURE_SIZE;
+		debugfs_create_blob("frame", 0400, seninf->debugfs, &seninf->frame_blob);
+	}
+	memset(bytes, CAPTURE_FILL_BYTE, CAPTURE_SIZE);
+	memset(bytes + CAPTURE_SIZE, CAPTURE_GUARD_BYTE, CAPTURE_GUARD);
+	dev_info(seninf->dev, "capture buffer at %pad, %u bytes\n",
+		 &seninf->frame_dma, CAPTURE_SIZE);
+
+	ret = v4l2_subdev_call(&seninf->sd, video, s_stream, 1);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(seninf->smi_clk);
+	if (ret)
+		goto stop_stream;
+	ret = clk_prepare_enable(seninf->larb_clk);
+	if (ret)
+		goto put_smi;
+	ret = clk_prepare_enable(seninf->camsv_clk);
+	if (ret)
+		goto put_larb;
+
+	/* Let the stream settle, so the frame starts clean. */
+	msleep(100);
+
+	/* All the CAMSV inputs take this interface's mux. */
+	val = readl(seninf->base + SENINF_TOP_CAM_MUX);
+	for (i = 2; i < 8; i++)
+		val = (val & ~SENINF_TOP_CAM_MUX_SEL(i)) | (SENINF_RX_IF << (4 * i));
+	writel(val, seninf->base + SENINF_TOP_CAM_MUX);
+
+	writel(CAMSV_SW_CTL_SW_RST, sv + CAMSV_SW_CTL);
+	writel(0, sv + CAMSV_SW_CTL);
+	writel(CAMSV_SW_CTL_RST_TRIG, sv + CAMSV_SW_CTL);
+	ret = readl_poll_timeout(sv + CAMSV_SW_CTL, val,
+				 val == (CAMSV_SW_CTL_RST_TRIG | CAMSV_SW_CTL_RST_STA),
+				 100, 100000);
+	if (ret) {
+		dev_err(seninf->dev, "camsv reset timed out, %08x\n", val);
+		goto stop_camsv;
+	}
+	writel(0, sv + CAMSV_SW_CTL);
+
+	writel(CAMSV_CLK_EN_VAL, sv + CAMSV_CLK_EN);
+	writel(readl(sv + CAMSV_TG_SEN_MODE) & ~CAMSV_TG_SEN_MODE_CLR, sv + CAMSV_TG_SEN_MODE);
+	writel(0, sv + CAMSV_TG_SUB_PERIOD);
+	writel((u32)CAPTURE_WIDTH << 16, sv + CAMSV_TG_SEN_GRAB_PXL);
+	writel((u32)CAPTURE_HEIGHT << 16, sv + CAMSV_TG_SEN_GRAB_LIN);
+	writel(CAMSV_FMT_SEL_BAYER10, sv + CAMSV_FMT_SEL);
+	writel(0, sv + CAMSV_INT_EN);
+	writel((readl(sv + CAMSV_PAK) & ~CAMSV_PAK_MASK) | CAMSV_PAK_RAW10, sv + CAMSV_PAK);
+	writel(0, sv + CAMSV_DMA_FRAME_HEADER_EN);
+	writel(readl(sv + CAMSV_DMA_RSV1) & ~BIT(31), sv + CAMSV_DMA_RSV1);
+	writel(0xffffffff, sv + CAMSV_DMA_RSV6);
+	writel(readl(sv + CAMSV_SPECIAL_FUN_EN) | CAMSV_SPECIAL_FUN_VAL, sv + CAMSV_SPECIAL_FUN_EN);
+
+	writel(lower_32_bits(seninf->frame_dma), sv + CAMSV_IMGO_BASE_ADDR);
+	writel(0, sv + CAMSV_IMGO_OFST_ADDR);
+	writel(CAPTURE_STRIDE - 1, sv + CAMSV_IMGO_XSIZE);
+	writel(CAPTURE_HEIGHT - 1, sv + CAMSV_IMGO_YSIZE);
+	writel(CAPTURE_STRIDE | CAMSV_IMGO_STRIDE_BUS16, sv + CAMSV_IMGO_STRIDE);
+	writel(0, sv + CAMSV_IMGO_CROP);
+
+	writel(CAMSV_MODULE_EN_TG | CAMSV_MODULE_EN_PAK | CAMSV_MODULE_EN_IMGO |
+	       CAMSV_MODULE_EN_DB, sv + CAMSV_MODULE_EN);
+	seninf_camsv_dump(seninf, "before");
+
+	writel(readl(sv + CAMSV_TG_SEN_MODE) | CAMSV_TG_SEN_MODE_CMOS_EN, sv + CAMSV_TG_SEN_MODE);
+	writel(readl(sv + CAMSV_TG_VF_CON) | CAMSV_TG_VF_CON_EN | CAMSV_TG_VF_CON_SINGLE,
+	       sv + CAMSV_TG_VF_CON);
+
+	/* Two frame times at the sensor's 30 frames a second, and some margin. */
+	msleep(150);
+	seninf_camsv_dump(seninf, "after");
+
+	writel(readl(sv + CAMSV_TG_VF_CON) & ~CAMSV_TG_VF_CON_EN, sv + CAMSV_TG_VF_CON);
+	writel(readl(sv + CAMSV_TG_SEN_MODE) & ~CAMSV_TG_SEN_MODE_CMOS_EN, sv + CAMSV_TG_SEN_MODE);
+	writel(0, sv + CAMSV_MODULE_EN);
+	seninf_camsv_dump(seninf, "stopped");
+
+stop_camsv:
+	clk_disable_unprepare(seninf->camsv_clk);
+put_larb:
+	clk_disable_unprepare(seninf->larb_clk);
+put_smi:
+	clk_disable_unprepare(seninf->smi_clk);
+stop_stream:
+	v4l2_subdev_call(&seninf->sd, video, s_stream, 0);
+
+	for (i = 0; i < CAPTURE_SIZE; i++)
+		unwritten += bytes[i] == CAPTURE_FILL_BYTE;
+	for (i = 0; i < CAPTURE_GUARD; i++)
+		guard_bad += bytes[CAPTURE_SIZE + i] != CAPTURE_GUARD_BYTE;
+	dev_info(seninf->dev, "capture: %u of %u bytes still fill, %u guard bytes changed\n",
+		 unwritten, CAPTURE_SIZE, guard_bad);
+	dev_info(seninf->dev, "first bytes %*ph\n", 16, bytes);
+
+	return ret;
+}
+
+static int seninf_dbg_capture_set(void *data, u64 val)
+{
+	return val ? seninf_capture_once(data) : 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(seninf_dbg_capture, NULL, seninf_dbg_capture_set, "%llu\n");
+
 static void seninf_debugfs_init(struct mt6797_seninf *seninf)
 {
 	struct dentry *dir = debugfs_create_dir("mt6797-seninf", NULL);
@@ -576,6 +798,7 @@ static void seninf_debugfs_init(struct mt6797_seninf *seninf)
 	debugfs_create_file_unsafe("stream", 0200, dir, seninf, &seninf_dbg_stream);
 	debugfs_create_file_unsafe("pattern", 0200, dir, seninf, &seninf_dbg_pattern);
 	debugfs_create_file("status", 0400, dir, seninf, &seninf_dbg_status_fops);
+	debugfs_create_file_unsafe("capture", 0200, dir, seninf, &seninf_dbg_capture);
 	debugfs_create_u32("settle", 0600, dir, &seninf->settle);
 	debugfs_create_bool("hsrx_delay", 0600, dir, &seninf->hsrx_delay);
 }
@@ -690,6 +913,9 @@ static void seninf_remove(struct platform_device *pdev)
 
 	debugfs_remove_recursive(seninf->debugfs);
 	seninf_rx_exit(seninf);
+	if (seninf->frame)
+		dma_free_coherent(seninf->dev, CAPTURE_SIZE + CAPTURE_GUARD,
+				  seninf->frame, seninf->frame_dma);
 }
 
 static const struct of_device_id seninf_of_match[] = {
-- 
