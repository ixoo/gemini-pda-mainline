index 000000000..3c303121f
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/native-diag.h
@@ -0,0 +1,212 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Pure decision core for the DEFAULT-OFF native-crypto-delivery diagnostic
+ * (CONFIG_MT6797_NATIVE_DELIVERY_DIAG). No side effects, no kernel calls; the
+ * includer provides the RX_FLAG_* definitions (net/mac80211.h in the driver,
+ * test stubs in the unit test). It fixes the admitted first-window ceilings and
+ * the exact rx_status flag discipline so the ordinary native RX traverses the
+ * full standard mac80211 CCMP AEAD/MIC and replay check.
+ */
+#ifndef MT6797_NATIVE_DIAG_H
+#define MT6797_NATIVE_DIAG_H
+
+/* Root-admitted first-window ceilings; the lower existing data-phase ceilings
+ * (MT6797_JOIN_DATA_RX_MAX etc.) also stop the run, checked by the caller.
+ */
+#define MT6797_NATIVE_DIAG_WALL_MS    10000U        /* 10 s post-switch wall */
+#define MT6797_NATIVE_DIAG_RX_MAX     512U          /* total RX frames admitted */
+#define MT6797_NATIVE_DIAG_NATIVE_MAX 64U           /* protected-native ordinary frames */
+#define MT6797_NATIVE_DIAG_BYTES_MAX  (1024U * 1024U) /* 1 MiB total RX bytes */
+
+/* Once the sample window ends, draining the owed completion (the exact TX-done
+ * class only; the broad control dispatcher and all other classes are gated) has
+ * its own finite ceiling, set below the parent command/frame/grant/lifetime
+ * deadlines, after which an unretired ledger fails through the normal terminal.
+ */
+#define MT6797_NATIVE_DIAG_RETIRE_READS 64U            /* further all-class reads */
+#define MT6797_NATIVE_DIAG_RETIRE_BYTES (256U * 1024U) /* 256 KiB drained */
+#define MT6797_NATIVE_DIAG_RETIRE_MS    750U           /* below the parent deadlines */
+
+/* The crypto bypass/strip flags that would make mac80211 SKIP decrypt, MIC or
+ * replay. The diagnostic sets NONE of them for an ordinary native MPDU, so the
+ * frame traverses ieee80211_crypto_ccmp_decrypt's AEAD+MIC and the rx_pn replay
+ * check in full. ALLOW_SAME_PN is included (and left clear): no retry/aggregation
+ * same-PN acceptance is claimed.
+ */
+static inline unsigned int mt6797_native_diag_crypto_bypass_mask(void)
+{
+	return RX_FLAG_DECRYPTED | RX_FLAG_IV_STRIPPED | RX_FLAG_PN_VALIDATED |
+	       RX_FLAG_MMIC_STRIPPED | RX_FLAG_MIC_STRIPPED | RX_FLAG_ALLOW_SAME_PN;
+}
+
+/* The exact rx_status flag word the diagnostic sets for an ordinary native
+ * protected MPDU: only the no-signal marker when the signal is invalid; never a
+ * crypto bypass/strip flag and never an 802.3/decap flag. (band, freq and the
+ * signal value are set separately by the caller; they are not flags.)
+ */
+static inline unsigned int mt6797_native_diag_ordinary_flags(int signal_valid)
+{
+	return signal_valid ? 0U : RX_FLAG_NO_SIGNAL_VAL;
+}
+
+enum mt6797_native_diag_step { MT6797_NATIVE_DIAG_CONTINUE, MT6797_NATIVE_DIAG_STOP };
+
+struct mt6797_native_diag_budget {
+	unsigned int elapsed_ms;   /* monotonic ms since the mode switch */
+	unsigned int total_rx;     /* all RX frames admitted in the window */
+	unsigned int native_rx;    /* protected-native ordinary frames delivered */
+	unsigned int bytes;        /* total RX bytes admitted in the window */
+};
+
+/* STOP when any admitted ceiling is reached; otherwise CONTINUE. A NULL or an
+ * at/over-ceiling state stops.
+ */
+static inline enum mt6797_native_diag_step
+mt6797_native_diag_budget_step(const struct mt6797_native_diag_budget *b)
+{
+	if (!b)
+		return MT6797_NATIVE_DIAG_STOP;
+	if (b->elapsed_ms >= MT6797_NATIVE_DIAG_WALL_MS ||
+	    b->total_rx >= MT6797_NATIVE_DIAG_RX_MAX ||
+	    b->native_rx >= MT6797_NATIVE_DIAG_NATIVE_MAX ||
+	    b->bytes >= MT6797_NATIVE_DIAG_BYTES_MAX)
+		return MT6797_NATIVE_DIAG_STOP;
+	return MT6797_NATIVE_DIAG_CONTINUE;
+}
+
+/* STOP when the owed-completion drain budget is reached; otherwise CONTINUE. */
+static inline enum mt6797_native_diag_step
+mt6797_native_diag_retire_step(unsigned int reads, unsigned int bytes,
+			       unsigned int elapsed_ms)
+{
+	if (reads >= MT6797_NATIVE_DIAG_RETIRE_READS ||
+	    bytes >= MT6797_NATIVE_DIAG_RETIRE_BYTES ||
+	    elapsed_ms >= MT6797_NATIVE_DIAG_RETIRE_MS)
+		return MT6797_NATIVE_DIAG_STOP;
+	return MT6797_NATIVE_DIAG_CONTINUE;
+}
+
+/* The default-off diagnostic's control runs INSIDE join_work; it must never block
+ * on its own ledger (a worker waiting for itself would time out). This pure
+ * transition drives a compact asynchronous state machine the poller steps once
+ * per iteration: it submits exactly one enable, then one disable, each reconciled
+ * across later iterations on the real credit/page ledger (as the in-worker
+ * commands are), activating only after the enable retires and permitting the
+ * inherited healthy cleanup only after the disable retires. On a deadline or any
+ * poison it latches a no-radio stop before any further submission. No blocking,
+ * no new workqueue. The wiring executes the returned action (charge the one page
+ * + credit deadline on a submit, or set first_error+closing on a latch).
+ */
+enum mt6797_native_diag_state {
+	MT6797_ND_IDLE,
+	MT6797_ND_ENABLE_PENDING,
+	MT6797_ND_ACTIVE,
+	MT6797_ND_DISABLE_PENDING,
+	MT6797_ND_CLOSED,
+};
+
+enum mt6797_native_diag_action {
+	MT6797_ND_ACT_NONE,
+	MT6797_ND_ACT_SUBMIT_ENABLE,
+	MT6797_ND_ACT_SUBMIT_DISABLE,
+	MT6797_ND_ACT_LATCH_NORADIO,
+};
+
+struct mt6797_native_diag_ctx {
+	enum mt6797_native_diag_state state;
+	int armed;		/* the native_delivery_diag module parameter */
+	int data_phase;		/* healthy associated data phase, both keys installed */
+	int quiescent;		/* ledger idle: no credit pending, no page debt, no inflight */
+	int poisoned;		/* first_error or closing already set */
+	int deadline_passed;	/* now >= the pending command's credit deadline */
+	int seq_ok;		/* command sequence space remains for the submit */
+	int budget_stop;	/* ACTIVE: a window ceiling reached */
+};
+
+/* Pure next-state + action. *state is updated in place. */
+static inline enum mt6797_native_diag_action
+mt6797_native_diag_transition(struct mt6797_native_diag_ctx *c)
+{
+	if (!c)
+		return MT6797_ND_ACT_NONE;
+	switch (c->state) {
+	case MT6797_ND_IDLE:
+		if (c->poisoned)
+			return MT6797_ND_ACT_NONE;
+		if (c->armed && c->data_phase && c->quiescent && c->seq_ok) {
+			c->state = MT6797_ND_ENABLE_PENDING;
+			return MT6797_ND_ACT_SUBMIT_ENABLE;
+		}
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_ENABLE_PENDING:
+		if (c->poisoned) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_NONE;
+		}
+		if (c->deadline_passed) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_LATCH_NORADIO;
+		}
+		if (c->quiescent)		/* enable retired */
+			c->state = MT6797_ND_ACTIVE;
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_ACTIVE:
+		if (c->poisoned) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_NONE;
+		}
+		/* The window ends on a ceiling OR when the data phase ends (its lower
+		 * deadline may expire before the 10 s wall, or the association is lost);
+		 * disable only once the ledger is quiescent so an owed completion is
+		 * retired first -- never disable with a frame still in flight.
+		 */
+		if (c->budget_stop || !c->data_phase) {
+			if (!c->quiescent)
+				return MT6797_ND_ACT_NONE;	/* wait for retirement */
+			if (!c->seq_ok) {
+				c->state = MT6797_ND_CLOSED;
+				return MT6797_ND_ACT_LATCH_NORADIO;
+			}
+			c->state = MT6797_ND_DISABLE_PENDING;
+			return MT6797_ND_ACT_SUBMIT_DISABLE;
+		}
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_DISABLE_PENDING:
+		if (c->poisoned) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_NONE;
+		}
+		if (c->deadline_passed) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_LATCH_NORADIO;
+		}
+		if (c->quiescent)		/* disable retired */
+			c->state = MT6797_ND_CLOSED;
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_CLOSED:
+	default:
+		return MT6797_ND_ACT_NONE;
+	}
+}
+
+/* The inherited healthy cleanup may submit only when the diagnostic owns no
+ * un-retired radio command: never armed, or fully closed.
+ */
+static inline int mt6797_native_diag_cleanup_allowed(enum mt6797_native_diag_state s)
+{
+	return s == MT6797_ND_IDLE || s == MT6797_ND_CLOSED;
+}
+
+/* Prospective per-frame admission while the window is pending or active: the
+ * frame and its logical bytes are ALWAYS counted (matched or not); it is
+ * delivered only in ACTIVE and only if no ceiling is reached once counted.
+ */
+static inline int
+mt6797_native_diag_admit(enum mt6797_native_diag_state s,
+			 const struct mt6797_native_diag_budget *after)
+{
+	return s == MT6797_ND_ACTIVE &&
+	       mt6797_native_diag_budget_step(after) == MT6797_NATIVE_DIAG_CONTINUE;
+}
+
+#endif /* MT6797_NATIVE_DIAG_H */
