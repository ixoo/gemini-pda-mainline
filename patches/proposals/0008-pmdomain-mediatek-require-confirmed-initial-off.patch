From f241040de2b23ef730c5ce89381a3d843dd081a8 Mon Sep 17 00:00:00 2001
From: MT6797 diagnostic experiment <nobody@example.invalid>
Date: Sat, 26 Sep 2026 17:40:16 -0400
Subject: [PATCH] pmdomain: mediatek: require confirmed OFF for opted domains

KEEP_DEFAULT_OFF currently warns when an island reads ON, but still
registers it as OFF. Its status helper also ignores regmap errors and
collapses mixed dual-status bits into OFF. A future MT6797 CONN child
needs a fail-closed initial state before any consumer can attach.

Add an opt-in capability that reads both status registers and rejects
ON, mixed, or unreadable state before genpd registration. Require it
to be paired with KEEP_DEFAULT_OFF. Existing SoCs retain their prior
behavior; no domain selects the new capability in this patch.

Internal experiment only; synthetic non-certifying author, no DCO.
Base: Linux 7.1.3, mtk-pm-domains.c SHA-256
d9a2fc3d875ec737a01234109115db9d39779b64597c2888d6db631970184f3b.
---
 drivers/pmdomain/mediatek/mtk-pm-domains.c | 38 +++++++++++++++++++++-
 drivers/pmdomain/mediatek/mtk-pm-domains.h |  2 ++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/drivers/pmdomain/mediatek/mtk-pm-domains.c b/drivers/pmdomain/mediatek/mtk-pm-domains.c
index e1cfd42..5bcd4a8 100644
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.c
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.c
@@ -99,6 +99,28 @@ static bool scpsys_domain_is_on(struct scpsys_domain *pd)
 	return status && status2;
 }
 
+static int scpsys_require_initially_off(struct scpsys_domain *pd)
+{
+	struct scpsys *scpsys = pd->scpsys;
+	u32 status, status2, mask2;
+	int ret;
+
+	if (!pd->data || !MTK_SCPD_CAPS(pd, MTK_SCPD_KEEP_DEFAULT_OFF) ||
+	    !pd->data->sta_mask)
+		return -EINVAL;
+
+	mask2 = pd->data->sta2nd_mask ?: pd->data->sta_mask;
+	ret = regmap_read(scpsys->base, pd->data->pwr_sta_offs, &status);
+	if (ret)
+		return ret;
+	ret = regmap_read(scpsys->base, pd->data->pwr_sta2nd_offs, &status2);
+	if (ret)
+		return ret;
+
+	return (status & pd->data->sta_mask) || (status2 & mask2) ?
+		-EBUSY : 0;
+}
+
 static bool scpsys_hwv_domain_is_disable_done(struct scpsys_domain *pd)
 {
 	const struct scpsys_hwv_domain_data *hwv = pd->hwv_data;
@@ -883,10 +905,24 @@ generic_pm_domain *scpsys_add_one_domain(struct scpsys *scpsys, struct device_no
 	 * software.  The unused domains will be switched off during
 	 * late_init time.
 	 */
+	if (MTK_SCPD_CAPS(pd, MTK_SCPD_REQUIRE_INIT_OFF) &&
+	    !MTK_SCPD_CAPS(pd, MTK_SCPD_KEEP_DEFAULT_OFF)) {
+		ret = -EINVAL;
+		goto err_put_subsys_clocks;
+	}
 	if (MTK_SCPD_CAPS(pd, MTK_SCPD_KEEP_DEFAULT_OFF)) {
-		if (scpsys_domain_is_on(pd))
+		if (MTK_SCPD_CAPS(pd, MTK_SCPD_REQUIRE_INIT_OFF)) {
+			ret = scpsys_require_initially_off(pd);
+			if (ret) {
+				dev_err_probe(scpsys->dev, ret,
+					      "%pOF: domain is not confirmed off\n",
+					      node);
+				goto err_put_subsys_clocks;
+			}
+		} else if (scpsys_domain_is_on(pd)) {
 			dev_warn(scpsys->dev,
 				 "%pOF: A default off power domain has been ON\n", node);
+		}
 	} else {
 		ret = pd->genpd.power_on(&pd->genpd);
 		if (ret < 0) {
diff --git a/drivers/pmdomain/mediatek/mtk-pm-domains.h b/drivers/pmdomain/mediatek/mtk-pm-domains.h
index a5dca24..f552431 100644
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.h
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.h
@@ -17,6 +17,8 @@
 #define MTK_SCPD_MODEM_PWRSEQ		BIT(10)
 #define MTK_SCPD_SKIP_RESET_B		BIT(11)
 #define MTK_SCPD_INFRA_PWR_CTL		BIT(12)
+/* Fail registration unless both power-status bits are readable and clear. */
+#define MTK_SCPD_REQUIRE_INIT_OFF	BIT(13)
 #define MTK_SCPD_CAPS(_scpd, _x)	((_scpd)->data ?		\
 					 (_scpd)->data->caps & (_x) :	\
 					 (_scpd)->hwv_data->caps & (_x))
-- 
