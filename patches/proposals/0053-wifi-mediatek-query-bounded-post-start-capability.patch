From a6c5d1816b05c830bf506f921c0037043366b032 Mon Sep 17 00:00:00 2001
From: Codex native diagnostic <noreply@native-diagnostic.invalid>
Date: Tue, 29 Sep 2026 21:13:59 -0400
Subject: [PATCH] wifi: mediatek: query bounded capability after firmware start

After the admitted one-shot firmware START reaches WCIR ready, send one
gen3 capability query through the owned PIO path. Keep normal TC4
accounting distinct from INIT, require an empty receive queue before
submission, and accept only the matching bounded port-1 reply. Report
non-private capability fields while leaving calibration, radio commands
and packet DMA held.
---
 drivers/net/wireless/mediatek/mt6797/hif.c    |  94 ++++++++
 drivers/net/wireless/mediatek/mt6797/hif.h    |  11 +
 .../wireless/mediatek/mt6797/normal_command.h | 213 ++++++++++++++++++
 drivers/soc/mediatek/mt6797-consys.c          |  12 +
 4 files changed, 330 insertions(+)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/normal_command.h

diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index bc1366b..44aa5a7 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -24,6 +24,7 @@ struct mt6797_hif {
 	u64 start_deadline_ns;
 	bool start_attempted;
 	bool firmware_ready;
+	bool capability_attempted;
 	int first_error;
 	u8 scratch[2560];
 };
@@ -312,3 +313,96 @@ out:
 	mutex_unlock(&hif->mutex);
 	return error;
 }
+
+int mt6797_hif_query_capability(struct mt6797_hif *hif, unsigned int sequence,
+				u64 deadline_ns,
+				struct mt6797_normal_capability *capability)
+{
+	struct mt6797_normal_transaction normal = {0};
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	u32 lengths;
+	int error;
+
+	if (!capability)
+		return -EINVAL;
+	*capability = (struct mt6797_normal_capability){0};
+	if (!hif || sequence > 255)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || hif->capability_attempted ||
+	    hif->transaction->phase != MT6797_START_READY) {
+		error = -EIO;
+		goto unlock;
+	}
+	hif->capability_attempted = true;
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto out;
+	/* The source reset is a software ledger reset; the sole normal user in
+	 * this driver starts with its selected 26-page default, not INIT TC4.
+	 */
+	error = mt6797_normal_admit(&normal, 26, 26,
+				    hif->transaction->used_sequences);
+	if (error)
+		goto out;
+	/* A pre-existing event would make a reply's owner ambiguous. */
+	error = mt6797_hif_read32_locked(hif, 0x90, &lengths);
+	if (error)
+		goto out;
+	if (lengths) {
+		error = -EBUSY;
+		goto out;
+	}
+	error = mt6797_normal_prepare(&normal, MT6797_NORMAL_CAPABILITY,
+				      sequence, NULL, 0, hif->scratch,
+				      sizeof(hif->scratch), &command);
+	if (error)
+		goto out;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch, MT6797_NORMAL_CAP_BYTES,
+					sizeof(hif->scratch), &transfer);
+	error = mt6797_normal_submitted(&normal, error);
+	if (error)
+		goto out;
+	for (;;) {
+		error = mt6797_hif_read32_locked(hif, 0x90, &lengths);
+		if (error)
+			goto out;
+		if (lengths & 0xffff) {
+			error = -EPROTO;
+			goto out;
+		}
+		error = mt6797_normal_reply_span(&normal, lengths >> 16,
+						 sizeof(hif->scratch), &command);
+		if (error != -EAGAIN)
+			break;
+		error = mt6797_hif_guard(hif);
+		if (error)
+			goto out;
+		usleep_range(50, 100);
+	}
+	if (error)
+		goto out;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x54, MT6797_HIF_READ,
+					hif->scratch, command.transfer_bytes,
+					sizeof(hif->scratch), &transfer);
+	if (error)
+		goto out;
+	error = mt6797_hif_guard(hif);
+	if (error)
+		goto out;
+	error = mt6797_normal_accept_capability(&normal, hif->scratch,
+						MT6797_NORMAL_CAP_BYTES,
+						capability);
+out:
+	if (error) {
+		*capability = (struct mt6797_normal_capability){0};
+		mt6797_normal_abort(&normal);
+		error = mt6797_hif_fail(hif, error);
+	}
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index 00f4f9d..fd8c6fc 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -9,6 +9,7 @@
 #include <linux/types.h>
 #endif
 #include "hif_ordinary_section.h"
+#include "normal_command.h"
 
 struct mt6797_hif;
 
@@ -66,4 +67,14 @@ int mt6797_hif_start_submit(struct mt6797_hif *hif, const u8 *command,
  */
 int mt6797_hif_start_observe_ready(struct mt6797_hif *hif, u32 *wcir);
 
+/* Exactly one post-START capability query on this exclusive PIO owner.
+ * The selected gen3 default normal TC4 allocation is 26 pages; this driver
+ * has no Tc4Page override or competing normal command user. One page is
+ * debited without replenishment. A timeout or unexpected event poisons the
+ * session; no radio command, calibration payload or packet DMA is issued.
+ */
+int mt6797_hif_query_capability(struct mt6797_hif *hif, unsigned int sequence,
+				u64 deadline_ns,
+				struct mt6797_normal_capability *capability);
+
 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/normal_command.h b/drivers/net/wireless/mediatek/mt6797/normal_command.h
new file mode 100644
index 0000000..bf003ab
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/normal_command.h
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original bounded normal-command helpers; see NORMAL_COMMAND.md. */
+#ifndef GEMINI_NORMAL_COMMAND_H
+#define GEMINI_NORMAL_COMMAND_H
+#include "hif_command.h"
+
+#define MT6797_NORMAL_CAP_BYTES 124U
+#define MT6797_NORMAL_NVRAM_BYTES 520U
+
+enum mt6797_normal_kind { MT6797_NORMAL_CAPABILITY, MT6797_NORMAL_NVRAM };
+enum mt6797_normal_phase {
+	MT6797_NORMAL_COLD, MT6797_NORMAL_IDLE, MT6797_NORMAL_CAP_TX,
+	MT6797_NORMAL_CAP_WAIT, MT6797_NORMAL_CAP_RECEIVED,
+	MT6797_NORMAL_NVRAM_TX, MT6797_NORMAL_NVRAM_SUBMITTED,
+	MT6797_NORMAL_FAILED,
+};
+
+struct mt6797_normal_transaction {
+	enum mt6797_normal_phase phase;
+	unsigned int tc4_limit, tc4_free, expected_sequence;
+	/* Shared adapter-session history, including INIT. Never cleared here. */
+	unsigned char *used_sequences;
+};
+
+/* No MAC, date string or raw event is copied into this result. */
+struct mt6797_normal_capability {
+	unsigned int product, firmware_own, firmware_peer;
+	unsigned int hw_5g_disabled, eeprom_used, rf_cal_fail, bb_cal_fail;
+};
+
+static inline unsigned int mt6797_normal_le16(const unsigned char *p)
+{
+	return (unsigned int)p[0] | ((unsigned int)p[1] << 8);
+}
+
+static inline int mt6797_normal_abort(struct mt6797_normal_transaction *t)
+{
+	if (!t)
+		return -EINVAL;
+	t->phase = MT6797_NORMAL_FAILED;
+	return -EIO;
+}
+
+/* Only the actual post-START resource owner may supply these normal-TC4 facts.
+ * No default quota, hardware reset, INIT-credit reuse or refill is provided.
+ * history must cover 32 bytes and outlive this serialized bounded transaction.
+ */
+static inline int
+mt6797_normal_admit(struct mt6797_normal_transaction *t, unsigned int limit,
+		    unsigned int available, unsigned char *history)
+{
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_COLD)
+		return mt6797_normal_abort(t);
+	if (!history || !limit || limit > 0xffffU || available > limit)
+		return -EINVAL;
+	t->tc4_limit = limit;
+	t->tc4_free = available;
+	t->used_sequences = history;
+	t->phase = MT6797_NORMAL_IDLE;
+	return 0;
+}
+
+/* Distinct immutable payload, output and state storage. No output bytes are
+ * changed on refusal. CAP's unused request tail and all HIF padding are zero.
+ * Returned command describes WTDR1 PIO; no I/O occurs in this helper.
+ */
+static inline int
+mt6797_normal_prepare(struct mt6797_normal_transaction *t,
+		      enum mt6797_normal_kind kind, unsigned int sequence,
+		      const unsigned char *payload, size_t payload_bytes,
+		      unsigned char *output, size_t capacity,
+		      struct mt6797_hif_command *command)
+{
+	struct mt6797_hif_command encoded;
+	size_t bytes, i;
+	unsigned int pages;
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (!t->used_sequences || !t->tc4_limit || t->tc4_limit > 0xffffU ||
+	    t->tc4_free > t->tc4_limit)
+		return mt6797_normal_abort(t);
+	if (kind == MT6797_NORMAL_CAPABILITY) {
+		if (t->phase != MT6797_NORMAL_IDLE)
+			return mt6797_normal_abort(t);
+		if (payload || payload_bytes)
+			return -EINVAL;
+		bytes = MT6797_NORMAL_CAP_BYTES;
+	} else if (kind == MT6797_NORMAL_NVRAM) {
+		if (t->phase != MT6797_NORMAL_CAP_RECEIVED)
+			return mt6797_normal_abort(t);
+		if (!payload || payload_bytes != 512)
+			return -EINVAL;
+		bytes = MT6797_NORMAL_NVRAM_BYTES;
+	} else {
+		return -EINVAL;
+	}
+	if (sequence > 255)
+		return -EINVAL;
+	if (t->used_sequences[sequence / 8] & (1U << (sequence % 8)))
+		return mt6797_normal_abort(t);
+	error = mt6797_hif_encode_command(0x34, MT6797_HIF_WRITE,
+					  MT6797_HIF_PIO_ONLY, bytes, capacity,
+					  &encoded);
+	if (error)
+		return error;
+	/* Source normal GENERAL/NETWORK IOCTL uses ceil(logical length/128),
+	 * with no additional TX descriptor and no charge for HIF block padding.
+	 */
+	pages = (unsigned int)((bytes + 127) / 128);
+	if (t->tc4_free < pages)
+		return -ENOSPC;
+	for (i = 0; i < encoded.transfer_bytes; i++)
+		output[i] = 0;
+	output[0] = (unsigned char)bytes;
+	output[1] = (unsigned char)(bytes >> 8);
+	output[3] = 0x80;
+	output[4] = kind == MT6797_NORMAL_CAPABILITY ? 0x80 : 0x48;
+	output[5] = 0xa0;
+	output[6] = kind == MT6797_NORMAL_NVRAM ? 1 : 0;
+	output[7] = (unsigned char)sequence;
+	for (i = 0; i < payload_bytes; i++)
+		output[8 + i] = payload[i];
+	t->tc4_free -= pages;
+	t->used_sequences[sequence / 8] |= (unsigned char)(1U << (sequence % 8));
+	t->expected_sequence = sequence;
+	t->phase = kind == MT6797_NORMAL_CAPABILITY ? MT6797_NORMAL_CAP_TX :
+		MT6797_NORMAL_NVRAM_TX;
+	*command = encoded;
+	return 0;
+}
+
+/* Feedback from the actual ordered transport. Failure may have side effects. */
+static inline int
+mt6797_normal_submitted(struct mt6797_normal_transaction *t, int transport_error)
+{
+	if (!t)
+		return -EINVAL;
+	if (transport_error)
+		return mt6797_normal_abort(t);
+	if (t->phase == MT6797_NORMAL_CAP_TX)
+		t->phase = MT6797_NORMAL_CAP_WAIT;
+	else if (t->phase == MT6797_NORMAL_NVRAM_TX)
+		t->phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	else
+		return mt6797_normal_abort(t);
+	return 0;
+}
+
+/* Caller supplies the logical port-1 length obtained via proper WRPLR access.
+ * Extra four RX bytes are staging only. Zero means pending, never a reply.
+ */
+static inline int
+mt6797_normal_reply_span(struct mt6797_normal_transaction *t,
+			 unsigned int reported_length, size_t capacity,
+			 struct mt6797_hif_command *span)
+{
+	int error;
+
+	if (span)
+		*span = (struct mt6797_hif_command){0};
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_CAP_WAIT || !span)
+		return mt6797_normal_abort(t);
+	if (!reported_length)
+		return -EAGAIN;
+	if (reported_length != MT6797_NORMAL_CAP_BYTES)
+		return mt6797_normal_abort(t);
+	error = mt6797_hif_encode_command(0x54, MT6797_HIF_READ,
+					  MT6797_HIF_PIO_ONLY,
+					  MT6797_NORMAL_CAP_BYTES + 4,
+					  capacity, span);
+	if (error)
+		mt6797_normal_abort(t);
+	return error;
+}
+
+/* Exact logical event only; no response-status byte is defined for capability.
+ * RF/BB failure flags are observations, not packet-validation failures or proof
+ * of calibration. Reserved bytes/MAC/date remain unexported and uninterpreted.
+ */
+static inline int
+mt6797_normal_accept_capability(struct mt6797_normal_transaction *t,
+				const unsigned char *packet, size_t bytes,
+				struct mt6797_normal_capability *result)
+{
+	if (result)
+		*result = (struct mt6797_normal_capability){0};
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_CAP_WAIT || !packet || !result ||
+	    bytes != MT6797_NORMAL_CAP_BYTES ||
+	    mt6797_normal_le16(packet) != MT6797_NORMAL_CAP_BYTES ||
+	    mt6797_normal_le16(packet + 2) != 0xe000 || packet[4] != 1 ||
+	    t->expected_sequence > 255 || packet[5] != t->expected_sequence)
+		return mt6797_normal_abort(t);
+	result->product = mt6797_normal_le16(packet + 8);
+	result->firmware_own = mt6797_normal_le16(packet + 10);
+	result->firmware_peer = mt6797_normal_le16(packet + 12);
+	result->hw_5g_disabled = packet[14];
+	result->eeprom_used = packet[15];
+	result->rf_cal_fail = packet[26];
+	result->bb_cal_fail = packet[27];
+	t->phase = MT6797_NORMAL_CAP_RECEIVED;
+	return 0;
+}
+#endif
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index 8b3e2b8..8ade16a 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -752,6 +752,7 @@ static void mt6797_consys_probe_firmware_start(struct device *dev,
 		16, 0, 0, 0x80, 2, 0xa0, 0, 3,
 	};
 	struct mt6797_wlan_ordinary_result ordinary = {};
+	struct mt6797_normal_capability capability;
 	u64 deadline;
 	u32 whlpcr, wrplr, wcir = 0;
 	unsigned int i;
@@ -851,6 +852,17 @@ static void mt6797_consys_probe_firmware_start(struct device *dev,
 		goto stopped;
 	}
 	dev_info(dev, "one-shot WLAN firmware ready; radio commands and DMA held\n");
+	ret = mt6797_hif_query_capability(owner->fw_hif, 4,
+					  ktime_get_ns() + NSEC_PER_SEC,
+					  &capability);
+	dev_info(dev, "one-shot WLAN capability query: status=%d\n", ret);
+	if (!ret)
+		dev_info(dev,
+			 "one-shot WLAN capability: product=0x%04x own=0x%04x peer=0x%04x 5g_disabled=%u eeprom_used=%u rf_fail=%u bb_fail=%u\n",
+			 capability.product, capability.firmware_own,
+			 capability.firmware_peer, capability.hw_5g_disabled,
+			 capability.eeprom_used, capability.rf_cal_fail,
+			 capability.bb_cal_fail);
 	return;
 
 stopped:
