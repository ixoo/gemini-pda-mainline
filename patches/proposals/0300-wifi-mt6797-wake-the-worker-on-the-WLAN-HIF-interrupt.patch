From 4b348a34000fbfd4eea07bfcc31230234bfdec6e Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 20:08:44 -0400
Subject: [PATCH] wifi: mt6797: wake the worker on the WLAN HIF interrupt

With batching in place the receive cost left is the worker's polled
cadence: with nothing to transmit it re-queues after 20 ms, and with
work pending but no progress it sleeps a 4 ms jiffy, while about 96
percent of its status-block reads find nothing.

Use the WLAN HIF interrupt as a wake source, in the vendor's shape (an
ISR that touches no HIF register, masks the line and wakes the thread,
which reads the status block and re-arms). The CONSYS owner reads the
interrupt from the wifi child and hands it to the mac80211 client,
which requests it masked. For the data phase the worker arms the
sources (TX, RX0 and RX1 done; INT_EN_SET) and unmasks the line; the hard
handler masks it, counts and queues the worker at once; the worker
unmasks it at the end of its pass, and disarms at the data phase's end
or a failed lifetime. The pump's delays stay as the fallback, so a
missed interrupt costs only latency. Without the interrupt in the
device tree the client stays polled. One record names the registers
before and after arming, and the interrupts taken and re-armed.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 106 +++++++++++++++++++++
 drivers/net/wireless/mediatek/mt6797/mac.h |   5 +
 drivers/soc/mediatek/mt6797-consys.c       |  19 ++++
 3 files changed, 130 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 37a7f8a98..11b8f4a1d 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -9,6 +9,7 @@
 #include <linux/rtnetlink.h>
 #include <linux/unaligned.h>
 #include <linux/workqueue.h>
+#include <linux/interrupt.h>
 #include <net/mac80211.h>
 
 #include "snapshot.h"
@@ -217,6 +218,17 @@ struct mt6797_mac {
 	/* Order: RTNL -> this mutex -> HIF mutex. No CONSYS callback here. */
 	struct mutex mutex;
 	struct ieee80211_supported_band band, band_5g;
+#ifdef CONFIG_MT6797_HIF_RX_IRQ
+	/* The HIF interrupt as a wake source (0300): the handler masks the line
+	 * and queues the worker; the worker arms, re-arms and disarms it.
+	 */
+	int hif_irq;
+	bool hif_irq_armed, hif_irq_arm_tried;
+	atomic_t hif_irq_masked;
+	unsigned int hif_irq_taken, hif_irq_rearmed;
+	int hif_irq_arm_status, hif_irq_disarm_status;
+	struct mt6797_hif_irq_record hif_irq_on, hif_irq_off;
+#endif
 #ifdef CONFIG_MT6797_HT_CAPABILITY
 	bool join_ht_requested, join_ht_accepted;
 #ifdef CONFIG_MT6797_HT_RECORDS
@@ -3393,6 +3405,68 @@ static void mt6797_native_diag_step(struct mt6797_mac *mac)
 /* End the data phase once: the reserved deauthentication's hold ends now and
  * the poller sends it, then the teardown follows. Called with the mutex held.
  */
+#ifdef CONFIG_MT6797_HIF_RX_IRQ
+/* Hard handler: no HIF register is touched here, as in the vendor's
+ * HifAhbISR. Mask the level-low line, count, and queue the worker now.
+ */
+static irqreturn_t mt6797_mac_hif_irq(int irq, void *data)
+{
+	struct mt6797_mac *mac = data;
+
+	disable_irq_nosync(irq);
+	atomic_set(&mac->hif_irq_masked, 1);
+	WRITE_ONCE(mac->hif_irq_taken, mac->hif_irq_taken + 1);
+	mod_delayed_work(system_percpu_wq, &mac->join_work, 0);
+	return IRQ_HANDLED;
+}
+
+/* End of a worker pass, under the MAC mutex (0300). Arm once per data
+ * phase, re-arm the line after the handler masked it (the vendor's
+ * nicEnableInterrupt point), and disarm when the data phase ends or the
+ * lifetime fails. The pump's delays stay as the fallback.
+ */
+static void mt6797_mac_hif_irq_pass(struct mt6797_mac *mac)
+{
+	bool want = mac->hif_irq > 0 && mac->join_data_phase && !mac->join_data_ended &&
+		    !mac->closing && !mac->first_error;
+	u64 deadline = ktime_get_ns() + 50 * NSEC_PER_MSEC;
+
+	if (want && !mac->hif_irq_armed && !mac->hif_irq_arm_tried) {
+		mac->hif_irq_arm_tried = true;
+		mac->hif_irq_arm_status = mt6797_hif_set_interrupt(mac->hif, true, deadline,
+								   &mac->hif_irq_on);
+		if (!mac->hif_irq_arm_status) {
+			mac->hif_irq_armed = true;
+			enable_irq(mac->hif_irq);
+		}
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN HIF interrupt armed: irq=%d status=%d whier=0x%08x>0x%08x whlpcr=0x%08x>0x%08x\n",
+			 mac->hif_irq, mac->hif_irq_arm_status, mac->hif_irq_on.whier_before,
+			 mac->hif_irq_on.whier_after, mac->hif_irq_on.whlpcr_before,
+			 mac->hif_irq_on.whlpcr_after);
+		return;
+	}
+	if (mac->hif_irq_armed && !want) {
+		disable_irq(mac->hif_irq);
+		if (atomic_xchg(&mac->hif_irq_masked, 0))
+			enable_irq(mac->hif_irq);
+		mac->hif_irq_armed = false;
+		mac->hif_irq_disarm_status = mt6797_hif_set_interrupt(mac->hif, false, deadline,
+								      &mac->hif_irq_off);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN HIF interrupt disarmed: irq=%d status=%d taken=%u rearmed=%u whlpcr=0x%08x>0x%08x\n",
+			 mac->hif_irq, mac->hif_irq_disarm_status, READ_ONCE(mac->hif_irq_taken),
+			 mac->hif_irq_rearmed, mac->hif_irq_off.whlpcr_before,
+			 mac->hif_irq_off.whlpcr_after);
+		return;
+	}
+	if (mac->hif_irq_armed && atomic_xchg(&mac->hif_irq_masked, 0)) {
+		mac->hif_irq_rearmed++;
+		enable_irq(mac->hif_irq);
+	}
+}
+#endif
+
 static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 {
 #ifdef CONFIG_MT6797_CCMP_CONNECTED_LIFETIME
@@ -3628,6 +3702,11 @@ static int mt6797_mac_join_release_channel(struct mt6797_mac *mac)
 	mac->join_data_phase = true;
 	mac->join_data_ended = false;
 	mac->join_data_started = now;
+#ifdef CONFIG_MT6797_HIF_RX_IRQ
+	mac->hif_irq_arm_tried = false;
+	mac->hif_irq_taken = 0;
+	mac->hif_irq_rearmed = 0;
+#endif
 	mac->join_data_passes = 0;
 	mac->join_data_submissions = 0;
 	mac->join_data_pass_max = 0;
@@ -5369,6 +5448,9 @@ static void mt6797_mac_join_work(struct work_struct *work)
 		if (submits > mac->join_data_pass_max)
 			mac->join_data_pass_max = submits;
 	}
+#ifdef CONFIG_MT6797_HIF_RX_IRQ
+	mt6797_mac_hif_irq_pass(mac);
+#endif
 	snapshot_delay = mt6797_snapshot_active(mac->snapshot) ?
 		1 : msecs_to_jiffies(20);
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
@@ -5390,6 +5472,9 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	goto unlock;
 failed:
 	ret = mt6797_mac_join_fail_stop(mac, ret, branch, &discard, &internal);
+#ifdef CONFIG_MT6797_HIF_RX_IRQ
+	mt6797_mac_hif_irq_pass(mac);
+#endif
 unlock:
 	mutex_unlock(&mac->mutex);
 	/* One worker serializes RX_ni and TX_status_ni, outside driver locks. */
@@ -7454,6 +7539,27 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 	return ret;
 }
 
+int mt6797_mac_attach_hif_irq(struct ieee80211_hw *hw, struct device *dev, int irq)
+{
+#ifdef CONFIG_MT6797_HIF_RX_IRQ
+	struct mt6797_mac *mac = hw ? hw->priv : NULL;
+	int ret;
+
+	if (!mac || !dev)
+		return -EINVAL;
+	if (irq <= 0)
+		return irq ? irq : -ENXIO;
+	atomic_set(&mac->hif_irq_masked, 0);
+	ret = devm_request_irq(dev, irq, mt6797_mac_hif_irq, IRQF_NO_AUTOEN,
+			       "mt6797-wlan-hif", mac);
+	if (!ret)
+		mac->hif_irq = irq;
+	return ret;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
 void mt6797_mac_scan_ready(struct ieee80211_hw *hw)
 {
 #if IS_ENABLED(CONFIG_MT6797_PASSIVE_SCAN)
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.h b/drivers/net/wireless/mediatek/mt6797/mac.h
index 6fa6aa9e7..31e468d6a 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.h
+++ b/drivers/net/wireless/mediatek/mt6797/mac.h
@@ -26,4 +26,9 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
  */
 void mt6797_mac_scan_ready(struct ieee80211_hw *hw);
 
+/* Hand the WLAN HIF interrupt to a registered client (requested masked;
+ * armed only for the data phase). Returns -EOPNOTSUPP without the option.
+ */
+int mt6797_mac_attach_hif_irq(struct ieee80211_hw *hw, struct device *dev, int irq);
+
 #endif
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index 72811cc62..22a807af3 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -1134,6 +1134,25 @@ static void mt6797_consys_probe_firmware_start(struct device *dev,
 					 record, &owner->wlan_hw);
 		dev_info(dev, "one-shot WLAN regulatory configuration: status=%d\n",
 			 ret);
+#ifdef CONFIG_MT6797_HIF_RX_IRQ
+		/* The WLAN HIF interrupt lives on the wifi child, not on this
+		 * node (whose one interrupt is the WMT/BTIF line). Without it the
+		 * client stays polled (0300).
+		 */
+		if (!ret) {
+			struct device_node *wlan;
+			int irq = -ENODEV, irq_ret;
+
+			wlan = of_get_compatible_child(dev->of_node, "mediatek,mt6797-wlan");
+			if (wlan) {
+				irq = of_irq_get(wlan, 0);
+				of_node_put(wlan);
+			}
+			irq_ret = mt6797_mac_attach_hif_irq(owner->wlan_hw, dev, irq);
+			dev_info(dev, "one-shot WLAN HIF interrupt attached: irq=%d status=%d\n",
+				 irq, irq_ret);
+		}
+#endif
 	}
 #endif
 	mt6797_wifi_record_release(record);
-- 
2.43.0

