From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 19:51:14 -0500
Subject: [PATCH 565/568] clk: mediatek: mt6797-mm: keep the SMI common gate
 open

The display and the cameras both go through this gate, and no driver owns it for
the display. A camera consumer taking its count from 1 to 0 closed it and hung the
display at its next blank. Keep it open until an SMI driver owns it.
---
 drivers/clk/mediatek/clk-mt6797-mm.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/mediatek/clk-mt6797-mm.c b/drivers/clk/mediatek/clk-mt6797-mm.c
index d80172649..5950a2fa7 100644
--- a/drivers/clk/mediatek/clk-mt6797-mm.c
+++ b/drivers/clk/mediatek/clk-mt6797-mm.c
@@ -30,7 +30,13 @@ static const struct mtk_gate_regs mm1_cg_regs = {
 	GATE_MTK(_id, _name, _parent, &mm1_cg_regs, _shift, &mtk_clk_gate_ops_setclr)
 
 static const struct mtk_gate mm_clks[] = {
-	GATE_MM0(CLK_MM_SMI_COMMON, "mm_smi_common", "mm_sel", 0),
+	/*
+	 * The display and the cameras go through this gate, and no driver here owns
+	 * it for the display. If a consumer's count fell to zero, it would close
+	 * behind the display, so it stays open until an SMI driver takes it.
+	 */
+	GATE_MTK_FLAGS(CLK_MM_SMI_COMMON, "mm_smi_common", "mm_sel", &mm0_cg_regs, 0,
+		       &mtk_clk_gate_ops_setclr, CLK_IS_CRITICAL),
 	GATE_MM0(CLK_MM_SMI_LARB0, "mm_smi_larb0", "mm_sel", 1),
 	GATE_MM0(CLK_MM_SMI_LARB5, "mm_smi_larb5", "mm_sel", 2),
 	GATE_MM0(CLK_MM_CAM_MDP, "mm_cam_mdp", "mm_sel", 3),
