From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 31 Oct 2026 07:29:58 -0400
Subject: [PATCH] mfd: mt6397: add the MT6351 power controller cell

The MT6351 RTC block, which holds the BBPU power-down register, sits
at 0x4000. Expose it as a power controller cell, as the MT6323 does,
so the PMIC power-off driver can bind to it.
---
 drivers/mfd/mt6397-core.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/mfd/mt6397-core.c b/drivers/mfd/mt6397-core.c
index ef859f655..b8e8050ec 100644
--- a/drivers/mfd/mt6397-core.c
+++ b/drivers/mfd/mt6397-core.c
@@ -140,6 +140,10 @@ static const struct resource mt6323_pwrc_resources[] = {
 	DEFINE_RES_MEM(MT6323_PWRC_BASE, MT6323_PWRC_SIZE),
 };
 
+static const struct resource mt6351_pwrc_resources[] = {
+	DEFINE_RES_MEM(MT6351_RTC_BASE, MT6351_RTC_SIZE),
+};
+
 static const struct mfd_cell mt6323_devs[] = {
 	{
 		.name = "mt6323-rtc",
@@ -237,6 +241,11 @@ static const struct mfd_cell mt6351_devs[] = {
 		.num_resources = ARRAY_SIZE(mt6351_keys_resources),
 		.resources = mt6351_keys_resources,
 		.of_compatible = "mediatek,mt6351-keys",
+	}, {
+		.name = "mt6351-pwrc",
+		.num_resources = ARRAY_SIZE(mt6351_pwrc_resources),
+		.resources = mt6351_pwrc_resources,
+		.of_compatible = "mediatek,mt6351-pwrc",
 	},
 };
 
