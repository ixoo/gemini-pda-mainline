diff --git a/drivers/net/wireless/mediatek/mt6797/join-submit.h b/drivers/net/wireless/mediatek/mt6797/join-submit.h
index eeca6c2d3..ee39d346c 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-submit.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-submit.h
@@ -105,12 +105,13 @@ mt6797_join_prepare_security(struct mt6797_normal_transaction *t,
  * is untouched; the phase flip is the same as for every frame.
  */
 static inline int
-mt6797_join_prepare_data(struct mt6797_normal_transaction *t,
-			 const unsigned char *frame, size_t bytes,
-			 unsigned char wlan, unsigned char pid,
-			 unsigned int lifetime_ms, unsigned int attempt_count,
-			 unsigned char *output, size_t capacity,
-			 struct mt6797_hif_command *command)
+mt6797_join_prepare_data_report(struct mt6797_normal_transaction *t,
+				const unsigned char *frame, size_t bytes,
+				unsigned char wlan, unsigned char pid,
+				bool status_report,
+				unsigned int lifetime_ms, unsigned int attempt_count,
+				unsigned char *output, size_t capacity,
+				struct mt6797_hif_command *command)
 {
 	unsigned char descriptor[MT6797_JOIN_TX_DESC_BYTES];
 	struct mt6797_hif_command encoded;
@@ -126,8 +127,9 @@ mt6797_join_prepare_data(struct mt6797_normal_transaction *t,
 	    !t->tc4_limit || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit ||
 	    !t->tc1_limit || t->tc1_free > t->tc1_limit)
 		return mt6797_normal_abort(t);
-	if (!mt6797_join_tx_data_descriptor(frame, bytes, wlan, pid, lifetime_ms,
-					    attempt_count, descriptor, &pages))
+	if (!mt6797_join_tx_data_descriptor_report(frame, bytes, wlan, pid,
+						   status_report, lifetime_ms,
+						   attempt_count, descriptor, &pages))
 		return -EINVAL;
 	#if !defined(CONFIG_MT6797_CCMP_TX_DEPTH) || CONFIG_MT6797_CCMP_TX_DEPTH == 1
 	if (t->tc1_free != t->tc1_limit || t->tc1_pending)
@@ -152,4 +154,17 @@ mt6797_join_prepare_data(struct mt6797_normal_transaction *t,
 	*command = encoded;
 	return 0;
 }
+
+static inline int
+mt6797_join_prepare_data(struct mt6797_normal_transaction *t,
+			 const unsigned char *frame, size_t bytes,
+			 unsigned char wlan, unsigned char pid,
+			 unsigned int lifetime_ms, unsigned int attempt_count,
+			 unsigned char *output, size_t capacity,
+			 struct mt6797_hif_command *command)
+{
+	return mt6797_join_prepare_data_report(t, frame, bytes, wlan, pid, true,
+					       lifetime_ms, attempt_count, output,
+					       capacity, command);
