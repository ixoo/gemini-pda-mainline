+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -1484,10 +1484,11 @@ int mt6797_hif_send_security(struct mt6797_hif *hif, const u8 *frame,
 	return error;
 }
 
-int mt6797_hif_send_data(struct mt6797_hif *hif, const u8 *frame,
-			 size_t frame_bytes, u8 wlan, u8 pid,
-			 unsigned int lifetime_ms, unsigned int attempt_count,
-			 u64 deadline_ns)
+int mt6797_hif_send_data_report(struct mt6797_hif *hif, const u8 *frame,
+				size_t frame_bytes, u8 wlan, u8 pid,
+				bool status_report,
+				unsigned int lifetime_ms, unsigned int attempt_count,
+				u64 deadline_ns)
 {
 	struct mt6797_hif_pio_result transfer;
 	struct mt6797_hif_command command;
@@ -1503,10 +1504,11 @@ int mt6797_hif_send_data(struct mt6797_hif *hif, const u8 *frame,
 		error = -EIO;
 		goto unlock;
 	}
-	error = mt6797_join_prepare_data(&hif->normal, frame, frame_bytes,
-					 wlan, pid, lifetime_ms, attempt_count,
-					 hif->scratch, sizeof(hif->scratch),
-					 &command);
+	error = mt6797_join_prepare_data_report(&hif->normal, frame, frame_bytes,
+						wlan, pid, status_report,
+						lifetime_ms, attempt_count,
+						hif->scratch, sizeof(hif->scratch),
+						&command);
 	if (error)
 		goto unlock;
 	error = mt6797_hif_enter(hif, deadline_ns);
@@ -1527,6 +1529,15 @@ int mt6797_hif_send_data(struct mt6797_hif *hif, const u8 *frame,
 	return error;
 }
 
+int mt6797_hif_send_data(struct mt6797_hif *hif, const u8 *frame,
+			 size_t frame_bytes, u8 wlan, u8 pid,
+			 unsigned int lifetime_ms, unsigned int attempt_count,
+			 u64 deadline_ns)
+{
+	return mt6797_hif_send_data_report(hif, frame, frame_bytes, wlan, pid, true,
+					   lifetime_ms, attempt_count, deadline_ns);
+}
+
 int mt6797_hif_send_config(struct mt6797_hif *hif,
 			   enum mt6797_normal_config_kind kind,
 			   unsigned int sequence, const u8 *payload,
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index a6a26de25..62beaa469 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
