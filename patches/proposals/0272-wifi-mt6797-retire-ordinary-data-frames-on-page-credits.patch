From a1ff8c8b3933406bb77a5dc66aa33ed58c7d1763 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 07:59:35 -0400
Subject: [PATCH 4/4] wifi: mt6797: retire ordinary data frames on page credits

Every data descriptor requested a transmit-status report to the MCU with a
PID, and the frame was retired on the firmware's TX-done event received
through the receive path, 4-9 ms after the bus write. The vendor sets the
PID and the MCU report together only for frames with a completion handler
(nicTxFillDesc) and retires plain data on the page release counts.

Behind CONFIG_MT6797_DATA_CREDIT_COMPLETION an ordinary data frame goes out
without a PID or a status report and is retired at submission: mac80211 is
told the frame was transmitted without an acknowledgment report
(IEEE80211_TX_STAT_NOACK_TRANSMITTED), never a loss; the TX-done event and
the in-flight slot are not used for it; the page credits remain the flow
control. Management and security frames keep their PID, their report and
the TX-done event. The data-end record counts the frames retired this way.
A measurement variable for the transmit completion latency.
---
 drivers/net/wireless/mediatek/mt6797/Kconfig  | 10 +++
 drivers/net/wireless/mediatek/mt6797/hif.c    | 27 ++++---
 drivers/net/wireless/mediatek/mt6797/hif.h    |  5 ++
 .../wireless/mediatek/mt6797/join-submit.h    | 31 +++++---
 .../net/wireless/mediatek/mt6797/join-tx.h    | 35 +++++++--
 drivers/net/wireless/mediatek/mt6797/mac.c    | 72 ++++++++++++++-----
 6 files changed, 140 insertions(+), 40 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 12aaa06f7..30fe9c942 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -104,6 +104,16 @@ config MT6797_RX_RATE_RECORD
 	  receive ceiling is the path or the station's own capability
 	  advertisement. No behaviour changes.
 
+config MT6797_DATA_CREDIT_COMPLETION
+	bool "MT6797 Wi-Fi: retire ordinary data frames on page credits"
+	help
+	  Send ordinary data descriptors without a PID or the MCU transmit
+	  status report, as the vendor does for frames without a completion
+	  handler, and retire them at submission; the page credits remain
+	  the flow control. Management and security frames keep their
+	  reports and the TX done event. A measurement variable for the
+	  transmit completion latency.
+
 config MT6797_CCMP_TX_DEPTH
 	int
 	depends on MT6797_CCMP_TX_PUMP
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
