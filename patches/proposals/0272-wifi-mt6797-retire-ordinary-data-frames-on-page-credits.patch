@@ -387,6 +387,7 @@ struct mt6797_mac {
 	 * pages owed on that pool, counts, and the in-flight frame's class.
 	 */
 	unsigned int join_data_page_debt, join_data_tx_queued, join_data_tx_done;
+	unsigned int join_data_credit_retired; /* ordinary data retired at submission (0272) */
 	unsigned int join_data_tx_failed, join_data_tx_failures_in_row;
 	unsigned int join_data_expired;
 	bool join_inflight_data;
@@ -1711,6 +1712,7 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_data_rx_group = 0;
 	mac->join_data_rx_dropped = 0;
 	mac->ccmp_rx_delivered = 0;
+	mac->join_data_credit_retired = 0;
 #ifdef CONFIG_MT6797_RX_RATE_RECORD
 	memset(mac->rx_rates, 0, sizeof(mac->rx_rates));
 	mac->rx_rates_other = 0;
@@ -2860,11 +2862,11 @@ static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 #endif
 	mac->join_hold_until = ktime_get_ns();
 	dev_info(wiphy_dev(mac->hw->wiphy),
-		 "one-shot WLAN join data phase end: reason=%s elapsed_ms=%llu rx_delivered=%u tx_queued=%u tx_done=%u tx_failed=%u tx_credits=%u\n",
+		 "one-shot WLAN join data phase end: reason=%s elapsed_ms=%llu rx_delivered=%u tx_queued=%u tx_done=%u tx_failed=%u tx_credits=%u credit_retired=%u\n",
 		 reason, (ktime_get_ns() - mac->join_data_started) / NSEC_PER_MSEC,
 		 mac->ccmp_rx_delivered,
 		 mac->join_data_tx_queued, mac->join_data_tx_done, mac->join_data_tx_failed,
-		 mac->join_data_credits);
+		 mac->join_data_credits, mac->join_data_credit_retired);
 	{
 		unsigned int dma_tx, dma_rx, dma_poll_max, dma_failures;
 
@@ -3313,6 +3315,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	struct mt6797_join_rx_frame frame;
 	struct mt6797_scan_frame beacon;
 	struct sk_buff_head received, discard, data_completed;
+	bool credit_only = false;
 	struct sk_buff *skb, *completed = NULL, *internal = NULL;
 	unsigned long flags, snapshot_delay;
 	unsigned int n, port, pages;
@@ -3663,23 +3666,54 @@ static void mt6797_mac_join_work(struct work_struct *work)
 				memcpy(mac->join_eth + 6, skb->data + 10, ETH_ALEN);
 				memcpy(mac->join_eth + 12, skb->data + 30, 2);
 				memcpy(mac->join_eth + 14, skb->data + 32, skb->len - 32);
+				credit_only = !port &&
+					      IS_ENABLED(CONFIG_MT6797_DATA_CREDIT_COMPLETION);
+				if (credit_only) {
+					/* No PID and no MCU status report for an ordinary
+					 * data frame: it is retired on its page credits, as
+					 * the vendor retires plain data (0272).
+					 */
+					mac->join_pid = 0;
+				} else {
 #ifdef CONFIG_MT6797_CCMP_TX_PID_REUSE
-				ret = mt6797_ccmp_assign_pid(mac, false, !port);
-				if (ret)
-					goto failed;
+					ret = mt6797_ccmp_assign_pid(mac, false, !port);
+					if (ret)
+						goto failed;
 #else
-				mac->join_pid = mac->join_next_pid++;
+					mac->join_pid = mac->join_next_pid++;
 #endif
+				}
 				mac->join_last_acked = false;
 				reinit_completion(&mac->join_frame_done);
 				pages = (MT6797_JOIN_TX_DESC_BYTES + eth_bytes + 127) / 128;
 				if (!port) {
-					ret = mt6797_hif_send_data(mac->hif, mac->join_eth, eth_bytes,
-								   1, mac->join_pid, 500, 3, deadline);
+					ret = mt6797_hif_send_data_report(mac->hif,
+									  mac->join_eth,
+									  eth_bytes, 1,
+									  mac->join_pid,
+									  !credit_only,
+									  500, 3, deadline);
 					if (ret)
 						goto failed;
-					mac->join_inflight_data = true;
+					mac->join_inflight_data = !credit_only;
 					mac->join_data_page_debt += pages;
+					if (credit_only) {
+						/* Retired at submission: mac80211 sees a
+						 * frame transmitted without an
+						 * acknowledgment report, never a loss; the
+						 * TX done event and the slot are not used.
+						 */
+						struct ieee80211_tx_info *cb;
+
+						cb = IEEE80211_SKB_CB(skb);
+
+						ieee80211_tx_info_clear_status(cb);
+						cb->flags |= IEEE80211_TX_STAT_NOACK_TRANSMITTED;
+						__skb_queue_tail(&data_completed, skb);
+						mac->join_inflight = NULL;
+						mac->join_data_tx_done++;
+						mac->join_data_credit_retired++;
+					}
 					if (!mac->join_data_tx_done && !mac->join_data_tx_failed)
 						dev_info(wiphy_dev(mac->hw->wiphy),
 							 "one-shot WLAN join data TX: first pid=%u pages=%u bytes=%zu\n",
@@ -3740,15 +3774,19 @@ static void mt6797_mac_join_work(struct work_struct *work)
 #ifdef CONFIG_MT6797_CCMP_TX_PUMP
 			pump_progress = true;
 #endif
-			if (MT6797_DATA_DEPTH > 1 && mac->join_inflight_data) {
-				if (!mt6797_data_put(&mac->data_slots, mac->join_pid,
-						     mac->join_inflight,
-						     mac->join_frame_deadline)) {
-					ret = -EPROTO;
-					goto failed;
+			if (MT6797_DATA_DEPTH > 1 &&
+			    (mac->join_inflight_data || credit_only)) {
+				if (mac->join_inflight_data) {
+					if (!mt6797_data_put(&mac->data_slots, mac->join_pid,
+							     mac->join_inflight,
+							     mac->join_frame_deadline)) {
+						ret = -EPROTO;
+						goto failed;
+					}
+					mac->join_inflight = NULL;
+					mac->join_inflight_data = false;
 				}
-				mac->join_inflight = NULL;
-				mac->join_inflight_data = false;
+				credit_only = false;
 				/* Submit every admissible data frame in this pass, up
 				 * to the in-flight depth, before the receive loop and
 				 * the next pass's status reads run again.
