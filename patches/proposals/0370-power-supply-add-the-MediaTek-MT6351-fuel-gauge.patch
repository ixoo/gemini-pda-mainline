From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 31 Oct 2026 15:18:47 -0400
Subject: [PATCH] power: supply: add the MediaTek MT6351 fuel gauge

The MT6351 PMIC measures battery current and charge in its FGADC coulomb
counter. Mainline has no driver for it; the vendor stack reads the counter
in the kernel and runs its estimator in userspace.

Report what the hardware measures: the pack voltage from the PMIC AUXADC,
the current and charge counter from one latched FGADC read (the vendor
sequence: read request, latch status, read, clear, release), and the
battery temperature from a thermal zone. The current uses 158.122 uA per
count and the counter the vendor's 17-bit slice at 44.98 uAh per step,
both for a 20 mOhm base, rescaled for the board's sense resistor and gain
correction. The capacity is the monitored battery's OCV table at the
terminal voltage corrected by I x R. The FGADC is left as the bootloader
configured it; only the software read bits of FGADC_CON0 are written.
---
 drivers/power/supply/Kconfig             |  10 +
 drivers/power/supply/Makefile            |   1 +
 drivers/power/supply/mt6351-fuel-gauge.c | 317 +++++++++++++++++++++++
 3 files changed, 328 insertions(+)
 create mode 100644 drivers/power/supply/mt6351-fuel-gauge.c

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index 83392ed6a..f1ed82724 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -444,6 +444,16 @@ config BATTERY_MAX17040
 
 	  Driver can be build as a module (max17040_battery).
 
+config BATTERY_MT6351
+	tristate "MediaTek MT6351 PMIC fuel gauge"
+	depends on MFD_MT6397 && IIO && THERMAL
+	help
+	  Say Y or M to report the battery voltage, current, charge counter,
+	  temperature and an OCV-based capacity from the MediaTek MT6351 PMIC
+	  fuel gauge. The current and charge come from its FGADC coulomb
+	  counter, the voltage from the PMIC AUXADC and the temperature from a
+	  thermal zone; the capacity comes from the battery's OCV tables.
+
 config BATTERY_MAX17042
 	tristate "Maxim MAX17042/17047/17050/8997/8966 family Fuel Gauge"
 	depends on I2C
diff --git a/drivers/power/supply/Makefile b/drivers/power/supply/Makefile
index 7ee839dca..b58c72ace 100644
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -58,6 +58,7 @@ obj-$(CONFIG_CHARGER_DA9150)	+= da9150-charger.o
 obj-$(CONFIG_BATTERY_DA9150)	+= da9150-fg.o
 obj-$(CONFIG_BATTERY_MAX17040)	+= max17040_battery.o
 obj-$(CONFIG_BATTERY_MAX17042)	+= max17042_battery.o
+obj-$(CONFIG_BATTERY_MT6351)	+= mt6351-fuel-gauge.o
 obj-$(CONFIG_BATTERY_MAX1720X)	+= max1720x_battery.o
 obj-$(CONFIG_BATTERY_MAX1721X)	+= max1721x_battery.o
 obj-$(CONFIG_BATTERY_RT5033)	+= rt5033_battery.o
diff --git a/drivers/power/supply/mt6351-fuel-gauge.c b/drivers/power/supply/mt6351-fuel-gauge.c
new file mode 100644
index 000000000..3ba4fdaed
--- /dev/null
+++ b/drivers/power/supply/mt6351-fuel-gauge.c
@@ -0,0 +1,317 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6351 PMIC fuel gauge
+ *
+ * Reports what the MT6351 measures: the pack voltage from its AUXADC, the
+ * battery current and the charge counter from its FGADC coulomb counter, and
+ * the battery temperature from the battery thermal zone. The state of charge
+ * is the battery's open-circuit voltage, the measured voltage corrected for
+ * the drop across the cell and meter resistance, looked up in its OCV tables.
+ * No vendor estimator is involved: the vendor stack runs one in userspace.
+ *
+ * The FGADC is left as the bootloader configured it; this driver only latches
+ * and clears its software read.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/iio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/thermal.h>
+
+#define MT6351_FGADC_CON0		0x0ca4
+#define MT6351_FGADC_CON1		0x0ca6	/* FG_CAR[34:19] */
+#define MT6351_FGADC_CON2		0x0ca8	/* FG_CAR[18:3] */
+#define MT6351_FGADC_CON11		0x0cba	/* FG_CURRENT_OUT */
+/* The software read controls in CON0's upper byte; the lower byte is left. */
+#define MT6351_FG_CTRL_MASK		GENMASK(15, 8)
+#define MT6351_FG_SW_READ_PRE		BIT(9)
+#define MT6351_FG_LATCHDATA_ST		BIT(10)
+#define MT6351_FG_SW_CLEAR		BIT(11)
+#define MT6351_FG_ON			BIT(0)
+#define MT6351_FG_POLL_US		1000
+#define MT6351_FG_TIMEOUT_US		100000
+
+/* 158.122 uA per count and 44.98 uAh per counter step, for a 20 mOhm sense. */
+#define MT6351_FG_CURRENT_NA		158122
+#define MT6351_FG_CHARGE_NAH		44983
+#define MT6351_FG_SENSE_BASE_MOHM	20
+
+/* Within this current, the battery is reported as not charging. */
+#define MT6351_FG_IDLE_UA		20000
+
+struct mt6351_fg {
+	struct device *dev;
+	struct regmap *regmap;
+	struct iio_channel *vbat;
+	struct thermal_zone_device *tz;
+	struct power_supply *psy;
+	struct power_supply_battery_info *info;
+	/* Serializes the latched FGADC read. */
+	struct mutex lock;
+	u32 sense_mohm;
+	u32 car_tune;
+	u32 resistance_mohm;
+};
+
+/* Scale a raw FGADC count for this board's sense resistor and CAR tune. */
+static s64 mt6351_fg_scale(struct mt6351_fg *fg, s64 count, s64 unit)
+{
+	return div_s64(count * unit * MT6351_FG_SENSE_BASE_MOHM * fg->car_tune,
+		       (s64)fg->sense_mohm * 100 * 1000);
+}
+
+/*
+ * The latched read, as the vendor does it: request the latch, wait for the
+ * latch status, read the current and the counter, clear, wait for the status
+ * to drop, and release. Charging is positive.
+ */
+static int mt6351_fg_read(struct mt6351_fg *fg, int *current_ua, int *charge_uah)
+{
+	unsigned int con0, cur, car_h, car_l, raw;
+	s64 count;
+	int ret;
+
+	guard(mutex)(&fg->lock);
+
+	ret = regmap_read(fg->regmap, MT6351_FGADC_CON0, &con0);
+	if (ret)
+		return ret;
+	if (!(con0 & MT6351_FG_ON))
+		return -ENODATA;
+
+	ret = regmap_update_bits(fg->regmap, MT6351_FGADC_CON0, MT6351_FG_CTRL_MASK,
+				 MT6351_FG_SW_READ_PRE);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(fg->regmap, MT6351_FGADC_CON0, con0,
+				       con0 & MT6351_FG_LATCHDATA_ST,
+				       MT6351_FG_POLL_US, MT6351_FG_TIMEOUT_US);
+	if (!ret)
+		ret = regmap_read(fg->regmap, MT6351_FGADC_CON11, &cur);
+	if (!ret)
+		ret = regmap_read(fg->regmap, MT6351_FGADC_CON1, &car_h);
+	if (!ret)
+		ret = regmap_read(fg->regmap, MT6351_FGADC_CON2, &car_l);
+
+	/* Clear and release even after a failed read. */
+	regmap_update_bits(fg->regmap, MT6351_FGADC_CON0, MT6351_FG_CTRL_MASK,
+			   MT6351_FG_SW_CLEAR);
+	regmap_read_poll_timeout(fg->regmap, MT6351_FGADC_CON0, con0,
+				 !(con0 & MT6351_FG_LATCHDATA_ST),
+				 MT6351_FG_POLL_US, MT6351_FG_TIMEOUT_US);
+	regmap_update_bits(fg->regmap, MT6351_FGADC_CON0, MT6351_FG_CTRL_MASK, 0);
+	if (ret)
+		return ret;
+
+	/* A 16-bit sign-magnitude-like code: above 32767 is discharge. */
+	count = cur > 32767 ? -(s64)(65535 - cur) : (s64)cur;
+	*current_ua = mt6351_fg_scale(fg, count, MT6351_FG_CURRENT_NA) / 1000;
+
+	/*
+	 * The vendor's 17-bit slice of the 35-bit counter, with the sign in
+	 * CAR[34]; 0 and 0x1ffff are its zero sentinels.
+	 */
+	raw = (car_l >> 11) | ((car_h & 0xfff) << 5);
+	if (raw == 0 || raw == 0x1ffff)
+		count = 0;
+	else if (car_h & BIT(15))
+		count = -(s64)(0x1ffff - raw);
+	else
+		count = raw;
+	*charge_uah = mt6351_fg_scale(fg, count, MT6351_FG_CHARGE_NAH) / 1000;
+
+	return 0;
+}
+
+static int mt6351_fg_voltage(struct mt6351_fg *fg, int *uv)
+{
+	int raw, scale_mv, scale_den, ret;
+
+	ret = iio_read_channel_raw(fg->vbat, &raw);
+	if (ret < 0)
+		return ret;
+	/* The channel scale is the full-scale millivolts of its 15-bit code. */
+	ret = iio_read_channel_scale(fg->vbat, &scale_mv, &scale_den);
+	if (ret < 0)
+		return ret;
+	*uv = div_s64((s64)raw * scale_mv * 1000, 1 << 15);
+
+	return 0;
+}
+
+static int mt6351_fg_get_property(struct power_supply *psy,
+				  enum power_supply_property psp,
+				  union power_supply_propval *val)
+{
+	struct mt6351_fg *fg = power_supply_get_drvdata(psy);
+	int uv, ua, uah, mc, ret;
+
+	/* The battery description is read just after registration. */
+	if (!READ_ONCE(fg->info))
+		return -ENODATA;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		return mt6351_fg_voltage(fg, &val->intval);
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = thermal_zone_get_temp(fg->tz, &mc);
+		if (ret)
+			return ret;
+		val->intval = mc / 100;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = fg->info->charge_full_design_uah;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = fg->info->voltage_max_design_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = fg->info->voltage_min_design_uv;
+		return 0;
+	default:
+		break;
+	}
+
+	ret = mt6351_fg_read(fg, &ua, &uah);
+	if (ret)
+		return ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		val->intval = ua;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
+		val->intval = uah;
+		return 0;
+	case POWER_SUPPLY_PROP_STATUS:
+		if (ua > MT6351_FG_IDLE_UA)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else if (ua < -MT6351_FG_IDLE_UA)
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = mt6351_fg_voltage(fg, &uv);
+		if (!ret)
+			ret = thermal_zone_get_temp(fg->tz, &mc);
+		if (ret)
+			return ret;
+		/* The open-circuit voltage: charging current raises the terminal. */
+		uv -= (s64)ua * fg->resistance_mohm / 1000;
+		ret = power_supply_batinfo_ocv2cap(fg->info, uv, mc / 1000);
+		if (ret < 0)
+			return ret;
+		val->intval = clamp(ret, 0, 100);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const enum power_supply_property mt6351_fg_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+};
+
+static const struct power_supply_desc mt6351_fg_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = mt6351_fg_props,
+	.num_properties = ARRAY_SIZE(mt6351_fg_props),
+	.get_property = mt6351_fg_get_property,
+};
+
+static int mt6351_fg_probe(struct platform_device *pdev)
+{
+	struct power_supply_battery_info *info;
+	struct power_supply_config cfg = {};
+	struct device *dev = &pdev->dev;
+	const char *zone;
+	struct mt6351_fg *fg;
+	int ret;
+
+	fg = devm_kzalloc(dev, sizeof(*fg), GFP_KERNEL);
+	if (!fg)
+		return -ENOMEM;
+	fg->dev = dev;
+	mutex_init(&fg->lock);
+
+	/* The regmap is the PMIC wrapper's, parent of the mt6397 MFD. */
+	fg->regmap = dev_get_regmap(dev->parent->parent, NULL);
+	if (!fg->regmap)
+		return dev_err_probe(dev, -ENODEV, "no PMIC regmap\n");
+
+	fg->vbat = devm_iio_channel_get(dev, "vbat");
+	if (IS_ERR(fg->vbat))
+		return dev_err_probe(dev, PTR_ERR(fg->vbat), "no battery voltage channel\n");
+
+	if (device_property_read_string(dev, "mediatek,battery-thermal-zone", &zone))
+		return dev_err_probe(dev, -EINVAL, "no battery thermal zone\n");
+	fg->tz = thermal_zone_get_zone_by_name(zone);
+	if (IS_ERR(fg->tz))
+		return dev_err_probe(dev, -EPROBE_DEFER, "battery thermal zone %s not ready\n",
+				     zone);
+
+	if (device_property_read_u32(dev, "mediatek,sense-resistor-milliohm", &fg->sense_mohm) ||
+	    !fg->sense_mohm)
+		return dev_err_probe(dev, -EINVAL, "no sense resistor\n");
+	if (device_property_read_u32(dev, "mediatek,car-tune", &fg->car_tune))
+		fg->car_tune = 100;
+
+	cfg.drv_data = fg;
+	cfg.fwnode = dev_fwnode(dev);
+	fg->psy = devm_power_supply_register(dev, &mt6351_fg_desc, &cfg);
+	if (IS_ERR(fg->psy))
+		return dev_err_probe(dev, PTR_ERR(fg->psy), "cannot register battery\n");
+
+	ret = power_supply_get_battery_info(fg->psy, &info);
+	if (ret)
+		return dev_err_probe(dev, ret, "no monitored battery\n");
+	if (!info->ocv_table[0])
+		return dev_err_probe(dev, -EINVAL, "monitored battery has no OCV table\n");
+	fg->resistance_mohm = info->factory_internal_resistance_uohm > 0 ?
+			      info->factory_internal_resistance_uohm / 1000 : 0;
+	WRITE_ONCE(fg->info, info);
+
+	return 0;
+}
+
+static const struct of_device_id mt6351_fg_of_match[] = {
+	{ .compatible = "mediatek,mt6351-fuel-gauge" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6351_fg_of_match);
+
+static struct platform_driver mt6351_fg_driver = {
+	.driver = {
+		.name = "mt6351-fuel-gauge",
+		.of_match_table = mt6351_fg_of_match,
+	},
+	.probe = mt6351_fg_probe,
+};
+module_platform_driver(mt6351_fg_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6351 PMIC fuel gauge");
+MODULE_LICENSE("GPL");
-- 
2.43.0

