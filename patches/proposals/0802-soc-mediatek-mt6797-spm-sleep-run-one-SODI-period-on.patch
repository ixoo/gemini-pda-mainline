+
 struct spm_wake {
 	u32 assert_pc, r12, r12_ext, raw_sta, raw_ext_sta, wake_misc;
 	u32 timer_out, r13, idle_sta, debug_flag, event_reg, isr;
@@ -211,12 +254,13 @@ static struct {
 	bool gic_masked;
 	void __iomem *infra;
 	void __iomem *topck;
-	u32 im_ptr;
-	u32 im_len;
-	u32 vec[16];
+	struct spm_scen sleep;
+	struct spm_scen sodi;
 	u32 flags;
 	bool hwcid_5140;
 	int irq;
+	struct dentry *debugfs;
+	u32 dummy1;
 
 	/* per-suspend state */
 	bool pmic_done;
@@ -245,6 +289,10 @@ static bool gic_mask = true;
 module_param(gic_mask, bool, 0644);
 MODULE_PARM_DESC(gic_mask, "Disable every SPI but the SPM's at the GIC while CPU0 waits");
 
+static bool sodi_pdn;
+module_param(sodi_pdn, bool, 0644);
+MODULE_PARM_DESC(sodi_pdn, "SODI test in PDN mode (DRAM PHY and MEMPLL off) instead of CG mode");
