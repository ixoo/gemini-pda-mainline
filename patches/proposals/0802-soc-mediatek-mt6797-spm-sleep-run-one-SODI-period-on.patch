@@ -189,6 +221,17 @@ struct spm_slot {
 	u32 val;
 };
 
+/* What differs between the suspend program and one SODI period */
+struct spm_scen {
+	u32 im_ptr, im_len, vec[16];
+	u32 src_req, src2_mask;
+	unsigned int wfi_count;	/* WFI_EN words set, from MP0_CPU0 */
