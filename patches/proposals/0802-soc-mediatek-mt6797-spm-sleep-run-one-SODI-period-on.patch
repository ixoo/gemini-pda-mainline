 	0x6b, 0x4a, 0x67, 0xe7, 0xd7, 0x70, 0xf4, 0xe0,
 };
 
+#define SODI_FW_NAME		"mediatek/mt6797/pcm_sodi.bin"
+
+static const u8 sodi_fw_sha256[SHA256_DIGEST_SIZE] = {
+	0xdd, 0xa8, 0xcc, 0xa1, 0xe1, 0x10, 0xd5, 0x71,
+	0x37, 0xaf, 0xb8, 0xef, 0x49, 0x57, 0xda, 0x75,
+	0x8c, 0x19, 0xd3, 0x8d, 0xb4, 0x5e, 0xa2, 0xbb,
+	0x30, 0xbc, 0x71, 0x33, 0xcc, 0x12, 0x2a, 0xe4,
+};
+
 /* Physical blocks */
 #define SPM_PHYS		0x10006000
 #define PWRAP_PHYS		0x1000d000
@@ -104,7 +118,9 @@ static const u8 spm_fw_sha256[SHA256_DIGEST_SIZE] = {
 #define SPM_SW_FLAG		0x600
 #define SPM_SW_DEBUG		0x604
 #define SPM_SW_RSV_0		0x608
+#define SPM_PASR_DPD_0		0x630
 #define SPM_PASR_DPD_3		0x63c
+#define DUMMY1_PWR_CON		0x2b4
 
 #define SPM_KEY			(0xb16 << 16)
 #define PCM_KICK_L		BIT(0)
@@ -138,6 +154,19 @@ static const u8 spm_fw_sha256[SHA256_DIGEST_SIZE] = {
 /* Wake sources: PCM timer and EINT */
 #define S1_WAKE_SRC		(BIT(0) | BIT(6))
 
+/*
+ * SPM_SW_FLAG for one SODI period (D3): S1's flags without bit 7, which
+ * pcm_sodi tests in its NFC clock-buffer handlers with another meaning, and
+ * with DIS_VCORE_DVS (bit 3), so the program issues no PMIC-wrapper command
+ * at all. CG mode (bit 12) keeps the DRAM PHY and MEMPLL up: DRAM only goes
+ * into self-refresh. sodi_pdn clears it.
+ */
+#define SODI_FLAGS		((S1_FLAGS & ~BIT(7)) | BIT(3) | BIT(12))
+#define SODI_FLAG_CG_MODE	BIT(12)
+
+/* The I2C controller the programs reset (I2C6: the CPU bucks) */
+#define I2C6_PHYS		0x1100e000
+
 /* PMIC wrapper DVFS command slots */
 #define PWRAP_DVFS_ADR(n)	(0x10c + 8 * (n))
 #define PWRAP_DVFS_WDATA(n)	(0x110 + 8 * (n))
@@ -162,6 +191,8 @@ static const u8 spm_fw_sha256[SHA256_DIGEST_SIZE] = {
 #define CG0_GCE			BIT(9)
 #define CG1_AUXADC		BIT(10)
 #define CG2_I2C_APPM		BIT(1)
+#define CG1_AP_DMA		BIT(18)
+#define CG2_SSUSB		(BIT(9) | BIT(18) | BIT(24))
 #define CLK_CFG_0		0x040
 
 /* MT6351 */
@@ -182,6 +213,7 @@ static const u16 spm_saved_regs[] = {
 	PCM_TIMER_VAL, SPM_SCP_MAILBOX, SPM_IRQ_MASK, SPM_SRC_REQ, SPM_SRC_MASK,
 	SPM_SRC2_MASK, SPM_WAKEUP_EVENT_MASK, SPM_MAS_PAUSE_MASK_B,
 	SPM_MAS_PAUSE2_MASK_B, SPM_SW_FLAG, SPM_SW_RSV_0, SPM_PASR_DPD_3,
+	SPM_PASR_DPD_0,
 };
 
