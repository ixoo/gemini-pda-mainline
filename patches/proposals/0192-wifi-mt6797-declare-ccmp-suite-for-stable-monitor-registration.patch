From 0fcdc1ee65d588a2fc9cdbfc61cd39761cb71e01 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Wed, 14 Oct 2026 10:41:44 +0000
Subject: [PATCH] wifi: mt6797: declare CCMP suite for stable monitor
 registration

CCMP1 stopped before association: mac80211 main.c:1076 rejects
SW_CRYPTO_CONTROL when wiphy->cipher_suites is NULL. Keep the flag and
the actual key/TX/no-fallback gates, and declare only the supported
CCMP suite with static lifetime/count in the new-mode branch.

Initial PTK and GTK install still use the same CCMP admission. Do not
advertise WEP/TKIP/GCMP/MFP or change callbacks, PN, HIF, monitor commands,
budgets, replay/lifetime decisions or legacy native profile behavior.

The focused host fixture extracts the actual7.1.3 cipher predicate and
actual parent/fixed registration blocks: reproduce parent-EINVAL, accept
the CCMP-only list with flags unchanged, preserve normal-mode defaults
and FIPS refusal. This is source/host evidence, not parser or HW support.

Internal experiment archive, synthetic non-certifying author; no DCO
certification and not submission-ready.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index ce39e03..791277d 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -34,6 +34,7 @@ MODULE_PARM_DESC(native_delivery_diag,
 #include <linux/rcupdate.h>
 #include "ccmp-rx.h"
 static bool ccmp_stable_epoch;
+static const u32 mt6797_ccmp_ciphers[] = { WLAN_CIPHER_SUITE_CCMP };
 module_param(ccmp_stable_epoch, bool, 0444);
 MODULE_PARM_DESC(ccmp_stable_epoch,
 		 "Arm one monitor-assisted stable PTK epoch; excludes native_delivery_diag");
@@ -4484,6 +4485,8 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 	init_completion(&mac->ccmp_key_done);
 	init_completion(&mac->ccmp_cleanup_done);
 	if (ccmp_stable_epoch) {
+		hw->wiphy->cipher_suites = mt6797_ccmp_ciphers;
+		hw->wiphy->n_cipher_suites = ARRAY_SIZE(mt6797_ccmp_ciphers);
 		ieee80211_hw_set(hw, SUPPORTS_RX_DECAP_OFFLOAD);
 		ieee80211_hw_set(hw, SW_CRYPTO_CONTROL);
 	}
