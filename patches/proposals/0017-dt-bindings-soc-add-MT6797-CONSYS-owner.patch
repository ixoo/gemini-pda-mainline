From c72cb64f1283f5a46dffd1bff18d5ac15c684bab Mon Sep 17 00:00:00 2001
From: MT6797 internal experiment <nobody@example.invalid>
Date: Sat, 26 Sep 2026 22:04:01 -0400
Subject: [PATCH 1/2] dt-bindings: soc: add MT6797 CONSYS owner

Describe an unpowered shared owner with one boot-allocated no-map memory
region. No device-tree node is enabled here.

Internal experiment patch with a synthetic snapshot parent. No DCO
certification.
---
 .../soc/mediatek/mediatek,mt6797-consys.yaml  | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
new file mode 100644
index 0000000..11ffa59
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-consys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 shared connectivity resources
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description: |
+  The CONSYS manager owns the boot-allocated no-map firmware reservation
+  shared by WLAN and WMT. It does not attach to a power domain during probe;
+  later children can be populated only after their common prerequisites are
+  prepared.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-consys
+
+  memory-region:
+    maxItems: 1
+    description: Boot-allocated no-map CONSYS firmware reservation.
+
+required:
+  - compatible
+  - memory-region
+
+additionalProperties: false
+
+examples:
+  - |
+    / {
+        reserved-memory {
+            #address-cells = <2>;
+            #size-cells = <2>;
+            ranges;
+
+            consys_reserved: consys-reserve-memory {
+                compatible = "mediatek,consys-reserve-memory";
+                no-map;
+                size = <0 0x200000>;
+                alignment = <0 0x200000>;
+            };
+        };
+
+        consys {
+            compatible = "mediatek,mt6797-consys";
+            memory-region = <&consys_reserved>;
+        };
+    };
