From 50539da09d9d3ffd9be3bdcc43f99cbeb35f92be Mon Sep 17 00:00:00 2001
From: Codex Experiment <codex-experiment@example.invalid>
Date: Sun, 18 Oct 2026 18:02:03 -0400
Subject: [PATCH] wifi: mt6797: quarantine one cleanup page without a healthy
 terminal

Keep the retained page in the physical ledger. Admit only teardown
commands at the one-page floor and latch each command's actual
pre-submission debt. Completion with debt is a distinct permanent close,
never healthy stage 3. No quota, deadline, PID or key reuse change.

Internal experiment archive, synthetic non-certifying author;
no DCO certification and not an upstream submission.
---
 drivers/net/wireless/mediatek/mt6797/hif.c    |  28 +++++
 drivers/net/wireless/mediatek/mt6797/hif.h    |   2 +
 .../mediatek/mt6797/join-command-submit.h     |  17 +++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 101 ++++++++++++++++--
 .../wireless/mediatek/mt6797/normal_command.h |  35 ++++++
 5 files changed, 174 insertions(+), 9 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index c6c1505..7ef5ca0 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -741,6 +741,34 @@ bool mt6797_hif_cleanup_abort_ready(struct mt6797_hif *hif)
 	return ready;
 }
 
+int mt6797_hif_retain_cleanup_page(struct mt6797_hif *hif)
+{
+	int error = -EBUSY;
+
+	if (!hif || !mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (hif->firmware_ready && hif->capability_complete &&
+	    hif->transaction->phase == MT6797_INIT_IDLE &&
+	    !hif->normal.cleanup_retained_pages &&
+	    mt6797_join_cleanup_abort_ready(&hif->normal, 1)) {
+		hif->normal.cleanup_retained_pages = 1;
+		error = 0;
+	}
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+
+bool mt6797_hif_cleanup_ready(struct mt6797_hif *hif)
+{
+	bool ready;
+
+	if (!hif || !mutex_trylock(&hif->mutex))
+		return false;
+	ready = mt6797_normal_cleanup_ready(&hif->normal);
+	mutex_unlock(&hif->mutex);
+	return ready;
+}
+
 #endif
 
 int mt6797_hif_join_station(struct mt6797_hif *hif, unsigned int sequence,
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index aaafe55..c4af682 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -229,6 +229,8 @@ int mt6797_hif_join_pm_abort(struct mt6797_hif *hif, unsigned int sequence,
 int mt6797_hif_join_pm_abort_debt(struct mt6797_hif *hif, unsigned int sequence,
 				  unsigned int deauth_pages, u64 deadline_ns);
 bool mt6797_hif_cleanup_abort_ready(struct mt6797_hif *hif);
+int mt6797_hif_retain_cleanup_page(struct mt6797_hif *hif);
+bool mt6797_hif_cleanup_ready(struct mt6797_hif *hif);
 #endif
 int mt6797_hif_join_station(struct mt6797_hif *hif, unsigned int sequence,
 	const u8 *ap, unsigned int state, unsigned int aid,
diff --git a/drivers/net/wireless/mediatek/mt6797/join-command-submit.h b/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
index e1d726d..606b7b3 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
@@ -100,7 +100,24 @@ mt6797_join_prepare_command(struct mt6797_normal_transaction *t,
 	}
 	if (bytes != required)
 		return -EINVAL;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	if (t->cleanup_retained_pages) {
+		/* Only removal/abort encoders, never a key install, STA activation
+		 * or another channel request. Their original length checks precede
+		 * every field read here. Each new debit remains a real debit.
+		 */
+		if ((cid == 0x07 && (payload[0] || payload[1] || payload[11] || payload[13])) ||
+		    (cid == 0x14 && (payload[0] || payload[1] != 1 || payload[2] || payload[3])) ||
+		    (cid == 0x1c && (!payload[1] || payload[2] != 1)) ||
+		    (cid != 0x07 && cid != 0x14 && cid != 0x17 && cid != 0x1c))
+			return -EOPNOTSUPP;
+		if (!mt6797_normal_cleanup_ready(t))
+			return -EBUSY;
+	}
+	if (!t->cleanup_retained_pages && t->tc4_free != t->tc4_limit)
+#else
 	if (t->tc4_free != t->tc4_limit)
+#endif
 		return -EBUSY;
 	error = mt6797_normal_encode(t, cid, 1, sequence, payload, bytes,
 				     8 + bytes, MT6797_NORMAL_CONFIG_TX,
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index c261a00..ab6b50a 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -229,6 +229,9 @@ struct mt6797_mac {
 	bool ccmp_loss_reported;
 	unsigned int ccmp_deauth_timeouts, ccmp_deauth_late;
 	u8 ccmp_deauth_retired_pid;
+	unsigned int ccmp_cleanup_retained_pages, ccmp_cleanup_credit_floor;
+	unsigned int ccmp_cleanup_op, ccmp_cleanup_sequence;
+	bool ccmp_cleanup_credit_active, ccmp_cleanup_bounded_done;
 #endif
 	struct ieee80211_sta __rcu *ccmp_sta;
 	/* Cookies only: never dereferenced, withdrawn before DISABLE_KEY returns. */
@@ -512,6 +515,16 @@ static bool mt6797_ccmp_deauth_retire(struct mt6797_mac *mac, u64 now,
 	    now < mac->join_frame_deadline || now >= mac->join_deadline ||
 	    !discard || !internal || *internal)
 		return false;
+	if (mac->join_page_debt) {
+		int ret = mt6797_hif_retain_cleanup_page(mac->hif);
+
+		if (ret) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN cleanup debt admission: status=%d\n", ret);
+			return false;
+		}
+		mac->ccmp_cleanup_retained_pages = 1;
+	}
 	mac->ccmp_deauth_timeouts++;
 	mac->ccmp_deauth_retired_pid = mac->join_pid;
 	*internal = mac->join_internal;
@@ -526,16 +539,24 @@ static bool mt6797_ccmp_deauth_retire(struct mt6797_mac *mac, u64 now,
 	return true;
 }
 
-static bool mt6797_ccmp_deauth_abort_owed(const struct mt6797_mac *mac)
+static bool mt6797_ccmp_cleanup_debt_ready(const struct mt6797_mac *mac)
 {
 	return ccmp_stable_epoch && mac->ccmp_deauth_timeouts == 1 &&
 		mac->join_cleanup_requested && mac->join_data_ended &&
 		!mac->first_error && !mac->closing && !mac->join_retired &&
-		!mac->join_cleanup_stage && mac->ccmp_pm_connected &&
-		!mac->ccmp_pm_abort_pending && !mac->ccmp_pm_abort_credited &&
+		mac->join_cleanup_stage <= 3 && mac->ccmp_cleanup_retained_pages == 1 &&
 		mac->join_page_debt == 1 && !mac->join_inflight;
 }
 
+static bool mt6797_ccmp_cleanup_credit_ready(const struct mt6797_mac *mac)
+{
+	if (!ccmp_stable_epoch || !mac->ccmp_cleanup_credit_active)
+		return !mac->join_page_debt;
+	return mac->ccmp_cleanup_credit_floor <= 1 &&
+		mac->ccmp_cleanup_credit_floor <= mac->ccmp_cleanup_retained_pages &&
+		mac->join_page_debt <= mac->ccmp_cleanup_credit_floor;
+}
+
 /* A late completion for this lifetime's one retired PID cannot own a second
  * skb or credit. Unknown PIDs, invalid status and malformed events still fail.
  */
@@ -1390,7 +1411,12 @@ static int mt6797_mac_join_guard(struct mt6797_mac *mac, u64 deadline)
 				 "one-shot WLAN join credit: pages=%u remaining=%u\n",
 				 account.released_pages, mac->join_page_debt);
 #endif
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+		if (mac->join_credit_pending && mt6797_ccmp_cleanup_credit_ready(mac)) {
+			mac->ccmp_cleanup_credit_active = false;
+#else
 		if (mac->join_credit_pending && !mac->join_page_debt) {
+#endif
 			mac->join_credit_pending = false;
 			complete_all(&mac->join_credit_done);
 		}
@@ -1724,7 +1750,7 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
 #ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
 	if (queued || mac->join_inflight ||
-	    (mac->join_page_debt && !mt6797_ccmp_deauth_abort_owed(mac)) ||
+	    (mac->join_page_debt && !mt6797_ccmp_cleanup_debt_ready(mac)) ||
 #else
 	if (queued || mac->join_inflight || mac->join_page_debt ||
 #endif
@@ -1754,8 +1780,8 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 		return ret;
 #ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
 	if (!mt6797_hif_normal_idle(mac->hif) &&
-	    !(mt6797_ccmp_deauth_abort_owed(mac) &&
-	      mt6797_hif_cleanup_abort_ready(mac->hif))) {
+	    !(mt6797_ccmp_cleanup_debt_ready(mac) &&
+	      mt6797_hif_cleanup_ready(mac->hif))) {
 #else
 	if (!mt6797_hif_normal_idle(mac->hif)) {
 #endif
@@ -1778,8 +1804,8 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 	}
 #ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
 	if (ccmp_stable_epoch && mac->ccmp_pm_abort_pending) {
-		/* All owed pages/pending credit were excluded above, including this
-		 * abort. A credit proves buffer consumption, never key-slot reuse.
+		/* The abort returned to its latched debt floor. A retained page is
+		 * still charged; this credit never proves key-slot reuse.
 		 */
 		mac->ccmp_pm_abort_pending = false;
 		mac->ccmp_pm_abort_credited = true;
@@ -1788,12 +1814,16 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 			 "one-shot WLAN PM abort credit: returned=1\n");
 	}
 	if (ccmp_stable_epoch && mac->ccmp_pm_connected) {
-		unsigned int deauth_debt = mt6797_ccmp_deauth_abort_owed(mac) ? 1 : 0;
+		unsigned int deauth_debt = mt6797_ccmp_cleanup_debt_ready(mac) ? 1 : 0;
 
 		if (mac->sequence > 253)
 			return -ENOSPC;
 		mac->join_credit_deadline = deadline;
 		reinit_completion(&mac->join_credit_done);
+		mac->ccmp_cleanup_credit_floor = mac->join_page_debt;
+		mac->ccmp_cleanup_credit_active = true;
+		mac->ccmp_cleanup_op = 1;
+		mac->ccmp_cleanup_sequence = mac->sequence;
 		mac->join_credit_pending = true;
 		mac->join_page_debt = deauth_debt + 1;
 		if (deauth_debt)
@@ -1809,6 +1839,13 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 	}
 #endif
 	if (mac->join_cleanup_stage == 3) {
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+		if (ccmp_stable_epoch && mac->join_page_debt) {
+			mac->ccmp_cleanup_bounded_done = true;
+			mac->join_cleanup_stage = 4;
+			mac->join_closed = true;
+		}
+#endif
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
 		mt6797_ccmp_observe_terminal(mac);
 #endif
@@ -1848,9 +1885,21 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 			dev_info(wiphy_dev(mac->hw->wiphy),
 				 "one-shot WLAN join data LLC mismatches discarded: total=%u\n",
 				 mac->join_data_llc_discarded);
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+		if (mac->ccmp_cleanup_bounded_done) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN cleanup complete: bounded_page_debt=%u healthy_stage3=0 no_reuse=1\n",
+				 mac->join_page_debt);
+		} else {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join cleanup: stage=3 credits=returned slots=retired deauth=%u\n",
+				 mac->join_deauth_done);
+		}
+#else
 		dev_info(wiphy_dev(mac->hw->wiphy),
 			 "one-shot WLAN join cleanup: stage=3 credits=returned slots=retired deauth=%u\n",
 			 mac->join_deauth_done);
+#endif
 #ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
 		mt6797_native_diag_rx_report(mac);
 #endif
@@ -1868,10 +1917,32 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 	}
 	if (mac->join_cleanup_stage > 3 || mac->sequence > 253)
 		return -ENOSPC;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	/* A released privilege submits no command and consumes no new page. */
+	if (ccmp_stable_epoch && mac->join_cleanup_stage == 1 &&
+	    mac->join_channel_released && mac->join_key_pairwise != 1 &&
+	    mac->join_key_group != 1) {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join cleanup submission: stage=1 released=1\n");
+		mac->join_cleanup_stage++;
+		return 0;
+	}
+	if (ccmp_stable_epoch) {
+		mac->ccmp_cleanup_credit_floor = mac->join_page_debt;
+		mac->ccmp_cleanup_credit_active = true;
+		mac->ccmp_cleanup_op = mac->join_key_pairwise == 1 ? 2 :
+			mac->join_key_group == 1 ? 3 : 4 + mac->join_cleanup_stage;
+		mac->ccmp_cleanup_sequence = mac->sequence;
+	}
+#endif
 	mac->join_credit_deadline = deadline;
 	reinit_completion(&mac->join_credit_done);
 	mac->join_credit_pending = true;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	mac->join_page_debt += 1;
+#else
 	mac->join_page_debt = 1;
+#endif
 	/* Explicit key retirement on the healthy path only, after the
 	 * deauthentication has completed (the guards above) and before stage 0:
 	 * the pinned source does not show that removing the station record
@@ -4467,9 +4538,21 @@ static int mt6797_ccmp_disable_key(struct mt6797_mac *mac)
 		if (mac->join_running && !mac->join_retired)
 			mt6797_mac_join_fail_stop(mac, ret, 8, &discard, &internal);
 	}
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	if (mac->ccmp_cleanup_bounded_done) {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN ccmp-stable disable bounded: local=1 command_path_credit=%u status=%d resource_debt=%u no_reuse=1\n",
+			 retired, ret, mac->join_page_debt);
+	} else {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN ccmp-stable disable: local=1 removal_command_credit=%u status=%d no_reuse=1\n",
+			 retired, ret);
+	}
+#else
 	dev_info(wiphy_dev(mac->hw->wiphy),
 		 "one-shot WLAN ccmp-stable disable: local=1 removal_command_credit=%u status=%d no_reuse=1\n",
 		 retired, ret);
+#endif
 	mutex_unlock(&mac->mutex);
 	/* The terminal worker's last TX-status batch also precedes keyconf free. */
 	cancel_delayed_work_sync(&mac->join_work);
diff --git a/drivers/net/wireless/mediatek/mt6797/normal_command.h b/drivers/net/wireless/mediatek/mt6797/normal_command.h
index fcb2b46..afa17e4 100644
--- a/drivers/net/wireless/mediatek/mt6797/normal_command.h
+++ b/drivers/net/wireless/mediatek/mt6797/normal_command.h
@@ -37,6 +37,9 @@ struct mt6797_normal_transaction {
 	enum mt6797_normal_phase phase, config_return_phase;
 	unsigned int tc4_limit, tc4_free, expected_sequence;
 	unsigned int tc4_pending_cpu, tc4_pending_ffa;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	unsigned int cleanup_retained_pages;
+#endif
 	/* Phase C3 data pool on TC1 (the pinned AC1 queue, HIF TX index 1): a
 	 * declared host budget, one frame in flight, released by the AC1 count
 	 * matched against the shared free-for-all pool like TC4's CPU count.
@@ -89,6 +92,9 @@ mt6797_normal_admit(struct mt6797_normal_transaction *t, unsigned int limit,
 	t->tc4_free = available;
 	t->tc4_pending_cpu = 0;
 	t->tc4_pending_ffa = 0;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	t->cleanup_retained_pages = 0;
+#endif
 	t->used_sequences = history;
 	t->phase = MT6797_NORMAL_IDLE;
 	return 0;
@@ -187,6 +193,26 @@ mt6797_normal_reconcile(struct mt6797_normal_transaction *t,
 	return 0;
 }
 
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+/* A quarantine budget, never a credit or quota change. Only cleanup callers
+ * may submit at this floor; the actual owed page stays in the ledger.
+ */
+static inline bool
+mt6797_normal_cleanup_ready(const struct mt6797_normal_transaction *t)
+{
+	unsigned int debt;
+
+	if (!t || t->cleanup_retained_pages != 1 ||
+	    t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    t->tc4_limit <= 1 || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit)
+		return false;
+	debt = t->tc4_limit - t->tc4_free;
+	return debt <= 1 && t->tc4_pending_cpu <= debt && t->tc4_pending_ffa <= debt &&
+		!(t->tc4_pending_cpu && t->tc4_pending_ffa) &&
+		t->tc1_free == t->tc1_limit && !t->tc1_pending;
+}
+#endif
+
 /* Shared normal-TC4 framing and debit. Callers validate phase and payload
  * contract first. A transport failure never refunds this debit.
  */
@@ -436,6 +462,15 @@ mt6797_normal_prepare_config(struct mt6797_normal_transaction *t,
 	}
 	if (payload_bytes != required)
 		return -EINVAL;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	if (t->cleanup_retained_pages) {
+		if (kind != MT6797_NORMAL_BSS_ACTIVE || payload[0] || payload[1] ||
+		    payload[2] || payload[3] != 1 || payload[10] || payload[11])
+			return -EOPNOTSUPP;
+		if (!mt6797_normal_cleanup_ready(t))
+			return -EBUSY;
+	}
+#endif
 	tx_phase = kind == MT6797_NORMAL_NVRAM_SETTINGS ?
 		MT6797_NORMAL_NVRAM_TX : MT6797_NORMAL_CONFIG_TX;
 	error = mt6797_normal_encode(t, kind, 1, sequence, payload,
-- 
