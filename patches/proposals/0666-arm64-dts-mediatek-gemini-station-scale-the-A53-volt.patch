+
+/* The legacy direct-address driver with writable voltages, in place of dlg,da9214. */
+&da9214 {
+	compatible = "dlg,da9214-legacy";
+	reg = <0x68>, <0x69>;
+	reg-names = "primary", "page2";
+
+	regulators {
+		vproc1: BUCKA {
+			regulator-name = "vproc1";
+			regulator-min-microvolt = <770000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-coupled-with = <&vsram_l>;
+			regulator-coupled-max-spread = <430000>;
+		};
+
+		/* For the A72 pair; nothing here consumes it yet. */
+		vproc2: BUCKB {
+			regulator-name = "vproc-big";
+			regulator-min-microvolt = <800000>;
+			regulator-max-microvolt = <1200000>;
+		};
+	};
+};
+
+/*
+ * capacity-dmips-mhz: the A53 against the A72's 1024, as on MT8173. The
+ * energy model's dynamic-power-coefficient is still to be measured
+ * (experiments/2026-11-08-mt6797-a53-dvfs); without it cpufreq-dt registers no
+ * energy model.
+ */
+
+&cpu0 {
+	operating-points-v2 = <&ll_dvfs_opp>;
+	cpu-supply = <&vproc1>;
+	capacity-dmips-mhz = <740>;
+};
