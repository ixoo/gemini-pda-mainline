+		mediatek,infracfg = <&infrasys>;
+		regulator-name = "vsram_l";
+		regulator-min-microvolt = <1000000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-coupled-with = <&vproc1>;
+		/* The coupler sets the spread itself; the core needs a value. */
+		regulator-coupled-max-spread = <430000>;
+	};
+
+	/* The CCI follows the faster of the two clusters, as the vendor's does. */
