From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 1 Nov 2026 07:09:26 -0500
Subject: [PATCH] wifi: mt6797: survive a lost handshake frame

On station 27 the eighth reconnect lost a 4-way handshake frame. The
access point retransmitted, but the driver delivers at most two EAPOL
frames per lifetime, so its message 3 was refused and the handshake
failed. The lifetime then ended without keys, and the re-arm, which
waits for exactly two key removals, stayed deferred: every later scan
was refused until a module reload.

Allow up to four EAPOL frames each way until the pairwise key is
submitted, so one retransmission of each handshake message gets
through; after that the cap stays at two, so frames after the handshake
are refused as before. Let a lifetime that never submitted a key re-arm
without waiting for key removals; its other quiescence checks are
unchanged.

Part of the Wi-Fi daily-use plan, phase 2.
---
 drivers/net/wireless/mediatek/mt6797/join.c   | 29 ++++++++++++++-----
 .../net/wireless/mediatek/mt6797/mac-priv.h   |  9 +++++-
 drivers/net/wireless/mediatek/mt6797/main.c   |  6 ++--
 3 files changed, 33 insertions(+), 11 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/join.c b/drivers/net/wireless/mediatek/mt6797/join.c
index acfed6185..03283765c 100644
--- a/drivers/net/wireless/mediatek/mt6797/join.c
+++ b/drivers/net/wireless/mediatek/mt6797/join.c
@@ -12,9 +12,15 @@ mt6797_join_rearm_ready(const struct mt6797_join_rearm_state *s)
 {
 	if (!s->cleanup_done || !s->sta_removed || s->poisoned)
 		return MT6797_JOIN_REARM_NO;
-	if (s->key_pairwise != 2 || s->key_group != 2 ||
-	    !s->key_done || !s->key_done_second ||
-	    s->inflight || s->page_debt || s->data_page_debt || s->credit_pending ||
+	/* Both keys installed and removed, or a lifetime that never submitted
+	 * one, as when its 4-way handshake failed.
+	 */
+	if (!(s->key_pairwise == 2 && s->key_group == 2 &&
+	      s->key_done && s->key_done_second) &&
+	    !(!s->key_pairwise && !s->key_group && !s->key_done &&
+	      !s->key_done_second && !s->key_submitted))
+		return MT6797_JOIN_REARM_NO;
+	if (s->inflight || s->page_debt || s->data_page_debt || s->credit_pending ||
 	    !s->queue_empty)
 		return MT6797_JOIN_REARM_NO;
 	/* The data PID is cyclic and the pool restarts with the epoch, so it
@@ -1876,6 +1882,8 @@ void mt6797_mac_join_work(struct work_struct *work)
 			.poisoned = mac->first_error || mac->closing,
 			.key_done = mac->join_key_done,
 			.key_done_second = mac->join_key_done_second,
+			.key_submitted = mac->join_key_pairwise_submitted ||
+					 mac->join_key_group_submitted,
 			.inflight = !!(mac->join_inflight || mac->data_slots.count),
 			.credit_pending = mac->join_credit_pending,
 			.queue_empty = queue_empty,
@@ -1894,7 +1902,9 @@ void mt6797_mac_join_work(struct work_struct *work)
 		 * reset the epoch under that key on the fourth lifecycle boot, and
 		 * the late removal then closed the new lifetime's receive path.
 		 */
-		if (!mac->join_closed && mac->ccmp_key_disables < 2) {
+		if (!mac->join_closed && (mac->join_key_pairwise_submitted ||
+					  mac->join_key_group_submitted) &&
+		    mac->ccmp_key_disables < 2) {
 			dev_info(wiphy_dev(mac->hw->wiphy),
 				 "one-shot WLAN join rearm deferred: key_removals=%u\n",
 				 mac->ccmp_key_disables);
@@ -2549,12 +2559,12 @@ void mt6797_mac_join_work(struct work_struct *work)
 			/* Phase C2: a clear EAPOL-Key frame from the target to this
 			 * station on the join channel (0140 decoder) is delivered to
 			 * mac80211 as a native data frame (the rebuilt header for the
-			 * translated layout), at most twice, only after a status-0
+			 * translated layout), within MT6797_JOIN_EAPOL_*FRAMES, only after a status-0
 			 * association response and before the deauthentication completes;
 			 * whether the station was already activated is recorded. mac80211
 			 * admits control-port data from a known station before its
 			 * association flag and routes it to the connection owner. Any
-			 * other shape, or a third frame, reaches the refusal below.
+			 * other shape, or a frame past the bound, reaches the refusal below.
 			 */
 			eapol_gate = mt6797_eapol_rx_gate(mac->join_packet, rx.logical_bytes,
 							  40, mac->hw->wiphy->perm_addr,
@@ -2562,7 +2572,9 @@ void mt6797_mac_join_work(struct work_struct *work)
 			if (eapol_gate == MT6797_EAPOL_OK &&
 			    mac->join_assoc_received && !mac->join_assoc_status &&
 			    !mac->join_deauth_done && !mac->join_cleanup_done &&
-			    mac->join_eapol_seen < 2 &&
+			    (mac->join_eapol_seen < MT6797_JOIN_EAPOL_FRAMES ||
+			     (mac->join_eapol_seen < MT6797_JOIN_EAPOL_HANDSHAKE_FRAMES &&
+			      !mac->join_key_pairwise_submitted)) &&
 			    /* BSSID tag 15, observed before the station activation
 			     * (runtimes 12 and 15, message 1), is admitted only until the
 			     * successful BSS command credit completion is recorded; tag 1
@@ -2606,7 +2618,8 @@ void mt6797_mac_join_work(struct work_struct *work)
 				!mac->join_assoc_received || mac->join_assoc_status ? "association" :
 				mac->join_deauth_done ? "deauth-ended" :
 				mac->join_cleanup_done ? "cleanup-done" :
-				mac->join_eapol_seen >= 2 ? "delivery-cap" : "bss-interval",
+				mac->join_eapol_seen >= MT6797_JOIN_EAPOL_FRAMES ?
+				"delivery-cap" : "bss-interval",
 				eapol_gate, eapol_gate == MT6797_EAPOL_OK ? eapol.bytes : 0);
 
 			/* Phase C3: during the data phase, after both key credits and
diff --git a/drivers/net/wireless/mediatek/mt6797/mac-priv.h b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
index 5f21ddb69..48543b13b 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac-priv.h
+++ b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
@@ -138,7 +138,7 @@ enum mt6797_join_rearm_decision {
 
 struct mt6797_join_rearm_state {
 	bool cleanup_done, sta_removed, poisoned;
-	bool key_done, key_done_second;
+	bool key_done, key_done_second, key_submitted;
 	bool inflight, credit_pending, queue_empty;
 	unsigned int key_pairwise, key_group;
 	unsigned int page_debt, data_page_debt;
@@ -147,6 +147,13 @@ struct mt6797_join_rearm_state {
 
 #define MT6797_JOIN_PUMP_MAX_ZERO 32U
 
+/* EAPOL frames each way per lifetime: the 4-way handshake's two, and up to
+ * two more until the pairwise key is submitted, for the access point's
+ * retransmission of a message whose reply was lost.
+ */
+#define MT6797_JOIN_EAPOL_FRAMES 2U
+#define MT6797_JOIN_EAPOL_HANDSHAKE_FRAMES 4U
+
 #define MT6797_JOIN_PUMP_IDLE_MS 20U
 
 #define MT6797_JOIN_PUMP_PENDING_MS 1U
diff --git a/drivers/net/wireless/mediatek/mt6797/main.c b/drivers/net/wireless/mediatek/mt6797/main.c
index 5c8c0322e..015a1f352 100644
--- a/drivers/net/wireless/mediatek/mt6797/main.c
+++ b/drivers/net/wireless/mediatek/mt6797/main.c
@@ -1613,7 +1613,7 @@ static void mt6797_mac_tx(struct ieee80211_hw *hw,
 
 	/* Phase C2: the supplicant's control-port EAPOL frames, built by
 	 * mac80211 as non-QoS To-DS data frames with the LLC/SNAP EAPOL type to
-	 * the target, at most two per lifetime, only after an accepted
+	 * the target, within MT6797_JOIN_EAPOL_*FRAMES, only after an accepted
 	 * association and before the deauthentication. They are submitted
 	 * after the station activation as Ethernet II security frames.
 	 */
@@ -1634,7 +1634,9 @@ static void mt6797_mac_tx(struct ieee80211_hw *hw,
 		spin_lock_irqsave(&mac->join_queue.lock, flags);
 		if (mac->join_open && mac->join_assoc_received &&
 		    !mac->join_assoc_status && !mac->join_deauth_done &&
-		    mac->join_eapol_tx < 2 &&
+		    (mac->join_eapol_tx < MT6797_JOIN_EAPOL_FRAMES ||
+		     (mac->join_eapol_tx < MT6797_JOIN_EAPOL_HANDSHAKE_FRAMES &&
+		      !mac->join_key_pairwise_submitted)) &&
 		    skb_queue_len(&mac->join_queue) < 3 &&
 		    mac->join_queue_bytes + skb->len <= 3 * 2304) {
 			mac->join_eapol_tx++;
-- 
2.43.0

