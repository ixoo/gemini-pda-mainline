From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 31 Oct 2026 13:25:59 -0400
Subject: [PATCH] dt-bindings: thermal: mediatek: add the hardware reset
 properties

Describe the TOPRGU phandle and the temperature at which the controller
arms its hardware thermal reset.
---
 .../bindings/thermal/mediatek,thermal.yaml         | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/Documentation/devicetree/bindings/thermal/mediatek,thermal.yaml b/Documentation/devicetree/bindings/thermal/mediatek,thermal.yaml
index 96d37c522..18a02514a 100644
--- a/Documentation/devicetree/bindings/thermal/mediatek,thermal.yaml
+++ b/Documentation/devicetree/bindings/thermal/mediatek,thermal.yaml
@@ -67,6 +67,20 @@ properties:
   resets:
     description: Reset controller controlling the thermal controller
 
+  mediatek,toprgu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The TOPRGU watchdog block that turns the controller's hot request into
+      a chip reset. Used with mediatek,hw-reset-millicelsius.
+
+  mediatek,hw-reset-millicelsius:
+    description:
+      Temperature at which each bank raises its hot request, which TOPRGU
+      turns into a chip reset with no software running. Without it, no
+      hardware reset is armed.
+    minimum: 90000
+    maximum: 125000
+
   nvmem-cells:
     items:
       - description:
-- 
2.43.0

