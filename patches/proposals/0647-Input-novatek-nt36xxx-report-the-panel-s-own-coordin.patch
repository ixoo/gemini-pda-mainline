From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 8 Nov 2026 07:19:24 -0500
Subject: [PATCH 647/648] Input: novatek-nt36xxx: report the panel's own
 coordinates

The driver turned every contact to the vendor's landscape layout itself,
reporting the raw y as X and the reversed raw x as Y. A compositor that
maps touch to the panel's output and applies the output's rotation then
turned it a second time, so touch only lined up with a calibration matrix.

Report the controller's coordinates on the panel's own axes, with the
ranges from its firmware information, and let the board describe any
inversion or swap with the standard touchscreen properties.
touchscreen_report_pos() applies them.

Not yet run on hardware.
---
 drivers/input/touchscreen/novatek-nt36xxx.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/drivers/input/touchscreen/novatek-nt36xxx.c b/drivers/input/touchscreen/novatek-nt36xxx.c
index 46c8240..de44941 100644
--- a/drivers/input/touchscreen/novatek-nt36xxx.c
+++ b/drivers/input/touchscreen/novatek-nt36xxx.c
@@ -13,6 +13,7 @@
 #include <linux/i2c.h>
 #include <linux/input.h>
 #include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
 #include <linux/interrupt.h>
 #include <linux/module.h>
 #include <linux/regulator/consumer.h>
@@ -41,6 +42,7 @@
 struct nvt36xxx_data {
 	struct i2c_client *client;
 	struct input_dev *input;
+	struct touchscreen_properties prop;
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data supplies[2];
 	u8 event[NVT36XXX_EVENT_DATA_LEN];
@@ -273,12 +275,9 @@ static irqreturn_t nvt36xxx_irq(int irq, void *arg)
 			pressure = touch[5];
 		pressure = clamp_val(pressure, 1U, NVT36XXX_MAX_PRESSURE);
 
-		/* Match the board's vendor orientation: swap X/Y, then reverse Y. */
 		input_mt_slot(data->input, slot - 1);
 		input_mt_report_slot_state(data->input, MT_TOOL_FINGER, true);
-		input_report_abs(data->input, ABS_MT_POSITION_X, y);
-		input_report_abs(data->input, ABS_MT_POSITION_Y,
-				   data->raw_x_max - 1 - x);
+		touchscreen_report_pos(data->input, &data->prop, x, y, true);
 		input_report_abs(data->input, ABS_MT_TOUCH_MAJOR, width);
 		input_report_abs(data->input, ABS_MT_PRESSURE, pressure);
 		active++;
@@ -360,13 +359,14 @@ static int nvt36xxx_probe(struct i2c_client *client)
 	input->name = "Novatek NT36772 touchscreen";
 	input->id.bustype = BUS_I2C;
 	input_set_abs_params(input, ABS_MT_POSITION_X, 0,
-				      data->raw_y_max - 1, 0, 0);
-	input_set_abs_params(input, ABS_MT_POSITION_Y, 0,
 				      data->raw_x_max - 1, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, 0,
+				      data->raw_y_max - 1, 0, 0);
 	input_set_abs_params(input, ABS_MT_TOUCH_MAJOR, 0,
 				      NVT36XXX_MAX_WIDTH, 0, 0);
 	input_set_abs_params(input, ABS_MT_PRESSURE, 0,
 				      NVT36XXX_MAX_PRESSURE, 0, 0);
+	touchscreen_parse_properties(input, true, &data->prop);
 	ret = input_mt_init_slots(input, NVT36XXX_MAX_TOUCHES,
 					   INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
 	if (ret)
