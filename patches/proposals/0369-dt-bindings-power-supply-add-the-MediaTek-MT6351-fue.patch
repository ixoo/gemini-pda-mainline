From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 31 Oct 2026 15:18:47 -0400
Subject: [PATCH] dt-bindings: power: supply: add the MediaTek MT6351 fuel
 gauge

Describe the MT6351 PMIC fuel gauge: its battery voltage channel, the
monitored battery, the sense resistor, the gain correction and the
thermal zone that gives the battery temperature.
---
 .../supply/mediatek,mt6351-fuel-gauge.yaml    | 51 +++++++++++++++++++
 1 file changed, 51 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/mediatek,mt6351-fuel-gauge.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/mediatek,mt6351-fuel-gauge.yaml b/Documentation/devicetree/bindings/power/supply/mediatek,mt6351-fuel-gauge.yaml
new file mode 100644
index 000000000..ed733abcd
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/mediatek,mt6351-fuel-gauge.yaml
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6351-fuel-gauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6351 PMIC fuel gauge
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description:
+  The MT6351 FGADC coulomb counter and current sense, with the pack voltage
+  from the PMIC AUXADC and the battery temperature from a thermal zone. The
+  state of charge comes from the monitored battery's OCV tables.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6351-fuel-gauge
+
+  io-channels:
+    maxItems: 1
+
+  io-channel-names:
+    const: vbat
+
+  monitored-battery: true
+
+  mediatek,sense-resistor-milliohm:
+    description: The battery current sense resistor.
+
+  mediatek,car-tune:
+    description: The current and charge gain correction, in percent.
+    default: 100
+
+  mediatek,battery-thermal-zone:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: The thermal zone that measures the battery temperature.
+
+required:
+  - compatible
+  - io-channels
+  - io-channel-names
+  - monitored-battery
+  - mediatek,sense-resistor-milliohm
+  - mediatek,battery-thermal-zone
+
+unevaluatedProperties: false
-- 
2.43.0

