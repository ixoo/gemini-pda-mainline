+#define MT6797_WMT_INIT_BUDGET_MS 30000U
+#define MT6797_WMT_INIT_EXCHANGE_MS 500U
+#define MT6797_WMT_INIT_CALIBRATION_MS 2000U
+
+/* Retained Gemian pair, in download order; contents stay outside the kernel. */
+static const struct {
+	const char *name;
+	u8 sha256[SHA256_DIGEST_SIZE];
+} mt6797_rom_patches[2] = {
+	{ "mediatek/mt6797/ROMv3_patch_1_1_hdr.bin", {
+		0x57, 0x32, 0xc0, 0x73, 0x03, 0x80, 0xe9, 0x37, 0xb4, 0x8a, 0xd1, 0x69,
+		0xf2, 0x80, 0x5b, 0x65, 0xe8, 0xd4, 0xa1, 0x78, 0x26, 0x55, 0x66, 0xc5,
+		0x08, 0x3c, 0xb2, 0xcc, 0x2d, 0x24, 0x9f, 0x1e } },
+	{ "mediatek/mt6797/ROMv3_patch_1_0_hdr.bin", {
+		0x45, 0x0c, 0x2b, 0x09, 0x49, 0xcf, 0x87, 0x92, 0x17, 0xac, 0x9a, 0xef,
+		0x81, 0xb1, 0x8b, 0x86, 0x09, 0x82, 0xf0, 0xe6, 0x93, 0x40, 0x78, 0x4b,
+		0x44, 0x8c, 0xf6, 0x30, 0x80, 0xb4, 0x3c, 0xf6 } },
+};
+
+static int mt6797_consys_init_rail(struct regulator *rail, bool on, bool *state)
+{
+	int ret;
+
+	if (*state == on)
+		return -EPROTO;
+	if (!on) {
+		ret = regulator_disable(rail);
+		if (!ret)
+			*state = false;
+		return ret;
+	}
+	ret = regulator_is_enabled(rail);
+	if (ret)
+		return ret < 0 ? ret : -EBUSY;
+	ret = regulator_set_voltage(rail, 3300000, 3300000);
+	if (!ret)
+		ret = regulator_enable(rail);
+	if (ret)
+		return ret;
+	*state = true;
+	ret = regulator_is_enabled(rail);
+	return ret == 1 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+/*
+ * Fixed common initialization on the negotiated link. The first failure
+ * stops the sequence; power, clocks and rails stay as they are for reviewed
+ * recovery. WLAN START and scan are not part of this sequence.
+ */
+static int mt6797_consys_common_init(struct device *dev, struct mt6797_consys *owner)
+{
+	struct mt6797_wmt_negotiate *n = &owner->wmt_negotiate;
+	typeof(owner->common_init) *ci = &owner->common_init;
+	const struct firmware *fw[2] = {};
+	struct wmt_rom_patch pair[2];
+	u8 digest[SHA256_DIGEST_SIZE];
+	unsigned long budget;
+	unsigned int i, timeout;
+	int ret;
+
+	for (i = 0; i < 2; i++) {
+		ret = request_firmware(&fw[i], mt6797_rom_patches[i].name, dev);
+		if (ret)
+			goto out;
+		sha256(fw[i]->data, fw[i]->size, digest);
+		if (memcmp(digest, mt6797_rom_patches[i].sha256, sizeof(digest)) ||
+		    wmt_rom_patch_parse(fw[i]->data, fw[i]->size, i + 1, &pair[i])) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	budget = jiffies + msecs_to_jiffies(MT6797_WMT_INIT_BUDGET_MS);
+	for (i = 0; i < WMT_INIT_STEPS; i++) {
+		if (time_after_eq(jiffies, budget)) {
+			ret = -ETIMEDOUT;
+			goto out;
+		}
+		ret = mt6797_wmt_init_step(pair, ci->antenna_mode, i, ci->command,
+					   sizeof(ci->command), &ci->step) ? -EINVAL : 0;
+		if (ret)
+			goto out;
+		switch (ci->step.kind) {
+		case WMT_INIT_BT_RAIL_ON:
+		case WMT_INIT_BT_RAIL_OFF:
+			ret = mt6797_consys_init_rail(owner->vcn33_bt,
+						      ci->step.kind == WMT_INIT_BT_RAIL_ON,
+						      &ci->bt_rail);
+			break;
+		case WMT_INIT_WIFI_RAIL_ON:
+		case WMT_INIT_WIFI_RAIL_OFF:
+			ret = mt6797_consys_init_rail(owner->vcn33_wifi,
+						      ci->step.kind == WMT_INIT_WIFI_RAIL_ON,
+						      &ci->wifi_rail);
+			break;
+		default:
+			timeout = i == WMT_INIT_CALIBRATION ?
+				  MT6797_WMT_INIT_CALIBRATION_MS :
+				  MT6797_WMT_INIT_EXCHANGE_MS;
+			ret = mt6797_stp_task_prepare(&ci->io, n->first.btif, n->first.irq,
+						      &n->link, STP_FULL_TASK_WMT,
+						      ci->command, ci->step.length,
+						      ci->step.expected, ci->step.prefix,
+						      ci->step.expected_length,
+						      jiffies + msecs_to_jiffies(timeout));
+			if (!ret)
+				ret = mt6797_wmt_full_exchange(&ci->io);
+			if (!ret && i == WMT_INIT_CALIBRATION) {
+				ci->calibration_bytes = min_t(unsigned int, ci->io.rx_count,
+							      sizeof(ci->calibration));
+				memcpy(ci->calibration, ci->io.received,
+				       ci->calibration_bytes);
+			}
+		}
+		if (ret)
+			goto out;
+		ci->completed = i + 1;
+	}
+out:
+	ci->result = ret;
+	for (i = 0; i < 2; i++)
+		release_firmware(fw[i]);
+	dev_info(dev,
+		 "one-shot WMT common init: result=%d completed=%u/%u bt-rail=%d wifi-rail=%d link=%u/%u/%u/%u\n",
+		 ret, ci->completed, WMT_INIT_STEPS, ci->bt_rail, ci->wifi_rail,
+		 n->link.transport.tx_next, n->link.transport.rx_next,
+		 n->link.transport.peer_ack, n->link.transport.local_ack);
+	print_hex_dump(KERN_INFO, "WMT common init calibration RX: ", DUMP_PREFIX_OFFSET,
+		       16, 1, ci->calibration, ci->calibration_bytes, false);
+	if (ret && ci->completed < WMT_INIT_STEPS && ci->io.prepared) {
+		dev_info(dev, "WMT common init failed step %u: tx=%u rx=%u services=%u frames=%u\n",
+			 ci->completed, ci->io.tx_count, ci->io.rx_count,
+			 ci->io.services, ci->io.frames);
+		print_hex_dump(KERN_INFO, "WMT common init failed RX: ", DUMP_PREFIX_OFFSET,
+			       16, 1, ci->io.received, ci->io.rx_count, false);
+	}
+	return ret;
+}
