 		vcn33_bt = devm_regulator_get(&pdev->dev, "vcn33-bt");
 		if (IS_ERR(vcn33_bt)) {
 			ret = dev_err_probe(&pdev->dev, PTR_ERR(vcn33_bt),
@@ -1718,6 +1883,11 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 		}
 	}
 	afe_resource = platform_get_resource(pdev, IORESOURCE_MEM, 9);
+	/* Common init owns the AFE stage unconditionally. */
+	if (common_init && !afe_resource) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
 	if (afe_resource) {
 		if (!wmt_query || !afe_resource->name ||
 		    strcmp(afe_resource->name, "afe") ||
@@ -1803,6 +1973,8 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	mt6797_consys.vcn33_wifi = vcn33_wifi;
 	mt6797_consys.vcn33_bt = vcn33_bt;
 	mt6797_consys.bt_h1_after_negotiate = bt_h1;
+	mt6797_consys.common_init.enabled = common_init;
+	mt6797_consys.common_init.antenna_mode = antenna_mode;
 	mt6797_consys.conmcu_reset = conmcu_reset;
 	mt6797_consys.conn_domain = conn_domain;
 	mt6797_consys.bound = true;
diff --git a/drivers/soc/mediatek/mt6797-wmt-common-init.h b/drivers/soc/mediatek/mt6797-wmt-common-init.h
new file mode 100644
index 000000000..865f2fb6d
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-wmt-common-init.h
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_WMT_COMMON_INIT_H
+#define MT6797_WMT_COMMON_INIT_H
+
+#include "wmt-full-stp.h"
+#include "wmt-rom-patch.h"
+
+/*
+ * Fixed MT6797 (chip 0x0279) WMT common initialization after full-mode
+ * negotiation, in the selected vendor order: DLM power, MCU clock raise,
+ * both ROM patches each followed by a WMT reset, MCU clock restore, LTE
+ * coexistence, PA rails on, RF calibration, PA rails off, antenna mode.
+ * Crystal trim, co-clock, merged PCM and FM strap are not selected.
+ */
+enum wmt_init_kind {
+	WMT_INIT_EXCHANGE,
+	WMT_INIT_BT_RAIL_ON,
+	WMT_INIT_WIFI_RAIL_ON,
+	WMT_INIT_BT_RAIL_OFF,
+	WMT_INIT_WIFI_RAIL_OFF,
+};
+
+#define WMT_INIT_PRE 7U
+#define WMT_INIT_PATCH 264U
+#define WMT_INIT_POST 8U
+#define WMT_INIT_STEPS (WMT_INIT_PRE + WMT_INIT_PATCH + WMT_INIT_POST + 6U)
+#define WMT_INIT_CALIBRATION (WMT_INIT_PRE + WMT_INIT_PATCH + WMT_INIT_POST + 2U)
+
+struct wmt_init_step {
+	enum wmt_init_kind kind;
+	unsigned int length, prefix, expected_length;
+	unsigned char expected[8];
+};
+
+static const unsigned char wmt_init_reg_event[] = {
+	0x02, 0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x01,
+};
+
+static const unsigned char wmt_init_coex_event[] = { 0x02, 0x10, 0x01, 0x00, 0x00 };
+
+/* Masked firmware register writes: header, address, value, mask. */
+static const unsigned char wmt_init_reg[WMT_INIT_PRE + 3][12] = {
+	/* DLM power: 0x80100060 clear 0xf00, 0xf0, then 0x8. */
+	{ 0x60, 0x00, 0x10, 0x80, 0, 0, 0, 0, 0x00, 0x0f, 0x00, 0x00 },
+	{ 0x60, 0x00, 0x10, 0x80, 0, 0, 0, 0, 0xf0, 0x00, 0x00, 0x00 },
+	{ 0x60, 0x00, 0x10, 0x80, 0, 0, 0, 0, 0x08, 0x00, 0x00, 0x00 },
+	/* MCU clock raise: enable, ratio, divider, HCLK. */
+	{ 0x10, 0x11, 0x02, 0x81, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x10 },
+	{ 0x0c, 0x01, 0x00, 0x80, 0x40, 0x00, 0x00, 0x00, 0xc0, 0x00, 0x00, 0x00 },
+	{ 0x18, 0x11, 0x02, 0x80, 0x07, 0x00, 0x00, 0x00, 0x3f, 0x00, 0x00, 0x00 },
+	{ 0x00, 0x11, 0x02, 0x81, 0x04, 0x00, 0x00, 0x00, 0x07, 0x00, 0x00, 0x00 },
+	/* MCU clock restore: HCLK, ratio, enable. */
+	{ 0x00, 0x11, 0x02, 0x81, 0x00, 0x00, 0x00, 0x00, 0x07, 0x00, 0x00, 0x00 },
+	{ 0x0c, 0x01, 0x00, 0x80, 0x00, 0x00, 0x00, 0x00, 0xc0, 0x00, 0x00, 0x00 },
+	{ 0x10, 0x11, 0x02, 0x81, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10 },
+};
+
+/* Selected LTE coexistence table for chip 0x0279, external component zero. */
+static const unsigned char wmt_init_lte_ext[] = {
+	0x01, 0x10, 0x03, 0x00, 0x0d, 0x00, 0x00,
+};
+
+static const unsigned char wmt_init_lte_filter[] = {
+	0x01, 0x10, 0x45, 0x00, 0x11, 0x00, 0x00, 0x01,
+	0x00, 0x11, 0x11, 0x16, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x63, 0x63, 0x63, 0x00, 0x39, 0x43, 0x63,
+	0x63, 0x02, 0x02, 0x03, 0x00, 0x01, 0x01, 0x01,
+	0x01, 0x0e, 0x0e, 0x0e, 0x00, 0x0a, 0x0c, 0x0e,
+	0x0e, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+static const unsigned char wmt_init_lte_freq[] = {
+	0x01, 0x10, 0x21, 0x00, 0x12, 0xfc, 0x08, 0x15,
+	0x09, 0x2e, 0x09, 0x47, 0x09, 0xc4, 0x09, 0xd4,
+	0x09, 0xe3, 0x09, 0x5a, 0x0a, 0x14, 0x09, 0x2d,
+	0x09, 0x46, 0x09, 0x60, 0x09, 0xd3, 0x09, 0xe2,
+	0x09, 0x59, 0x0a, 0x8b, 0x0a,
+};
+
+static const unsigned char wmt_init_lte_unsafe[] = { 0x01, 0x10, 0x02, 0x00, 0x13, 0x00 };
+
+static const unsigned char wmt_init_lte_l[] = { 0x01, 0x10, 0x02, 0x00, 0x21, 0x01 };
+
+static const unsigned char wmt_init_calibration[] = { 0x01, 0x14, 0x01, 0x00, 0x01 };
+/* Vendor expects 02 14 02 00 00 01 but never compares content; capture both. */
+static const unsigned char wmt_init_calibration_prefix[] = { 0x02, 0x14, 0x02, 0x00 };
+
+static int wmt_init_copy(unsigned char *out, unsigned int capacity,
+			 const unsigned char *src, unsigned int length)
+{
+	unsigned int i;
+
+	if (capacity < length)
+		return -1;
+	for (i = 0; i < length; i++)
+		out[i] = src[i];
+	return length;
+}
+
+static void wmt_init_expect(struct wmt_init_step *step, const unsigned char *event,
+			    unsigned int prefix, unsigned int length)
+{
+	unsigned int i;
+
+	for (i = 0; i < prefix; i++)
+		step->expected[i] = event[i];
+	step->prefix = prefix;
+	step->expected_length = length;
+}
+
+/*
+ * Build step index into out/step. No effects; pair must be the two parsed,
+ * digest-checked ROM patches. Returns 0, or -1 with outputs unchanged.
+ */
+static inline int mt6797_wmt_init_step(const struct wmt_rom_patch pair[2],
+				       unsigned int antenna_mode, unsigned int index,
+				       unsigned char *out, unsigned int capacity,
+				       struct wmt_init_step *step)
+{
+	static const unsigned char *lte[] = {
+		wmt_init_lte_ext, wmt_init_lte_filter, wmt_init_lte_freq,
+		wmt_init_lte_unsafe, wmt_init_lte_l,
+	};
+	static const unsigned int lte_length[] = {
+		sizeof(wmt_init_lte_ext), sizeof(wmt_init_lte_filter),
+		sizeof(wmt_init_lte_freq), sizeof(wmt_init_lte_unsafe),
+		sizeof(wmt_init_lte_l),
+	};
+	struct wmt_init_step next = { .kind = WMT_INIT_EXCHANGE };
+	unsigned int i, base, reg, expected_length;
+	int bytes;
+
+	if (!pair || !out || !step || antenna_mode > 255 || index >= WMT_INIT_STEPS)
+		return -1;
+	if (index < WMT_INIT_PRE ||
+	    (index >= WMT_INIT_PRE + WMT_INIT_PATCH &&
+	     index < WMT_INIT_PRE + WMT_INIT_PATCH + 3)) {
+		reg = index < WMT_INIT_PRE ? index :
+			WMT_INIT_PRE + index - (WMT_INIT_PRE + WMT_INIT_PATCH);
+		if (capacity < 20)
+			return -1;
+		out[0] = 0x01;
+		out[1] = 0x08;
+		out[2] = 0x10;
+		out[3] = 0x00;
+		out[4] = 0x01;
+		out[5] = 0x01;
+		out[6] = 0x00;
+		out[7] = 0x01;
+		for (i = 0; i < 12; i++)
+			out[8 + i] = wmt_init_reg[reg][i];
+		bytes = 20;
+		wmt_init_expect(&next, wmt_init_reg_event, 8, 8);
+	} else if (index < WMT_INIT_PRE + WMT_INIT_PATCH) {
+		bytes = mt6797_wmt_rom_step(pair, index - WMT_INIT_PRE, out, capacity,
+					    next.expected, &expected_length);
+		if (bytes < 0)
+			return -1;
+		next.prefix = expected_length;
+		next.expected_length = expected_length;
+	} else {
+		base = index - (WMT_INIT_PRE + WMT_INIT_PATCH + 3);
+		if (base < 5) {
+			bytes = wmt_init_copy(out, capacity, lte[base], lte_length[base]);
+			wmt_init_expect(&next, wmt_init_coex_event, 5, 5);
+		} else if (base == 5 || base == 6 || base == 8 || base == 9) {
+			next.kind = base == 5 ? WMT_INIT_BT_RAIL_ON :
+				    base == 6 ? WMT_INIT_WIFI_RAIL_ON :
+				    base == 8 ? WMT_INIT_BT_RAIL_OFF :
+						WMT_INIT_WIFI_RAIL_OFF;
+			bytes = 0;
+		} else if (base == 7) {
+			bytes = wmt_init_copy(out, capacity, wmt_init_calibration,
+					      sizeof(wmt_init_calibration));
+			wmt_init_expect(&next, wmt_init_calibration_prefix, 4, 6);
+		} else {
+			if (capacity < 6)
+				return -1;
+			out[0] = 0x01;
+			out[1] = 0x10;
+			out[2] = 0x02;
+			out[3] = 0x00;
+			out[4] = 0x01;
+			out[5] = antenna_mode;
+			bytes = 6;
+			wmt_init_expect(&next, wmt_init_coex_event, 5, 5);
+		}
+		if (bytes < 0)
+			return -1;
+	}
+	next.length = bytes;
+	*step = next;
+	return 0;
+}
+
+#endif
diff --git a/drivers/soc/mediatek/wmt-rom-patch.h b/drivers/soc/mediatek/wmt-rom-patch.h
new file mode 100644
index 000000000..fedf071fe
--- /dev/null
+++ b/drivers/soc/mediatek/wmt-rom-patch.h
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef GEMINI_WMT_ROM_PATCH_H
+#define GEMINI_WMT_ROM_PATCH_H
+
+struct wmt_rom_patch {
+	const unsigned char *body;
+	unsigned int length, sequence;
+	unsigned char address[4];
+};
+
+/* Selected retained pair only. Caller verifies exact full-file digest and
+ * applicability separately; metadata alone is not firmware authentication.
+ * Result aliases immutable input. Refusal leaves output unchanged.
+ */
+static inline int wmt_rom_patch_parse(const unsigned char *file, unsigned int bytes,
+				      unsigned int sequence, struct wmt_rom_patch *result)
+{
+	static const unsigned int lengths[] = { 46444, 210876 };
+	static const unsigned char addresses[][4] = {
+		{ 0, 0, 0x0a, 0xf0 }, { 0, 0, 9, 0 }
+	};
+	unsigned int i;
+
+	if (!file || !result || sequence < 1 || sequence > 2 ||
+	    bytes != lengths[sequence - 1] + 28 || file[24] != (0x20 | sequence))
+		return -1;
+	for (i = 1; i < 4; i++)
+		if (file[24 + i] != addresses[sequence - 1][i])
+			return -1;
+	result->body = file + 28;
+	result->length = bytes - 28;
+	result->sequence = sequence;
+	for (i = 0; i < 4; i++)
+		result->address[i] = addresses[sequence - 1][i];
+	return 0;
+}
+
+/* Construct one WMT payload, not an STP frame or a transfer. Input/output must
+ * be disjoint. Index is zero-based; caller advances only after checked event.
+ */
+static inline int wmt_rom_patch_fragment(const struct wmt_rom_patch *patch,
+					 unsigned int index, unsigned char *out,
+					 unsigned int capacity)
+{
+	unsigned int count, offset, length, i;
+
+	if (!patch || !patch->body || !patch->length || patch->length > 210876 || !out)
+		return -1;
+	count = (patch->length + 999) / 1000;
+	if (index >= count)
+		return -1;
+	offset = index * 1000;
+	length = patch->length - offset;
+	if (length > 1000)
+		length = 1000;
+	if (capacity < length + 5)
+		return -1;
+	out[0] = 1;
+	out[1] = 1;
+	out[2] = (length + 1) & 255;
+	out[3] = (length + 1) >> 8;
+	out[4] = index == count - 1 ? 3 : index == 0 ? 1 : 2;
+	for (i = 0; i < length; i++)
+		out[5 + i] = patch->body[offset + i];
+	return length + 5;
+}
+
+/* MT6797 selected pair: two addresses, body fragments, ordinary WMT reset,
+ * then the second patch. Constructor only; ordinal advances after a complete
+ * checked transport exchange, never on construction or partial submission.
+ * Caller supplies disjoint immutable inputs and separate command/event output.
+ */
+static inline int mt6797_wmt_rom_step(const struct wmt_rom_patch pair[2],
+				      unsigned int ordinal, unsigned char *out,
+				      unsigned int capacity, unsigned char expected[8],
+				      unsigned int *expected_length)
+{
+	static const unsigned int lengths[2] = { 46444, 210876 };
+	static const unsigned char addresses[2][4] = {
+		{ 0, 0, 10, 240 }, { 0, 0, 9, 0 }
+	};
+	unsigned int i, j, sequence, step, count, bytes, event_bytes;
+
+	if (!pair || !out || !expected || !expected_length || ordinal >= 264)
+		return -1;
+	for (i = 0; i < 2; i++) {
+		if (!pair[i].body || pair[i].sequence != i + 1 ||
+		    pair[i].length != lengths[i])
+			return -1;
+		for (j = 0; j < 4; j++)
+			if (pair[i].address[j] != addresses[i][j])
+				return -1;
+	}
+	sequence = ordinal < 50 ? 0 : 1;
+	step = sequence ? ordinal - 50 : ordinal;
+	count = (lengths[sequence] + 999) / 1000;
+	if (step < 2) {
+		if (capacity < 20)
+			return -1;
+		/* Opcode 8, one masked firmware register operation. */
+		out[0] = 1;
+		out[1] = 8;
+		out[2] = 16;
+		out[3] = 0;
+		out[4] = 1;
+		out[5] = 1;
+		out[6] = 0;
+		out[7] = 1;
+		out[8] = step ? 0x2c : 8;
+		out[9] = step ? 0x0b : 5;
+		out[10] = 9;
+		out[11] = 2;
+		for (i = 0; i < 4; i++) {
+			out[12 + i] = step ? pair[sequence].address[i] : 0;
+			out[16 + i] = 255;
+		}
+		bytes = 20;
+		event_bytes = 8;
+	} else if (step < count + 2) {
+		int result = wmt_rom_patch_fragment(&pair[sequence], step - 2, out, capacity);
+
+		if (result < 0)
+			return -1;
+		bytes = result;
+		event_bytes = 5;
+	} else {
+		if (capacity < 5)
+			return -1;
+		out[0] = 1;
+		out[1] = 7;
+		out[2] = 1;
+		out[3] = 0;
+		out[4] = 4;
+		bytes = 5;
+		event_bytes = 5;
+	}
+	expected[0] = 2;
+	expected[1] = out[1];
+	expected[2] = event_bytes - 4;
+	expected[3] = 0;
+	for (i = 4; i < event_bytes; i++)
+		expected[i] = 0;
+	if (event_bytes == 8)
+		expected[7] = 1;
+	*expected_length = event_bytes;
+	return bytes;
+}
+#endif
