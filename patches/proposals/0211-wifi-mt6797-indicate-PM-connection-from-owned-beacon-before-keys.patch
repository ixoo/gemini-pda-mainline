 drivers/net/wireless/mediatek/mt6797/hif.c    |  24 +++
 drivers/net/wireless/mediatek/mt6797/hif.h    |   7 +
 .../mediatek/mt6797/join-command-submit.h     |  15 ++
 .../wireless/mediatek/mt6797/join-commands.h  |  77 +++++++++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 162 +++++++++++++++++-
 5 files changed, 280 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 501dda8..97c87a3 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -670,6 +670,30 @@ int mt6797_hif_join_bss(struct mt6797_hif *hif, unsigned int sequence,
 					   sizeof(payload), false, deadline_ns);
 }
 
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+int mt6797_hif_join_pm_connected(struct mt6797_hif *hif, unsigned int sequence,
+				 unsigned int dtim, unsigned int aid, unsigned int interval,
+				 u64 deadline_ns)
+{
+	u8 payload[MT6797_JOIN_PM_CONNECTED_BYTES];
+
+	if (!mt6797_join_pm_connected_payload(dtim, aid, interval, payload))
+		return -EINVAL;
+	return mt6797_hif_send_join_command(hif, 0x16, sequence, payload,
+					   sizeof(payload), false, deadline_ns);
+}
+
+int mt6797_hif_join_pm_abort(struct mt6797_hif *hif, unsigned int sequence,
+			     u64 deadline_ns)
+{
+	u8 payload[4];
+
+	mt6797_join_pm_abort_payload(payload);
+	return mt6797_hif_send_join_command(hif, 0x17, sequence, payload,
+					   sizeof(payload), false, deadline_ns);
+}
+#endif
+
 int mt6797_hif_join_station(struct mt6797_hif *hif, unsigned int sequence,
 	const u8 *ap, unsigned int state, unsigned int aid,
 	unsigned int desired_rates, unsigned int basic_rates, u64 deadline_ns)
