@@ -13,6 +13,20 @@ menuconfig RADIO_ADAPTERS
 
 if RADIO_ADAPTERS
 
+config RADIO_MT6797
+	tristate "MediaTek MT6797 CONSYS FM receiver"
+	depends on MTK_MT6797_CONSYS
+	help
+	  Say Y here for the MT6631 FM receiver behind the MT6797
+	  connectivity subsystem, reached over the shared STP link.
+
+	  This version only checks that the receiver answers: loading it
+	  powers the receiver up, reads its identity and powers it down
