From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 14 Nov 2026 20:47:28 -0500
Subject: [PATCH 793/793] soc: mediatek: mt6797-dvfsp-handoff: do not hold the
 shared AP-DMA gate to its boot state on resume

The I2C6 cleanup check requires the AP-DMA gate to keep its pre-probe state
through all 32 samples. That fits probe, where I2C6 is the only change, but
the sleep path compares against the same boot sample. Since the CONSYS and
Wi-Fi drivers enable AP-DMA per transfer instead of holding it, the gate
no longer stays at its boot state, and a resume can fail the check, fault
the handoff and leave I2C6 refused until reboot, with the DA9214 rails
frozen.

In the sleep path, require only a valid AP-DMA readback. Keep the stopped
PCM signature and the I2C_APPM gate checks, and keep the baseline check at
probe. Pick sample 0 when no sample matches the boot AP-DMA state.
---
 drivers/soc/mediatek/mt6797-dvfsp-handoff.c | 31 +++++++++++++++------
 1 file changed, 23 insertions(+), 8 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-dvfsp-handoff.c b/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
index 2e9ee38bb..e74cb3863 100644
--- a/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
+++ b/drivers/soc/mediatek/mt6797-dvfsp-handoff.c
@@ -496,8 +496,16 @@ static bool mt6797_dvfsp_snapshot_main_valid(
 	       mt6797_dvfsp_gate_is(snapshot, gated);
 }
 
+/*
+ * At probe the AP-DMA gate must keep its pre-probe state, since I2C6 is then
+ * the only change. In the sleep path that baseline is stale: AP-DMA is
+ * shared and its other users (the CONSYS and Wi-Fi drivers enable it per
+ * transfer) gate and ungate it on their own. Only its readback must be
+ * valid there.
+ */
 static bool
-mt6797_dvfsp_sample_consumer_post(struct mt6797_dvfsp_handoff *handoff)
+mt6797_dvfsp_sample_consumer_post(struct mt6797_dvfsp_handoff *handoff,
+				  bool dma_baseline)
 {
 	const struct mt6797_dvfsp_snapshot *baseline =
 		&handoff->samples[MT6797_DVFSP_PRE0];
@@ -548,11 +556,18 @@ mt6797_dvfsp_sample_consumer_post(struct mt6797_dvfsp_handoff *handoff)
 		!handoff->consumer_post_pcm_failures &&
 		!handoff->consumer_post_main_failures &&
 		!handoff->consumer_post_dma_invalid &&
-		handoff->consumer_post_dma_unchanged ==
-			MT6797_DVFSP_CONSUMER_POST_COUNT;
-	handoff->consumer_post_selected = handoff->consumer_post_passed ?
-		(first_dma_gated >= 0 ? first_dma_gated : first_dma_unchanged) :
-		MT6797_DVFSP_CONSUMER_POST_COUNT - 1;
+		(!dma_baseline ||
+		 handoff->consumer_post_dma_unchanged ==
+			MT6797_DVFSP_CONSUMER_POST_COUNT);
+	if (!handoff->consumer_post_passed)
+		handoff->consumer_post_selected =
+			MT6797_DVFSP_CONSUMER_POST_COUNT - 1;
+	else if (first_dma_gated >= 0)
+		handoff->consumer_post_selected = first_dma_gated;
+	else if (first_dma_unchanged >= 0)
+		handoff->consumer_post_selected = first_dma_unchanged;
+	else
+		handoff->consumer_post_selected = 0;
 	handoff->samples[MT6797_DVFSP_CONSUMER_POST] =
 		handoff->consumer_post[handoff->consumer_post_selected];
 	handoff->sample_valid[MT6797_DVFSP_CONSUMER_POST] = true;
@@ -1675,7 +1690,7 @@ mt6797_dvfsp_handoff_validate_clock(
 
 	if (gated) {
 		bool cleanup_passed =
-			mt6797_dvfsp_sample_consumer_post(handoff);
+			mt6797_dvfsp_sample_consumer_post(handoff, true);
 
 		mt6797_dvfsp_log_snapshot(
 			handoff, MT6797_DVFSP_CONSUMER_POST);
@@ -1764,7 +1779,7 @@ mt6797_dvfsp_handoff_validate_clock_pm(
 		atomic_inc(&handoff->consumer_ungated_checks);
 
 	if (gated) {
-		if (mt6797_dvfsp_sample_consumer_post(handoff))
+		if (mt6797_dvfsp_sample_consumer_post(handoff, false))
 			goto unlock_pm;
 	} else {
 		snapshot = &handoff->samples[MT6797_DVFSP_CONSUMER_HELD];
-- 
