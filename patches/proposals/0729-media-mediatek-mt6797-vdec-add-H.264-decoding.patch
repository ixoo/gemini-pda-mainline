+	  .menu_skip_mask = BIT(V4L2_MPEG_VIDEO_H264_PROFILE_EXTENDED),
+	  .def = V4L2_MPEG_VIDEO_H264_PROFILE_MAIN },
 	{ .id = V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
 	  .min = V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN,
 	  .max = V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN,
@@ -301,6 +338,31 @@ static void mvdec_buf_request_complete(struct vb2_buffer *vb)
 	v4l2_ctrl_request_complete(vb->req_obj.req, &ctx->hdl);
 }
 
+int mvdec_alloc_aux(struct mvdec_ctx *ctx, unsigned int idx, size_t size)
+{
+	struct mvdec_aux_buf *b;
+
+	if (idx >= MVDEC_AUX_BUFS || ctx->aux[idx].cpu)
+		return -EINVAL;
+	b = &ctx->aux[idx];
+	b->size = PAGE_ALIGN(size);
+	b->cpu = dma_alloc_coherent(ctx->dev->dev, b->size, &b->dma, GFP_KERNEL);
+	return b->cpu ? 0 : -ENOMEM;
+}
+
+static void mvdec_free_aux(struct mvdec_ctx *ctx)
+{
+	unsigned int i;
+
+	for (i = 0; i < MVDEC_AUX_BUFS; i++) {
+		if (!ctx->aux[i].cpu)
+			continue;
+		dma_free_coherent(ctx->dev->dev, ctx->aux[i].size, ctx->aux[i].cpu,
+				  ctx->aux[i].dma);
+		ctx->aux[i].cpu = NULL;
+	}
+}
+
 static void mvdec_free_mv(struct mvdec_ctx *ctx)
 {
 	unsigned int i;
@@ -324,8 +386,12 @@ static int mvdec_start_streaming(struct vb2_queue *vq, unsigned int count)
 		return 0;
 
 	memset(&ctx->hevc, 0, sizeof(ctx->hevc));
+	memset(&ctx->h264, 0, sizeof(ctx->h264));
 	/* One zeroed collocated-MV buffer per capture buffer. */
-	size = mvdec_hevc_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height);
+	if (mvdec_is_h264(ctx->src_fmt.pixelformat))
