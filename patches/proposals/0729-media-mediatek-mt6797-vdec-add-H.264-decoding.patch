 static const struct vb2_ops mvdec_qops = {
@@ -420,19 +497,35 @@ static void mvdec_device_run(void *priv)
 	struct mvdec_ctx *ctx = priv;
 	struct mvdec_dev *vdev = ctx->dev;
 	struct vb2_v4l2_buffer *src, *dst;
+	bool h264 = mvdec_is_h264(ctx->src_fmt.pixelformat);
 	struct mvdec_hevc_run run = {};
