@@ -448,7 +541,10 @@ static void mvdec_device_run(void *priv)
 	writel(0, vdev->larb + MVDEC_LARB_MMU_EN);
 
 	vdev->running = ctx;
-	ret = mvdec_hevc_run(ctx, src, dst, &run);
+	if (h264)
