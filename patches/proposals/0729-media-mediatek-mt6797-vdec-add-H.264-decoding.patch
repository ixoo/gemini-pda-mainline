  */
@@ -25,9 +25,23 @@
 
 /* ---- formats ---------------------------------------------------------- */
 
-static void mvdec_fill_dst(struct v4l2_pix_format_mplane *pix)
+static bool mvdec_is_h264(u32 fourcc)
 {
-	unsigned int w = ALIGN(pix->width, 64), h = ALIGN(pix->height, 64);
+	return fourcc == V4L2_PIX_FMT_H264_SLICE;
+}
+
+/* HEVC frames are padded to 64x64 CTBs, H.264 frames to 16x32 tiles. */
+static void mvdec_fill_dst(struct v4l2_pix_format_mplane *pix, u32 codec)
+{
+	unsigned int w, h;
+
+	if (mvdec_is_h264(codec)) {
