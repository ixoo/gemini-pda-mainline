+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
@@ -11,9 +11,9 @@ maintainers:
 
 description: |
   The CONSYS manager owns the boot-allocated no-map firmware reservation
-  shared by WLAN and WMT. It does not attach to a power domain during probe;
-  later children can be populated only after their common prerequisites are
-  prepared.
+  shared by WLAN and WMT. It attaches to a confirmed-OFF CONN domain only
+  after acquiring the common resources, then populates the passive WLAN child.
+  The child has no direct power-domain attachment.
 
 properties:
   compatible:
@@ -44,6 +44,16 @@ properties:
 
   power-domains: false
 
+  wifi:
+    type: object
+    description: Passive WLAN firmware client populated after CONSYS binds.
+    properties:
+      compatible:
+        const: mediatek,mt6797-wlan
+    required:
+      - compatible
+    additionalProperties: false
+
   mediatek,conn-power-domain:
     $ref: /schemas/types.yaml#/definitions/phandle-array
     maxItems: 1
@@ -112,5 +122,9 @@ examples:
             vcn33-wifi-supply = <&vcn33_wifi>;
             resets = <&watchdog 12>;
             reset-names = "con-mcu";
+
+            wifi {
+                compatible = "mediatek,mt6797-wlan";
+            };
         };
     };
