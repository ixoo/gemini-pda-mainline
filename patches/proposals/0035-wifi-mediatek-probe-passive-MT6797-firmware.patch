 .../boot/dts/mediatek/mt6797-gemini-pda.dts   |  4 ++
 drivers/net/wireless/mediatek/mt6797/Makefile |  1 +
 .../mediatek/mt6797/firmware-prepare.c        | 15 +++++
 .../mediatek/mt6797/firmware-prepare.h        | 10 ++++
 .../wireless/mediatek/mt6797/firmware-probe.c | 60 +++++++++++++++++++
 drivers/soc/mediatek/mt6797-consys.c          | 10 +++-
 7 files changed, 116 insertions(+), 4 deletions(-)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/firmware-probe.c

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
