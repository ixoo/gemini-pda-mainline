diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 0730c1ec3..dff076461 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -508,6 +508,13 @@ int mt6797_hif_query_capability(struct mt6797_hif *hif, unsigned int sequence,
 	trace->stage = MT6797_CAP_ADMIT;
 	error = mt6797_normal_admit(&hif->normal, 26, 26,
 				    hif->transaction->used_sequences);
+	if (error)
+		goto out;
+	/* Phase C3 data pool: a declared 16-page TC1 budget (one 1518-byte
+	 * frame with its descriptor is 13 pages), far below the pinned
+	 * NIC_TX_PAGE_COUNT_TC1 the vendor configures; one frame in flight.
+	 */
+	error = mt6797_normal_admit_tc1(&hif->normal, 16, 16);
 	if (error)
 		goto out;
 	/* A pre-existing port-1 event would make its reply owner ambiguous.
@@ -725,7 +732,8 @@ bool mt6797_hif_normal_idle(struct mt6797_hif *hif)
 	t = &hif->normal;
 	idle = t->phase == MT6797_NORMAL_NVRAM_SUBMITTED && t->used_sequences &&
 	       t->tc4_limit && t->tc4_limit <= 0xffffU && !t->tc4_pending_cpu &&
-	       !t->tc4_pending_ffa && t->tc4_free == t->tc4_limit;
+	       !t->tc4_pending_ffa && t->tc4_free == t->tc4_limit &&
+	       t->tc1_free == t->tc1_limit && !t->tc1_pending;
 	mutex_unlock(&hif->mutex);
 	return idle;
 }
@@ -840,6 +848,49 @@ int mt6797_hif_send_security(struct mt6797_hif *hif, const u8 *frame,
 	return error;
 }
 
+int mt6797_hif_send_data(struct mt6797_hif *hif, const u8 *frame,
+			 size_t frame_bytes, u8 wlan, u8 pid,
+			 unsigned int lifetime_ms, unsigned int attempt_count,
+			 u64 deadline_ns)
+{
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	int error;
+
+	if (!hif || !frame)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || !hif->capability_complete ||
+	    hif->transaction->phase != MT6797_INIT_IDLE ||
+	    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
+		error = -EIO;
+		goto unlock;
+	}
+	error = mt6797_join_prepare_data(&hif->normal, frame, frame_bytes,
+					 wlan, pid, lifetime_ms, attempt_count,
+					 hif->scratch, sizeof(hif->scratch),
+					 &command);
+	if (error)
+		goto unlock;
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto fail;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch,
+					MT6797_JOIN_TX_DESC_BYTES + frame_bytes,
+					sizeof(hif->scratch), &transfer);
+	error = mt6797_normal_submitted(&hif->normal, error);
+	if (!error)
+		error = mt6797_hif_guard(hif);
+fail:
+	if (error)
+		error = mt6797_hif_fail(hif, error);
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
