diff --git a/drivers/net/wireless/mediatek/mt6797/join-submit.h b/drivers/net/wireless/mediatek/mt6797/join-submit.h
index 43ebf4ef3..8cf29b4e9 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-submit.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-submit.h
@@ -97,4 +97,57 @@ mt6797_join_prepare_security(struct mt6797_normal_transaction *t,
 	return mt6797_join_prepare_frame(t, descriptor, frame, bytes, pages,
 					 output, capacity, command);
 }
+
+/* Prepare one protected Ethernet II data frame on the TC1 data pool: the
+ * same framing as the TC4 frames, the pages debited from the pool admitted
+ * by mt6797_normal_admit_tc1, one frame in flight (the pool must be whole),
+ * no command sequence consumed, TX done matched by the PID. The TC4 ledger
+ * is untouched; the phase flip is the same as for every frame.
+ */
+static inline int
+mt6797_join_prepare_data(struct mt6797_normal_transaction *t,
+			 const unsigned char *frame, size_t bytes,
+			 unsigned char wlan, unsigned char pid,
+			 unsigned int lifetime_ms, unsigned int attempt_count,
+			 unsigned char *output, size_t capacity,
+			 struct mt6797_hif_command *command)
+{
+	unsigned char descriptor[MT6797_JOIN_TX_DESC_BYTES];
+	struct mt6797_hif_command encoded;
+	unsigned int pages;
+	size_t total, i;
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    !t->tc4_limit || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit ||
+	    !t->tc1_limit || t->tc1_free > t->tc1_limit)
+		return mt6797_normal_abort(t);
+	if (!mt6797_join_tx_data_descriptor(frame, bytes, wlan, pid, lifetime_ms,
+					    attempt_count, descriptor, &pages))
+		return -EINVAL;
+	if (t->tc1_free != t->tc1_limit || t->tc1_pending)
+		return -EBUSY;
+	if (t->tc1_free < pages)
+		return -ENOSPC;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	error = mt6797_hif_encode_command(0x34, MT6797_HIF_WRITE,
+					  MT6797_HIF_PIO_ONLY, total, capacity, &encoded);
+	if (error)
+		return error;
+	for (i = 0; i < encoded.transfer_bytes; i++)
+		output[i] = 0;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = descriptor[i];
+	for (i = 0; i < bytes; i++)
+		output[MT6797_JOIN_TX_DESC_BYTES + i] = frame[i];
+	t->tc1_free -= pages;
+	t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	t->phase = MT6797_NORMAL_CONFIG_TX;
+	*command = encoded;
+	return 0;
+}
 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/join-tx.h b/drivers/net/wireless/mediatek/mt6797/join-tx.h
index b125a8b1a..f4dcc5268 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-tx.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-tx.h
@@ -61,6 +61,7 @@ mt6797_join_tx_descriptor(const unsigned char *frame, size_t bytes,
 }
 
 #define MT6797_JOIN_ETH_MAX_BYTES 1518U
+#define MT6797_JOIN_ETH_MIN_BYTES 14U
 
 /* Original encoder from the pinned public gen3 nicTxComposeSecurityFrameDesc
  * path: one Ethernet II EAPOL frame on the same TC4 owner, header format
@@ -111,4 +112,59 @@ mt6797_join_tx_security_descriptor(const unsigned char *frame, size_t bytes,
 	*pages = (total + 127U) / 128U;
 	return true;
 }
+
+/* Original encoder from the pinned public gen3 nicTxComposeDesc path for one
+ * protected Ethernet II data frame of a legacy station: TC1 (PORT_INDEX_LMAC
+ * 0, MAC_TXQ_AC1_INDEX 1, the pinned arTcResourceControl row), long format,
+ * non-802.11 header with the Ethernet II flag, Ethernet-type offset after the
+ * descriptor and the 12 address bytes, TID 0 (no WMM was negotiated), the
+ * protected-frame bit (the firmware encrypts with the installed pairwise key
+ * under the station's WLAN index, as secIsProtectedFrame sets it for a
+ * station with a TX key), own-MAC index 1, the bounded lifetime and attempt
+ * count, the fixed OFDM 6 Mbps rate and a PID with TX status to the MCU. The
+ * destination may be a group address (ARP and DHCP are); the source is this
+ * station, never a group address; the EAPOL type is refused here (no rekey
+ * on this path). The firmware builds the 802.11 header; no sequence number,
+ * type or subtype is encoded. No transport, lifetime or admission here.
+ */
+static inline bool
+mt6797_join_tx_data_descriptor(const unsigned char *frame, size_t bytes,
+			       unsigned char wlan, unsigned char pid,
+			       unsigned int lifetime_ms, unsigned int attempt_count,
+			       unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+			       unsigned int *pages)
+{
+	unsigned char d[MT6797_JOIN_TX_DESC_BYTES] = {0};
+	unsigned int lifetime, total, count, i;
+
+	if (!frame || !output || !pages || bytes < MT6797_JOIN_ETH_MIN_BYTES ||
+	    bytes > MT6797_JOIN_ETH_MAX_BYTES || wlan > 30 || !pid || pid > 127 ||
+	    !lifetime_ms || lifetime_ms > 10000 || !attempt_count || attempt_count > 30)
+		return false;
+	if ((frame[6] & 1) || (frame[12] == 0x88 && frame[13] == 0x8e))
+		return false;
+	lifetime = (lifetime_ms * 1000U / 1024U) >> 5;
+	if (!lifetime)
+		lifetime = 1;
+	if (lifetime > 255)
+		lifetime = 255;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	count = attempt_count << 11;
+	d[0] = total; d[1] = total >> 8;
+	d[2] = (MT6797_JOIN_TX_DESC_BYTES + 12) / 2; /* Ethernet type after the addresses. */
+	d[3] = 1U << 3; /* LMAC port 0, queue index 1 (AC1): TC1. */
+	d[4] = wlan;
+	d[5] = 0x90; /* Long descriptor, non-802.11 header, Ethernet II. */
+	d[6] = 0x80; /* Protected frame, TID 0, no header padding. */
+	d[7] = 1U << 2; /* Own-MAC 1. */
+	d[10] = lifetime;
+	d[11] = 0x80; /* Fixed rate enabled, zero power offset. */
+	d[12] = count; d[13] = count >> 8;
+	d[20] = pid; d[21] = 2; /* TX status to MCU. */
+	d[26] = (0x4bU << 2) & 255; d[27] = (0x4bU << 2) >> 8;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = d[i];
+	*pages = (total + 127U) / 128U;
+	return true;
+}
 #endif
