From c31ef7adf62d3eb98f2e38e4231c0963845aa3ed Mon Sep 17 00:00:00 2001
From: Gemini PDA experiment <experiment.invalid>
Date: Mon, 28 Sep 2026 16:15:38 -0400
Subject: [PATCH] soc: mediatek: probe one gated MT6797 Wi-Fi HIF startup

After the observed one-shot CONMCU reset release, test the Gemian-matched
pre-firmware HIF path once. Claim the AHB aperture, check the shared VCN33
controls, enable only the Wi-Fi rail and function 1, require IOEx/IORx
readback, and read WCIR. Keep all effects for reviewed recovery and leave
firmware and DMA held.

This is an internal experiment with synthetic, non-certifying authorship.
It is not an upstream submission.

---
 .../soc/mediatek/mediatek,mt6797-consys.yaml  |  21 +++
 .../boot/dts/mediatek/mt6797-gemini-pda.dts   |   7 +-
 drivers/soc/mediatek/mt6797-consys.c          | 174 +++++++++++++++++-
 3 files changed, 191 insertions(+), 11 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
index 26fadbb..4374294 100644
--- a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
@@ -26,6 +26,7 @@ properties:
       - description: Four-byte CONN-to-AP sleep mask at TOPCKGEN 0x1350.
       - description: Read-only CONSYS chip ID at 0x18070008.
       - description: CONSYS MCU ACR at 0x18070110.
+      - description: AHB SDIO-like Wi-Fi HIF at 0x180f0000.
 
   reg-names:
     minItems: 1
@@ -34,6 +35,7 @@ properties:
       - const: conn2ap-sleep-mask
       - const: chip-id
       - const: mcu-acr
+      - const: wifi-hif
 
   memory-region:
     maxItems: 1
@@ -75,6 +77,13 @@ properties:
       set MCU ACR bit 18 and release the exclusive CONMCU reset once.
       Retain all effects until reboot; do not transfer firmware.
 
+  mediatek,one-shot-hif-probe:
+    type: boolean
+    description: |
+      After a successful gated CONMCU release, enable the Wi-Fi 3.3 V rail,
+      perform one function-enable CMD52 exchange and read WCIR once through
+      the exclusively claimed AHB HIF. No firmware or DMA transfer occurs.
+
   wifi:
     type: object
     description: Passive WLAN firmware client populated after CONSYS binds.
@@ -140,6 +149,18 @@ allOf:
       required:
         - mediatek,one-shot-chip-id-probe
         - reg-names
+  - if:
+      required:
+        - mediatek,one-shot-hif-probe
+    then:
+      properties:
+        reg:
+          minItems: 5
+        reg-names:
+          minItems: 5
+      required:
+        - mediatek,one-shot-reset-release-probe
+        - reg-names
 
 examples:
   - |
diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
index 1ba824b..6336bcf 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -79,11 +79,14 @@
 	consys@10001340 {
 		compatible = "mediatek,mt6797-consys";
 		reg = <0 0x10001340 0 4>, <0 0x10001350 0 4>,
-		      <0 0x18070008 0 4>, <0 0x18070110 0 4>;
-		reg-names = "remap", "conn2ap-sleep-mask", "chip-id", "mcu-acr";
+		      <0 0x18070008 0 4>, <0 0x18070110 0 4>,
+		      <0 0x180f0000 0 0x1100>;
+		reg-names = "remap", "conn2ap-sleep-mask", "chip-id", "mcu-acr",
+			    "wifi-hif";
 		mediatek,one-shot-power-probe;
 		mediatek,one-shot-chip-id-probe;
 		mediatek,one-shot-reset-release-probe;
+		mediatek,one-shot-hif-probe;
 		memory-region = <&consys_reserved>;
 		vcn18-supply = <&mt6351_vcn18_reg>;
 		vcn28-supply = <&mt6351_vcn28_reg>;
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index 1a532c5..0335204 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -30,7 +30,17 @@
 #define MT6797_CONSYS_CHIP_ID_REG	0x18070008
 #define MT6797_CONSYS_MCU_ACR_REG	0x18070110
 #define MT6797_CONSYS_MCU_ACR_MBIST	BIT(18)
+#define MT6797_CONSYS_HIF_REG	0x180f0000
+#define MT6797_CONSYS_HIF_SIZE	0x1100
+#define MT6797_HIF_CMD_SETUP	0x0000
+#define MT6797_HIF_CMD52_DATA	0x0004
+#define MT6797_HIF_CMD53_DATA	0x1000
+#define MT6797_HIF_CCCR_IOEX	0x0002
+#define MT6797_HIF_CCCR_IORX	0x0003
+#define MT6797_HIF_WIFI_FUNCTION	BIT(1)
+#define MT6797_HIF_WCIR_ID	0x0279
 #define MT6797_EMI_MPU_READ	0x82000208
+#define MT6351_VCN33_ACTIVE	(BIT(3) | BIT(1))
 #define MT6351_VCN28_HW_CONTROL	BIT(3)
 #define MT6351_VCN28_ENABLE	BIT(1)
 #define MT6351_VCN28_CLOCK_SELECT	(GENMASK(7, 5) | GENMASK(13, 11))
@@ -41,6 +51,7 @@ struct mt6797_consys {
 	void __iomem *sleep_mask;
 	void __iomem *chip_id;
 	void __iomem *mcu_acr;
+	void __iomem *hif;
 	phys_addr_t base;
 	struct regulator *vcn18;
 	struct regulator *vcn28;
@@ -316,7 +327,7 @@ skipped:
 }
 
 /* Do not undo an uncertain MCU write or reset transition in this one-shot boot. */
-static void mt6797_consys_probe_reset_release(struct device *dev,
+static bool mt6797_consys_probe_reset_release(struct device *dev,
 					       struct mt6797_consys *owner)
 {
 	u32 before, after, chip_id;
@@ -364,18 +375,133 @@ static void mt6797_consys_probe_reset_release(struct device *dev,
 	chip_id = readl(owner->chip_id);
 	dev_info(dev, "one-shot CONN MCU reset released: chip-id=0x%08x, domain ON\n",
 		 chip_id);
-	if (chip_id != 0x0279)
+	if (chip_id != 0x0279) {
 		dev_err(dev, "one-shot CONN MCU reset release: unexpected chip ID; state retained\n");
-	return;
+		return false;
+	}
+	return true;
 
 stopped:
 	dev_err(dev, "one-shot CONN MCU reset release stopped (%d); state retained\n",
 		ret);
+	return false;
+}
+
+/* CMD52 function-zero access through the claimed AHB SDIO-like aperture. */
+static u8 mt6797_consys_hif_cccr_read(struct mt6797_consys *owner, u32 reg)
+{
+	writel(reg << 9, owner->hif + MT6797_HIF_CMD_SETUP);
+	return readl(owner->hif + MT6797_HIF_CMD52_DATA);
+}
+
+static void mt6797_consys_hif_cccr_write(struct mt6797_consys *owner,
+					 u32 reg, u8 value)
+{
+	writel(BIT(31) | (reg << 9) | value,
+	       owner->hif + MT6797_HIF_CMD_SETUP);
+	writel(value, owner->hif + MT6797_HIF_CMD52_DATA);
+}
+
+/* Match only the Gemian PALDO, function-enable and pre-DMA WCIR path. */
+static void mt6797_consys_probe_hif(struct device *dev,
+				   struct mt6797_consys *owner)
+{
+	struct regmap *pmic;
+	unsigned int bt_control, wifi_control;
+	u32 wcir;
+	u8 ioex, iorx;
+	int ret;
+
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 0) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	if (readl(owner->chip_id) != MT6797_HIF_WCIR_ID) {
+		ret = -ENODEV;
+		goto stopped;
+	}
+	ret = regulator_is_enabled(owner->vcn33_wifi);
+	if (ret) {
+		ret = ret < 0 ? ret : -EBUSY;
+		goto stopped;
+	}
+	pmic = regulator_get_regmap(owner->vcn33_wifi);
+	if (IS_ERR(pmic)) {
+		ret = PTR_ERR(pmic);
+		goto stopped;
+	}
+	ret = regmap_read(pmic, MT6351_LDO_VCN33_BT_CON0, &bt_control);
+	if (ret)
+		goto stopped;
+	ret = regmap_read(pmic, MT6351_LDO_VCN33_WIFI_CON0, &wifi_control);
+	if (ret)
+		goto stopped;
+	dev_info(dev, "one-shot HIF VCN33 before: BT=0x%04x WiFi=0x%04x\n",
+		 bt_control, wifi_control);
+	if ((bt_control | wifi_control) & MT6351_VCN33_ACTIVE) {
+		ret = -EBUSY;
+		goto stopped;
+	}
+	ret = regulator_set_voltage(owner->vcn33_wifi, 3300000, 3300000);
+	if (ret)
+		goto stopped;
+	ret = regulator_enable(owner->vcn33_wifi);
+	if (ret)
+		goto stopped;
+	ret = regulator_is_enabled(owner->vcn33_wifi);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 0) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	ioex = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IOEX);
+	iorx = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IORX);
+	dev_info(dev, "one-shot HIF before enable: IOEx=0x%02x IORx=0x%02x\n",
+		 ioex, iorx);
+	if (ioex || iorx) {
+		ret = -EBUSY;
+		goto stopped;
+	}
+	mt6797_consys_hif_cccr_write(owner, MT6797_HIF_CCCR_IOEX,
+				     MT6797_HIF_WIFI_FUNCTION);
+	ioex = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IOEX);
+	iorx = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IORX);
+	dev_info(dev, "one-shot HIF after enable: IOEx=0x%02x IORx=0x%02x\n",
+		 ioex, iorx);
+	if (ioex != MT6797_HIF_WIFI_FUNCTION ||
+	    iorx != MT6797_HIF_WIFI_FUNCTION) {
+		ret = -EIO;
+		goto stopped;
+	}
+	writel(BIT(28) | 4, owner->hif + MT6797_HIF_CMD_SETUP);
+	wcir = readl(owner->hif + MT6797_HIF_CMD53_DATA);
+	dev_info(dev, "one-shot HIF WCIR=0x%08x\n", wcir);
+	if ((wcir & 0xffff) != MT6797_HIF_WCIR_ID) {
+		ret = -ENODEV;
+		goto stopped;
+	}
+	dev_info(dev, "one-shot HIF function ready; firmware and DMA held\n");
+	return;
+
+stopped:
+	dev_err(dev, "one-shot HIF stopped (%d); state retained\n", ret);
 }
 
 /* One attempt per boot. Keep every acquired vote after any uncertain effect. */
 static void mt6797_consys_probe_power_on(struct device *dev, struct mt6797_consys *owner,
-					 bool chip_id_probe, bool reset_release_probe)
+					 bool chip_id_probe, bool reset_release_probe,
+					 bool hif_probe)
 {
 	struct regmap *pmic;
 	unsigned int vcn28;
@@ -528,8 +654,13 @@ static void mt6797_consys_probe_power_on(struct device *dev, struct mt6797_consy
 		if (chip_id == 0x0279) {
 			bool emi_clear = mt6797_consys_probe_powered_emi(dev, owner);
 
-			if (reset_release_probe && emi_clear)
-				mt6797_consys_probe_reset_release(dev, owner);
+			if (reset_release_probe && emi_clear) {
+				bool released;
+
+				released = mt6797_consys_probe_reset_release(dev, owner);
+				if (hif_probe && released)
+					mt6797_consys_probe_hif(dev, owner);
+			}
 			else if (reset_release_probe)
 				dev_err(dev, "one-shot CONN MCU reset release skipped: EMI gate\n");
 		}
@@ -543,12 +674,14 @@ held:
 static int mt6797_consys_probe(struct platform_device *pdev)
 {
 	struct resource *remap_resource, *sleep_resource, *chip_resource, *acr_resource;
+	struct resource *hif_resource;
 	struct regulator *vcn18, *vcn28, *vcn33_wifi;
 	struct reset_control *conmcu_reset;
 	struct generic_pm_domain *conn_domain;
 	void __iomem *remap;
 	void __iomem *sleep_mask = NULL, *chip_id = NULL, *mcu_acr = NULL;
-	bool power_probe, chip_id_probe, reset_release_probe;
+	void __iomem *hif = NULL;
+	bool power_probe, chip_id_probe, reset_release_probe, hif_probe;
 	u64 base;
 	int ret;
 
@@ -559,6 +692,8 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 					      "mediatek,one-shot-chip-id-probe");
 	reset_release_probe = of_property_read_bool(pdev->dev.of_node,
 					      "mediatek,one-shot-reset-release-probe");
+	hif_probe = of_property_read_bool(pdev->dev.of_node,
+					  "mediatek,one-shot-hif-probe");
 	if (chip_id_probe && !power_probe) {
 		ret = -EINVAL;
 		goto out_unlock;
@@ -567,6 +702,10 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 		ret = -EINVAL;
 		goto out_unlock;
 	}
+	if (hif_probe && !reset_release_probe) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
 	if (mt6797_consys.bound) {
 		ret = -EBUSY;
 		goto out_unlock;
@@ -656,7 +795,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	if (reset_release_probe) {
 		acr_resource = platform_get_resource(pdev, IORESOURCE_MEM, 3);
 		if (!acr_resource ||
-		    platform_get_resource(pdev, IORESOURCE_MEM, 4) ||
+		    (!hif_probe && platform_get_resource(pdev, IORESOURCE_MEM, 4)) ||
 		    acr_resource->start != MT6797_CONSYS_MCU_ACR_REG ||
 		    resource_size(acr_resource) != sizeof(u32)) {
 			ret = -EINVAL;
@@ -668,6 +807,21 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 			goto out_unlock;
 		}
 	}
+	if (hif_probe) {
+		hif_resource = platform_get_resource(pdev, IORESOURCE_MEM, 4);
+		if (!hif_resource ||
+		    platform_get_resource(pdev, IORESOURCE_MEM, 5) ||
+		    hif_resource->start != MT6797_CONSYS_HIF_REG ||
+		    resource_size(hif_resource) != MT6797_CONSYS_HIF_SIZE) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+		hif = devm_platform_ioremap_resource(pdev, 4);
+		if (IS_ERR(hif)) {
+			ret = PTR_ERR(hif);
+			goto out_unlock;
+		}
+	}
 	ret = mt6797_consys_attach_off_domain(&pdev->dev, &conn_domain);
 	if (ret)
 		goto out_unlock;
@@ -676,6 +830,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	mt6797_consys.sleep_mask = sleep_mask;
 	mt6797_consys.chip_id = chip_id;
 	mt6797_consys.mcu_acr = mcu_acr;
+	mt6797_consys.hif = hif;
 	mt6797_consys.vcn18 = vcn18;
 	mt6797_consys.vcn28 = vcn28;
 	mt6797_consys.vcn33_wifi = vcn33_wifi;
@@ -694,7 +849,8 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 		 "bound boot CONSYS reserve, remap, VCN, CONMCU reset and checked-OFF CONN domain; populated passive children\n");
 	if (power_probe)
 		mt6797_consys_probe_power_on(&pdev->dev, &mt6797_consys,
-					    chip_id_probe, reset_release_probe);
+					    chip_id_probe, reset_release_probe,
+					    hif_probe);
 out_unlock:
 	mutex_unlock(&mt6797_consys_lock);
 	return ret;
