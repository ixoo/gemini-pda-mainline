+++ b/drivers/net/wireless/mediatek/mt6797/record-prepare.c
@@ -44,6 +44,7 @@ int mt6797_wifi_record_prepare(struct device *dev,
 	kfree(record);
 	return ret;
 }
+EXPORT_SYMBOL_GPL(mt6797_wifi_record_prepare);
 
 const u8 *mt6797_wifi_record_data(const struct mt6797_wifi_record *record)
 {
@@ -66,3 +67,4 @@ void mt6797_wifi_record_release(struct mt6797_wifi_record *record)
 	memzero_explicit(&record->commands, sizeof(record->commands));
 	kfree(record);
 }
