From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 16 Nov 2026 09:37:04 -0500
Subject: [PATCH 801/801] power: supply: mt6351-usb-type: set the USB role from
 VBUS

On the Gemini PDA the USB 2.0 PHY forces the controller's B-session
valid, so the MTU3 controller never sees VBUS go away and, as a
device-default port with no wake path, it keeps its clocks and PHY on
with no cable: the SoC's deep idle waits on them.

The PMIC's charger detection does see VBUS. Set the controller's role
switch to none when VBUS goes and to device when it comes from a port
that may be a host, not from a dedicated or Apple charger, after the
charger type detection so that the pullup does not disturb it. BC1.1 misread
a charging host as a non-standard charger with the controller powered
down, so hold it powered, still stopped, for the detection. The switch is
looked up at each change and released after it, since the controller
can be unbound and bound again with a new switch. Leave a
host role alone: it is set by whoever drives the port as a host, and
its VBUS comes from this side.
---
 drivers/power/supply/Kconfig           |  4 +-
 drivers/power/supply/mt6351-usb-type.c | 87 ++++++++++++++++++++++++++
 2 files changed, 90 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index db30caedf..3a52cc596 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -843,11 +843,13 @@ config CHARGER_BQ25890
 config CHARGER_MT6351_USB_TYPE
 	tristate "MediaTek MT6351 USB charger type detection"
 	depends on MFD_MT6397 && OF
+	depends on USB_ROLE_SWITCH || !USB_ROLE_SWITCH
 	help
 	  Say Y or M to detect the type of a USB charger (SDP, CDP, DCP or
 	  Apple) with the MT6351 PMIC's BC1.1 block, switching the MT6797
 	  USB 2.0 PHY's data lines to it at a plug. The result is reported
-	  as a power supply's usb_type for a charger driver to use.
+	  as a power supply's usb_type for a charger driver to use, and the
+	  USB controller's role follows VBUS.
 
 config CHARGER_BQ25980
 	tristate "TI BQ25980 battery charger driver"
diff --git a/drivers/power/supply/mt6351-usb-type.c b/drivers/power/supply/mt6351-usb-type.c
index c7f3306df..872aef7e2 100644
--- a/drivers/power/supply/mt6351-usb-type.c
+++ b/drivers/power/supply/mt6351-usb-type.c
@@ -25,8 +25,10 @@
 #include <linux/of_address.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 #include <linux/power_supply.h>
 #include <linux/regmap.h>
+#include <linux/usb/role.h>
 #include <linux/workqueue.h>
 
 #define MT6351_CHR_CON0			0x0f78
@@ -172,6 +174,79 @@ static int mt6351_usb_type_detect(struct mt6351_usb_type *ut)
 	return type;
 }
 
+/*
+ * The PHY forces the USB controller's B-session valid, so the controller
+ * itself never sees VBUS. With no VBUS there is no host to serve: set its
+ * role switch to none, which lets it power down, and back to device when
+ * VBUS comes from a port that may be a host, after the detection so that the
+ * pullup does not disturb it.
+ * A host role is someone else's and left alone.
+ */
+static void mt6351_usb_type_set_role(struct mt6351_usb_type *ut, bool host)
+{
+	struct usb_role_switch *sw;
+	struct device_node *np;
+	int ret;
+
+	/*
+	 * Look the switch up at each change and drop it after: the controller
+	 * may be unbound and bound again, which replaces its switch.
+	 */
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6797-mtu3");
+	if (!np)
+		return;
+	sw = usb_role_switch_find_by_fwnode(of_fwnode_handle(np));
+	of_node_put(np);
+	if (!sw)
+		return;
+
+	if (usb_role_switch_get_role(sw) != USB_ROLE_HOST) {
+		ret = usb_role_switch_set_role(sw, host ? USB_ROLE_DEVICE :
+						      USB_ROLE_NONE);
+		if (ret)
+			dev_warn_ratelimited(ut->dev,
+					     "cannot set the USB role: %d\n", ret);
+	}
+
+	usb_role_switch_put(sw);
+}
+
+/*
+ * BC1.1 misreads a charging host as a non-standard charger while the USB
+ * controller has powered its PHY down for want of VBUS. Hold the controller
+ * powered for the detection; with no role set it stays stopped, so its
+ * gadget does not pull up. Returns the controller to release, or NULL.
+ */
+static struct device *mt6351_usb_type_hold_phy(void)
+{
+	struct platform_device *pdev;
+	struct device_node *np;
+
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6797-mtu3");
+	if (!np)
+		return NULL;
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return NULL;
+
+	if (pm_runtime_resume_and_get(&pdev->dev)) {
+		put_device(&pdev->dev);
+		return NULL;
+	}
+
+	return &pdev->dev;
+}
+
+static void mt6351_usb_type_release_phy(struct device *dev)
+{
+	if (!dev)
+		return;
+
+	pm_runtime_put(dev);
+	put_device(dev);
+}
+
 static void mt6351_usb_type_work(struct work_struct *work)
 {
 	struct mt6351_usb_type *ut =
@@ -185,12 +260,16 @@ static void mt6351_usb_type_work(struct work_struct *work)
 	if (!regmap_read(ut->regmap, MT6351_CHR_CON0, &con0)) {
 		online = con0 & MT6351_RGS_CHRDET;
 		if (online && !ut->online) {
+			struct device *usb = mt6351_usb_type_hold_phy();
+
 			type = mt6351_usb_type_detect(ut);
+			mt6351_usb_type_release_phy(usb);
 			if (type < 0) {
 				/* Not reported online, so the retry tries again. */
 				dev_warn_ratelimited(ut->dev, "detection failed: %d\n", type);
 				queue_delayed_work(system_power_efficient_wq,
 						   &ut->work, USB_TYPE_RETRY);
+				mt6351_usb_type_set_role(ut, true);
 				return;
 			}
 			dev_info(ut->dev, "charger attached: %s\n",
@@ -207,6 +286,14 @@ static void mt6351_usb_type_work(struct work_struct *work)
 			WRITE_ONCE(ut->online, false);
 			power_supply_changed(ut->psy);
 		}
+		/*
+		 * A dedicated or Apple charger has no host behind it: leave the
+		 * controller without a role, so that it stays powered down. A
+		 * charger read as non-standard may still be a host.
+		 */
+		mt6351_usb_type_set_role(ut, online &&
+					 ut->usb_type != POWER_SUPPLY_USB_TYPE_DCP &&
+					 ut->usb_type != POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID);
 	}
 }
 
-- 
2.43.0

