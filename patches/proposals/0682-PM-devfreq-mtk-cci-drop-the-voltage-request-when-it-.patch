From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 9 Nov 2026 09:39:01 -0500
Subject: [PATCH] PM / devfreq: mtk-cci: drop the voltage request when it lets
 go

The probe raises the proc (and SRAM) regulator to the highest OPP's
voltage before it adds the devfreq device. If a later step fails, most
often with -EPROBE_DEFER from the passive governor while a CPU has no
cpufreq policy yet, the error path disables the regulators and devres
puts them, but the raised request stays applied. Putting a consumer
does not settle the regulator again, so the rail stays at the highest
voltage until another consumer changes its own request.

On an MT6797 with only CPU0 online and its cluster pinned at 221 MHz,
a deferred probe left the coupled SRAM rail at 1.20 V instead of
1.10 V, and the battery current about 18 mA higher, until cpufreq-dt
was unloaded. Each deferred retry raises it again.

Set the request to the regulator's whole range before the regulators
are released, on the probe error paths after the voltage was raised and
in remove(), so the regulators settle at what the remaining consumers
ask for.
---
 drivers/devfreq/mtk-cci-devfreq.c | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/drivers/devfreq/mtk-cci-devfreq.c b/drivers/devfreq/mtk-cci-devfreq.c
index b5a6b34a5..b1ded9c2c 100644
--- a/drivers/devfreq/mtk-cci-devfreq.c
+++ b/drivers/devfreq/mtk-cci-devfreq.c
@@ -229,6 +229,18 @@ static int mtk_ccifreq_target(struct device *dev, unsigned long *freq,
 	return ret;
 }
 
+/*
+ * Give up the voltage request before the regulators are put: putting a
+ * consumer does not settle the regulator again, so a raised request would
+ * otherwise hold the rail until another consumer changes its own request.
+ */
+static void mtk_ccifreq_drop_voltage(struct mtk_ccifreq_drv *drv)
+{
+	regulator_set_voltage(drv->proc_reg, 0, INT_MAX);
+	if (drv->sram_reg)
+		regulator_set_voltage(drv->sram_reg, 0, INT_MAX);
+}
+
 static int mtk_ccifreq_opp_notifier(struct notifier_block *nb,
 				    unsigned long event, void *data)
 {
@@ -363,13 +375,13 @@ static int mtk_ccifreq_probe(struct platform_device *pdev)
 	if (ret) {
 		dev_err(dev, "failed to scale to highest voltage %lu in proc_reg\n",
 			opp_volt);
-		goto out_remove_opp_table;
+		goto out_drop_voltage;
 	}
 
 	passive_data = devm_kzalloc(dev, sizeof(*passive_data), GFP_KERNEL);
 	if (!passive_data) {
 		ret = -ENOMEM;
-		goto out_remove_opp_table;
+		goto out_drop_voltage;
 	}
 
 	passive_data->parent_type = CPUFREQ_PARENT_DEV;
@@ -380,17 +392,20 @@ static int mtk_ccifreq_probe(struct platform_device *pdev)
 		ret = -EPROBE_DEFER;
 		dev_err(dev, "failed to add devfreq device: %ld\n",
 			PTR_ERR(drv->devfreq));
-		goto out_remove_opp_table;
+		goto out_drop_voltage;
 	}
 
 	drv->opp_nb.notifier_call = mtk_ccifreq_opp_notifier;
 	ret = dev_pm_opp_register_notifier(dev, &drv->opp_nb);
 	if (ret) {
 		dev_err(dev, "failed to register opp notifier: %d\n", ret);
-		goto out_remove_opp_table;
+		goto out_drop_voltage;
 	}
 	return 0;
 
+out_drop_voltage:
+	mtk_ccifreq_drop_voltage(drv);
+
 out_remove_opp_table:
 	dev_pm_opp_of_remove_table(dev);
 
@@ -417,6 +432,7 @@ static void mtk_ccifreq_remove(struct platform_device *pdev)
 	dev_pm_opp_unregister_notifier(dev, &drv->opp_nb);
 	dev_pm_opp_of_remove_table(dev);
 	clk_disable_unprepare(drv->cci_clk);
+	mtk_ccifreq_drop_voltage(drv);
 	regulator_disable(drv->proc_reg);
 	if (drv->sram_reg)
 		regulator_disable(drv->sram_reg);
