 			 * runtime 16's unclassified frame shared its type word and
 			 * length), is irrelevant to the bounded join and is discarded
 			 * while the station is active: never delivered or interpreted,
@@ -1721,7 +1724,8 @@ static void mt6797_mac_join_work(struct work_struct *work)
 			    !mac->join_cleanup_done &&
 			    mt6797_join_action_frame(mac->join_packet, rx.logical_bytes, 40,
 						     mac->hw->wiphy->perm_addr,
-						     mac->join_ap, &action) &&
+						     mac->join_ap, mac->join_key_pairwise == 1,
+						     &action) &&
 			    mac->join_action_discarded < 8) {
 				mac->join_action_discarded++;
 				dev_info(wiphy_dev(mac->hw->wiphy),
