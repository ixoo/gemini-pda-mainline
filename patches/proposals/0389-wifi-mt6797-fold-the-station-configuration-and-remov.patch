@@ -1,187 +0,0 @@
-/* SPDX-License-Identifier: GPL-2.0-only */
-#ifndef MT6797_WMT_IDENTITY_IO_H
-#define MT6797_WMT_IDENTITY_IO_H
-#include <linux/completion.h>
-#include <linux/errno.h>
-#include <linux/interrupt.h>
