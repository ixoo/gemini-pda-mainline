diff --git a/drivers/net/wireless/mediatek/mt6797/testcfg-parse.h b/drivers/net/wireless/mediatek/mt6797/testcfg-parse.h
deleted file mode 100644
index 8390bea..0000000
--- a/drivers/net/wireless/mediatek/mt6797/testcfg-parse.h
+++ /dev/null
@@ -1,222 +0,0 @@
-/* SPDX-License-Identifier: GPL-2.0-only */
-#ifndef MT6797_TESTCFG_PARSE_H
-#define MT6797_TESTCFG_PARSE_H
-
-/* One join's test configuration (CONFIG_MT6797_WIFI_TESTCONFIG): the
- * class-B variables only, each overriding the build for one association.
- * The receive width is the advertised 20/40 MHz capability and the width
- * the join accepts; the join channel stays as built.
- */
-struct mt6797_testcfg {
-	unsigned char rate;	/* the data descriptor's fixed rate code */
-	bool minstrel;		/* mac80211's rate control choice instead */
-	bool txbw40;		/* FIX_BW_40, on an HT40 join only */
-	bool rxbw40;		/* advertise and accept the HT40 join */
-	bool sgi;		/* short GI, when the peer advertises it */
-	bool agg;		/* receive A-MPDU in the station record */
-	bool peek;		/* the WHISR peek before the status block */
-};
-
-#define MT6797_TESTCFG_ENTRIES 16U
-#define MT6797_TESTCFG_NAME 32U
-
-/* A schedule entry as written, with its verdict. */
-struct mt6797_testcfg_entry {
-	struct mt6797_testcfg cfg;
-	char name[MT6797_TESTCFG_NAME];
-	const char *refused;	/* NULL when valid */
-};
-
-static inline bool mt6797_testcfg_is(const char *s, size_t n, const char *word)
-{
-	size_t i;
-
-	for (i = 0; word[i]; i++)
-		if (i >= n || s[i] != word[i])
-			return false;
-	return i == n;
-}
-
-/* "x=0" or "x=1" for the word x; -1 when s is not that item. */
-static inline int mt6797_testcfg_flag(const char *s, size_t n, const char *word)
-{
-	size_t w = 0;
-
-	while (word[w])
-		w++;
-	if (n != w + 2 || s[w] != '=' || !mt6797_testcfg_is(s, w, word))
-		return -1;
-	return s[w + 1] == '0' ? 0 : s[w + 1] == '1' ? 1 : -1;
-}
-
-static inline int mt6797_testcfg_hex(char c)
-{
-	return c >= '0' && c <= '9' ? c - '0' :
-	       c >= 'a' && c <= 'f' ? c - 'a' + 10 :
-	       c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
-}
-
-/* One item of an entry: 20M<k> or 40M<k> (HT MCS k at that transmit width),
- * txbw=20|40, rxbw=20|40, rate=fixed:0xNN, rate=minstrel (mac80211's rate
- * control: its width and guard interval too), sgi[=0|1], agg=0|1, peek=0|1,
- * or default (the build). NULL on success, else why the item is refused.
- */
-static inline const char *
-mt6797_testcfg_item(const char *s, size_t n, const struct mt6797_testcfg *base,
-		    struct mt6797_testcfg *c)
-{
-	int v;
-
-	if (n == 4 && (s[0] == '2' || s[0] == '4') && s[1] == '0' && s[2] == 'M' &&
-	    s[3] >= '0' && s[3] <= '7') {
-		c->txbw40 = s[0] == '4';
-		c->rate = 0x80 | (s[3] - '0');
-		c->minstrel = false;
-		return NULL;
-	}
-	if (mt6797_testcfg_is(s, n, "default")) {
-		*c = *base;
-		return NULL;
-	}
-	if (mt6797_testcfg_is(s, n, "sgi")) {
-		c->sgi = true;
-		return NULL;
-	}
-	v = mt6797_testcfg_flag(s, n, "sgi");
-	if (v >= 0) {
-		c->sgi = v;
-		return NULL;
-	}
-	v = mt6797_testcfg_flag(s, n, "agg");
-	if (v >= 0) {
-		c->agg = v;
-		return NULL;
-	}
-	v = mt6797_testcfg_flag(s, n, "peek");
-	if (v >= 0) {
-		c->peek = v;
-		return NULL;
-	}
-	if (mt6797_testcfg_is(s, n, "txbw=20") || mt6797_testcfg_is(s, n, "txbw=40")) {
-		c->txbw40 = s[5] == '4';
-		return NULL;
-	}
-	if (mt6797_testcfg_is(s, n, "rxbw=20") || mt6797_testcfg_is(s, n, "rxbw=40")) {
-		c->rxbw40 = s[5] == '4';
-		return NULL;
-	}
-	if (n >= 3 && mt6797_testcfg_is(s, 3, "bw="))
-		return "bw is txbw or rxbw";
-	if (n > 13 && mt6797_testcfg_is(s, 13, "rate=fixed:0x")) {
-		int hi = mt6797_testcfg_hex(s[13]);
-		int lo = n == 15 ? mt6797_testcfg_hex(s[14]) : 0;
-
-		if (n > 15 || hi < 0 || lo < 0)
-			return "bad rate code";
-		v = n == 15 ? hi << 4 | lo : hi;
-		/* 0 is the firmware's selector, which needs 0277's state 2. */
-		if (!v)
-			return "rate code 0";
-		c->rate = v;
-		c->minstrel = false;
-		return NULL;
-	}
-	if (mt6797_testcfg_is(s, n, "rate=minstrel")) {
-		c->minstrel = true;
-		return NULL;
-	}
-	return "unknown item";
-}
-
-/* One entry: items joined by '+', applied over the build's configuration.
- * NULL on success, else why it is refused; *c is then unspecified.
- */
-static inline const char *
-mt6797_testcfg_entry(const char *s, size_t n, const struct mt6797_testcfg *base,
-		     struct mt6797_testcfg *c)
-{
-	const char *why;
-	size_t i = 0, j;
-
-	*c = *base;
-	if (!n)
-		return "empty entry";
-	while (i <= n) {
-		for (j = i; j < n && s[j] != '+'; j++)
-			;
-		if (j == i)
-			return "empty item";
-		why = mt6797_testcfg_item(s + i, j - i, base, c);
-		if (why)
-			return why;
-		i = j + 1;
-	}
-	/* A 20 MHz association has no 40 MHz transmission. */
-	if (c->txbw40 && !c->rxbw40)
-		return "txbw=40 needs rxbw=40";
-	return NULL;
-}
-
-/* The advertised HT capability information for this lifetime: without
- * rxbw=40, no 20/40 MHz channel width (bit 1) or 40 MHz short GI (bit 6),
- * so mac80211 associates at 20 MHz and the access point sends 20 MHz.
- */
-static inline unsigned short
-mt6797_testcfg_ht_cap(const struct mt6797_testcfg *c, unsigned short cap)
-{
-	return c->rxbw40 ? cap : cap & ~(0x0002 | 0x0040);
-}
-
-/* The join's secondary channel offset for mac80211's width: 3 (below) at
- * 40 MHz, 0 at 20 MHz, and -1, a refused join, at 40 MHz without rxbw=40.
- */
-static inline int mt6797_testcfg_join_sco(const struct mt6797_testcfg *c, bool ht40)
-{
-	return !ht40 ? 0 : c->rxbw40 ? 3 : -1;
-}
-
-static inline bool mt6797_testcfg_space(char c)
-{
-	return c == ' ' || c == '\t' || c == '\n' || c == '\r';
-}
-
-/* A schedule: entries separated by ',', blanks around them ignored. An
- * empty schedule has no entries (the build's configuration for every join).
- * Every entry is kept with its verdict; a refused one is applied as the
- * previous configuration. Returns the entry count, or -1 when there are
- * more than MT6797_TESTCFG_ENTRIES or an entry's name does not fit.
- */
-static inline int
-mt6797_testcfg_schedule(const char *s, size_t n, const struct mt6797_testcfg *base,
-			struct mt6797_testcfg_entry *out)
-{
-	size_t i = 0, j, a, b, k;
-	unsigned int count = 0;
-
-	while (n && mt6797_testcfg_space(s[n - 1]))
-		n--;
-	while (i < n && mt6797_testcfg_space(s[i]))
-		i++;
-	if (i == n)
-		return 0;
-	while (i <= n) {
-		for (j = i; j < n && s[j] != ','; j++)
-			;
-		for (a = i; a < j && mt6797_testcfg_space(s[a]); a++)
-			;
-		for (b = j; b > a && mt6797_testcfg_space(s[b - 1]); b--)
-			;
-		if (count == MT6797_TESTCFG_ENTRIES || b - a >= MT6797_TESTCFG_NAME)
-			return -1;
-		for (k = 0; k < b - a; k++)
-			out[count].name[k] = s[a + k];
-		out[count].name[k] = 0;
-		out[count].refused = mt6797_testcfg_entry(s + a, b - a, base,
-							  &out[count].cfg);
-		count++;
-		i = j + 1;
-	}
-	return count;
-}
-
-#endif
