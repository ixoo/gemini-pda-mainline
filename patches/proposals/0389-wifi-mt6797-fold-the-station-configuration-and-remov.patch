diff --git a/drivers/net/wireless/mediatek/mt6797/action-frame.h b/drivers/net/wireless/mediatek/mt6797/action-frame.h
index 288ec34..88cb92c 100644
--- a/drivers/net/wireless/mediatek/mt6797/action-frame.h
+++ b/drivers/net/wireless/mediatek/mt6797/action-frame.h
@@ -14,181 +14,6 @@ struct mt6797_join_action_frame {
 	unsigned int rcpi;        /* RX vector RCPI (half dB), the keyed beacon only. */
 };
 
-/* The class of received packet that ended runtime 18 at the frame gate after
- * message 4, named there (runtime 16's refused frame shared only its type
- * word and length and was never classified): a 136-byte software-defined
- * frame with type word 0xee01 (the vendor's SW_FRAME type, groups 1 to 3,
- * header at offset 64) whose logged descriptor bytes were 02 28 18 04 01 00
- * 00 e0 (match flags
- * with the unicast-to-me bit only, channel 40, native 24-byte header without
- * padding, payload format 0 with BSSID field 1, WLAN index 1, TID 0 and
- * security mode 0, status 0xe000) and whose frame control was 0x00d0: an
- * unprotected Action frame (type 0, subtype 13) with the target as
- * transmitter and this station as receiver, 72 wire bytes. Its category,
- * body and sequence were not recorded and none is claimed or read here.
- *
- * Runtime 24 (candidate 23, the pairwise key's credit returned and the
- * add-key-done recorded) ended at the frame gate on a frame of the same
- * source-defined class (no body or sequence was retained in either run) with
- * two observed descriptor differences: bytes 02 28 18 04 01 40 04 e0, that is
- * byte 9 0x40 (TID 0, security mode 4) and status 0xe004 where runtime 18,
- * before any key, carried 00 and 0xe000; 136 bytes, groups 1 to 3, header at
- * 64, frame control 0x00d0 (unprotected, Retry clear), receiver this station
- * and transmitter the target (the summary's explicit comparisons). Source
- * meaning of the two fields (pinned public layout): the security mode is the
- * receiving WLAN entry's cipher context, CCMP once the pairwise key is
- * installed under it, and bit 2 of the status word is
- * RX_STATUS_FLAG_CIPHER_MISMATCH, an unprotected frame against a keyed
- * entry; the ICV-error flag is bit 4 and is clear. The category, body,
- * BSSID and sequence were not retained and none is claimed; the decoder
- * compares the BSSID as before.
- *
- * This decoder names exactly that class so the caller can discard it
- * without delivery, in its two measured descriptor variants: byte 9 exactly
- * 0 with status exactly 0xe000 (runtime 18) at every stage the caller admits
- * the class, as before; and byte 9 exactly 0x40 with status exactly 0xe004
- * (runtime 24) only when the caller passes `keyed`, that is, once the
- * pairwise key is installed. The keyed variant before the key is not the
- * class; the unkeyed variant keeps its existing admission after the key, as
- * no measurement asks to withdraw it. An unprotected Action frame flagged as
- * a cipher mismatch is never delivered to mac80211. In the pinned vendor
- * driver the management path drops only ICV errors (under MFP) before
- * dispatching by category; no further vendor behaviour is claimed.
- * The common conditions: the type word exactly 0xee01 (the measured value; the
- * public layout's checksum and Ethernet-type-offset bits in it are zero and
- * no other value is admitted); the match byte exactly 0x02; the descriptor
- * bytes 6 to 11 exactly as measured
- * (24-byte header, no translation, no padding; format 0 with BSSID field 1;
- * WLAN index 1, the station's own index; byte 9 zero; status 0xe000, the
- * same status every admitted management response of this lifetime carries);
- * frame control 0x00d0 with only the Retry bit free (a retransmission of the
- * same frame); receiver this station, transmitter and BSSID the target;
- * fragment number 0; and at least two body bytes after the header (the
- * category and at least one more byte, as every Action frame body the
- * pinned public sources define has; the measured body had 48), none of
- * which is read. Protected frames, Action No Ack and every other subtype,
- * group-addressed frames, other peers, other descriptor values and other
- * status words are not this class and reach the caller's refusal. The
- * discard makes no new host submission; whatever acknowledgment the
- * hardware gives such frames is inherited behaviour, unchanged and not
- * captured.
- */
-static inline bool
-mt6797_join_action_frame(const unsigned char *packet, size_t bytes,
-			 unsigned char channel, const unsigned char own[6],
-			 const unsigned char ap[6], bool keyed,
-			 struct mt6797_join_action_frame *out)
-{
-	struct mt6797_join_action_frame r;
-	const size_t offset = 16 + 16 + 8 + 24;
-	unsigned int type, status;
-	const unsigned char *f;
-
-	if (!packet || !own || !ap || !out || bytes < offset + 26 ||
-	    bytes > 4096 || !channel || mt6797_join_le16(packet) != bytes ||
-	    packet[5] != channel)
-		return false;
-	type = mt6797_join_le16(packet + 2);
-	if (type != 0xee01)
-		return false;
-	r.match = packet[4];
-	status = mt6797_join_le16(packet + 10);
-	if (r.match != 0x02 || packet[6] != 24 || packet[7] != 0x04 ||
-	    packet[8] != 1)
-		return false;
-	/* The two measured variants, each exactly: unkeyed (byte 9 = 0, status
-	 * 0xe000) always; keyed (0x40, 0xe004) only once the pairwise key is
-	 * installed. Mixed pairs and every other value are not the class.
-	 */
-	if (!((packet[9] == 0 && status == 0xe000) ||
-	      (keyed && packet[9] == 0x40 && status == 0xe004)))
-		return false;
-	f = packet + offset;
-	r.fc = mt6797_join_le16(f);
-	if ((r.fc & 0xf7ff) != 0x00d0)
-		return false;
-	if (memcmp(f + 4, own, 6) || memcmp(f + 10, ap, 6) || memcmp(f + 16, ap, 6) ||
-	    (mt6797_join_le16(f + 22) & 15))
-		return false;
-	r.bytes = bytes - offset;
-	r.status = mt6797_join_le16(packet + 10);
-	r.wlan = packet[8];
-	r.bss = packet[7] >> 2;
-	r.sec = packet[9] >> 4;
-	*out = r;
-	return true;
-}
-
-/* Runtime 21 ended at the frame gate after message 4 on a clear Action frame
- * whose descriptor the firmware filled with the broadcast match flag and no
- * station index. Observed (sanitized diagnostic: the descriptor bytes 4 to
- * 11, the group set, the header offset and the first payload byte only):
- * 708 packet bytes in all, that is a 16-byte descriptor, groups 1 to 3 (48
- * bytes, no group 4) and 644 wire bytes at offset 64; type word 0xee01;
- * descriptor bytes 08 28 18 3c ff 00 00 e0 (match flags with the broadcast
- * bit only, channel 40, native 24-byte header without padding or
- * translation, payload format 0 with BSSID field 15, WLAN index 255, TID 0
- * and security mode 0, status 0xe000); frame control first byte 0xd0. The
- * transmitter, BSSID, sequence, category and body were not retained, and
- * nothing is claimed about the sender or the category.
- *
- * Source-defined meaning of the observed fields (pinned vendor driver): the
- * WLAN index selects the 32-entry WLAN table and secGetStaIdxByWlanIdx
- * returns "no station" for any index at or above it, so 255 names no table
- * entry; what the vendor then does with such an Action frame depends on a
- * lookup by transmitter and on the category, neither retained, so no
- * vendor behaviour is claimed beyond that lookup. BSSID field 15 is the
- * value the pre-activation EAPOL frames also carried; its meaning is not
- * known and none is claimed.
- *
- * This decoder names exactly that class so the caller can discard it
- * without delivery and without a new host submission, at any stage of the
- * lifetime. Observed conditions: type word exactly 0xee01; match byte
- * exactly 0x08 (the broadcast bit alone; the multicast and unicast-to-me
- * bits are not admitted); descriptor bytes 6 to 11 exactly 18 3c ff 00 00
- * e0; frame control first byte 0xd0. Source-defined conditions not in the
- * diagnostic: frame control 0x00d0 with only the Retry bit free (type 0,
- * subtype 13, unprotected); the broadcast receiver address, which the
- * descriptor layout's broadcast match flag denotes; fragment number 0; at
- * least two body bytes after the header, none read. The transmitter and
- * BSSID fields are not compared, because the descriptor names no station
- * entry to compare against. Protected frames, Action No Ack, other
- * subtypes, directed or multicast frames, any WLAN index below 255, other
- * descriptor values and other status words are not this class and reach
- * the caller's refusal.
- */
-static inline bool
-mt6797_join_group_action_frame(const unsigned char *packet, size_t bytes,
-			       unsigned char channel,
-			       struct mt6797_join_action_frame *out)
-{
-	static const unsigned char broadcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
-	struct mt6797_join_action_frame r;
-	const size_t offset = 16 + 16 + 8 + 24;
-	const unsigned char *f;
-
-	if (!packet || !out || bytes < offset + 26 || bytes > 4096 || !channel ||
-	    mt6797_join_le16(packet) != bytes || packet[5] != channel ||
-	    mt6797_join_le16(packet + 2) != 0xee01)
-		return false;
-	r.match = packet[4];
-	if (r.match != 0x08 || packet[6] != 24 || packet[7] != 0x3c ||
-	    packet[8] != 255 || packet[9] || mt6797_join_le16(packet + 10) != 0xe000)
-		return false;
-	f = packet + offset;
-	r.fc = mt6797_join_le16(f);
-	if ((r.fc & 0xf7ff) != 0x00d0 || memcmp(f + 4, broadcast, 6) ||
-	    (mt6797_join_le16(f + 22) & 15))
-		return false;
-	r.bytes = bytes - offset;
-	r.status = 0xe000;
-	r.wlan = 255;
-	r.bss = packet[7] >> 2;
-	r.sec = 0;
-	*out = r;
-	return true;
-}
-
 /* Runtime 26 (candidate 25, the group key installed under the station's
  * declared broadcast WLAN entry) ended at the frame gate, before any data
  * frame, on a packet of the target's beacon class in a keyed descriptor
diff --git a/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h b/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h
index 1c514fc..3af25f4 100644
--- a/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h
+++ b/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h
@@ -7,11 +7,7 @@
 /* QoS data (subtype bit 0x0080) with QoS control 0, TID 0 and normal
  * acknowledgment, admitted only with WMM negotiated (0284); 0 otherwise.
  */
-#ifdef CONFIG_MT6797_WMM_QOS_DATA
 #define MT6797_CCMP_RX_QOS_BIT 0x0080U
-#else
-#define MT6797_CCMP_RX_QOS_BIT 0U
-#endif
 
 /* CCMP keeps one replay counter per TID, and mac80211 keeps them so
  * (rx_pn[tid]): a frame is checked against its own TID's counter and
@@ -76,10 +72,8 @@ struct mt6797_ccmp_rx {
  */
 static inline bool mt6797_ccmp_rx_status_ok(unsigned int status)
 {
-#ifdef CONFIG_MT6797_RX_AMPDU
 	if (!(status & 0xffbf))
 		return true;
-#endif
 	return status == 0xc000;
 }
 
diff --git a/drivers/net/wireless/mediatek/mt6797/data-rx.h b/drivers/net/wireless/mediatek/mt6797/data-rx.h
index 99bca96..f8f041d 100644
--- a/drivers/net/wireless/mediatek/mt6797/data-rx.h
+++ b/drivers/net/wireless/mediatek/mt6797/data-rx.h
@@ -17,35 +17,6 @@ struct mt6797_data_rx {
 	unsigned char group_vld;   /* The 4-bit GROUP_VLD mask as decoded (bit 0 is group 1). */
 };
 
-/* The first receive-vector word of a gen3 RXD when group 3 is present (the
- * pinned nic_rx.h: RX_VT_RX_RATE bits 0-6, RX_VT_RX_MODE bits 12-14), walked
- * in the source order group 4, 1, 2, 3 from the 16-byte base; false when
- * the group is absent or the packet is too short. Recorded, never decided on.
- */
-static inline bool
-mt6797_rx_vector_word(const unsigned char *packet, size_t bytes, unsigned int *word)
-{
-	size_t offset = 16;
-	unsigned int groups;
-
-	if (!packet || !word || bytes < 16)
-		return false;
-	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
-	if (!(groups & 4))
-		return false;
-	if (groups & 8)
-		offset += 16;
-	if (groups & 1)
-		offset += 16;
-	if (groups & 2)
-		offset += 8;
-	if (offset + 4 > bytes)
-		return false;
-	*word = mt6797_join_le16(packet + offset) |
-		((unsigned int)mt6797_join_le16(packet + offset + 2) << 16);
-	return true;
-}
-
 /* Original decoder of one protected, firmware-decrypted, translated data
  * frame of the public gen3 RXD layout for a legacy non-QoS station, the two
  * classes the reference run 3 ledger holds and the pinned nic_rx.h defines:
@@ -259,152 +230,4 @@ mt6797_data_rx_llc_mismatch(const unsigned char *packet, size_t bytes,
 	return true;
 }
 
-/* Strict native (untranslated, still-encrypted) view of the SAME pinned gen3 RXD
- * (nic_rx.h), for the default-off native-crypto-delivery diagnostic (0181). It
- * reuses the exact group walk and the BIT(6) header-offset pad of mt6797_data_rx
- * and derives the NATIVE-class gates rather than assuming the translated ones:
- *   - header translation OFF  (ucHeaderLen BIT7 clear; the translated decoder
- *     requires it SET) -- this is the native-vs-translated discriminator;
- *   - CCMP derived from the ORIGINAL MPDU (Protected + CCMP Ext-IV), not the
- *     descriptor security-mode field.
- * It does NOT copy the translated class's constants (header length 14, ucBssid
- * 0x04, status 0xc000). It then locates the ORIGINAL 802.11 MPDU at the
- * post-group offset and validates it as a protected CCMP data frame from the AP
- * (version 0, type data, Protected set, FromDS and not ToDS, BSSID/TA == ap,
- * addr1 == own for unicast or group-addressed, a plausible header length and the
- * CCMP Ext-IV set, with room for the CCMP header and the 8-byte MIC). On success
- * it returns the MPDU offset and length; authentication is NOT claimed here --
- * the original protected MPDU is handed to standard mac80211, whose CCMP AEAD,
- * MIC and replay check authenticate it. Every translated, plain, non-CCMP,
- * non-peer, short or malformed ordinary frame is withheld (returns false).
- */
-/* First failed eligibility gate, not an authentication or firmware verdict. */
-enum mt6797_native_rx_gate {
-	MT6797_NATIVE_RX_OK,
-	MT6797_NATIVE_RX_INPUT,
-	MT6797_NATIVE_RX_LENGTH,
-	MT6797_NATIVE_RX_TYPE,
-	MT6797_NATIVE_RX_CHANNEL,
-	MT6797_NATIVE_RX_TRANSLATED,
-	MT6797_NATIVE_RX_MSDU,
-	MT6797_NATIVE_RX_FCS,
-	MT6797_NATIVE_RX_HEADER,
-	MT6797_NATIVE_RX_SPAN,
-	MT6797_NATIVE_RX_FRAME_TYPE,
-	MT6797_NATIVE_RX_UNPROTECTED,
-	MT6797_NATIVE_RX_DS,
-	MT6797_NATIVE_RX_FRAME_SHAPE,
-	MT6797_NATIVE_RX_PEER,
-	MT6797_NATIVE_RX_DESTINATION,
-	MT6797_NATIVE_RX_CCMP_SHAPE,
-	MT6797_NATIVE_RX_GATES,
-};
-
-static inline enum mt6797_native_rx_gate
-mt6797_data_rx_native_gate(const unsigned char *packet, size_t bytes,
-			   unsigned char channel, const unsigned char own[6],
-			   const unsigned char ap[6], size_t *mpdu_off,
-			   size_t *mpdu_len)
-{
-	size_t offset = 16;
-	unsigned int groups, fc, hdrlen, subtype, i;
-	const unsigned char *m;
-
-	if (!packet || !own || !ap || !mpdu_off || !mpdu_len ||
-	    bytes < 16 || bytes > 4096 || !channel)
-		return MT6797_NATIVE_RX_INPUT;
-	if (mt6797_join_le16(packet) != bytes)
-		return MT6797_NATIVE_RX_LENGTH;
-	if ((mt6797_join_le16(packet + 2) >> 13) != 2)
-		return MT6797_NATIVE_RX_TYPE;
-	if (packet[5] != channel)
-		return MT6797_NATIVE_RX_CHANNEL;
-	if (packet[6] & 0x80)				/* header translation OFF */
-		return MT6797_NATIVE_RX_TRANSLATED;
-	if (packet[7] & 0x03)				/* MSDU0 (no AMSDU subframe) */
-		return MT6797_NATIVE_RX_MSDU;
-	/* No reliance on the descriptor security-mode/error fields (a translated-
-	 * decrypted shape); CCMP is derived from the original MPDU below.
-	 */
-	/* Conservative, clearly-labeled filter (NOT the authentication bar): a frame
-	 * the hardware flags bad-FCS (HAL_RX_STATUS_IS_FCS_ERROR == u2StatusFlag
-	 * bit1, le16(packet+10) & 0x0002; nicRxProcessMonitorPacket only marks
-	 * radiotap bad-FCS, it does not drop) is unlikely to authenticate; a reported
-	 * bad FCS does not logically preclude a valid MIC, so this is a CONSERVATIVE
-	 * metadata filter, not an authentication decision. No tail-FCS byte is
-	 * stripped; the MPDU below is delivered verbatim and mac80211
-	 * authenticates.
-	 */
-	if (mt6797_join_le16(packet + 10) & 0x0002)
-		return MT6797_NATIVE_RX_FCS;
-	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
-	/* The source walk (nicRxFillRFB) adds any present status groups in 4/1/2/3
-	 * order, then the BIT(6) header-offset pad; group 4's presence is NOT the
-	 * translation gate (BIT7 above is), so a present group 4 is skipped by its
-	 * size and the actual MPDU is validated below -- it is never used to
-	 * reconstruct the header for this native path.
-	 */
-	if (groups & 8)
-		offset += 16;				/* group 4 */
-	if (groups & 1)
-		offset += 16;				/* group 1 (PN) */
-	if (groups & 2)
-		offset += 8;					/* group 2: timestamp/CRC */
-	if (groups & 4)
-		offset += 24;				/* group 3 (vector) */
-	if (packet[6] & 0x40)
-		offset += 2;					/* BIT(6) header-offset pad */
-	hdrlen = packet[6] & 0x3f;				/* reported 802.11 header length */
-	if (hdrlen != 24 && hdrlen != 26)
-		return MT6797_NATIVE_RX_HEADER;
-	if (offset > bytes || bytes - offset < hdrlen + 8 + 8)	/* + CCMP header + MIC */
-		return MT6797_NATIVE_RX_SPAN;
-	m = packet + offset;
-	fc = mt6797_join_le16(m);
-	subtype = (fc >> 4) & 15;
-	if ((fc & 3) != 0 || (fc & 0x0c) != 0x08)		/* version 0, type data */
-		return MT6797_NATIVE_RX_FRAME_TYPE;
-	if ((fc & 0x4000) == 0)				/* Protected */
-		return MT6797_NATIVE_RX_UNPROTECTED;
-	if ((fc & 0x0300) != 0x0200)			/* FromDS, not ToDS */
