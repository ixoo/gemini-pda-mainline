@@ -1,244 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0-only
-/* The per-join test surface (CONFIG_MT6797_WIFI_TESTCONFIG). The harness
- * cycles the association; each join takes the next schedule entry, and each
- * data phase end appends that lifetime's measurements. No device access.
- */
-#include <linux/debugfs.h>
-#include <linux/err.h>
-#include <linux/fs.h>
-#include <linux/kernel.h>
-#include <linux/mutex.h>
-#include <linux/slab.h>
-#include <linux/string.h>
-#include <linux/uaccess.h>
-
-#include "testcfg.h"
-
-#define MT6797_TESTCFG_LINES 16U
-#define MT6797_TESTCFG_APPLIED 160U
-#define MT6797_TESTCFG_STATS 448U
-#define MT6797_TESTCFG_TEXT 512U
-
-struct mt6797_testcfg_state {
-	struct mutex lock;	/* everything below */
-	struct dentry *dir;
-	struct mt6797_testcfg build, last;
-	struct mt6797_testcfg_entry entries[MT6797_TESTCFG_ENTRIES];
-	unsigned int count, next, lifetime;
-	/* applied and not yet measured; the previous one not ok */
-	bool pending, recover;
-	char name[MT6797_TESTCFG_NAME];
-	char schedule[MT6797_TESTCFG_TEXT];
-	char applied[MT6797_TESTCFG_LINES][MT6797_TESTCFG_APPLIED];
-	char stats[MT6797_TESTCFG_LINES][MT6797_TESTCFG_STATS];
-	unsigned int applied_n, stats_n, dropped;
-};
-
-static void mt6797_testcfg_rewind(struct mt6797_testcfg_state *t)
-{
-	t->next = 0;
-	t->pending = false;
-	t->recover = false;
-	t->last = t->build;
-	t->applied_n = 0;
-	t->stats_n = 0;
-	t->dropped = 0;
-}
-
-void mt6797_testcfg_next(struct mt6797_testcfg_state *t, unsigned int lifetime,
-			 struct mt6797_testcfg *cfg, char *line, size_t bytes)
-{
-	const struct mt6797_testcfg_entry *e = NULL;
-	const char *source;
-	unsigned int index = 0;
-
-	mutex_lock(&t->lock);
-	/* A lifetime applied but never measured ended before its data phase. */
-	if (t->pending)
-		t->recover = true;
-	if (!t->count) {
-		*cfg = t->build;
-		source = "build";
-	} else if (t->recover) {
