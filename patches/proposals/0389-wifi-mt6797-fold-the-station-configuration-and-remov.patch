-/* SPDX-License-Identifier: GPL-2.0-only */
-#ifndef MT6797_STP_FULL_STREAM_H
-#define MT6797_STP_FULL_STREAM_H
-#include "stp-full.h"
-
-/*
- * Owner-held persistent storage, never a kernel stack allocation. Consume the
- * completed payload before resetting storage for the next frame. Link sequence
- * and ACK state are separate and must not be reset at these frame boundaries.
- */
-struct stp_full_stream {
-	unsigned char frame[STP_FULL_MAX_FRAME];
-	unsigned int used, needed;
-	int terminal;
-};
-
-static inline void stp_full_stream_init(struct stp_full_stream *stream)
-{
-	stream->used = 0;
-	stream->needed = 4;
-	stream->terminal = 0;
-}
-
-/*
- * Incomplete=0, ACK=1, data=2, terminal refusal=-1. Aggregate frame/byte/time
- * budgets and task delivery belong to the shared owner, not individual tasks.
- */
-static inline int stp_full_stream_byte(struct stp_full_stream *stream,
-				       unsigned char byte, struct stp_full_frame *result)
-{
-	unsigned int length;
-	int kind;
-
-	if (!stream || !result)
-		return -1;
-	if (stream->terminal || stream->used >= sizeof(stream->frame))
-		goto refuse;
-	stream->frame[stream->used++] = byte;
-	if (stream->used == 4) {
-		if (stp_full_header(stream->frame, stream->used, &length))
-			goto refuse;
-		stream->needed = length ? length + 6 : 4;
-	}
-	if (stream->used < stream->needed)
-		return 0;
-	kind = stp_full_decode(stream->frame, stream->used, result);
-	if (kind < 0)
-		goto refuse;
-	stream->terminal = 1;
-	return kind + 1;
-refuse:
-	stream->terminal = -1;
-	return -1;
-}
-#endif
