+
+static int mt6797_mac_load_record(struct mt6797_mac *mac,
+				  const struct mt6797_wifi_record *record)
+{
+	const struct mt6797_record_commands *commands;
+	struct mt6797_regulatory_payloads policy;
+	int ret;
+
+	ASSERT_RTNL();
+	commands = mt6797_wifi_record_commands(record);
+	ret = mt6797_mac_policy(mac, &policy);
+	if (ret)
+		return ret;
+	if (commands->base_power) {
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_TX_PWR,
+				      commands->base_power_bytes,
+				      sizeof(commands->base_power_bytes));
+		if (ret)
+			return ret;
+	}
+	if (commands->edge_5g) {
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_EDGE_5G,
+				      commands->edge_5g_bytes,
+				      sizeof(commands->edge_5g_bytes));
+		if (ret)
+			return ret;
+	}
+	if (commands->ac_5g) {
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_AC_PWR,
+				      commands->ac_5g_bytes,
+				      sizeof(commands->ac_5g_bytes));
+		if (ret)
+			return ret;
+	}
+	ret = mt6797_mac_domains(mac, &policy);
+	if (ret)
+		return ret;
+	/* The retained firmware's mapped normal table has no CID 0x49.
+	 * Do not replay the newer host's country-power table or claim its
+	 * enforcement. Apply supported per-channel CID 0x38 after NVRAM.
+	 */
+	if (commands->edge_2g) {
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_EDGE_2G,
+				      commands->edge_2g_bytes,
+				      sizeof(commands->edge_2g_bytes));
+		if (ret)
+			return ret;
+	}
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_NVRAM_SETTINGS,
+			      mt6797_wifi_record_data(record), 512);
+	if (!ret)
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_TX_CTRL,
+				      policy.power, sizeof(policy.power));
+	if (!ret)
+		mac->configured = true;
+	return ret;
+}
+
+static int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
+			       const struct mt6797_normal_capability *capability,
+			       const struct mt6797_wifi_record *record, bool reattach,
+			       struct ieee80211_hw **out)
+{
+	static const int bitrates[] = {
+		10, 20, 55, 110, 60, 90, 120, 180, 240, 360, 480, 540,
+	};
+	static const u16 codes[] = MT6797_LEGACY_RATE_CODES;
+	struct ieee80211_hw *hw;
+	struct mt6797_mac *mac;
+	const u8 *data;
+	unsigned int i;
+	bool enable_5g;
+	int sequence = 5;
+	int ret;
+
+	if (!out)
+		return -EINVAL;
+	*out = NULL;
+	if (!dev || !hif || !capability || !record)
+		return -EINVAL;
+	if (capability->product != 0x6797 || capability->firmware_own != 0x0403 ||
+	    capability->firmware_peer || capability->rf_cal_fail ||
+	    capability->bb_cal_fail || !mt6797_wifi_record_commands(record))
+		return -EOPNOTSUPP;
+	data = mt6797_wifi_record_data(record);
+	if (!data || !is_valid_ether_addr(data + 4))
+		return -EINVAL;
+	/* Validated record support/enable bytes and the firmware hardware gate. */
+	enable_5g = !capability->hw_5g_disabled && data[197] && data[262];
+	/* The boot's sequence history refuses reuse: a re-attach continues it. */
+	if (reattach) {
+		sequence = mt6797_hif_next_sequence(hif);
+		if (sequence < 0)
+			return sequence;
+		sequence = max(sequence, 5);
+	}
+	hw = ieee80211_alloc_hw(sizeof(*mac), &mt6797_mac_ops);
+	if (!hw)
+		return -ENOMEM;
+	mac = hw->priv;
+	mac->hif = hif;
+	mac->sequence = sequence;
+	memcpy(mac->alpha2, "00", 2);
+	mutex_init(&mac->mutex);
+	mac->hw = hw;
+	INIT_DELAYED_WORK(&mac->scan_work, mt6797_mac_scan_work);
+	skb_queue_head_init(&mac->join_queue);
+	skb_queue_head_init(&mac->credit_retired_queue);
+	INIT_DELAYED_WORK(&mac->join_work, mt6797_mac_join_work);
+	mac->join_next_pid = 1;
+	mac->ccmp_pid_pool.next = 1;
+	init_completion(&mac->join_channel_done);
+	init_completion(&mac->join_sta_done);
+	init_completion(&mac->join_credit_done);
+	init_completion(&mac->join_frame_done);
+	mutex_init(&mac->ccmp_receive_mutex);
+	init_completion(&mac->ccmp_key_done);
+	init_completion(&mac->ccmp_cleanup_done);
+	init_completion(&mac->ccmp_dtim_done);
+	hw->wiphy->cipher_suites = mt6797_ccmp_ciphers;
+	hw->wiphy->n_cipher_suites = ARRAY_SIZE(mt6797_ccmp_ciphers);
+	ieee80211_hw_set(hw, SUPPORTS_RX_DECAP_OFFLOAD);
+	ieee80211_hw_set(hw, SW_CRYPTO_CONTROL);
+	/* This bounded lane requires PM connection credit before keys and
+	 * reports an unusable live lifetime through connection_loss.
+	 * Normal profiles do not advertise this experimental ownership.
+	 */
+	ieee80211_hw_set(hw, CONNECTION_MONITOR);
+	hw->wiphy->max_scan_ssids = 0;
+	/* Userspace may attach elements to a scan request (the standard
+	 * supplicant always does); with a hw_scan operation mac80211 keeps a
+	 * zero limit, and cfg80211 would then reject every such request. The
+	 * one admitted scan is passive and transmits no probe request, so the
+	 * elements are accepted here and never read; mac80211 subtracts its own.
+	 */
+	hw->wiphy->max_scan_ie_len = 256;
+	ieee80211_hw_set(hw, SIGNAL_DBM);
+	SET_IEEE80211_DEV(hw, dev);
+	SET_IEEE80211_PERM_ADDR(hw, data + 4);
+	ieee80211_hw_set(hw, NO_AUTO_VIF);
+	hw->queues = 4;
+	ieee80211_hw_set(hw, REPORTS_TX_ACK_STATUS);
+	hw->wiphy->interface_modes = BIT(NL80211_IFTYPE_STATION);
+	hw->wiphy->reg_notifier = mt6797_mac_regulatory;
+	/* No private country hint, custom regdomain or self-managed flag. */
+	for (i = 0; i < MT6797_CHANNELS; i++) {
+		mac->channels[i].band = i < MT6797_2G_CHANNELS ?
+			NL80211_BAND_2GHZ : NL80211_BAND_5GHZ;
+		mac->channels[i].hw_value = mt6797_channel_number(i);
+		mac->channels[i].center_freq = i < MT6797_2G_CHANNELS ?
+			2412 + 5 * i : 5000 + 5 * mac->channels[i].hw_value;
+		/* Conservative initial driver ceiling, not measured RF output. */
+		mac->channels[i].max_power = 20;
+		mac->channels[i].flags = IEEE80211_CHAN_NO_HT40 |
+			IEEE80211_CHAN_NO_80MHZ | IEEE80211_CHAN_NO_160MHZ;
+		/* 5 GHz pairs 36/40 and 44/48 (0323); 2.4 GHz stays 20 MHz. */
+		if (i >= MT6797_2G_CHANNELS)
+			mac->channels[i].flags ^= (i - MT6797_2G_CHANNELS) % 2 ?
+				IEEE80211_CHAN_NO_HT40MINUS : IEEE80211_CHAN_NO_HT40PLUS;
+		if (i >= MT6797_2G_CHANNELS && !enable_5g)
+			mac->channels[i].flags |= IEEE80211_CHAN_DISABLED;
+	}
+	for (i = 0; i < ARRAY_SIZE(bitrates); i++) {
+		mac->rates[i].bitrate = bitrates[i];
+		mac->rates[i].hw_value = codes[i];
+	}
+	/* One rate per ordinary data frame, at the descriptor's three attempts. */
+	hw->max_rates = 1;
+	hw->max_rate_tries = 3;
+	mac->band.band = NL80211_BAND_2GHZ;
+	mac->band.channels = mac->channels;
+	mac->band.n_channels = MT6797_2G_CHANNELS;
+	mac->band.bitrates = mac->rates;
+	mac->band.n_bitrates = ARRAY_SIZE(mac->rates);
+	hw->wiphy->bands[NL80211_BAND_2GHZ] = &mac->band;
+	if (enable_5g) {
+		mac->band_5g.band = NL80211_BAND_5GHZ;
+		mac->band_5g.channels = mac->channels + MT6797_2G_CHANNELS;
+		mac->band_5g.n_channels = MT6797_5G_CHANNELS;
+		/* 5 GHz has the eight legacy OFDM rates, never CCK rates. */
+		mac->band_5g.bitrates = mac->rates + 4;
+		mac->band_5g.n_bitrates = ARRAY_SIZE(mac->rates) - 4;
+		mac->band_5g.ht_cap.ht_supported = true;
+		mac->band_5g.ht_cap.cap = MT6797_HT_CAP_INFO;
+		mac->band_5g.ht_cap.ampdu_factor = IEEE80211_HT_MAX_AMPDU_8K;
+		mac->band_5g.ht_cap.ampdu_density = IEEE80211_HT_MPDU_DENSITY_8;
+		mac->band_5g.ht_cap.mcs.rx_mask[0] = 0xff;
+		mac->band_5g.ht_cap.mcs.tx_params = IEEE80211_HT_MCS_TX_DEFINED;
+		hw->wiphy->bands[NL80211_BAND_5GHZ] = &mac->band_5g;
+	}
+	ret = ieee80211_register_hw(hw);
+	if (ret)
+		goto free_hw;
+	/* Serialize with cfg80211's global channel updates, including a
+	 * notifier arriving between registration and this initial sequence.
+	 */
+	rtnl_lock();
+	mutex_lock(&mac->mutex);
+	/* A re-attach finds the firmware configured; never replay the record. */
+	if (reattach) {
+		mac->configured = true;
+		ret = 0;
+	} else {
+		ret = mt6797_mac_load_record(mac, record);
+	}
+	if (ret) {
+		mac->first_error = ret;
+		mac->closing = true;
+	}
+	mutex_unlock(&mac->mutex);
+	rtnl_unlock();
+	if (ret) {
+		ieee80211_unregister_hw(hw);
+		goto free_hw;
+	}
+	*out = hw;
+	return 0;
+free_hw:
+	ieee80211_free_hw(hw);
+	return ret;
+}
+
+static void mt6797_mac_scan_ready(struct ieee80211_hw *hw)
+{
+	struct mt6797_mac *mac = hw->priv;
+
+	mutex_lock(&mac->mutex);
+	if (mac->configured && !mac->closing && !mac->first_error)
+		mac->scan_ready = true;
+	mutex_unlock(&mac->mutex);
+}
+
+/* The reverse of mt6797_mac_register(). Unregistering stops the hardware,
+ * which closes any join and cancels the scan; the rest is host state.
+ */
+static void mt6797_mac_unregister(struct ieee80211_hw *hw)
+{
+	struct mt6797_mac *mac = hw->priv;
+
+	ieee80211_unregister_hw(hw);
+	cancel_delayed_work_sync(&mac->scan_work);
+	cancel_delayed_work_sync(&mac->join_work);
+	skb_queue_purge(&mac->join_queue);
+	skb_queue_purge(&mac->credit_retired_queue);
+	ieee80211_free_hw(hw);
+}
+
+const struct mt6797_mac_ops mt6797_mac_attach_ops = {
+	.reg = mt6797_mac_register,
+	.scan_ready = mt6797_mac_scan_ready,
+	.unreg = mt6797_mac_unregister,
+};
+
+#if IS_MODULE(CONFIG_MT6797_MAC80211)
+
+static int __init mt6797_mac_module_init(void)
+{
+	return mt6797_consys_wlan_attach(&mt6797_mac_attach_ops);
+}
+
+module_init(mt6797_mac_module_init);
+
+static void __exit mt6797_mac_module_exit(void)
+{
+	mt6797_consys_wlan_detach(&mt6797_mac_attach_ops);
+}
+
+module_exit(mt6797_mac_module_exit);
+
+MODULE_DESCRIPTION("MT6797 WLAN mac80211 station driver");
+
+MODULE_LICENSE("GPL");
+
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/mcu.h b/drivers/net/wireless/mediatek/mt6797/mcu.h
new file mode 100644
index 000000000..07504ad80
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/mcu.h
@@ -0,0 +1,1210 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_MCU_H
+#define MT6797_MCU_H
+
+#include "hif-init.h"
+
+/* Original bounded normal-command helpers. */
+
+#define MT6797_NORMAL_CAP_BYTES 124U
+#define MT6797_NORMAL_NVRAM_BYTES 520U
+
+enum mt6797_normal_kind { MT6797_NORMAL_CAPABILITY, MT6797_NORMAL_NVRAM };
+/* Selected configuration sets and the bounded passive-scan command owner. */
+enum mt6797_normal_config_kind {
+	MT6797_NORMAL_SCAN_V2 = 0x03,
+	MT6797_NORMAL_NIC_POWER_CTRL = 0x04,
+	MT6797_NORMAL_SCAN_BROADCAST = 0x0a,
+	MT6797_NORMAL_BSS_ACTIVE = 0x11,
+	MT6797_NORMAL_SCAN_CANCEL = 0x1b,
+	MT6797_NORMAL_DOMAIN = 0x0f,
+	MT6797_NORMAL_TX_PWR = 0x24,
+	MT6797_NORMAL_EDGE_2G = 0x36,
+	MT6797_NORMAL_TX_CTRL = 0x38,
+	MT6797_NORMAL_EDGE_5G = 0x40,
+	MT6797_NORMAL_CHANNEL_OFFSET = 0x41,
+	MT6797_NORMAL_AC_PWR = 0x42,
+	MT6797_NORMAL_RSSI = 0x43,
+	MT6797_NORMAL_NVRAM_SETTINGS = 0x48,
+	MT6797_NORMAL_COUNTRY_POWER = 0x49,
+};
+
+enum mt6797_normal_phase {
+	MT6797_NORMAL_COLD, MT6797_NORMAL_IDLE, MT6797_NORMAL_CAP_TX,
+	MT6797_NORMAL_CAP_WAIT, MT6797_NORMAL_CAP_RECEIVED,
+	MT6797_NORMAL_CONFIG_TX,
+	MT6797_NORMAL_NVRAM_TX, MT6797_NORMAL_NVRAM_SUBMITTED,
+	MT6797_NORMAL_FAILED,
+};
+
+struct mt6797_normal_transaction {
+	enum mt6797_normal_phase phase, config_return_phase;
+	unsigned int tc4_limit, tc4_free, expected_sequence;
+	unsigned int tc4_pending_cpu, tc4_pending_ffa;
+	unsigned int cleanup_retained_pages;
+	/* Phase C3 data pool on TC1 (the pinned AC1 queue, HIF TX index 1): a
+	 * declared host budget, one frame in flight, released by the AC1 count
+	 * matched against the shared free-for-all pool like TC4's CPU count.
+	 * Zero limit means no data pool was admitted.
+	 */
+	unsigned int tc1_limit, tc1_free, tc1_pending;
+	/* Shared adapter-session history, including INIT. Never cleared here. */
+	unsigned char *used_sequences;
+};
+
+struct mt6797_normal_release {
+	unsigned int released_pages, tc4_free, pending_cpu, pending_ffa;
+	unsigned int tc1_released, tc1_free, pending_ac1;
+};
+
+/* No MAC, date string or raw event is copied into this result. */
+struct mt6797_normal_capability {
+	unsigned int product, firmware_own, firmware_peer;
+	unsigned int hw_5g_disabled, eeprom_used, rf_cal_fail, bb_cal_fail;
+};
+
+static inline unsigned int mt6797_normal_le16(const unsigned char *p)
+{
+	return (unsigned int)p[0] | ((unsigned int)p[1] << 8);
+}
+
+static inline int mt6797_normal_abort(struct mt6797_normal_transaction *t)
+{
+	if (!t)
+		return -EINVAL;
+	t->phase = MT6797_NORMAL_FAILED;
+	return -EIO;
+}
+
+/* Only the actual post-START resource owner may supply these normal-TC4 facts.
+ * No default quota, hardware reset or INIT-credit reuse is provided.
+ * history must cover 32 bytes and outlive this serialized bounded transaction.
+ */
+static inline int
+mt6797_normal_admit(struct mt6797_normal_transaction *t, unsigned int limit,
+		    unsigned int available, unsigned char *history)
+{
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_COLD)
+		return mt6797_normal_abort(t);
+	if (!history || !limit || limit > 0xffffU || available > limit)
+		return -EINVAL;
+	t->tc4_limit = limit;
+	t->tc4_free = available;
+	t->tc4_pending_cpu = 0;
+	t->tc4_pending_ffa = 0;
+	t->cleanup_retained_pages = 0;
+	t->used_sequences = history;
+	t->phase = MT6797_NORMAL_IDLE;
+	return 0;
+}
+
+/* Admit the TC1 data pool after the TC4 admission; refused twice or empty. */
+static inline int
+mt6797_normal_admit_tc1(struct mt6797_normal_transaction *t, unsigned int limit,
+			unsigned int available)
+{
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_IDLE || t->tc1_limit)
+		return mt6797_normal_abort(t);
+	if (!limit || limit > 0xffffU || available > limit)
+		return -EINVAL;
+	t->tc1_limit = limit;
+	t->tc1_free = available;
+	t->tc1_pending = 0;
+	return 0;
+}
+
+/* Caller supplies one fresh, complete consumable WTQCR0..7 snapshot under
+ * the same exclusive owner as command submission. CPU/TC4, AC1/TC1 and FFA
+ * are attributable here (pinned nicTxReleaseResource: each queue's released
+ * count accrues to its TC, and the free-for-all count is the pool that turns
+ * accrued counts into free pages, every TC fulfilled when the pool suffices,
+ * round-robin otherwise). Release the minimum of each TC's accrued count and
+ * the pool, TC4 first then TC1 when the pool is scarce, a chosen deterministic
+ * order; the remainders stay pending for the next snapshot. No speculative
+ * extra-TX completion or reset. No pages beyond a debit may enter a pending
+ * counter; every other queue's count must be zero.
+ */
+static inline int
+mt6797_normal_reconcile(struct mt6797_normal_transaction *t,
+			const unsigned int *words,
+			struct mt6797_normal_release *result)
+{
+	unsigned int i, debt, cpu, ffa, released, ac1, tc1_debt, released1;
+
+	if (result)
+		*result = (struct mt6797_normal_release){0};
+	if (!t || !words || !result)
+		return -EINVAL;
+	if ((t->phase != MT6797_NORMAL_CAP_RECEIVED &&
+	     t->phase != MT6797_NORMAL_NVRAM_SUBMITTED) ||
+	    !t->used_sequences || !t->tc4_limit || t->tc4_limit > 0xffffU ||
+	    t->tc4_free > t->tc4_limit)
+		return mt6797_normal_abort(t);
+	debt = t->tc4_limit - t->tc4_free;
+	if (t->tc1_free > t->tc1_limit)
+		return mt6797_normal_abort(t);
+	tc1_debt = t->tc1_limit - t->tc1_free;
+	/* The pending pool serves either TC, so it is bounded by both debts. */
+	if (t->tc4_pending_cpu > debt || t->tc4_pending_ffa > debt + tc1_debt ||
+	    t->tc1_pending > tc1_debt)
+		return mt6797_normal_abort(t);
+	for (i = 1; i < 7; i++)
+		if (words[i])
+			return mt6797_normal_abort(t);
+	if (words[0] & 0xffffU)
+		return mt6797_normal_abort(t);
+	ac1 = words[0] >> 16;
+	cpu = words[7] >> 16;
+	ffa = words[7] & 0xffffU;
+	/* Each queue's count is bounded by its own unmatched debt; the pool's by
+	 * both debts less the pool already pending (an accrued queue count may
+	 * precede the pool count that frees it, or follow it).
+	 */
+	if (cpu > debt - t->tc4_pending_cpu ||
+	    ac1 > tc1_debt - t->tc1_pending ||
+	    ffa > debt + tc1_debt - t->tc4_pending_ffa)
+		return mt6797_normal_abort(t);
+	cpu += t->tc4_pending_cpu;
+	ac1 += t->tc1_pending;
+	ffa += t->tc4_pending_ffa;
+	released = cpu < ffa ? cpu : ffa;
+	ffa -= released;
+	released1 = ac1 < ffa ? ac1 : ffa;
+	ffa -= released1;
+	t->tc4_free += released;
+	t->tc4_pending_cpu = cpu - released;
+	t->tc1_free += released1;
+	t->tc1_pending = ac1 - released1;
+	/* The pool remainder waits with TC4's pending count; it serves either TC
+	 * on the next snapshot, bounded by both debts above.
+	 */
+	t->tc4_pending_ffa = ffa;
+	result->released_pages = released;
+	result->tc4_free = t->tc4_free;
+	result->pending_cpu = t->tc4_pending_cpu;
+	result->pending_ffa = t->tc4_pending_ffa;
+	result->tc1_released = released1;
+	result->tc1_free = t->tc1_free;
+	result->pending_ac1 = t->tc1_pending;
+	return 0;
+}
+
+/* A quarantine budget, never a credit or quota change. Only cleanup callers
+ * may submit at this floor; the actual owed page stays in the ledger.
+ */
+static inline bool
+mt6797_normal_cleanup_ready(const struct mt6797_normal_transaction *t)
+{
+	unsigned int debt;
+
+	if (!t || t->cleanup_retained_pages != 1 ||
+	    t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    t->tc4_limit <= 1 || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit)
+		return false;
+	debt = t->tc4_limit - t->tc4_free;
+	return debt <= 1 && t->tc4_pending_cpu <= debt && t->tc4_pending_ffa <= debt &&
+		!(t->tc4_pending_cpu && t->tc4_pending_ffa) &&
+		t->tc1_free == t->tc1_limit && !t->tc1_pending;
+}
+
+/* Shared normal-TC4 framing and debit. Callers validate phase and payload
+ * contract first. A transport failure never refunds this debit.
+ */
+static inline int
+mt6797_normal_encode(struct mt6797_normal_transaction *t,
+		     unsigned int cid, unsigned int is_set,
+		     unsigned int sequence, const unsigned char *payload,
+		     size_t payload_bytes, size_t bytes,
+		     enum mt6797_normal_phase tx_phase,
+		     unsigned char *output, size_t capacity,
+		     struct mt6797_hif_command *command)
+{
+	struct mt6797_hif_command encoded;
+	size_t i;
+	unsigned int pages;
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (!t->used_sequences || !t->tc4_limit || t->tc4_limit > 0xffffU ||
+	    t->tc4_free > t->tc4_limit)
+		return mt6797_normal_abort(t);
+	if (bytes < 8 || payload_bytes > bytes - 8 ||
+	    (payload_bytes && !payload) || cid > 255 || is_set > 1)
+		return -EINVAL;
+	if (sequence > 255)
+		return -EINVAL;
+	if (t->used_sequences[sequence / 8] & (1U << (sequence % 8)))
+		return mt6797_normal_abort(t);
+	error = mt6797_hif_encode_command(0x34, MT6797_HIF_WRITE,
+					  MT6797_HIF_PIO_ONLY, bytes, capacity,
+					  &encoded);
+	if (error)
+		return error;
+	/* No separate TX descriptor or HIF padding charge. */
+	pages = (unsigned int)((bytes + 127) / 128);
+	if (t->tc4_free < pages)
+		return -ENOSPC;
+	for (i = 0; i < encoded.transfer_bytes; i++)
+		output[i] = 0;
+	output[0] = (unsigned char)bytes;
+	output[1] = (unsigned char)(bytes >> 8);
+	output[3] = 0x80;
+	output[4] = (unsigned char)cid;
+	output[5] = 0xa0;
+	output[6] = (unsigned char)is_set;
+	output[7] = (unsigned char)sequence;
+	for (i = 0; i < payload_bytes; i++)
+		output[8 + i] = payload[i];
+	t->tc4_free -= pages;
+	t->used_sequences[sequence / 8] |= (unsigned char)(1U << (sequence % 8));
+	t->expected_sequence = sequence;
+	t->phase = tx_phase;
+	*command = encoded;
+	return 0;
+}
+
+/* Distinct immutable payload, output and state storage. No output bytes are
+ * changed on refusal. CAP's unused request tail and HIF padding are zero.
+ */
+static inline int
+mt6797_normal_prepare(struct mt6797_normal_transaction *t,
+		      enum mt6797_normal_kind kind, unsigned int sequence,
+		      const unsigned char *payload, size_t payload_bytes,
+		      unsigned char *output, size_t capacity,
+		      struct mt6797_hif_command *command)
+{
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (kind == MT6797_NORMAL_CAPABILITY) {
+		if (t->phase != MT6797_NORMAL_IDLE)
+			return mt6797_normal_abort(t);
+		if (payload || payload_bytes)
+			return -EINVAL;
+		return mt6797_normal_encode(t, 0x80, 0, sequence,
+			NULL, 0, MT6797_NORMAL_CAP_BYTES, MT6797_NORMAL_CAP_TX,
+			output, capacity, command);
+	}
+	if (kind == MT6797_NORMAL_NVRAM) {
+		if (t->phase != MT6797_NORMAL_CAP_RECEIVED)
+			return mt6797_normal_abort(t);
+		if (!payload || payload_bytes != 512)
+			return -EINVAL;
+		return mt6797_normal_encode(t, 0x48, 1, sequence,
+			payload, payload_bytes, MT6797_NORMAL_NVRAM_BYTES,
+			MT6797_NORMAL_NVRAM_TX, output, capacity, command);
+	}
+	return -EINVAL;
+}
+
+/* Selected no-reply configuration commands. The caller owns their order,
+ * payload content, regulatory policy and calibration provenance.
+ */
+static inline int
+mt6797_normal_prepare_config(struct mt6797_normal_transaction *t,
+			     enum mt6797_normal_config_kind kind,
+			     unsigned int sequence,
+			     const unsigned char *payload,
+			     size_t payload_bytes, unsigned char *output,
+			     size_t capacity,
+			     struct mt6797_hif_command *command)
+{
+	enum mt6797_normal_phase previous, tx_phase;
+	size_t required;
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	previous = t->phase;
+	if (previous != MT6797_NORMAL_CAP_RECEIVED &&
+	    previous != MT6797_NORMAL_NVRAM_SUBMITTED)
+		return mt6797_normal_abort(t);
+	/* After the immutable record, admit regulatory updates, the bounded
+	 * scan owner and the power-off request only. Never replay manufacture
+	 * data.
+	 */
+	if (previous == MT6797_NORMAL_NVRAM_SUBMITTED &&
+	    kind != MT6797_NORMAL_DOMAIN && kind != MT6797_NORMAL_TX_CTRL &&
+	    kind != MT6797_NORMAL_NIC_POWER_CTRL &&
+	    kind != MT6797_NORMAL_SCAN_V2 && kind != MT6797_NORMAL_BSS_ACTIVE &&
+	    kind != MT6797_NORMAL_SCAN_CANCEL &&
+	    kind != MT6797_NORMAL_SCAN_BROADCAST)
+		return mt6797_normal_abort(t);
+	if (!payload)
+		return -EINVAL;
+	if ((kind == MT6797_NORMAL_SCAN_V2 || kind == MT6797_NORMAL_BSS_ACTIVE ||
+	     kind == MT6797_NORMAL_SCAN_CANCEL ||
+	     kind == MT6797_NORMAL_NIC_POWER_CTRL ||
+	     kind == MT6797_NORMAL_SCAN_BROADCAST) &&
+	    previous != MT6797_NORMAL_NVRAM_SUBMITTED)
+		return mt6797_normal_abort(t);
+	switch (kind) {
+	case MT6797_NORMAL_NIC_POWER_CTRL:
+		/* The vendor's power-off request: power mode 1, reserved zero. */
+		if (payload_bytes != 4 || payload[0] != 1 || payload[1] ||
+		    payload[2] || payload[3])
+			return -EINVAL;
+		required = 4;
+		break;
+	case MT6797_NORMAL_SCAN_BROADCAST:
+		/* Only the source-defined broadcast request for this scan owner. */
+		if (payload_bytes != 4 || payload[0] != 8 || payload[1] ||
+		    payload[2] || payload[3])
+			return -EINVAL;
+		required = 4;
+		break;
+	case MT6797_NORMAL_SCAN_V2:
+		required = 226;
+		break;
+	case MT6797_NORMAL_BSS_ACTIVE:
+		required = 12;
+		break;
+	case MT6797_NORMAL_SCAN_CANCEL:
+		required = 4;
+		break;
+	case MT6797_NORMAL_DOMAIN:
+		required = 56;
+		break;
+	case MT6797_NORMAL_TX_PWR:
+		required = 40;
+		break;
+	case MT6797_NORMAL_EDGE_2G:
+	case MT6797_NORMAL_EDGE_5G:
+		required = 4;
+		break;
+	case MT6797_NORMAL_CHANNEL_OFFSET:
+	case MT6797_NORMAL_AC_PWR:
+		required = 12;
+		break;
+	case MT6797_NORMAL_TX_CTRL:
+		required = 32;
+		break;
+	case MT6797_NORMAL_NVRAM_SETTINGS:
+		required = 512;
+		break;
+	case MT6797_NORMAL_RSSI:
+		required = 2;
+		break;
+	case MT6797_NORMAL_COUNTRY_POWER:
+		if (payload_bytes < 16 || payload_bytes > 528 ||
+		    (payload_bytes - 16) % 8)
+			return -EINVAL;
+		required = payload_bytes;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (payload_bytes != required)
+		return -EINVAL;
+	if (t->cleanup_retained_pages) {
+		if (kind != MT6797_NORMAL_BSS_ACTIVE || payload[0] || payload[1] ||
+		    payload[2] || payload[3] != 1 || payload[10] || payload[11])
+			return -EOPNOTSUPP;
+		if (!mt6797_normal_cleanup_ready(t))
+			return -EBUSY;
+	}
+	tx_phase = kind == MT6797_NORMAL_NVRAM_SETTINGS ?
+		MT6797_NORMAL_NVRAM_TX : MT6797_NORMAL_CONFIG_TX;
+	error = mt6797_normal_encode(t, kind, 1, sequence, payload,
+				     payload_bytes, 8 + payload_bytes, tx_phase,
+		output, capacity, command);
+	if (!error)
+		t->config_return_phase = previous;
+	return error;
+}
+
+/* Feedback from the actual ordered transport. Failure may have side effects. */
+static inline int
+mt6797_normal_submitted(struct mt6797_normal_transaction *t, int transport_error)
+{
+	if (!t)
+		return -EINVAL;
+	if (transport_error)
+		return mt6797_normal_abort(t);
+	if (t->phase == MT6797_NORMAL_CAP_TX) {
+		t->phase = MT6797_NORMAL_CAP_WAIT;
+	} else if (t->phase == MT6797_NORMAL_CONFIG_TX) {
+		if (t->config_return_phase != MT6797_NORMAL_CAP_RECEIVED &&
+		    t->config_return_phase != MT6797_NORMAL_NVRAM_SUBMITTED)
+			return mt6797_normal_abort(t);
+		t->phase = t->config_return_phase;
+	} else if (t->phase == MT6797_NORMAL_NVRAM_TX) {
+		t->phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	} else {
+		return mt6797_normal_abort(t);
+	}
+	return 0;
+}
+
+/* Caller supplies the logical port-1 length obtained via proper WRPLR access.
+ * Extra four RX bytes are staging only. Zero means pending, never a reply.
+ */
+static inline int
+mt6797_normal_reply_span(struct mt6797_normal_transaction *t,
+			 unsigned int reported_length, size_t capacity,
+			 struct mt6797_hif_command *span)
+{
+	int error;
+
+	if (span)
+		*span = (struct mt6797_hif_command){0};
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_CAP_WAIT || !span)
+		return mt6797_normal_abort(t);
+	if (!reported_length)
+		return -EAGAIN;
+	if (reported_length != MT6797_NORMAL_CAP_BYTES)
+		return mt6797_normal_abort(t);
+	error = mt6797_hif_encode_command(0x54, MT6797_HIF_READ,
+					  MT6797_HIF_PIO_ONLY,
+					  MT6797_NORMAL_CAP_BYTES + 4,
+					  capacity, span);
+	if (error)
+		mt6797_normal_abort(t);
+	return error;
+}
+
+/* Exact logical event only; no response-status byte is defined for capability.
+ * RF/BB failure flags are observations, not packet-validation failures or proof
+ * of calibration. Reserved bytes/MAC/date remain unexported and uninterpreted.
+ */
+static inline int
+mt6797_normal_accept_capability(struct mt6797_normal_transaction *t,
+				const unsigned char *packet, size_t bytes,
+				struct mt6797_normal_capability *result)
+{
+	if (result)
+		*result = (struct mt6797_normal_capability){0};
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_CAP_WAIT || !packet || !result ||
+	    bytes != MT6797_NORMAL_CAP_BYTES ||
+	    mt6797_normal_le16(packet) != MT6797_NORMAL_CAP_BYTES ||
+	    mt6797_normal_le16(packet + 2) != 0xe000 || packet[4] != 1 ||
+	    t->expected_sequence > 255 || packet[5] != t->expected_sequence)
+		return mt6797_normal_abort(t);
+	result->product = mt6797_normal_le16(packet + 8);
+	result->firmware_own = mt6797_normal_le16(packet + 10);
+	result->firmware_peer = mt6797_normal_le16(packet + 12);
+	result->hw_5g_disabled = packet[14];
+	result->eeprom_used = packet[15];
+	result->rf_cal_fail = packet[26];
+	result->bb_cal_fail = packet[27];
+	t->phase = MT6797_NORMAL_CAP_RECEIVED;
+	return 0;
+}
+
+/* The vendor rate codes (transmit mode in bits 6-8, the PHY rate below) in
+ * the order of the driver's bitrate table: CCK 1, 2, 5.5 and 11 Mbit/s with
+ * the long preamble, then OFDM 6, 9, 12, 18, 24, 36, 48 and 54 Mbit/s.
+ */
+#define MT6797_LEGACY_RATE_CODES \
+	{ 0x00, 0x01, 0x02, 0x03, 0x4b, 0x4f, 0x4a, 0x4e, 0x49, 0x4d, 0x48, 0x4c }
+
+/* One ordinary data frame's rate as the descriptor carries it. */
+struct mt6797_tx_rate {
+	unsigned short code;	/* u2FixedRate's rate code */
+	bool bw40;		/* FIX_BW_40 */
+	bool sgi;		/* u2FixedRate's short GI bit */
+};
+
+/* mac80211's first rate for a frame: an HT MCS of one stream (0-7) is HT
+ * mixed mode, 0x80 | MCS, with its width and guard interval; a legacy rate
+ * is its bitrate's hw_value, the vendor code (legacy, -1 when the index is
+ * outside the band). false for what the descriptor cannot carry: no rate,
+ * VHT, a second stream, or a legacy rate at 40 MHz or short GI.
+ */
+static inline bool
+mt6797_tx_rate_map(int idx, bool mcs, bool vht, bool w40, bool sgi, int legacy,
+		   struct mt6797_tx_rate *r)
+{
+	if (idx < 0 || vht)
+		return false;
+	if (mcs) {
+		if (idx > 7)
+			return false;
+		r->code = 0x80 | idx;
+		r->bw40 = w40;
+		r->sgi = sgi;
+		return true;
+	}
+	if (legacy < 0 || w40 || sgi)
+		return false;
+	r->code = legacy;
+	r->bw40 = false;
+	r->sgi = false;
+	return true;
+}
+
+/* The descriptor bytes the rate sets over the built ones: the fixed-rate
+ * bit (11), FIX_BW_40 (25) and u2FixedRate with its guard interval in bit
+ * 15 (26-27).
+ */
+static inline void mt6797_tx_rate_descriptor(const struct mt6797_tx_rate *r,
+					     unsigned char *d)
+{
+	d[11] = 0x80;
+	d[25] = r->bw40 ? 5 : 0;
+	d[26] = (r->code << 2) & 255;
+	d[27] = ((r->code << 2) >> 8) | (r->sgi ? 0x80 : 0);
+}
+
+/* Original parser from the publicly pinned gen3 event layouts. */
+static inline unsigned short mt6797_join_le16(const unsigned char *p)
+{
+	return (unsigned short)p[0] | (unsigned short)p[1] << 8;
+}
+
+static inline unsigned int mt6797_join_le32(const unsigned char *p)
+{
+	return (unsigned int)p[0] | (unsigned int)p[1] << 8 |
+	       (unsigned int)p[2] << 16 | (unsigned int)p[3] << 24;
+}
+
+static inline bool mt6797_join_event(const unsigned char *p, size_t n, unsigned char id,
+				     size_t payload)
+{
+	return p && n == 8 + payload && mt6797_join_le16(p) == n &&
+	       mt6797_join_le16(p + 2) == 0xe000 && p[4] == id;
+}
+
+struct mt6797_join_tx_result {
+	unsigned char status, count, flags;
+	unsigned short sequence, rate;
+};
+
+/* TX completion is asynchronous: its header sequence is not a command ID.
+ * Successful parsing alone does not imply an ACK.
+ */
+static inline bool mt6797_join_tx_done(const unsigned char *p, size_t n,
+				       unsigned char pid, unsigned char wlan,
+				       struct mt6797_join_tx_result *out)
+{
+	struct mt6797_join_tx_result r;
+
+	if (!out || !pid || pid > 127 || wlan > 30 ||
+	    !mt6797_join_event(p, n, 0x0f, 16) ||
+	    p[8] != pid || p[12] != wlan)
+		return false;
+	r.status = p[9];
+	r.sequence = mt6797_join_le16(p + 10);
+	/* Firmware rate/count are advanced information only when flag bit 0 is set. */
+	r.count = p[16] & 1 ? p[13] : 0;
+	r.rate = p[16] & 1 ? mt6797_join_le16(p + 14) : 0;
+	r.flags = p[16];
+	*out = r;
+	return true;
+}
+
+struct mt6797_join_channel {
+	unsigned char bss, token, channel, sco, band, width, center1, center2, type;
+	unsigned int max_ms;
+};
+
+static inline bool mt6797_join_channel_grant(const unsigned char *p, size_t n,
+					     const struct mt6797_join_channel *e,
+					     unsigned int *interval_ms)
+{
+	unsigned int interval;
+
+	if (!e || !interval_ms || !e->max_ms ||
+	    !mt6797_join_event(p, n, 0x10, 16) ||
+	    p[8] != e->bss || p[9] != e->token || p[10] != 0 ||
+	    p[11] != e->channel || p[12] != e->sco || p[13] != e->band ||
+	    p[14] != e->width || p[15] != e->center1 ||
+	    p[16] != e->center2 || p[17] != e->type)
+		return false;
+	interval = mt6797_join_le32(p + 20);
+	if (!interval || interval > e->max_ms)
+		return false;
+	*interval_ms = interval;
+	return true;
+}
+
+static inline bool mt6797_join_sta_active(const unsigned char *p, size_t n,
+					  unsigned char command_seq, unsigned char sta,
+					  unsigned char bss, const unsigned char *mac,
+					  bool state3_pending)
+{
+	unsigned int i;
+
+	if (!mac || !state3_pending ||
+	    !mt6797_join_event(p, n, 0x0c, 8) || p[5] != command_seq ||
+	    p[14] != sta || p[15] != bss)
+		return false;
+	for (i = 0; i < 6; i++)
+		if (p[8 + i] != mac[i])
+			return false;
+	return true;
+}
+
+/* The fixed rate code of ordinary data descriptors: mode in bits 6-8, rate
+ * index in bits 0-5; 0x85 is HT MCS5. Management and security frames keep
+ * OFDM 6 Mbit/s (0x4b).
+ */
+#define MT6797_DATA_FIXED_RATE_CODE 0x85U
+
+#define MT6797_JOIN_TX_DESC_BYTES 28U
+
+/* Original encoder from the pinned public gen3 nicTxComposeDesc path.
+ * No transport, station lifetime, destination or channel admission here.
+ * Caller must check those before submitting descriptor and frame together.
+ */
+static inline bool
+mt6797_join_tx_descriptor(const unsigned char *frame, size_t bytes,
+			  unsigned char wlan, unsigned char pid,
+			 unsigned int lifetime_ms, unsigned int attempt_count,
+			 unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+			 unsigned int *pages)
+{
+	unsigned char d[MT6797_JOIN_TX_DESC_BYTES] = {0};
+	unsigned int fc, subtype, minimum, sequence, lifetime, total, count, i;
+
+	if (!frame || !output || !pages || bytes < 24 || bytes > 2304 ||
+	    wlan > 30 || !pid || pid > 127 || !lifetime_ms || lifetime_ms > 10000 ||
+	    !attempt_count || attempt_count > 30)
+		return false;
+	fc = mt6797_join_le16(frame);
+	if (fc & 0xff0f)
+		return false; /* Native unprotected management; no flags/version/type. */
+	subtype = (fc >> 4) & 15;
+	minimum = subtype == 11 ? 30 : subtype == 0 ? 28 : subtype == 12 ? 26 : 0;
+	if (!minimum || bytes < minimum || (frame[22] & 15))
+		return false;
+	sequence = mt6797_join_le16(frame + 22) >> 4;
+	/* 32 TU units; zero is unlimited, never encode it for a finite request. */
+	lifetime = (lifetime_ms * 1000U / 1024U) >> 5;
+	if (!lifetime)
+		lifetime = 1;
+	if (lifetime > 255)
+		lifetime = 255;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	count = attempt_count << 11;
+	d[0] = total; d[1] = total >> 8;
+	d[2] = (MT6797_JOIN_TX_DESC_BYTES + 24) / 2;
+	d[3] = 0x88; /* TC4: MCU port, queue 1. */
+	d[4] = wlan;
+	d[5] = 0xcc; /* Long descriptor, native 802.11, 24-byte header. */
+	d[7] = 1U << 2; /* Own-MAC 1; software packet-type bits remain zero. */
+	d[8] = subtype;
+	d[10] = lifetime;
+	d[11] = 0x80; /* Fixed rate enabled, zero power offset. */
+	d[12] = count; d[13] = count >> 8;
+	d[14] = sequence; d[15] = (sequence >> 8) | 0x80;
+	d[20] = pid; d[21] = 2; /* TX status to MCU. */
+	/* Descriptor rate mode, OFDM 6 Mbps (0x4b), no bandwidth override. */
+	d[26] = (0x4bU << 2) & 255; d[27] = (0x4bU << 2) >> 8;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = d[i];
+	*pages = (total + 127U) / 128U;
+	return true;
+}
+
+#define MT6797_JOIN_ETH_MAX_BYTES 1518U
+#define MT6797_JOIN_ETH_MIN_BYTES 14U
+
+/* The control port's EAPOL frames carry TID 6 (AC_VO) with WMM, the TID the
+ * access point uses for its own (boot P), so both directions of the
+ * handshake take the same access category (0287). The queue stays the
+ * explicit TC4 MCU port of byte 3; the vendor's security path uses TID 0.
+ */
+#define MT6797_JOIN_TX_SECURITY_TID 6U
+
+/* Original encoder from the pinned public gen3 nicTxComposeSecurityFrameDesc
+ * path: one Ethernet II EAPOL frame on the same TC4 owner, header format
+ * non-802.11 with the Ethernet II flag, Ethernet-type offset after the
+ * descriptor and the 12 address bytes, TID 0, the station's WLAN index,
+ * own-MAC index 1, the bounded lifetime and attempt count, the fixed OFDM
+ * 6 Mbps rate and a PID with TX status to the MCU. The firmware builds the
+ * 802.11 header; no sequence number, type or subtype is encoded. No
+ * transport, station lifetime, destination or channel admission here.
+ */
+static inline bool
+mt6797_join_tx_security_descriptor(const unsigned char *frame, size_t bytes,
+				   unsigned char wlan, unsigned char pid,
+				   unsigned int lifetime_ms, unsigned int attempt_count,
+				   unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+				   unsigned int *pages)
+{
+	unsigned char d[MT6797_JOIN_TX_DESC_BYTES] = {0};
+	unsigned int lifetime, total, count, i;
+
+	if (!frame || !output || !pages || bytes < 14 + 4 ||
+	    bytes > MT6797_JOIN_ETH_MAX_BYTES || wlan > 30 || !pid || pid > 127 ||
+	    !lifetime_ms || lifetime_ms > 10000 || !attempt_count || attempt_count > 30)
+		return false;
+	/* Unicast Ethernet II EAPOL only: no group destination or source. */
+	if ((frame[0] & 1) || (frame[6] & 1) || frame[12] != 0x88 || frame[13] != 0x8e)
+		return false;
+	lifetime = (lifetime_ms * 1000U / 1024U) >> 5;
+	if (!lifetime)
+		lifetime = 1;
+	if (lifetime > 255)
+		lifetime = 255;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	count = attempt_count << 11;
+	d[0] = total; d[1] = total >> 8;
+	d[2] = (MT6797_JOIN_TX_DESC_BYTES + 12) / 2; /* Ethernet type after the addresses. */
+	d[3] = 0x88; /* TC4: MCU port, queue 1. */
+	d[4] = wlan;
+	d[5] = 0x90; /* Long descriptor, non-802.11 header, Ethernet II. */
+	d[6] = MT6797_JOIN_TX_SECURITY_TID << 4; /* TID, bits 4-6. */
+	d[7] = 1U << 2; /* Own-MAC 1. */
+	d[10] = lifetime;
+	d[11] = 0x80; /* Fixed rate enabled, zero power offset. */
+	d[12] = count; d[13] = count >> 8;
+	d[20] = pid; d[21] = 2; /* TX status to MCU. */
+	d[26] = (0x4bU << 2) & 255; d[27] = (0x4bU << 2) >> 8;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = d[i];
+	*pages = (total + 127U) / 128U;
+	return true;
+}
+
+/* Original encoder from the pinned public gen3 nicTxComposeDesc path for one
+ * protected Ethernet II data frame of a legacy station: TC1 (PORT_INDEX_LMAC
+ * 0, MAC_TXQ_AC1_INDEX 1, the pinned arTcResourceControl row), long format,
+ * non-802.11 header with the Ethernet II flag, Ethernet-type offset after the
+ * descriptor and the 12 address bytes, TID 0 (no WMM was negotiated), the
+ * protected-frame bit (the firmware encrypts with the installed pairwise key
+ * under the station's WLAN index, as secIsProtectedFrame sets it for a
+ * station with a TX key), own-MAC index 1, the bounded lifetime and attempt
+ * count, the fixed OFDM 6 Mbps rate and a PID with TX status to the MCU. The
+ * destination may be a group address (ARP and DHCP are); the source is this
+ * station, never a group address; the EAPOL type is refused here (no rekey
+ * on this path). The firmware builds the 802.11 header; no sequence number,
+ * type or subtype is encoded. No transport, lifetime or admission here.
+ */
+static inline bool
+mt6797_join_tx_data_descriptor_report(const unsigned char *frame, size_t bytes,
+				      unsigned char wlan, unsigned char pid,
+				      bool status_report,
+				      unsigned int lifetime_ms, unsigned int attempt_count,
+				      unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+				      unsigned int *pages)
+{
+	unsigned char d[MT6797_JOIN_TX_DESC_BYTES] = {0};
+	unsigned int lifetime, total, count, i;
+
+	/* Without a status report the descriptor carries no PID: the vendor
+	 * sets the PID and the MCU report together, only for frames with a
+	 * completion handler (nicTxFillDesc), and releases plain data on the
+	 * page counts.
+	 */
+	if (!frame || !output || !pages || bytes < MT6797_JOIN_ETH_MIN_BYTES ||
+	    bytes > MT6797_JOIN_ETH_MAX_BYTES || wlan > 30 ||
+	    (status_report ? (!pid || pid > 127) : pid != 0) ||
+	    !lifetime_ms || lifetime_ms > 10000 || !attempt_count || attempt_count > 30)
+		return false;
+	if ((frame[6] & 1) || (frame[12] == 0x88 && frame[13] == 0x8e))
+		return false;
+	lifetime = (lifetime_ms * 1000U / 1024U) >> 5;
+	if (!lifetime)
+		lifetime = 1;
+	if (lifetime > 255)
+		lifetime = 255;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	count = attempt_count << 11;
+	d[0] = total; d[1] = total >> 8;
+	d[2] = (MT6797_JOIN_TX_DESC_BYTES + 12) / 2; /* Ethernet type after the addresses. */
+	d[3] = 1U << 3; /* LMAC port 0, queue index 1 (AC1): TC1. */
+	d[4] = wlan;
+	d[5] = 0x90; /* Long descriptor, non-802.11 header, Ethernet II. */
+	d[6] = 0x80; /* Protected frame, TID 0, no header padding. */
+	d[7] = 1U << 2; /* Own-MAC 1. */
+	d[10] = lifetime;
+	/* Fixed rate enabled unless the code is 0, zero power offset. */
+	d[11] = 0x80;	/* fixed rate */
+	d[12] = count; d[13] = count >> 8;
+	if (status_report) {
+		d[20] = pid; d[21] = 2; /* TX status to MCU. */
+	}
+	d[26] = (MT6797_DATA_FIXED_RATE_CODE << 2) & 255;
+	d[27] = (MT6797_DATA_FIXED_RATE_CODE << 2) >> 8;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = d[i];
+	*pages = (total + 127U) / 128U;
+	return true;
+}
+
+static inline bool
+mt6797_join_tx_data_descriptor(const unsigned char *frame, size_t bytes,
+			       unsigned char wlan, unsigned char pid,
+			       unsigned int lifetime_ms, unsigned int attempt_count,
+			       unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+			       unsigned int *pages)
+{
+	return mt6797_join_tx_data_descriptor_report(frame, bytes, wlan, pid, true,
+						     lifetime_ms, attempt_count,
+						     output, pages);
+}
+
+#define MT6797_JOIN_STA_BYTES 124U
+
+/* The AP station's broadcast (BMC) WLAN table index this driver declares.
+ * The pinned vendor allocator (privacy.c secPrivacySeekForEntry for an AP
+ * station calls secGetBmcWlanIndex, lowest free entry below
+ * NIC_TX_DEFAULT_WLAN_INDEX 31) hands the BSS's own broadcast entry 0 at
+ * activation, the station's pairwise entry 1 at creation and the station's
+ * broadcast entry 2 right after it, declares 2 in every UPDATE_STA_RECORD for
+ * the AP station and installs the group key under it (wlanoidSetAddKey
+ * reuses the entry whose key id is still 0xff). The reference run 3 ledger
+ * shows exactly that order (station records with BMC index 2 before any
+ * key, the group key command with WLAN index 2, group frames received on
+ * WLAN index 2). The BSS payloads keep the BSS's own entry 0.
+ */
+#define MT6797_JOIN_BMC_WLAN_INDEX 2U
+#define MT6797_JOIN_RESERVED_WLAN_INDEX 255U
+
+/* Public gen3 DIRECTED (bit 0) plus BROADCAST (bit 3), no monitor mode. */
+static inline bool mt6797_join_filter_payload(unsigned char output[4])
+{
+	if (!output)
+		return false;
+	output[0] = 9;
+	output[1] = 0;
+	output[2] = 0;
+	output[3] = 0;
+	return true;
+}
+
+/* mac80211's published 5 GHz band has OFDM rates in positions 0..7.
+ * The gen3 software rate set reserves positions 0..5 before OFDM 6 Mbps.
+ * Validate both sets before modifying outputs; this establishes no peer state.
+ */
+static inline bool
+mt6797_join_legacy_rates(unsigned int supported, unsigned int basic,
+			 unsigned int *desired_rates, unsigned int *basic_rates)
+{
+	if (!desired_rates || !basic_rates || !supported || (supported & ~0xffU) ||
+	    !basic || (basic & ~supported) || !(supported & 1U))
+		return false;
+	*desired_rates = supported << 6;
+	*basic_rates = basic << 6;
+	return true;
+}
+
+/* Original payload encoders for one legacy 5 GHz, 20 MHz join. Slot indices
+ * are project reservations, not firmware allocation acknowledgements.
+ * The caller must establish the exclusive BSS/peer lifetime first.
+ */
+static inline bool
+mt6797_join_station_payload(const unsigned char *ap, unsigned int state,
+			    unsigned int aid, unsigned int desired_rates, unsigned int basic_rates,
+	unsigned char output[MT6797_JOIN_STA_BYTES])
+{
+	unsigned char p[MT6797_JOIN_STA_BYTES] = {0};
+	unsigned int i, any = 0;
+
+	if (!ap || !output || (ap[0] & 1) || (state != 1 && state != 3) ||
+	    (state == 1 && aid) || (state == 3 && (!aid || aid > 2007)) ||
+	    !desired_rates || (desired_rates & ~0x3fc0U) ||
+	    !basic_rates || (basic_rates & ~desired_rates) ||
+	    !(desired_rates & (1U << 6)))
+		return false;
+	for (i = 0; i < 6; i++)
+		any |= ap[i];
+	if (!any)
+		return false;
+	p[0] = 1; /* STA index 1. */
+	p[1] = 0x41; /* Legacy AP: legacy bit 0, AP role bit 6. */
+	for (i = 0; i < 6; i++)
+		p[2 + i] = ap[i];
+	p[8] = aid; p[9] = aid >> 8;
+	p[10] = 1; /* Listen interval, no station power-save admission. */
+	p[13] = 8; /* PHY OFDM 5 GHz only. BSS index 0. */
+	p[14] = desired_rates; p[15] = desired_rates >> 8;
+	p[16] = basic_rates; p[17] = basic_rates >> 8;
+	p[20] = state;
+	p[51] = state == 3; /* Activation response required only for state 3. */
+	p[54] = 1; /* AP WLAN index 1. */
+	p[55] = MT6797_JOIN_BMC_WLAN_INDEX; /* The station's declared broadcast entry. */
+	p[68] = 3; /* Legacy RTS policy. */
+	p[74] = 0x4b; /* Default fixed rate OFDM 6 Mbps. */
+	p[76] = 1; p[77] = 1; /* Command option DISABLED, not AUTO (0). */
+	for (i = 0; i < MT6797_JOIN_STA_BYTES; i++)
+		output[i] = p[i];
+	return true;
+}
+
+#define MT6797_JOIN_BSS_BYTES 88U
+
+/* Public gen3 CMD_SET_BSS_INFO including its 20-byte RLM tail.
+ * One legacy 5 GHz AIS BSS, connected (enum 0), Open System/no cipher.
+ * Natural alignment leaves reserved bytes at 49 and 61..63.
+ */
+static inline bool
+mt6797_join_bss_payload(const unsigned char *ap, const unsigned char *ssid,
+			unsigned int ssid_bytes, unsigned int desired_rates,
+	unsigned int basic_rates, bool short_preamble, bool wpa2,
+	unsigned char output[MT6797_JOIN_BSS_BYTES])
+{
+	unsigned char p[MT6797_JOIN_BSS_BYTES] = {0};
+	unsigned int i, any = 0;
+
+	if (!ap || !ssid || !output || !ssid_bytes || ssid_bytes > 32 ||
+	    (ap[0] & 1) || !desired_rates || (desired_rates & ~0x3fc0U) ||
+	    !basic_rates || (basic_rates & ~desired_rates) ||
+	    !(desired_rates & (1U << 6)))
+		return false;
+	for (i = 0; i < 6; i++)
+		any |= ap[i];
+	if (!any)
+		return false;
+	p[3] = ssid_bytes;
+	for (i = 0; i < ssid_bytes; i++)
+		p[4 + i] = ssid[i];
+	for (i = 0; i < 6; i++)
+		p[36 + i] = ap[i];
+	p[44] = desired_rates; p[45] = desired_rates >> 8;
+	p[46] = basic_rates; p[47] = basic_rates >> 8;
+	p[48] = 1; /* AP STA index. */
+	p[50] = 0x4b; /* Fixed OFDM 6 Mbps. */
+	p[52] = 3; /* PHY_TYPE_OFDM_INDEX, not a bitmap. */
+	/* Pinned gen3 CMD_SET_BSS_INFO bytes 53 and 54: ucAuthMode and ucEncStatus.
+	 * A WPA2-PSK join declares AUTH_MODE_WPA2_PSK (7) and
+	 * ENUM_ENCRYPTION3_ENABLED (6) at connect time, before any key exists, as
+	 * the vendor AIS path does; otherwise AUTH_MODE_OPEN (0) and
+	 * ENUM_ENCRYPTION_DISABLED (1), not encryption-enabled enum 0.
+	 */
+	p[53] = wpa2 ? 7 : 0;
+	p[54] = wpa2 ? 6 : 1;
+	p[55] = 8; /* PHY_TYPE_BIT_OFDM. */
+	/* BSS 0, BMC 0 (the BSS's own broadcast entry, as the vendor's
+	 * post-association SET_BSS_INFO carries; the station's broadcast entry
+	 * is declared in the station record), private AIS index 0, disconnect
+	 * threshold default 0.
+	 */
+	p[69] = 2; p[70] = 40;
+	p[81] = short_preamble;
+	p[82] = 1; /* 5 GHz always uses short slot time. */
+	/* Public rlmFillSyncCmdParam uses the legacy basic set here too. */
+	p[86] = basic_rates; p[87] = basic_rates >> 8;
+	for (i = 0; i < MT6797_JOIN_BSS_BYTES; i++)
+		output[i] = p[i];
+	return true;
+}
+
+static inline bool
+mt6797_join_remove_station(unsigned char output[4])
+{
+	if (!output)
+		return false;
+	output[0] = 0; /* Remove one STA, not every station in a BSS. */
+	output[1] = 1;
+	output[2] = 0;
+	output[3] = 0;
+	return true;
+}
+
+static inline bool
+mt6797_join_channel_payload(unsigned char token, unsigned char channel,
+			    unsigned int interval_ms, bool abort, unsigned char output[16])
+{
+	unsigned char p[16] = {0};
+	unsigned int i;
+
+	if (!output || !token || (!abort &&
+				  (channel != 40 || !interval_ms ||
+	     (interval_ms > 10000 && interval_ms != 65000))))
+		return false;
+	p[1] = token; /* BSS 0, project-owned single-use token. */
+	p[2] = abort; /* Request 0, abort 1. */
+	if (!abort) {
+		p[3] = channel;
+		p[5] = 2; /* 5 GHz, no secondary offset, 20/40 width enum 0. */
+		/* JOIN request type 0, center segments and reserved bytes zero. */
+		p[12] = interval_ms; p[13] = interval_ms >> 8;
+		p[14] = interval_ms >> 16; p[15] = interval_ms >> 24;
+	}
+	for (i = 0; i < 16; i++)
+		output[i] = p[i];
+	return true;
+}
+
+#define MT6797_JOIN_KEY_BYTES 64U
+
+/* Clear a local copy of key material without the compiler eliding it. */
+static inline void mt6797_join_clear(unsigned char *p, unsigned int n)
+{
+	memzero_explicit(p, n);
+}
+
+/* Original encoder of the pinned public gen3 CMD_802_11_KEY for
+ * CMD_ID_ADD_REMOVE_KEY (0x07), as wlanoidSetAddKey and wlanoidSetRemoveKey
+ * fill it for a WPA2-PSK CCMP station. Add: TX key and unicast type for the
+ * pairwise key, neither for the group key, no authenticator flag, the AP's
+ * address as the peer for both (the vendor substitutes the BSSID for the
+ * broadcast group address), BSS index 0, CIPHER_SUITE_CCMP (4), the key id,
+ * 16 key bytes, WLAN index 1 for the pairwise key and the station's declared
+ * broadcast index MT6797_JOIN_BMC_WLAN_INDEX for the group key. Remove, as
+ * wlanoidSetRemoveKey fills it on the paths the standard supplicant
+ * exercises: the zeroed command with AddRemove 0, the key id and BSS index;
+ * for the pairwise key the AP's address, unicast type 1 and the station's
+ * WLAN index 1 (a removal with an address and the unicast flag); for the
+ * group key a zero peer, type 0 and WLAN index 255, WTBL_RESERVED_ENTRY (the
+ * supplicant's wpa_clear_keys deletes by index with no address, the vendor
+ * finds no station record for the zero address and, for WPA, writes the
+ * reserved entry; the reference teardowns show six such removals accepted).
+ * A group removal is the one shape without a peer. The RSC is zero in both: the pinned
+ * wlanoidSetAddKey zeroes the whole command (kalMemZero at its start) and
+ * never writes aucKeyRsc, which only the WAPI path fills, so the firmware
+ * receives no receive sequence counter for a CCMP key and replay handling is
+ * not validated by this driver. The 16 key bytes are copied only for an add,
+ * the local copy is cleared before returning, and the caller clears the
+ * payload and the transfer buffer after submission; nothing is retained.
+ */
+static inline bool
+mt6797_join_key_payload(bool add, bool pairwise, const unsigned char *peer,
+			unsigned int key_id, const unsigned char *material,
+			unsigned char output[MT6797_JOIN_KEY_BYTES])
+{
+	unsigned char p[MT6797_JOIN_KEY_BYTES] = {0};
+	unsigned int i, any = 0;
+
+	bool group_removal = !add && !pairwise;
+
+	if (!output || key_id > 3 || (pairwise && key_id) || (add && !material))
+		return false;
+	if (group_removal) {
+		if (peer)
+			return false;
+	} else {
+		if (!peer || (peer[0] & 1))
+			return false;
+		for (i = 0; i < 6; i++)
+			any |= peer[i];
+		if (!any)
+			return false;
+	}
+	p[0] = add;
+	p[1] = add && pairwise;
+	p[2] = pairwise;
+	if (!group_removal)
+		for (i = 0; i < 6; i++)
+			p[4 + i] = peer[i];
+	p[11] = add ? 4 : 0;
+	p[12] = key_id;
+	p[13] = add ? 16 : 0;
+	p[14] = pairwise ? 1 : group_removal ? MT6797_JOIN_RESERVED_WLAN_INDEX :
+		MT6797_JOIN_BMC_WLAN_INDEX;
+	if (add)
+		for (i = 0; i < 16; i++)
+			p[16 + i] = material[i];
+	for (i = 0; i < MT6797_JOIN_KEY_BYTES; i++)
+		output[i] = p[i];
+	mt6797_join_clear(p, MT6797_JOIN_KEY_BYTES);
+	return true;
+}
+
+/* The monitor control the proven data path uses: the stock SET_MONITOR
+ * callback's complete Boolean-mask store, written directly as one word at
+ * its fixed address through the register-access command. Only this address
+ * and the values 7 (enable) and 0 (disable) are ever encoded.
+ */
+#define MT6797_DIAG_MASK_BYTES 8U
+#define MT6797_DIAG_MASK_TARGET 0x800c0068U
+static inline bool
+mt6797_diag_mask_payload(bool enable, unsigned char output[MT6797_DIAG_MASK_BYTES])
+{
+	unsigned int i;
+
+	if (!output)
+		return false;
+	for (i = 0; i < 4; i++)
+		output[i] = MT6797_DIAG_MASK_TARGET >> (8 * i);
+	output[4] = enable ? 7 : 0;
+	output[5] = 0;
+	output[6] = 0;
+	output[7] = 0;
+	return true;
+}
+
+#define MT6797_JOIN_PM_CONNECTED_BYTES 12U
+
+/* Called only for the existing qualified target beacon, after association.
+ * Validate the entire IE span and a unique TIM; no output changes on failure.
+ */
+static inline int
+mt6797_join_beacon_dtim(const unsigned char *frame, size_t bytes,
+			unsigned int interval, unsigned char *dtim)
+{
+	size_t pos = 36;
+	unsigned char period = 0;
+	unsigned int seen = 0;
+
+	if (!frame || !dtim || bytes < 36 || bytes > 4096 ||
+	    !interval || interval > 0xffffU)
+		return -EINVAL;
+	if ((mt6797_join_le16(frame) & 0x00ff) != 0x0080 ||
+	    mt6797_join_le16(frame + 32) != interval)
+		return -EPROTO;
+	while (pos < bytes) {
+		unsigned int len;
+
+		if (bytes - pos < 2)
+			return -EPROTO;
+		len = frame[pos + 1];
+		if (len > bytes - pos - 2)
+			return -EPROTO;
+		if (frame[pos] == 5) {
+			if (++seen != 1 || len < 4 || !frame[pos + 3] ||
+			    frame[pos + 2] >= frame[pos + 3])
+				return -EPROTO;
+			period = frame[pos + 3];
+		}
+		pos += 2 + len;
+	}
+	if (!seen)
+		return -ENOENT;
+	*dtim = period;
+	return 0;
+}
+
+/* Public gen3 PM connection: BSS 0, legacy no-PS, zero ATIM/UAPSD/reserved.
+ * DTIM is from a fresh qualified beacon; AID is the accepted AssocResp's.
+ */
+static inline bool
+mt6797_join_pm_connected_payload(unsigned int dtim, unsigned int aid,
+				 unsigned int interval,
+				 unsigned char output[MT6797_JOIN_PM_CONNECTED_BYTES])
+{
+	unsigned char p[MT6797_JOIN_PM_CONNECTED_BYTES] = {0};
+	unsigned int i;
+
+	if (!output || !dtim || dtim > 255 || !aid || aid > 2007 ||
+	    !interval || interval > 0xffffU)
+		return false;
+	p[1] = dtim;
+	p[2] = aid;
+	p[3] = aid >> 8;
+	p[4] = interval;
+	p[5] = interval >> 8;
+	for (i = 0; i < sizeof(p); i++)
+		output[i] = p[i];
+	return true;
+}
+
+static inline bool mt6797_join_pm_abort_payload(unsigned char output[4])
+{
+	unsigned int i;
+
+	if (!output)
+		return false;
+	for (i = 0; i < 4; i++)
+		output[i] = 0;
+	return true;
+}
+
+#endif /* MT6797_MCU_H */
diff --git a/drivers/net/wireless/mediatek/mt6797/ordinary-transfer.c b/drivers/net/wireless/mediatek/mt6797/ordinary-transfer.c
new file mode 100644
index 000000000..14782f924
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/ordinary-transfer.c
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include "ordinary-transfer.h"
+
+#define MT6797_ORDINARY_TRANSFER_CONFIG_BYTES 20U
+
+struct mt6797_ordinary_transfer_batch {
+	const struct mt6797_ordinary_transfer_request *request_start;
+	size_t request_bytes;
+	size_t count;
+	size_t aggregate_bytes;
+	int attempted;
+	int first_error;
+	struct mt6797_ordinary_transfer_request requests[MTKE_MAX_SECTIONS];
+};
+
+static void *ordinary_zalloc(size_t size)
+{
+	return kzalloc(size, GFP_KERNEL);
+}
+
+static void ordinary_free(void *pointer)
+{
+	kfree(pointer);
+}
+
+static u64 ordinary_now_ns(void)
+{
+	return ktime_get_ns();
+}
+
+static int ordinary_span(const void *pointer, size_t bytes,
+			 unsigned long *start, unsigned long *end)
+{
+	unsigned long address = (unsigned long)pointer;
+
+	if (!pointer || !bytes || bytes > ULONG_MAX - address)
+		return -EOVERFLOW;
+	*start = address;
+	*end = address + bytes;
+	return 0;
+}
+
+static int ordinary_disjoint(const void *left, size_t left_bytes,
+			     const void *right, size_t right_bytes)
+{
+	unsigned long left_start, left_end, right_start, right_end;
+
+	if (ordinary_span(left, left_bytes, &left_start, &left_end) ||
+	    ordinary_span(right, right_bytes, &right_start, &right_end))
+		return 0;
+	return left_end <= right_start || right_end <= left_start;
+}
+
+static int
+ordinary_request_spans_valid(const struct mt6797_ordinary_transfer_request *requests,
+			     size_t count,
+			     const struct mt6797_ordinary_transfer_batch *batch)
+{
+	size_t i, j;
+
+	if (!ordinary_disjoint(requests, count * sizeof(*requests), batch,
+			       sizeof(*batch)))
+		return -EOVERFLOW;
+	for (i = 0; i < count; i++) {
+		const struct mt6797_ordinary_transfer_request *request = &requests[i];
+
+		if (!ordinary_disjoint(requests, count * sizeof(*requests),
+				       request->config, request->config_bytes) ||
+		    !ordinary_disjoint(requests, count * sizeof(*requests),
+				       request->data, request->length) ||
+		    !ordinary_disjoint(batch, sizeof(*batch), request->config,
+				       request->config_bytes) ||
+		    !ordinary_disjoint(batch, sizeof(*batch), request->data,
+				       request->length) ||
+		    !ordinary_disjoint(request->config, request->config_bytes,
+				       request->data, request->length))
+			return -EINVAL;
+		for (j = 0; j < i; j++) {
+			if (!ordinary_disjoint(request->config, request->config_bytes,
+					       requests[j].config,
+					       requests[j].config_bytes) ||
+			    !ordinary_disjoint(request->config, request->config_bytes,
+					       requests[j].data, requests[j].length) ||
+			    !ordinary_disjoint(request->data, request->length,
+					       requests[j].config,
+					       requests[j].config_bytes) ||
+			    !ordinary_disjoint(request->data, request->length,
+					       requests[j].data, requests[j].length))
+				return -EINVAL;
+		}
+	}
+	return 0;
+}
+
+struct mt6797_ordinary_transfer_batch *
+mt6797_ordinary_transfer_prepare(const struct mt6797_ordinary_transfer_request *requests,
+				 size_t count)
+{
+	struct mt6797_ordinary_transfer_batch *batch;
+	size_t i, aggregate = 0;
+
+	if (!requests || !count || count > MTKE_MAX_SECTIONS ||
+	    count > (size_t)-1 / sizeof(*requests))
+		return NULL;
+	batch = ordinary_zalloc(sizeof(*batch));
+	if (!batch)
+		return NULL;
+	if (ordinary_request_spans_valid(requests, count, batch))
+		goto fail;
+	for (i = 0; i < count; i++) {
+		const struct mt6797_ordinary_transfer_request *request = &requests[i];
+		size_t j;
+
+		if (request->kind != MT6797_SECTION_ORDINARY || !request->config ||
+		    request->config_bytes != MT6797_ORDINARY_TRANSFER_CONFIG_BYTES ||
+		    !request->data || !request->length ||
+		    request->length > MTKE_MAX_BYTES ||
+		    request->sequence == 0 || request->sequence > 255U ||
+		    mt6797_init_validate_config(request->config, request->config_bytes,
+						request->sequence) ||
+		    mt6797_init_le32(request->config + 12) != request->length ||
+		    aggregate > MTKE_MAX_BYTES - request->length)
+			goto fail;
+		for (j = 0; j < i; j++)
+			if (request->sequence == batch->requests[j].sequence)
+				goto fail;
+		aggregate += request->length;
+		batch->requests[i] = *request;
+	}
+	batch->request_start = requests;
+	batch->request_bytes = count * sizeof(*requests);
+	batch->count = count;
+	batch->aggregate_bytes = aggregate;
+	return batch;
+fail:
+	ordinary_free(batch);
+	return NULL;
+}
+
+static int
+ordinary_result_spans_valid(const struct mt6797_ordinary_transfer_batch *batch,
+			    const struct mt6797_ordinary_transfer_result *result)
+{
+	size_t i;
+
+	if (!ordinary_disjoint(result, sizeof(*result), batch, sizeof(*batch)) ||
+	    !ordinary_disjoint(result, sizeof(*result), batch->request_start,
+			       batch->request_bytes))
+		return 0;
+	for (i = 0; i < batch->count; i++) {
+		const struct mt6797_ordinary_transfer_request *request =
+			&batch->requests[i];
+
+		if (!ordinary_disjoint(result, sizeof(*result), request->config,
+				       request->config_bytes) ||
+		    !ordinary_disjoint(result, sizeof(*result), request->data,
+				       request->length))
+			return 0;
+	}
+	return 1;
+}
+
+int
+mt6797_ordinary_transfer_execute(struct mt6797_ordinary_transfer_batch *batch,
+				 struct mt6797_hif *hif, u64 deadline_ns,
+				 struct mt6797_ordinary_transfer_result *result)
+{
+	size_t i;
+
+	if (!batch || !hif || !result || batch->attempted || batch->first_error)
+		return -EINVAL;
+	if (!ordinary_result_spans_valid(batch, result))
+		return -EINVAL;
+	*result = (struct mt6797_ordinary_transfer_result){
+		.failed_index = MT6797_ORDINARY_TRANSFER_NO_FAILURE_INDEX};
+	batch->attempted = 1;
+	if (!deadline_ns || ordinary_now_ns() >= deadline_ns) {
+		batch->first_error = -ETIMEDOUT;
+		result->error = batch->first_error;
+		return batch->first_error;
+	}
+	for (i = 0; i < batch->count; i++) {
+		struct mt6797_hif_section_request request = {
+			.kind = batch->requests[i].kind,
+			.config = batch->requests[i].config,
+			.config_bytes = batch->requests[i].config_bytes,
+			.sequence = batch->requests[i].sequence,
+			.data = batch->requests[i].data,
+			.length = batch->requests[i].length,
+		};
+		struct mt6797_hif_section_result section = {0};
+		int error;
+
+		error = mt6797_hif_download_section(hif, &request, deadline_ns,
+						    &section);
+		if (error || section.submitted != request.length) {
+			if (!error)
+				error = -EPROTO;
+			batch->first_error = error;
+			result->failed_index = i;
+			result->error = error;
+			result->firmware_status = section.firmware_status;
+			result->partial_submitted = section.submitted;
+			return error;
+		}
+		result->completed_sections++;
+		result->completed_bytes += request.length;
+	}
+	return 0;
+}
diff --git a/drivers/net/wireless/mediatek/mt6797/ordinary-transfer.h b/drivers/net/wireless/mediatek/mt6797/ordinary-transfer.h
new file mode 100644
index 000000000..6687e5b16
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/ordinary-transfer.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_ORDINARY_TRANSFER_H
+#define MT6797_ORDINARY_TRANSFER_H
+
+#include "hif.h"
+#include "firmware.h"
+
+#define MT6797_ORDINARY_TRANSFER_NO_FAILURE_INDEX ((size_t)-1)
+
+struct mt6797_ordinary_transfer_request {
+	enum mt6797_section_kind kind;
+	const u8 *config;
+	size_t config_bytes;
+	unsigned int sequence;
+	const u8 *data;
+	size_t length;
+};
+
+struct mt6797_ordinary_transfer_result {
+	size_t completed_sections;
+	size_t completed_bytes;
+	size_t failed_index;
+	int error;
+	unsigned int firmware_status;
+	size_t partial_submitted;
+};
+
+struct mt6797_ordinary_transfer_batch;
+
+/*
+ * The caller retains powered ownership, exclusion, generation and all source
+ * buffers across preparation and execution. This object makes none of those
+ * claims and has no production caller or owner-token escape hatch.
+ */
+struct mt6797_ordinary_transfer_batch *
+mt6797_ordinary_transfer_prepare(const struct mt6797_ordinary_transfer_request *requests,
+				 size_t count);
+
+/*
+ * One absolute monotonic deadline covers the whole batch. The HIF context and
+ * result storage must remain disjoint from every retained input span.
+ */
+int
+mt6797_ordinary_transfer_execute(struct mt6797_ordinary_transfer_batch *batch,
+				 struct mt6797_hif *hif, u64 deadline_ns,
+				 struct mt6797_ordinary_transfer_result *result);
+
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/record-prepare.c b/drivers/net/wireless/mediatek/mt6797/record-prepare.c
new file mode 100644
index 000000000..bfbf6ba36
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/record-prepare.c
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Private board record acquisition; no command or radio action here. */
+#include <linux/firmware.h>
+#include <linux/slab.h>
+
+#include "record-prepare.h"
+
+#define MT6797_WIFI_RECORD_NAME "mediatek/mt6797/WIFI.storage"
+
+struct mt6797_wifi_record {
+	const struct firmware *blob;
+	struct mt6797_record_commands commands;
+};
+
+int mt6797_wifi_record_prepare(struct device *dev,
+			       struct mt6797_wifi_record **out)
+{
+	struct mt6797_wifi_record *record;
+	int ret;
+
+	if (!out)
+		return -EINVAL;
+	*out = NULL;
+	if (!dev)
+		return -EINVAL;
+	record = kzalloc_obj(*record, GFP_KERNEL);
+	if (!record)
+		return -ENOMEM;
+	ret = request_firmware(&record->blob, MT6797_WIFI_RECORD_NAME, dev);
+	if (ret)
+		goto free_record;
+	ret = mt6797_record_commands_from_storage(record->blob->data,
+						  record->blob->size,
+						  &record->commands);
+	if (ret)
+		goto release_blob;
+	*out = record;
+	return 0;
+
+release_blob:
+	release_firmware(record->blob);
+free_record:
+	memzero_explicit(&record->commands, sizeof(record->commands));
+	kfree(record);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wifi_record_prepare);
+
+const u8 *mt6797_wifi_record_data(const struct mt6797_wifi_record *record)
+{
+	return record ? record->blob->data : NULL;
+}
+EXPORT_SYMBOL_GPL(mt6797_wifi_record_data);
+
+const struct mt6797_record_commands *
+mt6797_wifi_record_commands(const struct mt6797_wifi_record *record)
+{
+	return record ? &record->commands : NULL;
+}
+EXPORT_SYMBOL_GPL(mt6797_wifi_record_commands);
+
+void mt6797_wifi_record_release(struct mt6797_wifi_record *record)
+{
+	if (!record)
+		return;
+	release_firmware(record->blob);
+	memzero_explicit(&record->commands, sizeof(record->commands));
+	kfree(record);
+}
+EXPORT_SYMBOL_GPL(mt6797_wifi_record_release);
diff --git a/drivers/net/wireless/mediatek/mt6797/record-prepare.h b/drivers/net/wireless/mediatek/mt6797/record-prepare.h
new file mode 100644
index 000000000..136145af0
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/record-prepare.h
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_WIFI_RECORD_PREPARE_H
+#define MT6797_WIFI_RECORD_PREPARE_H
+
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#define MT6797_WIFI_STORAGE_BYTES 514U
+#define MT6797_WIFI_RECORD_BYTES 512U
+
+/* Opaque command bytes from the selected host branches. This is format
+ * preparation, not calibration applicability or permission to transmit.
+ */
+struct mt6797_record_commands {
+	bool base_power, edge_5g, ac_5g, edge_2g;
+	u8 base_power_bytes[40];
+	u8 edge_5g_bytes[4];
+	u8 ac_5g_bytes[12];
+	u8 edge_2g_bytes[4];
+};
+
+static inline unsigned int mt6797_record_le16(const u8 *p)
+{
+	return (unsigned int)p[0] | ((unsigned int)p[1] << 8);
+}
+
+/* The selected driver has own/peer versions 0x0200/0. Its peer-version
+ * predicate and the storage trailer detect incompatibility/corruption, not
+ * factory provenance. Offsets were checked against pinned CFG_Wifi_File.h.
+ * Regulatory payloads and RF admission remain outside this adapter.
+ */
+static inline int
+mt6797_record_commands_from_storage(const u8 *storage, size_t length,
+				    struct mt6797_record_commands *result)
+{
+	struct mt6797_record_commands built = {0};
+	u8 check = 0;
+	size_t i;
+
+	if (!result)
+		return -EINVAL;
+	memset(result, 0, sizeof(*result));
+	if (!storage || length != MT6797_WIFI_STORAGE_BYTES ||
+	    storage[512] != 0xaa)
+		return -EINVAL;
+	for (i = 0; i < MT6797_WIFI_RECORD_BYTES; i++)
+		check = (u8)(i & 1 ? check ^ storage[i] :
+			     check + storage[i]);
+	if (check != storage[513])
+		return -EILSEQ;
+	if (mt6797_record_le16(storage + 2) > 0x0200 ||
+	    mt6797_record_le16(storage + 258) > 0x0200)
+		return -EPROTONOSUPPORT;
+
+	/* A different selected command branch cannot be silently dropped. */
+	if (storage[83] || storage[104] || storage[155] || storage[266])
+		return -EOPNOTSUPP;
+
+	built.base_power = mt6797_record_le16(storage) != 1 && storage[196];
+	if (built.base_power)
+		memcpy(built.base_power_bytes, storage + 12, 40);
+	if (storage[262]) {
+		built.edge_5g = !!storage[62];
+		if (built.edge_5g) {
+			built.edge_5g_bytes[0] = 0;
+			memcpy(built.edge_5g_bytes + 1, storage + 63, 3);
+		}
+		built.ac_5g = !!storage[123];
+		if (built.ac_5g) {
+			built.ac_5g_bytes[0] = 2;
+			memcpy(built.ac_5g_bytes + 1, storage + 112, 11);
+		}
+	}
+	built.edge_2g = !!storage[198];
+	if (built.edge_2g) {
+		memcpy(built.edge_2g_bytes, storage + 199, 3);
+		/* The selected source does not initialize its fourth byte. */
+		built.edge_2g_bytes[3] = 0;
+	}
+	*result = built;
+	return 0;
+}
+
+struct mt6797_wifi_record;
+
+/* The caller retains this immutable object through every normal command.
+ * Preparation reads one complete private firmware-class file and is passive.
+ * The first 512 bytes are the opaque NVRAM command payload; never the trailer.
+ */
+int mt6797_wifi_record_prepare(struct device *dev,
+			       struct mt6797_wifi_record **out);
+const u8 *mt6797_wifi_record_data(const struct mt6797_wifi_record *record);
+const struct mt6797_record_commands *
+mt6797_wifi_record_commands(const struct mt6797_wifi_record *record);
+void mt6797_wifi_record_release(struct mt6797_wifi_record *record);
+
+#endif
