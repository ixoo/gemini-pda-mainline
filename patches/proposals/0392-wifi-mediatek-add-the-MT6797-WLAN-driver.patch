+/*
+ * True only when the post-record normal owner is idle with every TC4 page
+ * returned. A busy context reads as not idle, so callers fail closed.
+ */
+bool mt6797_hif_normal_idle(struct mt6797_hif *hif)
+{
+	const struct mt6797_normal_transaction *t;
+	bool idle;
+
+	if (!hif || !mutex_trylock(&hif->mutex))
+		return false;
+	t = &hif->normal;
+	idle = t->phase == MT6797_NORMAL_NVRAM_SUBMITTED && t->used_sequences &&
+	       t->tc4_limit && t->tc4_limit <= 0xffffU && !t->tc4_pending_cpu &&
+	       !t->tc4_pending_ffa && t->tc4_free == t->tc4_limit &&
+	       t->tc1_free == t->tc1_limit && !t->tc1_pending;
+	mutex_unlock(&hif->mutex);
+	return idle;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_normal_idle);
+
+int mt6797_hif_recycle_sequences(struct mt6797_hif *hif, unsigned int first)
+{
+	struct mt6797_normal_transaction *t;
+	unsigned int sequence;
+	int error = -EBUSY;
+
+	if (!hif || !first || first > 255)
+		return -EINVAL;
+	mutex_lock(&hif->mutex);
+	t = &hif->normal;
+	if (t->phase == MT6797_NORMAL_NVRAM_SUBMITTED && t->used_sequences &&
+	    t->tc4_limit && t->tc4_limit <= 0xffffU && !t->tc4_pending_cpu &&
+	    !t->tc4_pending_ffa && t->tc4_free == t->tc4_limit &&
+	    t->tc1_free == t->tc1_limit && !t->tc1_pending) {
+		for (sequence = first; sequence <= 255; sequence++)
+			t->used_sequences[sequence / 8] &=
+				(unsigned char)~(1U << (sequence % 8));
+		error = 0;
+	}
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_recycle_sequences);
+
+void mt6797_hif_normal_ledger(struct mt6797_hif *hif, struct mt6797_hif_ledger *out)
+{
+	const struct mt6797_normal_transaction *t;
+
+	if (!out)
+		return;
+	*out = (struct mt6797_hif_ledger){0};
+	if (!hif || !mutex_trylock(&hif->mutex)) {
+		out->locked = true;
+		return;
+	}
+	t = &hif->normal;
+	out->phase = t->phase;
+	out->tc4_free = t->tc4_free;
+	out->tc1_free = t->tc1_free;
+	out->tc1_limit = t->tc1_limit;
+	out->tc1_pending = t->tc1_pending;
+	out->tc4_limit = t->tc4_limit;
+	out->pending_cpu = t->tc4_pending_cpu;
+	out->pending_ffa = t->tc4_pending_ffa;
+	out->sequences = !!t->used_sequences;
+	mutex_unlock(&hif->mutex);
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_normal_ledger);
+
+/*
+ * One past the highest command sequence used this boot, from the shared
+ * history that refuses reuse; 256 when none is left. A re-attached mac80211
+ * layer continues from here. -EBUSY when the context is busy, -EIO once the
+ * HIF has failed or outside the post-record normal phase.
+ */
+int mt6797_hif_next_sequence(struct mt6797_hif *hif)
+{
+	const unsigned char *used;
+	int next = 0, i;
+
+	if (!hif || !mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	used = hif->normal.used_sequences;
+	if (hif->first_error || !used ||
+	    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
+		mutex_unlock(&hif->mutex);
+		return -EIO;
+	}
+	for (i = 255; i >= 0; i--) {
+		if (used[i / 8] & (1U << (i % 8))) {
+			next = i + 1;
+			break;
+		}
+	}
+	mutex_unlock(&hif->mutex);
+	return next;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_next_sequence);
+
+/*
+ * Ask the firmware to power WLAN off, as the vendor's adapter stop does:
+ * NIC_POWER_CTRL (0x04) with power mode 1 on TC4, no reply, then WCIR is
+ * polled every millisecond until WLAN_READY (bit 21) clears or the deadline
+ * passes. Whatever the result, this firmware session ends here: the context
+ * refuses every later command. -ETIMEDOUT when the bit never cleared; the
+ * caller escalates nothing. *wcir holds the last WCIR read.
+ */
+int mt6797_hif_power_off(struct mt6797_hif *hif, unsigned int sequence,
+			 u64 deadline_ns, u32 *wcir)
+{
+	static const u8 power_off[4] = { 1 };
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	int error;
+
+	if (!hif || !wcir || sequence > 255)
+		return -EINVAL;
+	*wcir = 0;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || !hif->capability_complete ||
+	    hif->transaction->phase != MT6797_INIT_IDLE ||
+	    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
+		error = -EIO;
+		goto unlock;
+	}
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto out;
+	error = mt6797_normal_prepare_config(&hif->normal,
+					     MT6797_NORMAL_NIC_POWER_CTRL,
+					     sequence, power_off,
+					     sizeof(power_off), hif->scratch,
+					     sizeof(hif->scratch), &command);
+	if (error)
+		goto out;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch, 8 + sizeof(power_off),
+					sizeof(hif->scratch), &transfer);
+	error = mt6797_normal_submitted(&hif->normal, error);
+	while (!error) {
+		error = mt6797_hif_read32_locked(hif, 0, wcir);
+		if (error || !(*wcir & BIT(21)))
+			break;
+		usleep_range(1000, 1500);
+	}
+out:
+	hif->firmware_ready = false;
+	error = mt6797_hif_fail(hif, error ?: -ESHUTDOWN);
+	if (error == -ESHUTDOWN)
+		error = 0;
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_power_off);
+
+int mt6797_hif_send_management(struct mt6797_hif *hif, const u8 *frame,
+			       size_t frame_bytes, u8 wlan, u8 pid,
+			      unsigned int lifetime_ms, unsigned int attempt_count,
+			      u64 deadline_ns)
+{
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	int error;
+
+	if (!hif || !frame)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || !hif->capability_complete ||
+	    hif->transaction->phase != MT6797_INIT_IDLE ||
+	    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
+		error = -EIO;
+		goto unlock;
+	}
+	/* Validate and debit under the same owner before touching the bus.
+	 * Preparation errors have no PIO effects; bus errors never refund debt.
+	 */
+	error = mt6797_join_prepare_management(&hif->normal, frame, frame_bytes,
+					       wlan, pid, lifetime_ms, attempt_count,
+					      hif->scratch, sizeof(hif->scratch),
+					      &command);
+	if (error)
+		goto unlock;
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto fail;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch,
+					MT6797_JOIN_TX_DESC_BYTES + frame_bytes,
+					sizeof(hif->scratch), &transfer);
+	error = mt6797_normal_submitted(&hif->normal, error);
+	if (!error)
+		error = mt6797_hif_guard(hif);
+fail:
+	if (error)
+		error = mt6797_hif_fail(hif, error);
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_send_management);
+
+int mt6797_hif_send_security(struct mt6797_hif *hif, const u8 *frame,
+			     size_t frame_bytes, u8 wlan, u8 pid,
