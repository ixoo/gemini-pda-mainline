+}
+
+/* Ordinary QoS data on any TID mac80211 chose (0-7) with normal
+ * acknowledgment, no A-MSDU and no EOSP is admitted (0291). The station
+ * record is non-QoS, so the descriptor keeps TID 0 and the TC1 queue: the
+ * vendor's single template for a non-QoS station record (nic_tx.c,
+ * nicTxGenerateDescTemplate; in station mode a group destination also goes
+ * through the access point's record, qmDetermineStaRecIndex). Any other QoS
+ * control is refused, counted and the first 16 of a lifetime named by TID,
+ * mac80211's access category, the destination's group bit, the Ethernet
+ * type and an IPv4 TOS byte. Non-QoS frames pass.
+ */
+static bool mt6797_join_qos_tid_refused(struct mt6797_mac *mac, struct sk_buff *skb,
+					const u8 *header, unsigned int hl)
+{
+	static const char *const ac[IEEE80211_NUM_ACS] = { "vo", "vi", "be", "bk" };
+	unsigned int qos, queue;
+	char tos[8] = "n/a";
+	u8 ip[2];
+
+	if (hl != 26)
+		return false;
+	qos = get_unaligned_le16(header + 24);
+	if (!(qos & ~IEEE80211_QOS_CTL_TAG1D_MASK))
+		return false;
+	if (++mac->qos_tx_tid_refused <= 16) {
+		queue = skb_get_queue_mapping(skb);
+		if (header[hl + 6] == 0x08 && !header[hl + 7] &&
+		    !skb_copy_bits(skb, hl + 8, ip, sizeof(ip)) && (ip[0] >> 4) == 4)
+			scnprintf(tos, sizeof(tos), "0x%02x", ip[1]);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN data tx refused: n=%u tid=%u ac=%s qos=0x%04x group=%u type=0x%02x%02x tos=%s\n",
+			 mac->qos_tx_tid_refused, qos & 15,
+			 queue < IEEE80211_NUM_ACS ? ac[queue] : "none", qos,
+			 header[16] & 1, header[hl + 6], header[hl + 7], tos);
+	}
+	return true;
+	return false;
+}
+
+/* Sets the 802.11 header length of a copied data header; always true. */
+static bool mt6797_mac_tx_hdrlen(const u8 *header, unsigned int *hl)
+{
+	*hl = MT6797_JOIN_TX_HDRLEN(mt6797_join_le16(header));
+	return true;
+}
+
+static void mt6797_mac_tx(struct ieee80211_hw *hw,
+			  struct ieee80211_tx_control *control, struct sk_buff *skb)
+{
+	struct mt6797_mac *mac = hw->priv;
+	static const u8 llc_eapol[8] = { 0xaa, 0xaa, 3, 0, 0, 0, 0x88, 0x8e };
+	u8 header[32 + MT6797_JOIN_TX_QOS_EXTRA];
+	unsigned int hl;
+	unsigned long flags;
+	unsigned int fc, subtype;
+	bool accepted = false;
+	bool stop = false;
+
+	/* Phase C2: the supplicant's control-port EAPOL frames, built by
+	 * mac80211 as non-QoS To-DS data frames with the LLC/SNAP EAPOL type to
+	 * the target, at most two per lifetime, only after an accepted
+	 * association and before the deauthentication. They are submitted
+	 * after the station activation as Ethernet II security frames.
+	 */
+	/* With WMM, mac80211 sends the control port's EAPOL as QoS data (its
+	 * own TID) and ordinary data as QoS data; the header is 26 bytes.
+	 */
+	if (skb->len >= sizeof(header) + 4 &&
+	    skb->len <= sizeof(header) + MT6797_JOIN_ETH_MAX_BYTES - 14 &&
+	    (IEEE80211_SKB_CB(skb)->control.flags & IEEE80211_TX_CTRL_PORT_CTRL_PROTO) &&
+	    !skb_copy_bits(skb, 0, header, sizeof(header)) &&
+	    mt6797_mac_tx_hdrlen(header, &hl) &&
+	    (mt6797_join_le16(header) & ~MT6797_JOIN_TX_QOS_BIT) == 0x0108 &&
+	    (hl == 24 || !(header[24] & 0xe0)) &&
+	    !memcmp(header + hl, llc_eapol, sizeof(llc_eapol)) &&
+	    ether_addr_equal(header + 4, mac->join_ap) &&
+	    ether_addr_equal(header + 10, hw->wiphy->perm_addr) &&
+	    ether_addr_equal(header + 16, mac->join_ap)) {
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		if (mac->join_open && mac->join_assoc_received &&
+		    !mac->join_assoc_status && !mac->join_deauth_done &&
+		    mac->join_eapol_tx < 2 &&
+		    skb_queue_len(&mac->join_queue) < 3 &&
+		    mac->join_queue_bytes + skb->len <= 3 * 2304) {
+			mac->join_eapol_tx++;
+			mac->join_queue_bytes += skb->len;
+			__skb_queue_tail(&mac->join_queue, skb);
+			schedule_delayed_work(&mac->join_work, 0);
+			accepted = true;
+		}
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		if (accepted)
+			return;
+	}
+	/* Phase C3: mac80211's ordinary data to the target during the data phase:
+	 * a non-QoS To-DS data frame with the Protected bit (the key is in the
+	 * firmware, so mac80211 leaves no IV space) and an LLC/SNAP header, not
+	 * EAPOL (no rekey on this path), bounded queue. Converted to Ethernet II
+	 * at submission, the mac80211 skb stays the frame whose status is
+	 * reported. Anything else below the admission is freed unsent.
+	 */
+	if (skb->len >= sizeof(header) && skb->len <= sizeof(header) + 1500 &&
+	    !(IEEE80211_SKB_CB(skb)->control.flags & IEEE80211_TX_CTRL_PORT_CTRL_PROTO) &&
+	    IEEE80211_SKB_CB(skb)->control.hw_key &&
+	    !skb_copy_bits(skb, 0, header, sizeof(header)) &&
+	    mt6797_mac_tx_hdrlen(header, &hl) &&
+	    (mt6797_join_le16(header) & ~(0x0800U | MT6797_JOIN_TX_QOS_BIT)) == 0x4108 &&
+	    !mt6797_join_qos_tid_refused(mac, skb, header, hl) &&
+	    !memcmp(header + hl, llc_eapol, 6) &&
+	    !(header[hl + 6] == 0x88 && header[hl + 7] == 0x8e) &&
+	    ether_addr_equal(header + 4, mac->join_ap) &&
+	    ether_addr_equal(header + 10, hw->wiphy->perm_addr)) {
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		if (mac->join_open && mac->join_data_phase && !mac->join_data_ended &&
+		    mac->ccmp_tx_ready &&
+		    IEEE80211_SKB_CB(skb)->control.hw_key == mac->ccmp_ptk &&
+		    mac->join_key_pairwise == 1 && mac->join_key_group == 1 &&
+		    !mac->join_deauth_done &&
+		    skb_queue_len(&mac->join_queue) < MT6797_JOIN_DATA_TX_QUEUE &&
+		    mac->join_queue_bytes + skb->len <= MT6797_JOIN_DATA_TX_QUEUE_BYTES) {
+			mac->join_data_tx_queued++;
+			if (hl == 26) {
+				mac->qos_tx++;
+				mac->qos_tx_tid[header[24] & 7]++;
+			} else {
+				mac->qos_tx_nonqos++;
+			}
+			mac->join_queue_bytes += skb->len;
+			__skb_queue_tail(&mac->join_queue, skb);
+			schedule_delayed_work(&mac->join_work, 0);
+			accepted = true;
+			/* Nearly full: stop mac80211's queues before a frame
+			 * arrives to be freed unsent; the worker wakes them once
+			 * the queue has drained to half (wide hysteresis, so the
+			 * cycle runs at the queue's scale, not the pass cadence).
+			 */
+			if (skb_queue_len(&mac->join_queue) > mac->tx_queue_high_water)
+				mac->tx_queue_high_water = skb_queue_len(&mac->join_queue);
+			if (!mac->tx_queues_stopped &&
+			    (skb_queue_len(&mac->join_queue) >= MT6797_JOIN_DATA_TX_STOP ||
+			     mac->join_queue_bytes + 1550U > MT6797_JOIN_DATA_TX_QUEUE_BYTES)) {
+				mac->tx_queues_stopped = true;
+				mac->tx_queue_stops++;
+				stop = true;
+			}
+		} else if (mac->join_open && mac->join_data_phase &&
+			   !mac->join_data_ended) {
+			mac->tx_dropped_full++;
+		}
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		if (stop)
+			ieee80211_stop_queues(hw);
+		if (accepted)
+			return;
+	}
+	if (skb->len >= 24 && skb->len <= 2304 &&
+	    !skb_copy_bits(skb, 0, header, 24)) {
+		fc = mt6797_join_le16(header);
+		subtype = (fc >> 4) & 15;
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		if (mac->join_open && !(fc & 0xff0f) &&
+		    (mac->join_tx_allowed & BIT(subtype)) &&
+		    mt6797_join_attempt_open(mac, subtype) &&
+		    ether_addr_equal(header + 4, mac->join_ap) &&
+		    ether_addr_equal(header + 10, hw->wiphy->perm_addr) &&
+		    ether_addr_equal(header + 16, mac->join_ap) &&
+		    skb_queue_len(&mac->join_queue) < 3 &&
+		    mac->join_queue_bytes + skb->len <= 3 * 2304) {
+			mt6797_join_attempt_note(mac, subtype);
+			mac->join_queue_bytes += skb->len;
+			__skb_queue_tail(&mac->join_queue, skb);
+			schedule_delayed_work(&mac->join_work, 0);
+			accepted = true;
+		}
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	}
+	if (accepted)
+		return;
+	ieee80211_free_txskb(hw, skb);
+}
+
