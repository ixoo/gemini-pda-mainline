+					 "one-shot WLAN native HIF refused: gate=%s port=%u pre_valid=%u pre_wrplr=0x%08x selected=%u header_valid=%u header=%u setup=%u complete=%u staging=%zu post_valid=%u post_wrplr=0x%08x refused_type_valid=%u refused_type_word=0x%04x\n",
+					 rx.protocol_refusal == MT6797_HIF_RX_REFUSAL_LENGTH ?
+					 "wrplr-length" : "header-length", rx_port, rx.pre_valid,
+					 rx.pre_wrplr, rx.selected_length, rx.header_valid,
+					 rx.header_length, rx.rx_setup, rx.rx_complete,
+					 rx.staging_bytes, rx.post_valid, rx.post_wrplr,
+					 rx.refused_type_valid, rx.refused_type_word);
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN native HIF framing hint: base_valid=%u header_control=0x%02x status_flags=0x%04x\n",
+					 rx.refused_base_valid, rx.refused_header_control,
+					 rx.refused_status_flags);
+			}
+			if (ret == -EAGAIN) {
+				ret = 0;
+				continue;
+			}
+			if (ret == -EPROTO && rx.protocol_refusal != MT6797_HIF_RX_REFUSAL_NONE &&
+			    mac->join_data_phase && mac->join_data_ended && rx.rx_complete) {
+				/* A record framed for the other monitor state, in flight
+				 * across the data-end control toggle. The data phase is over,
+				 * so its payload is not deliverable anyway, and the transfer
+				 * completed, so the FIFO is consistent. Count it and carry on
+				 * with the teardown instead of poisoning the lifetime.
+				 */
+				if (mac->join_teardown_framing_drops++ < 4)
+					dev_info(wiphy_dev(mac->hw->wiphy),
+						 "one-shot WLAN teardown framing drop: port=%u selected=%u header=%u count=%u\n",
+						 rx_port, rx.selected_length, rx.header_length,
+						 mac->join_teardown_framing_drops);
+				ret = 0;
+				continue;
+			}
+			if (ret)
+				goto failed;
+			got = true;
+			branch = 5;
+			/* Count the actual consumed length into the sample or the drain
+			 * bucket. nd_over marks the post-stop phase (window over by any
+			 * reason) for the owed-completion gate below.
+			 */
+			/* The post-stop gate is scoped to the ENABLE_PENDING/ACTIVE
+			 * ending states only. IDLE (unarmed, or after close) and CLOSED
+			 * run the inherited bounded class dispatch -- ordinary plaintext
+			 * stays withheld through native_diag_engaged, not this gate --
+			 * so an old join_data_ended never suppresses their control events.
+			 */
+			nd_over = (mac->native_diag_state == MT6797_ND_ENABLE_PENDING ||
+				   mac->native_diag_state == MT6797_ND_ACTIVE) &&
+				  (mac->native_diag_sample_done || mac->join_data_ended);
+			if (mac->native_diag_state == MT6797_ND_ENABLE_PENDING ||
+			    mac->native_diag_state == MT6797_ND_ACTIVE) {
+				if (!nd_over) {
+					mac->native_diag_total++;
+					mac->native_diag_bytes +=
+						(unsigned int)rx.logical_bytes;
+				} else {
+					mac->native_diag_retire_reads++;
+					mac->native_diag_retire_bytes +=
+						(unsigned int)rx.logical_bytes;
+				}
+			}
+			if (mt6797_ccmp_deauth_late(mac, rx.logical_bytes))
+				continue;
+			if (mt6797_join_event(mac->join_packet, rx.logical_bytes, 0x0f, 16)) {
+				if (!mac->join_inflight &&
+				    mac->join_packet[12] == 1) {
+					struct mt6797_data_owner *owner;
+
+					owner = mt6797_data_find(&mac->data_slots,
+								 mac->join_packet[8]);
+					if (owner) {
+						mac->join_pid = owner->pid;
+						mac->join_frame_deadline = owner->deadline;
+						mac->join_inflight =
+							mt6797_data_take(&mac->data_slots,
+									 owner->pid);
+						mac->join_inflight_data = true;
+					}
+				}
+				/* Exact ABI shape, but no matching host owner. Like the
+				 * public pending-list consumer, complete no skb. A real
+				 * pending frame keeps its unchanged deadline.
+				 */
+				if (!mac->join_inflight ||
+				    mac->join_packet[8] != mac->join_pid ||
+				    mac->join_packet[12] != 1)
+					continue;
+				if (!mac->join_inflight ||
+				    !mt6797_join_tx_done(mac->join_packet, rx.logical_bytes,
+							 mac->join_pid, 1, &result) ||
+				    (result.status > 7 &&
+				     (result.status < 32 || result.status > 34))) {
+					ret = -EPROTO;
+					goto failed;
+				}
+				if (mac->join_pid != MT6797_JOIN_PID_RESERVED) {
+					if (!mt6797_join_pid_complete(&mac->ccmp_pid_pool,
+								      mac->join_pid)) {
+						ret = -EPROTO;
+						goto failed;
+					}
+				}
+				pump_progress = true;
+				completed = mac->join_inflight;
+				mac->join_inflight = NULL;
+				if (completed == mac->join_internal) {
+					completed_internal = true;
+					mac->join_internal = NULL;
+				}
+				ack = result.status == 0;
+				mac->join_last_acked = ack;
+				if (completed_internal) {
+					mac->join_deauth_done = ack;
+					mac->join_deauth_status_valid = true;
+					mac->join_deauth_status = result.status;
+				}
+				complete_all(&mac->join_frame_done);
+				ieee80211_tx_info_clear_status(IEEE80211_SKB_CB(completed));
+				IEEE80211_SKB_CB(completed)->flags &= ~IEEE80211_TX_STAT_ACK;
+				if (ack)
+					IEEE80211_SKB_CB(completed)->flags |= IEEE80211_TX_STAT_ACK;
+				if (mac->join_inflight_data)
+					mt6797_mac_tx_rate_status(completed, result.count);
+				if (mac->join_inflight_data) {
+					/* A data frame the AP did not acknowledge is reported
+					 * to mac80211 and counted, never a fault by itself;
+					 * eight in a row end the data phase.
+					 */
+					mac->join_inflight_data = false;
+					__skb_queue_tail(&data_completed, completed);
+					completed = NULL;
+					mt6797_mac_data_tx_counted(mac, ack);
+					continue;
+				}
+				if (!ack) {
+					ret = -ENOLINK;
+					goto failed;
+				}
+				continue;
+			}
+			/* Post-stop (window over), the exact TX-done above is the only owed
+			 * RX completion; the broad control dispatcher and every other class
+			 * (beacon, EAPOL, group, data) are not resumed outside the admitted
+			 * limits -- the disable's own credit retires by the register guard,
+			 * not an RX control event.
+			 */
+			if (nd_over)
+				continue;
+			if (rx.logical_bytes >= 8 &&
+			    mt6797_join_le16(mac->join_packet + 2) == 0xe000) {
+				branch = 6;
+				ret = mt6797_mac_join_control_event(mac, rx.logical_bytes);
+				if (ret == -EPROTO &&
+				    mt6797_ccmp_owned_loss(mac, rx.logical_bytes))
+					ret = 0;
+				if (ret) {
+					/* Header metadata, and the body of a four-byte notice
+					 * (no address fits in it); no other body bytes.
+					 */
+					dev_info(wiphy_dev(mac->hw->wiphy),
+						 "one-shot WLAN join control event refused: status=%d bytes=%zu type=0x%04x id=0x%02x seq=%u\n",
+						 ret, rx.logical_bytes,
+						 mt6797_join_le16(mac->join_packet + 2),
+						 rx.logical_bytes >= 8 ? mac->join_packet[4] : 0,
+						 rx.logical_bytes >= 8 ? mac->join_packet[5] : 0);
+					goto failed;
+				}
+				ret = mt6797_rx_reorder_apply(mac, &received);
+				if (ret)
+					goto failed;
+				continue;
+			}
+			/* Parseable beacons are asynchronous, never an epoch fence. */
+			branch = 7;
+			if (!mt6797_scan_frame(mac->join_packet, rx.logical_bytes, &beacon)) {
+				/* The target's clear beacon (the scan decoder's class:
+				 * unprotected, clean status) on the join channel after an
+				 * accepted association is delivered to mac80211 (0176);
+				 * every other parseable beacon is skipped as before.
+				 */
+				const u8 *f = mac->join_packet + beacon.offset;
+
+				if (mac->join_assoc_received && !mac->join_assoc_status &&
+				    !mac->join_cleanup_done && beacon.channel == 40 &&
+				    (mt6797_join_le16(f) & 0x00ff) == 0x0080 &&
+				    ether_addr_equal(f + 10, mac->join_ap) &&
+				    ether_addr_equal(f + 16, mac->join_ap)) {
+					ret = mt6797_mac_join_deliver_beacon(mac, beacon.offset,
+									     beacon.bytes, beacon.rcpi,
+									     false, &received);
+					if (ret)
+						goto failed;
+				}
+				continue;
+			}
+			/* The target's beacon class in the keyed descriptor variant
+			 * (runtime 26, once the group key sits under the broadcast
+			 * entry; action-frame.h names the observed and the
+			 * source-defined conditions; the vendor delivers management
+			 * frames regardless of the cipher-mismatch flag and drops only
+			 * ICV errors) is delivered to mac80211 like the clear beacon
+			 * (0176), counted; a beacon cannot be a fence either.
+			 */
+			if (mac->join_key_group == 1 && !mac->join_cleanup_done &&
+			    mt6797_join_keyed_beacon(mac->join_packet, rx.logical_bytes, 40,
+						     mac->join_ap, MT6797_JOIN_BMC_WLAN_INDEX,
+						     &action)) {
+				ret = mt6797_mac_join_deliver_beacon(mac, 16 + 16 + 8 + 24,
+								     action.bytes, action.rcpi,
+								     true, &received);
+				if (ret)
+					goto failed;
+				continue;
+			}
+			/* Phase C2: a clear EAPOL-Key frame from the target to this
+			 * station on the join channel (0140 decoder) is delivered to
+			 * mac80211 as a native data frame (the rebuilt header for the
+			 * translated layout), at most twice, only after a status-0
+			 * association response and before the deauthentication completes;
+			 * whether the station was already activated is recorded. mac80211
+			 * admits control-port data from a known station before its
+			 * association flag and routes it to the connection owner. Any
+			 * other shape, or a third frame, reaches the refusal below.
+			 */
+			eapol_gate = mt6797_eapol_rx_gate(mac->join_packet, rx.logical_bytes,
+							  40, mac->hw->wiphy->perm_addr,
+							mac->join_ap, &eapol);
+			if (eapol_gate == MT6797_EAPOL_OK &&
+			    mac->join_assoc_received && !mac->join_assoc_status &&
+			    !mac->join_deauth_done && !mac->join_cleanup_done &&
+			    mac->join_eapol_seen < 2 &&
+			    /* BSSID tag 15, observed before the station activation
+			     * (runtimes 12 and 15, message 1), is admitted only until the
+			     * successful BSS command credit completion is recorded; tag 1
+			     * from the accepted association on. Tag 1 was first observed
+			     * after the station activation (runtime 15, message 3), and
+			     * boots AA and AA3 observed it on message 1, 24 ms after the
+			     * association response and before the activation, where waiting
+			     * for the activation cost the access point's one-second
+			     * retransmission (0305). The supplicant's reply still waits for
+			     * the activation in the transmit queue. The field is filled by
+			     * the firmware and unused by the pinned receive path; any other
+			     * value is refused and named by the frame gate below. The rest
+			     * of the decoder's framing gates verify that packet next.
+			     */
+			    ((eapol.bss_index == 15 && !mac->join_bss_configured) ||
+			     eapol.bss_index == 1)) {
+				mt6797_mac_eapol_trace(mac, rx.logical_bytes, "admitted", "ok",
+						       eapol_gate, eapol.bytes);
+				mac->join_eapol_seen++;
+				skb = dev_alloc_skb(eapol.prefix_bytes + eapol.bytes);
+				if (!skb) {
+					ret = -ENOMEM;
+					goto failed;
+				}
+				if (eapol.prefix_bytes)
+					skb_put_data(skb, eapol.prefix, eapol.prefix_bytes);
+				skb_put_data(skb, mac->join_packet + eapol.offset, eapol.bytes);
+				memset(IEEE80211_SKB_RXCB(skb), 0,
+				       sizeof(struct ieee80211_rx_status));
+				IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
+				IEEE80211_SKB_RXCB(skb)->freq = 5200;
+				if (eapol.signal_valid)
+					IEEE80211_SKB_RXCB(skb)->signal = eapol.signal_dbm;
+				else
+					IEEE80211_SKB_RXCB(skb)->flag |= RX_FLAG_NO_SIGNAL_VAL;
+				__skb_queue_tail(&received, skb);
+				continue;
+			}
+			mt6797_mac_eapol_trace(mac, rx.logical_bytes, "refused",
+					       eapol_gate != MT6797_EAPOL_OK ? mt6797_eapol_gate_name(eapol_gate) :
+				!mac->join_assoc_received || mac->join_assoc_status ? "association" :
+				mac->join_deauth_done ? "deauth-ended" :
+				mac->join_cleanup_done ? "cleanup-done" :
+				mac->join_eapol_seen >= 2 ? "delivery-cap" : "bss-interval",
+				eapol_gate, eapol_gate == MT6797_EAPOL_OK ? eapol.bytes : 0);
+
+			/* Phase C3: during the data phase, after both key credits and
+			 * before the deauthentication, a protected firmware-decrypted
+			 * translated non-aggregated non-QoS data frame of the two
+			 * source-defined classes (data-rx.h) is delivered to mac80211
+			 * as the 802.11 frame it would have seen: rebuilt header, LLC
+			 * and SNAP, the body as received, with the decrypted and
+			 * stripped flags (no PN is available, so no replay protection
+			 * is claimed). EAPOL-typed data is not admitted (no rekey) and
+			 * reaches the refusal below; aggregated, QoS or any other shape
+			 * reaches it too. Delivery is capped per lifetime; frames above
+			 * the cap are dropped undelivered and counted.
+			 */
+			if (mac->native_diag_engaged) {
+				struct mt6797_native_diag_budget nb = {
+					mac->native_diag_started ?
+					(unsigned int)((ktime_get_ns() -
+					 mac->native_diag_started) / NSEC_PER_MSEC) : 0,
+					mac->native_diag_total, mac->native_diag_native,
+					mac->native_diag_bytes };
+				bool admitted;
+				struct mt6797_native_beacon nbcn;
+
+				nb.native_rx = mac->ccmp_queued;
+				admitted = mac->native_diag_state == MT6797_ND_ACTIVE &&
+					mt6797_ccmp_diag_budget_step(&nb) ==
+					MT6797_NATIVE_DIAG_CONTINUE;
+				/* Class7 beacon paths above stay unchanged. A raw class2 beacon
+				 * in the ACTIVE sample uses the same normal mac80211 delivery,
+				 * after central all-RX accounting and the existing admission.
+				 * It is not a protected-native ordinary-data eligibility call.
+				 */
+				if (admitted && mac->join_assoc_received &&
+				    !mac->join_assoc_status && !mac->join_cleanup_done &&
+				    !mac->join_deauth_done &&
+				    mt6797_native_beacon(mac->join_packet, rx.logical_bytes,
+							 40, mac->join_ap, &nbcn)) {
+					ret = mt6797_mac_join_deliver_beacon(mac, nbcn.offset,
+									     nbcn.bytes, nbcn.rcpi,
+									     false, &received);
+					if (ret)
+						goto failed;
+					continue;
+				}
+				if (admitted)
+					ret = mt6797_ccmp_queue_rx(mac, rx.logical_bytes,
+								   &received);
+				if (ret)
+					goto failed;
+				continue;
+			}
+			/* The strict directed management path; no ordinary legacy
+			 * data fallback.
+			 */
+			if (!mt6797_join_rx_frame(mac->join_packet, rx.logical_bytes, 40,
+						  mac->hw->wiphy->perm_addr, mac->join_ap,
+						  mac->join_rx_allowed, &frame))
+				continue;
+			body = mac->join_packet + frame.offset;
+			if (frame.subtype == 11) {
+				if (!(mac->join_submitted & BIT(11)) || mac->join_auth_received) {
+					ret = -EPROTO;
+					goto failed;
+				}
+				mac->join_auth_received = true;
+				mac->join_auth_ok = !get_unaligned_le16(body + 28);
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN join RX: subtype=11 status=%u\n",
+					 get_unaligned_le16(body + 28));
+			} else if (frame.subtype == 1) {
+				if (!(mac->join_submitted & BIT(0)) || mac->join_assoc_received) {
+					ret = -EPROTO;
+					goto failed;
+				}
+				mac->join_assoc_received = true;
+				mac->join_short_preamble = !!(get_unaligned_le16(body + 24) & BIT(5));
+				mac->join_assoc_status = get_unaligned_le16(body + 26);
+				mac->join_aid = get_unaligned_le16(body + 28) & 0x3fff;
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN join RX: subtype=1 status=%u\n",
+					 mac->join_assoc_status);
+				mt6797_join_assoc_wmm(mac, body, frame.bytes);
+				mt6797_join_assoc_ht(mac, body, frame.bytes);
+				if (!mac->join_assoc_status &&
+				    (!mac->join_aid || mac->join_aid > 2007)) {
+					ret = -EPROTO;
+					goto failed;
+				}
+			}
+			skb = dev_alloc_skb(frame.bytes);
+			if (!skb) {
+				ret = -ENOMEM;
+				goto failed;
+			}
+			skb_put_data(skb, mac->join_packet + frame.offset, frame.bytes);
+			memset(IEEE80211_SKB_RXCB(skb), 0, sizeof(struct ieee80211_rx_status));
+			IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
+			IEEE80211_SKB_RXCB(skb)->freq = 5200;
+			IEEE80211_SKB_RXCB(skb)->signal = frame.signal_dbm;
+			__skb_queue_tail(&received, skb);
+		}
+		if (!got)
+			break;
+	}
+	/* The bubble deadline is checked here, on every pass: no timer and
+	 * no wait; a pass comes at least every 20 ms while the lifetime runs.
+	 */
+	ret = mt6797_rx_reorder_expire_all(mac, &received);
+	if (ret)
+		goto failed;
+	branch = 8;
+	ret = mt6797_mac_join_cleanup_step(mac);
+	if (ret)
+		goto failed;
+	/* Rendezvous (proposal 0180): both the worker's healthy stage-3 cleanup
+	 * and the mac80211 station teardown (NOTEXIST) observed, the lifetime
+	 * quiescent and not poisoned, under the two-lifetime cap -> re-arm once
+	 * here in the serialized worker. A wire-identity wrap poisons instead.
+	 */
+	/* Rendezvous (0180): once the healthy stage-3 cleanup and the mac80211
+	 * NOTEXIST teardown are both seen and the lifetime is not poisoned, queue
+	 * the dedicated re-arm pass (handled at the worker top). Scheduling, not an
+	 * inline reset, so the re-arm never runs while this pass holds local SKBs.
+	 */
+	if (mac->join_cleanup_done && mac->join_sta_removed && !mac->join_closed &&
+	    !mac->first_error && !mac->closing && !mac->join_rearm_pending) {
+		mac->join_rearm_pending = true;
+		schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
+	}
+	pass_delay = msecs_to_jiffies(20);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	unsigned int delay_ms;
+	bool pending = !skb_queue_empty(&mac->join_queue) ||
+		mac->join_inflight || mac->data_slots.count || mac->join_credit_pending ||
+		mac->join_page_debt || mac->join_data_page_debt;
+
+	delay_ms = mt6797_join_pump_delay(&mac->join_pump_zero_runs,
+					  pending, pump_progress);
+	pass_delay = msecs_to_jiffies(delay_ms);
+	if (mac->join_running)
+		schedule_delayed_work(&mac->join_work, pass_delay);
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	goto unlock;
+failed:
+	ret = mt6797_mac_join_fail_stop(mac, ret, branch, &discard, &internal);
+unlock:
+	mutex_unlock(&mac->mutex);
+	/* One worker serializes RX_ni and TX_status_ni, outside driver locks. */
+	mutex_lock(&mac->ccmp_receive_mutex);
+	while ((skb = skb_dequeue(&mac->credit_retired_queue)))
+		ieee80211_tx_status_ni(mac->hw, skb);
+	while ((skb = __skb_dequeue(&data_completed)))
+		ieee80211_tx_status_ni(mac->hw, skb);
+	if (completed) {
+		if (completed_internal)
+			dev_kfree_skb(completed);
+		else
+			ieee80211_tx_status_ni(mac->hw, completed);
+	}
+	while ((skb = __skb_dequeue(&received))) {
+		if (ret)
+			dev_kfree_skb(skb);
+		else
+			mt6797_ccmp_receive(mac, skb);
+	}
+	mutex_unlock(&mac->ccmp_receive_mutex);
+	while ((skb = __skb_dequeue(&discard))) {
+		if (skb == internal)
+			dev_kfree_skb(skb);
+		else
+			ieee80211_free_txskb(mac->hw, skb);
+	}
+}
+
+/* Enter and return with the MAC mutex held. Polling must run while we wait. */
+/* A join command the host refused before any write (-EINVAL from the
+ * payload encoder or the HIF argument checks) owes the device nothing:
+ * release the page reservation and the credit wait so the join stops with
+ * a true debt. Pages already written are never released here.
+ */
+void mt6797_mac_join_refused(struct mt6797_mac *mac, int ret)
+{
+	if (ret != -EINVAL)
+		return;
+	mac->join_page_debt = 0;
+	mac->join_credit_pending = false;
+}
+
+int mt6797_mac_join_wait_credit(struct mt6797_mac *mac)
+{
+	u64 now = ktime_get_ns(), deadline = mac->join_credit_deadline;
+	unsigned long timeout;
+
+	if (now >= deadline)
+		return -ETIMEDOUT;
+	timeout = nsecs_to_jiffies(deadline - now) + 1;
+	mutex_unlock(&mac->mutex);
+	wait_for_completion_timeout(&mac->join_credit_done, timeout);
+	mutex_lock(&mac->mutex);
+	if (mac->first_error)
+		return mac->first_error;
+	if (mac->closing || mac->join_retired || !mac->join_running)
+		return -ECANCELED;
+	/* The waiter owns exactly one pending credit: the worker clears
+	 * join_credit_pending only when the owed pages have all returned
+	 * (before the credit deadline, which the worker enforces itself) and
+	 * completes join_credit_done. Once cleared, the same worker iteration
+	 * may already have submitted a queued frame and recharged the shared
+	 * page debt for it (runtime 23: message 4 went out 1 ms after the
+	 * pairwise key's credit), so the debt is the frame's, not this
+	 * command's, and is not consulted here.
+	 */
+	if (mac->join_credit_pending)
+		return -ETIMEDOUT;
+	return 0;
+}
+
+/* Drain the exact submitted management frame before advancing host state. */
+int mt6797_mac_join_wait_management(struct mt6797_mac *mac)
+{
+	u64 now, deadline;
+
+	if (mac->join_inflight) {
+		now = ktime_get_ns();
+		deadline = min(mac->join_frame_deadline, mac->join_deadline);
+		if (now >= deadline)
+			return -ETIMEDOUT;
+		mutex_unlock(&mac->mutex);
+		wait_for_completion_timeout(&mac->join_frame_done,
+					    nsecs_to_jiffies(deadline - now) + 1);
+		mutex_lock(&mac->mutex);
+		if (mac->first_error)
+			return mac->first_error;
+		if (mac->closing || mac->join_retired || !mac->join_running)
+			return -ECANCELED;
+		if (ktime_get_ns() >= deadline || mac->join_inflight)
+			return -ETIMEDOUT;
+	}
+	if (!mac->join_last_acked)
+		return -ENOLINK;
+	if (mac->join_page_debt) {
+		mac->join_credit_deadline = min_t(u64, mac->join_deadline,
+						  ktime_get_ns() + 100 * NSEC_PER_MSEC);
+		reinit_completion(&mac->join_credit_done);
+		mac->join_credit_pending = true;
+		return mt6797_mac_join_wait_credit(mac);
+	}
+	return mt6797_hif_normal_idle(mac->hif) ? 0 : -EPROTO;
+}
+
+/* The grant event and its command credits are independent completions. */
+static int mt6797_mac_join_wait_channel(struct mt6797_mac *mac, u64 deadline)
+{
+	u64 now = ktime_get_ns();
+	unsigned long timeout;
+
+	if (now >= deadline)
+		return -ETIMEDOUT;
+	timeout = nsecs_to_jiffies(deadline - now) + 1;
+	mutex_unlock(&mac->mutex);
+	wait_for_completion_timeout(&mac->join_channel_done, timeout);
+	mutex_lock(&mac->mutex);
+	if (mac->first_error)
+		return mac->first_error;
+	if (mac->closing || mac->join_retired || !mac->join_running)
+		return -ECANCELED;
+	if (ktime_get_ns() >= deadline || mac->join_channel_pending ||
+	    !mac->join_channel_granted ||
+	    mac->join_grant_deadline <= ktime_get_ns() + 3 * NSEC_PER_SEC)
+		return -ETIMEDOUT;
+	return 0;
+}
+
+/* One peer slot per firmware session. This admits setup, never management TX. */
+int mt6797_mac_join_add_peer(struct mt6797_mac *mac,
+			     struct ieee80211_vif *vif,
+				    struct ieee80211_sta *sta)
+{
+	unsigned int desired, basic, refused;
+	u64 grant_wait;
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&mac->mutex);
+	if (mac->scan_active || !mac->join_scan_ready) {
+		refused = (mac->scan_active ? BIT(0) : 0) |
+			  (mac->join_scan_ready ? 0 : BIT(1));
+		goto refuse;
+	}
+	mutex_unlock(&mac->mutex);
+	/* scan_completed can expose this callback before scan_work returns. */
+	cancel_delayed_work_sync(&mac->scan_work);
+	mutex_lock(&mac->mutex);
+	/* Every precondition is evaluated so a refusal names all of them. */
+	refused = (vif != mac->vif ? BIT(2) : 0) |
+		  (vif->valid_links || sta->mlo || sta->valid_links ? BIT(3) : 0) |
+		  (mac->started ? 0 : BIT(4)) | (mac->configured ? 0 : BIT(5)) |
+		  (mac->scan_active ? BIT(0) : 0) | (mac->join_scan_ready ? 0 : BIT(1)) |
+		  (mac->bss_active ? 0 : BIT(6)) | (mac->join_running ? 0 : BIT(7)) |
+		  (mac->join_bss_valid ? 0 : BIT(8)) |
+		  (mac->join_channel_valid ? 0 : BIT(9)) |
+		  (mac->join_peer_used ? BIT(10) : 0) |
+		  (mac->join_retired || mac->closing ? BIT(11) : 0) |
+		  (mac->first_error ? BIT(12) : 0) |
+		  (mac->join_page_debt ? BIT(13) : 0) |
+		  (ktime_get_ns() >= mac->join_deadline ? BIT(14) : 0) |
+		  (mac->sequence > 248 ? BIT(15) : 0) |
+		  (mt6797_hif_normal_idle(mac->hif) ? 0 : BIT(16)) |
+		  (ether_addr_equal(sta->addr, mac->join_bssid) ? 0 : BIT(17)) |
+		  (mt6797_join_legacy_rates(sta->deflink.supp_rates[NL80211_BAND_5GHZ],
+					    mac->join_basic_rates, &desired, &basic) ?
+		   0 : BIT(18));
+	if (refused)
+		goto refuse;
+	ether_addr_copy(mac->join_ap, sta->addr);
+	mac->join_desired_rates = desired;
+	mac->join_peer_basic_rates = basic;
+	/* Reserve before any PIO: failure never authorizes a second peer attempt. */
+	mac->join_peer_used = true;
+	mac->join_eapol_seen = 0;
+	mac->join_eapol_trace = 0;
+	mac->join_eapol_refused = 0;
+	mac->ccmp_rx_refused = 0;
+	mac->join_data_llc_discarded = 0;
+	mac->join_data_credits = 0;
+	mac->join_data_started = 0;
+	mac->join_key_pairwise_submitted = false;
+	mac->join_key_group_submitted = false;
+	mac->join_key_done = false;
+	mac->join_key_done_second = false;
+	mac->join_hold_until = 0;
+	mac->join_credit_deadline = min_t(u64, mac->join_deadline,
+					  ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 1;
+	ret = mt6797_hif_join_filter(mac->hif, mac->sequence++,
+				     mac->join_credit_deadline);
+	mt6797_mac_join_refused(mac, ret);
+	if (!ret)
+		ret = mt6797_mac_join_wait_credit(mac);
+	if (ret)
+		goto failed;
+	/* A fresh token is reserved once, before the first request write. */
+	mac->join_channel_token = 1;
+	mac->join_requested_ms = 9000;
+	mac->join_channel_pending = true;
+	reinit_completion(&mac->join_channel_done);
+	grant_wait = min_t(u64, mac->join_deadline,
+			   ktime_get_ns() + 750 * NSEC_PER_MSEC);
+	mac->join_credit_deadline = min_t(u64, grant_wait,
+					  ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 1;
+	ret = mt6797_hif_join_channel_sco(mac->hif, mac->sequence++,
+					  mac->join_channel_token, 40, mac->join_sco,
+					  mac->join_requested_ms,
+					  mac->join_credit_deadline);
+	mt6797_mac_join_refused(mac, ret);
+	if (!ret)
+		ret = mt6797_mac_join_wait_credit(mac);
+	if (!ret)
+		ret = mt6797_mac_join_wait_channel(mac, grant_wait);
+	if (ret)
+		goto failed;
+	mac->join_credit_deadline = min_t(u64, mac->join_deadline,
+					  ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 2;
+	ret = mt6797_hif_join_station(mac->hif, mac->sequence++, mac->join_ap,
+				      1, 0, desired, basic,
+				      mac->join_credit_deadline);
+	mt6797_mac_join_refused(mac, ret);
+	if (!ret)
+		ret = mt6797_mac_join_wait_credit(mac);
+	if (!ret) {
+		mac->join_peer_ready = true;
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join peer: ready=1 sequence=%u\n", mac->sequence);
+		goto out;
+	}
+failed:
+	if (!mac->first_error)
+		mac->first_error = ret;
+	mac->closing = true;
+	mac->join_retired = true;
+	mac->join_credit_pending = false;
+	mac->join_channel_pending = false;
+	mac->join_sta_pending = false;
+	complete_all(&mac->join_credit_done);
+	complete_all(&mac->join_frame_done);
+	complete_all(&mac->join_channel_done);
+	complete_all(&mac->join_sta_done);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	goto out;
+refuse:
+	/* Diagnostic only: the refusal still establishes no peer state. */
+	ret = -EOPNOTSUPP;
+	if (!mac->join_peer_refusal_logged) {
+		mac->join_peer_refusal_logged = true;
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join peer refused: reasons=0x%05x supported=0x%x basic=0x%x sequence=%u\n",
+			 refused, sta->deflink.supp_rates[NL80211_BAND_5GHZ],
+			 mac->join_basic_rates, mac->sequence);
+	}
+out:
+	mutex_unlock(&mac->mutex);
+	return ret;
+}
+
+/* Called with the MAC mutex held; every wait releases it for the poller. */
+/* Connection indication belongs to the first fresh post-association beacon,
+ * before association returns to key installation. MAC mutex held on entry and
+ * return; its existing phase deadline also bounds metadata and command credit.
+ */
+static int mt6797_ccmp_pm_indicate(struct mt6797_mac *mac, u64 phase_deadline)
+{
+	u64 now = ktime_get_ns(), deadline;
+	int ret;
+
+	if (!mac->ccmp_dtim_valid && now < phase_deadline) {
+		mutex_unlock(&mac->mutex);
+		wait_for_completion_timeout(&mac->ccmp_dtim_done,
+					    nsecs_to_jiffies(phase_deadline - now) + 1);
+		mutex_lock(&mac->mutex);
+	}
+	now = ktime_get_ns();
+	if (mac->first_error || mac->closing || mac->join_retired || mac->ccmp_closed ||
+	    !mac->join_running) {
+		ret = mac->first_error ? mac->first_error : -ECANCELED;
+		goto out;
+	}
+	if (now >= phase_deadline || now >= mac->join_deadline || !mac->ccmp_dtim_valid) {
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+	if (mac->ccmp_pm_attempted || !mac->join_bss_configured || !mac->join_sta_active ||
+	    mac->join_key_pairwise || mac->join_key_group ||
+	    mac->join_key_pairwise_submitted || mac->join_key_group_submitted) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (mac->sequence > 253) {
+		ret = -ENOSPC;
+		goto out;
+	}
+	if (mac->join_inflight || mac->data_slots.count || mac->join_page_debt ||
+	    mac->join_credit_pending ||
+	    !mt6797_hif_normal_idle(mac->hif)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	deadline = min_t(u64, phase_deadline,
+			 min_t(u64, mac->join_deadline, now + 100 * NSEC_PER_MSEC));
+	mac->join_credit_deadline = deadline;
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 1;
+	mac->ccmp_pm_attempted = true;
+	ret = mt6797_hif_join_pm_connected(mac->hif, mac->sequence++,
+					   mac->ccmp_dtim_period, mac->join_aid,
+					   mac->join_beacon_interval, deadline);
+	mt6797_mac_join_refused(mac, ret);
+	if (!ret)
+		ret = mt6797_mac_join_wait_credit(mac);
+	if (!ret && (mac->ccmp_closed || mac->closing || mac->join_retired || mac->first_error))
+		ret = mac->first_error ? mac->first_error : -ECANCELED;
+	if (!ret && ktime_get_ns() >= deadline)
+		ret = -ETIMEDOUT;
+	if (!ret) {
+		mac->ccmp_pm_connected = true;
+		mac->ccmp_pm_credit_ns = ktime_get_ns();
+	}
+out:
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN PM connection: attempted=%u credited=%u status=%d dtim_valid=%u dtim_status=%d keys=%u%u\n",
+		 mac->ccmp_pm_attempted, mac->ccmp_pm_connected, ret, mac->ccmp_dtim_valid,
+		 mac->ccmp_dtim_status, mac->join_key_pairwise_submitted,
+		 mac->join_key_group_submitted);
+	return ret;
+}
+
+int mt6797_mac_join_associate(struct mt6797_mac *mac, unsigned int aid)
+{
+	u64 deadline, now;
+	int ret;
+	const u8 *ht_cap = NULL, *ht_op = NULL;
+	u8 ht_op40[22];
+
+	if (!mac->join_assoc_received || mac->join_assoc_status ||
+	    !mac->join_ssid_bytes || !aid || aid > 2007 || aid != mac->join_aid ||
+	    mac->join_bss_configured || mac->join_sta_active || mac->join_sta_pending ||
+	    mac->sequence > 251)
+		return -EOPNOTSUPP;
+	ret = mt6797_mac_join_wait_management(mac);
+	if (ret)
+		return ret;
+	mac->ccmp_dtim_valid = false;
+	mac->ccmp_dtim_period = 0;
+	mac->ccmp_dtim_status = -ENODATA;
+	reinit_completion(&mac->ccmp_dtim_done);
+	/* Pinned vendor AIS applies BSS/RLM before the associated STA record. */
+	mac->join_credit_deadline = min_t(u64, mac->join_deadline,
+					  ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 1;
+	/* Both records declare HT only with WMM records and the access point's
+	 * accepted HT; the element bodies are named once, as sent (0295).
+	 */
+	if (mac->join_wmm_accepted && mac->join_ht_accepted &&
+	    mac->join_ht_op_seen && mac->join_ht_peer_cap_seen) {
+		ht_cap = mac->join_ht_peer_cap;
+		ht_op = mac->join_ht_op;
+		/* As rlm.c does when 40 MHz is not allowed: without an HT40
+		 * join, info 1 drops its secondary offset and channel width.
+		 */
+		memcpy(ht_op40, mac->join_ht_op, sizeof(ht_op40));
+		if (mac->join_sco != 3)
+			ht_op40[1] &= ~0x07;
+		ht_op = ht_op40;
+	}
+	ret = mt6797_hif_join_bss_qos(mac->hif, mac->sequence++, mac->join_ap,
+				      mac->join_ssid, mac->join_ssid_bytes,
+				     mac->join_desired_rates, mac->join_peer_basic_rates,
+				     mac->join_short_preamble, mac->join_rsn,
+				     mac->join_wmm_accepted &&
+				     1,
+				     ht_op, mac->join_credit_deadline);
+	mt6797_mac_join_refused(mac, ret);
+	if (!ret)
+		ret = mt6797_mac_join_wait_credit(mac);
+	if (ret)
+		return ret;
+	mac->join_bss_configured = true;
+	mac->join_sta_sequence = mac->sequence++;
+	mac->join_sta_pending = true;
+	reinit_completion(&mac->join_sta_done);
+	deadline = min_t(u64, mac->join_deadline,
+			 ktime_get_ns() + 750 * NSEC_PER_MSEC);
+	mac->join_credit_deadline = min_t(u64, deadline,
+					  ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 2;
+	ret = mt6797_hif_join_station_qos(mac->hif, mac->join_sta_sequence,
+					  mac->join_ap, 3, aid, mac->join_desired_rates,
+					 mac->join_peer_basic_rates,
+					 mac->join_wmm_accepted &&
+					 1,
+					 ht_cap, mac->join_credit_deadline);
+	mt6797_mac_join_refused(mac, ret);
+	if (!ret)
+		ret = mt6797_mac_join_wait_credit(mac);
+	if (ret)
+		return ret;
+	now = ktime_get_ns();
+	if (now >= deadline)
+		return -ETIMEDOUT;
+	mutex_unlock(&mac->mutex);
+	wait_for_completion_timeout(&mac->join_sta_done,
+				    nsecs_to_jiffies(deadline - now) + 1);
+	mutex_lock(&mac->mutex);
+	if (mac->first_error)
+		return mac->first_error;
+	if (mac->closing || mac->join_retired || !mac->join_running)
+		return -ECANCELED;
+	if (ktime_get_ns() >= deadline || mac->join_sta_pending || !mac->join_sta_active)
+		return -ETIMEDOUT;
+	return mt6797_ccmp_pm_indicate(mac, deadline);
+}
+
+/* Reserve cleanup once. An accepted join gets exactly one owned deauth skb. */
+int mt6797_mac_join_request_cleanup(struct mt6797_mac *mac)
+{
+	struct sk_buff *skb = NULL;
+	unsigned long flags;
+	u8 *frame;
+
+	if (mac->join_cleanup_requested || mac->join_cleanup_done)
+		return 0;
+	if (!mac->join_peer_used || !mac->join_running || mac->join_retired ||
+	    mac->first_error || mac->closing)
+		return -ECANCELED;
+	if (mac->sequence > 253)
+		return -ENOSPC;
+	if (ktime_get_ns() + 1200 * NSEC_PER_MSEC >= mac->join_deadline)
+		return -ETIMEDOUT;
+	if (mac->join_sta_active) {
+		/* Before the channel release the reserved deauthentication needs
+		 * the live grant with room for it; after the release (data phase)
+		 * the connected BSS transmits it without a privilege.
+		 */
+		if (!mac->join_assoc_received || mac->join_assoc_status ||
+		    (!mac->join_channel_released &&
+		     (!mac->join_channel_granted ||
+		      ktime_get_ns() + 1200 * NSEC_PER_MSEC >= mac->join_grant_deadline)))
+			return -ETIMEDOUT;
+		skb = dev_alloc_skb(26);
+		if (!skb)
+			return -ENOMEM;
+		frame = skb_put_zero(skb, 26);
+		put_unaligned_le16(IEEE80211_STYPE_DEAUTH, frame);
+		ether_addr_copy(frame + 4, mac->join_ap);
+		ether_addr_copy(frame + 10, mac->hw->wiphy->perm_addr);
+		ether_addr_copy(frame + 16, mac->join_ap);
+		put_unaligned_le16(((mac->join_last_sequence + 1) & 0xfff) << 4, frame + 22);
+		put_unaligned_le16(WLAN_REASON_DEAUTH_LEAVING, frame + 24);
+		memset(IEEE80211_SKB_CB(skb), 0, sizeof(struct ieee80211_tx_info));
+		IEEE80211_SKB_CB(skb)->band = NL80211_BAND_5GHZ;
+	}
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	if (!skb_queue_empty(&mac->join_queue) ||
+	    (skb && (mac->join_seen & BIT(12)))) {
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		dev_kfree_skb(skb);
+		return -EPROTO;
+	}
+	mac->join_cleanup_requested = true;
+	mac->join_open = !!skb;
+	mac->join_tx_allowed = skb ? BIT(12) : 0;
+	if (skb) {
+		mac->join_seen |= BIT(12);
+		mac->join_internal = skb;
+		mac->join_queue_bytes = skb->len;
+		__skb_queue_tail(&mac->join_queue, skb);
+	}
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mac->join_rx_allowed = BIT(10) | BIT(12);
+	return 0;
+}
diff --git a/drivers/net/wireless/mediatek/mt6797/mac-priv.h b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
new file mode 100644
index 000000000..f67dd3fd1
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
@@ -0,0 +1,788 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Private definitions shared by the MT6797 mac80211 layer. */
+#ifndef MT6797_MAC_PRIV_H
+#define MT6797_MAC_PRIV_H
+
+#include <linux/completion.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/etherdevice.h>
+#include <linux/jiffies.h>
+#include <linux/ktime.h>
+#include <linux/mutex.h>
+#include <linux/rcupdate.h>
+#include <linux/rtnetlink.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+#include <net/mac80211.h>
+#include "hif.h"
+#include "mac.h"
+#include "mcu.h"
+#include "record-prepare.h"
+
+#define MT6797_2G_CHANNELS 13U
+
+#define MT6797_5G_CHANNELS 4U
+
+#define MT6797_CHANNELS (MT6797_2G_CHANNELS + MT6797_5G_CHANNELS)
+
+/* An effective cfg80211 channel snapshot, never private record subbands. */
+struct mt6797_channel_limit {
+	bool enabled, no_ir;
+	int max_power_dbm;
+};
+
+struct mt6797_regulatory_payloads {
+	unsigned char passive[56], domain[56], power[32];
+};
+
+#define MT6797_PASSIVE_SCAN_BYTES 226U
+
+#define MT6797_PASSIVE_SCAN_DWELL_MS 500U
+
+#define MT6797_PASSIVE_SCAN_CHANNELS MT6797_CHANNELS
+
+struct mt6797_scan_frame {
+	size_t offset, bytes;
+	unsigned int channel, rcpi;
+};
+
+struct mt6797_join_rx_frame {
+	size_t offset, bytes;
+	unsigned char subtype, rcpi;
+	int signal_dbm;
+};
+
+/* With WMM negotiated (0284) the access point may send EAPOL-Key as QoS
+ * data: a 26-byte header with its QoS control field, any TID, no A-MSDU.
+ */
+#define MT6797_EAPOL_RX_QOS_BIT 0x0080U
+
+#define MT6797_EAPOL_RX_QOS_EXTRA 2U
+
+enum mt6797_eapol_gate {
+	MT6797_EAPOL_OK,
+	MT6797_EAPOL_INPUT,
+	MT6797_EAPOL_BYTE_COUNT,
+	MT6797_EAPOL_PACKET_TYPE,
+	MT6797_EAPOL_CHANNEL,
+	MT6797_EAPOL_WLAN_MATCH,
+	MT6797_EAPOL_MSDU_FORMAT,
+	MT6797_EAPOL_BSS,
+	MT6797_EAPOL_FORMAT,
+	MT6797_EAPOL_SECURITY,
+	MT6797_EAPOL_PREFIX,
+	MT6797_EAPOL_GROUP_BOUNDS,
+	MT6797_EAPOL_VECTOR,
+	MT6797_EAPOL_TRANSLATED_LAYOUT,
+	MT6797_EAPOL_FRAGMENT,
+	MT6797_EAPOL_PEER,
+	MT6797_EAPOL_ETHERTYPE,
+	MT6797_EAPOL_NATIVE_LAYOUT,
+	MT6797_EAPOL_LLC,
+	MT6797_EAPOL_FRAME_CONTROL,
+	MT6797_EAPOL_SOURCE,
+	MT6797_EAPOL_EAPOL_VERSION,
+	MT6797_EAPOL_EAPOL_TYPE,
+	MT6797_EAPOL_EAPOL_LENGTH,
+	MT6797_EAPOL_KEY_DESCRIPTOR,
+	MT6797_EAPOL_KEY_DATA_LENGTH,
+};
+
+struct mt6797_eapol_rx {
+	unsigned char prefix[32 + MT6797_EAPOL_RX_QOS_EXTRA];
+	size_t prefix_bytes, offset, bytes;
+	int signal_dbm;
+	unsigned char tid; /* descriptor byte 9's low nibble */
+	bool signal_valid; /* False when the firmware omitted RX vector group 3. */
+	unsigned char bss_index; /* RXD BSSID field as received: 1 or 15. */
+};
+
+#define MT6797_DATA_RX_PREFIX_BYTES 32U
+
+struct mt6797_data_rx {
+	unsigned char prefix[MT6797_DATA_RX_PREFIX_BYTES]; /* Rebuilt 802.11 header and LLC/SNAP. */
+	size_t offset, bytes;      /* The payload after the Ethernet type, in the packet. */
+	unsigned int ether_type;   /* Metadata only, never interpreted here. */
+	unsigned char tid, key_id; /* Descriptor TID and key id fields, recorded. */
+	bool group;                /* Destination group bit (and the descriptor's BC/MC bit). */
+	bool signal_valid;         /* False when RX vector group 3 was omitted. */
+	int signal_dbm;
+	unsigned char group_vld;   /* The 4-bit GROUP_VLD mask as decoded (bit 0 is group 1). */
+};
+
+/* Pure decision for the station re-arm between lifetimes (proposal 0180). The two facts
+ * - the worker's healthy stage-3 cleanup (cleanup_done) and the mac80211
+ * station teardown (sta_removed) - may arrive in either order; re-arm only when
+ * both are seen, the lifetime is quiescent (empty queue implied by cleanup_done,
+ * no debt, no in-flight frame, no credit pending), exactly the two expected key
+ * removals are credited with both key-done windows and no third. An exhausted
+ * command sequence is recycled (RECYCLE): at this barrier no command is owed, and join
+ * completions are matched by credit and token, never by command sequence.
+ * The caller restarts at `sequence_base`, the first sequence of lifetime 1.
+ * `poisoned` is the device-wide fatal state (first_error or closing or an ambiguous
+ * ownership loss), NOT the healthy stage-3 stop (which also sets join_retired); the
+ * caller must pass first_error||closing so a healthy retirement can still re-arm.
+ * This is not an authenticated key-completion barrier: the counts bound, they do
+ * not authenticate a generationless ADD_PKEY_DONE.
+ */
+enum mt6797_join_rearm_decision {
+	MT6797_JOIN_REARM_NO = 0,
+	MT6797_JOIN_REARM_YES,
+	MT6797_JOIN_REARM_WRAP,
+	MT6797_JOIN_REARM_RECYCLE,
+};
+
+struct mt6797_join_rearm_state {
+	bool cleanup_done, sta_removed, poisoned;
+	bool key_done, key_done_second;
+	bool inflight, credit_pending, queue_empty;
+	unsigned int key_pairwise, key_group;
+	unsigned int page_debt, data_page_debt;
+	unsigned int sequence, sequence_base, next_pid;
+};
+
+#define MT6797_JOIN_PUMP_MAX_ZERO 32U
+
+#define MT6797_JOIN_PUMP_IDLE_MS 20U
+
+#define MT6797_JOIN_PUMP_PENDING_MS 1U
+
+/*
+ * Pure decision core for the data-phase RX monitor-mask state machine. No
+ * side effects, no kernel calls.
+ */
+/* Low-traffic connected observation through ten minutes, not queue storage. */
+#define MT6797_CCMP_DIAG_CHECKED_MAX  8192U
+
+/* Once the sample window ends, draining the owed completion (the exact TX-done
+ * class only; the broad control dispatcher and all other classes are gated) has
+ * its own finite ceiling, set below the parent command/frame/grant/lifetime
+ * deadlines, after which an unretired ledger fails through the normal terminal.
+ */
+#define MT6797_NATIVE_DIAG_RETIRE_READS 64U            /* further all-class reads */
+
+#define MT6797_NATIVE_DIAG_RETIRE_BYTES (256U * 1024U) /* 256 KiB drained */
+
+#define MT6797_NATIVE_DIAG_RETIRE_MS    750U           /* below the parent deadlines */
+
+enum mt6797_native_diag_step { MT6797_NATIVE_DIAG_CONTINUE, MT6797_NATIVE_DIAG_STOP };
+
+struct mt6797_native_diag_budget {
+	unsigned int elapsed_ms;   /* monotonic ms since the mode switch */
+	unsigned int total_rx;     /* all RX frames admitted in the window */
+	unsigned int native_rx;    /* protected-native ordinary frames delivered */
+	unsigned int bytes;        /* total RX bytes admitted in the window */
+};
+
+/* The default-off diagnostic's control runs INSIDE join_work; it must never block
+ * on its own ledger (a worker waiting for itself would time out). This pure
+ * transition drives a compact asynchronous state machine the poller steps once
+ * per iteration: it submits exactly one enable, then one disable, each reconciled
+ * across later iterations on the real credit/page ledger (as the in-worker
+ * commands are), activating only after the enable retires and permitting the
+ * inherited healthy cleanup only after the disable retires. On a deadline or any
+ * poison it latches a no-radio stop before any further submission. No blocking,
+ * no new workqueue. The wiring executes the returned action (charge the one page
+ * + credit deadline on a submit, or set first_error+closing on a latch).
+ */
+enum mt6797_native_diag_state {
+	MT6797_ND_IDLE,
+	MT6797_ND_ENABLE_PENDING,
+	MT6797_ND_ACTIVE,
+	MT6797_ND_DISABLE_PENDING,
+	MT6797_ND_CLOSED,
+};
+
+enum mt6797_native_diag_action {
+	MT6797_ND_ACT_NONE,
+	MT6797_ND_ACT_SUBMIT_ENABLE,
+	MT6797_ND_ACT_SUBMIT_DISABLE,
+	MT6797_ND_ACT_LATCH_NORADIO,
+};
+
+struct mt6797_native_diag_ctx {
+	enum mt6797_native_diag_state state;
+	int armed;		/* always set by the driver */
+	int data_phase;		/* healthy associated data phase, both keys installed */
+	int quiescent;		/* ledger idle: no credit pending, no page debt, no inflight */
+	int poisoned;		/* first_error or closing already set */
+	int deadline_passed;	/* now >= the pending command's credit deadline */
+	int seq_ok;		/* command sequence space remains for the submit */
+	int budget_stop;	/* ACTIVE: a window ceiling reached */
+};
+
+struct mt6797_native_beacon {
+	size_t offset, bytes;
+	unsigned int rcpi;
+};
+
+struct mt6797_join_action_frame {
+	size_t bytes;             /* Wire bytes after the descriptor and groups. */
+	unsigned int fc;          /* Frame control, native header. */
+	unsigned int match;       /* Descriptor match flags (RXD byte 4). */
+	unsigned int status;      /* Descriptor status word (RXD bytes 10..11). */
+	unsigned char wlan, bss;  /* Descriptor WLAN index and BSSID field. */
+	unsigned char sec;        /* Descriptor security mode field. */
+	unsigned int rcpi;        /* RX vector RCPI (half dB), the keyed beacon only. */
+};
+
+/* QoS data (subtype bit 0x0080) with QoS control 0, TID 0 and normal
+ * acknowledgment, admitted only with WMM negotiated (0284); 0 otherwise.
+ */
+#define MT6797_CCMP_RX_QOS_BIT 0x0080U
+
+/* CCMP keeps one replay counter per TID, and mac80211 keeps them so
+ * (rx_pn[tid]): a frame is checked against its own TID's counter and
+ * advances only that one. TID 0's counter is pn, which a non-QoS data frame
+ * shares, as in mac80211; TIDs 1-7 are tid_pn. Every counter stays strict:
+ * nothing at or below its TID's last PN is accepted. A QoS TID of 8 or more
+ * (TSPEC, never negotiated here) is refused (0292).
+ */
+#define MT6797_CCMP_RX_TIDS 8U
+
+/*
+ * Caller-owned, serialized context for ONE initial, stable PTK epoch. The
+ * caller must establish current authorization/key activation and seed pn from
+ * mac80211 RX sequence state. PN is most-significant-byte first. No RXD epoch
+ * tag exists: replacing/reinstalling a firmware slot is NOT admitted here.
+ */
+struct mt6797_ccmp_rx_context {
+	bool authorized, active, seeded, pairwise;
+	unsigned int cipher;
+	unsigned char key_bytes, key_id, wlan_index, rxd_bssid, channel;
+	unsigned char own[6], ap[6], pn[6];
+	unsigned char tid_pn[MT6797_CCMP_RX_TIDS - 1][6]; /* TIDs 1-7 (0292) */
+};
+
+struct mt6797_ccmp_rx {
+	size_t offset, bytes; /* Actual Ethernet frame, no reconstructed header. */
+};
+
+/* The receive reorder window of one block-ack session (0321), kept per TID
+ * as the vendor's que_mgt.c keeps it (qmAddRxBaEntry,
+ * qmProcessPktWithReordering, qmPopOutDueToFallWithin and FallAhead,
+ * qmHandleEventCheckReorderBubble). The window starts at the ADDBA starting
+ * sequence number and spans the ADDBA buffer size plus CFG_RX_BA_INC_SIZE.
+ * Until a frame falls in it, the first frame in the window sets its start
+ * (QM_RX_WIN_SSN_AUTO_ADVANCING) and a frame behind it passes
+ * (QM_RX_INIT_FALL_BEHIND_PASS). Afterwards a frame in the window is held
+ * until every earlier sequence number has been released or skipped, a
+ * frame ahead of it moves the window to end there and releases what falls
+ * out, a frame behind it is dropped, and a hole that stays
+ * QM_RX_BA_ENTRY_MISS_TIMEOUT_MS releases everything held. Frames leave in
+ * sequence order, so the strict per-TID PN check after the window sees
+ * them in order.
+ *
+ * Decisions only: no allocation, clock or lock. The caller owns the frames
+ * and serializes every call.
+ */
+#define MT6797_RX_REORDER_TIDS 8U
+
+#define MT6797_RX_REORDER_BUFFER 64U	/* the station record's ucRxBaSize (0317) */
+
+#define MT6797_RX_REORDER_INC 4U	/* CFG_RX_BA_INC_SIZE */
+
+/* One slot per sequence number held. The slot count exceeds the widest
+ * window and divides 4096, so no two held sequence numbers share a slot.
+ */
+#define MT6797_RX_REORDER_SLOTS 128U
+
+#define MT6797_RX_REORDER_TIMEOUT_NS (200ULL * 1000000ULL)
+
+#define MT6797_RX_SEQ 4096U
+
+struct sk_buff;
+
+struct mt6797_rx_reorder {
+	struct sk_buff *held[MT6797_RX_REORDER_SLOTS];
+	unsigned long long deadline;
+	unsigned int count, holes;
+	/* start is the next sequence number to leave. While start != until
+	 * the window is being moved to until and holes are skipped.
+	 */
+	unsigned short start, until, size, bubble;
+	bool valid, waiting, has_bubble;
+};
+
+enum mt6797_rx_reorder_place {
+	MT6797_RX_REORDER_NOW,		/* deliver it, then drain */
+	MT6797_RX_REORDER_HOLD,		/* drain, then hold it, then drain */
+	MT6797_RX_REORDER_DUPLICATE,	/* already held: drop */
+	MT6797_RX_REORDER_BEHIND,	/* behind the window: drop */
+};
+
+#define MT6797_DATA_DEPTH 12
+
+struct mt6797_data_owner {
+	void *frame;
+	unsigned long long deadline;
+	unsigned char pid;
+	/* A frame retired on credit arrival: the pages it was charged, its
+	 * submission order and time; zero pages for a frame with a status report.
+	 * A sampled frame (reported) keeps its place in the credit order and its
+	 * slot until its report arrives: covered once the credits reached it. A
+	 * placeholder (no frame, pages left) holds the order of a reported frame
+	 * taken by its report before the credits covered it.
+	 */
+	unsigned int pages, ordinal;
+	unsigned long long submitted;
+	bool reported, covered;
+};
+
+struct mt6797_data_slots {
+	struct mt6797_data_owner owner[MT6797_DATA_DEPTH];
+	unsigned int count;
+};
+
+enum mt6797_data_cover {
+	MT6797_DATA_COVER_NONE,		/* no credit frame, or the credits fall short */
+	MT6797_DATA_COVER_RETIRE,	/* the oldest frame is covered and taken */
+	MT6797_DATA_COVER_HELD,		/* covered but waiting for its report, or a placeholder */
+};
+
+/* One initial station/key epoch, bounded data owners. No timeout release.
+ * The reserved deauthentication never enters this reusable ordinary pool.
+ */
+#define MT6797_JOIN_PID_LAST 126U
+
+#define MT6797_JOIN_PID_RESERVED 127U
+
+struct mt6797_join_pid_pool {
+	unsigned char next, pending;
+	bool used[MT6797_JOIN_PID_LAST + 1];
+	bool completed[MT6797_JOIN_PID_LAST + 1];
+	unsigned int allocations, completions, wraps;
+};
+
+/* Phase C3 finite limits: the data phase budget after the group key's
+ * credit, the teardown margin added to the lifetime deadline at that point,
+ * and the poll and packet caps that cover scan hand-off, join, data phase and
+ * teardown at the 20 ms poll period. All are chosen host limits.
+ */
+#define MT6797_JOIN_DATA_BUDGET_MS 60000U
+
+#define MT6797_JOIN_TEARDOWN_MARGIN_MS 5000U
+
+/* The data phase runs inside the channel grant (the reference's first data
+ * frames did) and ends this long before the grant does. The tail covers, in
+ * order: the last data frame admitted at the phase's end and its 750 ms
+ * completion deadline; the deauthentication reserved at association, whose
+ * dequeue after that completion needs 850 ms of grant room, which also covers
+ * its own 750 ms completion; then PM abort, the two key removals, station
+ * removal, channel abort and BSS disable, each with a 100 ms credit deadline,
+ * plus the 20 ms poll and the HIF's 100 ms: 750 + 850 + 6 x 100 + 120 = 2320.
+ * The existing 2500 ms tail is unchanged; the phase only gets shorter.
+ */
+#define MT6797_JOIN_GRANT_TAIL_MS 2500U
+
+#define MT6797_JOIN_DATA_TX_QUEUE 64U
+
+/* Backpressure marks: stop at seven eighths of the bound, wake at half. */
+#define MT6797_JOIN_DATA_TX_STOP (MT6797_JOIN_DATA_TX_QUEUE - MT6797_JOIN_DATA_TX_QUEUE / 8U)
+
+#define MT6797_JOIN_DATA_TX_WAKE (MT6797_JOIN_DATA_TX_QUEUE / 2U)
+
+#define MT6797_JOIN_DATA_TX_QUEUE_BYTES (MT6797_JOIN_DATA_TX_QUEUE * 1550U)
+
+/* QoS data from mac80211 carries a 2-byte QoS control field after the
+ * 24-byte header (0284); without WMM the bit is never admitted.
+ */
+#define MT6797_JOIN_TX_QOS_BIT 0x0080U
+
+#define MT6797_JOIN_TX_QOS_EXTRA 2U
+
+#define MT6797_JOIN_TX_HDRLEN(fc) ((fc) & MT6797_JOIN_TX_QOS_BIT ? 26U : 24U)
+
+#define MT6797_JOIN_DATA_TX_FAILURES 8U
+
+/* PIDs 1..127 are consumed in order by management, security and data frames;
+ * ordinary data stops at 126 so the reserved deauthentication always has one.
+ */
+#define MT6797_JOIN_DATA_LAST_PID 126U
