+void mt6797_mac_join_close(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+	struct sk_buff_head discard;
+	struct sk_buff *skb, *internal = NULL;
+	bool wake_queues = false;
+
+	skb_queue_head_init(&discard);
+	/* Fence every producer before cancellation, preserving idle eligibility.
+	 * 0180: an explicit close (stop/remove/poison) permanently invalidates
+	 * re-arm and clears any queued re-arm under the mutex BEFORE the
+	 * unlock/cancel gap, so a re-arm pass cannot reopen the fence; the healthy
+	 * rendezvous is the only admitted reset route and never reaches here.
+	 */
+	mutex_lock(&mac->mutex);
+	mac->join_retired = true;
+	mt6797_ccmp_withdraw(mac);
+	mac->join_closed = true;
+	mac->join_rearm_pending = false;
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mutex_unlock(&mac->mutex);
+	/* Neither this mutex nor the queue lock may be held while cancelling. */
+	cancel_delayed_work_sync(&mac->join_work);
+	mutex_lock(&mac->mutex);
+	mt6797_rx_reorder_drop(mac);
+	{
+		int ret = mt6797_mac_join_retire_idle_bss(mac);
+
+		if (ret && !mac->first_error)
+			mac->first_error = ret;
+		mac->join_scan_ready = false;
+	}
+	mac->join_retired = true;
+	mac->join_channel_pending = false;
+	mac->join_sta_pending = false;
+	complete_all(&mac->join_channel_done);
+	complete_all(&mac->join_sta_done);
+	mac->join_credit_pending = false;
+	complete_all(&mac->join_credit_done);
+	complete_all(&mac->join_frame_done);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	skb_queue_splice_init(&mac->join_queue, &discard);
+	mac->join_queue_bytes = 0;
+	if (mac->tx_queues_stopped) {
+		mac->tx_queues_stopped = false;
+		mac->tx_queue_wakes++;
+		wake_queues = true;
+	}
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	if (wake_queues)
+		ieee80211_wake_queues(mac->hw);
+	while ((skb = mt6797_data_pop(&mac->data_slots)))
+		__skb_queue_tail(&discard, skb);
+	while ((skb = skb_dequeue(&mac->credit_retired_queue)))
+		__skb_queue_tail(&discard, skb);
+	if (mac->join_inflight) {
+		__skb_queue_tail(&discard, mac->join_inflight);
+		mac->join_inflight = NULL;
+	}
+	internal = mac->join_internal;
+	mac->join_internal = NULL;
+	mutex_unlock(&mac->mutex);
+	while ((skb = __skb_dequeue(&discard))) {
+		if (skb == internal)
+			dev_kfree_skb(skb);
+		else
+			ieee80211_free_txskb(mac->hw, skb);
+	}
+}
+
+/* Ordinary data goes out without a PID or an MCU status report and is
+ * retired here, on the TC1 page credits the firmware returns, in submission
+ * order: a frame is retired when the pages returned since the frames before
+ * it cover its own pages. The vendor releases its transmit resources on
+ * these counts (nicTxReleaseResource) and never retires plain data at the
+ * bus write; the first attempt at this lever (0272) retired at submission
+ * and lost the in-flight bound. Pages left over with no frame in flight are
+ * dropped, so a frame is never retired by credits that preceded it; a frame
+ * the credits never cover expires on its slot deadline. mac80211 is told
+ * the frame was transmitted without an acknowledgment report. Caller holds
+ * mac->mutex.
+ */
+static void mt6797_mac_credit_retire(struct mt6797_mac *mac, unsigned int pages)
+{
+	struct mt6797_data_owner taken;
+	struct sk_buff *skb;
+	void *frame;
+	enum mt6797_data_cover cover;
+
+	mac->credit_retire_pages += pages;
+	while ((cover = mt6797_data_cover_oldest(&mac->data_slots,
+						 mac->credit_retire_pages, &taken,
+						 &frame)) != MT6797_DATA_COVER_NONE) {
+		mac->credit_retire_pages -= taken.pages;
+		if (cover == MT6797_DATA_COVER_HELD)
+			continue;	/* a sample waits for its report; a placeholder is done */
+		skb = frame;
+		mt6797_join_pid_complete(&mac->ccmp_pid_pool, taken.pid);
+		mac->join_data_tx_done++;
+		mac->join_data_tx_failures_in_row = 0;
+		ieee80211_tx_info_clear_status(IEEE80211_SKB_CB(skb));
+		IEEE80211_SKB_CB(skb)->flags |= IEEE80211_TX_STAT_NOACK_TRANSMITTED;
+		skb_queue_tail(&mac->credit_retired_queue, skb);
+	}
+	if (!mt6797_data_credit_outstanding(&mac->data_slots))
+		mac->credit_retire_pages = 0;
+}
+
+static int mt6797_mac_join_guard(struct mt6797_mac *mac, u64 deadline)
+{
+	struct mt6797_hif_tx_status status = {0};
+	struct mt6797_normal_release account;
+	u32 wcir = 0, own = 0;
+	int ret;
+
+	ret = mt6797_hif_read32(mac->hif, 0, deadline, &wcir);
+	if (!ret && ((wcir & 0xffff) != 0x0279 || !(wcir & BIT(21))))
+		ret = -EIO;
+	if (!ret)
+		ret = mt6797_hif_read32(mac->hif, 4, deadline, &own);
+	if (!ret && !(own & BIT(8)))
+		ret = -EACCES;
+	if (!ret)
+		ret = mt6797_hif_reconcile_runtime(mac->hif, deadline, &status, &account);
+	if (ret) {
+		/* The guard's refusal, with the words it saw: the identity and
+		 * ownership registers, the status acquisition (valid=0 means it
+		 * was refused before any read), and the receive-batching merge
+		 * state (0268) so a credit fault names its source.
+		 */
+		struct mt6797_hif_rx_batch_stats batch;
+		u32 wasr = 0, wasr2 = 0;
+
+		mt6797_hif_rx_batch_stats(mac->hif, &batch);
+		mt6797_hif_read32(mac->hif, 0x20, deadline, &wasr);
+		mt6797_hif_read32(mac->hif, 0xe0, deadline, &wasr2);
+		dev_err(wiphy_dev(mac->hw->wiphy),
+			"one-shot WLAN join guard failed: ret=%d wcir=0x%08x own=0x%08x valid=0x%x whcr=0x%08x whisr=0x%08x synth=0x%x wtqcr0=0x%08x wtqcr7=0x%08x hif=%d wasr=0x%08x wasr2=0x%08x block_whisr=0x%08x block_abnormal=0x%08x pending0=0x%08x pending7=0x%08x batch_failures=%u credits=%u\n",
+			ret, wcir, own, status.valid_words, status.whcr, status.whisr,
+			status.synthesized, status.wtqcr[0], status.wtqcr[7], batch.error,
+			wasr, wasr2, batch.block_whisr, batch.block_abnormal,
+			batch.pending_wtqcr0, batch.pending_wtqcr7, batch.failures,
+			batch.credit_blocks);
+	}
+	if (!ret) {
+		if (account.released_pages > mac->join_page_debt) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join credit overflow: pages=%u debt=%u\n",
+				 account.released_pages, mac->join_page_debt);
+			return -EPROTO;
+		}
+		if (account.tc1_released > mac->join_data_page_debt) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join data credit overflow: pages=%u debt=%u\n",
+				 account.tc1_released, mac->join_data_page_debt);
+			return -EPROTO;
+		}
+		mac->join_data_page_debt -= account.tc1_released;
+		if (account.tc1_released) {
+			mac->join_data_credits += account.tc1_released;
+			mt6797_mac_credit_retire(mac, account.tc1_released);
+		}
+		mac->join_page_debt -= account.released_pages;
+		if (mac->join_credit_pending && mt6797_ccmp_cleanup_credit_ready(mac)) {
+			mac->ccmp_cleanup_credit_active = false;
+			mac->join_credit_pending = false;
+			complete_all(&mac->join_credit_done);
+		}
+	}
+	return ret;
+}
+
+/* Healthy unused handoff only. Never invent a teardown for an owned peer. */
+static int mt6797_mac_join_retire_idle_bss(struct mt6797_mac *mac)
+{
+	u8 bss[12];
+	int ret;
+
+	if (!mac->join_scan_ready || !mac->bss_active || mac->join_peer_used ||
+	    mac->first_error || mac->scan_active || mac->join_inflight || mac->data_slots.count ||
+	    mac->join_page_debt || mac->join_sta_pending || mac->join_sta_active ||
+	    mac->join_channel_pending || mac->join_channel_granted)
+		return 0;
+	ret = mt6797_mac_join_guard(mac, ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	if (ret)
+		return ret;
+	if (!mt6797_hif_normal_idle(mac->hif))
+		return -EPROTO;
+	mt6797_scan_bss(mac->hw->wiphy->perm_addr, false, bss);
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_BSS_ACTIVE, bss, sizeof(bss));
+	if (!ret)
+		mac->bss_active = false;
+	return ret;
+}
+
+/* A scan that mac80211 never followed with a join (no BSS found, or none
+ * selected) is not a failed lifetime: its idle BSS is retired above and the
+ * scan cycle is re-opened so the next request is admitted. Only scan-cycle
+ * state is reset; the wire identities, keys and epoch were never consumed.
+ * The lifetime counted at this scan's submission is handed back.
+ */
+static void mt6797_mac_join_reopen_scan(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+
+	mac->join_idle_scans++;
+	if (mac->join_lifetimes)
+		mac->join_lifetimes--;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join idle scan retired: lifetime=%u idle_scans=%u sequence=%u\n",
+		 mac->join_lifetimes, mac->join_idle_scans, mac->sequence);
+	mac->scan_used = false;
+	mac->scan_active = false;
+	mac->scan_count = 0;
+	mac->scan_channels = 0;
+	mac->scan_polls = 0;
+	mac->scan_packets = 0;
+	mac->scan_beacon = false;
+	mac->scan_credit = false;
+	mac->scan_frame_seen = false;
+	mac->join_scan_ready = false;
+	mac->join_deadline = 0;
+	mac->join_seen = 0;
+	mac->join_auth_attempts = 0;
+	mac->join_assoc_attempts = 0;
+	mac->rx_ba_active = 0;
+	mt6797_rx_reorder_drop(mac);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+}
+
+static int mt6797_mac_join_control_event(struct mt6797_mac *mac, size_t bytes)
+{
+	struct mt6797_join_channel expected = {
+		.bss = 0, .token = mac->join_channel_token, .channel = 40,
+		.sco = mac->join_sco, .band = 2, .max_ms = mac->join_requested_ms,
+	};
+	unsigned long flags;
+	u32 interval, own;
+	int ret;
+
+	if (bytes < 8 || !mt6797_join_event(mac->join_packet, bytes,
+					    mac->join_packet[4], bytes - 8))
+		return -EPROTO;
+	/* Same bounded notifications as the proven scan consumer; no body log. */
+	if (mac->join_packet[4] == 0x27)
+		return 0;
+	if (mac->join_packet[4] == 0x07) {
+		if (bytes != 12 || mac->join_packet[8] > 1)
+			return -EPROTO;
+		ret = mt6797_hif_read32(mac->hif, 4,
+					min_t(u64, mac->join_deadline,
+					      ktime_get_ns() + 100 * NSEC_PER_MSEC), &own);
+		if (ret)
+			return ret;
+		return own & BIT(8) ? 0 : -EACCES;
+	}
+
+	if (mt6797_join_event(mac->join_packet, bytes, 0x10, 16)) {
+		if (!mac->join_channel_pending ||
+		    !mt6797_join_channel_grant(mac->join_packet, bytes, &expected, &interval))
+			return -EPROTO;
+		mac->join_channel_pending = false;
+		mac->join_channel_granted = true;
+		/* The grant is a resource horizon, not the join phase deadline.
+		 * join_deadline still fences every pre-data operation unchanged.
+		 */
+		mac->join_grant_deadline = ktime_get_ns() +
+			(u64)interval * NSEC_PER_MSEC;
+		/* Keep the acquired resource recorded even on an early refusal.
+		 * The late check remains authoritative after association and keys.
+		 */
+		if (interval < 9000U) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN initial-key grant refused: interval_ms=%u required_ms=%u\n",
+				 interval, 9000U);
+			return -ERANGE;
+		}
+		complete_all(&mac->join_channel_done);
+		/* This lifetime's data at 40 MHz only on the HT40 grant (0324). */
+		mt6797_hif_set_data_bw40(mac->hif, mt6797_mac_data_bw40(mac));
+		/* The rate_control parameter, once per lifetime. */
+		mac->join_data_minstrel = READ_ONCE(rate_control);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join grant: channel=40 sco=%u interval_ms=%u\n",
+			 mac->join_sco, interval);
+		return 0;
+	}
+	if (mt6797_join_event(mac->join_packet, bytes, 0x0c, 8)) {
+		if (!mac->join_sta_pending ||
+		    !mt6797_join_sta_active(mac->join_packet, bytes,
+			mac->join_sta_sequence, 1, 0, mac->join_ap, true))
+			return -EPROTO;
+		mac->join_sta_pending = false;
+		mac->join_sta_active = true;
+		complete_all(&mac->join_sta_done);
+		{
+			/* Finite hold of the single deauthentication for the handshake:
+			 * four seconds after activation, shortened to one second after
+			 * the group key command's credit returns, never past 1500 ms
+			 * before the grant or join deadline, which the deauthentication
+			 * and the teardown already need.
+			 */
+			u64 now = ktime_get_ns();
+			u64 limit = min(mac->join_deadline, mac->join_grant_deadline);
+
+			mac->join_hold_until = limit > now + 1500 * NSEC_PER_MSEC ?
+				min(now + 4000 * NSEC_PER_MSEC, limit - 1500 * NSEC_PER_MSEC) : now;
+		}
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join activation: sequence=%u state=3 lifetime=%u\n",
+			 mac->join_sta_sequence, mac->join_lifetimes);
+		return 0;
+	}
+	if (mt6797_join_event(mac->join_packet, bytes, 0x24, 8)) {
+		/* EVENT_ID_ADD_PKEY_DONE (publicly pinned gen3 nic_cmd_event.h:
+		 * unsolicited, "add key done for port control"; payload
+		 * EVENT_ADD_KEY_DONE_INFO: ucBSSIndex, ucReserved, aucStaAddr[6]).
+		 * The payload carries neither a key type, a key index nor a command
+		 * sequence, and the pinned receive path only marks the station's TX
+		 * key ready on it, so an event cannot be attributed to a key by its
+		 * content. Runtime 20 recorded one owned event (BSS index 0, the
+		 * target's address) after the pairwise key command and refused a
+		 * second event of this id, 16 bytes with sequence 0, after the group
+		 * key command; that second payload was not recorded. This gate admits
+		 * at most two owned events, attributed by window only: the first
+		 * after the pairwise command was submitted and before the group one,
+		 * the second after the group command was submitted. Whether the
+		 * second is the group key's completion or a delayed repeat of the
+		 * first is not decidable from the pinned source or the event, and
+		 * is not claimed; a repeat arriving between the group submission
+		 * and that key's own event is indistinguishable from it and is
+		 * admitted as the second. A second event before the group
+		 * submission, a third event, and any event outside the lifetime
+		 * window are refused. Each admitted event requires sequence 0, the
+		 * station active and the BSS configured, the handshake hold with the
+		 * reserved deauthentication queued (the cleanup is requested at the
+		 * accepted association, so that flag does not exclude it), the
+		 * deauthentication neither in flight nor done, no cleanup stage and
+		 * the pairwise key not removed, BSS index 0 and the target's address
+		 * (compared, never logged); the reserved byte is unconstrained by the
+		 * pinned source and unread. The record changes nothing the hold, the
+		 * teardown, the key slots or the credit ledger depend on, and
+		 * transmits nothing. A refusal names the index, the peer flags, the
+		 * sequence and the submission and record state, no address.
+		 */
+		const u8 *body = mac->join_packet + 8;
+		bool peer = ether_addr_equal(body + 2, mac->join_ap);
+		bool owned = !mac->join_packet[5] && !body[0] && peer &&
+			     mac->join_sta_active && mac->join_bss_configured &&
+			     !mac->join_deauth_done &&
+			     !(mac->join_internal && mac->join_inflight == mac->join_internal) &&
+			     !mac->join_cleanup_stage && !mac->join_cleanup_done &&
+			     mac->join_key_pairwise != 2;
+		const char *window = NULL;
+
+		if (owned && mac->join_key_pairwise_submitted && !mac->join_key_done &&
+		    !mac->join_key_group_submitted)
+			window = "first after=pairwise";
+		else if (owned && mac->join_key_done && mac->join_key_group_submitted &&
+			 !mac->join_key_done_second)
+			window = "second after=group";
+		if (!window) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join key done refused: bss=%u peer=%u broadcast=%u seq=%u submitted=%u%u recorded=%u%u\n",
+				 body[0], peer, is_broadcast_ether_addr(body + 2),
+				 mac->join_packet[5], mac->join_key_pairwise_submitted,
+				 mac->join_key_group_submitted, mac->join_key_done,
+				 mac->join_key_done_second);
+			return -EPROTO;
+		}
+		if (mac->join_key_done)
+			mac->join_key_done_second = true;
+		else
+			mac->join_key_done = true;
+		if (!mac->join_key_group_submitted)
+			complete_all(&mac->ccmp_key_done);
+		return 0;
+	}
+	if (mt6797_join_event(mac->join_packet, bytes, 0x11, 4)) {
+		/* EVENT_ID_BSS_ABSENCE_PRESENCE (publicly pinned gen3 que_mgt.h):
+		 * the event header, then ucBssIndex, ucIsAbsent, ucBssFreeQuota
+		 * and one reserved byte; unsolicited, so its sequence is zero.
+		 * Admitted only for the owned BSS slot during the host-owned
+		 * teardown after the BSS-off submission, with no page owed,
+		 * nothing in flight and nothing queued. The cap of two is a
+		 * chosen bounded notification budget, not an observed count. The
+		 * quota and reserved bytes are unrestricted metadata, logged and
+		 * not validated: the quota is never TC4 credit and never proof of
+		 * drain or quiescence; the original idle guards still decide.
+		 */
+		const u8 *body = mac->join_packet + 8;
+		bool queued;
+
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		queued = !skb_queue_empty(&mac->join_queue);
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		if (mac->join_packet[5] || body[0] || body[1] > 1) {
+			/* An unsolicited notice whose content is not the owned
+			 * BSS's absence or presence is a firmware state change the
+			 * lifetime does not depend on: counted, its four body bytes
+			 * logged (no address fits in them), never a fault.
+			 */
+			mac->join_absence_unexpected++;
+			if (mac->join_absence_unexpected <= 4)
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN join bss notice unexpected: seq=%u body=%02x%02x%02x%02x count=%u\n",
+					 mac->join_packet[5], body[0], body[1], body[2],
+					 body[3], mac->join_absence_unexpected);
+			return 0;
+		}
+		if (!mac->join_cleanup_requested || mac->join_cleanup_done ||
+		    mac->join_cleanup_stage != 3 || mac->join_page_debt ||
+		    mac->join_credit_pending || mac->join_inflight ||
+		    mac->data_slots.count || queued ||
+		    mac->join_absence_events >= 2) {
+			/* Outside the teardown window the firmware's absence or
+			 * presence notice is a state change, not a protocol fault.
+			 * An absence during the data phase ends it, and the
+			 * teardown then runs as for any disconnect; anything else
+			 * is counted and ignored.
+			 */
+			bool in_data = mac->join_data_phase && !mac->join_data_ended;
+
+			mac->join_absence_outside++;
+			if (mac->join_absence_outside <= 4)
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN join bss absence outside teardown: absent=%u quota=%u data_phase=%u count=%u\n",
+					 body[1], body[2], (unsigned int)in_data,
+					 mac->join_absence_outside);
+			if (body[1] == 1 && in_data)
+				mt6797_mac_join_end_data(mac, "bss-absence");
+			return 0;
+		}
+		mac->join_absence_events++;
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join bss absence: bss=%u absent=%u quota=%u reserved=%u\n",
+			 body[0], body[1], body[2], body[3]);
+		return 0;
+	}
+	/* The firmware answered the access point's ADDBA itself (block-ack
+	 * is firmware-managed) and reports the receive session (0318):
+	 * EVENT_ID_RX_ADDBA (0x0a) carries the station record index, the
+	 * dialog token, the BA parameter set (TID bits 2-5, window bits
+	 * 6-15), the timeout and the starting sequence control;
+	 * EVENT_ID_RX_DELBA (0x0b) the station record index and the TID.
+	 * Each is recorded and never ends the lifetime.
+	 */
+	if (mac->join_packet[4] == 0x0a && bytes >= 16) {
+		const u8 *e = mac->join_packet + 8;
+		unsigned int param = get_unaligned_le16(e + 2), tid = (param >> 2) & 15;
+
+		mac->rx_ba_starts++;
+		if (tid < 8) {
+			mac->rx_reorder_pending |= BIT(tid);
+			mac->rx_ba_active |= BIT(tid);
+			mac->rx_ba_window[tid] = param >> 6;
+			mac->rx_ba_ssn[tid] = get_unaligned_le16(e + 6) >> 4;
+		}
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN RX BA start: sta=%u dialog=%u tid=%u window=%u ssn=%u timeout=%u bytes=%zu count=%u\n",
+			 e[0], e[1], tid, param >> 6, get_unaligned_le16(e + 6) >> 4,
+			 get_unaligned_le16(e + 4), bytes, mac->rx_ba_starts);
+		return 0;
+	}
+	if (mac->join_packet[4] == 0x0b && bytes >= 10) {
+		const u8 *e = mac->join_packet + 8;
+
+		mac->rx_ba_stops++;
+		if (e[1] < 8) {
+			mac->rx_reorder_pending |= BIT(e[1]);
+			mac->rx_ba_active &= ~BIT(e[1]);
+		}
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN RX BA stop: sta=%u tid=%u bytes=%zu count=%u\n",
+			 e[0], e[1], bytes, mac->rx_ba_stops);
+		return 0;
+	}
+	return -EPROTO;
+}
+
+/* Poller-owned finite teardown. A returned page proves submission, not reuse. */
+static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+	bool queued;
+	u64 deadline;
+	u8 bss[12];
+	int ret;
+
+	if (!mac->join_cleanup_requested || mac->join_cleanup_done)
+		return 0;
+	if (mac->first_error || mac->closing || mac->join_retired)
+		return -ECANCELED;
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	queued = !skb_queue_empty(&mac->join_queue);
+	if (queued && mt6797_ccmp_pm_holds_deauth(mac) && mac->join_internal &&
+	    skb_queue_len(&mac->join_queue) == 1 &&
+	    skb_peek(&mac->join_queue) == mac->join_internal &&
+	    mac->join_internal->len == 26 &&
+	    mt6797_join_le16(mac->join_internal->data) == 0x00c0)
+		queued = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	if (queued || mac->join_inflight || mac->data_slots.count ||
+	    (mac->join_page_debt && !mt6797_ccmp_cleanup_debt_ready(mac)) ||
+	    mac->join_credit_pending)
+		return 0;
+	if (!mt6797_native_diag_cleanup_allowed(mac->native_diag_state))
+		return 0;	/* wait for the native enable/disable to retire first */
+	/* TC1 pages of the last data frame may return after its TX status; the
+	 * ledger must be whole before a cleanup command, so wait for them (the
+	 * lifetime deadline bounds the wait) rather than refuse the cleanup.
+	 */
+	if (mac->join_data_page_debt)
+		return 0;
+	deadline = min_t(u64, mac->join_deadline,
+			 ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	ret = mt6797_mac_join_guard(mac, deadline);
+	if (ret)
+		return ret;
+	if (!mt6797_hif_normal_idle(mac->hif) &&
+	    !(mt6797_ccmp_cleanup_debt_ready(mac) &&
+	      mt6797_hif_cleanup_ready(mac->hif))) {
+		/* Diagnostic only: name the host ledger terms behind this refusal
+		 * (no hardware read), then end the lifetime exactly as before.
+		 * The snapshot is a second trylock taken after the failed check,
+		 * so it describes the ledger just after the refusal, not an atomic
+		 * proof of the predicate that failed; locked=1 means the mutex was
+		 * busy again at that instant.
+		 */
+		struct mt6797_hif_ledger ledger;
+
+		mt6797_hif_normal_ledger(mac->hif, &ledger);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join cleanup refused: stage=%u phase=%u free=%u limit=%u pending_cpu=%u pending_ffa=%u sequences=%u locked=%u\n",
+			 mac->join_cleanup_stage, ledger.phase, ledger.tc4_free,
+			 ledger.tc4_limit, ledger.pending_cpu, ledger.pending_ffa,
+			 ledger.sequences, ledger.locked);
+		return -EPROTO;
+	}
+	if (mac->ccmp_pm_abort_pending) {
+		/* The abort returned to its latched debt floor. A retained page is
+		 * still charged; this credit never proves key-slot reuse.
+		 */
+		mac->ccmp_pm_abort_pending = false;
+		mac->ccmp_pm_abort_credited = true;
+		mac->ccmp_pm_connected = false;
+	}
+	if (mac->ccmp_pm_connected &&
+	    (mac->join_deauth_done || mac->ccmp_deauth_timeouts ||
+	     mt6797_ccmp_pm_holds_deauth(mac))) {
+		unsigned int deauth_debt = mt6797_ccmp_cleanup_debt_ready(mac) ? 1 : 0;
+
+		if (mac->sequence > 253)
+			return -ENOSPC;
+		mac->join_credit_deadline = deadline;
+		reinit_completion(&mac->join_credit_done);
+		mac->ccmp_cleanup_credit_floor = mac->join_page_debt;
+		mac->ccmp_cleanup_credit_active = true;
+		mac->ccmp_cleanup_op = 1;
+		mac->ccmp_cleanup_sequence = mac->sequence;
+		mac->join_credit_pending = true;
+		mac->join_page_debt = deauth_debt + 1;
+		if (deauth_debt)
+			ret = mt6797_hif_join_pm_abort_debt(mac->hif, mac->sequence++,
+							    deauth_debt, deadline);
+		else
+			ret = mt6797_hif_join_pm_abort(mac->hif, mac->sequence++, deadline);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN PM abort: sequence=%u status=%d\n", mac->sequence - 1, ret);
+		if (!ret)
+			mac->ccmp_pm_abort_pending = true;
+		return ret;
+	}
+	if (mac->join_sta_active && !mac->join_deauth_done &&
+	    !mac->ccmp_deauth_timeouts)
+		return 0;
+
+	if (mac->join_cleanup_stage == 3) {
+		if (mac->join_page_debt) {
+			mac->ccmp_cleanup_bounded_done = true;
+			mac->join_cleanup_stage = 4;
+			mac->join_closed = true;
+		}
+		mac->join_cleanup_done = true;
+		mt6797_ccmp_withdraw(mac);
+		complete_all(&mac->ccmp_cleanup_done);
+		mac->join_sta_active = false;
+		mac->join_channel_granted = false;
+		mac->bss_active = false;
+		mac->join_scan_ready = false;
+		mac->join_retired = true;
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		mac->join_open = false;
+		mac->join_running = false;
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		if (mac->ccmp_cleanup_bounded_done) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN cleanup complete: bounded_page_debt=%u healthy_stage3=0 no_reuse=1\n",
+				 mac->join_page_debt);
+		} else {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join cleanup: stage=3 credits=returned slots=retired deauth=%u delivery=%s\n",
+				 mac->join_deauth_done,
+				 mt6797_mac_deauth_verdict(mac));
+		}
+		/* This API only queues work; no synchronous MLME call under our mutex. */
+		mt6797_ccmp_connection_lost(mac, "cleanup", 0);
+		return 0;
+	}
+	if (mac->join_cleanup_stage > 3 || mac->sequence > 253)
+		return -ENOSPC;
+	/* A released privilege submits no command and consumes no new page. */
+	if (mac->join_cleanup_stage == 1 &&
+	    mac->join_channel_released && mac->join_key_pairwise != 1 &&
+	    mac->join_key_group != 1) {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join cleanup submission: stage=1 released=1\n");
+		mac->join_cleanup_stage++;
+		return 0;
+	}
+	mac->ccmp_cleanup_credit_floor = mac->join_page_debt;
+	mac->ccmp_cleanup_credit_active = true;
+	mac->ccmp_cleanup_op = mac->join_key_pairwise == 1 ? 2 :
+		mac->join_key_group == 1 ? 3 : 4 + mac->join_cleanup_stage;
+	mac->ccmp_cleanup_sequence = mac->sequence;
+	mac->join_credit_deadline = deadline;
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt += 1;
+	/* Explicit key retirement on the healthy path only, after the
+	 * deauthentication has completed (the guards above) and before stage 0:
+	 * the pinned source does not show that removing the station record
+	 * retires the group key held under the station's broadcast WLAN index,
+	 * so each submitted key is removed by its own bounded command, pairwise
+	 * first (the AP's address, unicast type, WLAN index 1), then the group
+	 * key (zero peer, type 0, the reserved WLAN index, the shape the
+	 * supplicant's index-based deletion produces in the pinned
+	 * wlanoidSetRemoveKey), each with its credit. A removal's credit proves
+	 * buffer consumption only.
+	 */
+	if (mac->join_key_pairwise == 1 || mac->join_key_group == 1) {
+		bool pairwise = mac->join_key_pairwise == 1;
+
+		ret = mt6797_hif_join_key(mac->hif, mac->sequence++, false, pairwise,
+					  pairwise ? mac->join_ap : NULL,
+					  pairwise ? 0 : mac->join_group_key_id,
+					  NULL, deadline);
+		if (ret)
+			return ret;
+		if (pairwise)
+			mac->join_key_pairwise = 2;
+		else
+			mac->join_key_group = 2;
+		return 0;
+	}
+	switch (mac->join_cleanup_stage) {
+	case 0:
+		ret = mt6797_hif_join_remove_station(mac->hif, mac->sequence++, deadline);
+		break;
+	case 1:
+		if (mac->join_channel_released) {
+			/* The privilege was released after the group key; the
+			 * stage is recorded as released and submits nothing.
+			 */
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join cleanup submission: stage=1 released=1\n");
+			mac->join_cleanup_stage++;
+			mac->join_credit_pending = false;
+			mac->join_page_debt = 0;
+			complete_all(&mac->join_credit_done);
+			return 0;
+		}
+		ret = mt6797_hif_join_channel(mac->hif, mac->sequence++,
+					      mac->join_channel_token, 40, 0, true, deadline);
+		break;
+	default:
+		mt6797_scan_bss(mac->hw->wiphy->perm_addr, false, bss);
+		ret = mt6797_hif_send_config(mac->hif, MT6797_NORMAL_BSS_ACTIVE,
+					     mac->sequence++, bss, sizeof(bss), deadline);
+		break;
+	}
+	if (!ret)
+		mac->join_cleanup_stage++;
+	return ret;
+}
+
+/* Step the asynchronous native-crypto-delivery state machine once per worker
+ * iteration. It never blocks on its own ledger: it submits exactly one enable
+ * then one disable, each charged one page with a credit deadline and reconciled
+ * on later iterations through the shared credit/page ledger, and it latches the
+ * no-radio stop (first_error + closing) before any submission on a deadline or
+ * poison. The pure transition (native-diag.h) decides; this executes the action.
+ * Mutex held (the worker).
+ */
+/* Pre-read native budget gate (mutex held). Enforced BEFORE the receive so no
+ * read crosses a ceiling and the drain/wall are honored even on an empty stream;
+ * a full HIF-max read is reserved (post-read logical_bytes is already-consumed
+ * FIFO, not a pre-read contract). Returns 0 to proceed with the receive, 1 to
+ * stop reading (window/drain complete, nothing owed), or <0 to fail-stop through
+ * the normal terminal when owed work cannot retire within the drain budget.
+ */
+static int mt6797_native_diag_pre_read(struct mt6797_mac *mac)
+{
+	u64 now;
+	unsigned int rel;
+	bool owed;
+
+	/* IDLE/CLOSED: no native gating (inherited cleanup runs its own protocol,
+	 * with the sticky plaintext withhold still in force via native_diag_engaged).
+	 */
+	if (mac->native_diag_state == MT6797_ND_IDLE ||
+	    mac->native_diag_state == MT6797_ND_CLOSED)
+		return 0;
+	/* DISABLE_PENDING: the only obligation is the disable's TC4 credit, retired
+	 * by the worker's register guard -- no RX completion is owed, so read no
+	 * generic traffic; stop until the guard reconciles and the step reaches
+	 * CLOSED.
+	 */
+	if (mac->native_diag_state == MT6797_ND_DISABLE_PENDING)
+		return 1;
+	now = ktime_get_ns();
+	owed = mac->join_inflight || mac->data_slots.count ||
+	       mac->join_page_debt || mac->join_credit_pending;
+	/* The window is over on a sample ceiling OR any data-phase end (lower
+	 * deadline / PID budget / association loss).
+	 */
+	if (!mac->native_diag_sample_done && !mac->join_data_ended)
+		return 0;
+	/* Window over: read only to drain an owed exact TX-done, within the finite
+	 * budget; nothing owed means stop at once.
+	 */
+	if (!owed)
+		return 1;
+	if (!mac->native_diag_retire_started)
+		mac->native_diag_retire_started = now;
+	rel = (unsigned int)((now - mac->native_diag_retire_started) / NSEC_PER_MSEC);
+	if (mac->native_diag_retire_reads >= MT6797_NATIVE_DIAG_RETIRE_READS ||
+	    mac->native_diag_retire_bytes + MT6797_HIF_RX_MAX_PACKET >
+	    MT6797_NATIVE_DIAG_RETIRE_BYTES ||
+	    rel >= MT6797_NATIVE_DIAG_RETIRE_MS)
+		return mac->first_error ? mac->first_error : -ETIMEDOUT;
+	return 0;
+}
+
+/* TX fence: while engaged and the window is ending or ended (sample ceiling,
+ * lower deadline, PID budget, or an already-ended data phase), hold ALL frame
+ * selection -- the reserved deauthentication included -- until the native
+ * disable has retired (state CLOSED), so no recovery TX precedes the disable.
+ */
+static bool mt6797_native_diag_tx_fenced(const struct mt6797_mac *mac)
+{
+	return mac->native_diag_engaged &&
+	       mac->native_diag_state != MT6797_ND_CLOSED &&
+	       (mac->native_diag_sample_done || mac->join_data_ended ||
+		ktime_get_ns() >= mac->join_data_deadline ||
+		mac->join_next_pid > MT6797_JOIN_DATA_LAST_PID);
+}
+
+void mt6797_native_diag_step(struct mt6797_mac *mac)
+{
+	struct mt6797_native_diag_ctx c;
+	struct mt6797_native_diag_budget b;
+	unsigned char prev = mac->native_diag_state;
+	enum mt6797_native_diag_action act;
+	u64 now = ktime_get_ns();
+	int rc;
+
+	b.elapsed_ms = mac->native_diag_started ?
+		(unsigned int)((now - mac->native_diag_started) / NSEC_PER_MSEC) : 0;
+	b.total_rx = mac->native_diag_total;
+	b.native_rx = mac->ccmp_queued;
+	b.bytes = mac->native_diag_bytes;
+	c.state = mac->native_diag_state;
+	c.armed = true;
+	c.data_phase = mac->join_data_phase && !mac->join_data_ended &&
+		       mac->join_key_pairwise == 1 && mac->join_key_group == 1 &&
+		       now < mac->join_data_deadline;
+	c.quiescent = !mac->join_credit_pending && !mac->join_page_debt &&
+		      !mac->join_inflight && !mac->data_slots.count;
+	c.poisoned = mac->first_error || mac->closing;
+	c.deadline_passed = (mac->native_diag_state == MT6797_ND_ENABLE_PENDING ||
+			     mac->native_diag_state == MT6797_ND_DISABLE_PENDING) &&
+			    now >= mac->join_credit_deadline;
+	c.seq_ok = mac->sequence <= 253;
+	c.budget_stop = mac->native_diag_sample_done ||
+		mt6797_ccmp_diag_budget_step(&b) == MT6797_NATIVE_DIAG_STOP;
+	act = mt6797_native_diag_transition(&c);
+	mac->native_diag_state = c.state;
+	if (act == MT6797_ND_ACT_SUBMIT_ENABLE || act == MT6797_ND_ACT_SUBMIT_DISABLE) {
+		rc = mt6797_hif_diag_mask(mac->hif, mac->sequence++,
+					  act == MT6797_ND_ACT_SUBMIT_ENABLE,
+					  min_t(u64, mac->join_deadline,
+						ktime_get_ns() + 100 * NSEC_PER_MSEC));
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN mask-control submission: enable=%u status=%d\n",
+			 (unsigned int)(act == MT6797_ND_ACT_SUBMIT_ENABLE), rc);
+		if (rc) {
+			if (!mac->first_error)
+				mac->first_error = rc;
+			mac->closing = true;	/* ambiguous submit: no further radio */
+			mac->native_diag_state = MT6797_ND_CLOSED;
+		} else {
+			/* Charge one page on the SHARED ledger with the shared credit
+			 * deadline the parent poller enforces (and poisons on timeout).
+			 */
+			mac->join_credit_deadline = now + 100 * NSEC_PER_MSEC;
+			reinit_completion(&mac->join_credit_done);
+			mac->join_credit_pending = true;
+			mac->join_page_debt = 1;
+			if (act == MT6797_ND_ACT_SUBMIT_ENABLE)
+				mac->native_diag_engaged = true;  /* sticky: no legacy RX again */
+		}
+	} else if (act == MT6797_ND_ACT_LATCH_NORADIO) {
+		if (!mac->first_error)
+			mac->first_error = -ETIMEDOUT;
+		mac->closing = true;
+	}
+	if (prev != MT6797_ND_CLOSED && mac->native_diag_state == MT6797_ND_CLOSED &&
+	    mac->native_diag_engaged)
+		mt6797_mac_join_end_data(mac, "native-diag");
+	if (prev != MT6797_ND_ACTIVE && mac->native_diag_state == MT6797_ND_ACTIVE)
+		mac->native_diag_started = now;
+}
+
+/* End the data phase once: the reserved deauthentication's hold ends now and
+ * the poller sends it, then the teardown follows. Called with the mutex held.
+ */
+void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
+{
+	u64 now, teardown_end;
+
+	if (!mac->join_data_phase || mac->join_data_ended)
+		return;
+	/* Only the first end owns the teardown fence. */
+	now = ktime_get_ns();
+	mac->join_data_ended = true;
+	teardown_end = now + (u64)MT6797_JOIN_TEARDOWN_MARGIN_MS * NSEC_PER_MSEC;
+	mac->join_deadline = min(mac->join_deadline, teardown_end);
+	mac->join_hold_until = ktime_get_ns();
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join data phase end: reason=%s elapsed_ms=%llu rx_delivered=%u tx_queued=%u tx_done=%u tx_failed=%u tx_credits=%u\n",
+		 reason, (ktime_get_ns() - mac->join_data_started) / NSEC_PER_MSEC,
+		 mac->ccmp_rx_delivered,
+		 mac->join_data_tx_queued, mac->join_data_tx_done, mac->join_data_tx_failed,
+		 mac->join_data_credits);
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join data backpressure: stops=%u wakes=%u dropped_full=%u stopped=%u high_water=%u bound=%u\n",
+		 mac->tx_queue_stops, mac->tx_queue_wakes, mac->tx_dropped_full,
+		 mac->tx_queues_stopped, mac->tx_queue_high_water,
+		 MT6797_JOIN_DATA_TX_QUEUE);
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN data qos: wmm_requested=%u wmm_accepted=%u ac_params=%u tx_qos=%u tx_nonqos=%u tx_tid_refused=%u tx_tid=%u/%u/%u/%u/%u/%u/%u/%u rx_qos=%u rx_nonqos=%u rx_refused=%u rx_refused_qos=%u rx_llc_mis=%u\n",
+		 mac->join_wmm_requested, mac->join_wmm_accepted, mac->qos_ac_params,
+		 mac->qos_tx, mac->qos_tx_nonqos, mac->qos_tx_tid_refused,
+		 mac->qos_tx_tid[0], mac->qos_tx_tid[1], mac->qos_tx_tid[2],
+		 mac->qos_tx_tid[3], mac->qos_tx_tid[4], mac->qos_tx_tid[5],
+		 mac->qos_tx_tid[6], mac->qos_tx_tid[7],
+		 mac->qos_rx, mac->qos_rx_nonqos, mac->qos_rx_refused,
+		 mac->qos_rx_refused_qos, mac->join_data_llc_discarded);
+	{
+		struct mt6797_hif_rx_batch_stats batch;
+
+		mt6797_hif_rx_batch_stats(mac->hif, &batch);
+		if (batch.refused_error)
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN HIF RX batch refused: error=%d queue=%u frames=%u bytes=%u first_length=%u capacity=%u dma=%u read=%u\n",
+				 batch.refused_error, batch.refused_queue, batch.refused_frames,
+				 batch.refused_bytes, batch.refused_first_length,
+				 batch.refused_capacity,
+				 batch.refused_bytes >= MT6797_HIF_DMA_MIN_BYTES,
+				 batch.refused_read);
+	}
+}
+
+/* Open the bounded data phase after the group key's credit, inside the live
+ * channel grant. The reference run 3 ledger places every one of the vendor's
+ * first data frames inside its grant, with the CH_PRIVILEGE abort about four
+ * seconds after the request and data continuing afterwards under a BSS it
+ * had declared connected; runtime 25 (proposal 0165) aborted the privilege
+ * before the first data frame, an order the vendor never showed, and that
+ * frame produced no TX status within its deadline. The privilege is now kept
+ * through the data phase and returned by cleanup stage 1 as before 0165
+ * (`released` stays false). The data phase ends at the budget or, sooner, a
+ * tail before the grant's end so the reserved deauthentication keeps its
+ * grant room; the lifetime deadline becomes that end plus the teardown
+ * margin. No command is submitted here. Data after a release stays
+ * unmeasured on the default path. The separately selected channel-release
+ * comparison below retains a finite data window while returning privilege.
+ */
+int mt6797_mac_join_release_channel(struct mt6797_mac *mac)
+{
+	u64 now = ktime_get_ns(), grant_end;
+
+	if (!mac->ccmp_pm_connected || !mac->ccmp_pm_credit_ns)
+		return -EOPNOTSUPP;
+	if (!mac->join_channel_granted || mac->join_channel_released ||
+	    mac->join_data_phase || mac->join_page_debt || mac->join_credit_pending)
+		return -EBUSY;
+	if (mac->join_grant_deadline <= now + (u64)MT6797_JOIN_GRANT_TAIL_MS * NSEC_PER_MSEC)
+		return -ETIMEDOUT;
+	grant_end = mac->join_grant_deadline - (u64)MT6797_JOIN_GRANT_TAIL_MS * NSEC_PER_MSEC;
+	mac->join_data_phase = true;
+	mac->join_data_ended = false;
+	mac->join_data_started = now;
+	/* Only this comparison separates connected data from join privilege.
+	 * Keep the same data budget and teardown margin; release before the old
+	 * grant tail, with no new TX until its command credit returns.
+	 */
+	mac->ccmp_channel_release_at = grant_end;
+	/* Connected BSS ownership is independent of the finite join fence.
+	 * end_data arms the existing bounded teardown fence exactly once.
+	 */
+	mac->join_data_deadline = U64_MAX;
+	mac->join_deadline = U64_MAX;
+	mac->join_hold_until = mac->join_data_deadline;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN connected data phase: teardown_margin_ms=%u no_reuse=1\n",
+		 MT6797_JOIN_TEARDOWN_MARGIN_MS);
+	return 0;
+}
+
+/* Return 1 to hold new TX while releasing the join privilege. The existing
+ * worker still drains RX and reconciles credit; no blocking wait under mutex.
+ * The public AIS NORMAL_TR join-timer path releases CH_PRIVILEGE while the
+ * connected BSS remains active. This bounded comparison tests that ownership
+ * independently of a longer grant. No key or PID can be reused here.
+ */
+static int mt6797_ccmp_channel_release_step(struct mt6797_mac *mac, u64 now)
+{
+	u64 deadline;
+	int ret;
+
+	if (mac->join_channel_released)
+		return 0;
+	if (!mac->ccmp_channel_release_pending &&
+	    (!mac->join_data_phase || mac->join_data_ended ||
+	     now < mac->ccmp_channel_release_at))
+		return 0;
+	if (mac->first_error || mac->closing || mac->join_retired ||
+	    !mac->join_running || !mac->join_channel_granted ||
+	    !mac->ccmp_pm_connected || !mac->ccmp_pm_credit_ns ||
+	    !mac->join_sta_active || mac->join_key_pairwise != 1 ||
+	    mac->join_key_group != 1)
+		return -EPROTO;
+	if (now >= mac->join_grant_deadline || now >= mac->join_deadline)
+		return -ETIMEDOUT;
+	if (mac->ccmp_channel_release_pending) {
+		if (mac->join_credit_pending || mac->join_page_debt)
+			return 1;
+		mac->ccmp_channel_release_pending = false;
+		mac->join_channel_released = true;
+		mac->join_channel_granted = false;
+		return 0;
+	}
+	/* Stop selecting new frames at the old grant tail. An already owned TX
+	 * must complete and both real ledgers must be whole before the abort.
+	 * The unchanged frame bound and remaining tail bound this drain.
+	 */
+	if (mac->join_inflight || mac->data_slots.count || mac->join_credit_pending ||
+	    mac->join_page_debt || mac->join_data_page_debt)
+		return 1;
+	if (mac->sequence > 253)
+		return -ENOSPC;
+	deadline = min_t(u64, now + 100 * NSEC_PER_MSEC,
+			 min(mac->join_deadline, mac->join_grant_deadline));
+	mac->join_credit_deadline = deadline;
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 1;
+	mac->ccmp_channel_release_pending = true;
+	mac->ccmp_channel_release_sequence = mac->sequence++;
+	ret = mt6797_hif_join_channel(mac->hif, mac->ccmp_channel_release_sequence,
+				      mac->join_channel_token, 40, 0, true, deadline);
+	mt6797_mac_join_refused(mac, ret);
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN connected channel release: credited=0 sequence=%u status=%d observed_ns=%llu pm_offset_ns=%llu debt=%u\n",
+		 mac->ccmp_channel_release_sequence, ret, now, now - mac->ccmp_pm_credit_ns,
+		 mac->join_page_debt);
+	return ret ? ret : 1;
+}
+
+/* The lifetime's one terminal path (mutex held): the stopped footer, the
+ * first error, the flags that fence every producer, the waiters completed,
+ * and the queued and in-flight frames moved to `discard` for the caller to
+ * free outside the locks. The worker reaches it from its own checks; a key
+ * command refused while the lifetime runs reaches it synchronously (runtime
+ * 23 retired there directly and left no terminal record, and the supplicant's
+ * disconnect could then close the lifetime before any footer). Once it has
+ * run, join_retired fences the worker and mt6797_mac_join_close frees nothing
+ * twice.
+ */
+int mt6797_mac_join_fail_stop(struct mt6797_mac *mac, int ret,
+			      unsigned int branch,
+				     struct sk_buff_head *discard,
+				     struct sk_buff **internal)
+{
+	unsigned long flags;
+
+	mt6797_ccmp_withdraw(mac);
+	complete_all(&mac->ccmp_cleanup_done);
+
+	dev_err(wiphy_dev(mac->hw->wiphy),
+		"one-shot WLAN join stopped: status=%d first=%d submitted=0x%x debt=%u cleanup=%u branch=%u\n",
+		ret, mac->first_error, mac->join_submitted,
+		mac->join_page_debt, mac->join_cleanup_stage, branch);
+	if (mac->join_data_phase)
+		mt6797_ccmp_connection_lost(mac, "terminal", 0);
+	if (!ret)
+		ret = -E2BIG;
+	if (!mac->first_error)
+		mac->first_error = ret;
+	mac->closing = true;
+	mac->join_retired = true;
+	mac->join_channel_pending = false;
+	mac->join_sta_pending = false;
+	complete_all(&mac->join_channel_done);
+	complete_all(&mac->join_sta_done);
+	mac->join_credit_pending = false;
+	complete_all(&mac->join_credit_done);
+	complete_all(&mac->join_frame_done);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	skb_queue_splice_init(&mac->join_queue, discard);
+	mac->join_queue_bytes = 0;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	{
+		struct sk_buff *owned;
+
+		while ((owned = mt6797_data_pop(&mac->data_slots)))
+			__skb_queue_tail(discard, owned);
+	}
+	if (mac->join_inflight) {
+		__skb_queue_tail(discard, mac->join_inflight);
+		mac->join_inflight = NULL;
+	}
+	/* This tick may already own the retired deauth in discard. Preserve its
+	 * free path if a later guard/cleanup command fails in the same tick.
+	 */
+	if (!*internal)
+		*internal = mac->join_internal;
+	mac->join_internal = NULL;
+	return ret;
+}
+
+/* Count one data frame's completion; eight failures in a row end the data
+ * phase.
+ */
+static void mt6797_mac_data_tx_counted(struct mt6797_mac *mac, bool ack)
+{
+	if (ack) {
+		mac->join_data_tx_done++;
+		mac->join_data_tx_failures_in_row = 0;
+		return;
+	}
+	mac->join_data_tx_failed++;
+	if (++mac->join_data_tx_failures_in_row >= MT6797_JOIN_DATA_TX_FAILURES)
+		mt6797_mac_join_end_data(mac, "txfail");
+}
+
+void mt6797_mac_join_work(struct work_struct *work)
+{
+	struct mt6797_mac *mac = container_of(to_delayed_work(work),
