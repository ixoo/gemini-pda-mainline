+int mt6797_hif_query_capability(struct mt6797_hif *hif, unsigned int sequence,
+				u64 deadline_ns,
+				struct mt6797_normal_capability *capability,
+				struct mt6797_capability_trace *trace)
+{
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	u32 lengths;
+	int error;
+
+	if (!capability || !trace)
+		return -EINVAL;
+	*capability = (struct mt6797_normal_capability){0};
+	*trace = (struct mt6797_capability_trace){0};
+	if (!hif || sequence > 255)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	trace->stage = MT6797_CAP_ENTER;
+	if (!hif->firmware_ready || hif->capability_attempted ||
+	    hif->transaction->phase != MT6797_INIT_IDLE) {
+		error = -EIO;
+		goto unlock;
+	}
+	hif->capability_attempted = true;
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto out;
+	/* The source reset is a software ledger reset; the sole normal user in
+	 * this driver starts with its selected 26-page default, not INIT TC4.
+	 */
+	trace->stage = MT6797_CAP_ADMIT;
+	error = mt6797_normal_admit(&hif->normal, 26, 26,
+				    hif->transaction->used_sequences);
+	if (error)
+		goto out;
+	/* Data pool: a declared 52-page TC1 budget, four 1518-byte frames with
+	 * their descriptors (13 pages each). The vendor driver's default host
+	 * budget for this queue is 36 such frames (468 pages), and the 26-page
+	 * TC4 pool observed on the device is exactly its two-frame default, so
+	 * the admitted frames stay inside the firmware's allocation at every
+	 * depth the option allows (13 pages a frame: 52 at four, the series'
+	 * default; 104 at eight; 156 at twelve). The ledger still refuses any
+	 * return that exceeds the debit.
+	 */
+	error = mt6797_normal_admit_tc1(&hif->normal, MT6797_TC1_LEDGER_PAGES,
+					MT6797_TC1_LEDGER_PAGES);
+	if (error)
+		goto out;
+	/* A pre-existing port-1 event would make its reply owner ambiguous.
+	 * Port 0 has a separate FIFO and may hold a post-START packet.
+	 */
+	trace->stage = MT6797_CAP_PRE_WRPLR;
+	error = mt6797_hif_read32_locked(hif, 0x90, &lengths);
+	if (error)
+		goto out;
+	trace->pre_valid = true;
+	trace->pre_wrplr = lengths;
+	if (lengths & 0xffff0000U) {
+		error = -EBUSY;
+		goto out;
+	}
+	trace->stage = MT6797_CAP_PREPARE;
+	error = mt6797_normal_prepare(&hif->normal, MT6797_NORMAL_CAPABILITY,
+				      sequence, NULL, 0, hif->scratch,
+				      sizeof(hif->scratch), &command);
+	if (error)
+		goto out;
+	trace->stage = MT6797_CAP_TX;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch, MT6797_NORMAL_CAP_BYTES,
+					sizeof(hif->scratch), &transfer);
+	trace->tx_setup = transfer.setup_submitted;
+	trace->tx_complete = transfer.transfer_complete;
+	trace->tx_bytes = transfer.data_bytes;
+	if (!error)
+		trace->stage = MT6797_CAP_SUBMIT;
+	error = mt6797_normal_submitted(&hif->normal, error);
+	if (error)
+		goto out;
+	for (;;) {
+		trace->stage = MT6797_CAP_POST_WRPLR;
+		error = mt6797_hif_read32_locked(hif, 0x90, &lengths);
+		if (error)
+			goto out;
+		trace->post_valid = true;
+		trace->post_wrplr = lengths;
+		trace->stage = MT6797_CAP_REPLY_SPAN;
+		error = mt6797_normal_reply_span(&hif->normal, lengths >> 16,
+						 sizeof(hif->scratch), &command);
+		if (error != -EAGAIN)
+			break;
+		error = mt6797_hif_guard(hif);
+		if (error)
+			goto out;
+		usleep_range(50, 100);
+	}
+	if (error)
+		goto out;
+	trace->stage = MT6797_CAP_RX;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x54, MT6797_HIF_READ,
+					hif->scratch, command.transfer_bytes,
+					sizeof(hif->scratch), &transfer);
+	trace->rx_setup = transfer.setup_submitted;
+	trace->rx_complete = transfer.transfer_complete;
+	trace->rx_bytes = transfer.data_bytes;
+	if (error)
+		goto out;
+	trace->event_length = mt6797_normal_le16(hif->scratch);
+	trace->packet_type = mt6797_normal_le16(hif->scratch + 2);
+	trace->event_id = hif->scratch[4];
+	trace->event_sequence = hif->scratch[5];
+	trace->stage = MT6797_CAP_RX_GUARD;
+	error = mt6797_hif_guard(hif);
+	if (error)
+		goto out;
+	trace->stage = MT6797_CAP_PARSE;
+	error = mt6797_normal_accept_capability(&hif->normal, hif->scratch,
+						MT6797_NORMAL_CAP_BYTES,
+						capability);
+	if (!error) {
+		trace->stage = MT6797_CAP_DONE;
+		hif->capability_complete = true;
+	}
+out:
+	if (error) {
+		*capability = (struct mt6797_normal_capability){0};
+		error = mt6797_hif_fail(hif, error);
+	}
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_query_capability);
+
+static int
+mt6797_hif_send_join_command_debt(struct mt6797_hif *hif,
+				  unsigned int cid, unsigned int sequence,
+				  const u8 *payload, size_t payload_bytes, bool sensitive,
+				  u64 deadline_ns, unsigned int deauth_pages)
+{
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	int error;
+
+	if (!hif || !payload)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || !hif->capability_complete ||
+	    hif->transaction->phase != MT6797_INIT_IDLE ||
+	    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
+		error = -EIO;
+		goto unlock;
+	}
+	if (deauth_pages) {
+		if (cid != 0x17 || payload_bytes != 4 || payload[0] || payload[1] ||
+		    payload[2] || payload[3]) {
+			error = -EINVAL;
+			goto unlock;
+		}
+		error = mt6797_join_prepare_cleanup_abort(&hif->normal, sequence,
+							  deauth_pages, hif->scratch,
+							  sizeof(hif->scratch), &command);
+	} else {
+		error = mt6797_join_prepare_command(&hif->normal, cid, sequence,
+						    payload, payload_bytes, hif->scratch,
+						    sizeof(hif->scratch), &command);
+	}
+	if (error)
+		goto unlock;
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto fail;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch, 8 + payload_bytes,
+					sizeof(hif->scratch), &transfer);
+	error = mt6797_normal_submitted(&hif->normal, error);
+	if (!error)
+		error = mt6797_hif_guard(hif);
+fail:
+	if (error)
+		error = mt6797_hif_fail(hif, error);
+unlock:
+	/* Key material must not outlive its transfer in the shared buffer. */
+	if (sensitive)
+		memzero_explicit(hif->scratch, sizeof(hif->scratch));
+	mutex_unlock(&hif->mutex);
+	return error;
+}
