+static void mt6797_mac_sta_set_decap_offload(struct ieee80211_hw *hw,
+					     struct ieee80211_vif *vif,
+					     struct ieee80211_sta *sta, bool enabled)
+{
+	struct mt6797_mac *mac = hw->priv;
+
+	mutex_lock(&mac->mutex);
+	mac->ccmp_decap = enabled && vif == mac->vif && !mac->ccmp_closed &&
+		mac->ccmp_rx.active && mac->ccmp_rx.authorized &&
