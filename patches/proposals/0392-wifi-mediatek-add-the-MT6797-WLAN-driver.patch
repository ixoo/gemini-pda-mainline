+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_PRIVATE_HIF_H
+#define MT6797_PRIVATE_HIF_H
+
+#include <linux/io.h>
+#include <linux/types.h>
+#include "hif-init.h"
+#include "mcu.h"
+
+struct mt6797_hif;
+
+struct mt6797_hif_section_request {
+	enum mt6797_section_kind kind;
+	const u8 *config;
+	size_t config_bytes;
+	unsigned int sequence;
+	const u8 *data;
+	size_t length;
+};
+
+struct mt6797_hif_section_result {
+	size_t submitted;
+	unsigned int firmware_status;
+};
+
+enum mt6797_capability_stage {
+	MT6797_CAP_ENTER, MT6797_CAP_ADMIT, MT6797_CAP_PRE_WRPLR,
+	MT6797_CAP_PREPARE, MT6797_CAP_TX, MT6797_CAP_SUBMIT,
+	MT6797_CAP_POST_WRPLR, MT6797_CAP_REPLY_SPAN, MT6797_CAP_RX,
+	MT6797_CAP_RX_GUARD, MT6797_CAP_PARSE, MT6797_CAP_DONE,
+};
+
+/* Header fields only: no MAC, date, reserved bytes or payload. Values are
+ * meaningful only when the corresponding read/transfer completed.
+ */
+struct mt6797_capability_trace {
+	enum mt6797_capability_stage stage;
+	u32 pre_wrplr, post_wrplr;
+	size_t tx_bytes, rx_bytes;
+	unsigned int event_length, packet_type;
+	u8 event_id, event_sequence;
+	bool pre_valid, post_valid, tx_setup, tx_complete;
+	bool rx_setup, rx_complete;
+};
+
+/* Pinned CFG_RX_MAX_PKT_SIZE = 28 + 2312 + 12. The extra four-byte read
+ * and block rounding fit the retained 2560-byte HIF scratch buffer.
+ */
+#define MT6797_HIF_RX_MAX_PACKET 2352U
+
+struct mt6797_hif_rx_result {
+	u32 pre_wrplr, post_wrplr;
+	size_t staging_bytes, logical_bytes;
+	unsigned int packet_type;
+	bool pre_valid, rx_setup, rx_complete, post_valid;
+	/* Selected-runtime API only: selection from the existing pre word.
+	 * Valid means a nonzero advertised half, not an accepted packet.
+	 */
+	unsigned int selected_port;
+	bool selected_port_valid;
+	/* Failure-only observations; zero is absent unless the valid bit is set. */
+	enum {
+		MT6797_HIF_RX_REFUSAL_NONE,
+		MT6797_HIF_RX_REFUSAL_LENGTH,
+		MT6797_HIF_RX_REFUSAL_HEADER,
+	} protocol_refusal;
+	unsigned int selected_length, header_length;
+	bool header_valid;
+	/* Already-staged framing hint on header-length refusal only; untrusted. */
+	u16 refused_type_word;
+	bool refused_type_valid;
+	/* Raw base fields, not a validated RXD or packet interpretation. */
+	u8 refused_header_control;
+	u16 refused_status_flags;
+	bool refused_base_valid;
+};
+
+/* One interrupt/control and eight returned-page register reads. WHISR and
+ * returned counts may be read-consuming; this is not a passive MMIO dump.
+ * Each valid bit names a completed word (WHCR, WHISR, then WTQCR0..7).
+ * Counts are observations only: no credit is replenished by this interface.
+ */
+struct mt6797_hif_tx_status {
+	u32 whcr, whisr, wtqcr[8];
+	unsigned int valid_words;
+	u32 synthesized;	/* done bits implied by block-carried counts (0268) */
+};
+
+/* Allocation owns memory only. Caller retains the real powered mapping,
+ * transaction, exclusive driver ownership, IRQ quiescence and reset exclusion
+ * through all calls. No ownership acquisition, INIT seeding or reset occurs.
+ * The mutex serializes this context only, not another driver or firmware.
+ */
+struct mt6797_hif *
+mt6797_hif_alloc(void __iomem *base, size_t span,
+		 struct mt6797_init_transaction *transaction);
+/* Caller has stopped/joined every user; this frees no provider resources
+ * except a DMA attachment made through mt6797_hif_attach_dma.
+ */
+void mt6797_hif_free(struct mt6797_hif *hif);
+
+struct device;
+struct clk;
+/* Attach the Wi-Fi HIF's AP-DMA channel 0 (its 0x80-byte register window)
+ * for the data ports: the fixed data-port FIFO's physical address, the
+ * device that owns the coherent bounce buffer, the AP-DMA clock, and whether
+ * the address-extension bits are set on each start. Data-port transfers of
+ * at least MT6797_HIF_DMA_MIN_BYTES then move by DMA where the build admits
+ * the direction; everything else stays PIO. Returns zero or an error that
+ * leaves the context on PIO.
+ */
+int mt6797_hif_attach_dma(struct mt6797_hif *hif, void __iomem *window,
+			  phys_addr_t fifo, struct device *dev, struct clk *clk,
+			  bool addr2);
+#define MT6797_HIF_DMA_MIN_BYTES 64U
+/* DMA transfer counters for the records: zero when no channel is attached. */
+struct mt6797_hif_rx_batch_stats {
+	unsigned int failures;
+	unsigned int credit_blocks;
+	u32 block_whisr, block_abnormal, pending_wtqcr0, pending_wtqcr7;
+	int error;
+	/* The first aggregate read the transfer refused (0311). */
+	int refused_error;
+	unsigned int refused_queue, refused_frames, refused_bytes, refused_read;
+	unsigned int refused_first_length, refused_capacity;
+};
+
+void mt6797_hif_rx_batch_pass(struct mt6797_hif *hif);
+void mt6797_hif_rx_batch_stats(const struct mt6797_hif *hif,
+			       struct mt6797_hif_rx_batch_stats *stats);
+
+/* Absolute monotonic nanoseconds; positive remaining budget <= one second.
+ * WCIR (0), WHLPCR (4), WRPLR (0x90) only. No register writes are exposed.
+ */
+int mt6797_hif_read32(struct mt6797_hif *hif, unsigned int reg, u64 deadline_ns,
+		      u32 *value);
+/* One ordinary section only, <=1 MiB. Caller supplies immutable, validated,
+ * distinct metadata/data and retains them until return. Successful submission
+ * is neither whole-image completion nor permission to issue START.
+ */
+int
+mt6797_hif_download_section(struct mt6797_hif *hif,
+			    const struct mt6797_hif_section_request *request,
+			    u64 deadline_ns, struct mt6797_hif_section_result *result);
+
+/* Caller proves complete image/EMI sealing and retains all owner resources
+ * before calling: an uncertain write can already have started firmware.
+ * Same mapping, IRQ/reset exclusion and immutable storage contract as download.
+ * One attempt per context. Zero means START TX submitted, never readiness.
+ * No ACK read, image completeness check, ownership acquisition or retry occurs.
+ */
+int mt6797_hif_start_submit(struct mt6797_hif *hif, const u8 *command,
+			    size_t bytes, unsigned int sequence, u64 deadline_ns);
+/* One actual WCIR read under the unchanged START absolute deadline. Zero means
+ * the ready level was observed, -EAGAIN means pending; neither proves causality.
+ * Pending observations may repeat only before that deadline. Other failures
+ * poison the retained transaction. No internal polling or renewed budget.
+ */
+int mt6797_hif_start_observe_ready(struct mt6797_hif *hif, u32 *wcir);
+
+/* At most one pre-normal snapshot and two post-record snapshots per boot.
+ * Requires ready firmware, the retained exclusive HIF owner, disabled IRQs
+ * and no competing counter reader. The post-record pair holds one HIF lock.
+ * count=1 before normal commands, count=2 after record; status has count
+ * elements. Partial acquisition poisons the session.
+ */
+int mt6797_hif_observe_tx_status(struct mt6797_hif *hif, u64 deadline_ns,
+				 unsigned int count,
+				 struct mt6797_hif_tx_status *status);
+
+/* Same acquisition budgets and exclusive owner as observation, but require
+ * zero returned-page baseline before normal commands. Account both complete
+ * post-record snapshots atomically against the retained TC4 ledger. Non-CPU
+ * counts, over-release or any partial acquisition poison without refund.
+ * account has count elements; no added I/O, IRQ, radio or sequence mutation.
+ */
+int mt6797_hif_account_tx_status(struct mt6797_hif *hif, u64 deadline_ns,
+				 unsigned int count,
+				 struct mt6797_hif_tx_status *status,
+				 struct mt6797_normal_release *account);
+
+/* One fresh runtime snapshot on the mature exclusive TC4 owner. Requires
+ * the accounting baseline and complete post-configuration pair. No diagnostic
+ * budget is reset. Caller bounds its runtime work and retains IRQ exclusion;
+ * other traffic classes are still forbidden. A partial/invalid snapshot poisons
+ * without committing credit, and separate pending CPU/FFA counts are retained.
+ */
+int mt6797_hif_reconcile_runtime(struct mt6797_hif *hif, u64 deadline_ns,
+				 struct mt6797_hif_tx_status *status,
+				 struct mt6797_normal_release *account);
+
+/* Exactly one post-START capability query on this exclusive PIO owner.
+ * The selected gen3 default normal TC4 allocation is 26 pages; this driver
+ * has no Tc4Page override or competing normal command user. One page is
+ * debited without replenishment. A timeout or unexpected event poisons the
+ * session; no radio command, calibration payload or packet DMA is issued.
+ */
+int mt6797_hif_query_capability(struct mt6797_hif *hif, unsigned int sequence,
+				u64 deadline_ns,
+				struct mt6797_normal_capability *capability,
+				struct mt6797_capability_trace *trace);
+
+/* Send one selected no-reply configuration or bounded scan command on the
+ * retained normal owner. The caller owns payload provenance, ordering and regulatory policy.
+ * A successful return proves only PIO submission, not firmware application.
+ */
+
+/* Process context only. Encoded payloads do not prove slot ownership or
+ * legal channel admission. The MAC owner must serialize pending responses,
+ * enforce monotonic deadlines and use each sequence/token once per session.
+ * Zero means PIO submission; credit and firmware response are separate.
+ */
+int mt6797_hif_join_filter(struct mt6797_hif *hif, unsigned int sequence,
+			   u64 deadline_ns);
+/* One key add or removal command (pinned gen3 CMD_ID_ADD_REMOVE_KEY); the
+ * payload holds the 16 key bytes only until submission and is then cleared.
+ */
+int mt6797_hif_join_key(struct mt6797_hif *hif, unsigned int sequence,
+			bool add, bool pairwise, const u8 *peer,
+			unsigned int key_id, const u8 *material, u64 deadline_ns);
+int mt6797_hif_join_pm_connected(struct mt6797_hif *hif, unsigned int sequence,
+				 unsigned int dtim, unsigned int aid, unsigned int interval,
+				 u64 deadline_ns);
+int mt6797_hif_join_pm_abort(struct mt6797_hif *hif, unsigned int sequence,
+			     u64 deadline_ns);
+int mt6797_hif_join_pm_abort_debt(struct mt6797_hif *hif, unsigned int sequence,
+				  unsigned int deauth_pages, u64 deadline_ns);
+bool mt6797_hif_cleanup_abort_ready(struct mt6797_hif *hif);
+int mt6797_hif_retain_cleanup_page(struct mt6797_hif *hif);
+bool mt6797_hif_cleanup_ready(struct mt6797_hif *hif);
+int mt6797_hif_join_station(struct mt6797_hif *hif, unsigned int sequence,
+			    const u8 *ap, unsigned int state, unsigned int aid,
+	unsigned int desired_rates, unsigned int basic_rates, u64 deadline_ns);
+int mt6797_hif_join_bss_qos(struct mt6797_hif *hif, unsigned int sequence,
+			    const u8 *ap, const u8 *ssid, unsigned int ssid_bytes,
+	unsigned int desired_rates, unsigned int basic_rates,
+	bool short_preamble, bool wpa2, bool qos, const u8 *ht_op,
+	u64 deadline_ns);
+int mt6797_hif_join_station_qos(struct mt6797_hif *hif, unsigned int sequence,
+				const u8 *ap, unsigned int state, unsigned int aid,
+	unsigned int desired_rates, unsigned int basic_rates, bool qos,
+	const u8 *ht_cap, u64 deadline_ns);
+int mt6797_hif_join_remove_station(struct mt6797_hif *hif,
+				   unsigned int sequence, u64 deadline_ns);
+int mt6797_hif_join_channel(struct mt6797_hif *hif, unsigned int sequence,
+			    u8 token, u8 channel, unsigned int interval_ms, bool abort,
+			    u64 deadline_ns);
+/* The same request with ucRfSco (byte 4) set: 0, or 3 (below) on channel 40. */
+int mt6797_hif_join_channel_sco(struct mt6797_hif *hif, unsigned int sequence,
+				u8 token, u8 channel, u8 sco, unsigned int interval_ms,
+				u64 deadline_ns);
+
+/* The proven data path's monitor control: the fixed-address mask store. */
+int mt6797_hif_diag_mask(struct mt6797_hif *hif, unsigned int sequence,
+			 bool enable, u64 deadline_ns);
+
+/* One native bounded management frame through the existing TC4 PIO owner.
+ * Process context only. Caller owns station/channel generation, destination,
+ * exact frame-body admission and single-use PID. No overlapping page debt.
+ * Zero proves PIO submission only; credit returns and TXdone remain separate.
+ */
+bool mt6797_hif_normal_idle(struct mt6797_hif *hif);
+/* Release sequences first..255 of the adapter history for reuse, only while
+ * the normal owner is idle (every page returned); -EBUSY otherwise.
+ */
+int mt6797_hif_recycle_sequences(struct mt6797_hif *hif, unsigned int first);
+
+/* Diagnostic snapshot of the normal transaction's page ledger. */
+struct mt6797_hif_ledger {
+	unsigned int phase, tc4_free, tc4_limit, pending_cpu, pending_ffa;
+	unsigned int tc1_free, tc1_limit, tc1_pending;
+	bool sequences, locked;
+};
+
+void mt6797_hif_normal_ledger(struct mt6797_hif *hif, struct mt6797_hif_ledger *out);
+int mt6797_hif_next_sequence(struct mt6797_hif *hif);
+int mt6797_hif_power_off(struct mt6797_hif *hif, unsigned int sequence,
+			 u64 deadline_ns, u32 *wcir);
+int mt6797_hif_send_management(struct mt6797_hif *hif, const u8 *frame,
+			       size_t frame_bytes, u8 wlan, u8 pid,
+			      unsigned int lifetime_ms, unsigned int attempt_count,
+			      u64 deadline_ns);
+/* Ordinary data descriptors carry the fixed-rate bandwidth FIX_BW_40 (0324). */
+void mt6797_hif_set_data_bw40(struct mt6797_hif *hif, bool bw40);
+/* rate: this frame's rate over the fixed one, or NULL. */
+int mt6797_hif_send_data_report(struct mt6797_hif *hif, const u8 *frame,
+				size_t frame_bytes, u8 wlan, u8 pid,
+				bool status_report,
+				unsigned int lifetime_ms, unsigned int attempt_count,
+				const struct mt6797_tx_rate *rate, u64 deadline_ns);
+int mt6797_hif_send_security(struct mt6797_hif *hif, const u8 *frame,
+			     size_t frame_bytes, u8 wlan, u8 pid,
+			     unsigned int lifetime_ms, unsigned int attempt_count,
+			     u64 deadline_ns);
+
+int mt6797_hif_send_config(struct mt6797_hif *hif,
+			   enum mt6797_normal_config_kind kind,
+			   unsigned int sequence, const u8 *payload,
+			   size_t payload_bytes, u64 deadline_ns);
+
+/* Read one complete queued port-0 or port-1 packet through the exclusive
+ * PIO owner. A zero WRPLR length returns -EAGAIN without consumption. Output
+ * bytes are unchanged unless the full packet and post-read WRPLR succeed.
+ * A partial bus read or malformed packet poisons this firmware session.
+ * The caller owns event/data decoding and never treats this as radio approval.
+ */
+int mt6797_hif_receive_packet(struct mt6797_hif *hif, unsigned int port,
+			      u64 deadline_ns, u8 *buffer, size_t capacity,
+			      struct mt6797_hif_rx_result *result);
+
+/* MAC runtime comparison: same receive contract, but no success post-WRPLR
+ * observation. post_valid stays false; boot readers retain receive_packet().
+ */
+int mt6797_hif_receive_runtime_packet(struct mt6797_hif *hif, unsigned int port,
+				      u64 deadline_ns, u8 *buffer, size_t capacity,
+				      struct mt6797_hif_rx_result *result);
+
+/* Post-CLOSED comparison only: one pre-WRPLR, port0 if nonempty else port1.
+ * No success post-read, cache, extra I/O or change to equality/poison/copy.
+ * Both empty: -EAGAIN and selected_port_valid=false. Port0 priority is not
+ * operational fairness. Legacy callers above retain requested-port behavior.
+ */
+int mt6797_hif_receive_selected(struct mt6797_hif *hif,
+				u64 deadline_ns, u8 *buffer,
+				size_t capacity,
+				struct mt6797_hif_rx_result *result);
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/join.c b/drivers/net/wireless/mediatek/mt6797/join.c
new file mode 100644
index 000000000..acfed6185
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/join.c
@@ -0,0 +1,3246 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6797 WLAN station lifetime: join, association, data phase
+ * pump, teardown and re-arm.
+ */
+
+#include "mac-priv.h"
+
+static int mt6797_mac_join_retire_idle_bss(struct mt6797_mac *mac);
+
+static inline enum mt6797_join_rearm_decision
+mt6797_join_rearm_ready(const struct mt6797_join_rearm_state *s)
+{
+	if (!s->cleanup_done || !s->sta_removed || s->poisoned)
+		return MT6797_JOIN_REARM_NO;
+	if (s->key_pairwise != 2 || s->key_group != 2 ||
+	    !s->key_done || !s->key_done_second ||
+	    s->inflight || s->page_debt || s->data_page_debt || s->credit_pending ||
+	    !s->queue_empty)
+		return MT6797_JOIN_REARM_NO;
+	/* The data PID is cyclic and the pool restarts with the epoch, so it
+	 * is not a boot-scoped identity: the fifth lifecycle boot stopped its
+	 * data phase at PID 82 and was refused here as a wrap. The channel
+	 * token and the station sequence are not either: every join assigns
+	 * them afresh (token 1, the next command sequence).
+	 */
+	/* A lifetime uses 22 commands (boot AV); recycle while two still fit. */
+	if (s->sequence > 200 && s->sequence_base && s->sequence_base <= 128)
+		return MT6797_JOIN_REARM_RECYCLE;
+	if (s->sequence > 248)
+		return MT6797_JOIN_REARM_WRAP;
+	return MT6797_JOIN_REARM_YES;
+}
+
+/* Scheduling only. Count consecutive no-progress iterations, not submitted
+ * frames or retired completions. Idle alone gets the long interval.
+ */
+static inline unsigned int
+mt6797_join_pump_delay(unsigned int *zero_runs, bool pending, bool progress)
+{
+	if (!pending) {
+		*zero_runs = 0;
+		return MT6797_JOIN_PUMP_IDLE_MS;
+	}
+	if (progress) {
+		*zero_runs = 0;
+		return 0;
+	}
+	if (*zero_runs < MT6797_JOIN_PUMP_MAX_ZERO) {
+		(*zero_runs)++;
+		return 0;
+	}
+	*zero_runs = 0;
+	return MT6797_JOIN_PUMP_PENDING_MS;
+}
+
+/* native_rx holds checked PTK+GTK for this caller, never native ciphertext.
+ * Under the connected lifetime the ceilings are counts, never a stop: the
+ * data phase ends by its own deadline, the host's disconnect or association
+ * loss, and a measurement that crosses a count keeps its window and its
+ * delivery (the count saturates and the frames beyond are counted apart).
+ */
+static inline enum mt6797_native_diag_step
+mt6797_ccmp_diag_budget_step(const struct mt6797_native_diag_budget *b)
+{
+	if (!b)
+		return MT6797_NATIVE_DIAG_STOP;
+	return MT6797_NATIVE_DIAG_CONTINUE;
+}
+
+/* Pure next-state + action. *state is updated in place. */
+static inline enum mt6797_native_diag_action
+mt6797_native_diag_transition(struct mt6797_native_diag_ctx *c)
+{
+	if (!c)
+		return MT6797_ND_ACT_NONE;
+	switch (c->state) {
+	case MT6797_ND_IDLE:
+		if (c->poisoned)
+			return MT6797_ND_ACT_NONE;
+		if (c->armed && c->data_phase && c->quiescent && c->seq_ok) {
+			c->state = MT6797_ND_ENABLE_PENDING;
+			return MT6797_ND_ACT_SUBMIT_ENABLE;
+		}
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_ENABLE_PENDING:
+		if (c->poisoned) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_NONE;
+		}
+		if (c->deadline_passed) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_LATCH_NORADIO;
+		}
+		if (c->quiescent)		/* enable retired */
+			c->state = MT6797_ND_ACTIVE;
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_ACTIVE:
+		if (c->poisoned) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_NONE;
+		}
+		/* The window ends on a ceiling OR when the data phase ends (its lower
+		 * deadline may expire before the 10 s wall, or the association is lost);
+		 * disable only once the ledger is quiescent so an owed completion is
+		 * retired first -- never disable with a frame still in flight.
+		 */
+		if (c->budget_stop || !c->data_phase) {
+			if (!c->quiescent)
+				return MT6797_ND_ACT_NONE;	/* wait for retirement */
+			if (!c->seq_ok) {
+				c->state = MT6797_ND_CLOSED;
+				return MT6797_ND_ACT_LATCH_NORADIO;
+			}
+			c->state = MT6797_ND_DISABLE_PENDING;
+			return MT6797_ND_ACT_SUBMIT_DISABLE;
+		}
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_DISABLE_PENDING:
+		if (c->poisoned) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_NONE;
+		}
+		if (c->deadline_passed) {
+			c->state = MT6797_ND_CLOSED;
+			return MT6797_ND_ACT_LATCH_NORADIO;
+		}
+		if (c->quiescent)		/* disable retired */
+			c->state = MT6797_ND_CLOSED;
+		return MT6797_ND_ACT_NONE;
+	case MT6797_ND_CLOSED:
+	default:
+		return MT6797_ND_ACT_NONE;
+	}
+}
+
+/* The inherited healthy cleanup may submit only when the diagnostic owns no
+ * un-retired radio command: never armed, or fully closed.
+ */
+static inline int mt6797_native_diag_cleanup_allowed(enum mt6797_native_diag_state s)
+{
+	return s == MT6797_ND_IDLE || s == MT6797_ND_CLOSED;
+}
+
+static bool rate_control;
+
+module_param(rate_control, bool, 0644);
+
+MODULE_PARM_DESC(rate_control,
+		 "Send data at mac80211's rate control (minstrel_ht) choice instead of the fixed HT MCS5 rate; read at each association");
+
+/* An entry holding neither a frame nor a placeholder's pages. */
+static inline bool mt6797_data_entry_free(const struct mt6797_data_slots *s)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (!s->owner[i].frame && !s->owner[i].pages)
+			return true;
+	return false;
+}
+
+bool
+mt6797_data_room(const struct mt6797_data_slots *s, unsigned int pages,
+		 unsigned int free_pages)
+{
+	return s->count < MT6797_DATA_DEPTH && mt6797_data_entry_free(s) &&
+	       pages && pages <= free_pages;
+}
+
+static inline struct mt6797_data_owner *
+mt6797_data_find(struct mt6797_data_slots *s, unsigned char pid)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame && s->owner[i].pid == pid)
+			return &s->owner[i];
+	return NULL;
+}
+
+static inline bool
+mt6797_data_put(struct mt6797_data_slots *s, unsigned char pid, void *frame,
+		unsigned long long deadline)
+{
+	unsigned int i;
+
+	if (!frame || !pid || pid >= 127 || s->count >= MT6797_DATA_DEPTH ||
+	    mt6797_data_find(s, pid))
+		return false;
+	for (i = 0; i < MT6797_DATA_DEPTH; i++) {
+		if (!s->owner[i].frame && !s->owner[i].pages) {
+			s->owner[i] = (struct mt6797_data_owner){ .frame = frame,
+								  .deadline = deadline,
+								  .pid = pid };
+			s->count++;
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Put a frame that will be retired on credit arrival, with its pages. */
+static inline bool
+mt6797_data_put_credit(struct mt6797_data_slots *s, unsigned char pid, void *frame,
+		       unsigned long long deadline, unsigned int pages,
+		       unsigned int ordinal, unsigned long long submitted)
+{
+	struct mt6797_data_owner *o;
+
+	if (!pages || !mt6797_data_put(s, pid, frame, deadline))
+		return false;
+	o = mt6797_data_find(s, pid);
+	o->pages = pages;
+	o->ordinal = ordinal;
+	o->submitted = submitted;
+	return true;
+}
+
+static inline void *mt6797_data_take(struct mt6797_data_slots *s, unsigned char pid)
+{
+	struct mt6797_data_owner *o = mt6797_data_find(s, pid);
+	void *frame;
+
+	if (!o)
+		return NULL;
+	frame = o->frame;
+	if (o->reported && !o->covered) {
+		/* Its report came first: keep its place in the credit order. */
+		o->frame = NULL;
+		o->pid = 0;
+	} else {
+		*o = (struct mt6797_data_owner){0};
+	}
+	s->count--;
+	return frame;
+}
+
+static inline void *mt6797_data_pop(struct mt6797_data_slots *s)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame)
+			return mt6797_data_take(s, s->owner[i].pid);
+	return NULL;
+}
+
+/* Retire one slot whose deadline has passed, returning its frame and PID. */
+static inline void *
+mt6797_data_take_expired(struct mt6797_data_slots *s, unsigned long long now,
+			 unsigned char *pid)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame && now >= s->owner[i].deadline) {
+			*pid = s->owner[i].pid;
+			return mt6797_data_take(s, *pid);
+		}
+	return NULL;
+}
+
+/* Cover the oldest credit-ordered entry (lowest ordinal) if the credits reach
+ * its pages: a plain frame is taken for retirement; a sampled frame is marked
+ * covered and kept for its report; a placeholder is cleared. The copy holds
+ * the entry as it was.
+ */
+static inline enum mt6797_data_cover
+mt6797_data_cover_oldest(struct mt6797_data_slots *s, unsigned int credit_pages,
+			 struct mt6797_data_owner *copy, void **frame)
+{
+	struct mt6797_data_owner *oldest = NULL;
+	unsigned int i;
+
+	*frame = NULL;
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].pages &&
+		    !(s->owner[i].reported && s->owner[i].covered) &&
+		    (!oldest || s->owner[i].ordinal < oldest->ordinal))
+			oldest = &s->owner[i];
+	if (!oldest || oldest->pages > credit_pages)
+		return MT6797_DATA_COVER_NONE;
+	*copy = *oldest;
+	if (!oldest->frame) {
+		*oldest = (struct mt6797_data_owner){0};
+		return MT6797_DATA_COVER_HELD;
+	}
+	if (oldest->reported) {
+		oldest->covered = true;
+		return MT6797_DATA_COVER_HELD;
+	}
+	*frame = mt6797_data_take(s, copy->pid);
+	return MT6797_DATA_COVER_RETIRE;
+}
+
+static inline bool
+mt6797_data_credit_outstanding(const struct mt6797_data_slots *s)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].pages &&
+		    !(s->owner[i].reported && s->owner[i].covered))
+			return true;
+	return false;
+}
+
+/* Mark a credit-ordered frame as sampled: it carries a status report. */
+static inline bool
+mt6797_data_mark_reported(struct mt6797_data_slots *s, unsigned char pid)
+{
+	struct mt6797_data_owner *o = mt6797_data_find(s, pid);
+
+	if (!o || !o->pages)
+		return false;
+	o->reported = true;
+	return true;
+}
+
+static inline bool
+mt6797_data_expired(const struct mt6797_data_slots *s, unsigned long long now)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame && now >= s->owner[i].deadline)
+			return true;
+	return false;
+}
+
+/* Exactly the advertised HT capability element body (26 bytes). */
+static bool mt6797_join_ht_cap_ok(const u8 *b, u16 cap)
+{
+	unsigned int i;
+
+	if ((get_unaligned_le16(b) & ~IEEE80211_HT_CAP_SM_PS) !=
+	    (cap & ~IEEE80211_HT_CAP_SM_PS) ||
+	    b[2] != MT6797_HT_AMPDU_PARAMS || b[3] != 0xff ||
+	    b[15] != IEEE80211_HT_MCS_TX_DEFINED)
+		return false;
+	for (i = 4; i < 26; i++)
+		if (i != 15 && b[i])
+			return false;
+	return true;
+}
+
+/* The access point accepts HT when its response carries an HT operation
+ * element (0293).
+ */
+static void mt6797_join_assoc_ht(struct mt6797_mac *mac, const u8 *f, size_t n)
+{
+	size_t e = 30;
+
+	while (mac->join_ht_requested && e + 2 <= n && f[e + 1] <= n - e - 2) {
+		if (f[e] == WLAN_EID_HT_OPERATION && f[e + 1] == 22) {
+			mac->join_ht_accepted = true;
+			memcpy(mac->join_ht_op, f + e + 2, 22);
+			mac->join_ht_op_seen = true;
+		}
+		if (f[e] == WLAN_EID_HT_CAPABILITY && f[e + 1] == 26) {
+			memcpy(mac->join_ht_peer_cap, f + e + 2, 26);
+			mac->join_ht_peer_cap_seen = true;
+		}
+		e += 2 + f[e + 1];
+	}
+}
+
+/* The access point's association response: WMM is accepted when we asked
+ * for it and the response carries the WMM parameter element (OUI 00:50:f2,
+ * type 2, subtype 1, version 1, 24 bytes).
+ */
+static void mt6797_join_assoc_wmm(struct mt6797_mac *mac, const u8 *f, size_t n)
+{
+	size_t e = 30;
+
+	while (mac->join_wmm_requested && e + 2 <= n && f[e + 1] <= n - e - 2) {
+		if (f[e] == WLAN_EID_VENDOR_SPECIFIC && f[e + 1] == 24 && !f[e + 2] &&
+		    f[e + 3] == 0x50 && f[e + 4] == 0xf2 && f[e + 5] == 2 &&
+		    f[e + 6] == 1 && f[e + 7] == 1)
+			mac->join_wmm_accepted = true;
+		e += 2 + f[e + 1];
+	}
+}
+
+/* The one RSN element body this admission accepts in an association request:
+ * RSN version 1, group cipher CCMP, one pairwise cipher CCMP, one AKM PSK,
+ * RSN capabilities 0 or 0x000c. The first 18 bytes are the element the
+ * reviewed connect helper sends. The capabilities admit exactly two values:
+ * 0 (the helper) and the 16-PTKSA-replay-counter declaration, bits 2 and 3,
+ * that the pinned supplicant makes whenever the AP's BSS carries the WMM
+ * vendor element (wpa_supplicant_set_suites, rsn_supp_capab), independent of
+ * any WMM negotiation; this admission still refuses the WMM element itself.
+ * No MFP, OCV, extended key id, pre-authentication or no-pairwise bit, any
+ * other body, or a second element, is refused like any other shape.
+ */
+static const u8 mt6797_join_rsn_body[18] = {
+	0x01, 0x00,
+	0x00, 0x0f, 0xac, 0x04,
+	0x01, 0x00, 0x00, 0x0f, 0xac, 0x04,
+	0x01, 0x00, 0x00, 0x0f, 0xac, 0x02,
+};
+
+static bool mt6797_join_rsn_capabilities(const u8 *capabilities)
+{
+	unsigned int value = mt6797_join_le16(capabilities);
+
+	return value == 0 || value == 0x000c;
+}
+
+/* Called with join_queue.lock held. */
+bool mt6797_join_attempt_open(const struct mt6797_mac *mac,
+			      unsigned int subtype)
+{
+	if (subtype == 11)
+		return mac->join_auth_attempts < MT6797_JOIN_ATTEMPTS;
+	if (subtype == 0)
+		return mac->join_assoc_attempts < MT6797_JOIN_ATTEMPTS;
+	return !(mac->join_seen & BIT(subtype));
+}
+
+/* Called with join_queue.lock held, for the frame being queued. */
+void mt6797_join_attempt_note(struct mt6797_mac *mac, unsigned int subtype)
+{
+	mac->join_seen |= BIT(subtype);
+	mac->join_auth_attempts += subtype == 11;
+	mac->join_assoc_attempts += subtype == 0;
+}
+
+static bool mt6797_mac_join_frame(struct mt6797_mac *mac, struct sk_buff *skb)
+{
+	const u8 *f = skb->data;
+	size_t n = skb->len, ie;
+	unsigned int fc, subtype, minimum;
+	unsigned int ssid_count = 0, rsn_count = 0;
+
+	if (n < 24 || n > 2304)
+		return false;
+	fc = mt6797_join_le16(f);
+	subtype = (fc >> 4) & 15;
+	if ((fc & 0xff0f) || (f[22] & 15) ||
+	    !(mac->join_tx_allowed & BIT(subtype)) ||
+					!ether_addr_equal(f + 4, mac->join_ap) ||
+					!ether_addr_equal(f + 10, mac->hw->wiphy->perm_addr) ||
+					!ether_addr_equal(f + 16, mac->join_ap))
+		return false;
+	minimum = subtype == 11 ? 30 : subtype == 0 ? 28 : subtype == 12 ? 26 : 0;
+	if (!minimum || n < minimum)
+		return false;
+	/* A retried association request is validated afresh (0304). */
+	if (subtype == 0) {
+		mac->join_wmm_requested = false;
+		mac->join_ht_requested = false;
+	}
+	if (subtype == 11)
+		return n == 30 && !mt6797_join_le16(f + 24) &&
+	 mt6797_join_le16(f + 26) == 1 && !mt6797_join_le16(f + 28);
+	if (subtype == 12)
+		return n == 26;
+	if (!mt6797_join_le16(f + 26))
+		return false;
+	for (ie = 28; ie < n; ) {
+		if (n - ie < 2 || f[ie + 1] > n - ie - 2)
+			return false;
+		if (f[ie] == WLAN_EID_SSID) {
+			if (++ssid_count != 1 || !f[ie + 1] || f[ie + 1] > 32)
+				return false;
+			mac->join_ssid_bytes = f[ie + 1];
+			memcpy(mac->join_ssid, f + ie + 2, mac->join_ssid_bytes);
+		}
+		/* Exactly one RSN element with the fixed WPA2-PSK CCMP body and
+		 * one of the two admitted capability values.
+		 */
+		if (f[ie] == WLAN_EID_RSN) {
+			if (++rsn_count != 1 ||
+			    f[ie + 1] != sizeof(mt6797_join_rsn_body) + 2 ||
+			    memcmp(f + ie + 2, mt6797_join_rsn_body,
+				   sizeof(mt6797_join_rsn_body)) ||
+			    !mt6797_join_rsn_capabilities(f + ie + 2 +
+							  sizeof(mt6797_join_rsn_body))) {
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN join frame element refused: subtype=%u id=0x%02x len=%u count=%u\n",
+					 subtype, f[ie], f[ie + 1], rsn_count);
+				return false;
+			}
+			mac->join_rsn = true;
+			ie += 2 + f[ie + 1];
+			continue;
+		}
+		/* One WMM information element (OUI 00:50:f2, type 2, subtype 0,
+		 * version 1) with QoS info 0: no U-APSD.
+		 */
+		if (subtype == 0 && f[ie] == WLAN_EID_VENDOR_SPECIFIC &&
+		    f[ie + 1] == 7 && f[ie + 2] == 0 && f[ie + 3] == 0x50 &&
+		    f[ie + 4] == 0xf2 && f[ie + 5] == 2 && f[ie + 6] == 0 &&
+		    f[ie + 7] == 1 && !f[ie + 8] && !mac->join_wmm_requested) {
+			mac->join_wmm_requested = true;
+			ie += 2 + f[ie + 1];
+			continue;
+		}
+		/* One HT capability element, exactly the advertised one. */
+		if (subtype == 0 && f[ie] == WLAN_EID_HT_CAPABILITY &&
+		    f[ie + 1] == 26 &&
+		    mt6797_join_ht_cap_ok(f + ie + 2, mac->band_5g.ht_cap.cap) &&
+		    !mac->join_ht_requested) {
+			mac->join_ht_requested = true;
+			ie += 2 + f[ie + 1];
+			continue;
+		}
+		/* No other HT, no VHT, fast-transition or WMM negotiation here. */
+		if (f[ie] == WLAN_EID_HT_CAPABILITY ||
+		    f[ie] == WLAN_EID_VHT_CAPABILITY ||
+		    f[ie] == WLAN_EID_MOBILITY_DOMAIN ||
+		    f[ie] == WLAN_EID_FAST_BSS_TRANSITION ||
+		    (f[ie] == WLAN_EID_VENDOR_SPECIFIC && f[ie + 1] >= 4 &&
+		     f[ie + 2] == 0 && f[ie + 3] == 0x50 && f[ie + 4] == 0xf2 &&
+		     f[ie + 5] == 2)) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join frame element refused: subtype=%u id=0x%02x len=%u count=%u\n",
+				 subtype, f[ie], f[ie + 1], rsn_count);
+			return false;
+		}
+		ie += 2 + f[ie + 1];
+	}
+	if (ssid_count != 1)
+		return false;
+	return true;
+}
+
+/* Re-arm the driver to its pre-scan baseline for a second lifetime, called
+ * only from the serialized join_work after BOTH the healthy stage-3 cleanup
+ * and the mac80211 station teardown (NOTEXIST) have been observed, with the
+ * queue empty, no debt, no in-flight frame and the lifetime not poisoned.
+ * first_error/closing are left untouched (they must be clear to reach here).
+ * Wire identities advance and a u8 wrap refuses the re-arm rather than reuse
+ * a value; key/absence events do not gain identities. Returns -EOWNERDEAD to
+ * ask the caller to poison on wrap, 0 on a completed re-arm.
+ */
+/* Per-lifetime epoch state back to its probe-time values, so a re-armed
+ * lifetime starts as the first one did: no key cookies, no receive contexts,
+ * no PM or cleanup residue, a fresh PID pool and empty in-flight slots. The
+ * boot-scoped identities (command sequence, channel token, station sequence)
+ * are left to the caller, which advances them.
+ */
+static void mt6797_mac_epoch_reset(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+
+	mac->native_diag_state = MT6797_ND_IDLE;
+	mac->native_diag_engaged = false;
+	mac->native_diag_sample_done = false;
+	mac->native_diag_total = 0;
+	mac->native_diag_native = 0;
+	mac->native_diag_bytes = 0;
+	mac->native_diag_retire_reads = 0;
+	mac->native_diag_retire_bytes = 0;
+	mac->native_diag_started = 0;
+	mac->native_diag_retire_started = 0;
+	memset(&mac->ccmp_rx, 0, sizeof(mac->ccmp_rx));
+	memset(&mac->ccmp_gtk_rx, 0, sizeof(mac->ccmp_gtk_rx));
+	mac->ccmp_gtk_attempted = false;
+	mac->ccmp_last_checked_rx = 0;
+	mac->ccmp_timeout_ignored = 0;
+	reinit_completion(&mac->ccmp_dtim_done);
+	mac->ccmp_dtim_period = 0;
+	mac->ccmp_dtim_status = 0;
+	mac->ccmp_dtim_valid = false;
+	mac->ccmp_pm_attempted = false;
+	mac->ccmp_pm_connected = false;
+	mac->ccmp_pm_abort_pending = false;
+	mac->ccmp_pm_abort_credited = false;
+	mac->ccmp_loss_reported = false;
+	mac->ccmp_deauth_timeouts = 0;
+	mac->ccmp_deauth_late = 0;
+	mac->ccmp_deauth_retired_pid = 0;
+	mac->ccmp_cleanup_retained_pages = 0;
+	mac->ccmp_cleanup_credit_floor = 0;
+	mac->ccmp_cleanup_op = 0;
+	mac->ccmp_cleanup_sequence = 0;
+	mac->ccmp_cleanup_credit_active = false;
+	mac->ccmp_cleanup_bounded_done = false;
+	mac->ccmp_pm_credit_ns = 0;
+	mac->ccmp_channel_release_at = 0;
+	mac->ccmp_channel_release_sequence = 0;
+	mac->ccmp_channel_release_pending = false;
+	RCU_INIT_POINTER(mac->ccmp_sta, NULL);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->ccmp_tx_ready = false;
+	mac->ccmp_ptk = NULL;
+	mac->ccmp_gtk = NULL;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	reinit_completion(&mac->ccmp_key_done);
+	reinit_completion(&mac->ccmp_cleanup_done);
+	mac->ccmp_decap = false;
+	mac->ccmp_closed = false;
+	mac->ccmp_ptk_attempted = false;
+	mac->ccmp_queued = 0;
+	memset(&mac->ccmp_pid_pool, 0, sizeof(mac->ccmp_pid_pool));
+	mac->ccmp_pid_pool.next = 1;
+	mac->ccmp_reserved_pid_used = false;
+	memset(&mac->data_slots, 0, sizeof(mac->data_slots));
+	mac->ccmp_key_disables = 0;
+}
+
+static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+
+	/* The caller (join_work) re-arms only on MT6797_JOIN_REARM_YES from
+	 * mt6797_join_rearm_ready(), which has already proved the rendezvous,
+	 * the quiescent gate and the command sequence headroom.
+	 */
+	mac->join_channel_token++;
+	mac->join_teardown_framing_drops = 0;
+	mac->join_sta_sequence++;
+	/* Scan cycle re-opened; the radio (scan_ready), vif, configured and
+	 * started state and the monotonic mac->sequence are left as they are.
+	 */
+	mac->scan_used = false;
+	mac->scan_active = false;
+	mac->bss_active = false;
+	mac->scan_count = 0;
+	mac->scan_channels = 0;
+	mac->scan_polls = 0;
+	mac->scan_packets = 0;
+	mac->scan_beacon = false;
+	mac->scan_credit = false;
+	mac->scan_frame_seen = false;
+	mac->join_scan_ready = false;
+	mac->join_peer_used = false;
+	mac->join_peer_ready = false;
+	mac->join_auth_received = false;
+	mac->join_auth_ok = false;
+	mac->join_authenticated = false;
+	mac->join_assoc_received = false;
+	mac->join_assoc_status = 0;
+	mac->join_aid = 0;
+	mac->join_bss_valid = false;
+	mac->join_channel_valid = false;
+	mac->join_sco = 0;
+	mac->join_bss_configured = false;
+	mac->join_short_preamble = false;
+	mac->join_channel_pending = false;
+	mac->join_channel_granted = false;
+	mac->join_channel_released = false;
+	mac->join_sta_pending = false;
+	mac->join_sta_active = false;
+	mac->join_peer_refusal_logged = false;
+	mac->join_channel_refusal_logged = false;
+	mac->join_data_phase = false;
+	mac->join_data_ended = false;
+	mac->join_cleanup_requested = false;
+	mac->join_cleanup_done = false;
+	mac->join_deauth_done = false;
+	mac->join_deauth_timed_out = false;
+	mac->join_deauth_status_valid = false;
+	mac->join_deauth_status = 0;
+	mac->join_cleanup_stage = 0;
+	mac->join_rsn = false;
+	mac->join_key_pairwise = 0;
+	mac->join_key_group = 0;
+	mac->join_key_pairwise_submitted = false;
+	mac->join_key_group_submitted = false;
+	mac->join_key_done = false;
+	mac->join_key_done_second = false;
+	mac->join_group_key_id = 0;
+	mac->join_eapol_seen = 0;
+	mac->join_eapol_trace = 0;
+	mac->join_eapol_refused = 0;
+	mac->ccmp_rx_refused = 0;
+	mac->join_eapol_tx = 0;
+	mac->join_data_llc_discarded = 0;
+	mac->join_absence_events = 0;
+	mac->join_absence_outside = 0;
+	mac->join_absence_unexpected = 0;
+	mac->ccmp_rx_delivered = 0;
+	mac->join_data_credits = 0;
+	mac->join_data_page_debt = 0;
+	mac->join_data_tx_queued = 0;
+	mac->join_data_tx_done = 0;
+	mac->join_data_tx_failed = 0;
+	mac->join_data_tx_failures_in_row = 0;
+	mac->join_data_expired = 0;
+	mac->credit_retire_pages = 0;
+	mac->credit_retire_ordinal = 0;
+	mac->tx_sample_counter = 0;
+	mac->tx_queue_stops = 0;
+	mac->tx_queue_wakes = 0;
+	mac->tx_dropped_full = 0;
+	mac->tx_queue_high_water = 0;
+	mac->join_wmm_requested = false;
+	mac->join_wmm_accepted = false;
+	mac->join_ht_requested = false;
+	mac->join_ht_accepted = false;
+	mac->join_ht_peer_cap_seen = false;
+	mac->join_ht_op_seen = false;
+	mac->qos_ac_params = 0;
+	mac->qos_tx = 0;
+	mac->qos_tx_nonqos = 0;
+	mac->qos_tx_tid_refused = 0;
+	memset(mac->qos_tx_tid, 0, sizeof(mac->qos_tx_tid));
+	mac->qos_rx = 0;
+	mac->qos_rx_nonqos = 0;
+	mac->qos_rx_refused = 0;
+	mac->qos_rx_refused_qos = 0;
+	mac->join_inflight_data = false;
+	mac->join_last_acked = false;
+	mac->join_credit_pending = false;
+	mac->join_channel_pending = false;
+	mac->join_sta_pending = false;
+	mac->join_page_debt = 0;
+	mac->join_seen = 0;
+	mac->join_auth_attempts = 0;
+	mac->join_assoc_attempts = 0;
+	mac->rx_ba_active = 0;
+	mt6797_rx_reorder_drop(mac);
+	/* The block-ack and reorder counts are per lifetime, as the rest of
+	 * the data phase's records are; they start again after the teardown
+	 * drop, which no lifetime's record counts.
+	 */
+	mac->rx_ba_starts = 0;
+	mac->rx_ba_stops = 0;
+	{
+		unsigned int tid;
+
+		for (tid = 0; tid < MT6797_RX_REORDER_TIDS; tid++)
+			mac->rx_reorder[tid].holes = 0;
+	}
+	mac->join_tx_allowed = 0;
+	mac->join_rx_allowed = 0;
+	mac->join_deadline = 0;
+	mac->join_frame_deadline = 0;
+	mac->join_grant_deadline = 0;
+	mac->join_credit_deadline = 0;
+	mac->join_data_deadline = 0;
+	mac->join_data_started = 0;
+	mac->join_hold_until = 0;
+	mac->join_pid = 0;
+	mac->join_submitted = 0;
+	mac->join_sta_removed = false;
+	mac->join_rearm_pending = false;
+	mt6797_mac_epoch_reset(mac);
+	/* join_next_pid stays monotonic; the PID pool restarts with the epoch. */
+	reinit_completion(&mac->join_channel_done);
+	reinit_completion(&mac->join_sta_done);
+	reinit_completion(&mac->join_credit_done);
+	reinit_completion(&mac->join_frame_done);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	mac->join_queue_bytes = 0;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mac->join_retired = false;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join rearm: lifetime=%u token=%u sta_seq=%u sequence=%u\n",
+		 mac->join_lifetimes, mac->join_channel_token, mac->join_sta_sequence,
+		 mac->sequence);
+}
