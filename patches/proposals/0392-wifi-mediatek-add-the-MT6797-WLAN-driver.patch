+EXPORT_SYMBOL_GPL(mt6797_hif_send_security);
+
+int mt6797_hif_send_data_report(struct mt6797_hif *hif, const u8 *frame,
+				size_t frame_bytes, u8 wlan, u8 pid,
+				bool status_report,
+				unsigned int lifetime_ms, unsigned int attempt_count,
+				const struct mt6797_tx_rate *rate, u64 deadline_ns)
+{
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	int error;
+
+	if (!hif || !frame)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || !hif->capability_complete ||
+	    hif->transaction->phase != MT6797_INIT_IDLE ||
+	    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
+		error = -EIO;
+		goto unlock;
+	}
+	error = mt6797_join_prepare_data_report(&hif->normal, frame, frame_bytes,
+						wlan, pid, status_report,
+						lifetime_ms, attempt_count,
+						hif->scratch, sizeof(hif->scratch),
+						&command);
+	if (error)
+		goto unlock;
+	/* DW6 byte 25: the fixed rate's bandwidth, FIX_BW_40 (0324). */
+	if (hif->data_bw40)
+		hif->scratch[25] = 5;
+	/* mac80211's rate control choice for this frame, over all of those. */
+	if (rate)
+		mt6797_tx_rate_descriptor(rate, hif->scratch);
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto fail;
+	error = mt6797_hif_data_transfer(hif, 0x34, MT6797_HIF_WRITE,
+					 hif->scratch,
+					 MT6797_JOIN_TX_DESC_BYTES + frame_bytes,
+					 sizeof(hif->scratch), &transfer);
+	error = mt6797_normal_submitted(&hif->normal, error);
+	if (!error)
+		error = mt6797_hif_guard(hif);
+fail:
+	if (error)
+		error = mt6797_hif_fail(hif, error);
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_send_data_report);
+
+void mt6797_hif_set_data_bw40(struct mt6797_hif *hif, bool bw40)
+{
+	if (!hif)
+		return;
+	mutex_lock(&hif->mutex);
+	hif->data_bw40 = bw40;
+	mutex_unlock(&hif->mutex);
+}
