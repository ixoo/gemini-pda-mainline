+
+int mt6797_hif_send_config(struct mt6797_hif *hif,
+			   enum mt6797_normal_config_kind kind,
+			   unsigned int sequence, const u8 *payload,
+			   size_t payload_bytes, u64 deadline_ns)
+{
+	struct mt6797_hif_pio_result transfer;
+	struct mt6797_hif_command command;
+	int error;
+
+	if (!hif || !payload || sequence > 255)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || !hif->capability_complete ||
+	    hif->transaction->phase != MT6797_INIT_IDLE ||
+	    (hif->normal.phase != MT6797_NORMAL_CAP_RECEIVED &&
+	     hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED)) {
+		error = -EIO;
+		goto unlock;
+	}
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto out;
+	error = mt6797_normal_prepare_config(&hif->normal, kind, sequence,
+					     payload, payload_bytes,
+					     hif->scratch, sizeof(hif->scratch),
+					     &command);
+	if (error)
+		goto out;
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch, 8 + payload_bytes,
+					sizeof(hif->scratch), &transfer);
+	error = mt6797_normal_submitted(&hif->normal, error);
+	if (!error)
+		error = mt6797_hif_guard(hif);
+out:
+	if (error)
+		error = mt6797_hif_fail(hif, error);
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_send_config);
+
+/* The selected gen3 host also permits the data ports through PIO. Keep the
+ * full packet private to the caller; a parsed header alone is insufficient
+ * for later event or mac80211 delivery.
+ */
+static int mt6797_hif_receive(struct mt6797_hif *hif, unsigned int port,
+			      u64 deadline_ns, u8 *buffer, size_t capacity,
+			      struct mt6797_hif_rx_result *result, bool post_read,
+			      bool select_port)
+{
+	int error;
+
+	if (!result)
+		return -EINVAL;
+	*result = (struct mt6797_hif_rx_result){0};
+	if (!hif || !buffer || port > 1)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready || !hif->capability_complete ||
+	    hif->transaction->phase != MT6797_INIT_IDLE ||
+	    (hif->normal.phase != MT6797_NORMAL_CAP_RECEIVED &&
+	     hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED)) {
+		error = -EIO;
+		goto unlock;
+	}
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto poison;
+	if (!hif->rx_batch_enabled) {
+		error = mt6797_hif_rx_batch_enable(hif);
+		if (error)
+			goto poison;
+	}
+	if (hif->rx_batch_next >= hif->rx_batch_count && hif->rx_batch_refill) {
+		hif->rx_batch_refill = false;
+		/* A bus failure, the only error the fill returns. */
+		error = mt6797_hif_rx_batch_fill(hif);
+		if (error) {
+			hif->rx_batch_failures++;
+			goto poison;
+		}
+	}
+	if (hif->rx_batch_next >= hif->rx_batch_count) {
+		error = -EAGAIN;
+		goto unlock;
+	}
+	/* Frames are served in the order the block reported them, each
+	 * tagged with its own queue; the caller's port is advisory.
+	 */
+	{
+		unsigned int f = hif->rx_batch_next;
+
+		if (capacity < hif->rx_batch_frame[f].length) {
+			error = -ENOSPC;
+			goto unlock;
+		}
+		hif->rx_batch_next++;
+		memcpy(buffer, hif->rx_batch_agg + hif->rx_batch_frame[f].offset,
+		       hif->rx_batch_frame[f].length);
+		result->logical_bytes = hif->rx_batch_frame[f].length;
+		result->packet_type = mt6797_normal_le16(buffer + 2);
+		result->selected_port = hif->rx_batch_frame[f].port;
+		result->selected_port_valid = true;
+		result->rx_setup = true;
+		result->rx_complete = true;
+		result->staging_bytes = ALIGN(result->logical_bytes + 4U, 4);
+		goto unlock;
+	}
+poison:
+	error = mt6797_hif_fail(hif, error);
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+
+int mt6797_hif_receive_packet(struct mt6797_hif *hif, unsigned int port,
+			      u64 deadline_ns, u8 *buffer, size_t capacity,
+			      struct mt6797_hif_rx_result *result)
+{
+	return mt6797_hif_receive(hif, port, deadline_ns, buffer, capacity,
+				  result, true, false);
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_receive_packet);
+
+int mt6797_hif_receive_runtime_packet(struct mt6797_hif *hif, unsigned int port,
+				      u64 deadline_ns, u8 *buffer, size_t capacity,
+				      struct mt6797_hif_rx_result *result)
+{
+	return mt6797_hif_receive(hif, port, deadline_ns, buffer, capacity,
+				  result, false, false);
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_receive_runtime_packet);
+
+int mt6797_hif_receive_selected(struct mt6797_hif *hif,
+				u64 deadline_ns, u8 *buffer,
+				size_t capacity,
+				struct mt6797_hif_rx_result *result)
+{
+	return mt6797_hif_receive(hif, 0, deadline_ns, buffer, capacity, result,
+				  false, true);
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_receive_selected);
+
