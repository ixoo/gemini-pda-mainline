+/* The group form of the class above in its LLC-mismatch variant (runtime 30,
+ * inside the data phase, 5.4 s after it opened): a 94-byte data RXD with
+ * descriptor bytes 48 28 ce 04 02 40 00 c2 (the broadcast match bit with key
+ * id 1 in bits 6 and 7, channel 40, header translation with the 14-byte
+ * header and the 2-byte offset, payload format 0 with BSSID field 1, the
+ * declared broadcast entry, TID 0, security mode 4 in the descriptor's
+ * cipher field, status 0xc200: the two high bits every admitted packet
+ * carries and the LLC-mismatch flag, every other covered error indicator
+ * clear), status group 4 with frame control 0x6208 (data, FromDS, More Data,
+ * Protected), fragment 0 and the target as transmitter, and a translated
+ * header whose word after the addresses was 0x002e, consistent with an IEEE
+ * 802.3 length field rather than an EtherType. No body was retained: what
+ * the payload carried, whether the frame was decrypted and why the flag was
+ * set are not measured. In the pinned vendor data path a status word with
+ * the LLC-mismatch flag is the error class (RXS_DW2_RX_nERR_BITMAP covers
+ * bit 9) and the frame is dropped without delivery. This decoder names
+ * exactly that variant: the group form's
+ * conditions of mt6797_data_rx (that decoder is unchanged) with the status
+ * word exactly 0xc200, so the caller can discard it as the vendor does,
+ * without delivery or interpretation; the type or length word is carried as
+ * metadata only. The unicast form, any other status and every other shape
+ * are not this class and reach the caller's refusal.
+ */
+static inline bool
+mt6797_data_rx_llc_mismatch(const unsigned char *packet, size_t bytes,
+			    unsigned char channel, const unsigned char ap[6],
+			    unsigned char bmc_index, struct mt6797_data_rx *out)
+{
+	struct mt6797_data_rx r = {0};
+	size_t offset = 16, group4 = 0, vector = 0;
+	unsigned int groups, fc, i, match;
+	const unsigned char *f;
+
+	if (!packet || !ap || !out || bytes < 16 || bytes > 4096 ||
+	    !channel || mt6797_join_le16(packet) != bytes ||
+	    (mt6797_join_le16(packet + 2) >> 13) != 2 ||
+	    packet[5] != channel || (packet[6] & 0x80) == 0 ||
+	    (packet[6] & 63) != 14 || packet[7] != 0x04 ||
+	    (packet[9] >> 4) != 4 || mt6797_join_le16(packet + 10) != 0xc200)
+		return false;
+	match = packet[4];
+	if (((match & 0x3f) != 0x08 && (match & 0x3f) != 0x04) ||
+	    packet[8] != bmc_index)
+		return false;
+	r.group = true;
+	r.key_id = match >> 6;
+	r.tid = packet[9] & 15;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if (groups & 8) {
+		group4 = offset;
+		offset += 16;
+	}
+	if (groups & 1)
+		offset += 16;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4) {
+		vector = offset;
+		offset += 24;
+	}
+	if (packet[6] & 0x40)
+		offset += 2;
+	if (!group4 || offset > bytes || bytes - offset < 14 ||
+	    (vector && packet[vector + 9] > 220))
+		return false;
+	fc = mt6797_join_le16(packet + group4);
+	if ((fc & ~0x2800U) != 0x4208 || (mt6797_join_le16(packet + group4 + 8) & 15))
+		return false;
+	for (i = 0; i < 6; i++)
+		if (packet[group4 + 2 + i] != ap[i])
+			return false;
+	f = packet + offset;
+	if (!(f[0] & 1) || (f[6] & 1))
+		return false;
+	r.ether_type = ((unsigned int)f[12] << 8) | f[13];
+	r.prefix[0] = fc;
+	r.prefix[1] = fc >> 8;
+	r.offset = offset + 14;
+	r.bytes = bytes - r.offset;
+	r.signal_valid = vector != 0;
+	r.signal_dbm = vector ? (int)packet[vector + 9] / 2 - 110 : 0;
+	r.group_vld = (unsigned char)groups;
+	*out = r;
+	return true;
+}
