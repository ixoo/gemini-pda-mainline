+/* Original decoder of one protected, firmware-decrypted, translated data
+ * frame of the public gen3 RXD layout for a legacy non-QoS station, the two
+ * classes the reference run 3 ledger holds and the pinned nic_rx.h defines:
+ *
+ * - a complete data RXD (type 2, declared length equal to the buffer) on the
+ *   join channel, header translation set with a 14-byte Ethernet header,
+ *   MSDU payload format with BSSID field 1 (the value measured after the
+ *   station activation), security mode 4 (the CCMP cipher the keys declared)
+ *   and status word exactly 0xc000: every error, fragment, null and
+ *   non-data flag clear and the two A-MPDU flags set, which in the pinned
+ *   macros (HAL_RX_STATUS_IS_AMPDU_SUB_FRAME / _FORMAT return FALSE when the
+ *   bit is set) means not aggregated. The reference's unicast frames carried
+ *   status 0 (aggregated: the vendor station is HT); this station never
+ *   negotiates HT or block-ack, so an aggregated frame (either bit clear) is
+ *   refused, not reordered. Status 0xc000 unicast is the source-defined
+ *   non-aggregated shape, unobserved on the reference and admitted as such.
+ * - unicast: match flags exactly unicast-to-me (key id bits free), WLAN index
+ *   1 (the station's pairwise entry), destination this station; group: match
+ *   flags exactly the broadcast or the multicast bit, WLAN index the station's
+ *   declared broadcast entry, destination with the group bit. The source is
+ *   never a group address.
+ * - status group 4 present (the vendor reads the frame control and sequence
+ *   of a translated frame from it, rxmDefragMPDU and the reorder path): frame
+ *   control a non-QoS data frame (type data, subtype 0) with FromDS and
+ *   Protected set and ToDS, More Fragments, Power Management and Order clear
+ *   (Retry and More Data free), transmitter the target, fragment number 0.
+ *   QoS data is refused: the association negotiated no WMM.
+ * The output rebuilds the 24-byte 802.11 header (receiver, the target as
+ * transmitter, the source as address 3, the group-4 sequence control) and the
+ * LLC/SNAP header for the Ethernet type, so mac80211 receives the frame it
+ * would have seen without translation; the body is not read. Decryption and
+ * the replay counter are the firmware's: the caller delivers the frame with
+ * the decrypted and stripped flags and claims no replay protection.
+ */
+bool
+mt6797_data_rx(const unsigned char *packet, size_t bytes, unsigned char channel,
+	       const unsigned char own[6], const unsigned char ap[6],
+	       unsigned char bmc_index, struct mt6797_data_rx *out)
+{
+	struct mt6797_data_rx r = {0};
+	size_t offset = 16, group4 = 0, vector = 0;
+	unsigned int groups, fc, i, match;
+	const unsigned char *f;
+
+	if (!packet || !own || !ap || !out || bytes < 16 || bytes > 4096 ||
+	    !channel || mt6797_join_le16(packet) != bytes ||
+	    (mt6797_join_le16(packet + 2) >> 13) != 2 ||
+	    packet[5] != channel || (packet[6] & 0x80) == 0 ||
+	    (packet[6] & 63) != 14 || packet[7] != 0x04 ||
+	    (packet[9] >> 4) != 4 || mt6797_join_le16(packet + 10) != 0xc000)
+		return false;
+	match = packet[4];
+	if ((match & 0x3f) == 0x02) {
+		if (packet[8] != 1)
+			return false;
+		r.group = false;
+	} else if ((match & 0x3f) == 0x08 || (match & 0x3f) == 0x04) {
+		if (packet[8] != bmc_index)
+			return false;
+		r.group = true;
+	} else {
+		return false;
+	}
+	r.key_id = match >> 6;
+	r.tid = packet[9] & 15;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if (groups & 8) {
+		group4 = offset;
+		offset += 16;
+	}
+	if (groups & 1)
+		offset += 16;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4) {
+		vector = offset;
+		offset += 24;
+	}
+	if (packet[6] & 0x40)
+		offset += 2;
+	if (!group4 || offset > bytes || bytes - offset < 14 ||
+	    (vector && packet[vector + 9] > 220))
+		return false;
+	fc = mt6797_join_le16(packet + group4);
+	/* Data (type 2) subtype 0, FromDS, Protected; ToDS, More Fragments,
+	 * Order, QoS and every other subtype bit clear; version 0.
+	 */
+	if ((fc & ~0x2800U) != 0x4208 || (mt6797_join_le16(packet + group4 + 8) & 15))
+		return false;
+	for (i = 0; i < 6; i++)
+		if (packet[group4 + 2 + i] != ap[i])
+			return false;
+	f = packet + offset;
+	if (r.group) {
+		if (!(f[0] & 1))
+			return false;
+	} else {
+		for (i = 0; i < 6; i++)
+			if (f[i] != own[i])
+				return false;
+	}
+	if (f[6] & 1)
+		return false;
+	r.ether_type = ((unsigned int)f[12] << 8) | f[13];
+	r.prefix[0] = fc;
+	r.prefix[1] = fc >> 8;
+	for (i = 0; i < 6; i++) {
+		r.prefix[4 + i] = f[i];
+		r.prefix[10 + i] = ap[i];
+		r.prefix[16 + i] = f[6 + i];
+	}
+	r.prefix[22] = packet[group4 + 8];
+	r.prefix[23] = packet[group4 + 9];
+	r.prefix[24] = 0xaa;
+	r.prefix[25] = 0xaa;
+	r.prefix[26] = 3;
+	r.prefix[30] = f[12];
+	r.prefix[31] = f[13];
+	r.offset = offset + 14;
+	r.bytes = bytes - r.offset;
+	r.signal_valid = vector != 0;
+	r.signal_dbm = vector ? (int)packet[vector + 9] / 2 - 110 : 0;
+	r.group_vld = (unsigned char)groups;
+	*out = r;
+	return true;
+}
