--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/firmware.c
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6797 WLAN firmware: container parsing, validation, EMI copy and ordinary
+ * section submission, and the passive firmware probe.
+ */
+
+#include <linux/bits.h>
+#include <linux/crc32.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/firmware.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include "firmware.h"
+#include "hif.h"
+
+/*
+ * Caller owns immutable data until all views are discarded. No concurrent
+ * parse/get or input mutation. Context must not alias input or output views.
+ * Context is fixed and small; no section table is stored on the stack.
+ */
+struct mtke_context {
+	const u8 *data;
+	size_t size;
+	unsigned int count;
+	int valid;
+};
+
+struct mtke_view {
+	const u8 *data;
+	u32 offset;
+	u32 length;
+	u32 destination;
+	u32 emi_offset;
+	unsigned int emi;
+	unsigned int raw_encrypted;
+	unsigned int raw_key_index;
+	unsigned int encrypted;
+	unsigned int key_index;
+};
+
+/*
+ * Supply standard IEEE CRC32 over the complete supplied span (zlib convention).
+ * Kernel adapter below uses crc32_le; no private CRC implementation required.
+ */
+
+/*
+ * parse: 0 valid, -1 invalid/unsupported structure, -2 unknown reserved
+ * semantics (not a corruption claim). Remaining structure may be unchecked.
+ * Any failure invalidates prior context.
+ */
+
+/* All fields are private except the accounting summary. Caller owns immutable
+ * input until every view is discarded, serializes all access, and keeps input,
+ * context and output storage distinct. No ownership/transfer admission occurs.
+ */
+struct mt6797_image_plan {
+	struct mtke_context image;
+	unsigned int sections;
+	unsigned int ordinary_sections;
+	unsigned int emi_sections;
+	size_t ordinary_bytes;
+	size_t emi_bytes;
+	int valid;
+};
+
+/* Zero means the complete descriptive plan is valid, including EMI sections.
+ * Parser errors (-1/-2) invalidate the whole plan. No execution is admitted.
+ */
+
+static u32 mtke_crc32(const u8 *data, size_t size)
+{
+	return crc32_le(~0U, data, size) ^ ~0U;
+}
+
+static u32 get32(const u8 *p)
+{
+	return (u32)p[0] | (u32)p[1] << 8 |
+	       (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+
+/* Lengths already bounded by the input cap: subtraction avoids end overflow. */
+static int overlap(u32 a, u32 n, u32 b, u32 m)
+{
+	return a <= b ? b - a < n : a - b < m;
+}
+
+static int mtke_parse(struct mtke_context *ctx, const u8 *data, size_t size)
+{
+	unsigned int count, i, j;
+	size_t table;
+
+	if (!ctx)
+		return -1;
+	ctx->valid = 0;
+	ctx->data = NULL;
+	ctx->size = 0;
+	ctx->count = 0;
+	if (!data || size < 24 || size > MTKE_MAX_BYTES)
+		return -1;
+	if (data[0] != 'M' || data[1] != 'T' || data[2] != 'K' ||
+	    data[3] != 'E')
+		return -1;
+	count = get32(data + 8);
+	if (!count || count > MTKE_MAX_SECTIONS)
+		return -1;
+	table = 24 + 16 * count;
+	if (table > size || mtke_crc32(data + 8, size - 8) != get32(data + 4))
+		return -1;
+	/* Unknown reserved semantics are unsupported, not evidence of corruption. */
+	if (get32(data + 20))
+		return -2;
+	for (i = 0; i < count; i++) {
+		const u8 *p = data + 24 + 16 * i;
+		u32 off = get32(p), len = get32(p + 8);
+		u32 dst = get32(p + 12), emi = dst & 0xfffffU;
+
+		if (p[6] || p[7])
+			return -2;
+		if (!len || off < table || off > size ||
+		    len > size - off || len - 1 > 0xffffffffU - dst)
+			return -1;
+		if (i >= 2 && (emi >= 0x80000U || len > 0x80000U - emi))
+			return -1;
+		for (j = 0; j < i; j++) {
+			const u8 *q = data + 24 + 16 * j;
+			u32 qlen = get32(q + 8), qdst = get32(q + 12);
+
+			if (overlap(off, len, get32(q), qlen))
+				return -1;
+			if (i < 2 && overlap(dst, len, qdst, qlen))
+				return -1;
+			if (i >= 2 && j >= 2 &&
+			    overlap(emi, len, qdst & 0xfffffU, qlen))
+				return -1;
+		}
+	}
+	ctx->data = data;
+	ctx->size = size;
+	ctx->count = count;
+	ctx->valid = 1;
+	return 0;
+}
+
+static int mtke_get(const struct mtke_context *ctx, unsigned int index,
+		    struct mtke_view *view)
+{
+	const u8 *p;
+
+	if (!view)
+		return -1;
+	*view = (struct mtke_view){ 0 };
+	if (!ctx || !ctx->valid || index >= ctx->count)
+		return -1;
+	p = ctx->data + 24 + 16 * index;
+	view->offset = get32(p);
+	view->data = ctx->data + view->offset;
+	view->length = get32(p + 8);
+	view->destination = get32(p + 12);
+	view->emi = index >= 2;
+	view->emi_offset = view->emi ? view->destination & 0xfffffU : 0;
+	view->raw_encrypted = p[5];
+	view->raw_key_index = p[4];
+	view->encrypted = !view->emi && p[5] != 0;
+	view->key_index = view->encrypted ? p[4] & 3U : 0;
+	return 0;
+}
+
+static void mt6797_image_plan_invalidate(struct mt6797_image_plan *plan)
+{
+	if (plan)
+		*plan = (struct mt6797_image_plan){0};
+}
+
+static int mt6797_image_plan_prepare(struct mt6797_image_plan *plan,
+				     const u8 *data, size_t size)
+{
+	struct mtke_context image = {0};
+	struct mt6797_image_plan pending = {0};
+	struct mtke_view view;
+	unsigned int i;
+	int error;
+
+	if (!plan)
+		return -1;
+	mt6797_image_plan_invalidate(plan);
+	error = mtke_parse(&image, data, size);
+	if (error)
+		return error;
+	/* No partial view is published while later entries remain unchecked. */
+	for (i = 0; i < image.count; i++) {
+		error = mtke_get(&image, i, &view);
+		if (error)
+			return error;
+		if (view.emi) {
+			pending.emi_sections++;
+			pending.emi_bytes += view.length;
+		} else {
+			pending.ordinary_sections++;
+			pending.ordinary_bytes += view.length;
+		}
+		pending.sections++;
+	}
+	/* The parser proves disjoint payloads within the 1 MiB input cap.
+	 * Consequently neither byte total nor their sum can overflow size_t.
+	 */
+	if (pending.sections != image.count ||
+	    pending.ordinary_sections + pending.emi_sections != image.count)
+		return -1;
+	*plan = pending;
+	plan->image = image;
+	plan->valid = 1;
+	return 0;
+}
+
+/* Passive MT6797 WLAN firmware acquisition and complete-plan validation. */
+
+struct mt6797_wlan_firmware {
+	const struct firmware *blob;
+	struct mt6797_image_plan plan;
+};
+
+int mt6797_wlan_firmware_prepare(struct device *dev,
+				 struct mt6797_wlan_firmware **out)
+{
+	struct mt6797_wlan_firmware *image;
+	int ret;
+
+	if (!out)
+		return -EINVAL;
+	*out = NULL;
+	if (!dev)
+		return -EINVAL;
+
+	image = kzalloc_obj(*image, GFP_KERNEL);
+	if (!image)
+		return -ENOMEM;
+	ret = request_firmware(&image->blob, MT6797_WLAN_FIRMWARE_NAME, dev);
+	if (ret)
+		goto free_image;
+	if (image->blob->size > MTKE_MAX_BYTES) {
+		ret = -EFBIG;
+		goto release_blob;
+	}
+	ret = mt6797_image_plan_prepare(&image->plan, image->blob->data,
+					image->blob->size);
+	if (ret) {
+		ret = ret == -2 ? -EOPNOTSUPP : -EINVAL;
+		goto release_blob;
+	}
+	*out = image;
+	return 0;
+
+release_blob:
+	release_firmware(image->blob);
+free_image:
+	kfree(image);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_firmware_prepare);
+
+int mt6797_wlan_firmware_summary(const struct mt6797_wlan_firmware *image,
+				 struct mt6797_wlan_firmware_summary *summary)
+{
+	if (!image || !summary || !image->plan.valid)
+		return -EINVAL;
+	*summary = (struct mt6797_wlan_firmware_summary) {
+		.sections = image->plan.sections,
+		.ordinary_sections = image->plan.ordinary_sections,
+		.emi_sections = image->plan.emi_sections,
+		.ordinary_bytes = image->plan.ordinary_bytes,
+		.emi_bytes = image->plan.emi_bytes,
+	};
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_firmware_summary);
+
+int mt6797_wlan_firmware_copy_emi(const struct mt6797_wlan_firmware *image,
+				  int (*copy)(void *owner, unsigned int index,
+					      u32 offset, const u8 *data, size_t bytes),
+				  void *owner,
+				  struct mt6797_wlan_emi_copy_result *result)
+{
+	struct mtke_view section;
+	unsigned int i;
+	int ret;
+
+	if (!image || !image->plan.valid || !copy || !owner || !result)
+		return -EINVAL;
+	*result = (struct mt6797_wlan_emi_copy_result){0};
+	for (i = 0; i < image->plan.sections; i++) {
+		ret = mtke_get(&image->plan.image, i, &section);
+		if (ret)
+			return -EINVAL;
+		if (!section.emi)
+			continue;
+		ret = copy(owner, i, section.emi_offset,
+			   section.data, section.length);
+		if (ret)
+			return ret;
+		result->sections++;
+		result->bytes += section.length;
+	}
+	if (result->sections != image->plan.emi_sections ||
+	    result->bytes != image->plan.emi_bytes)
+		return -EIO;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_firmware_copy_emi);
+
+int mt6797_wlan_firmware_submit_ordinary(const struct mt6797_wlan_firmware *image,
+					 struct mt6797_hif *hif,
+					 struct mt6797_wlan_ordinary_result *result)
+{
+	struct mt6797_hif_section_result submitted;
+	struct mt6797_hif_section_request request;
+	struct mtke_view section;
+	u8 config[20];
+	unsigned int i;
+	u32 mode;
+	int ret;
+
+	if (!image || !image->plan.valid || !hif || !result ||
+	    image->plan.sections != 4 || image->plan.ordinary_sections != 2)
+		return -EINVAL;
+	*result = (struct mt6797_wlan_ordinary_result){ .failed_index = 2 };
+	for (i = 0; i < image->plan.sections; i++) {
+		ret = mtke_get(&image->plan.image, i, &section);
+		if (ret)
+			return -EINVAL;
+		if (section.emi)
+			continue;
+		if (i >= 2 || !section.length || section.encrypted > 1 ||
+		    section.key_index > 3)
+			return -EINVAL;
+		mode = BIT(31) | (i == 0 ? BIT(3) : 0);
+		if (section.encrypted)
+			mode |= BIT(0) | (section.key_index << 1);
+		memset(config, 0, sizeof(config));
+		put_unaligned_le16(sizeof(config), config);
+		put_unaligned_le16(0x8000, config + 2);
+		config[4] = 1;
+		config[5] = 0xa0;
+		config[7] = i + 1;
+		put_unaligned_le32(section.destination, config + 8);
+		put_unaligned_le32(section.length, config + 12);
+		put_unaligned_le32(mode, config + 16);
+		request = (struct mt6797_hif_section_request) {
+			.kind = MT6797_SECTION_ORDINARY,
+			.config = config,
+			.config_bytes = sizeof(config),
+			.sequence = i + 1,
+			.data = section.data,
+			.length = section.length,
+		};
+		result->failed_index = i;
+		ret = mt6797_hif_download_section(hif, &request,
+						  ktime_get_ns() + NSEC_PER_SEC,
+						  &submitted);
+		result->firmware_status = submitted.firmware_status;
+		result->partial_submitted = submitted.submitted;
+		if (ret)
+			return ret;
+		if (submitted.submitted != section.length)
+			return -EIO;
+		result->sections++;
+		result->bytes += section.length;
+		result->partial_submitted = 0;
+	}
+	result->failed_index = 2;
+	if (result->sections != image->plan.ordinary_sections ||
+	    result->bytes != image->plan.ordinary_bytes)
+		return -EIO;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_firmware_submit_ordinary);
+
+void mt6797_wlan_firmware_release(struct mt6797_wlan_firmware *image)
+{
+	if (!image)
+		return;
+	release_firmware(image->blob);
+	kfree(image);
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_firmware_release);
+
+/* Passive MT6797 WLAN firmware probe below the shared CONSYS owner. */
+
+static void mt6797_wlan_firmware_cleanup(void *data)
+{
+	mt6797_wlan_firmware_release(data);
+}
+
+static int mt6797_wlan_firmware_probe(struct platform_device *pdev)
+{
+	struct mt6797_wlan_firmware_summary summary;
+	struct mt6797_wlan_firmware *image;
+	int ret;
+
+	if (!pdev->dev.parent ||
+	    !of_device_is_compatible(pdev->dev.parent->of_node,
+				     "mediatek,mt6797-consys") ||
+	    pdev->dev.pm_domain)
+		return -EINVAL;
+
+	ret = mt6797_wlan_firmware_prepare(&pdev->dev, &image);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to prepare WLAN firmware\n");
+	ret = devm_add_action_or_reset(&pdev->dev,
+				       mt6797_wlan_firmware_cleanup, image);
+	if (ret)
+		return ret;
+	ret = mt6797_wlan_firmware_summary(image, &summary);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, image);
+	dev_info(&pdev->dev,
+		 "validated WLAN firmware: %u sections, ordinary %u/%zu bytes, EMI %u/%zu bytes; execution held\n",
+		 summary.sections, summary.ordinary_sections,
+		 summary.ordinary_bytes, summary.emi_sections,
+		 summary.emi_bytes);
+	return 0;
+}
+
+static const struct of_device_id mt6797_wlan_firmware_of_match[] = {
+	{ .compatible = "mediatek,mt6797-wlan" },
+	{}
+};
+
+static struct platform_driver mt6797_wlan_firmware_driver = {
+	.probe = mt6797_wlan_firmware_probe,
+	.driver = {
+		.name = "mt6797-wlan-firmware",
+		.of_match_table = mt6797_wlan_firmware_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(mt6797_wlan_firmware_driver);
diff --git a/drivers/net/wireless/mediatek/mt6797/firmware.h b/drivers/net/wireless/mediatek/mt6797/firmware.h
new file mode 100644
index 000000000..d2b3c8dc0
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/firmware.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_WLAN_FIRMWARE_H
+#define MT6797_WLAN_FIRMWARE_H
+
+#include <linux/device.h>
+
+#include <linux/types.h>
+
+#define MT6797_WLAN_FIRMWARE_NAME "mediatek/mt6797/WIFI_RAM_CODE_6797"
+
+/* Container bounds: the whole image and its section table. */
+#define MTKE_MAX_BYTES (1024U * 1024U)
+#define MTKE_MAX_SECTIONS 256U
+
+struct mt6797_wlan_firmware;
+
+struct mt6797_wlan_firmware_summary {
+	unsigned int sections;
+	unsigned int ordinary_sections;
+	unsigned int emi_sections;
+	size_t ordinary_bytes;
+	size_t emi_bytes;
+};
+
+struct mt6797_wlan_emi_copy_result {
+	unsigned int sections;
+	size_t bytes;
+};
+
+struct mt6797_wlan_ordinary_result {
+	unsigned int sections;
+	size_t bytes;
+	unsigned int failed_index;
+	unsigned int firmware_status;
+	size_t partial_submitted;
+};
+
+struct mt6797_hif;
+
+/* Preparation alone is passive. The returned object owns immutable firmware
+ * bytes and its complete plan until release. No hardware admission or
+ * executable section view is exposed by preparation. An effectful caller
+ * retains it until quiescence is proved.
+ */
+int mt6797_wlan_firmware_prepare(struct device *dev,
+				 struct mt6797_wlan_firmware **out);
+int mt6797_wlan_firmware_summary(const struct mt6797_wlan_firmware *image,
+				 struct mt6797_wlan_firmware_summary *summary);
+/* The caller must hold the powered CONSYS/EMI owner and a writable WLAN
+ * window throughout this call. Every callback may have a partial effect;
+ * neither failure nor success permits replay or firmware START. No physical
+ * destination or protection control is exposed by the image object.
+ */
+int mt6797_wlan_firmware_copy_emi(const struct mt6797_wlan_firmware *image,
+				  int (*copy)(void *owner, unsigned int index,
+					      u32 offset, const u8 *data, size_t bytes),
+				  void *owner,
+				  struct mt6797_wlan_emi_copy_result *result);
+/* Submit exactly the two validated ordinary sections through the owned HIF.
+ * Every CONFIG and PDA action may be partial; failure poisons the transaction.
+ * Success reports submission only, not firmware execution or permission to
+ * release the image, HIF or shared CONSYS resources.
+ */
+int mt6797_wlan_firmware_submit_ordinary(const struct mt6797_wlan_firmware *image,
+					 struct mt6797_hif *hif,
+					 struct mt6797_wlan_ordinary_result *result);
+void mt6797_wlan_firmware_release(struct mt6797_wlan_firmware *image);
+
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/hif-init.h b/drivers/net/wireless/mediatek/mt6797/hif-init.h
new file mode 100644
index 000000000..26bff45b6
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/hif-init.h
@@ -0,0 +1,672 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_HIF_INIT_H
+#define MT6797_HIF_INIT_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+/* Original transfer-size arithmetic. */
+
+struct mt6797_hif_transfer_size {
+	size_t dma_bytes;
+	unsigned int command_count;
+	bool block_mode;
+};
+
+/*
+ * Selected 512-byte block contract. No address, mapping, port or MMIO action.
+ * A zero command count is deliberately refused: its special meaning on this
+ * private SDIO-like HIF has not been established. TX padding must be initialized
+ * by the caller; RX storage must cover dma_bytes, not just payload_bytes.
+ */
+static inline int
+mt6797_hif_transfer_size(size_t payload_bytes, size_t capacity, bool receive,
+			 struct mt6797_hif_transfer_size *result)
+{
+	size_t bytes, count;
+	bool blocks;
+
+	if (!result)
+		return -EINVAL;
+	*result = (struct mt6797_hif_transfer_size){0};
+	/* This bound also makes every following round-up overflow-safe. */
+	if (!payload_bytes || payload_bytes > 511U * 512U)
+		return -EMSGSIZE;
+
+	/* Receive rounds to eight bytes before the mode is chosen: a DMA read
+	 * of 505-508 bytes is one 512-byte block, never a byte-mode command
+	 * of 512, which exceeds the count field (boots AA5, AA6) (0310).
+	 */
+	bytes = receive ? (payload_bytes + 7U) & ~(size_t)7U :
+			  (payload_bytes + 3U) & ~(size_t)3U;
+	blocks = bytes >= 512U;
+	if (blocks) {
+		count = (bytes + 511U) / 512U;
+		bytes = count * 512U;
+	} else {
+		count = bytes;
+	}
+	if (!count || count > 511U || bytes > 0xfffffU || bytes > capacity)
+		return -EMSGSIZE;
+
+	result->dma_bytes = bytes;
+	result->command_count = (unsigned int)count;
+	result->block_mode = blocks;
+	return 0;
+}
+
+/* Original fixed-port command encoder. */
+
+enum mt6797_hif_direction {
+	MT6797_HIF_READ = 0,
+	MT6797_HIF_WRITE = 1,
+};
+
+/* Source use_dma policy, not a selection of the engine executing the command. */
+enum mt6797_hif_rx_policy {
+	MT6797_HIF_PIO_ONLY = 0,
+	MT6797_HIF_DMA_ENABLED = 1,
+};
+
+struct mt6797_hif_command {
+	unsigned int word;
+	size_t transfer_bytes;
+};
+
+/*
+ * Only INIT/data TX WTDR1 and response RX WRDR0/1 are admitted here.
+ * Function 1 and fixed-port mode are constants, not unvalidated caller fields.
+ * DMA_ENABLED preserves eight-byte RX alignment even for a PIO fallback.
+ * The caller owns initialized TX padding, RX capacity and all runtime gates.
+ */
+static inline int mt6797_hif_encode_command(unsigned int port,
+					    enum mt6797_hif_direction direction,
+					    enum mt6797_hif_rx_policy policy,
+					    size_t payload_bytes,
+					    size_t capacity,
+					    struct mt6797_hif_command *result)
+{
+	struct mt6797_hif_transfer_size size;
+	int error;
+
+	if (!result)
+		return -EINVAL;
+	*result = (struct mt6797_hif_command){0};
+	if ((direction != MT6797_HIF_READ && direction != MT6797_HIF_WRITE) ||
+	    (policy != MT6797_HIF_PIO_ONLY &&
+	     policy != MT6797_HIF_DMA_ENABLED) ||
+	    port > 0x1ffffU)
+		return -EINVAL;
+	if ((direction == MT6797_HIF_WRITE && port != 0x34U) ||
+	    (direction == MT6797_HIF_READ && port != 0x50U && port != 0x54U))
+		return -EINVAL;
+
+	/* The helper's false branch supplies four-byte TX/PIO-only RX rounding. */
+	error = mt6797_hif_transfer_size(payload_bytes, capacity,
+					 direction == MT6797_HIF_READ &&
+						 policy ==
+							 MT6797_HIF_DMA_ENABLED,
+					 &size);
+	if (error)
+		return error;
+	if (!size.command_count || size.command_count > 0x1ffU)
+		return -EMSGSIZE;
+	result->word = size.command_count | (port << 9) |
+		       (size.block_mode ? (1U << 27) : 0U) | (1U << 28) |
+		       (direction == MT6797_HIF_WRITE ? (1U << 31) : 0U);
+	result->transfer_bytes = size.dma_bytes;
+	return 0;
+}
+
+/* Offset-relative, ordered scalar I/O. Return zero on success, else error.
+ * A kernel adapter uses writel/readl on its held mapping. No status emulation.
+ */
+struct mt6797_hif_pio_io {
+	void *context;
+	int (*write)(void *context, unsigned int offset, unsigned int value);
+	int (*read)(void *context, unsigned int offset, unsigned int *value);
+};
+
+struct mt6797_hif_pio_result {
+	size_t data_bytes;
+	bool setup_submitted;
+	bool transfer_complete;
+};
+
+/* Caller holds powered mapping, driver ownership and setup/data serialization.
+ * Credits/RX length, session validity and response completion belong to caller.
+ * TX reads only payload bytes and supplies zero padding; RX stores padded bytes.
+ * Zero return means finite submission/read completed, not firmware success.
+ * An I/O error may have side effects: no retry, rollback or credit refund.
+ */
+static inline int mt6797_hif_pio_transfer(const struct mt6797_hif_pio_io *io,
+					  unsigned int port,
+					  enum mt6797_hif_direction direction,
+					  unsigned char *buffer,
+					  size_t payload_bytes, size_t capacity,
+					  struct mt6797_hif_pio_result *result)
+{
+	struct mt6797_hif_command command;
+	size_t offset;
+	unsigned int byte, word;
+	int error;
+
+	if (!result)
+		return -EINVAL;
+	*result = (struct mt6797_hif_pio_result){0};
+	if (!io || !io->write || !buffer ||
+	    (direction == MT6797_HIF_READ && !io->read))
+		return -EINVAL;
+	error = mt6797_hif_encode_command(port, direction, MT6797_HIF_PIO_ONLY,
+					  payload_bytes, capacity, &command);
+	if (error)
+		return error;
+	if (io->write(io->context, 0, command.word))
+		return -EIO;
+	result->setup_submitted = true;
+	for (offset = 0; offset < command.transfer_bytes; offset += 4) {
+		word = 0;
+		if (direction == MT6797_HIF_WRITE) {
+			for (byte = 0; byte < 4; byte++)
+				if (offset + byte < payload_bytes)
+					word |= (unsigned int)
+							buffer[offset + byte]
+						<< (byte * 8);
+			error = io->write(io->context, 0x1000, word);
+		} else {
+			error = io->read(io->context, 0x1000, &word);
+			if (!error)
+				for (byte = 0; byte < 4; byte++)
+					buffer[offset + byte] =
+						(unsigned char)(word >>
+								(byte * 8));
+		}
+		if (error)
+			return -EIO;
+		result->data_bytes += 4;
+	}
+	result->transfer_complete = true;
+	return 0;
+}
+
+/* Selected per-class boot INIT seed (TC0 and TC4): 8 * ceil((28 + 1532) / 128) = 104.
+ * Caller establishes the fresh boot phase; this function never seeds/refunds.
+ * Frame length already includes INIT header, excludes bus padding.
+ */
+static inline int mt6797_init_debit(size_t frame_bytes,
+				    unsigned int *free_pages)
+{
+	unsigned int cost;
+
+	if (!free_pages || *free_pages > 104U)
+		return -EINVAL;
+	if (!frame_bytes || frame_bytes > 104U * 128U)
+		return -EMSGSIZE;
+	cost = (unsigned int)((frame_bytes + 127U) / 128U);
+	if (cost > *free_pages)
+		return -ENOSPC;
+	*free_pages -= cost;
+	return 0;
+}
+
+/* Selected MT6797 CMD_RESULT is 28 logical bytes. Extra-read policy is +4,
+ * with RX aggregation/coalescing enabled. Read 32 into staging, decode 28.
+ * A pending length of zero is distinct from an unexpected nonzero event.
+ */
+static inline int mt6797_init_result_span(unsigned int reported_length,
+					  size_t staging_capacity,
+					  struct mt6797_hif_command *result)
+{
+	if (!result)
+		return -EINVAL;
+	*result = (struct mt6797_hif_command){0};
+	if (!reported_length)
+		return -EAGAIN;
+	if (reported_length != 28U)
+		return -EMSGSIZE;
+	return mt6797_hif_encode_command(0x50U, MT6797_HIF_READ,
+					 MT6797_HIF_PIO_ONLY, 32U,
+					 staging_capacity, result);
+}
+
+static inline unsigned int mt6797_init_le16(const unsigned char *p)
+{
+	return (unsigned int)p[0] | ((unsigned int)p[1] << 8);
+}
+
+static inline unsigned int mt6797_init_le32(const unsigned char *p)
+{
+	return mt6797_init_le16(p) | (mt6797_init_le16(p + 2) << 16);
+}
+
+/* Exact logical bytes only, not the 32-byte staging span. Nonzero status is
+ * well-formed firmware rejection (-EIO); diagnostics stay uninterpreted.
+ */
+static inline int mt6797_init_validate_result(const unsigned char *packet,
+					      size_t bytes,
+					      unsigned int expected_sequence,
+					      unsigned int *status)
+{
+	if (!status)
+		return -EINVAL;
+	*status = 0;
+	if (!packet || expected_sequence > 255U)
+		return -EINVAL;
+	if (bytes != 28 || mt6797_init_le16(packet) != 28 ||
+	    mt6797_init_le16(packet + 2) != 0xe000 || packet[4] != 1 ||
+	    packet[5] != expected_sequence)
+		return -EPROTO;
+	*status = packet[8];
+	return *status ? -EIO : 0;
+}
+
+static inline int mt6797_init_validate_config(const unsigned char *p,
+					      size_t bytes,
+					      unsigned int sequence)
+{
+	unsigned int address, length, mode;
+
+	if (!p || sequence > 255U)
+		return -EINVAL;
+	if (bytes != 20 || mt6797_init_le16(p) != 20 ||
+	    mt6797_init_le16(p + 2) != 0x8000 || p[4] != 1 || p[5] != 0xa0 ||
+	    p[6] || p[7] != sequence)
+		return -EPROTO;
+	address = mt6797_init_le32(p + 8);
+	length = mt6797_init_le32(p + 12);
+	mode = mt6797_init_le32(p + 16);
+	/* Inclusive last address allows a range ending exactly at 2^32. */
+	if (!length || length - 1U > 0xffffffffU - address ||
+	    (mode & ~0x8000000fU) || !(mode & 0x80000000U) ||
+	    ((mode & 6U) && !(mode & 1U)))
+		return -EPROTO;
+	return 0;
+}
+
+static inline int mt6797_init_validate_start(const unsigned char *p,
+					     size_t bytes,
+					     unsigned int sequence)
+{
+	if (!p || sequence > 255U)
+		return -EINVAL;
+	if (bytes != 16 || mt6797_init_le16(p) != 16 ||
+	    mt6797_init_le16(p + 2) != 0x8000 || p[4] != 2 || p[5] != 0xa0 ||
+	    p[6] || p[7] != sequence || mt6797_init_le32(p + 8) > 1U)
+		return -EPROTO;
+	/* The address is not a permission or validity check. */
+	return 0;
+}
+
+enum mt6797_init_phase {
+	MT6797_INIT_IDLE,
+	MT6797_INIT_DISPATCH,
+	MT6797_INIT_REPLY,
+	MT6797_INIT_POISONED,
+	MT6797_START_DISPATCH,
+	MT6797_START_READY,
+	MT6797_INIT_PAYLOAD
+};
+
+/* Zero-initialize once, set each pool only from proven fresh INIT admission.
+ * Caller serializes all calls and owns a finite deadline/owner generation.
+ * No reset/refund entry point. Do not reconstruct this after failure.
+ */
+struct mt6797_init_transaction {
+	enum mt6797_init_phase phase;
+	unsigned int free_pages, start_free_pages, expected_sequence;
+	/* free_pages is CONFIG TC4; start_free_pages is START TC0. */
+	unsigned char used_sequences[32];
+};
+
+static inline int mt6797_init_abort(struct mt6797_init_transaction *t)
+{
+	if (!t)
+		return -EINVAL;
+	t->phase = MT6797_INIT_POISONED;
+	return -EIO;
+}
+
+static inline int mt6797_init_begin(struct mt6797_init_transaction *t,
+				    const unsigned char *command, size_t bytes,
+				    unsigned int expected_sequence)
+{
+	int error;
+
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_INIT_IDLE || t->free_pages > 104U)
+		return mt6797_init_abort(t);
+	error = mt6797_init_validate_config(command, bytes, expected_sequence);
+	if (error)
+		return error;
+	if (t->used_sequences[expected_sequence / 8] &
+	    (1U << (expected_sequence % 8)))
+		return mt6797_init_abort(t);
+	error = mt6797_init_debit(bytes, &t->free_pages);
+	if (error)
+		return error;
+	t->used_sequences[expected_sequence / 8] |=
+		(unsigned char)(1U << (expected_sequence % 8));
+	t->expected_sequence = expected_sequence;
+	t->phase = MT6797_INIT_DISPATCH;
+	return 0;
+}
+
+/* Feed the finite PIO primitive's return outcome. Success means submitted,
+ * not acknowledged. Any uncertain/failing outcome permanently poisons state.
+ */
+static inline int mt6797_init_submitted(struct mt6797_init_transaction *t,
+					int pio_error)
+{
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_INIT_DISPATCH || pio_error)
+		return mt6797_init_abort(t);
+	t->phase = MT6797_INIT_REPLY;
+	return 0;
+}
+
+static inline int mt6797_start_begin(struct mt6797_init_transaction *t,
+				     const unsigned char *command, size_t bytes,
+				     unsigned int expected_sequence)
+{
+	int error;
+
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_INIT_IDLE || t->start_free_pages > 104U)
+		return mt6797_init_abort(t);
+	error = mt6797_init_validate_start(command, bytes, expected_sequence);
+	if (error)
+		return error;
+	if (t->used_sequences[expected_sequence / 8] &
+	    (1U << (expected_sequence % 8)))
+		return mt6797_init_abort(t);
+	error = mt6797_init_debit(bytes, &t->start_free_pages);
+	if (error)
+		return error;
+	t->used_sequences[expected_sequence / 8] |=
+		(unsigned char)(1U << (expected_sequence % 8));
+	t->expected_sequence = expected_sequence;
+	t->phase = MT6797_START_DISPATCH;
+	return 0;
+}
+
+static inline int mt6797_start_submitted(struct mt6797_init_transaction *t,
+					 int pio_error)
+{
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_START_DISPATCH || pio_error)
+		return mt6797_init_abort(t);
+	t->phase = MT6797_START_READY;
+	return 0;
+}
+
+/* Caller supplies an attributable WCIR observation after successful START TX.
+ * This is a level test, not proof that START caused a transition. Caller owns
+ * deadline and session validity; abort on timeout/ownership loss/read failure.
+ */
+static inline int mt6797_start_observe_ready(struct mt6797_init_transaction *t,
+					     unsigned int wcir)
+{
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_START_READY)
+		return mt6797_init_abort(t);
+	if (!(wcir & (1U << 21)))
+		return -EAGAIN;
+	t->phase = MT6797_INIT_IDLE;
+	return 0;
+}
+
+/* Validate port-0 length before dispatching the RX primitive. */
+static inline int mt6797_init_prepare_reply(struct mt6797_init_transaction *t,
+					    unsigned int length,
+					    size_t capacity,
+					    struct mt6797_hif_command *span)
+{
+	int error;
+
+	if (span)
+		*span = (struct mt6797_hif_command){0};
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_INIT_REPLY)
+		return mt6797_init_abort(t);
+	error = mt6797_init_result_span(length, capacity, span);
+	if (error && error != -EAGAIN)
+		mt6797_init_abort(t);
+	return error;
+}
+
+static inline int mt6797_init_accept_reply(struct mt6797_init_transaction *t,
+					   const unsigned char *packet,
+					   size_t logical_bytes,
+					   unsigned int *firmware_status)
+{
+	int error;
+
+	if (firmware_status)
+		*firmware_status = 0;
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_INIT_REPLY)
+		return mt6797_init_abort(t);
+	error = mt6797_init_validate_result(packet, logical_bytes,
+					    t->expected_sequence, firmware_status);
+	if (error) {
+		mt6797_init_abort(t);
+		return error;
+	}
+	t->phase = MT6797_INIT_IDLE;
+	return 0;
+}
+
+/* One CONFIG phase, deliberately split at the caller's timed WRPLR wait.
+ * Caller holds the existing owner/session/serialization contract throughout.
+ * No callback is added beyond the accepted scalar PIO seam.
+ */
+static inline int mt6797_config_send(struct mt6797_init_transaction *t,
+				     const struct mt6797_hif_pio_io *io,
+				     const unsigned char *command, size_t bytes,
+				     unsigned int sequence)
+{
+	unsigned char staging[20];
+	struct mt6797_hif_pio_result result;
+	size_t i;
+	int error;
+
+	if (!t)
+		return -EINVAL;
+	if (t->phase != MT6797_INIT_IDLE)
+		return mt6797_init_abort(t);
+	/* Validate the whole exchange's I/O capability before consuming credit. */
+	if (!io || !io->write || !io->read)
+		return -EINVAL;
+	error = mt6797_init_validate_config(command, bytes, sequence);
+	if (error)
+		return error;
+	for (i = 0; i < sizeof(staging); i++)
+		staging[i] = command[i];
+	error = mt6797_init_begin(t, staging, sizeof(staging), sequence);
+	if (error)
+		return error;
+	error = mt6797_hif_pio_transfer(io, 0x34, MT6797_HIF_WRITE, staging,
+					sizeof(staging), sizeof(staging),
+					&result);
+	return mt6797_init_submitted(t, error);
+}
+
+/* Caller supplies this session's port-0 logical WRPLR length after a timed wait.
+ * Zero returns EAGAIN without I/O. Exact length triggers one 32-byte PIO read
+ * and validation of its first 28 bytes. No raw reply escapes this function.
+ */
+static inline int mt6797_config_receive(struct mt6797_init_transaction *t,
+					const struct mt6797_hif_pio_io *io,
+					unsigned int length,
+					unsigned int *firmware_status)
+{
+	unsigned char staging[32];
+	struct mt6797_hif_command span;
+	struct mt6797_hif_pio_result result;
+	int error;
+
+	if (firmware_status)
+		*firmware_status = 0;
+	if (!io || !io->read || !io->write || !firmware_status) {
+		if (t)
+			mt6797_init_abort(t);
+		return -EINVAL;
+	}
+	error = mt6797_init_prepare_reply(t, length, sizeof(staging), &span);
+	if (error)
+		return error;
+	error = mt6797_hif_pio_transfer(io, 0x50, MT6797_HIF_READ, staging,
+					span.transfer_bytes, sizeof(staging),
+					&result);
+	if (error)
+		return mt6797_init_abort(t);
+	return mt6797_init_accept_reply(t, staging, 28, firmware_status);
+}
+
+enum mt6797_section_kind { MT6797_SECTION_ORDINARY, MT6797_SECTION_EMI };
+enum mt6797_section_phase {
+	MT6797_SECTION_NEW,
+	MT6797_SECTION_CONFIG,
+	MT6797_SECTION_PAYLOAD,
+	MT6797_SECTION_SUBMITTED,
+	MT6797_SECTION_FAILED
+};
+
+struct mt6797_ordinary_section {
+	enum mt6797_section_phase phase;
+	struct mt6797_init_transaction *transaction;
+	const unsigned char *data;
+	size_t length, submitted;
+};
+
+static inline int mt6797_section_fail(struct mt6797_ordinary_section *s)
+{
+	if (!s)
+		return -EINVAL;
+	s->phase = MT6797_SECTION_FAILED;
+	if (s->transaction)
+		mt6797_init_abort(s->transaction);
+	return -EIO;
+}
+
+/* Caller has validated ordinary-section metadata/bytes and retains immutable
+ * data, transaction, powered ownership and serialization for the entire phase.
+ * EMI is explicitly refused, not silently omitted. No destination permission.
+ */
+static inline int
+mt6797_section_begin(struct mt6797_ordinary_section *s,
+		     struct mt6797_init_transaction *t,
+		     const struct mt6797_hif_pio_io *io,
+		     enum mt6797_section_kind kind,
+		     const unsigned char *config, size_t config_bytes,
+		     unsigned int sequence, const unsigned char *data,
+		     size_t length)
+{
+	int error;
+
+	if (!s || !t || !data || kind != MT6797_SECTION_ORDINARY)
+		return -EINVAL;
+	if (s->phase != MT6797_SECTION_NEW)
+		return mt6797_section_fail(s);
+	error = mt6797_init_validate_config(config, config_bytes, sequence);
+	if (error)
+		return error;
+	if (!length || length != mt6797_init_le32(config + 12))
+		return -EMSGSIZE;
+	s->transaction = t;
+	s->data = data;
+	s->length = length;
+	s->submitted = 0;
+	error = mt6797_config_send(t, io, config, config_bytes, sequence);
+	if (error) {
+		mt6797_section_fail(s);
+		return error;
+	}
+	s->phase = MT6797_SECTION_CONFIG;
+	return 0;
+}
+
+static inline int mt6797_section_ack(struct mt6797_ordinary_section *s,
+				     const struct mt6797_hif_pio_io *io,
+				     unsigned int length, unsigned int *status)
+{
+	int error;
+
+	if (status)
+		*status = 0;
+	if (!s)
+		return -EINVAL;
+	if (s->phase != MT6797_SECTION_CONFIG)
+		return mt6797_section_fail(s);
+	error = mt6797_config_receive(s->transaction, io, length, status);
+	if (error == -EAGAIN)
+		return error;
+	if (error) {
+		mt6797_section_fail(s);
+		return error;
+	}
+	s->phase = MT6797_SECTION_PAYLOAD;
+	s->transaction->phase = MT6797_INIT_PAYLOAD;
+	return 0;
+}
+
+/* Exactly one <=2048-byte PDA chunk per call; no ACK wait or local credit debit.
+ * Scratch must be distinct from immutable section data and all state/I/O objects.
+ * At most 2560 bytes needed. Caller checks deadline/ownership between calls.
+ */
+static inline int mt6797_section_next(struct mt6797_ordinary_section *s,
+				      const struct mt6797_hif_pio_io *io,
+				      unsigned char *scratch, size_t capacity)
+{
+	size_t chunk, bytes, i;
+	struct mt6797_hif_command command;
+	struct mt6797_hif_pio_result result;
+	int error;
+
+	if (!s)
+		return -EINVAL;
+	if (s->phase != MT6797_SECTION_PAYLOAD || !s->transaction ||
+	    s->transaction->phase != MT6797_INIT_PAYLOAD || !s->data ||
+	    s->submitted >= s->length || !scratch || !io || !io->write)
+		return mt6797_section_fail(s);
+	chunk = s->length - s->submitted;
+	if (chunk > 2048)
+		chunk = 2048;
+	bytes = 8 + chunk;
+	error = mt6797_hif_encode_command(0x34, MT6797_HIF_WRITE,
+					  MT6797_HIF_PIO_ONLY, bytes, capacity,
+					  &command);
+	if (error) {
+		mt6797_section_fail(s);
+		return error;
+	}
+	for (i = 0; i < 8; i++)
+		scratch[i] = 0;
+	scratch[0] = (unsigned char)bytes;
+	scratch[1] = (unsigned char)(bytes >> 8);
+	scratch[3] = 0xc0;
+	scratch[5] = 0xa0;
+	for (i = 0; i < chunk; i++)
+		scratch[8 + i] = s->data[s->submitted + i];
+	error = mt6797_hif_pio_transfer(io, 0x34, MT6797_HIF_WRITE, scratch,
+					bytes, capacity, &result);
+	if (error) {
+		mt6797_section_fail(s);
+		return error;
+	}
+	s->submitted += chunk;
+	if (s->submitted == s->length) {
+		s->phase = MT6797_SECTION_SUBMITTED;
+		s->transaction->phase = MT6797_INIT_IDLE;
+	}
+	return 0;
+}
+
+#endif /* MT6797_HIF_INIT_H */
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
new file mode 100644
index 000000000..a51eb11f7
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -0,0 +1,2146 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/align.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/unaligned.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include "hif.h"
+
+/* The TC1 pages the host ledger admits for ordinary data: 13 a full frame
+ * (28-byte descriptor, 1,514-byte Ethernet frame, 128-byte pages) times the
+ * data depth, so the ledger and the depth cannot disagree; 52 without the
+ * depth option, the series' value.
+ */
+#define MT6797_TC1_LEDGER_PAGES (13U * 12)
+
+/* Prepare one management frame through the same TC4 owner as commands.
+ * The descriptor counts toward firmware pages; bus padding does not.
+ * No command sequence is consumed: TXdone matches the single-use frame PID.
+ * Caller owns exclusive station/channel admission and the PID ledger.
+ * No previous page debt may overlap this bounded submission.
+ */
+static inline int
+mt6797_join_prepare_frame(struct mt6797_normal_transaction *t,
+			  const unsigned char descriptor[MT6797_JOIN_TX_DESC_BYTES],
+			  const unsigned char *frame, size_t bytes, unsigned int pages,
+			  unsigned char *output, size_t capacity,
+			  struct mt6797_hif_command *command)
+{
+	struct mt6797_hif_command encoded;
+	size_t total, i;
+	int error;
+
+	if (t->tc4_free != t->tc4_limit)
+		return -EBUSY;
+	if (t->tc4_free < pages)
+		return -ENOSPC;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	error = mt6797_hif_encode_command(0x34, MT6797_HIF_WRITE,
+					  MT6797_HIF_PIO_ONLY, total, capacity, &encoded);
+	if (error)
+		return error;
+	for (i = 0; i < encoded.transfer_bytes; i++)
+		output[i] = 0;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = descriptor[i];
+	for (i = 0; i < bytes; i++)
+		output[MT6797_JOIN_TX_DESC_BYTES + i] = frame[i];
+	t->tc4_free -= pages;
+	t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	t->phase = MT6797_NORMAL_CONFIG_TX;
+	*command = encoded;
+	return 0;
+}
+
+static inline int
+mt6797_join_prepare_management(struct mt6797_normal_transaction *t,
+			       const unsigned char *frame, size_t bytes,
+			       unsigned char wlan, unsigned char pid,
+			       unsigned int lifetime_ms, unsigned int attempt_count,
+			       unsigned char *output, size_t capacity,
+			       struct mt6797_hif_command *command)
+{
+	unsigned char descriptor[MT6797_JOIN_TX_DESC_BYTES];
+	unsigned int pages;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    !t->tc4_limit || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit)
+		return mt6797_normal_abort(t);
+	if (!mt6797_join_tx_descriptor(frame, bytes, wlan, pid, lifetime_ms,
+				       attempt_count, descriptor, &pages))
+		return -EINVAL;
+	return mt6797_join_prepare_frame(t, descriptor, frame, bytes, pages,
+					 output, capacity, command);
+}
+
+/* Prepare one Ethernet II EAPOL frame as a security frame on the same TC4
+ * owner (the pinned gen3 security-frame path); the same ledger rules apply.
+ */
+static inline int
+mt6797_join_prepare_security(struct mt6797_normal_transaction *t,
+			     const unsigned char *frame, size_t bytes,
+			     unsigned char wlan, unsigned char pid,
+			     unsigned int lifetime_ms, unsigned int attempt_count,
+			     unsigned char *output, size_t capacity,
+			     struct mt6797_hif_command *command)
+{
+	unsigned char descriptor[MT6797_JOIN_TX_DESC_BYTES];
+	unsigned int pages;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    !t->tc4_limit || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit)
+		return mt6797_normal_abort(t);
+	if (!mt6797_join_tx_security_descriptor(frame, bytes, wlan, pid,
+						lifetime_ms, attempt_count,
+						descriptor, &pages))
+		return -EINVAL;
+	return mt6797_join_prepare_frame(t, descriptor, frame, bytes, pages,
+					 output, capacity, command);
+}
+
+/* Prepare one protected Ethernet II data frame on the TC1 data pool: the
+ * same framing as the TC4 frames, the pages debited from the pool admitted
+ * by mt6797_normal_admit_tc1, one frame in flight (the pool must be whole),
+ * no command sequence consumed, TX done matched by the PID. The TC4 ledger
+ * is untouched; the phase flip is the same as for every frame.
+ */
+static inline int
+mt6797_join_prepare_data_report(struct mt6797_normal_transaction *t,
+				const unsigned char *frame, size_t bytes,
+				unsigned char wlan, unsigned char pid,
+				bool status_report,
+				unsigned int lifetime_ms, unsigned int attempt_count,
+				unsigned char *output, size_t capacity,
+				struct mt6797_hif_command *command)
+{
+	unsigned char descriptor[MT6797_JOIN_TX_DESC_BYTES];
+	struct mt6797_hif_command encoded;
+	unsigned int pages;
+	size_t total, i;
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    !t->tc4_limit || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit ||
+	    !t->tc1_limit || t->tc1_free > t->tc1_limit)
+		return mt6797_normal_abort(t);
+	if (!mt6797_join_tx_data_descriptor_report(frame, bytes, wlan, pid,
+						   status_report, lifetime_ms,
+						   attempt_count, descriptor, &pages))
+		return -EINVAL;
+	if (t->tc1_free < pages)
+		return -ENOSPC;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	error = mt6797_hif_encode_command(0x34, MT6797_HIF_WRITE,
+					  MT6797_HIF_PIO_ONLY, total, capacity, &encoded);
+	if (error)
+		return error;
+	for (i = 0; i < encoded.transfer_bytes; i++)
+		output[i] = 0;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = descriptor[i];
+	for (i = 0; i < bytes; i++)
+		output[MT6797_JOIN_TX_DESC_BYTES + i] = frame[i];
+	t->tc1_free -= pages;
+	t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	t->phase = MT6797_NORMAL_CONFIG_TX;
+	*command = encoded;
+	return 0;
+}
+
+static inline int
+mt6797_join_prepare_data(struct mt6797_normal_transaction *t,
+			 const unsigned char *frame, size_t bytes,
+			 unsigned char wlan, unsigned char pid,
+			 unsigned int lifetime_ms, unsigned int attempt_count,
+			 unsigned char *output, size_t capacity,
+			 struct mt6797_hif_command *command)
+{
+	return mt6797_join_prepare_data_report(t, frame, bytes, wlan, pid, true,
+					       lifetime_ms, attempt_count, output,
+					       capacity, command);
+}
+
+/* Internal fixed command set. Callers use the corresponding payload encoder
+ * and own operation ordering, response identity and firmware lifetime gates.
+ */
+static inline int
+mt6797_join_prepare_command(struct mt6797_normal_transaction *t,
+			    unsigned int cid, unsigned int sequence, const unsigned char *payload,
+	size_t bytes, unsigned char *output, size_t capacity,
+	struct mt6797_hif_command *command)
+{
+	size_t required;
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !payload || !output || !command || !sequence || sequence > 255)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    !t->tc4_limit || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit)
+		return mt6797_normal_abort(t);
+	switch (cid) {
+	case 0x07:
+		required = MT6797_JOIN_KEY_BYTES;
+		break;
+	case 0x0a:
+		if (bytes != 4 || payload[0] != 9 || payload[1] || payload[2] || payload[3])
+			return -EINVAL;
+		required = 4;
+		break;
+	case 0x12:
+		required = MT6797_JOIN_BSS_BYTES;
+		break;
+	case 0x13:
+		required = MT6797_JOIN_STA_BYTES;
+		break;
+	case 0x14:
+		required = 4;
+		break;
+	case 0x16:
+		if (bytes != MT6797_JOIN_PM_CONNECTED_BYTES || payload[0] || !payload[1] ||
+		    !mt6797_join_le16(payload + 2) || mt6797_join_le16(payload + 2) > 2007 ||
+		    !mt6797_join_le16(payload + 4) || payload[6] || payload[7] ||
+		    payload[8] || payload[9] || payload[10] || payload[11])
+			return -EINVAL;
+		required = MT6797_JOIN_PM_CONNECTED_BYTES;
+		break;
+	case 0x17:
+		if (bytes != 4 || payload[0] || payload[1] || payload[2] || payload[3])
+			return -EINVAL;
+		required = 4;
+		break;
+	case 0x1c:
+		required = 16;
+		break;
+	case 0xc0:
+		/* Only the exact mask store; reject lengths before field reads. */
+		if (bytes != MT6797_DIAG_MASK_BYTES ||
+		    mt6797_join_le32(payload) != MT6797_DIAG_MASK_TARGET ||
+		    (mt6797_join_le32(payload + 4) != 0 &&
+		     mt6797_join_le32(payload + 4) != 7))
+			return -EINVAL;
+		required = MT6797_DIAG_MASK_BYTES;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (bytes != required)
+		return -EINVAL;
+	if (t->cleanup_retained_pages) {
+		/* Only removal/abort encoders, never a key install, STA activation
+		 * or another channel request. Their original length checks precede
+		 * every field read here. Each new debit remains a real debit.
+		 */
+		if ((cid == 0x07 && (payload[0] || payload[1] || payload[11] || payload[13])) ||
+		    (cid == 0x14 && (payload[0] || payload[1] != 1 || payload[2] || payload[3])) ||
+		    (cid == 0x1c && (!payload[1] || payload[2] != 1)) ||
+		    (cid != 0x07 && cid != 0x14 && cid != 0x17 && cid != 0x1c))
+			return -EOPNOTSUPP;
+		if (!mt6797_normal_cleanup_ready(t))
+			return -EBUSY;
+	}
+	if (!t->cleanup_retained_pages && t->tc4_free != t->tc4_limit)
+		return -EBUSY;
+	error = mt6797_normal_encode(t, cid, 1, sequence, payload, bytes,
+				     8 + bytes, MT6797_NORMAL_CONFIG_TX,
+				     output, capacity, command);
+	if (!error)
+		t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	return error;
+}
+
+/* One retired deauthentication may still own one TC4 page. No refund, quota
+ * change or ordinary command admission: only the first PM abort may use the
+ * remaining pool, and the caller must await the whole ledger before advancing.
+ */
+static inline bool
+mt6797_join_cleanup_abort_ready(const struct mt6797_normal_transaction *t,
+				unsigned int deauth_pages)
+{
+	return t && deauth_pages == 1 &&
+		t->phase == MT6797_NORMAL_NVRAM_SUBMITTED && t->used_sequences &&
+		t->tc4_limit > 1 && t->tc4_limit <= 0xffffU &&
+		t->tc4_free == t->tc4_limit - 1 &&
+		t->tc4_pending_cpu <= 1 && t->tc4_pending_ffa <= 1 &&
+		t->tc1_free == t->tc1_limit && !t->tc1_pending;
+}
+
+static inline int
+mt6797_join_prepare_cleanup_abort(struct mt6797_normal_transaction *t,
+				  unsigned int sequence, unsigned int deauth_pages,
+				  unsigned char *output,
+				  size_t capacity, struct mt6797_hif_command *command)
+{
+	const unsigned char payload[4] = {0};
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!sequence || sequence > 255 || !output || !command ||
+	    !mt6797_join_cleanup_abort_ready(t, deauth_pages))
+		return -EBUSY;
+	error = mt6797_normal_encode(t, 0x17, 1, sequence, payload, sizeof(payload),
+				     12, MT6797_NORMAL_CONFIG_TX, output, capacity, command);
+	if (!error)
+		t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	return error;
+}
+
+#define MT6797_HIF_MAX_NS 1000000000ULL
+#define MT6797_HIF_MAX_SECTION (1024U * 1024U)
+#define MT6797_RX_SW_MASK 0xe00fU
+#define MT6797_RX_SW_EVENT 0xe000U
+#define MT6797_RX_SW_FRAME 0xe001U
+#define MT6797_RX_DATA_TYPE 2U
+
+/* Receive batching (0268): one queue's aggregate of sixteen maximum frames,
+ * rounded up to the 512-byte blocks a transfer of 512 bytes or more moves
+ * (mt6797_hif_transfer_size), and the enhanced status block. Without the
+ * rounding an aggregate above 37,376 bytes is refused as -EMSGSIZE, which
+ * the caller treats as a bus failure (boot AA5) (0307).
+ */
+#define MT6797_HIF_RX_BATCH_QUEUE_BYTES \
+	ALIGN(16U * ALIGN(MT6797_HIF_RX_MAX_PACKET + 4U, 4), 512)
+#define MT6797_HIF_RX_BATCH_BLOCK_BYTES	112U
+
+struct mt6797_hif {
+	void __iomem *base;
+	/* Serializes this context, transaction and scratch; never external owners. */
+	struct mutex mutex;
+	struct mt6797_init_transaction *transaction;
+	struct mt6797_normal_transaction normal;
+	struct mt6797_hif_pio_io io;
+	u64 deadline_ns;
+	u64 start_deadline_ns;
+	bool start_attempted;
+	bool firmware_ready;
+	bool capability_attempted;
+	bool capability_complete;
+	bool tx_status_boot_attempted;
+	bool tx_status_normal_attempted;
+	bool tx_status_accounting_baseline;
+	int first_error;
+	/* AP-DMA channel 0 for the data ports (mt6797_hif_attach_dma); NULL
+	 * window means PIO. The bounce buffer is coherent and below 4 GiB.
+	 */
+	void __iomem *dma;
+	phys_addr_t dma_fifo;
+	struct device *dma_dev;
+	struct clk *dma_clk;
+	void *dma_buffer;
+	dma_addr_t dma_phys;
+	size_t dma_buffer_bytes;
+	bool dma_addr2;
+	u8 scratch[2560];
+	bool data_bw40;	/* under the mutex (0324) */
+	/* Receive batching (0268): the enhanced status block read once per
+	 * worker pass, the aggregated data-port read per queue it names, and
+	 * the frames served from that cache without per-frame register work.
+	 */
+	bool rx_batch_enabled, rx_batch_on, rx_batch_refill;
+	unsigned int rx_batch_reads, rx_batch_failures;
+	unsigned int rx_batch_count, rx_batch_next;
+	/* The TX release counts the block carried (the vendor's rTxInfo). In
+	 * enhanced mode the block read consumes WHISR and the queue counts, so
+	 * they are merged into the next TX status acquisition instead of being
+	 * lost; the credit path is otherwise unchanged.
+	 */
+	u32 rx_batch_pending_wtqcr[8];
+	u32 rx_batch_block_whisr, rx_batch_block_abnormal;
+	unsigned int rx_batch_credit_blocks;
+	/* The first refused aggregate read, for the record (0311). */
+	int rx_batch_refused_error;
+	unsigned int rx_batch_refused_queue, rx_batch_refused_frames;
+	unsigned int rx_batch_refused_bytes, rx_batch_refused_read;
+	unsigned int rx_batch_refused_first_length;
+	/* Two queues of up to sixteen frames each, as the block reports them. */
+	struct {
+		u8 port;
+		u16 length;
+		u32 offset;
+	} rx_batch_frame[32];
+
+	u8 rx_batch_block[MT6797_HIF_RX_BATCH_BLOCK_BYTES];
+	u8 *rx_batch_agg;
+};
+
+/* AP-DMA HIF channel 0 registers (window offsets) and fields, as the vendor
+ * driver programs them: CON burst 4/4, bus-increment, direction (1 = read
+ * from the FIFO), fixed addressing off; INT_FLAG/INT_EN bit 0; EN bit 0;
+ * SRC/DST_ADDR2 bit 0 the address-extension bit.
+ */
+#define MT6797_APDMA_INT_FLAG	0x00
+#define MT6797_APDMA_INT_EN	0x04
+#define MT6797_APDMA_EN		0x08
+#define MT6797_APDMA_CON	0x18
+#define MT6797_APDMA_SRC	0x1c
+#define MT6797_APDMA_DST	0x20
+#define MT6797_APDMA_LEN	0x24
+#define MT6797_APDMA_SRC2	0x54
+#define MT6797_APDMA_DST2	0x58
+#define MT6797_APDMA_CON_DIR		BIT(0)
+#define MT6797_APDMA_CON_FIX		BIT(1)
+#define MT6797_APDMA_CON_BURST		GENMASK(17, 16)
+#define MT6797_APDMA_CON_BURST_4_4	(3U << 16)
+#define MT6797_APDMA_CON_INCR		BIT(31)
+#define MT6797_APDMA_LEN_MASK		GENMASK(19, 0)
+/* One receive queue's aggregate (sixteen frames of the maximum length, each
+ * with its four staged bytes, rounded to the 512-byte block) must fit.
+ */
+#define MT6797_APDMA_BUFFER_BYTES	40960U
+#define MT6797_APDMA_POLL_LIMIT		200000U
+
+/* Register access to the channel window. */
+static inline u32 mt6797_hif_dma_rd(struct mt6797_hif *hif, unsigned int offset)
+{
+	return readl(hif->dma + offset);
+}
+
+static inline void mt6797_hif_dma_wr(struct mt6797_hif *hif, unsigned int offset, u32 value)
+{
+	writel(value, hif->dma + offset);
+}
+
+static int mt6797_hif_fail(struct mt6797_hif *hif, int error)
+{
+	if (!hif->first_error)
+		hif->first_error = error;
+	mt6797_init_abort(hif->transaction);
+	if (hif->normal.phase != MT6797_NORMAL_COLD)
+		mt6797_normal_abort(&hif->normal);
+	return hif->first_error;
+}
+
+static int mt6797_hif_guard(struct mt6797_hif *hif)
+{
+	if (hif->first_error)
+		return hif->first_error;
+	if (ktime_get_ns() >= hif->deadline_ns)
+		return mt6797_hif_fail(hif, -ETIMEDOUT);
+	return 0;
+}
+
+/* Ordered kernel MMIO cannot report a recoverable bus exception: zero means
+ * only the accessor returned.
+ */
+static int mt6797_hif_write(void *context, unsigned int offset,
+			    unsigned int value)
+{
+	struct mt6797_hif *hif = context;
+	int error;
+
+	if (offset != 0 && offset != 0x1000)
+		return mt6797_hif_fail(hif, -EINVAL);
+	error = mt6797_hif_guard(hif);
+	if (error)
+		return error;
+	writel(value, (u8 __iomem *)hif->base + offset);
+	return mt6797_hif_guard(hif);
+}
+
+static int mt6797_hif_read(void *context, unsigned int offset,
+			   unsigned int *value)
+{
+	struct mt6797_hif *hif = context;
+	int error;
+	u32 data;
+
+	if (!value || offset != 0x1000)
+		return mt6797_hif_fail(hif, -EINVAL);
+	error = mt6797_hif_guard(hif);
+	if (error)
+		return error;
+	data = readl((u8 __iomem *)hif->base + offset);
+	error = mt6797_hif_guard(hif);
+	if (!error)
+		*value = data;
+	return error;
+}
+
+struct mt6797_hif *mt6797_hif_alloc(void __iomem *base, size_t span,
+				    struct mt6797_init_transaction *transaction)
+{
+	struct mt6797_hif *hif;
+
+	if (!base || span < 0x1004 || !IS_ALIGNED((unsigned long)base, 4) ||
+	    !transaction)
+		return ERR_PTR(-EINVAL);
+	hif = kzalloc_obj(*hif, GFP_KERNEL);
+	if (!hif)
+		return ERR_PTR(-ENOMEM);
+	hif->rx_batch_agg = kzalloc(2U * MT6797_HIF_RX_BATCH_QUEUE_BYTES, GFP_KERNEL);
+	if (!hif->rx_batch_agg) {
+		kfree(hif);
+		return ERR_PTR(-ENOMEM);
+	}
+	hif->base = base;
+	hif->transaction = transaction;
+	hif->io = (struct mt6797_hif_pio_io){
+		.context = hif,
+		.write = mt6797_hif_write,
+		.read = mt6797_hif_read,
+	};
+	mutex_init(&hif->mutex);
+	return hif;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_alloc);
+
+void mt6797_hif_free(struct mt6797_hif *hif)
+{
+	if (hif && hif->dma) {
+		dma_free_coherent(hif->dma_dev, hif->dma_buffer_bytes, hif->dma_buffer,
+				  hif->dma_phys);
+		clk_disable_unprepare(hif->dma_clk);
+	}
+	if (hif)
+		kfree(hif->rx_batch_agg);
+	kfree(hif);
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_free);
+
+int mt6797_hif_attach_dma(struct mt6797_hif *hif, void __iomem *window,
+			  phys_addr_t fifo, struct device *dev, struct clk *clk,
+			  bool addr2)
+{
+	int error;
+
+	if (!hif || !window || !dev || !clk || hif->dma)
+		return -EINVAL;
+	/* The vendor's working configuration mapped host buffers below 4 GiB. */
+	error = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (error)
+		return error;
+	error = clk_prepare_enable(clk);
+	if (error)
+		return error;
+	hif->dma_buffer = dma_alloc_coherent(dev, MT6797_APDMA_BUFFER_BYTES,
+					     &hif->dma_phys, GFP_KERNEL);
+	if (!hif->dma_buffer) {
+		clk_disable_unprepare(clk);
+		return -ENOMEM;
+	}
+	if (upper_32_bits(hif->dma_phys) || upper_32_bits(fifo)) {
+		dma_free_coherent(dev, MT6797_APDMA_BUFFER_BYTES, hif->dma_buffer,
+				  hif->dma_phys);
+		clk_disable_unprepare(clk);
+		return -ERANGE;
+	}
+	hif->dma_buffer_bytes = MT6797_APDMA_BUFFER_BYTES;
+	hif->dma_dev = dev;
+	hif->dma_clk = clk;
+	hif->dma_fifo = fifo;
+	hif->dma_addr2 = addr2;
+	hif->dma = window;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_attach_dma);
+
+/* One data-port transfer through AP-DMA channel 0, vendor sequence: the
+ * CMD53 setup word on the window, then CON/SRC/DST/LEN, the extension bits,
+ * interrupt enable and EN; completion is the channel's own flag, polled
+ * under the context deadline, then acknowledged, the interrupt masked and
+ * EN seen clear. Payload moves through the coherent bounce buffer. Any
+ * timeout poisons the context like a PIO fault; nothing is retried.
+ */
+static int mt6797_hif_dma_transfer(struct mt6797_hif *hif, unsigned int port,
+				   enum mt6797_hif_direction direction,
+				   unsigned char *buffer, size_t payload_bytes,
+				   size_t capacity,
+				   struct mt6797_hif_pio_result *result)
+{
+	struct mt6797_hif_command command;
+	unsigned int polls = 0;
+	u32 con, flag, en;
+	int error;
+
+	*result = (struct mt6797_hif_pio_result){0};
+	error = mt6797_hif_encode_command(port, direction, MT6797_HIF_DMA_ENABLED,
+					  payload_bytes,
+					  min(capacity, hif->dma_buffer_bytes), &command);
+	if (error)
+		return error;
+	if (direction == MT6797_HIF_WRITE) {
+		memcpy(hif->dma_buffer, buffer, payload_bytes);
+		memset((u8 *)hif->dma_buffer + payload_bytes, 0,
+		       command.transfer_bytes - payload_bytes);
+	}
+	dma_wmb();
+	if (hif->io.write(hif->io.context, 0, command.word))
+		return -EIO;
+	result->setup_submitted = true;
+	con = mt6797_hif_dma_rd(hif, MT6797_APDMA_CON);
+	con &= ~(MT6797_APDMA_CON_BURST | MT6797_APDMA_CON_FIX | MT6797_APDMA_CON_DIR);
+	con |= MT6797_APDMA_CON_BURST_4_4 | MT6797_APDMA_CON_INCR |
+	       (direction == MT6797_HIF_READ ? MT6797_APDMA_CON_DIR : 0);
+	mt6797_hif_dma_wr(hif, MT6797_APDMA_CON, con);
+	if (direction == MT6797_HIF_READ) {
+		mt6797_hif_dma_wr(hif, MT6797_APDMA_SRC, lower_32_bits(hif->dma_fifo));
+		mt6797_hif_dma_wr(hif, MT6797_APDMA_DST, lower_32_bits(hif->dma_phys));
+	} else {
+		mt6797_hif_dma_wr(hif, MT6797_APDMA_SRC, lower_32_bits(hif->dma_phys));
+		mt6797_hif_dma_wr(hif, MT6797_APDMA_DST, lower_32_bits(hif->dma_fifo));
+	}
+	mt6797_hif_dma_wr(hif, MT6797_APDMA_LEN, command.transfer_bytes & MT6797_APDMA_LEN_MASK);
+	if (hif->dma_addr2) {
+		mt6797_hif_dma_wr(hif, MT6797_APDMA_SRC2,
+				  mt6797_hif_dma_rd(hif, MT6797_APDMA_SRC2) | BIT(0));
+		mt6797_hif_dma_wr(hif, MT6797_APDMA_DST2,
+				  mt6797_hif_dma_rd(hif, MT6797_APDMA_DST2) | BIT(0));
+	}
+	mt6797_hif_dma_wr(hif, MT6797_APDMA_INT_EN,
+			  mt6797_hif_dma_rd(hif, MT6797_APDMA_INT_EN) | BIT(0));
+	mt6797_hif_dma_wr(hif, MT6797_APDMA_EN, mt6797_hif_dma_rd(hif, MT6797_APDMA_EN) | BIT(0));
+	for (;;) {
+		flag = mt6797_hif_dma_rd(hif, MT6797_APDMA_INT_FLAG);
+		if (flag & BIT(0))
+			break;
+		if (++polls > MT6797_APDMA_POLL_LIMIT ||
+		    ktime_get_ns() >= hif->deadline_ns) {
+			mt6797_hif_dma_wr(hif, MT6797_APDMA_INT_EN,
+					  mt6797_hif_dma_rd(hif, MT6797_APDMA_INT_EN) & ~BIT(0));
+			return -ETIMEDOUT;
+		}
+		cpu_relax();
+	}
+	mt6797_hif_dma_wr(hif, MT6797_APDMA_INT_FLAG, flag & ~BIT(0));
+	mt6797_hif_dma_wr(hif, MT6797_APDMA_INT_EN,
+			  mt6797_hif_dma_rd(hif, MT6797_APDMA_INT_EN) & ~BIT(0));
+	for (polls = 0;; polls++) {
+		en = mt6797_hif_dma_rd(hif, MT6797_APDMA_EN);
+		if (!(en & BIT(0)))
+			break;
+		if (polls > MT6797_APDMA_POLL_LIMIT)
+			return -ETIMEDOUT;
+		cpu_relax();
+	}
+	dma_rmb();
+	if (direction == MT6797_HIF_READ) {
+		if (command.transfer_bytes > capacity)
+			return -ENOSPC;
+		memcpy(buffer, hif->dma_buffer, command.transfer_bytes);
+	}
+	result->data_bytes = command.transfer_bytes;
+	result->transfer_complete = true;
+	return 0;
+}
+
+/* The data-port transfer: DMA where attached, built for the direction and
+ * large enough to be worth it; the PIO encoder otherwise.
+ */
+static int mt6797_hif_data_transfer(struct mt6797_hif *hif, unsigned int port,
+				    enum mt6797_hif_direction direction,
+				    unsigned char *buffer, size_t payload_bytes,
+				    size_t capacity,
+				    struct mt6797_hif_pio_result *result)
+{
+	bool admitted = direction == MT6797_HIF_READ ?
+		1 : 1;
+
+	if (hif->dma && admitted && payload_bytes >= MT6797_HIF_DMA_MIN_BYTES)
+		return mt6797_hif_dma_transfer(hif, port, direction, buffer,
+					       payload_bytes, capacity, result);
+	return mt6797_hif_pio_transfer(&hif->io, port, direction, buffer,
+				       payload_bytes, capacity, result);
+}
+
+/* Called with the mutex held; busy callers refuse without waiting/retrying. */
+static int mt6797_hif_enter(struct mt6797_hif *hif, u64 deadline_ns)
+{
+	u64 now = ktime_get_ns();
+
+	hif->first_error = 0;
+	hif->deadline_ns = deadline_ns;
+	if (hif->start_attempted && !hif->firmware_ready &&
+	    deadline_ns > hif->start_deadline_ns)
+		return mt6797_hif_fail(hif, -EINVAL);
+	if (hif->transaction->phase != MT6797_INIT_IDLE &&
+	    hif->transaction->phase != MT6797_START_READY)
+		return mt6797_hif_fail(hif, -EIO);
+	if (hif->transaction->free_pages > 104 ||
+	    hif->transaction->start_free_pages > 104)
+		return mt6797_hif_fail(hif, -EINVAL);
+	if (deadline_ns <= now)
+		return mt6797_hif_fail(hif, -ETIMEDOUT);
+	if (deadline_ns - now > MT6797_HIF_MAX_NS)
+		return mt6797_hif_fail(hif, -EINVAL);
+	return 0;
+}
+
+static int mt6797_hif_read32_locked(struct mt6797_hif *hif, unsigned int reg,
+				    u32 *value)
+{
+	int error;
+
+	/* Function 1, READ, byte mode, fixed port, four bytes. Logical register
+	 * numbers are encoded here, never added directly to the MMIO mapping.
+	 */
+	error = mt6797_hif_write(hif, 0, (1U << 28) | (reg << 9) | 4U);
+	if (error)
+		return error;
+	return mt6797_hif_read(hif, 0x1000, value);
+}
+
+/* The enhanced status block (the vendor's ENHANCE_MODE_DATA_STRUCT_T): WHISR,
+ * sixteen TX queue counts, the two receive queues' packet counts and up to
+ * sixteen lengths each, two mailboxes; 112 bytes as one byte-mode read of
+ * the WHISR register.
+ */
+static int mt6797_hif_rx_batch_block(struct mt6797_hif *hif)
+{
+	unsigned int offset, word;
+	int error;
+
+	error = mt6797_hif_write(hif, 0, (1U << 28) | (0x10U << 9) |
+				 MT6797_HIF_RX_BATCH_BLOCK_BYTES);
+	if (error)
+		return error;
+	for (offset = 0; offset < MT6797_HIF_RX_BATCH_BLOCK_BYTES; offset += 4) {
+		error = mt6797_hif_read(hif, 0x1000, &word);
+		if (error)
+			return error;
+		put_unaligned_le32(word, hif->rx_batch_block + offset);
+	}
+	hif->rx_batch_reads++;
+	return 0;
+}
+
+/* The vendor's SDIO init (nicSDIOInit, nic.c) programs WHCR with the
+ * reported-length count 0 ("unlimited", up to the block's sixteen) and
+ * RX_ENHANCE_MODE_EN (bit 16) clear: its build has the interrupt
+ * enhancement (the 112-byte status read) and not the RX enhancement, in
+ * which every receive-port read carries a status block after the frames.
+ * The firmware's default WHCR is that configuration already, so nothing
+ * is written: the mode is confirmed by reading, and refused if bit 16 is
+ * set or the count field is outside the vendor's 0–15.
+ */
+static int mt6797_hif_rx_batch_enable(struct mt6797_hif *hif)
+{
+	u32 whcr;
+	int error;
+
+	error = mt6797_hif_read32_locked(hif, 0x0c, &whcr);
+	if (error)
+		return error;
+	hif->rx_batch_enabled = true;
+	hif->rx_batch_on = !(whcr & BIT(16)) && ((whcr >> 8) & 0x3fU) <= 15U;
+	return hif->rx_batch_on ? 0 : -EIO;
+}
+
+/* Two sixteen-bit counts in one word (the WTQCR layout), added half by half. */
+static u32 mt6797_hif_add16x2(u32 a, u32 b)
+{
+	u32 lo = (a & 0xffffU) + (b & 0xffffU), hi = (a >> 16) + (b >> 16);
+
+	return min_t(u32, lo, 0xffffU) | (min_t(u32, hi, 0xffffU) << 16);
+}
+
+static unsigned int mt6797_hif_rx_batch_length(const struct mt6797_hif *hif,
+					       unsigned int queue, unsigned int i)
+{
+	return get_unaligned_le16(hif->rx_batch_block + 40 + 32 * queue + 2 * i);
+}
+
+/* One pass's receive work: the block, then per non-empty queue one
+ * aggregated read of every reported frame (each frame occupies its length
+ * plus the four staged bytes, rounded to four), split by the reported
+ * lengths with the same header check the per-frame path applies.
+ *
+ * Only a bus failure (the setup word or a data-port read) is returned, and
+ * the caller poisons the context for it. What the block says is advisory:
+ * a count above sixteen is served as sixteen and the rest drains next
+ * pass; a length the block reports outside the frame bounds leaves that
+ * queue unread this pass; a header that disagrees with its reported length
+ * after the aggregate has been transferred drops that aggregate (its frames
+ * are lost and the transport retransmits them). Each is counted in
+ * failures and none poisons receive for the rest of the boot.
+ */
+static int mt6797_hif_rx_batch_fill(struct mt6797_hif *hif)
+{
+	struct mt6797_hif_pio_result transfer;
+	unsigned int queue, i, n, count = 0, first;
+	bool credited = false;
+	size_t total, offset;
+	int error;
+	u32 whisr;
+
+	/* WHISR alone first (0322): its done bits are read-only and
+	 * follow what is waiting, so a zero word means the block would
+	 * report nothing. Its abnormal and assert bits are checked here,
+	 * since the read may consume them before the block's.
+	 */
+	error = mt6797_hif_read32_locked(hif, 0x10, &whisr);
+	if (error)
+		return error;
+	if (whisr & (BIT(6) | BIT(31))) {
+		hif->rx_batch_block_whisr = whisr;
+		hif->rx_batch_block_abnormal = whisr;
+		return -EIO;
+	}
+	if (!whisr) {
+		hif->rx_batch_count = 0;
+		hif->rx_batch_next = 0;
+		return 0;
+	}
+	error = mt6797_hif_rx_batch_block(hif);
+	if (error)
+		return error;
+	/* In this mode the block is the single owner of WHISR: consumers derive
+	 * from it (the TX credits from the counts, below), they never copy its
+	 * edge bits into a polled acquisition. The abnormal (bit 6) and
+	 * firmware-assert (bit 31) edges are the exception the vendor also
+	 * makes: it resets the chip on either, from whichever read carried it,
+	 * so here they are recorded with the word and fail the HIF.
+	 */
+	hif->rx_batch_block_whisr = get_unaligned_le32(hif->rx_batch_block);
+	if (hif->rx_batch_block_whisr & (BIT(6) | BIT(31))) {
+		hif->rx_batch_block_abnormal = hif->rx_batch_block_whisr;
+		return -EIO;
+	}
+	for (i = 0; i < 8; i++) {
+		u32 word = get_unaligned_le32(hif->rx_batch_block + 4 + 4 * i);
+
+		if (!word)
+			continue;
+		hif->rx_batch_pending_wtqcr[i] =
+			mt6797_hif_add16x2(hif->rx_batch_pending_wtqcr[i], word);
+		credited = true;
+	}
+	if (credited)
+		hif->rx_batch_credit_blocks++;
+	hif->rx_batch_count = 0;
+	hif->rx_batch_next = 0;
+	for (queue = 0; queue < 2; queue++) {
+		u8 *agg = hif->rx_batch_agg + queue * MT6797_HIF_RX_BATCH_QUEUE_BYTES;
+
+		n = get_unaligned_le16(hif->rx_batch_block + 36 + 2 * queue);
+		if (!n)
+			continue;
+		if (n > 16) {
+			hif->rx_batch_failures++;
+			n = 16;
+		}
+		total = 0;
+		for (i = 0; i < n; i++) {
+			unsigned int length = mt6797_hif_rx_batch_length(hif, queue, i);
+
+			if (length < 4 || length > MT6797_HIF_RX_MAX_PACKET)
+				break;
+			total += ALIGN(length + 4U, 4);
+		}
+		if (i < n) {
+			hif->rx_batch_failures++;
+			continue;
+		}
+		error = mt6797_hif_data_transfer(hif, queue ? 0x54 : 0x50,
+						 MT6797_HIF_READ, agg, total,
+						 MT6797_HIF_RX_BATCH_QUEUE_BYTES,
+						 &transfer);
+		if (error) {
+			if (!hif->rx_batch_refused_error) {
+				hif->rx_batch_refused_error = error;
+				hif->rx_batch_refused_queue = queue;
+				hif->rx_batch_refused_frames = n;
+				hif->rx_batch_refused_bytes = total;
+				hif->rx_batch_refused_read = hif->rx_batch_reads;
+				hif->rx_batch_refused_first_length =
+					mt6797_hif_rx_batch_length(hif, queue, 0);
+			}
+			return error;
+		}
+		first = count;
+		offset = 0;
+		for (i = 0; i < n; i++) {
+			unsigned int length = mt6797_hif_rx_batch_length(hif, queue, i);
+
+			if (mt6797_normal_le16(agg + offset) != length) {
+				hif->rx_batch_failures++;
+				count = first;
+				break;
+			}
+			hif->rx_batch_frame[count].port = queue;
+			hif->rx_batch_frame[count].length = length;
+			hif->rx_batch_frame[count].offset =
+				queue * MT6797_HIF_RX_BATCH_QUEUE_BYTES + offset;
+			count++;
+			offset += ALIGN(length + 4U, 4);
+		}
+	}
+	hif->rx_batch_count = count;
+	return 0;
+}
+
+/* Called once per worker pass: the next receive may read the block again. */
+void mt6797_hif_rx_batch_pass(struct mt6797_hif *hif)
+{
+	if (hif)
+		hif->rx_batch_refill = true;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_rx_batch_pass);
+
+void mt6797_hif_rx_batch_stats(const struct mt6797_hif *hif,
+			       struct mt6797_hif_rx_batch_stats *stats)
+{
+	*stats = (struct mt6797_hif_rx_batch_stats){0};
+	if (!hif)
+		return;
+	stats->failures = hif->rx_batch_failures;
+	stats->credit_blocks = hif->rx_batch_credit_blocks;
+	stats->block_whisr = hif->rx_batch_block_whisr;
+	stats->block_abnormal = hif->rx_batch_block_abnormal;
+	stats->pending_wtqcr0 = hif->rx_batch_pending_wtqcr[0];
+	stats->pending_wtqcr7 = hif->rx_batch_pending_wtqcr[7];
+	stats->error = hif->first_error;
+	stats->refused_error = hif->rx_batch_refused_error;
+	stats->refused_queue = hif->rx_batch_refused_queue;
+	stats->refused_frames = hif->rx_batch_refused_frames;
+	stats->refused_bytes = hif->rx_batch_refused_bytes;
+	stats->refused_read = hif->rx_batch_refused_read;
+	stats->refused_first_length = hif->rx_batch_refused_first_length;
+	stats->refused_capacity = MT6797_HIF_RX_BATCH_QUEUE_BYTES;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_rx_batch_stats);
+
+int mt6797_hif_read32(struct mt6797_hif *hif, unsigned int reg, u64 deadline_ns,
+		      u32 *value)
+{
+	int error;
+
+	if (!value)
+		return -EINVAL;
+	*value = 0;
+	if (!hif || (reg != 0 && reg != 4 && reg != 0x90 && reg != 0x20 &&
+		     reg != 0xe0))
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (reg == 0x20 || reg == 0xe0) {
+		/* WASR/WASR2, the abnormal status (read by the vendor's abnormal
+		 * handler): a record on the failure path, past the guard, so a
+		 * poisoned context can still be described.
+		 */
+		error = mt6797_hif_read32_locked(hif, reg, value);
+		mutex_unlock(&hif->mutex);
+		return error;
+	}
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (!error)
+		error = mt6797_hif_read32_locked(hif, reg, value);
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_read32);
+
+int
+mt6797_hif_download_section(struct mt6797_hif *hif,
+			    const struct mt6797_hif_section_request *request,
+			    u64 deadline_ns, struct mt6797_hif_section_result *result)
+{
+	struct mt6797_ordinary_section section = {0};
+	u32 lengths;
+	int error;
+
+	if (!result)
+		return -EINVAL;
+	*result = (struct mt6797_hif_section_result){0};
+	if (!hif || !request || request->kind != MT6797_SECTION_ORDINARY ||
+	    !request->data || !request->length ||
+	    request->length > MT6797_HIF_MAX_SECTION)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (hif->start_attempted) {
+		error = -EIO;
+		goto out;
+	}
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto out;
+	error = mt6797_section_begin(&section, hif->transaction, &hif->io,
+				     request->kind, request->config,
+				     request->config_bytes, request->sequence,
+				     request->data, request->length);
+	if (error)
+		goto out;
+	for (;;) {
+		error = mt6797_hif_read32_locked(hif, 0x90, &lengths);
+		if (error)
+			goto out;
+		if (lengths & 0xffffU)
+			break;
+		/* The next scalar guard rechecks the same absolute deadline.
+		 * No sleep or software deadline can interrupt a stuck MMIO access.
+		 */
+		usleep_range(50, 100);
+	}
+	error = mt6797_section_ack(&section, &hif->io, lengths & 0xffffU,
+				   &result->firmware_status);
+	while (!error && section.phase == MT6797_SECTION_PAYLOAD) {
+		error = mt6797_hif_guard(hif);
+		if (!error)
+			error = mt6797_section_next(&section, &hif->io,
+						    hif->scratch,
+						    sizeof(hif->scratch));
+	}
+out:
+	result->submitted = section.submitted;
+	if (error)
+		error = mt6797_hif_fail(hif, error);
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+
+int mt6797_hif_start_submit(struct mt6797_hif *hif, const u8 *command,
+			    size_t bytes, unsigned int sequence, u64 deadline_ns)
+{
+	struct mt6797_hif_pio_result result;
+	unsigned int i;
+	int error;
+
+	if (!hif)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (hif->start_attempted) {
+		error = -EIO;
+		goto out;
+	}
+	hif->start_attempted = true;
+	hif->start_deadline_ns = deadline_ns;
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto out;
+	error = mt6797_start_begin(hif->transaction, command, bytes, sequence);
+	if (error)
+		goto out;
+	/* The frozen validator proved exactly 16 immutable command bytes. */
+	for (i = 0; i < 16; i++)
+		hif->scratch[i] = command[i];
+	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
+					hif->scratch, 16, sizeof(hif->scratch),
+					&result);
+	error = mt6797_start_submitted(hif->transaction, error);
+	if (!error)
+		error = mt6797_hif_guard(hif);
+out:
+	if (error)
+		error = mt6797_hif_fail(hif, error);
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_start_submit);
+
+int mt6797_hif_start_observe_ready(struct mt6797_hif *hif, u32 *wcir)
+{
+	int error;
+
+	if (!wcir)
+		return -EINVAL;
+	*wcir = 0;
+	if (!hif)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->start_attempted || hif->firmware_ready ||
+	    hif->transaction->phase != MT6797_START_READY) {
+		error = -EIO;
+		goto out;
+	}
+	error = mt6797_hif_enter(hif, hif->start_deadline_ns);
+	if (error)
+		goto out;
+	error = mt6797_hif_read32_locked(hif, 0, wcir);
+	if (!error)
+		error = mt6797_hif_guard(hif);
+	if (!error)
+		error = mt6797_start_observe_ready(hif->transaction, *wcir);
+	if (!error)
+		hif->firmware_ready = true;
+out:
+	if (error && (error != -EAGAIN || hif->first_error)) {
+		*wcir = 0;
+		error = mt6797_hif_fail(hif, error);
+		/* EAGAIN is reserved for a valid pending WCIR observation. */
+		if (error == -EAGAIN)
+			error = -EIO;
+	}
+	mutex_unlock(&hif->mutex);
+	return error;
+}
+EXPORT_SYMBOL_GPL(mt6797_hif_start_observe_ready);
+
+static int mt6797_hif_tx_status(struct mt6797_hif *hif, u64 deadline_ns,
+				unsigned int count,
+				struct mt6797_hif_tx_status *status,
+				struct mt6797_normal_release *account, bool runtime)
+{
+	struct mt6797_normal_transaction reconciled;
+	unsigned int n, i;
+	int error;
+
+	if (!status || !count || count > 2)
+		return -EINVAL;
+	memset(status, 0, count * sizeof(*status));
+	if (account)
+		memset(account, 0, count * sizeof(*account));
+	if (!hif)
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (!hif->firmware_ready ||
+	    hif->transaction->phase != MT6797_INIT_IDLE) {
+		error = -EIO;
+		goto unlock;
+	}
+	if (runtime) {
+		/* A mature accounting owner, never an observation-only baseline.
+		 * Every call consumes a new snapshot under the retained HIF lock.
+		 */
+		if (count != 1 || !account ||
+		    !hif->tx_status_accounting_baseline ||
+		    !hif->tx_status_normal_attempted || !hif->capability_complete ||
+		    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
+			error = -EIO;
+			goto unlock;
+		}
+	} else if (count == 1 && hif->normal.phase == MT6797_NORMAL_COLD &&
+	    !hif->capability_attempted && !hif->tx_status_boot_attempted) {
+		hif->tx_status_boot_attempted = true;
+	} else if (count == 2 &&
+		   hif->normal.phase == MT6797_NORMAL_NVRAM_SUBMITTED &&
+		   hif->tx_status_boot_attempted && hif->capability_complete &&
+		   !hif->tx_status_normal_attempted) {
+		hif->tx_status_normal_attempted = true;
+		if (account && !hif->tx_status_accounting_baseline) {
+			error = -EIO;
+			goto poison;
+		}
+	} else {
+		error = -EIO;
+		goto unlock;
+	}
+	error = mt6797_hif_enter(hif, deadline_ns);
+	if (error)
+		goto poison;
+	reconciled = hif->normal;
+	/* Keep both post-record acquisitions in one serialization window. A
+	 * regulatory notifier cannot submit a command between these reads.
+	 */
+	for (n = 0; n < count; n++) {
+		error = mt6797_hif_read32_locked(hif, 0x0c, &status[n].whcr);
+		if (error)
+			goto poison;
+		status[n].valid_words |= 1U;
+		error = mt6797_hif_read32_locked(hif, 0x10, &status[n].whisr);
+		if (error)
+			goto poison;
+		status[n].valid_words |= 2U;
+		/* Pinned WHISR: abnormal status bit 6, firmware assert bit 31.
+		 * Do not proceed to another read or command after either signal.
+		 */
+		if (status[n].whisr & ((1U << 6) | (1U << 31))) {
+			error = -EIO;
+			goto poison;
+		}
+		for (i = 0; i < 8; i++) {
+			error = mt6797_hif_read32_locked(hif, 0x130 + 4 * i,
+							 &status[n].wtqcr[i]);
+			if (error)
+				goto poison;
+			status[n].valid_words |= 1U << (i + 2);
+			if (!n) {
+				/* The counts the enhanced block consumed since the
+				 * last acquisition (0268), additive data; the TX-done
+				 * bit they imply is synthesised for the record as the
+				 * vendor does, never copied from the block's WHISR.
+				 */
+				u32 pending = hif->rx_batch_pending_wtqcr[i];
+
+				status[n].wtqcr[i] =
+					mt6797_hif_add16x2(status[n].wtqcr[i], pending);
+				hif->rx_batch_pending_wtqcr[i] = 0;
+				if (pending)
+					status[n].synthesized |= BIT(0);
+			}
+		}
+		if (account && (count == 2 || runtime)) {
+			error = mt6797_normal_reconcile(&reconciled,
+							status[n].wtqcr, &account[n]);
+			if (error)
+				goto poison;
+		}
+	}
+	if (account) {
+		error = mt6797_hif_guard(hif);
+		if (error)
+			goto poison;
+	}
+	if (account && count == 1 && !runtime) {
+		for (i = 0; i < 8; i++) {
+			if (status[0].wtqcr[i]) {
+				error = -EIO;
+				goto poison;
+			}
+		}
+		hif->tx_status_accounting_baseline = true;
+	} else if (account) {
+		/* Commit only after the complete acquisition validates. A bad
+		 * later snapshot cannot leave an earlier partial refund usable.
+		 */
+		hif->normal = reconciled;
+	}
+	goto unlock;
+poison:
+	if (account)
+		memset(account, 0, count * sizeof(*account));
+	error = mt6797_hif_fail(hif, error);
+unlock:
+	mutex_unlock(&hif->mutex);
+	return error;
+}
