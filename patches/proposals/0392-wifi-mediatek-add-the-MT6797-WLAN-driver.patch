+/* Runtime 26 (candidate 25, the group key installed under the station's
+ * declared broadcast WLAN entry) ended at the frame gate, before any data
+ * frame, on a packet of the target's beacon class in a keyed descriptor
+ * variant. Observed (sanitized diagnostic: descriptor bytes 4 to 11, the
+ * group set, the header offset, the first frame-control byte and the
+ * summary's explicit address comparisons): 442 packet bytes (16-byte
+ * descriptor, groups 1 to 3, 378 wire bytes at offset 64), type word 0xee01,
+ * descriptor bytes 08 28 18 04 02 40 04 e0 (broadcast match flag only,
+ * channel 40, native untranslated 24-byte header, BSSID field 1, WLAN index
+ * 2, TID 0, security mode 4, status 0xe004), first frame-control byte 0x80
+ * (management type, Beacon subtype; the flag byte is not in the summary),
+ * receiver not this station, transmitter the target. The receiver address
+ * itself, the BSSID, the flag byte, the sequence and the body were not
+ * retained and none is claimed or read.
+ *
+ * Source meaning (pinned public layout): WLAN index 2 is the broadcast entry
+ * the station record declares and the group key was installed under; the
+ * security mode is that entry's cipher context (CCMP) and status bit 2 is
+ * RX_STATUS_FLAG_CIPHER_MISMATCH, an unprotected frame against a keyed
+ * entry; the ICV-error flag is clear. The join worker skips, without a
+ * record, every beacon or probe response the scan decoder parses, and that
+ * decoder requires security mode 0 and a clean status word; the observed
+ * descriptor fails exactly those two conditions, so it reached the gate.
+ * Whether beacons arrived in earlier runs, or how often, is unobserved. In
+ * the pinned vendor driver a received beacon goes to the scan handler; its
+ * management path drops only ICV errors, and only under the MFP build option;
+ * no further vendor behaviour is claimed.
+ *
+ * This decoder names a narrow class for the caller to skip as it skips the
+ * clear beacons, counted: the observed conditions (type word exactly 0xee01,
+ * match byte exactly 0x08, descriptor bytes 6 to 11 exactly 18 04 <bmc> 40 04
+ * e0 with <bmc> the caller's declared broadcast entry, first frame-control
+ * byte 0x80, transmitter the target) and source-defined conditions the
+ * diagnostic did not carry (frame control exactly 0x0080, that is the flag
+ * byte clear; the broadcast receiver address; the BSSID equal to the target;
+ * fragment 0; at least the 12 fixed body bytes after the header, none read).
+ * A next boot whose frame differs in a source-defined field will refuse it
+ * here as before; nothing is claimed about runtime 26 being resolved until
+ * measured. Probe responses, any other subtype, the unkeyed descriptor,
+ * mixed pairs, the ICV-error flag, other indices and other peers are not
+ * this class. The skip is counted and bounded by the lifetime's packet
+ * budget, as the clear-beacon skip already is; no discard budget changes.
+ */
+bool
+mt6797_join_keyed_beacon(const unsigned char *packet, size_t bytes,
+			 unsigned char channel, const unsigned char ap[6],
+			 unsigned char bmc_index,
+			 struct mt6797_join_action_frame *out)
+{
+	static const unsigned char broadcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct mt6797_join_action_frame r;
+	const size_t offset = 16 + 16 + 8 + 24;
+	const unsigned char *f;
+
+	if (!packet || !ap || !out || bytes < offset + 24 + 12 || bytes > 4096 ||
+	    !channel || mt6797_join_le16(packet) != bytes || packet[5] != channel ||
+	    mt6797_join_le16(packet + 2) != 0xee01)
+		return false;
+	r.match = packet[4];
+	if (r.match != 0x08 || packet[6] != 24 || packet[7] != 0x04 ||
+	    packet[8] != bmc_index || packet[9] != 0x40 ||
+	    mt6797_join_le16(packet + 10) != 0xe004)
+		return false;
+	f = packet + offset;
+	r.fc = mt6797_join_le16(f);
+	if (r.fc != 0x0080 || memcmp(f + 4, broadcast, 6) || memcmp(f + 10, ap, 6) ||
+	    memcmp(f + 16, ap, 6) || (mt6797_join_le16(f + 22) & 15))
+		return false;
+	r.bytes = bytes - offset;
+	r.status = 0xe004;
+	r.wlan = bmc_index;
+	r.bss = packet[7] >> 2;
+	r.sec = 4;
+	/* The RX vector group is present (offset 64); its RCPI byte is read as
+	 * the scan decoder reads it, for the delivered frame's signal only.
+	 */
+	r.rcpi = packet[16 + 16 + 8 + 9];
+	*out = r;
+	return true;
+}
+
+/* Descriptor byte 9 carries the cipher in its high nibble (CCMP, 4) and the
+ * frame's TID in its low nibble (boot P). With WMM a QoS data frame is
+ * admitted on any TID whose QoS control holds only that TID (normal
+ * acknowledgment, no A-MSDU, no EOSP) and agrees with byte 9; a non-QoS
+ * frame, and every frame without WMM, keeps TID 0 and QoS control 0 (0289).
+ */
+static inline bool mt6797_ccmp_rx_tid_ok(const unsigned char *packet, unsigned int fc)
+{
+	unsigned int qos = mt6797_join_le16(packet + 26);
+
+	if ((packet[9] & 0xf0) != 0x40)
+		return false;
+	if (fc & MT6797_CCMP_RX_QOS_BIT)
+		return !(qos & ~0x000fU) && (qos & 15) == (packet[9] & 15U) &&
+		       (qos & 15) < MT6797_CCMP_RX_TIDS;
+	return !qos && !(packet[9] & 15);
+}
+
+/*
+ * Provisional public gen3/mt7603 descriptor contract, not firmware assurance.
+ * Only non-BA, non-QoS, unfragmented CCMP128 unicast with Group4+Group1 is
+ * accepted. Status0xc000 excludes the source-defined errors and aggregation.
+ * Group1 first6 LE PN is converted to mac80211 order and checked strictly
+ * against the frame's own TID's counter (0292).
+ * No flags/delivery/logging/MMIO. False preserves ALL context/output bytes;
+ * true commits only the validated PN and Ethernet view, under caller locking.
+ */
+/* The admitted status words: 0xc000, the non-aggregated shape; and, with
+ * receive aggregation (0319), a block-ack sub-frame as the vendor's
+ * nic_rx.c classifies it, (status & RXS_DW2_AMPDU_nERR_BITMAP 0xffbf) == 0:
+ * every flag clear but LEN_MISMATCH (bit 6), the inverted A-MPDU bits
+ * 14/15 included. Every other check, the strict per-TID PN among them,
+ * applies unchanged.
+ */
+static inline bool mt6797_ccmp_rx_status_ok(unsigned int status)
+{
+	if (!(status & 0xffbf))
+		return true;
+	return status == 0xc000;
+}
+
+static inline bool
+mt6797_ccmp_rx_check(const unsigned char *packet, size_t bytes,
+		     struct mt6797_ccmp_rx_context *context,
+		     struct mt6797_ccmp_rx *out)
+{
+	struct mt6797_ccmp_rx r;
+	unsigned char pn[6];
+	size_t offset = 48; /* base16, mandatory Group4 at16, Group1 at32 */
+	unsigned int groups, fc, i, tid;
+	unsigned char *last;
+	bool greater = false, own_any = false, ap_any = false, source_any = false;
+	const unsigned char *ethernet;
+
+	if (!packet || !context || !out || bytes < 16 || bytes > 2352 ||
+	    !context->authorized || !context->active || !context->seeded ||
+	    !context->pairwise || context->cipher != 0x000fac04U ||
+	    context->key_bytes != 16 || context->key_id ||
+	    context->wlan_index != 1 || context->rxd_bssid > 63 || !context->channel ||
+	    (context->own[0] & 1) || (context->ap[0] & 1))
+		return false;
+	for (i = 0; i < 6; i++) {
+		own_any |= context->own[i] != 0;
+		ap_any |= context->ap[i] != 0;
+	}
+	if (!own_any || !ap_any || mt6797_join_le16(packet) != bytes ||
+	    (mt6797_join_le16(packet + 2) >> 13) != 2 ||
+	    packet[4] != 0x02 || packet[5] != context->channel ||
+	    (packet[6] & 0xbf) != 0x8e ||
+	    packet[7] != (unsigned int)context->rxd_bssid << 2 ||
+	    packet[8] != context->wlan_index || (packet[9] & 0xf0) != 0x40 ||
+	    !mt6797_ccmp_rx_status_ok(mt6797_join_le16(packet + 10)))
+		return false;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if ((groups & 9) != 9)
+		return false;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4)
+		offset += 24;
+	if (packet[6] & 0x40)
+		offset += 2;
+	/* Bounds precede every Group4, Group1 and Ethernet field access. */
+	if (offset > bytes || bytes - offset <= 14)
+		return false;
+	fc = mt6797_join_le16(packet + 16);
+	if ((fc & ~(0x2800U | MT6797_CCMP_RX_QOS_BIT)) != 0x4208 ||
+	    (mt6797_join_le16(packet + 24) & 15) ||
+	    !mt6797_ccmp_rx_tid_ok(packet, fc) || mt6797_join_le32(packet + 28))
+		return false;
+	ethernet = packet + offset;
+	for (i = 0; i < 6; i++) {
+		if (packet[18 + i] != context->ap[i] || ethernet[i] != context->own[i])
+			return false;
+		source_any |= ethernet[6 + i] != 0;
+		pn[i] = packet[32 + 5 - i];
+	}
+	/* Ethernet-II only; EAPOL remains on the existing control-port path. */
+	if (!source_any || (ethernet[6] & 1) ||
+	    (((unsigned int)ethernet[12] << 8) | ethernet[13]) < 0x0600 ||
+	    (ethernet[12] == 0x88 && ethernet[13] == 0x8e))
+		return false;
+	tid = packet[9] & 15;
+	last = tid ? context->tid_pn[tid - 1] : context->pn;
+	for (i = 0; i < 6; i++) {
+		if (pn[i] < last[i])
+			return false;
+		if (pn[i] > last[i]) {
+			greater = true;
+			break;
+		}
+	}
+	if (!greater)
+		return false;
+	r.offset = offset;
+	r.bytes = bytes - offset;
+	for (i = 0; i < 6; i++)
+		last[i] = pn[i];
+	*out = r;
+	return true;
+}
+
+static inline unsigned int mt6797_rx_seq_after(unsigned int from, unsigned int to)
+{
+	return (to - from) & (MT6797_RX_SEQ - 1);
+}
+
+/* On ADDBA, with nothing held. */
+static inline void mt6797_rx_reorder_start(struct mt6797_rx_reorder *r,
+					   unsigned int ssn, unsigned int buffer)
+{
+	if (!buffer || buffer > MT6797_RX_REORDER_BUFFER)
+		buffer = MT6797_RX_REORDER_BUFFER;
+	r->start = ssn & (MT6797_RX_SEQ - 1);
+	r->until = r->start;
+	r->size = buffer + MT6797_RX_REORDER_INC;
+	r->valid = true;
+	r->waiting = true;
+	r->has_bubble = false;
+}
+
+enum mt6797_rx_reorder_place
+mt6797_rx_reorder_place(struct mt6797_rx_reorder *r, unsigned int seq)
+{
+	unsigned int d = mt6797_rx_seq_after(r->start, seq);
+
+	if (r->waiting) {
+		if (d >= MT6797_RX_SEQ / 2)
+			return MT6797_RX_REORDER_NOW;
+		if (d < r->size) {
+			r->start = seq;
+			r->until = r->start;
+			d = 0;
+		}
+		r->waiting = false;
+	}
+	if (d >= MT6797_RX_SEQ / 2)
+		return MT6797_RX_REORDER_BEHIND;
+	if (d >= r->size) {
+		/* Ahead: the window will end at seq once the drain moves it. */
+		r->until = (seq - r->size + 1) & (MT6797_RX_SEQ - 1);
+		return MT6797_RX_REORDER_HOLD;
+	}
+	if (r->held[seq % MT6797_RX_REORDER_SLOTS])
+		return MT6797_RX_REORDER_DUPLICATE;
+	if (!d) {
+		r->start = (seq + 1) & (MT6797_RX_SEQ - 1);
+		r->until = r->start;
+		return MT6797_RX_REORDER_NOW;
+	}
+	return MT6797_RX_REORDER_HOLD;
+}
+
+/* After the drain that follows a HOLD placement. */
+static inline void mt6797_rx_reorder_hold(struct mt6797_rx_reorder *r,
+					  unsigned int seq, struct sk_buff *skb)
+{
+	r->held[seq % MT6797_RX_REORDER_SLOTS] = skb;
+	r->count++;
+}
+
+/* The next frame to leave, or NULL. Skipping a hole while a later frame
+ * is held counts it; once nothing is held the window moves straight to
+ * until.
+ */
+static inline struct sk_buff *mt6797_rx_reorder_next(struct mt6797_rx_reorder *r)
+{
+	while (r->count) {
+		unsigned int slot = r->start % MT6797_RX_REORDER_SLOTS;
+		struct sk_buff *skb = r->held[slot];
+		bool moving = r->start != r->until;
+
+		if (!skb && !moving)
+			return NULL;
+		r->start = (r->start + 1) & (MT6797_RX_SEQ - 1);
+		if (!moving)
+			r->until = r->start;
+		if (skb) {
+			r->held[slot] = NULL;
+			r->count--;
+			return skb;
+		}
+		r->holes++;
+	}
+	r->start = r->until;
+	return NULL;
+}
+
+/* After every drain: a hole with frames held behind it arms the bubble
+ * deadline once, from the first hole, as cnmTimerStartTimer does.
+ */
+static inline void mt6797_rx_reorder_arm(struct mt6797_rx_reorder *r,
+					 unsigned long long now)
+{
+	if (!r->count) {
+		r->has_bubble = false;
+	} else if (!r->has_bubble) {
+		r->has_bubble = true;
+		r->bubble = r->start;
+		r->deadline = now + MT6797_RX_REORDER_TIMEOUT_NS;
+	}
+}
+
+/* Release everything held at the next drain: the window starts after the
+ * last held frame.
+ */
+static inline void mt6797_rx_reorder_flush(struct mt6797_rx_reorder *r)
+{
+	unsigned int d;
+
+	for (d = r->count ? r->size : 0; d; d--)
+		if (r->held[(r->start + d - 1) % MT6797_RX_REORDER_SLOTS])
+			break;
+	r->until = (r->start + d) & (MT6797_RX_SEQ - 1);
+}
+
+/* At the bubble deadline: true if the caller drains a flush. The first
+ * hole still open flushes; if it has been filled but frames are still
+ * held, the deadline restarts from the hole now first.
+ */
+static inline bool mt6797_rx_reorder_expire(struct mt6797_rx_reorder *r,
+					    unsigned long long now)
+{
+	if (!r->has_bubble || now < r->deadline)
+		return false;
+	if (!r->count) {
+		r->has_bubble = false;
+		return false;
+	}
+	if (r->bubble != r->start) {
+		r->bubble = r->start;
+		r->deadline = now + MT6797_RX_REORDER_TIMEOUT_NS;
+		return false;
+	}
+	r->has_bubble = false;
+	mt6797_rx_reorder_flush(r);
+	return true;
+}
+
+/* One separately seeded initial GTK context, never the PTK context. Preserve
+ * the PTK shape/status/PN contract, changing only group key class, ID, index
+ * and RA. A valid group does not make firmware integrity independently proven.
+ * False preserves every input/context/output byte; true advances only this
+ * context's strict PN for the frame's TID after complete validation (0292).
+ * No delivery or key lookup.
+ */
+static inline bool
+mt6797_ccmp_gtk_rx_check(const unsigned char *packet, size_t bytes,
+			 struct mt6797_ccmp_rx_context *context,
+			 struct mt6797_ccmp_rx *out)
+{
+	struct mt6797_ccmp_rx r;
+	unsigned char pn[6];
+	size_t offset = 48; /* base16, mandatory Group4 at16, Group1 at32 */
+	unsigned int groups, fc, i, tid;
+	unsigned char *last;
+	bool greater = false, own_any = false, ap_any = false, source_any = false;
+	const unsigned char *ethernet;
+
+	if (!packet || !context || !out || bytes < 16 || bytes > 2352 ||
+	    !context->authorized || !context->active || !context->seeded ||
+	    context->pairwise || context->cipher != 0x000fac04U ||
+	    context->key_bytes != 16 || context->key_id > 3 ||
+	    context->wlan_index != 2 || context->rxd_bssid > 63 || !context->channel ||
+	    (context->own[0] & 1) || (context->ap[0] & 1))
+		return false;
+	for (i = 0; i < 6; i++) {
+		own_any |= context->own[i] != 0;
+		ap_any |= context->ap[i] != 0;
+	}
+	if (!own_any || !ap_any || mt6797_join_le16(packet) != bytes ||
+	    (mt6797_join_le16(packet + 2) >> 13) != 2 ||
+	    ((packet[4] & 0x3f) != 0x08 && (packet[4] & 0x3f) != 0x04) ||
+	    (packet[4] >> 6) != context->key_id || packet[5] != context->channel ||
+	    (packet[6] & 0xbf) != 0x8e ||
+	    packet[7] != (unsigned int)context->rxd_bssid << 2 ||
+	    packet[8] != context->wlan_index || (packet[9] & 0xf0) != 0x40 ||
+	    mt6797_join_le16(packet + 10) != 0xc000)
+		return false;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if ((groups & 9) != 9)
+		return false;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4)
+		offset += 24;
+	if (packet[6] & 0x40)
+		offset += 2;
+	/* Bounds precede every Group4, Group1 and Ethernet field access. */
+	if (offset > bytes || bytes - offset <= 14)
+		return false;
+	fc = mt6797_join_le16(packet + 16);
+	if ((fc & ~(0x2800U | MT6797_CCMP_RX_QOS_BIT)) != 0x4208 ||
+	    (mt6797_join_le16(packet + 24) & 15) ||
+	    !mt6797_ccmp_rx_tid_ok(packet, fc) || mt6797_join_le32(packet + 28))
+		return false;
+	ethernet = packet + offset;
+	for (i = 0; i < 6; i++) {
+		if (packet[18 + i] != context->ap[i])
+			return false;
+		source_any |= ethernet[6 + i] != 0;
+		pn[i] = packet[32 + 5 - i];
+	}
+	/* Ethernet-II only; EAPOL remains on the existing control-port path. */
+	if (!(ethernet[0] & 1) || !source_any || (ethernet[6] & 1) ||
+	    (((unsigned int)ethernet[12] << 8) | ethernet[13]) < 0x0600 ||
+	    (ethernet[12] == 0x88 && ethernet[13] == 0x8e))
+		return false;
+	tid = packet[9] & 15;
+	last = tid ? context->tid_pn[tid - 1] : context->pn;
+	for (i = 0; i < 6; i++) {
+		if (pn[i] < last[i])
+			return false;
+		if (pn[i] > last[i]) {
+			greater = true;
+			break;
+		}
+	}
+	if (!greater)
+		return false;
+	r.offset = offset;
+	r.bytes = bytes - offset;
+	for (i = 0; i < 6; i++)
+		last[i] = pn[i];
+	*out = r;
+	return true;
+}
+
+static inline unsigned char mt6797_join_pid_take(struct mt6797_join_pid_pool *p)
+{
+	unsigned char pid;
+
+	if (!p || !p->next || p->next > MT6797_JOIN_PID_LAST ||
+	    p->pending >= MT6797_DATA_DEPTH || p->allocations - p->completions != p->pending ||
+	    p->allocations == ~0U)
+		return 0;
+	pid = p->next;
+	if (p->used[pid] && !p->completed[pid])
+		return 0;
+	p->used[pid] = true;
+	p->completed[pid] = false;
+	p->pending++;
+	p->allocations++;
+	if (pid == MT6797_JOIN_PID_LAST) {
+		p->next = 1;
+		p->wraps++;
+	} else {
+		p->next++;
+	}
+	return pid;
+}
+
+bool mt6797_join_pid_complete(struct mt6797_join_pid_pool *p,
+			      unsigned char pid)
+{
+	if (!p || !pid || pid > MT6797_JOIN_PID_LAST ||
+	    !p->pending || !p->used[pid] || p->completed[pid] || p->completions == ~0U ||
+	    p->allocations - p->completions != p->pending)
+		return false;
+	p->completed[pid] = true;
+	p->pending--;
+	p->completions++;
+	return true;
+}
+
+const char * __maybe_unused
+mt6797_mac_deauth_verdict(const struct mt6797_mac *mac)
+{
+	if (!mac->join_deauth_status_valid)
+		return mac->join_deauth_timed_out ? "missing" : "unclassified";
+	if (mac->join_deauth_status == 0)
+		return "transmitted";
+	if (mac->join_deauth_status == 5)
+		return "flushed";
+	return "unclassified";
+}
+
+/* Only a precheck: submission still charges the existing TC1 transaction. */
+bool mt6797_ccmp_data_room(struct mt6797_mac *mac, size_t bytes)
+{
+	struct mt6797_hif_ledger ledger;
+	unsigned int pid = mac->ccmp_pid_pool.next;
+	unsigned int pages = (MT6797_JOIN_TX_DESC_BYTES + 14 + bytes - 32 + 127) / 128;
+
+	/* A busy next PID waits; it never releases or skips that owner. */
+	if (mac->ccmp_pid_pool.used[pid] && !mac->ccmp_pid_pool.completed[pid])
+		return false;
+	mt6797_hif_normal_ledger(mac->hif, &ledger);
+	return mt6797_data_room(&mac->data_slots, pages, ledger.locked ? 0 : ledger.tc1_free);
+}
+
+/* Mutex held; selection already owns the skb but has not submitted it. */
+int mt6797_ccmp_assign_pid(struct mt6797_mac *mac, bool reserved, bool data)
+{
+	unsigned char pid;
+
+	if (mac->first_error || mac->closing || mac->join_retired ||
+	    mac->join_credit_pending || mac->join_page_debt ||
+	    (mac->join_data_page_debt && !data))
+		return -EBUSY;
+	if (reserved) {
+		if (mac->ccmp_reserved_pid_used || mac->ccmp_pid_pool.pending)
+			return -EOWNERDEAD;
+		mac->ccmp_reserved_pid_used = true;
+		pid = MT6797_JOIN_PID_RESERVED;
+	} else {
+		if (mac->join_data_ended || mac->ccmp_reserved_pid_used)
+			return -EOWNERDEAD;
+		pid = mt6797_join_pid_take(&mac->ccmp_pid_pool);
+		if (!pid)
+			return -EOWNERDEAD;
+		mac->join_next_pid = mac->ccmp_pid_pool.next;
+	}
+	mac->join_pid = pid;
+	return 0;
+}
+
+/* MAC mutex held; queue state also fences atomic .tx admission. */
+void mt6797_ccmp_withdraw(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+
+	mac->ccmp_rx.active = false;
+	mac->ccmp_rx.authorized = false;
+	mac->ccmp_gtk_rx.active = false;
+	mac->ccmp_gtk_rx.authorized = false;
+	complete_all(&mac->ccmp_dtim_done);
+	mac->ccmp_decap = false;
+	mac->ccmp_closed = true;
+	RCU_INIT_POINTER(mac->ccmp_sta, NULL);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->ccmp_tx_ready = false;
+	mac->ccmp_ptk = NULL;
+	mac->ccmp_gtk = NULL;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	complete_all(&mac->ccmp_key_done);
+}
+
+static bool mt6797_ccmp_rx_ready(struct mt6797_mac *mac)
+{
+	return !mac->ccmp_closed && mac->ccmp_rx.active && mac->ccmp_rx.authorized &&
+	       mac->ccmp_decap && rcu_access_pointer(mac->ccmp_sta) && mac->ccmp_ptk &&
+	       !mac->closing && !mac->first_error &&
+	       !mac->join_retired && mac->join_data_phase && !mac->join_data_ended &&
+	       mac->native_diag_state == MT6797_ND_ACTIVE;
+}
+
+/* The group LLC-mismatch class of data-rx.h (status 0xc200: boot R's
+ * fourteen downlink refusals). The pinned vendor data path drops a status
+ * word with RX_STATUS_LLC_MIS as an error (nic_rx.c, RXS_DW2_RX_nERR_BITMAP
+ * covers bit 9), so it is discarded here too: never delivered or
+ * interpreted, the group PN unchanged, counted and the first eight named by
+ * the translated type or length word, as the join path does (0290).
+ */
+static bool mt6797_ccmp_llc_mismatch(struct mt6797_mac *mac, size_t bytes)
+{
+	struct mt6797_data_rx view;
+
+	if (!mac->ccmp_gtk || mac->join_key_group != 1 ||
+	    !mt6797_data_rx_llc_mismatch(mac->join_packet, bytes, 40, mac->join_ap,
+					 MT6797_JOIN_BMC_WLAN_INDEX, &view) ||
+	    view.key_id != mac->join_group_key_id)
+		return false;
+	mac->join_data_llc_discarded++;
+	return true;
+}
+
+/* A data frame both receive checks refused (0288): counted, and named for the
+ * first 64 of a lifetime by the descriptor and header fields the checks fix,
+ * with the first of them that differs from the admitted shape. Lengths,
+ * flags and the PN's order only; no address or payload byte. The status
+ * word's bits that differ from the admitted 0xc000 are named as the pinned
+ * nic_rx.h names them (0290). The PN's order is against the counter of the
+ * frame's own TID in the context its WLAN index selects, both named (0292).
+ * The status rung is the check's own status gate, so a block-ack
+ * sub-frame the gate admits is named by the gate that refused it (0320).
+ */
+static void mt6797_ccmp_rx_refused(struct mt6797_mac *mac, size_t bytes)
+{
+	static const char *const status_bit[16] = {
+		"sw", "fcs", "cipher-mismatch", "cipher-length", "icv", "tkip-mic",
+		"length", "de-amsdu", "exceed-length", "llc-mis", "udf-vlt", "frag",
+		"null", "data", "ampdu-sub", "ampdu-format",
+	};
+	const u8 *p = mac->join_packet;
+	const struct mt6797_ccmp_rx_context *c;
+	unsigned int groups, fc = 0x10000, qos = 0x10000, i, diff, n = 0, tid;
+	const char *field, *pn = "n/a";
+	const unsigned char *last;
+	char status[144];
+
+	mac->qos_rx_refused++;
+	if (bytes >= 18 && (mt6797_join_le16(p + 16) & 0x0080))
+		mac->qos_rx_refused_qos++;
+	if (++mac->ccmp_rx_refused > 64) {
+		if (mac->ccmp_rx_refused == 65)
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN data rx refusal record suppressed: limit=64\n");
+		return;
+	}
+	if (bytes < 48) {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN data rx refused: n=%u field=short bytes=%zu\n",
+			 mac->ccmp_rx_refused, bytes);
+		return;
+	}
+	groups = (mt6797_join_le16(p + 2) >> 9) & 15;
+	c = p[8] == 2 ? &mac->ccmp_gtk_rx : &mac->ccmp_rx;
+	tid = p[9] & 15;
+	last = tid >= MT6797_CCMP_RX_TIDS ? NULL : tid ? c->tid_pn[tid - 1] : c->pn;
+	diff = mt6797_join_le16(p + 10) ^ 0xc000;
+	for (i = 0; i < 16; i++)
+		if (diff & BIT(i))
+			n += scnprintf(status + n, sizeof(status) - n, "%s%s",
+				       n ? "+" : "", status_bit[i]);
+	if (!n)
+		strscpy(status, "none", sizeof(status));
+	if (groups & 8) {
+		fc = mt6797_join_le16(p + 16);
+		qos = mt6797_join_le16(p + 26);
+	}
+	if ((groups & 8) && last) {
+		for (i = 0; i < 6; i++) {
+			if (p[32 + 5 - i] != last[i]) {
+				pn = p[32 + 5 - i] > last[i] ? "greater" : "lower";
+				break;
+			}
+		}
+		if (i == 6)
+			pn = "equal";
+	}
+	field = (mt6797_join_le16(p + 2) >> 13) != 2 ? "packet-type" :
+		(p[6] & 0xbf) != 0x8e ? "layout" :
+		p[8] != 1 && p[8] != 2 ? "wlan-index" :
+		(p[9] & 0xf0) != 0x40 ? "cipher" :
+		!mt6797_ccmp_rx_status_ok(mt6797_join_le16(p + 10)) ? "prefix" :
+		(groups & 9) != 9 ? "groups" :
+		(fc & ~(0x2800U | MT6797_CCMP_RX_QOS_BIT)) != 0x4208 ? "frame-control" :
+		((fc & 0x0080) ? (qos & ~0x000fU) || (qos & 15) != (p[9] & 15) :
+		 qos || (p[9] & 15)) ? "qos-control" :
+		mt6797_join_le32(p + 28) ? "ht-control" :
+		strcmp(pn, "greater") ? "pn" : "other";
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN data rx refused: n=%u field=%s bytes=%zu groups=0x%x p4=0x%02x p6=0x%02x p7=0x%02x wlan=%u p9=0x%02x prefix=0x%04x status=%s fc=0x%04x qos=0x%04x ht=0x%08x pn=%s tid=%u counter=%s\n",
+		 mac->ccmp_rx_refused, field, bytes, groups, p[4], p[6], p[7], p[8], p[9],
+		 mt6797_join_le16(p + 10), status, fc, qos,
+		 (groups & 8) ? mt6797_join_le32(p + 28) : 0, pn, tid,
+		 p[8] == 2 ? "group" : "pairwise");
+}
+
+/* Caller holds the MAC mutex and has already admitted this ACTIVE RX. */
+static int mt6797_ccmp_deliver_rx(struct mt6797_mac *mac, size_t bytes,
+				  struct sk_buff_head *received)
+{
+	struct mt6797_ccmp_rx view;
+	struct sk_buff *skb;
+	unsigned int rx_flags = RX_FLAG_8023 | RX_FLAG_DECRYPTED | RX_FLAG_IV_STRIPPED |
+		RX_FLAG_MIC_STRIPPED | RX_FLAG_PN_VALIDATED | RX_FLAG_NO_SIGNAL_VAL;
+
+	if (!mt6797_ccmp_rx_ready(mac))
+		return 0;
+	/* Allocate before the PN decision commits highwater. */
+	skb = dev_alloc_skb(bytes);
+	if (!skb)
+		return -ENOMEM;
+	if (!mt6797_ccmp_rx_check(mac->join_packet, bytes, &mac->ccmp_rx, &view)) {
+		if (mac->ccmp_gtk && mac->join_key_group == 1 &&
+		    mac->ccmp_gtk_rx.key_id == mac->join_group_key_id &&
+		    mt6797_ccmp_gtk_rx_check(mac->join_packet, bytes,
+					     &mac->ccmp_gtk_rx, &view))
+			goto checked;
+		if (mt6797_ccmp_llc_mismatch(mac, bytes)) {
+			dev_kfree_skb(skb);
+			return 0;
+		}
+		mt6797_ccmp_rx_refused(mac, bytes);
+		dev_kfree_skb(skb);
+		return 0;
+	}
+checked:
+	if (mt6797_join_le16(mac->join_packet + 16) & 0x0080)
+		mac->qos_rx++;
+	else
+		mac->qos_rx_nonqos++;
+	skb_put_data(skb, mac->join_packet + view.offset, view.bytes);
+	memset(IEEE80211_SKB_RXCB(skb), 0, sizeof(struct ieee80211_rx_status));
+	IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
+	IEEE80211_SKB_RXCB(skb)->freq = 5200;
+	IEEE80211_SKB_RXCB(skb)->flag = rx_flags;
+	/* The queued-frame count saturates; it never limits delivery. */
+	if (mac->ccmp_queued < MT6797_CCMP_DIAG_CHECKED_MAX)
+		mac->ccmp_queued++;
+	mac->ccmp_last_checked_rx = ktime_get_ns();
+	__skb_queue_tail(received, skb);
+	return 0;
+}
+
+/* Drain a window through the receive checks, each held descriptor copied
+ * back into join_packet, which its caller no longer needs. The PN counter
+ * advances only here and for frames delivered in place.
+ */
+static int mt6797_rx_reorder_release(struct mt6797_mac *mac, struct mt6797_rx_reorder *r,
+				     struct sk_buff_head *received)
+{
+	struct sk_buff *skb;
+	int ret = 0;
+
+	while (!ret && (skb = mt6797_rx_reorder_next(r))) {
+		memcpy(mac->join_packet, skb->data, skb->len);
+		ret = mt6797_ccmp_deliver_rx(mac, skb->len, received);
+		dev_kfree_skb(skb);
+	}
+	mt6797_rx_reorder_arm(r, ktime_get_ns());
+	return ret;
+}
+
+/* After an ADDBA or DELBA event: deliver what the TID's window holds, then
+ * start the new session or end it (qmDelRxBaEntry flushes to the host).
+ */
+int mt6797_rx_reorder_apply(struct mt6797_mac *mac, struct sk_buff_head *received)
+{
+	unsigned int tid;
+	int ret;
+
+	for (tid = 0; tid < MT6797_RX_REORDER_TIDS; tid++) {
+		struct mt6797_rx_reorder *r = &mac->rx_reorder[tid];
+
+		if (!(mac->rx_reorder_pending & BIT(tid)))
+			continue;
+		mac->rx_reorder_pending &= ~BIT(tid);
+		mt6797_rx_reorder_flush(r);
+		ret = mt6797_rx_reorder_release(mac, r, received);
+		if (ret)
+			return ret;
+		r->valid = false;
+		if (mac->rx_ba_active & BIT(tid))
+			mt6797_rx_reorder_start(r, mac->rx_ba_ssn[tid], mac->rx_ba_window[tid]);
+	}
+	return 0;
+}
+
+/* Once per worker pass: windows whose first hole outlived the timeout. */
+int mt6797_rx_reorder_expire_all(struct mt6797_mac *mac,
+				 struct sk_buff_head *received)
+{
+	u64 now = ktime_get_ns();
+	unsigned int tid;
+	int ret;
+
+	for (tid = 0; tid < MT6797_RX_REORDER_TIDS; tid++) {
+		if (!mt6797_rx_reorder_expire(&mac->rx_reorder[tid], now))
+			continue;
+		ret = mt6797_rx_reorder_release(mac, &mac->rx_reorder[tid], received);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+/* Lifetime reset and close: what is held is counted and freed. */
+void mt6797_rx_reorder_drop(struct mt6797_mac *mac)
+{
+	struct sk_buff *skb;
+	unsigned int tid;
+
+	for (tid = 0; tid < MT6797_RX_REORDER_TIDS; tid++) {
+		struct mt6797_rx_reorder *r = &mac->rx_reorder[tid];
+
+		mt6797_rx_reorder_flush(r);
+		while ((skb = mt6797_rx_reorder_next(r)))
+			dev_kfree_skb(skb);
+		r->valid = false;
+		r->waiting = false;
+		r->has_bubble = false;
+	}
+	mac->rx_reorder_pending = 0;
+}
+
+/* A pairwise QoS data frame on a TID with a block-ack session passes its
+ * window first (0321), aggregated or not, so that its TID's frames reach
+ * the PN check in sequence order; every other frame goes to the checks
+ * directly. A held frame is copied, because the drain reuses join_packet.
+ */
+int mt6797_ccmp_queue_rx(struct mt6797_mac *mac, size_t bytes,
+			 struct sk_buff_head *received)
+{
+	const u8 *p = mac->join_packet;
+	struct mt6797_rx_reorder *r;
+	struct sk_buff *skb = NULL;
+	unsigned int seq;
+	int ret = 0;
+
+	if (!mt6797_ccmp_rx_ready(mac) || bytes < 48 || p[8] != 1 ||
+	    (mt6797_join_le16(p + 2) >> 13) != 2 ||
+	    !((mt6797_join_le16(p + 2) >> 9) & 8) ||
+	    (mt6797_join_le16(p + 16) & 0x008c) != 0x0088 ||
+	    (p[9] & 15) >= MT6797_RX_REORDER_TIDS || !mac->rx_reorder[p[9] & 15].valid ||
+	    !mt6797_ccmp_rx_status_ok(mt6797_join_le16(p + 10)))
+		return mt6797_ccmp_deliver_rx(mac, bytes, received);
+	r = &mac->rx_reorder[p[9] & 15];
+	seq = mt6797_join_le16(p + 24) >> 4;
+	switch (mt6797_rx_reorder_place(r, seq)) {
+	case MT6797_RX_REORDER_DUPLICATE:
+		return 0;
+	case MT6797_RX_REORDER_BEHIND:
+		return 0;
+	case MT6797_RX_REORDER_NOW:
+		ret = mt6797_ccmp_deliver_rx(mac, bytes, received);
+		break;
+	case MT6797_RX_REORDER_HOLD:
+		skb = dev_alloc_skb(bytes);
+		if (!skb)
+			return -ENOMEM;
+		skb_put_data(skb, p, bytes);
+		break;
+	}
+	if (!ret)
+		ret = mt6797_rx_reorder_release(mac, r, received);
+	if (skb) {
+		if (ret) {
+			dev_kfree_skb(skb);
+			return ret;
+		}
+		mt6797_rx_reorder_hold(r, seq, skb);
+		ret = mt6797_rx_reorder_release(mac, r, received);
+	}
+	return ret;
+}
+
+/* Only the reserved, driver-owned deauth may retire without TX status. Its
+ * page remains charged. Neither mac80211 ACK status nor firmware retirement
+ * is invented; every other frame timeout is still fatal.
+ */
+bool mt6797_ccmp_deauth_retire(struct mt6797_mac *mac, u64 now,
+			       struct sk_buff_head *discard, struct sk_buff **internal)
+{
+	if (mac->ccmp_deauth_timeouts || mac->first_error ||
+	    mac->closing || mac->join_retired || mac->scan_active || !mac->join_running ||
+	    !mac->join_data_phase || !mac->join_data_ended ||
+	    (!mac->ccmp_pm_connected && !mac->ccmp_pm_abort_credited) ||
+	    !mac->join_cleanup_requested || mac->join_cleanup_done || mac->join_cleanup_stage ||
+	    !mac->join_sta_active || mac->native_diag_state != MT6797_ND_CLOSED ||
+	    !mac->join_internal || mac->join_inflight != mac->join_internal ||
+	    mac->join_inflight_data || mac->join_internal->len != 26 ||
+	    mt6797_join_le16(mac->join_internal->data) != 0x00c0 ||
+	    !mac->join_pid || mac->join_pid > 127 || mac->join_page_debt > 1 ||
+	    mac->join_credit_pending || mac->join_data_page_debt ||
+	    now < mac->join_frame_deadline || now >= mac->join_deadline ||
+	    !discard || !internal || *internal)
+		return false;
+	if (mac->join_page_debt) {
+		int ret = mt6797_hif_retain_cleanup_page(mac->hif);
+
+		if (ret) {
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN cleanup debt admission: status=%d\n", ret);
+			return false;
+		}
+		mac->ccmp_cleanup_retained_pages = 1;
+	}
+	mac->ccmp_deauth_timeouts++;
+	mac->ccmp_deauth_retired_pid = mac->join_pid;
+	*internal = mac->join_internal;
+	__skb_queue_tail(discard, mac->join_internal);
+	mac->join_inflight = NULL;
+	mac->join_internal = NULL;
+	mac->join_last_acked = false;
+	mac->join_deauth_timed_out = true;
+	complete_all(&mac->join_frame_done);
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN deauth completion missing: pid=%u timeouts=%u debt=%u acked=0 no_reuse=1\n",
+		 mac->ccmp_deauth_retired_pid, mac->ccmp_deauth_timeouts, mac->join_page_debt);
+	return true;
+}
+
+/* The reserved frame stays queued until the PM abort is credited. Ordinary
+ * expired data may still be discarded by the existing selection walk.
+ */
+bool mt6797_ccmp_pm_holds_deauth(const struct mt6797_mac *mac)
+{
+	return mac->join_cleanup_requested &&
+		mac->join_data_phase && mac->join_data_ended &&
+		mac->native_diag_state == MT6797_ND_CLOSED &&
+		mac->ccmp_pm_connected && !mac->ccmp_pm_abort_credited;
+}
+
+bool mt6797_ccmp_cleanup_debt_ready(const struct mt6797_mac *mac)
+{
+	return mac->ccmp_deauth_timeouts == 1 &&
+		mac->join_cleanup_requested && mac->join_data_ended &&
+		!mac->first_error && !mac->closing && !mac->join_retired &&
+		mac->join_cleanup_stage <= 3 && mac->ccmp_cleanup_retained_pages == 1 &&
+		mac->join_page_debt == 1 && !mac->join_inflight && !mac->data_slots.count;
+}
+
+bool mt6797_ccmp_cleanup_credit_ready(const struct mt6797_mac *mac)
+{
+	if (!mac->ccmp_cleanup_credit_active)
+		return !mac->join_page_debt;
+	return mac->ccmp_cleanup_credit_floor <= 1 &&
+		mac->ccmp_cleanup_credit_floor <= mac->ccmp_cleanup_retained_pages &&
+		mac->join_page_debt <= mac->ccmp_cleanup_credit_floor;
+}
+
+/* A late completion for this lifetime's one retired PID cannot own a second
+ * skb or credit. Unknown PIDs, invalid status and malformed events still fail.
+ */
+bool mt6797_ccmp_deauth_late(struct mt6797_mac *mac, size_t bytes)
+{
+	struct mt6797_join_tx_result result;
+
+	if (!mac->ccmp_deauth_timeouts ||
+	    !mac->join_running || !mac->join_cleanup_requested || mac->join_retired ||
+	    mac->first_error || mac->closing ||
+	    !mt6797_join_tx_done(mac->join_packet, bytes,
+				 mac->ccmp_deauth_retired_pid, 1, &result))
+		return false;
+	if (result.status > 7 && (result.status < 32 || result.status > 34)) {
+		mac->join_deauth_status_valid = true;
+		mac->join_deauth_status = result.status;
+		return false;
+	}
+	mac->ccmp_deauth_late++;
+	mac->join_deauth_status_valid = true;
+	mac->join_deauth_status = result.status;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN retired deauth completion: pid=%u status=%u late=%u no_credit=1\n",
+		 mac->ccmp_deauth_retired_pid, result.status, mac->ccmp_deauth_late);
+	return true;
+}
+
+/* MAC mutex held; this standard API only queues work, never calls back here.
+ * A finite healthy terminal and a fatal live-data stop share one notification.
+ */
+/* reason is the firmware's beacon-timeout reason byte for a monitor loss and
+ * zero otherwise. Reason 6 is the firmware's no-connection watchdog: it fires
+ * only when the connected indication was never credited, which is a driver
+ * ordering fault, not an air loss. Every other reason is the firmware's own
+ * link judgement and is reported to mac80211 as such.
+ */
+void mt6797_ccmp_connection_lost(struct mt6797_mac *mac, const char *source,
+				 unsigned int reason)
+{
+	if (!mac->vif || !mac->started || mac->ccmp_loss_reported)
+		return;
+	mac->ccmp_loss_reported = true;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN connection loss report: source=%s reason=%u class=%s once=1\n",
+		 source, reason, !reason ? "host" : reason == 6 ? "watchdog" : "air");
+	ieee80211_connection_loss(mac->vif);
+}
+
+/* Called only in the common serialized RX/TX-status batch, outside MAC locks.
+ * Withdrawal fences eligibility then waits for this batch before key removal
+ * callbacks complete. RCU covers pubsta and the entire core RX handoff.
+ */
+void mt6797_ccmp_receive(struct mt6797_mac *mac, struct sk_buff *skb)
+{
+	struct ieee80211_sta *sta = NULL;
+	bool ethernet = IEEE80211_SKB_RXCB(skb)->flag & RX_FLAG_8023, ready = true;
+
+	mutex_lock(&mac->mutex);
+	local_bh_disable();
+	rcu_read_lock();
+	if (ethernet) {
+		ready = mt6797_ccmp_rx_ready(mac);
+		sta = rcu_dereference_protected(mac->ccmp_sta, lockdep_is_held(&mac->mutex));
+		ready = ready && sta;
+	}
+	if (ready)
+		mac->ccmp_rx_delivered++;
+	mutex_unlock(&mac->mutex);
+	if (ready)
+		ieee80211_rx_napi(mac->hw, sta, skb, NULL);
+	else
+		dev_kfree_skb(skb);
+	rcu_read_unlock();
+	local_bh_enable();
+}
+
+/* This lifetime's data width and receive A-MPDU. */
+bool __maybe_unused mt6797_mac_data_bw40(const struct mt6797_mac *mac)
+{
+	return mac->join_sco == 3;
+}
+
+/* This lifetime's ordinary data at mac80211's rate control choice. */
+static bool __maybe_unused mt6797_mac_data_minstrel(const struct mt6797_mac *mac)
+{
+	return mac->join_data_minstrel;
+}
+
+/* One ordinary data frame's rate: mac80211's first choice in a rate control
+ * lifetime, as the descriptor carries it; 40 MHz only on the HT40 join, so
+ * a stray width flag cannot put wide frames on a 20 MHz association.
+ * Otherwise the frame goes at the fixed rate and its status names no rate
+ * (index -1), so the rate control learns nothing from it; in a rate control
+ * lifetime that fallback is counted, since it should never be taken.
+ */
+const struct mt6797_tx_rate * __maybe_unused
+mt6797_mac_tx_rate(struct mt6797_mac *mac, struct sk_buff *skb,
+		   struct mt6797_tx_rate *r)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_tx_rate *rate = &info->control.rates[0];
+	const struct ieee80211_supported_band *sband = mac->hw->wiphy->bands[info->band];
+	int legacy = sband && rate->idx >= 0 && rate->idx < sband->n_bitrates ?
+		     sband->bitrates[rate->idx].hw_value : -1;
+
+	bool w40 = rate->flags & IEEE80211_TX_RC_40_MHZ_WIDTH;
+
+	if (!mt6797_mac_data_minstrel(mac))
+		goto fixed;
+	if ((!w40 || mac->join_sco == 3) &&
+	    mt6797_tx_rate_map(rate->idx, rate->flags & IEEE80211_TX_RC_MCS,
+			       rate->flags & IEEE80211_TX_RC_VHT_MCS, w40,
+			       rate->flags & IEEE80211_TX_RC_SHORT_GI, legacy, r))
+		return r;
+fixed:
+	/* control.rates is status.rates (one union): this is the status. */
+	rate->idx = -1;
+	return NULL;
+}
+
+/* The status of a reported frame sent at its own rate: that one rate, for
+ * the attempts the MCU counted. mac80211's rate choice and the status rates
+ * share their storage, so the rate sent is already in status.rates[0]
+ * (ieee80211_tx_info_clear_status keeps it); the build fails if that ever
+ * stops being true.
+ */
+void __maybe_unused mt6797_mac_tx_rate_status(struct sk_buff *skb, unsigned int attempts)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+
+	BUILD_BUG_ON(offsetof(struct ieee80211_tx_info, control.rates) !=
+		     offsetof(struct ieee80211_tx_info, status.rates));
+
+	if (info->status.rates[0].idx < 0)
+		return;
+	info->status.rates[0].count = clamp(attempts, 1U, 31U);
+	info->status.rates[1].idx = -1;
+}
+
+bool mt6797_ccmp_owned_loss(struct mt6797_mac *mac, size_t bytes)
+{
+	u64 now;
+
+	if (!mt6797_join_event(mac->join_packet, bytes, 0x13, 4) ||
+	    mac->join_packet[5] || mac->join_packet[8] || !mt6797_ccmp_rx_ready(mac) ||
+	    !mac->started || !mac->vif ||
+	    !mac->join_running || !mac->join_sta_active || !mac->join_bss_valid ||
+	    !mac->join_bss_configured || !mac->ccmp_pm_connected || !mac->ccmp_pm_credit_ns ||
+	    mac->join_key_pairwise != 1 || mac->join_key_group != 1 || mac->ccmp_loss_reported)
+		return false;
+	now = ktime_get_ns();
+	if (mac->join_packet[9] == 4 && mac->ccmp_queued &&
+	    mac->ccmp_last_checked_rx <= now &&
+	    now - mac->ccmp_last_checked_rx < MT6797_CCMP_TIMEOUT_FRESH_RX_MS * NSEC_PER_MSEC) {
+		if (++mac->ccmp_timeout_ignored <= MT6797_CCMP_TIMEOUT_IGNORE_NAMED)
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN BSS timeout ignored: reason=4 checked_rx_age_ms=%llu data_ms=%llu ignored=%u\n",
+				 (now - mac->ccmp_last_checked_rx) / NSEC_PER_MSEC,
+				 now > mac->join_data_started ?
+				 (now - mac->join_data_started) / NSEC_PER_MSEC : 0,
+				 mac->ccmp_timeout_ignored);
+		return true;
+	}
+	mt6797_mac_join_end_data(mac, "connection-loss");
+	mt6797_ccmp_connection_lost(mac, "monitor", mac->join_packet[9]);
+	return true;
+}
+
+/* The target's beacon, delivered to mac80211 after an accepted association
+ * (0176). mac80211 arms its beacon monitor at association and polls the AP
+ * with a nullfunc when no beacon reaches it; neither TX gate admits that
+ * nullfunc, so the poll ends in a locally generated disconnect (reason 4)
+ * once unicast traffic idles (runtime 28). The beacon is handed over as the
+ * passive scan hands its beacons over: the native frame from the RX
+ * descriptor's header offset, the join channel, the RX vector's RCPI as the
+ * signal (half dB, 220 the vendor's ceiling), no PHY rate measurement. The
+ * first four deliveries are recorded, the total before the stage-3 record;
+ * the lifetime's packet budget bounds the class. Nothing is interpreted here;
+ * no decoder changes.
+ */
+/* The existing caller has validated this target beacon's peer and channel.
+ * Latch once after station activation, before any PM/key command. The callback
+ * waiter releases the MAC mutex; this RX path performs no command submission.
+ */
+static void mt6797_ccmp_pm_beacon(struct mt6797_mac *mac, size_t offset, size_t bytes)
+{
+	u8 period;
+
+	if (mac->ccmp_dtim_valid || mac->ccmp_pm_attempted ||
+	    mac->ccmp_closed || mac->first_error || mac->closing || mac->join_retired ||
+	    !mac->join_running || !mac->join_assoc_received || mac->join_assoc_status ||
+	    !mac->join_bss_valid || !mac->join_bss_configured || !mac->join_sta_active ||
+	    mac->join_data_phase || mac->join_key_pairwise || mac->join_key_group ||
+	    offset > sizeof(mac->join_packet) || bytes > sizeof(mac->join_packet) - offset ||
+	    ktime_get_ns() >= mac->join_deadline)
+		return;
+	mac->ccmp_dtim_status = mt6797_join_beacon_dtim(mac->join_packet + offset, bytes,
+							mac->join_beacon_interval, &period);
+	if (mac->ccmp_dtim_status)
+		return;
+	mac->ccmp_dtim_period = period;
+	mac->ccmp_dtim_valid = true;
+	complete_all(&mac->ccmp_dtim_done);
+}
+
+int mt6797_mac_join_deliver_beacon(struct mt6797_mac *mac, size_t offset,
+				   size_t bytes, unsigned int rcpi,
+					  bool keyed, struct sk_buff_head *received)
+{
+	struct sk_buff *skb = dev_alloc_skb(bytes);
+
+	if (!skb)
+		return -ENOMEM;
+	skb_put_data(skb, mac->join_packet + offset, bytes);
+	memset(IEEE80211_SKB_RXCB(skb), 0, sizeof(struct ieee80211_rx_status));
+	IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
+	IEEE80211_SKB_RXCB(skb)->freq = 5200;
+	if (rcpi <= 220)
+		IEEE80211_SKB_RXCB(skb)->signal = (int)rcpi / 2 - 110;
+	else
+		IEEE80211_SKB_RXCB(skb)->flag |= RX_FLAG_NO_SIGNAL_VAL;
+	mt6797_ccmp_pm_beacon(mac, offset, bytes);
+	__skb_queue_tail(received, skb);
+	return 0;
+}
+
+/* Pre-key data RXDs only. Header groups are metadata; never copy the MSDU.
+ * Missing descriptor groups leave the remainder zero, with header_bytes named.
+ */
+void mt6797_mac_eapol_trace(struct mt6797_mac *mac, size_t bytes,
+			    const char *verdict, const char *predicate,
+				 enum mt6797_eapol_gate gate, size_t eapol_bytes)
+{
+	const u8 *p = mac->join_packet;
+	u8 header[32] = {0};
+	size_t descriptor, copied, offset, frame_bytes = 0;
+	/* The header the gate read, so a refusal names its layout (0284, 0285).
+	 * The 0x10000 sentinel marks a field the packet does not hold whole.
+	 */
+	unsigned int hl = p[6] & 63, fc = 0x10000, qos = 0x10000, type = 0x10000;
+	const u8 *f;
+	bool refused;
+
+	if (mac->join_key_pairwise_submitted || bytes < 16 ||
+	    (mt6797_join_le16(p + 2) >> 13) != 2)
+		return;
+	refused = !strcmp(verdict, "refused");
+	if (refused && ++mac->join_eapol_refused > 64) {
+		if (mac->join_eapol_refused == 65)
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN EAPOL refusal record suppressed: limit=64\n");
+		return;
+	}
+	if (!refused && ++mac->join_eapol_trace > 64) {
+		if (mac->join_eapol_trace == 65)
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN EAPOL trace suppressed: limit=64\n");
+		return;
+	}
+	descriptor = mt6797_eapol_rxd_bytes(p, bytes);
+	copied = descriptor ? min_t(size_t, descriptor, sizeof(header)) : 16;
+	memcpy(header, p, copied);
+	offset = descriptor + ((p[6] & 0x40) ? 2 : 0);
+	if (descriptor && offset <= bytes)
+		frame_bytes = bytes - offset;
+	f = p + offset;
+	if (!frame_bytes) {
+		;
+	} else if (p[6] & 0x80) {
+		if (((mt6797_join_le16(p + 2) >> 9) & 8) && bytes >= 32) {
+			fc = mt6797_join_le16(p + 16);
+			qos = mt6797_join_le16(p + 26);
+		}
+		if (frame_bytes >= 14)
+			type = ((unsigned int)f[12] << 8) | f[13];
+	} else if (frame_bytes >= 2) {
+		fc = mt6797_join_le16(f);
+		if (hl >= 26 && frame_bytes >= 26)
+			qos = mt6797_join_le16(f + 24);
+		if ((hl == 24 || hl == 26) && frame_bytes >= hl + 8)
+			type = ((unsigned int)f[hl + 6] << 8) | f[hl + 7];
+	}
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN EAPOL header: ordinal=%u verdict=%s predicate=%s translated=%u hl=%u fc=0x%04x qos=0x%04x ethertype=0x%04x bss=%u format=0x%02x p9=0x%02x prefix=0x%04x\n",
+		 refused ? mac->join_eapol_refused : mac->join_eapol_trace, verdict, predicate,
+		 !!(p[6] & 0x80), hl, fc, qos, type, p[7] >> 2, p[8], p[9],
+		 mt6797_join_le16(p + 10));
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN EAPOL admission: ordinal=%u verdict=%s predicate=%s candidate=%u body_examined=%u body_valid=%u activated=%u bss_configured=%u seen=%u bss=%u msdu_format=%u format=0x%02x p8=0x%02x p9=0x%02x prefix=0x%04x rx_bytes=%zu frame_bytes=%zu eapol_bytes=%zu channel=%u translated=%u header_bytes=%zu rxd32=%*phN\n",
+		 refused ? mac->join_eapol_refused : mac->join_eapol_trace, verdict, predicate,
+		 mt6797_eapol_candidate(p, bytes),
+		 gate == MT6797_EAPOL_OK || gate >= MT6797_EAPOL_EAPOL_VERSION,
+		 gate == MT6797_EAPOL_OK, mac->join_sta_active,
+		 mac->join_bss_configured, mac->join_eapol_seen,
+		 p[7] >> 2, p[7] & 3, p[6], p[8], p[9], mt6797_join_le16(p + 10),
+		 bytes, frame_bytes, eapol_bytes, p[5], !!(p[6] & 0x80),
+		 copied, (int)sizeof(header), header);
+}
diff --git a/drivers/net/wireless/mediatek/mt6797/firmware.c b/drivers/net/wireless/mediatek/mt6797/firmware.c
new file mode 100644
