+# SPDX-License-Identifier: GPL-2.0-only
+config MT6797_HIF_CORE
+	tristate "MT6797 WLAN host interface transport"
+	depends on ARM64 && FW_LOADER
+	select CRC32
+	default n
+	help
+	  Build the ordered AHB transport, the firmware image loader and the
+	  bounded ordinary INIT section implementation for the MT6797
+	  connectivity subsystem. The CONSYS owner supplies the powered mapping
+	  and exclusion; this option alone provides no Wi-Fi device.
+
+	  As a module (mt6797-wlan-core) it loads before the CONSYS owner.
+
+config MT6797_MAC80211
+	tristate "MT6797 WLAN mac80211 station driver"
+	depends on MT6797_HIF_CORE && MTK_MT6797_CONSYS && MAC80211
+	default n
+	help
+	  Register the MT6797 WLAN function with mac80211 as a managed-mode
+	  station: regulatory configuration, passive scan, WPA2-PSK with
+	  firmware-owned encryption, checked CCMP receive with host PN
+	  validation, HT40 with receive aggregation, and reconnects. Group-key
+	  rekey and power save are not yet supported.
+
+	  As a module (mac) the CONSYS owner still starts the firmware;
+	  loading the module attaches this layer to it, and unloading it
+	  detaches the layer, so a later load attaches again.
