diff --git a/drivers/net/wireless/mediatek/mt6797/data.c b/drivers/net/wireless/mediatek/mt6797/data.c
new file mode 100644
index 000000000..dcf4e0e0a
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/data.c
@@ -0,0 +1,1831 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6797 WLAN data path: transmit PIDs and rates, protected
+ * receive with PN checks, reordering and connection monitoring.
+ */
+
+#include "mac-priv.h"
+
+/* Native unprotected directed management RX only. The caller selects which
+ * subtype its current state permits. Firmware metadata is not passed as part
+ * of the frame. Signal converts RCPI to whole dBm, rounding odd RCPI down.
+ */
+bool
+mt6797_join_rx_frame(const unsigned char *packet, size_t bytes,
+		     unsigned char channel, const unsigned char *own,
+		    const unsigned char *ap, unsigned int allowed_subtypes,
+		    struct mt6797_join_rx_frame *out)
+{
+	struct mt6797_join_rx_frame r;
+	size_t offset = 16, vector = 0, length, minimum, ie;
+	unsigned int type, groups, fc, subtype, i;
+	const unsigned char *f;
+
+	if (!packet || !own || !ap || !out || bytes < 16 || !channel ||
+	    mt6797_join_le16(packet) != bytes || packet[5] != channel)
+		return false;
+	type = mt6797_join_le16(packet + 2);
+	if ((type & 0xe00f) != 0xe001)
+		return false;
+	groups = (type >> 9) & 15;
+	if (groups & 8)
+		offset += 16;
+	if (groups & 1)
+		offset += 16;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4) {
+		vector = offset;
+		offset += 24;
+	}
+	if (!vector || offset > bytes)
+		return false;
+	if (packet[6] & 0x40)
+		offset += 2;
+	if (offset > bytes || bytes - offset < 24 ||
+	    (packet[6] & 0x80) || (packet[6] & 0x3f) != 24 ||
+	    (packet[9] & 0xf0) || (packet[7] & 3) ||
+	    (mt6797_join_le16(packet + 10) & 0x0ffe))
+		return false;
+	f = packet + offset;
+	length = bytes - offset;
+	fc = mt6797_join_le16(f);
+	subtype = (fc >> 4) & 15;
+	if ((fc & 0xc70f) || !(allowed_subtypes & (1U << subtype)) ||
+	    (mt6797_join_le16(f + 22) & 15))
+		return false;
+	minimum = subtype == 11 || subtype == 1 ? 30 :
+		  subtype == 10 || subtype == 12 ? 26 : 0;
+	if (!minimum || length < minimum)
+		return false;
+	for (i = 0; i < 6; i++)
+		if (f[4 + i] != own[i] || f[10 + i] != ap[i] || f[16 + i] != ap[i])
+			return false;
+	/* This admission uses only Open System response transaction 2. */
+	if (subtype == 11 && (mt6797_join_le16(f + 24) ||
+			      mt6797_join_le16(f + 26) != 2 || length != 30))
+		return false;
+	/* Association response IEs must be complete, never truncated. */
+	if (subtype == 1) {
+		for (ie = minimum; ie < length; ) {
+			if (length - ie < 2 || f[ie + 1] > length - ie - 2)
+				return false;
+			ie += 2 + f[ie + 1];
+		}
+	} else if (length != minimum) {
+		return false;
+	}
+	if (packet[vector + 9] > 220)
+		return false;
+	r.offset = offset;
+	r.bytes = length;
+	r.subtype = subtype;
+	r.rcpi = packet[vector + 9];
+	r.signal_dbm = (int)r.rcpi / 2 - 110;
+	*out = r;
+	return true;
+}
+
+/* Original decoder of the public gen3 RXD layout. Clear, nonaggregated,
+ * non-QoS From-DS EAPOL-Key only; peer lifetime and admission belong to caller.
+ * Translated Ethernet needs group 4 to restore the AP and sequence identity.
+ * RX vector group 3 is optional, as in the pinned gen3 receive path; without
+ * it the signal is reported invalid rather than the packet refused. The RXD
+ * BSSID field is not consumed by the pinned receive path, which routes by the
+ * WLAN index and defines no meaning for its values; this decoder requires the
+ * MSDU payload format and reports the field, admitting only the two values
+ * measured on this hardware: 15 before the station activation (runtimes 12
+ * and 15, the delivered message 1) and 1 after it (runtime 15, the next clear
+ * translated EAPOL-shaped packet after the activation, refused at this field
+ * before its body was examined; consistent with the expected message 3, not
+ * validated as such), so the caller can bind each to its interval. No other
+ * value has been observed; 0 was a guess and is refused with the frame named.
+ * No firmware crypto, key material, transport, allocation or effects here.
+ */
+enum mt6797_eapol_gate
+mt6797_eapol_rx_gate(const unsigned char *packet, size_t bytes,
+		     unsigned char channel, const unsigned char own[6],
+		const unsigned char ap[6], struct mt6797_eapol_rx *out)
+{
+	struct mt6797_eapol_rx r = {0};
+	size_t offset = 16, group4 = 0, vector = 0, eapol;
+	unsigned int groups, fc, i, length, hl;
+	const unsigned char *f, *source;
+	bool translated;
+
+	if (!packet || !own || !ap || !out || bytes < 16 || bytes > 4096 || !channel)
+		return MT6797_EAPOL_INPUT;
+	if (mt6797_join_le16(packet) != bytes)
+		return MT6797_EAPOL_BYTE_COUNT;
+	if ((mt6797_join_le16(packet + 2) >> 13) != 2)
+		return MT6797_EAPOL_PACKET_TYPE;
+	if (packet[5] != channel)
+		return MT6797_EAPOL_CHANNEL;
+	if ((packet[4] & 15) != 2)
+		return MT6797_EAPOL_WLAN_MATCH;
+	if (packet[7] & 3)
+		return MT6797_EAPOL_MSDU_FORMAT;
+	if ((packet[7] >> 2) != 1 && (packet[7] >> 2) != 15)
+		return MT6797_EAPOL_BSS;
+	if (packet[8] != 1)
+		return MT6797_EAPOL_FORMAT;
+	/* Descriptor byte 9: the cipher in its high nibble (none for a clear
+	 * EAPOL-Key) and, observed on boot P, the frame's TID in its low nibble
+	 * (6 for the access point's QoS EAPOL-Key, 0 for non-QoS). With WMM the
+	 * TID is admitted whatever it is and recorded (0286).
+	 */
+	if (packet[9] & ~(MT6797_EAPOL_RX_QOS_BIT ? 0x0fU : 0U))
+		return MT6797_EAPOL_SECURITY;
+	if (mt6797_join_le16(packet + 10) != 0xc000)
+		return MT6797_EAPOL_PREFIX;
+
+	r.bss_index = packet[7] >> 2;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if (groups & 8) {
+		group4 = offset;
+		offset += 16;
+	}
+	if (groups & 1)
+		offset += 16;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4) {
+		vector = offset;
+		offset += 24;
+	}
+	if (packet[6] & 0x40)
+		offset += 2;
+	if (offset > bytes)
+		return MT6797_EAPOL_GROUP_BOUNDS;
+	if (vector && packet[vector + 9] > 220)
+		return MT6797_EAPOL_VECTOR;
+	translated = packet[6] & 0x80;
+	f = packet + offset;
+	if (translated) {
+		if (!group4 || (packet[6] & 63) != 14 || bytes - offset < 18)
+			return MT6797_EAPOL_TRANSLATED_LAYOUT;
+		fc = mt6797_join_le16(packet + group4);
+		if (mt6797_join_le16(packet + group4 + 8) & 15)
+			return MT6797_EAPOL_FRAGMENT;
+		/* A QoS frame's rebuilt header carries its QoS control field. */
+		hl = fc & MT6797_EAPOL_RX_QOS_BIT ? 26 : 24;
+		if (hl == 26 && (packet[group4 + 10] & 0x80))
+			return MT6797_EAPOL_FRAME_CONTROL;
+		for (i = 0; i < 6; i++)
+			if (f[i] != own[i] || packet[group4 + 2 + i] != ap[i])
+				return MT6797_EAPOL_PEER;
+		if (f[12] != 0x88 || f[13] != 0x8e)
+			return MT6797_EAPOL_ETHERTYPE;
+		source = f + 6;
+		eapol = offset + 14;
+		r.prefix_bytes = hl + 8;
+		r.prefix[0] = fc;
+		r.prefix[1] = fc >> 8;
+		for (i = 0; i < 6; i++) {
+			r.prefix[4 + i] = own[i];
+			r.prefix[10 + i] = ap[i];
+			r.prefix[16 + i] = source[i];
+		}
+		r.prefix[22] = packet[group4 + 8];
+		r.prefix[23] = packet[group4 + 9];
+		if (hl == 26) {
+			r.prefix[24] = packet[group4 + 10];
+			r.prefix[25] = packet[group4 + 11];
+		}
+		r.prefix[hl] = 0xaa;
+		r.prefix[hl + 1] = 0xaa;
+		r.prefix[hl + 2] = 3;
+		r.prefix[hl + 6] = 0x88;
+		r.prefix[hl + 7] = 0x8e;
+		r.offset = eapol;
+	} else {
+		hl = packet[6] & 63;
+		if ((hl != 24 && !(MT6797_EAPOL_RX_QOS_BIT && hl == 26)) ||
+		    bytes - offset < hl + 12)
+			return MT6797_EAPOL_NATIVE_LAYOUT;
+		fc = mt6797_join_le16(f);
+		if (mt6797_join_le16(f + 22) & 15)
+			return MT6797_EAPOL_FRAGMENT;
+		/* The header length must agree with the QoS subtype. */
+		if ((hl == 26) != !!(fc & MT6797_EAPOL_RX_QOS_BIT) ||
+		    (hl == 26 && (f[24] & 0x80)))
+			return MT6797_EAPOL_FRAME_CONTROL;
+		for (i = 0; i < 6; i++)
+			if (f[4 + i] != own[i] || f[10 + i] != ap[i])
+				return MT6797_EAPOL_PEER;
+		if (f[hl] != 0xaa || f[hl + 1] != 0xaa || f[hl + 2] != 3 ||
+		    f[hl + 3] || f[hl + 4] || f[hl + 5] ||
+		    f[hl + 6] != 0x88 || f[hl + 7] != 0x8e)
+			return MT6797_EAPOL_LLC;
+		source = f + 16;
+		eapol = offset + hl + 8;
+		r.offset = offset;
+	}
+	/* Version/type, DS direction, fragment, protection and QoS are fixed.
+	 * Retry and More-Data do not alter header layout or peer identity.
+	 */
+	if ((fc & ~(0x2800U | MT6797_EAPOL_RX_QOS_BIT)) != 0x0208)
+		return MT6797_EAPOL_FRAME_CONTROL;
+	if (source[0] & 1)
+		return MT6797_EAPOL_SOURCE;
+	/* Complete WPA2-PSK EAPOL-Key (16-byte MIC) and key-data length.
+	 * Supplicant owns nonce, replay, MIC and handshake-state validation.
+	 */
+	length = (packet[eapol + 2] << 8) | packet[eapol + 3];
+	if (packet[eapol] < 1 || packet[eapol] > 3)
+		return MT6797_EAPOL_EAPOL_VERSION;
+	if (packet[eapol + 1] != 3)
+		return MT6797_EAPOL_EAPOL_TYPE;
+	if (length < 95 || length > 2048 || bytes - eapol != length + 4)
+		return MT6797_EAPOL_EAPOL_LENGTH;
+	if (packet[eapol + 4] != 2)
+		return MT6797_EAPOL_KEY_DESCRIPTOR;
+	if ((((unsigned int)packet[eapol + 97] << 8) | packet[eapol + 98]) != length - 95)
+		return MT6797_EAPOL_KEY_DATA_LENGTH;
+
+	r.bytes = bytes - r.offset;
+	r.tid = packet[9] & 15;
+	r.signal_valid = vector != 0;
+	r.signal_dbm = vector ? (int)packet[vector + 9] / 2 - 110 : 0;
+	*out = r;
+	return MT6797_EAPOL_OK;
+}
+
+/* Preserve the existing boolean admission API and every body predicate. */
+bool
+mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
+		unsigned char channel, const unsigned char own[6],
+		const unsigned char ap[6], struct mt6797_eapol_rx *out)
+{
+	return mt6797_eapol_rx_gate(packet, bytes, channel, own, ap, out) == MT6797_EAPOL_OK;
+}
+
+/* Descriptor geometry only. Zero means untrusted/truncated group geometry. */
+static inline size_t
+mt6797_eapol_rxd_bytes(const unsigned char *packet, size_t bytes)
+{
+	size_t n = 16;
+	unsigned int groups;
+
+	if (!packet || bytes < 16)
+		return 0;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if (groups & 8)
+		n += 16;
+	if (groups & 1)
+		n += 16;
+	if (groups & 2)
+		n += 8;
+	if (groups & 4)
+		n += 24;
+	return n <= bytes ? n : 0;
+}
+
+/* Diagnostic recognition only, never admission. No search or payload dump. */
+static inline bool
+mt6797_eapol_candidate(const unsigned char *packet, size_t bytes)
+{
+	size_t off = mt6797_eapol_rxd_bytes(packet, bytes);
+	const unsigned char *f;
+
+	if (!off)
+		return false;
+	if (packet[6] & 0x40)
+		off += 2;
+	if (off > bytes)
+		return false;
+	f = packet + off;
+	return (bytes - off >= 18 && f[12] == 0x88 && f[13] == 0x8e && f[15] == 3) ||
+	       (bytes - off >= 36 && f[24] == 0xaa && f[25] == 0xaa &&
+		f[26] == 3 && !f[27] && !f[28] && !f[29] &&
+		f[30] == 0x88 && f[31] == 0x8e && f[33] == 3) ||
+	       (MT6797_EAPOL_RX_QOS_BIT && bytes - off >= 38 &&
+		f[26] == 0xaa && f[27] == 0xaa && f[28] == 3 && !f[29] && !f[30] &&
+		!f[31] && f[32] == 0x88 && f[33] == 0x8e && f[35] == 3);
+}
+
+const char *mt6797_eapol_gate_name(enum mt6797_eapol_gate gate)
+{
+	switch (gate) {
+	case MT6797_EAPOL_OK:
+		return "ok";
+	case MT6797_EAPOL_INPUT:
+		return "input";
+	case MT6797_EAPOL_BYTE_COUNT:
+		return "rxd-byte-count";
+	case MT6797_EAPOL_PACKET_TYPE:
+		return "packet-type";
+	case MT6797_EAPOL_CHANNEL:
+		return "channel";
+	case MT6797_EAPOL_WLAN_MATCH:
+		return "rxd-byte4";
+	case MT6797_EAPOL_MSDU_FORMAT:
+		return "msdu-format";
+	case MT6797_EAPOL_BSS:
+		return "bss";
+	case MT6797_EAPOL_FORMAT:
+		return "rxd-byte8";
+	case MT6797_EAPOL_SECURITY:
+		return "rxd-byte9";
+	case MT6797_EAPOL_PREFIX:
+		return "prefix";
+	case MT6797_EAPOL_GROUP_BOUNDS:
+		return "group-bounds";
+	case MT6797_EAPOL_VECTOR:
+		return "vector";
+	case MT6797_EAPOL_TRANSLATED_LAYOUT:
+		return "translated-layout";
+	case MT6797_EAPOL_FRAGMENT:
+		return "fragment";
+	case MT6797_EAPOL_PEER:
+		return "peer";
+	case MT6797_EAPOL_ETHERTYPE:
+		return "ethertype";
+	case MT6797_EAPOL_NATIVE_LAYOUT:
+		return "native-layout";
+	case MT6797_EAPOL_LLC:
+		return "llc";
+	case MT6797_EAPOL_FRAME_CONTROL:
+		return "frame-control";
+	case MT6797_EAPOL_SOURCE:
+		return "source";
+	case MT6797_EAPOL_EAPOL_VERSION:
+		return "eapol-version";
+	case MT6797_EAPOL_EAPOL_TYPE:
+		return "eapol-type";
+	case MT6797_EAPOL_EAPOL_LENGTH:
+		return "eapol-length";
+	case MT6797_EAPOL_KEY_DESCRIPTOR:
+		return "key-descriptor";
+	case MT6797_EAPOL_KEY_DATA_LENGTH:
+		return "key-data-length";
+	default:
+		return "unknown";
+	}
+}
