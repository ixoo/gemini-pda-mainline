@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_MAC_H
+#define MT6797_MAC_H
+
+#include <linux/types.h>
+
+struct device;
+struct ieee80211_hw;
+struct mt6797_hif;
+struct mt6797_normal_capability;
+struct mt6797_wifi_record;
+
+/* The mac80211 layer's entry points, built in or in the mac module. */
+struct mt6797_mac_ops {
+	int (*reg)(struct device *dev, struct mt6797_hif *hif,
+		   const struct mt6797_normal_capability *capability,
+		   const struct mt6797_wifi_record *record, bool reattach,
+		   struct ieee80211_hw **out);
+	void (*scan_ready)(struct ieee80211_hw *hw);
+	void (*unreg)(struct ieee80211_hw *hw);
+};
+
+extern const struct mt6797_mac_ops mt6797_mac_attach_ops;
+
+/* Attach the mac80211 layer to the firmware the CONSYS owner started:
+ * record, registration, the initial TC4 accounting pair, then scan ready.
+ * A re-attach after a detach keeps the firmware's configuration and the
+ * TC4 baseline: the layer neither replays the record nor repeats the pair,
+ * and continues the boot's command sequence. -ENODEV before the firmware is
+ * ready, -EBUSY while attached or after a failed attach.
+ */
+int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops);
+
+/* Detach a successfully attached mac80211 layer: unregister and free it,
+ * then allow a new attach. The firmware stays started.
+ */
+void mt6797_consys_wlan_detach(const struct mt6797_mac_ops *ops);
+
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/main.c b/drivers/net/wireless/mediatek/mt6797/main.c
new file mode 100644
index 000000000..535b1d516
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/main.c
@@ -0,0 +1,1996 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6797 WLAN mac80211 station driver: registration, mac80211
+ * operations, scan and regulatory configuration.
+ */
+
+#include "mac-priv.h"
+
+static bool mt6797_mac_finish_scan(struct mt6797_mac *mac, int *status,
+				   bool cancel);
+
+/* Fixed 20 MHz set: channels 1-13 and non-DFS UNII-1 channels 36-48. */
+static inline unsigned int mt6797_channel_number(unsigned int slot)
+{
+	if (slot < MT6797_2G_CHANNELS)
+		return slot + 1;
+	if (slot < MT6797_CHANNELS)
+		return 36 + 4 * (slot - MT6797_2G_CHANNELS);
+	return 0;
+}
+
+static inline int mt6797_channel_slot(unsigned int channel)
+{
+	if (channel >= 1 && channel <= MT6797_2G_CHANNELS)
+		return channel - 1;
+	if (channel >= 36 && channel <= 48 && !(channel % 4))
+		return MT6797_2G_CHANNELS + (channel - 36) / 4;
+	return -1;
+}
+
+static inline int
+mt6797_regulatory_ranges(const struct mt6797_channel_limit *channels,
+			 bool passive, unsigned char *output)
+{
+	unsigned int i = 0, slot = 0, first, count;
+	unsigned char *band;
+
+	while (i < MT6797_CHANNELS) {
+		if (!channels[i].enabled || (passive && !channels[i].no_ir)) {
+			i++;
+			continue;
+		}
+		first = i++;
+		while (i < MT6797_CHANNELS && i != MT6797_2G_CHANNELS &&
+		       channels[i].enabled &&
+		       (!passive || channels[i].no_ir))
+			i++;
+		count = i - first;
+		if (slot == 6)
+			return -E2BIG;
+		band = output + 4 + 8 * slot++;
+		/* Source classes 81 (2.4 GHz) and 115 (non-DFS UNII-1). */
+		band[0] = first < MT6797_2G_CHANNELS ? 81 : 115;
+		band[1] = first < MT6797_2G_CHANNELS ? 1 : 2;
+		band[2] = first < MT6797_2G_CHANNELS ? 1 : 4;
+		band[3] = mt6797_channel_number(first);
+		band[4] = count;
+	}
+	return 0;
+}
+
+/* Source wire layouts: two 56-byte domains and CID 0x38's 32-byte control.
+ * Only the fixed 2.4 GHz and non-DFS UNII-1 20 MHz set is represented.
+ * Disabled channels are absent from
+ * both domain lists; their minimum power byte is not an RF-disable mechanism.
+ * NO_IR channels appear in the passive list as well as the ordinary list.
+ * A complete failed encoding returns a zero result and must gate all RF.
+ */
+static inline int
+mt6797_regulatory_encode(const struct mt6797_channel_limit *channels,
+			 const char alpha2[2],
+			 struct mt6797_regulatory_payloads *result)
+{
+	struct mt6797_regulatory_payloads built = {0};
+	unsigned int i;
+	int error, power, unii1_power = 63;
+
+	if (!result)
+		return -EINVAL;
+	memset(result, 0, sizeof(*result));
+	if (!channels || !alpha2)
+		return -EINVAL;
+	if (!((alpha2[0] >= 'A' && alpha2[0] <= 'Z' &&
+	       alpha2[1] >= 'A' && alpha2[1] <= 'Z') ||
+	      (alpha2[0] == '0' && alpha2[1] == '0')))
+		return -EINVAL;
+	built.domain[0] = alpha2[1];
+	built.passive[0] = alpha2[1];
+	built.domain[1] = alpha2[0];
+	built.passive[1] = alpha2[0];
+	built.passive[2] = 1;
+	built.domain[52] = 1;
+	built.passive[52] = 1; /* 20 MHz only. */
+	built.domain[53] = 1;
+	built.passive[53] = 1;
+	/* Source concurrency policy 1 selects the lower power, not the higher. */
+	built.power[8] = 1;
+	memset(built.power + 12, 0xc0, 18); /* -64 half-dBm units. */
+	for (i = 0; i < MT6797_CHANNELS; i++) {
+		if (!channels[i].enabled)
+			continue;
+		power = channels[i].max_power_dbm;
+		if (power < -32 || power > 31)
+			return -ERANGE;
+		if (i < MT6797_2G_CHANNELS)
+			built.power[12 + i] = (unsigned char)(2 * power);
+		else if (2 * power < unii1_power)
+			unii1_power = 2 * power;
+	}
+	/* CID 0x38 has one limit for all four UNII-1 channels, not per-channel
+	 * 5 GHz limits. Use the minimum of enabled channels; retain -64 when
+	 * none is enabled. The other three 5 GHz groups stay outside the domain.
+	 */
+	if (unii1_power != 63)
+		built.power[26] = (unsigned char)unii1_power;
+
+	error = mt6797_regulatory_ranges(channels, true, built.passive);
+	if (!error)
+		error = mt6797_regulatory_ranges(channels, false, built.domain);
+	if (error)
+		return error;
+	*result = built;
+	return 0;
+}
+
+/* One exclusive AIS BSS (0), own-MAC slot 1, unencrypted BMC slot 0.
+ * These slots remain reserved until the retained firmware session ends.
+ * This is a submission layout, never an activation acknowledgment.
+ */
+void
+mt6797_scan_bss(const unsigned char *mac, bool active, unsigned char output[12])
+{
+	unsigned int i;
+
+	for (i = 0; i < 12; i++)
+		output[i] = 0;
+	output[1] = active;
+	output[3] = 1;
+	for (i = 0; i < 6; i++)
+		output[4 + i] = mac[i];
+}
+
+/* Passive-only V2, no SSID, probe, IE, random address or reserved extension.
+ * Caller has checked each channel against current cfg80211 permissions.
+ */
+static inline int
+mt6797_scan_request(unsigned int sequence, const unsigned int *channels,
+		    unsigned int count, unsigned char *output)
+{
+	unsigned int i;
+
+	if (!output || !channels || !sequence || sequence > 255 ||
+	    count != 1 || mt6797_channel_slot(channels[0]) < 0)
+		return -EINVAL;
+	for (i = 0; i < MT6797_PASSIVE_SCAN_BYTES; i++)
+		output[i] = 0;
+	output[0] = sequence;
+	/* The retained passive decoder carries this halfword into a timer
+	 * that converts milliseconds to 32768 Hz ticks. Request several
+	 * beacon intervals on one channel; this does not prove RF tuning.
+	 */
+	output[154] = MT6797_PASSIVE_SCAN_DWELL_MS & 0xff;
+	output[155] = MT6797_PASSIVE_SCAN_DWELL_MS >> 8;
+	output[158] = 4; /* SCAN_CHANNEL_SPECIFIED */
+	output[159] = count;
+	for (i = 0; i < count; i++) {
+		output[160 + 2 * i] = channels[i] <= MT6797_2G_CHANNELS ? 1 : 2;
+		output[161 + 2 * i] = channels[i];
+	}
+	return 0;
+}
+
+/* Match the payload scan sequence before any caller state changes. The
+ * retained image's ordinary constructor emits 24 bytes and outer sequence 0.
+ * A normal completion is not a cancellation or event-drain acknowledgment.
+ */
+static inline int
+mt6797_scan_done(const unsigned char *packet, size_t bytes,
+		 unsigned int sequence, unsigned int channel_count)
+{
+	if (!packet || bytes != 24 || mt6797_normal_le16(packet) != bytes ||
+	    mt6797_normal_le16(packet + 2) != 0xe000 || packet[4] != 0x0d ||
+	    packet[5] || !sequence || sequence > 255 ||
+	    !channel_count || channel_count > MT6797_PASSIVE_SCAN_CHANNELS)
+		return -EPROTO;
+	if (packet[8] != sequence)
+		return -EAGAIN;
+	if (packet[13] != 7 || packet[12] != channel_count)
+		return -EPROTO;
+	return 0;
+}
+
+/* Only native unprotected beacon/probe-response management frames. The RX
+ * groups occur in wire order 4,1,2,3, with source-defined sizes 16,16,8,24.
+ * Never reinterpret translated Ethernet data or incomplete metadata as 802.11.
+ */
+int
+mt6797_scan_frame(const unsigned char *packet, size_t bytes,
+		  struct mt6797_scan_frame *frame)
+{
+	unsigned int type, groups, fc, flags, rcpi;
+	size_t offset = 16, vector = 0;
+
+	if (!frame)
+		return -EINVAL;
+	*frame = (struct mt6797_scan_frame){0};
+	if (!packet || bytes < 16 || mt6797_normal_le16(packet) != bytes)
+		return -EPROTO;
+	type = mt6797_normal_le16(packet + 2);
+	if ((type & 0xe00f) != 0xe001)
+		return -EOPNOTSUPP;
+	groups = (type >> 9) & 15;
+	if (groups & 8)
+		offset += 16;
+	if (groups & 1)
+		offset += 16;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4) {
+		vector = offset;
+		offset += 24;
+	}
+	if (offset > bytes)
+		return -EPROTO;
+	if (packet[6] & 0x40)
+		offset += 2;
+	if (offset > bytes || bytes - offset < 36)
+		return -EPROTO;
+	flags = mt6797_normal_le16(packet + 10);
+	if ((packet[6] & 0x80) || (packet[6] & 0x3f) != 24 ||
+	    (packet[9] & 0xf0) || (packet[7] & 3) || (flags & 0x07fe))
+		return -EOPNOTSUPP;
+	fc = mt6797_normal_le16(packet + offset);
+	if ((fc & 0x00ff) != 0x0080 && (fc & 0x00ff) != 0x0050)
+		return -EOPNOTSUPP;
+	if ((fc & 0xc700) || (mt6797_normal_le16(packet + offset + 22) & 15))
+		/* No DS, fragmentation, protection or HT-control interpretation. */
+		return -EOPNOTSUPP;
+	if (!vector)
+		return -EOPNOTSUPP;
+	rcpi = packet[vector + 9];
+	if (rcpi > 220 || mt6797_channel_slot(packet[5]) < 0)
+		return -EOPNOTSUPP;
+	frame->offset = offset;
+	frame->bytes = bytes - offset;
+	frame->channel = packet[5];
+	frame->rcpi = rcpi;
+	return 0;
+}
+
+static const u32 mt6797_ccmp_ciphers[] = { WLAN_CIPHER_SUITE_CCMP };
+
+int mt6797_mac_send(struct mt6797_mac *mac,
+		    enum mt6797_normal_config_kind kind,
+			   const u8 *payload, size_t bytes)
+{
+	int ret;
+
+	if (mac->first_error)
+		return mac->first_error;
+	/* The finite retained history is not reset or treated as a refill. */
+	if (mac->sequence > 255)
+		ret = -ENOSPC;
+	else
+		ret = mt6797_hif_send_config(mac->hif, kind, mac->sequence++,
+					     payload, bytes,
+					     ktime_get_ns() + NSEC_PER_SEC);
+	if (ret)
+		mac->first_error = ret;
+	return ret;
+}
+
+static int mt6797_mac_policy(struct mt6797_mac *mac,
+			     struct mt6797_regulatory_payloads *payloads)
+{
+	struct mt6797_channel_limit limits[MT6797_CHANNELS] = {0};
+	struct ieee80211_channel *channel;
+	unsigned int i;
+
+	ASSERT_RTNL();
+	for (i = 0; i < MT6797_CHANNELS; i++) {
+		channel = &mac->channels[i];
+		limits[i].enabled = !(channel->flags &
+			(IEEE80211_CHAN_DISABLED | IEEE80211_CHAN_NO_20MHZ |
+			 IEEE80211_CHAN_RADAR));
+		limits[i].no_ir = !!(channel->flags & IEEE80211_CHAN_NO_IR);
+		limits[i].max_power_dbm = channel->max_power;
+	}
+	return mt6797_regulatory_encode(limits, mac->alpha2, payloads);
+}
+
+static int mt6797_mac_domains(struct mt6797_mac *mac,
+			      const struct mt6797_regulatory_payloads *policy)
+{
+	int ret;
+
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_DOMAIN,
+			      policy->passive, sizeof(policy->passive));
+	if (!ret)
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_DOMAIN,
+				      policy->domain, sizeof(policy->domain));
+	return ret;
+}
+
+/* A regulatory update while the join lifetime is in use. cfg80211 calls the
+ * notifier when it restores its regulatory settings after every interface
+ * has disconnected (regulatory_hint_disconnect), so this callback can retire
+ * a running lifetime silently, with frames in flight and keys installed. A
+ * running lifetime now ends through the one terminal path (branch 9), so the
+ * footer makes the notifier's involvement observable and the frames are
+ * freed exactly once; a lifetime already ended is retired as before without a
+ * second footer. Called with the mutex held; the caller frees the discard
+ * list after unlocking. Returns true when the lifetime was in use.
+ */
+static bool mt6797_mac_join_regulatory_stop(struct mt6797_mac *mac,
+					    struct sk_buff_head *discard,
+					    struct sk_buff **internal)
+{
+	unsigned long flags;
+
+	if (!mac->join_scan_ready && !mac->join_peer_used)
+		return false;
+	/* 0180: a healthy quiescent terminal (stage-3 cleanup done: reserved TX retired,
+	 * keys removed, channel returned, no active TX) makes the expected idle
+	 * regulatory restore benign; do not poison it, so a subsequent fresh
+	 * scan/beacon re-admits normally. An active lifetime still retires.
+	 */
+	if (mac->join_cleanup_done)
+		return false;
+	if (mac->join_running && !mac->join_retired) {
+		mt6797_mac_join_fail_stop(mac, -ECANCELED, 9, discard, internal);
+		return true;
+	}
+	mac->first_error = -ECANCELED;
+	mac->closing = true;
+	mac->join_retired = true;
+	mac->join_credit_pending = false;
+	mac->join_channel_pending = false;
+	mac->join_sta_pending = false;
+	complete_all(&mac->join_credit_done);
+	complete_all(&mac->join_frame_done);
+	complete_all(&mac->join_channel_done);
+	complete_all(&mac->join_sta_done);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	return true;
+}
+
+static void mt6797_mac_regulatory(struct wiphy *wiphy,
+				  struct regulatory_request *request)
+{
+	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
+	struct mt6797_mac *mac = hw->priv;
+	struct mt6797_regulatory_payloads policy;
+	struct sk_buff_head discard;
+	struct sk_buff *skb __maybe_unused, *internal __maybe_unused = NULL;
+	int ret;
+
+	skb_queue_head_init(&discard);
+	/* cfg80211 updates the channel flags/power before this RTNL callback.
+	 * It may also call us before ieee80211_register_hw() returns.
+	 */
+	ASSERT_RTNL();
+	mutex_lock(&mac->mutex);
+	if (mac->closing || mac->first_error)
+		goto out;
+	if (mt6797_mac_join_regulatory_stop(mac, &discard, &internal))
+		goto out;
+	/* Regulatory changes retire an accepted scan before submitting updates.
+	 * Host completion does not claim firmware cancellation or queue drain.
+	 */
+	if (mac->scan_active) {
+		struct cfg80211_scan_info info = {.aborted = true};
+		int cancelled = -ECANCELED;
+
+		mt6797_mac_finish_scan(mac, &cancelled, true);
+		ieee80211_scan_completed(mac->hw, &info);
+		goto out;
+	}
+	if ((request->alpha2[0] >= 'A' && request->alpha2[0] <= 'Z' &&
+	     request->alpha2[1] >= 'A' && request->alpha2[1] <= 'Z') ||
+	    (request->alpha2[0] == '0' && request->alpha2[1] == '0'))
+		memcpy(mac->alpha2, request->alpha2, 2);
+	else
+		memcpy(mac->alpha2, "00", 2);
+	/* Before configuration, save the tag only. The initial transaction
+	 * reads the effective channels again under RTNL, after registration.
+	 */
+	if (!mac->configured)
+		goto out;
+	ret = mt6797_mac_policy(mac, &policy);
+	if (!ret)
+		ret = mt6797_mac_domains(mac, &policy);
+	if (!ret)
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_TX_CTRL,
+				      policy.power, sizeof(policy.power));
+	if (ret) {
+		mac->first_error = ret;
+		dev_err(wiphy_dev(wiphy), "regulatory submission stopped (%d)\n", ret);
+	}
+out:
+	mutex_unlock(&mac->mutex);
+	while ((skb = __skb_dequeue(&discard))) {
+		if (skb == internal)
+			dev_kfree_skb(skb);
+		else
+			ieee80211_free_txskb(mac->hw, skb);
+	}
+}
+
+static int mt6797_mac_scan_guard(struct mt6797_mac *mac, u64 deadline)
+{
+	struct mt6797_hif_tx_status status;
+	struct mt6797_normal_release account;
+	u32 wcir, own;
+	int ret;
+
+	ret = mt6797_hif_read32(mac->hif, 0, deadline, &wcir);
+	if (!ret && ((wcir & 0xffff) != 0x0279 || !(wcir & BIT(21))))
+		ret = -EIO;
+	if (!ret)
+		ret = mt6797_hif_read32(mac->hif, 4, deadline, &own);
+	if (!ret && !(own & BIT(8)))
+		ret = -EACCES;
+	if (!ret)
+		ret = mt6797_hif_reconcile_runtime(mac->hif, deadline, &status, &account);
+	if (!ret)
+		mac->scan_credit |= !!account.released_pages;
+	return ret;
+}
+
+/* Stop exactly one accepted host request. The scan/BSS slots remain retired
+ * even after normal completion: no unproved cancellation/reuse fence is used.
+ * Never submit cleanup after a transport, ownership or protocol failure.
+ */
+static bool mt6797_mac_finish_scan(struct mt6797_mac *mac, int *status,
+				   bool cancel)
+{
+	u8 bss[12], abort[4] = {1, 0, 0, 0};
+	bool retain = false;
+	int ret;
+
+	if (!mac->scan_active)
+		return false;
+	/* Close establishes this fence under the same mutex before cancellation. */
+	if (mac->join_retired && !*status)
+		*status = -ECANCELED;
+	mac->scan_active = false;
+	mac->join_scan_ready = false;
+	if (!cancel && !*status && !mac->first_error) {
+		if (!mac->bss_active || mac->join_retired || mac->scan_count != 1 ||
+		    mac->scan_channels != BIT(mt6797_channel_slot(40)) ||
+		    !mt6797_hif_normal_idle(mac->hif)) {
+			*status = -EPROTO;
+			mac->first_error = *status;
+		} else {
+			unsigned long flags;
+
+			retain = true;
+			mac->join_scan_ready = true;
+			mac->join_deadline = ktime_get_ns() + 10 * NSEC_PER_SEC;
+			spin_lock_irqsave(&mac->join_queue.lock, flags);
+			mac->join_running = true;
+			/* Poll asynchronous input; management TX remains closed. */
+			schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
+			spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		}
+	}
+	if (cancel && !mac->first_error) {
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_SCAN_CANCEL,
+				      abort, sizeof(abort));
+		if (ret)
+			*status = ret;
+	}
+	if (!retain && mac->bss_active && !mac->first_error) {
+		mt6797_scan_bss(mac->hw->wiphy->perm_addr, false, bss);
+		ret = mt6797_mac_send(mac, MT6797_NORMAL_BSS_ACTIVE,
+				      bss, sizeof(bss));
+		if (ret)
+			*status = ret;
+		else
+			mac->bss_active = false;
+	}
+	if (*status && !mac->first_error)
+		mac->first_error = *status;
+	memzero_explicit(mac->scan_packet, sizeof(mac->scan_packet));
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot passive WLAN scan: status=%d complete=%u frame=%u beacon=%u credit=%u retired=1\n",
+		 *status, !*status, mac->scan_frame_seen, mac->scan_beacon, mac->scan_credit);
+	return true;
+}
+
+static int mt6797_mac_scan_packet(struct mt6797_mac *mac, size_t bytes,
+				  u64 deadline, bool *done,
+				  struct sk_buff_head *received)
+{
+	struct ieee80211_rx_status *status;
+	struct mt6797_scan_frame frame;
+	struct ieee80211_channel *channel;
+	struct sk_buff *skb;
+	u8 *packet = mac->scan_packet;
+	u32 own;
+	unsigned int type;
+	int ret, slot;
+
+	if (bytes < 4)
+		return -EPROTO;
+	type = mt6797_normal_le16(packet + 2);
+	if (type == 0xe000) {
+		if (bytes < 8)
+			return -EPROTO;
+		switch (packet[4]) {
+		case 0x0d:
+			ret = mt6797_scan_done(packet, bytes, 1, mac->scan_count);
+			if (ret == -EAGAIN)
+				return 0;
+			if (!ret)
+				*done = true;
+			return ret;
+		case 0x27: /* debug: retain no body or diagnostic strings */
+			return 0;
+		case 0x07: /* sleepy notification, never a handoff request */
+			if (bytes != 12 || packet[8] > 1)
+				return -EPROTO;
+			ret = mt6797_hif_read32(mac->hif, 4, deadline, &own);
+			if (ret)
+				return ret;
+			return own & BIT(8) ? 0 : -EACCES;
+		case 0x11:
+			/* EVENT_ID_BSS_ABSENCE_PRESENCE: an unsolicited notice the
+			 * firmware emits for a BSS it still tracks. The second
+			 * lifetime's scan receives the previous BSS's notice here;
+			 * it is a state change the scan does not depend on, so it
+			 * is ignored.
+			 */
+			return 0;
+		default:
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot passive WLAN unknown event: len=%zu id=0x%02x seq=%u\n",
+				 bytes, packet[4], packet[5]);
+			return -EPROTO;
+		}
+	}
+	mac->scan_frame_seen = true;
+	ret = mt6797_scan_frame(packet, bytes, &frame);
+	if (ret == -EOPNOTSUPP)
+		return 0; /* unsupported data/control frames are never delivered */
+	if (ret)
+		return ret;
+	slot = mt6797_channel_slot(frame.channel);
+	if (slot < 0 || !(mac->scan_channels & BIT(slot)))
+		return -EPROTO;
+	channel = &mac->channels[slot];
+	if (channel->flags & (IEEE80211_CHAN_DISABLED |
+			      IEEE80211_CHAN_NO_20MHZ | IEEE80211_CHAN_RADAR))
+		return -EACCES;
+	/* Hand the validated beacon or probe response to mac80211 as a received
+	 * frame instead of informing cfg80211 directly: mac80211 then creates
+	 * the cfg80211 entry itself and fills its own BSS record (supported and
+	 * basic rates) that a later connection setup reads. The caller delivers
+	 * the queue outside the MAC lock, before completing the scan. RCPI is
+	 * in half-dB units. The scan result carries no PHY rate observation, so
+	 * the zeroed rate index (the band's lowest legacy rate) is a placeholder
+	 * that mac80211 requires, not a measurement; no timestamp is claimed.
+	 */
+	skb = dev_alloc_skb(frame.bytes);
+	if (!skb)
+		return -ENOMEM;
+	skb_put_data(skb, packet + frame.offset, frame.bytes);
+	status = IEEE80211_SKB_RXCB(skb);
+	memset(status, 0, sizeof(*status));
+	status->band = channel->band;
+	status->freq = channel->center_freq;
+	status->signal = (int)frame.rcpi / 2 - 110;
+	__skb_queue_tail(received, skb);
+	mac->scan_beacon = true;
+	return 0;
+}
+
+static void mt6797_mac_scan_work(struct work_struct *work)
+{
+	struct mt6797_mac *mac = container_of(to_delayed_work(work),
+						struct mt6797_mac, scan_work);
+	struct mt6797_hif_rx_result rx;
+	struct cfg80211_scan_info info = {0};
+	struct sk_buff_head received;
+	struct sk_buff *skb;
+	u64 deadline, now;
+	unsigned int n, port;
+	bool done = false, notify = false, cancel = false;
+	int ret = 0;
+
+	skb_queue_head_init(&received);
+	mutex_lock(&mac->mutex);
+	if (!mac->scan_active)
+		goto out;
+	now = ktime_get_ns();
+	if (now >= mac->scan_deadline || ++mac->scan_polls > 256) {
+		ret = -ETIMEDOUT;
+		cancel = true;
+		goto finish;
+	}
+	deadline = min_t(u64, now + 100 * NSEC_PER_MSEC, mac->scan_deadline);
+	ret = mt6797_mac_scan_guard(mac, deadline);
+	if (ret)
+		goto failed;
+	/* Alternate ports, at most sixteen packets per tick and 4096 overall.
+	 * Finish this bounded tick after a done event so the other port is not
+	 * skipped. This is not an event-drain fence. Empty polls consume no RX.
+	 */
+	mt6797_hif_rx_batch_pass(mac->hif);
+	for (n = 0; n < 8; n++) {
+		bool got = false;
+
+		for (port = 0; port < 2; port++) {
+			ret = mt6797_hif_receive_runtime_packet(mac->hif, port, deadline,
+								mac->scan_packet,
+								sizeof(mac->scan_packet), &rx);
+			if (ret == -EAGAIN) {
+				ret = 0;
+				continue;
+			}
+			if (ret)
+				goto failed;
+			if (++mac->scan_packets > 4096) {
+				ret = -E2BIG;
+				goto failed;
+			}
+			got = true;
+			ret = mt6797_mac_scan_packet(mac, rx.logical_bytes, deadline, &done,
+						     &received);
+			if (ret)
+				goto failed;
+		}
+		if (!got)
+			break;
+	}
+	if (done)
+		goto finish;
+	schedule_delayed_work(&mac->scan_work, msecs_to_jiffies(20));
+	goto out;
+failed:
+	/* Unknown wire state, failed read or lost ownership: no further I/O. */
+	mac->first_error = ret;
+finish:
+	notify = mt6797_mac_finish_scan(mac, &ret, cancel);
+	info.aborted = !!ret;
+out:
+	mutex_unlock(&mac->mutex);
+	/* Frames of a failed lifetime are dropped; the rest reach mac80211 while
+	 * the hardware scan is still in progress, so its scan receive path
+	 * records them before the completion below.
+	 */
+	mutex_lock(&mac->ccmp_receive_mutex);
+	while ((skb = __skb_dequeue(&received))) {
+		if (ret)
+			dev_kfree_skb(skb);
+		else
+			mt6797_ccmp_receive(mac, skb);
+	}
+	mutex_unlock(&mac->ccmp_receive_mutex);
+	if (notify)
+		ieee80211_scan_completed(mac->hw, &info);
+}
+
+static int mt6797_mac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			      struct ieee80211_scan_request *request)
+{
+	struct mt6797_mac *mac = hw->priv;
+	struct ieee80211_channel *channel;
+	unsigned int channels[MT6797_PASSIVE_SCAN_CHANNELS], mask = 0, i;
+	u8 payload[MT6797_PASSIVE_SCAN_BYTES], bss[12];
+	u8 broadcast[4] = {8, 0, 0, 0};
+	int ret = -EOPNOTSUPP, slot;
+
+	mutex_lock(&mac->mutex);
+	if (!mac->scan_ready || !mac->started || mac->vif != vif ||
+	    mac->closing || mac->first_error || mac->join_closed)
+		goto out;
+	/* One scan per lifetime: a request while this lifetime's scan is live
+	 * or still awaiting its join is busy, not a submission fault. mac80211
+	 * reports it and the supplicant retries.
+	 */
+	if (mac->scan_used) {
+		ret = -EBUSY;
+		goto out;
+	}
+	/* mac80211 may append supported-rate IEs internally. There are no
+	 * probe requests in this passive form, so no IEs are transmitted.
+	 */
+	/* This hint only selects a 6 GHz follow-up. No 6 GHz channel or
+	 * parameter is admitted below, so it adds no firmware operation.
+	 */
+	if (request->req.n_ssids ||
+	    (request->req.flags & ~NL80211_SCAN_FLAG_COLOCATED_6GHZ) ||
+	    request->req.duration ||
+	    request->req.duration_mandatory || request->req.scan_6ghz ||
+	    request->req.n_6ghz_params ||
+	    !is_broadcast_ether_addr(request->req.bssid) ||
+	    request->req.n_channels != 1)
+		goto out;
+	for (i = 0; i < request->req.n_channels; i++) {
+		channel = request->req.channels[i];
+		if (!channel)
+			goto out;
+		slot = mt6797_channel_slot(channel->hw_value);
+		if (slot < 0 || channel != &mac->channels[slot] ||
+		    channel->band != (slot < MT6797_2G_CHANNELS ?
+				      NL80211_BAND_2GHZ : NL80211_BAND_5GHZ) ||
+		    (channel->flags & (IEEE80211_CHAN_DISABLED |
+				      IEEE80211_CHAN_NO_20MHZ | IEEE80211_CHAN_RADAR)))
+			goto out;
+		channels[i] = channel->hw_value;
+		mask |= BIT(slot);
+	}
+	if (!mac->sequence_base)
+		mac->sequence_base = mac->sequence;
+	ret = mt6797_scan_request(1, channels, request->req.n_channels, payload);
+	if (ret)
+		goto out;
+	/* Retire before the first write: an uncertain activation/submission
+	 * cannot be retried or treated as an effect-free rejection.
+	 */
+	mac->scan_used = true;
+	/* 0180: count the lifetime at its first effectful submission (this scan).
+	 * An idle scan hands the count back when it is retired.
+	 */
+	if (mac->join_lifetimes < U8_MAX)
+		mac->join_lifetimes++;
+	ret = mt6797_mac_scan_guard(mac, ktime_get_ns() + NSEC_PER_SEC);
+	if (ret) {
+		mac->first_error = ret;
+		goto out;
+	}
+	/* The normal gen3 RX-mode path requests broadcast reception. Send
+	 * only that supported filter word; no native/monitor selector is used.
+	 * Submission and returned command credit do not prove application.
+	 */
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_SCAN_BROADCAST,
+			      broadcast, sizeof(broadcast));
+	if (ret)
+		goto out;
+	mt6797_scan_bss(hw->wiphy->perm_addr, true, bss);
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_BSS_ACTIVE, bss, sizeof(bss));
+	if (ret)
+		goto out;
+	mac->bss_active = true;
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_SCAN_V2, payload, sizeof(payload));
+	if (ret)
+		goto out;
+	mac->scan_channels = mask;
+	mac->scan_count = request->req.n_channels;
+	mac->scan_deadline = ktime_get_ns() + 5 * NSEC_PER_SEC;
+	mac->scan_active = true;
+	dev_info(wiphy_dev(hw->wiphy), "one-shot passive WLAN scan: admitted=1\n");
+	schedule_delayed_work(&mac->scan_work, 0);
+out:
+	if (ret && ret != -EBUSY && mac->scan_used)
+		dev_err(wiphy_dev(hw->wiphy),
+			"one-shot passive WLAN submission stopped: status=%d\n", ret);
+	mutex_unlock(&mac->mutex);
+	return ret;
+}
+
+static void mt6797_mac_cancel_scan(struct ieee80211_hw *hw,
+				   struct ieee80211_vif *vif)
+{
+	struct mt6797_mac *mac = hw->priv;
+	struct cfg80211_scan_info info = {.aborted = true};
+	bool notify;
+	int ret = -ECANCELED;
+	bool close_join;
+	unsigned long flags;
+
+	mutex_lock(&mac->mutex);
+	/* Cancellation can race the queued host completion after scan_active clears. */
+	mac->join_retired = true;
+	close_join = mac->join_scan_ready || mac->join_running || mac->join_peer_used;
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	notify = mt6797_mac_finish_scan(mac, &ret, true);
+	mutex_unlock(&mac->mutex);
+	cancel_delayed_work_sync(&mac->scan_work);
+	if (close_join)
+		mt6797_mac_join_close(mac);
+	if (notify)
+		ieee80211_scan_completed(hw, &info);
+}
+
+/* A passive scan interface is not an associated station or a data path. */
+static int mt6797_mac_start(struct ieee80211_hw *hw)
+{
+	struct mt6797_mac *mac = hw->priv;
+	int ret = -EOPNOTSUPP;
+
+	mutex_lock(&mac->mutex);
+	if (mac->scan_ready && mac->configured && !mac->closing &&
+	    !mac->first_error && !mac->join_closed) {
+		mac->started = true;
+		ret = 0;
+	}
+	mutex_unlock(&mac->mutex);
+	return ret;
+}
+
+static void mt6797_mac_stop(struct ieee80211_hw *hw, bool suspend)
+{
+	struct mt6797_mac *mac = hw->priv;
+
+	mt6797_mac_join_close(mac);
+	mt6797_mac_cancel_scan(hw, NULL);
+	mutex_lock(&mac->mutex);
+	mac->started = false;
+	mutex_unlock(&mac->mutex);
+}
+
+static int mt6797_mac_add_interface(struct ieee80211_hw *hw,
+				    struct ieee80211_vif *vif)
+{
+	struct mt6797_mac *mac = hw->priv;
+	int ret = -EOPNOTSUPP;
+
+	mutex_lock(&mac->mutex);
+	if (mac->scan_ready && !mac->vif && !mac->scan_used &&
+	    !mac->closing && !mac->first_error &&
+	    vif->type == NL80211_IFTYPE_STATION &&
+	    ether_addr_equal(vif->addr, hw->wiphy->perm_addr)) {
+		vif->driver_flags |= IEEE80211_VIF_BEACON_FILTER;
+		mac->vif = vif;
+		ret = 0;
+	}
+	mutex_unlock(&mac->mutex);
+	return ret;
+}
+
+static void mt6797_mac_remove_interface(struct ieee80211_hw *hw,
+					struct ieee80211_vif *vif)
+{
+	struct mt6797_mac *mac = hw->priv;
+
+	mt6797_mac_join_close(mac);
+	mt6797_mac_cancel_scan(hw, vif);
+	mutex_lock(&mac->mutex);
+	if (mac->vif == vif)
+		vif->driver_flags &= ~IEEE80211_VIF_BEACON_FILTER;
+	mac->vif = NULL;
+	/* Retain the wire BSS lifetime through recovery, never reuse its slot. */
+	mac->closing = true;
+	mutex_unlock(&mac->mutex);
+}
+
+static int mt6797_mac_config(struct ieee80211_hw *hw, int radio_idx, u32 changed)
+{
+	struct mt6797_mac *mac = hw->priv;
+	int ret = 0;
+
+	mutex_lock(&mac->mutex);
+	/* No operating channel or host TX is established by this scan-only
+	 * interface. Firmware owns tuning only during the admitted hw_scan.
+	 */
+	/* mac80211 passes radio_idx -1 for a wiphy without per-radio
+	 * configuration; only a radio-specific request is unsupported here.
+	 */
+	if (!mac->scan_ready || mac->first_error || mac->closing || radio_idx != -1 ||
+	    (hw->conf.flags & (IEEE80211_CONF_PS | IEEE80211_CONF_MONITOR)))
+		ret = -EOPNOTSUPP;
+	{
+		const struct cfg80211_chan_def *def = &hw->conf.chandef;
+		const struct ieee80211_channel *channel = def->chan;
+		int slot = channel ? mt6797_channel_slot(channel->hw_value) : -1;
+
+		mac->join_channel_valid = !ret && slot >= MT6797_2G_CHANNELS &&
+			slot < MT6797_CHANNELS &&
+			channel == &mac->channels[slot] &&
+			channel->band == NL80211_BAND_5GHZ &&
+			channel->hw_value == 40 && channel->center_freq == 5200 &&
+			(((def->width == NL80211_CHAN_WIDTH_20_NOHT ||
+			   def->width == NL80211_CHAN_WIDTH_20) &&
+			  def->center_freq1 == 5200) ||
+			 /* HT40 below: secondary channel 36 (0323). */
+			 (def->width == NL80211_CHAN_WIDTH_40 &&
+			  def->center_freq1 == 5190)) && !def->center_freq2 &&
+			!(channel->flags & (IEEE80211_CHAN_DISABLED |
+				IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_NO_20MHZ |
+				IEEE80211_CHAN_RADAR));
+		/* Diagnostic only: name the first rejected 5 GHz operating
+		 * channel so a refused join can be attributed offline.
+		 */
+		if (!mac->join_channel_valid && channel &&
+		    channel->band == NL80211_BAND_5GHZ &&
+		    !mac->join_channel_refusal_logged) {
+			mac->join_channel_refusal_logged = true;
+			dev_info(wiphy_dev(hw->wiphy),
+				 "one-shot WLAN join channel refused: hw=%u center=%u width=%u freq1=%u freq2=%u flags=0x%x config=%d\n",
+				 channel->hw_value, channel->center_freq, def->width,
+				 def->center_freq1, def->center_freq2, channel->flags, ret);
+		}
+		mac->join_sco = mac->join_channel_valid &&
+			def->width == NL80211_CHAN_WIDTH_40 ? 3 : 0;
+	}
+	mutex_unlock(&mac->mutex);
+	return ret;
+}
+
+static void mt6797_mac_bss_info_changed(struct ieee80211_hw *hw,
+					struct ieee80211_vif *vif,
+				      struct ieee80211_bss_conf *info,
+				      u64 changed)
+{
+	struct mt6797_mac *mac = hw->priv;
+
+	if (!(changed & (BSS_CHANGED_BSSID | BSS_CHANGED_BASIC_RATES |
+			 BSS_CHANGED_BEACON_INT)))
+		return;
+	mutex_lock(&mac->mutex);
+	mac->join_bss_valid = false;
+	if (mac->vif == vif && !ieee80211_vif_is_mld(vif) && !info->link_id &&
+	    info->bssid && is_valid_ether_addr(info->bssid) && info->beacon_int &&
+	    info->basic_rates && !(info->basic_rates & ~0xffU)) {
+		ether_addr_copy(mac->join_bssid, info->bssid);
+		mac->join_basic_rates = info->basic_rates;
+		mac->join_beacon_interval = info->beacon_int;
+		mac->join_bss_valid = true;
+	}
+	mutex_unlock(&mac->mutex);
+}
+
+static void mt6797_mac_mgd_prepare_tx(struct ieee80211_hw *hw,
+				      struct ieee80211_vif *vif,
+				      struct ieee80211_prep_tx_info *info)
+{
+	struct mt6797_mac *mac = hw->priv;
+	unsigned long flags;
+	unsigned int subtype = info->subtype >> 4;
+	bool admitted;
+
+	mutex_lock(&mac->mutex);
+	if (mac->join_cleanup_requested || mac->join_cleanup_done) {
+		/* mac80211's own deauthentication or disassociation during the
+		 * data phase (the supplicant or userspace disconnecting) ends the
+		 * phase; the driver-owned deauthentication goes out and mac80211's
+		 * frame is not admitted by the queue gate.
+		 */
+		if (vif == mac->vif && mac->join_data_phase && !mac->join_data_ended &&
+		    (info->subtype == IEEE80211_STYPE_DEAUTH ||
+		     info->subtype == IEEE80211_STYPE_DISASSOC))
+			mt6797_mac_join_end_data(mac, "disconnect");
+		mutex_unlock(&mac->mutex);
+		return;
+	}
+	admitted = vif == mac->vif && !vif->valid_links && !info->link_id &&
+		   mac->join_peer_ready && mac->join_running &&
+		   !mac->join_retired && !mac->closing && !mac->first_error &&
+		   mac->join_channel_valid && mac->join_bss_valid &&
+		   mac->join_channel_granted &&
+		   ktime_get_ns() + 850 * NSEC_PER_MSEC <
+			min(mac->join_deadline, mac->join_grant_deadline) &&
+		   ((info->subtype == IEEE80211_STYPE_AUTH &&
+		     !mac->join_authenticated && !mac->join_auth_received) ||
+		    (info->subtype == IEEE80211_STYPE_ASSOC_REQ &&
+		     mac->join_authenticated && !mac->join_assoc_received));
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	admitted = admitted && mt6797_join_attempt_open(mac, subtype);
+	mac->join_open = admitted;
+	mac->join_tx_allowed = admitted ? BIT(subtype) : 0;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	if (admitted) {
+		mac->join_rx_allowed = BIT(info->subtype == IEEE80211_STYPE_AUTH ? 11 : 1) |
+				       BIT(10) | BIT(12);
+	} else {
+		if (!mac->first_error)
+			mac->first_error = -EOPNOTSUPP;
+		mac->closing = true;
+	}
+	mutex_unlock(&mac->mutex);
+}
+
+static void mt6797_mac_mgd_complete_tx(struct ieee80211_hw *hw,
+				       struct ieee80211_vif *vif,
+				       struct ieee80211_prep_tx_info *info)
+{
+	struct mt6797_mac *mac = hw->priv;
+	unsigned long flags;
+
+	mutex_lock(&mac->mutex);
+	/* A later MLME notification must not close the owned deauth queue. */
+	if (mac->join_cleanup_requested || mac->join_cleanup_done) {
+		mutex_unlock(&mac->mutex);
+		return;
+	}
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_open = false;
+	mac->join_tx_allowed = 0;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	if (!mac->join_cleanup_requested && !mac->join_cleanup_done &&
+	    vif == mac->vif && !info->link_id &&
+	    (info->subtype == IEEE80211_STYPE_ASSOC_REQ || !info->success)) {
+		int ret = mt6797_mac_join_request_cleanup(mac);
+
+		if (ret && !mac->first_error) {
+			mac->first_error = ret;
+			mac->closing = true;
+		}
+	} else if (vif != mac->vif || info->link_id) {
+		if (!mac->first_error)
+			mac->first_error = -ECANCELED;
+		mac->closing = true;
+	}
+	mutex_unlock(&mac->mutex);
+}
+
+/* Firmware key ownership, the pinned vendor implementation's choice: each
+ * key the supplicant installs becomes one CMD_ID_ADD_REMOVE_KEY on the TC4
+ * owner with the same credit wait as the join commands. A returned credit
+ * proves that the firmware consumed the command buffer, nothing more; the
+ * records say so. The group key's credit shortens the deauthentication hold
+ * to one second. Only CCMP, only the exact peer, pairwise before group, one
+ * of each, key ids 0 to 3 for the group key (the pinned ucKeyId range; the
+ * WLAN index, 1 or the station's declared broadcast entry 2, distinguishes
+ * the keys); anything else ends
+ * the lifetime fail-stop. DISABLE_KEY submits
+ * nothing: the lifetime retires its keys explicitly in the cleanup.
+ */
+/* DISABLE_KEY completes locally, never asserts firmware key deletion. */
+static int mt6797_ccmp_disable_key(struct mt6797_mac *mac)
+{
+	struct sk_buff_head discard;
+	struct sk_buff *skb, *tmp, *internal = NULL;
+	unsigned long flags;
+	u64 deadline, now;
+	int ret = 0;
+	bool retired;
+
+	skb_queue_head_init(&discard);
+	mutex_lock(&mac->mutex);
+	mac->ccmp_key_disables++;
+	mt6797_ccmp_withdraw(mac);
+	/* Retain only reserved deauth; never dereference queued key cookies. */
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	skb_queue_walk_safe(&mac->join_queue, skb, tmp) {
+		if (skb == mac->join_internal)
+			continue;
+		__skb_unlink(skb, &mac->join_queue);
+		mac->join_queue_bytes -= skb->len;
+		__skb_queue_tail(&discard, skb);
+	}
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	if (mac->join_data_phase && !mac->join_data_ended)
+		mt6797_mac_join_end_data(mac, "key-disable");
+	deadline = mac->join_deadline;
+	mutex_unlock(&mac->mutex);
+	/* Prior RX/TX-status batches finish before the callback completes. */
+	mutex_lock(&mac->ccmp_receive_mutex);
+	mutex_unlock(&mac->ccmp_receive_mutex);
+	mutex_lock(&mac->mutex);
+	if (mac->join_inflight && !mac->first_error)
+		ret = mt6797_mac_join_wait_management(mac);
+	if (!ret && !mac->join_cleanup_done && !mac->first_error &&
+	    mac->join_running && !mac->join_retired && !mac->closing) {
+		schedule_delayed_work(&mac->join_work, 0);
+		now = ktime_get_ns();
+		if (now < deadline) {
+			mutex_unlock(&mac->mutex);
+			wait_for_completion_timeout(&mac->ccmp_cleanup_done,
+						    nsecs_to_jiffies(deadline - now) + 1);
+			mutex_lock(&mac->mutex);
+		}
+	}
+	retired = mac->join_cleanup_done && mac->join_key_pairwise == 2 &&
+		  mac->join_key_group == 2;
+	if (!retired) {
+		if (!ret)
+			ret = mac->first_error ? mac->first_error : -ETIMEDOUT;
+		if (mac->join_running && !mac->join_retired)
+			mt6797_mac_join_fail_stop(mac, ret, 8, &discard, &internal);
+	}
+	if (mac->ccmp_cleanup_bounded_done) {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN ccmp-stable disable bounded: local=1 command_path_credit=%u status=%d resource_debt=%u no_reuse=1\n",
+			 retired, ret, mac->join_page_debt);
+	} else {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN ccmp-stable disable: local=1 removal_command_credit=%u status=%d no_reuse=1\n",
+			 retired, ret);
+	}
+	mutex_unlock(&mac->mutex);
+	/* The terminal worker's last TX-status batch also precedes keyconf free. */
+	cancel_delayed_work_sync(&mac->join_work);
+	mutex_lock(&mac->ccmp_receive_mutex);
+	mutex_unlock(&mac->ccmp_receive_mutex);
+	/* A re-arm pass queued by the healthy terminal in the 20 ms before
+	 * this removal was cancelled with everything else; its pending flag
+	 * survives, so queue it again now that the key is gone. The pass
+	 * itself still decides with the rendezvous and quiescence rules.
+	 */
+	mutex_lock(&mac->mutex);
+	if (mac->join_rearm_pending && !mac->join_closed && !mac->first_error &&
+	    !mac->closing)
+		schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
+	mutex_unlock(&mac->mutex);
+	while ((skb = __skb_dequeue(&discard))) {
+		if (skb == internal)
+			dev_kfree_skb(skb);
+		else
+			ieee80211_free_txskb(mac->hw, skb);
+	}
+	return 0;
+}
+
+static int mt6797_mac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
+			      struct ieee80211_vif *vif, struct ieee80211_sta *sta,
+			      struct ieee80211_key_conf *key)
+{
+	struct mt6797_mac *mac = hw->priv;
+	bool pairwise = key->flags & IEEE80211_KEY_FLAG_PAIRWISE;
+	unsigned long flags;
+	int ret;
+	struct ieee80211_key_seq seed, tid_seed[MT6797_CCMP_RX_TIDS - 1];
+	unsigned int tid;
+
+	if (cmd == DISABLE_KEY)
+		return mt6797_ccmp_disable_key(mac);
+
+	if (cmd == DISABLE_KEY)
+		return 0;
+	mutex_lock(&mac->mutex);
+	if (!mac->ccmp_pm_connected) {
+		ret = -EOPNOTSUPP;
+		goto failed;
+	}
+	if ((mac->ccmp_closed ||
+	     (pairwise && mac->ccmp_ptk_attempted) ||
+				  (!pairwise && mac->ccmp_gtk_attempted))) {
+		ret = -EOPNOTSUPP;
+		goto failed;
+	}
+	if (vif != mac->vif || !mac->join_rsn || !mac->join_running ||
+	    !mac->join_sta_active || !mac->join_bss_configured ||
+	    mac->join_retired || mac->closing || mac->first_error ||
+	    mac->join_credit_pending ||
+	    key->cipher != WLAN_CIPHER_SUITE_CCMP || key->keylen != 16 ||
+	    key->keyidx < 0 || key->keyidx > 3 || mac->sequence > 253 ||
+	    (pairwise && (!sta || !ether_addr_equal(sta->addr, mac->join_ap) ||
+			  key->keyidx || mac->join_key_pairwise)) ||
+	    (!pairwise && (sta || mac->join_key_group ||
+			   mac->join_key_pairwise != 1)) ||
+	    ktime_get_ns() >= mac->join_deadline) {
+		ret = -EOPNOTSUPP;
+		goto failed;
+	}
+	if (!pairwise) {
+		/* Reserve this initial key before dropping the MAC mutex. The RX
+		 * batch takes receive -> MAC, so never wait in the opposite order.
+		 * No GTK is eligible before this context is published below.
+		 */
+		mac->ccmp_gtk_attempted = true;
+		mutex_unlock(&mac->mutex);
+		mutex_lock(&mac->ccmp_receive_mutex);
+		ieee80211_get_key_rx_seq(key, 0, &seed);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			ieee80211_get_key_rx_seq(key, tid, &tid_seed[tid - 1]);
+		mutex_unlock(&mac->ccmp_receive_mutex);
+		mutex_lock(&mac->mutex);
+		if (mac->ccmp_closed || mac->first_error || mac->closing ||
+		    mac->join_retired || mac->join_key_pairwise != 1 ||
+		    ktime_get_ns() >= mac->join_deadline) {
+			ret = mac->first_error ? mac->first_error : -EOPNOTSUPP;
+			goto failed;
+		}
+	}
+	if (pairwise) {
+		mac->ccmp_ptk_attempted = true;
+		ieee80211_get_key_rx_seq(key, 0, &seed);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			ieee80211_get_key_rx_seq(key, tid, &tid_seed[tid - 1]);
+		reinit_completion(&mac->ccmp_key_done);
+	}
+	/* The standard supplicant hands message 4 to the driver before it
+	 * installs the pairwise key, so the reply may be in flight or its pages
+	 * still owed when this is called. Serialize on the existing TC4 ledger:
+	 * wait for the in-flight frame's TX done and for its credit, bounded by
+	 * the frame and join deadlines; a reply that is only queued stays queued
+	 * while this command's page is owed and goes out after the credit.
+	 */
+	if (mac->join_inflight || mac->data_slots.count || mac->join_page_debt) {
+		ret = mt6797_mac_join_wait_management(mac);
+		if (ret)
+			goto failed;
+	}
+	if (mac->join_page_debt || mac->join_credit_pending || mac->sequence > 253) {
+		ret = -EBUSY;
+		goto failed;
+	}
+	mac->join_credit_deadline = min_t(u64, mac->join_deadline,
+					  ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 1;
+	ret = mt6797_hif_join_key(mac->hif, mac->sequence++, true, pairwise,
+				  mac->join_ap, key->keyidx, key->key,
+				  mac->join_credit_deadline);
+	mt6797_mac_join_refused(mac, ret);
+	if (!ret && pairwise)
+		mac->join_key_pairwise_submitted = true;
+	if (!ret && !pairwise)
+		mac->join_key_group_submitted = true;
+	if (!ret)
+		ret = mt6797_mac_join_wait_credit(mac);
+	if (ret)
+		goto failed;
+	if (pairwise) {
+		u64 now = ktime_get_ns(), deadline = min_t(u64, mac->join_deadline,
+							 now + 100 * NSEC_PER_MSEC);
+
+		/* First owned event precedes GTK; attribution remains provisional. */
+		if (!mac->join_key_done && now < deadline) {
+			mutex_unlock(&mac->mutex);
+			wait_for_completion_timeout(&mac->ccmp_key_done,
+						    nsecs_to_jiffies(deadline - now) + 1);
+			mutex_lock(&mac->mutex);
+		}
+		if (!mac->join_key_done || mac->join_key_group_submitted ||
+		    mac->ccmp_closed || mac->first_error || mac->closing || mac->join_retired) {
+			ret = mac->first_error ? mac->first_error : -ETIMEDOUT;
+			goto failed;
+		}
+		memcpy(mac->ccmp_rx.pn, seed.ccmp.pn, 6);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			memcpy(mac->ccmp_rx.tid_pn[tid - 1], tid_seed[tid - 1].ccmp.pn, 6);
+		memcpy(mac->ccmp_rx.own, hw->wiphy->perm_addr, 6);
+		memcpy(mac->ccmp_rx.ap, mac->join_ap, 6);
+		mac->ccmp_rx.cipher = key->cipher;
+		mac->ccmp_rx.key_bytes = key->keylen;
+		mac->ccmp_rx.key_id = key->keyidx;
+		mac->ccmp_rx.wlan_index = 1;
+		mac->ccmp_rx.rxd_bssid = 1; /* measured tag, not command BSS arithmetic */
+		mac->ccmp_rx.channel = 40;
+		mac->ccmp_rx.pairwise = true;
+		mac->ccmp_rx.seeded = true;
+		mac->ccmp_rx.active = true;
+		rcu_assign_pointer(mac->ccmp_sta, sta);
+		key->hw_key_idx = 1;
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		mac->ccmp_ptk = key;
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	} else {
+		/* The credit wait released the MAC mutex; withdrawal is permanent. */
+		if (mac->ccmp_closed || mac->first_error || mac->closing ||
+		    mac->join_retired || !mac->ccmp_gtk_attempted ||
+		    !mac->ccmp_rx.active || mac->ccmp_gtk ||
+		    mac->join_key_group || mac->join_key_pairwise != 1 ||
+		    ktime_get_ns() >= mac->join_deadline) {
+			ret = mac->first_error ? mac->first_error : -EOPNOTSUPP;
+			goto failed;
+		}
+		memcpy(mac->ccmp_gtk_rx.pn, seed.ccmp.pn, 6);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			memcpy(mac->ccmp_gtk_rx.tid_pn[tid - 1], tid_seed[tid - 1].ccmp.pn, 6);
+		memcpy(mac->ccmp_gtk_rx.own, hw->wiphy->perm_addr, 6);
+		memcpy(mac->ccmp_gtk_rx.ap, mac->join_ap, 6);
+		mac->ccmp_gtk_rx.cipher = key->cipher;
+		mac->ccmp_gtk_rx.key_bytes = key->keylen;
+		mac->ccmp_gtk_rx.key_id = key->keyidx;
+		mac->ccmp_gtk_rx.wlan_index = MT6797_JOIN_BMC_WLAN_INDEX;
+		mac->ccmp_gtk_rx.rxd_bssid = 1;
+		mac->ccmp_gtk_rx.channel = 40;
+		mac->ccmp_gtk_rx.pairwise = false;
+		mac->ccmp_gtk_rx.seeded = true;
+		mac->ccmp_gtk_rx.authorized = mac->ccmp_rx.authorized;
+		mac->ccmp_gtk_rx.active = true;
+		key->hw_key_idx = MT6797_JOIN_BMC_WLAN_INDEX;
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		mac->ccmp_gtk = key;
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	}
+	dev_info(wiphy_dev(hw->wiphy),
+		 "one-shot WLAN join key credit returned: %s\n",
+		 pairwise ? "pairwise" : "group");
+	if (pairwise) {
+		mac->join_key_pairwise = 1;
+	} else {
+		mac->join_key_group = 1;
+		mac->join_group_key_id = key->keyidx;
+		/* Both keys installed: open the bounded data phase inside the
+		 * grant; the reserved deauthentication waits for its end and
+		 * cleanup stage 1 returns the privilege. A phase that cannot open
+		 * ends the lifetime below.
+		 */
+		ret = mt6797_mac_join_release_channel(mac);
+		if (ret)
+			goto failed;
+		schedule_delayed_work(&mac->join_work, 0);
+	}
+	mutex_unlock(&mac->mutex);
+	return 0;
+failed:
+	/* The refusal is named so a key the supplicant installs after a
+	 * fail-stop (runtime 16) is distinguishable from one it never offered.
+	 * State flags and status only; no key byte.
+	 */
+	dev_info(wiphy_dev(hw->wiphy),
+		 "one-shot WLAN join key command refused: %s status=%d running=%u active=%u configured=%u first=%d\n",
+		 pairwise ? "pairwise" : "group", ret, mac->join_running,
+		 mac->join_sta_active, mac->join_bss_configured, mac->first_error);
+	if (mac->join_running && !mac->join_retired) {
+		/* The lifetime is still running: end it here through the one
+		 * terminal path (branch 8, the key command), so the footer exists
+		 * and the frames are freed exactly once before mac80211's station
+		 * teardown can close the lifetime.
+		 */
+		struct sk_buff_head discard;
+		struct sk_buff *skb, *internal = NULL;
+
+		skb_queue_head_init(&discard);
+		mt6797_mac_join_fail_stop(mac, ret, 8, &discard, &internal);
+		mutex_unlock(&mac->mutex);
+		while ((skb = __skb_dequeue(&discard))) {
+			if (skb == internal)
+				dev_kfree_skb(skb);
+			else
+				ieee80211_free_txskb(mac->hw, skb);
+		}
+		return ret;
+	}
+	/* Already stopped (runtime 16: a key offered after the fail-stop). */
+	if (!mac->first_error)
+		mac->first_error = ret;
+	mac->closing = true;
+	mac->join_retired = true;
+	mac->join_credit_pending = false;
+	complete_all(&mac->join_credit_done);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mutex_unlock(&mac->mutex);
+	return ret;
+}
+
+static int mt6797_mac_sta_state(struct ieee80211_hw *hw,
+				struct ieee80211_vif *vif, struct ieee80211_sta *sta,
+				enum ieee80211_sta_state old,
+				enum ieee80211_sta_state new)
+{
+	/* mac80211 station teardown must not fail; no peer command is
+	 * admitted by this incomplete upward-transition implementation.
+	 */
+	if (new <= old) {
+		if (new < old) {
+			struct mt6797_mac *mac = hw->priv;
+
+			mutex_lock(&mac->mutex);
+			mt6797_ccmp_withdraw(mac);
+			mutex_unlock(&mac->mutex);
+			/* No MAC lock while synchronizing an already-started handoff. */
+			mutex_lock(&mac->ccmp_receive_mutex);
+			mutex_unlock(&mac->ccmp_receive_mutex);
+		}
+		if (new < old) {
+			struct mt6797_mac *mac = hw->priv;
+			bool close = true;
+
+			mutex_lock(&mac->mutex);
+			/* 0180: record the mac80211 station teardown barrier; the
+			 * worker re-arms once the healthy cleanup also completes. This
+			 * never poisons merely because cleanup is still in progress.
+			 */
+			if (vif == mac->vif && new == IEEE80211_STA_NOTEXIST)
+				mac->join_sta_removed = true;
+			if (vif == mac->vif && mac->join_data_phase && !mac->join_data_ended)
+				mt6797_mac_join_end_data(mac, "disconnect");
+			if (vif == mac->vif && !mac->first_error && !mac->closing) {
+				if (mac->join_cleanup_done) {
+					/* 0180: a healthy descent never poisons (close stays
+					 * false on every downward transition). Queue the single
+					 * serialized re-arm only once the mac80211 NOTEXIST
+					 * teardown is also seen (join_sta_removed) - not on the
+					 * earlier AUTHORIZED/ASSOC/AUTH descents, which would run
+					 * the pass with sta_removed=false and log a false refusal.
+					 */
+					close = false;
+					/* The stable epoch re-arms too (0240 unlocked the worker's
+					 * site only; no worker pass runs after a retired terminal,
+					 * so this teardown is the only requester once the healthy
+					 * stage-3 cleanup is already done). The cleanup_done test
+					 * keeps a teardown that precedes the terminal from logging
+					 * a false refusal; the worker's site then requests it.
+					 */
+					if (mac->join_sta_removed && mac->join_cleanup_done &&
+					    !mac->join_closed && !mac->join_rearm_pending) {
+						mac->join_rearm_pending = true;
+						schedule_delayed_work(&mac->join_work, 0);
+					}
+				} else if (mac->join_peer_used && !mac->join_retired) {
+					int ret = mt6797_mac_join_request_cleanup(mac);
+
+					if (!ret) {
+						close = false;
+					} else {
+						mac->first_error = ret;
+						mac->closing = true;
+					}
+				}
+			}
+			mutex_unlock(&mac->mutex);
+			if (close)
+				mt6797_mac_join_close(mac);
+		}
+		return 0;
+	}
+	if (old == IEEE80211_STA_NOTEXIST && new == IEEE80211_STA_NONE)
+		return mt6797_mac_join_add_peer(hw->priv, vif, sta);
+	if (old == IEEE80211_STA_NONE && new == IEEE80211_STA_AUTH) {
+		struct mt6797_mac *mac = hw->priv;
+		int ret = -EOPNOTSUPP;
+
+		mutex_lock(&mac->mutex);
+		if (vif == mac->vif && !sta->mlo && !sta->valid_links &&
+		    ether_addr_equal(sta->addr, mac->join_ap) &&
+		    mac->join_peer_ready && mac->join_auth_received &&
+		    mac->join_auth_ok && !mac->join_authenticated &&
+		    !mac->join_retired && !mac->closing && !mac->first_error) {
+			ret = mt6797_mac_join_wait_management(mac);
+			if (!ret)
+				mac->join_authenticated = true;
+		}
+		mutex_unlock(&mac->mutex);
+		return ret;
+	}
+	if (old == IEEE80211_STA_AUTH && new == IEEE80211_STA_ASSOC) {
+		struct mt6797_mac *mac = hw->priv;
+		int ret = -EOPNOTSUPP;
+
+		mutex_lock(&mac->mutex);
+		if (vif == mac->vif && !sta->mlo && !sta->valid_links &&
+		    ether_addr_equal(sta->addr, mac->join_ap) &&
+		    mac->join_authenticated && !mac->join_retired &&
+		    !mac->closing && !mac->first_error) {
+			ret = mt6797_mac_join_associate(mac, vif->cfg.aid);
+			if (ret) {
+				if (!mac->first_error)
+					mac->first_error = ret;
+				mac->closing = true;
+			}
+		}
+		mutex_unlock(&mac->mutex);
+		return ret;
+	}
+	if (old == IEEE80211_STA_ASSOC && new == IEEE80211_STA_AUTHORIZED) {
+		struct mt6797_mac *mac = hw->priv;
+		int ret = -EOPNOTSUPP;
+		unsigned long flags;
+		struct ieee80211_sta *current_sta;
+
+		mutex_lock(&mac->mutex);
+		if (vif == mac->vif && ether_addr_equal(sta->addr, mac->join_ap) &&
+		    mac->join_sta_active && mac->join_bss_configured &&
+		    !mac->join_retired && !mac->closing && !mac->first_error)
+			ret = 0;
+		current_sta = rcu_dereference_protected(mac->ccmp_sta,
+							lockdep_is_held(&mac->mutex));
+		if (!ret && !mac->ccmp_closed && mac->ccmp_rx.active &&
+		    current_sta == sta) {
+			mac->ccmp_rx.authorized = true;
+			mac->ccmp_gtk_rx.authorized = true;
+			spin_lock_irqsave(&mac->join_queue.lock, flags);
+			mac->ccmp_tx_ready = true;
+			spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		} else {
+			ret = -EOPNOTSUPP;
+		}
+		mutex_unlock(&mac->mutex);
+		return ret;
+	}
+	return -EOPNOTSUPP;
+}
