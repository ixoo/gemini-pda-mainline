+/* A complete, untranslated class2 beacon from the joined AP, not ordinary data.
+ * Return the original MPDU span: no group4 reconstruction, strip or synthesis.
+ * Delivery/admission belongs to the caller; matching is not authentication.
+ */
+bool
+mt6797_native_beacon(const unsigned char *packet, size_t bytes,
+		     unsigned char channel, const unsigned char ap[6],
+		     struct mt6797_native_beacon *out)
+{
+	size_t offset = 16, vector;
+	unsigned int groups, fc, i, rcpi;
+	const unsigned char *frame;
+
+	if (!packet || !ap || !out || !channel || bytes < 16 || bytes > 4096 ||
+	    mt6797_join_le16(packet) != bytes ||
+	    (mt6797_join_le16(packet + 2) >> 13) != 2 || packet[5] != channel ||
+	    (packet[6] & 0x80) || (packet[6] & 0x3f) != 24 || (packet[7] & 3) ||
+	    (mt6797_join_le16(packet + 10) & 0x0012)) /* conservative FCS/ICV filter */
+		return false;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if (!(groups & 4))
+		return false;	/* the existing delivery helper's RX vector signal */
+	if (groups & 8)
+		offset += 16;
+	if (groups & 1)
+		offset += 16;
+	if (groups & 2)
+		offset += 8;
+	vector = offset;
+	offset += 24;
+	if (packet[6] & 0x40)
+		offset += 2;
+	if (offset > bytes || bytes - offset < 36)
+		return false;	/* 24-byte header and 12-byte beacon fixed fields */
+	frame = packet + offset;
+	fc = mt6797_join_le16(frame);
+	if ((fc & 0x00ff) != 0x0080 || (fc & 0xc700) ||
+	    (mt6797_join_le16(frame + 22) & 15))
+		return false;	/* version0 beacon, no DS/protection/fragment/HTC */
+	for (i = 0; i < 6; i++)
+		if (frame[4 + i] != 0xff || frame[10 + i] != ap[i] ||
+		    frame[16 + i] != ap[i])
+			return false;
+	rcpi = packet[vector + 9];
+	if (rcpi > 220)
+		return false;
+	*out = (struct mt6797_native_beacon){offset, bytes - offset, rcpi};
+	return true;
+}
