+};
+
+/* One stream, MCS 0-7, 20 and 40 MHz (0323); no short GI, greenfield,
+ * STBC or LDPC; the smallest A-MPDU window (0293). mac80211 sets the SM
+ * power save field from its own mode, so the admission below leaves those
+ * two bits free.
+ */
+#define MT6797_HT_CAP_INFO ((WLAN_HT_CAP_SM_PS_DISABLED << IEEE80211_HT_CAP_SM_PS_SHIFT) | \
+			    IEEE80211_HT_CAP_SUP_WIDTH_20_40)
+
+#define MT6797_HT_AMPDU_PARAMS \
+	(IEEE80211_HT_MAX_AMPDU_8K | \
+	 (IEEE80211_HT_MPDU_DENSITY_8 << IEEE80211_HT_AMPDU_PARM_DENSITY_SHIFT))
+
+/* Initial queue is closed. Only the forthcoming owned join state callbacks
+ * may open it after the scan/peer/channel gates; there is no device admission.
+ */
+/* mac80211 retries authentication and the association request when no
+ * response arrives (three tries each). The driver queues up to two of each,
+ * inside the same join window; every other management subtype stays one
+ * frame per lifetime (0304).
+ */
+#define MT6797_JOIN_ATTEMPTS 2
+
+/* A current, owned monitor notification is a normal connection loss, not a
+ * malformed transport event. End traffic and queue standard core teardown;
+ * native disable and resource cleanup still run under their existing bounds.
+ *
+ * Except reason 4 while the link is visibly alive: the vendor receiver drops a
+ * beacon-timeout event when a packet reached the host within the last two
+ * seconds, and every reason-4 event seen so far arrived six minutes into the
+ * data phase with checked receive under a second old. Such an event is logged,
+ * counted and consumed. The checked-receive clock is narrower than the vendor's
+ * (strictly checked PTK/GTK admissions only), so it ignores no more than the
+ * vendor would. A dead link stops that clock, and its next event is a loss.
+ */
+#define MT6797_CCMP_TIMEOUT_FRESH_RX_MS	2000
+
+#define MT6797_CCMP_TIMEOUT_IGNORE_NAMED	16
+
+void
+mt6797_scan_bss(const unsigned char *mac, bool active, unsigned char output[12]);
+
+int
+mt6797_scan_frame(const unsigned char *packet, size_t bytes,
+		  struct mt6797_scan_frame *frame);
+
+bool
+mt6797_join_rx_frame(const unsigned char *packet, size_t bytes,
+		     unsigned char channel, const unsigned char *own,
+		    const unsigned char *ap, unsigned int allowed_subtypes,
+		    struct mt6797_join_rx_frame *out);
+
+enum mt6797_eapol_gate
+mt6797_eapol_rx_gate(const unsigned char *packet, size_t bytes,
+		     unsigned char channel, const unsigned char own[6],
+		const unsigned char ap[6], struct mt6797_eapol_rx *out);
+
+bool
+mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
+		unsigned char channel, const unsigned char own[6],
+		const unsigned char ap[6], struct mt6797_eapol_rx *out);
+
+const char *mt6797_eapol_gate_name(enum mt6797_eapol_gate gate);
+
+bool
+mt6797_data_rx(const unsigned char *packet, size_t bytes, unsigned char channel,
+	       const unsigned char own[6], const unsigned char ap[6],
+	       unsigned char bmc_index, struct mt6797_data_rx *out);
+
+bool
+mt6797_native_beacon(const unsigned char *packet, size_t bytes,
+		     unsigned char channel, const unsigned char ap[6],
+		     struct mt6797_native_beacon *out);
+
+bool
+mt6797_join_keyed_beacon(const unsigned char *packet, size_t bytes,
+			 unsigned char channel, const unsigned char ap[6],
+			 unsigned char bmc_index,
+			 struct mt6797_join_action_frame *out);
+
+enum mt6797_rx_reorder_place
+mt6797_rx_reorder_place(struct mt6797_rx_reorder *r, unsigned int seq);
+
+bool
+mt6797_data_room(const struct mt6797_data_slots *s, unsigned int pages,
+		 unsigned int free_pages);
+
+bool mt6797_join_pid_complete(struct mt6797_join_pid_pool *p,
+			      unsigned char pid);
+
+const char * __maybe_unused
+mt6797_mac_deauth_verdict(const struct mt6797_mac *mac);
+
+bool mt6797_ccmp_data_room(struct mt6797_mac *mac, size_t bytes);
+
+int mt6797_ccmp_assign_pid(struct mt6797_mac *mac, bool reserved, bool data);
+
+void mt6797_ccmp_withdraw(struct mt6797_mac *mac);
+
+int mt6797_rx_reorder_apply(struct mt6797_mac *mac, struct sk_buff_head *received);
+
+int mt6797_rx_reorder_expire_all(struct mt6797_mac *mac,
+				 struct sk_buff_head *received);
+
+void mt6797_rx_reorder_drop(struct mt6797_mac *mac);
+
+int mt6797_ccmp_queue_rx(struct mt6797_mac *mac, size_t bytes,
+			 struct sk_buff_head *received);
+
+bool mt6797_ccmp_deauth_retire(struct mt6797_mac *mac, u64 now,
+			       struct sk_buff_head *discard, struct sk_buff **internal);
