From 4fdc8e6a2064401eeb5bf57c151103cc1f1dfefb Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 20:59:49 -0400
Subject: [PATCH] wifi: mt6797: leave the HIF wrapper line mask alone on disarm

Boot AA3 read the wrapper's line mask at 0x200 as 0 before 0301's arm
write, so that write is a no-op on this firmware state. Disarm then
wrote 0x01, which reads back. The vendor's disable path never writes
this register, so the driver should not either.

Disarm now only reads the mask, and the record keeps it on both lines.
Arm still writes 0 after setting INT_EN, as nicEnableInterrupt does.
The disarmed line now also prints WHIER before and after, so a firmware
clear of WHIER during the data phase would show.
---
 drivers/net/wireless/mediatek/mt6797/hif.c | 25 +++++++++++-----------
 drivers/net/wireless/mediatek/mt6797/mac.c |  5 +++--
 2 files changed, 16 insertions(+), 14 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 62e35a934..ecfa99a90 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -481,12 +481,14 @@ static int mt6797_hif_read32_locked(struct mt6797_hif *hif, unsigned int reg,
 #define MT6797_HIF_WHLPCR_INT_EN_SET BIT(0)
 #define MT6797_HIF_WHLPCR_INT_EN_CLR BIT(1)
 /* The wrapper's line mask in the direct window (sdio.h: __enable_irq()
- * writes 0 to base + 0x200, __disable_irq() writes 0x01), the one raw
- * write the vendor pairs with WHLPCR INT_EN in nicEnableInterrupt (0301).
+ * writes 0 to base + 0x200), the one raw write the vendor pairs with
+ * WHLPCR INT_EN in nicEnableInterrupt (0301). It reads 0 before that write
+ * (boot AA3), and the vendor's disable path never writes it, so disarm
+ * only reads it.
  */
 #define MT6797_HIF_LINE_MASK 0x200U
 
-static int mt6797_hif_line_mask_locked(struct mt6797_hif *hif, u32 value,
+static int mt6797_hif_line_mask_locked(struct mt6797_hif *hif, bool write,
 				       u32 *before, u32 *after)
 {
 	int error = mt6797_hif_guard(hif);
@@ -494,7 +496,8 @@ static int mt6797_hif_line_mask_locked(struct mt6797_hif *hif, u32 value,
 	if (error)
 		return error;
 	*before = readl((u8 __iomem *)hif->base + MT6797_HIF_LINE_MASK);
-	writel(value, (u8 __iomem *)hif->base + MT6797_HIF_LINE_MASK);
+	if (write)
+		writel(0, (u8 __iomem *)hif->base + MT6797_HIF_LINE_MASK);
 	*after = readl((u8 __iomem *)hif->base + MT6797_HIF_LINE_MASK);
 	return mt6797_hif_guard(hif);
 }
@@ -531,18 +534,16 @@ int mt6797_hif_set_interrupt(struct mt6797_hif *hif, bool enable,
 	if (!error && enable)
 		error = mt6797_hif_write32_locked(hif, MT6797_HIF_WHIER_REG,
 						  MT6797_HIF_WHIER_ARMED);
-	/* Disarm masks the wrapper line before clearing INT_EN; arm unmasks
-	 * it after setting INT_EN, as nicEnableInterrupt does (0301).
-	 */
-	if (!error && !enable)
-		error = mt6797_hif_line_mask_locked(hif, 0x01, &record->mask_before,
-						    &record->mask_after);
 	if (!error)
 		error = mt6797_hif_write32_locked(hif, MT6797_HIF_WHLPCR_REG,
 						  enable ? MT6797_HIF_WHLPCR_INT_EN_SET :
 						  MT6797_HIF_WHLPCR_INT_EN_CLR);
-	if (!error && enable)
-		error = mt6797_hif_line_mask_locked(hif, 0, &record->mask_before,
+	/* Arm writes the wrapper line mask 0 after setting INT_EN, as
+	 * nicEnableInterrupt does (0301); disarm leaves it as it is and
+	 * records it.
+	 */
+	if (!error)
+		error = mt6797_hif_line_mask_locked(hif, enable, &record->mask_before,
 						    &record->mask_after);
 	if (!error)
 		error = mt6797_hif_read32_locked(hif, MT6797_HIF_WHIER_REG,
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 02c0c71f5..2b6bd53ca 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -3455,9 +3455,10 @@ static void mt6797_mac_hif_irq_pass(struct mt6797_mac *mac)
 		mac->hif_irq_disarm_status = mt6797_hif_set_interrupt(mac->hif, false, deadline,
 								      &mac->hif_irq_off);
 		dev_info(wiphy_dev(mac->hw->wiphy),
-			 "one-shot WLAN HIF interrupt disarmed: irq=%d status=%d taken=%u rearmed=%u whlpcr=0x%08x>0x%08x mask=0x%08x>0x%08x\n",
+			 "one-shot WLAN HIF interrupt disarmed: irq=%d status=%d taken=%u rearmed=%u whier=0x%08x>0x%08x whlpcr=0x%08x>0x%08x mask=0x%08x>0x%08x\n",
 			 mac->hif_irq, mac->hif_irq_disarm_status, READ_ONCE(mac->hif_irq_taken),
-			 mac->hif_irq_rearmed, mac->hif_irq_off.whlpcr_before,
+			 mac->hif_irq_rearmed, mac->hif_irq_off.whier_before,
+			 mac->hif_irq_off.whier_after, mac->hif_irq_off.whlpcr_before,
 			 mac->hif_irq_off.whlpcr_after, mac->hif_irq_off.mask_before,
 			 mac->hif_irq_off.mask_after);
 		return;
-- 
2.43.0

