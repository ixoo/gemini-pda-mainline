From dbdaac15bb4b2ea5efb260e60a9f89cd1fc22875 Mon Sep 17 00:00:00 2001
From: Codex Experiment <codex-experiment@example.invalid>
Date: Mon, 19 Oct 2026 06:33:31 -0400
Subject: [PATCH] wifi: mt6797: report owned connected monitor loss to mac80211

Declare beacon filtering on the separately selected PM-required station.
An exact owned monitor event during healthy connected data ends traffic
and queues standard connection loss once. Existing native disable and
bounded cleanup still follow; this does not tolerate or ignore a loss.
Keep malformed, foreign, stale and pre-data events on their old refusal
path. Interpret no numeric reason and retain fatal transport poison.

Internal experiment archive, synthetic non-certifying author;
no DCO certification and not an upstream submission.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 34 ++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 7d4dfc2..63bf4c5 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -2470,6 +2470,27 @@ static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 		 mac->join_data_uni_masks, mac->join_data_grp_masks);
 }
 
+#ifdef CONFIG_MT6797_CCMP_CONNECTED_LIFETIME
+/* A current, owned monitor notification is a normal connection loss, not a
+ * malformed transport event. End traffic and queue standard core teardown;
+ * native disable and resource cleanup still run under their existing bounds.
+ */
+static bool mt6797_ccmp_owned_loss(struct mt6797_mac *mac, size_t bytes)
+{
+	if (!ccmp_stable_epoch || !mt6797_join_event(mac->join_packet, bytes, 0x13, 4) ||
+	    mac->join_packet[5] || mac->join_packet[8] || !mt6797_ccmp_rx_ready(mac) ||
+	    !mac->started || !mac->vif ||
+	    !mac->join_running || !mac->join_sta_active || !mac->join_bss_valid ||
+	    !mac->join_bss_configured || !mac->ccmp_pm_connected || !mac->ccmp_pm_credit_ns ||
+	    mac->join_key_pairwise != 1 || mac->join_key_group != 1 || mac->ccmp_loss_reported)
+		return false;
+	mt6797_ccmp_timeout_observe(mac, bytes);
+	mt6797_mac_join_end_data(mac, "connection-loss");
+	mt6797_ccmp_connection_lost(mac, "monitor");
+	return true;
+}
+#endif
+
 /* Open the bounded data phase after the group key's credit, inside the live
  * channel grant. The reference run 3 ledger places every one of the vendor's
  * first data frames inside its grant, with the CH_PRIVILEGE abort about four
@@ -3369,6 +3390,11 @@ submitted:
 			    mt6797_join_le16(mac->join_packet + 2) == 0xe000) {
 				branch = 6;
 				ret = mt6797_mac_join_control_event(mac, rx.logical_bytes);
+#ifdef CONFIG_MT6797_CCMP_CONNECTED_LIFETIME
+				if (ret == -EPROTO &&
+				    mt6797_ccmp_owned_loss(mac, rx.logical_bytes))
+					ret = 0;
+#endif
 				if (ret) {
 #ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
 					mt6797_ccmp_timeout_observe(mac, rx.logical_bytes);
@@ -4256,6 +4282,10 @@ static int mt6797_mac_add_interface(struct ieee80211_hw *hw,
 	    !mac->closing && !mac->first_error &&
 	    vif->type == NL80211_IFTYPE_STATION &&
 	    ether_addr_equal(vif->addr, hw->wiphy->perm_addr)) {
+#ifdef CONFIG_MT6797_CCMP_CONNECTED_LIFETIME
+		if (ccmp_stable_epoch)
+			vif->driver_flags |= IEEE80211_VIF_BEACON_FILTER;
+#endif
 		mac->vif = vif;
 		ret = 0;
 	}
@@ -4275,6 +4305,10 @@ static void mt6797_mac_remove_interface(struct ieee80211_hw *hw,
 	mt6797_mac_join_close(mac);
 	mt6797_mac_cancel_scan(hw, vif);
 	mutex_lock(&mac->mutex);
+#ifdef CONFIG_MT6797_CCMP_CONNECTED_LIFETIME
+	if (mac->vif == vif && ccmp_stable_epoch)
+		vif->driver_flags &= ~IEEE80211_VIF_BEACON_FILTER;
+#endif
 	mac->vif = NULL;
 	/* Retain the wire BSS lifetime through recovery, never reuse its slot. */
 	mac->closing = true;
-- 
