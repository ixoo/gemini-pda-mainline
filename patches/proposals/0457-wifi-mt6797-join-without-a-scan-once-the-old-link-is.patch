 	int ret = -EOPNOTSUPP, slot;
 
 	mutex_lock(&mac->mutex);
@@ -970,44 +1060,9 @@ static int mt6797_mac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif
 		ret = 0;
