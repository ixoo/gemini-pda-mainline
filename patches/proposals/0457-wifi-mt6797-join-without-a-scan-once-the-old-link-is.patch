+/* Everything a scan or a scanless join needs from the firmware first. Called
+ * with the mutex held.
+ */
+static int mt6797_mac_lifetime_begin(struct mt6797_mac *mac)
+{
+	u8 bss[12];
+	u8 broadcast[4] = {8, 0, 0, 0};
+	int ret;
+
+	/* Retire before the first write: an uncertain activation/submission
+	 * cannot be retried or treated as an effect-free rejection.
+	 */
+	mac->scan_used = true;
+	/* 0180: count the lifetime at its first effectful submission (this scan).
+	 * An idle scan hands the count back when it is retired.
+	 */
+	if (mac->join_lifetimes < U8_MAX)
+		mac->join_lifetimes++;
+	ret = mt6797_mac_scan_guard(mac, ktime_get_ns() + NSEC_PER_SEC);
+	if (ret) {
+		mac->first_error = ret;
+		return ret;
+	}
+	if (mac->monitor_left_on) {
+		ret = mt6797_hif_diag_mask(mac->hif, mac->sequence++, false,
+					   ktime_get_ns() + NSEC_PER_SEC);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN mask-control submission: enable=0 status=%d\n", ret);
+		if (ret) {
+			mac->first_error = ret;
+			return ret;
+		}
+		mac->monitor_left_on = false;
+	}
+	/* The normal gen3 RX-mode path requests broadcast reception. Send
+	 * only that supported filter word; no native/monitor selector is used.
+	 * Submission and returned command credit do not prove application.
+	 */
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_SCAN_BROADCAST,
+			      broadcast, sizeof(broadcast));
+	if (ret)
+		return ret;
+	mt6797_scan_bss(mac->hw->wiphy->perm_addr, true, bss);
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_BSS_ACTIVE, bss, sizeof(bss));
+	if (ret)
+		return ret;
+	mac->bss_active = true;
+	return 0;
+}
+
+/* A join from an earlier scan's results, as in a roam: open the lifetime a scan
+ * would have left. Called with the mutex held, on a re-armed idle driver.
+ */
+int mt6797_mac_join_open_lifetime(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+	u64 end;
+	int ret;
+
+	if (!mac->scan_ready || !mac->started || mac->closing || mac->first_error ||
+	    mac->join_closed || mac->scan_used || mac->scan_online ||
+	    mac->scan_online_cancel)
+		return -EOPNOTSUPP;
+	if (!mac->sequence_base)
+		mac->sequence_base = mac->sequence;
+	ret = mt6797_mac_lifetime_begin(mac);
+	/* The peer commands start from an idle ledger, as after a scan. */
+	end = ktime_get_ns() + 500 * NSEC_PER_MSEC;
+	while (!ret && !mt6797_hif_normal_idle(mac->hif)) {
+		if (ktime_get_ns() >= end)
+			ret = -ETIMEDOUT;
+		else
+			ret = mt6797_mac_scan_guard(mac, end);
+	}
+	if (ret) {
+		if (!mac->first_error)
+			mac->first_error = ret;
+		mac->closing = true;
+		return ret;
+	}
+	mac->join_scan_ready = true;
+	mac->join_deadline = ktime_get_ns() + 10 * NSEC_PER_SEC;
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = true;
+	schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join without a scan: lifetime=%u sequence=%u\n",
+		 mac->join_lifetimes, mac->sequence);
+	return 0;
+}
