@@ -880,8 +972,6 @@ static int mt6797_mac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif
 	bool online;
 	unsigned int i, probing = 0, passive = 0;
 	u64 mask = 0;
