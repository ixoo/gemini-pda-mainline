-		mac->join_lifetimes++;
-	ret = mt6797_mac_scan_guard(mac, ktime_get_ns() + NSEC_PER_SEC);
-	if (ret) {
-		mac->first_error = ret;
-		goto out;
-	}
-	if (mac->monitor_left_on) {
-		ret = mt6797_hif_diag_mask(mac->hif, mac->sequence++, false,
-					   ktime_get_ns() + NSEC_PER_SEC);
-		dev_info(wiphy_dev(hw->wiphy),
-			 "one-shot WLAN mask-control submission: enable=0 status=%d\n", ret);
-		if (ret) {
-			mac->first_error = ret;
-			goto out;
-		}
-		mac->monitor_left_on = false;
-	}
-	/* The normal gen3 RX-mode path requests broadcast reception. Send
-	 * only that supported filter word; no native/monitor selector is used.
-	 * Submission and returned command credit do not prove application.
-	 */
-	ret = mt6797_mac_send(mac, MT6797_NORMAL_SCAN_BROADCAST,
-			      broadcast, sizeof(broadcast));
-	if (ret)
-		goto out;
-	mt6797_scan_bss(hw->wiphy->perm_addr, true, bss);
-	ret = mt6797_mac_send(mac, MT6797_NORMAL_BSS_ACTIVE, bss, sizeof(bss));
+	ret = mt6797_mac_lifetime_begin(mac);
 	if (ret)
 		goto out;
-	mac->bss_active = true;
 	mac->scan_total = request->req.n_channels;
 	mac->scan_next = 0;
 	mac->scan_sequence = 0;
@@ -1623,6 +1678,23 @@ static int mt6797_mac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	return ret;
 }
 
+/* Called with the mutex held, which it drops while waiting; the worker owns
+ * both ends. Bounded: a late end costs that join, never a stuck mac80211 call.
+ */
+void mt6797_mac_join_await(struct mt6797_mac *mac, bool teardown)
+{
+	u64 end = ktime_get_ns() + (u64)MT6797_JOIN_AWAIT_MS * NSEC_PER_MSEC;
+
+	while (ktime_get_ns() < end && !mac->first_error && !mac->closing &&
+	       !mac->join_closed && (teardown ?
+	       mac->join_peer_used && !mac->join_cleanup_done :
+	       mac->scan_used && !mac->scan_active && !mac->join_scan_ready)) {
+		mutex_unlock(&mac->mutex);
+		msleep(5);
+		mutex_lock(&mac->mutex);
+	}
+}
+
 static int mt6797_mac_sta_state(struct ieee80211_hw *hw,
 				struct ieee80211_vif *vif, struct ieee80211_sta *sta,
 				enum ieee80211_sta_state old,
@@ -1688,6 +1760,11 @@ static int mt6797_mac_sta_state(struct ieee80211_hw *hw,
 					}
 				}
 			}
+			/* mac80211 moves to a new access point's channel straight
+			 * after this. The deauthentication still uses the old one.
+			 */
+			if (!close && new == IEEE80211_STA_NOTEXIST)
+				mt6797_mac_join_await(mac, true);
 			mutex_unlock(&mac->mutex);
 			if (close)
 				mt6797_mac_join_close(mac);
