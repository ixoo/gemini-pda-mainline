From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 21:23:49 -0500
Subject: [PATCH 575/576] media: mediatek: mt6797-seninf: take the sensor's
 flipped Bayer order

Accept RGGB as well as GRBG on the receiver and the node, and fail with EPIPE at
stream start if the node's format does not match what the sensor reports.
---
 .../platform/mediatek/seninf/mt6797-seninf.c  | 54 +++++++++++++++----
 drivers/media/v4l2-core/v4l2-ioctl.c          |  1 +
 include/uapi/linux/videodev2.h                |  1 +
 3 files changed, 47 insertions(+), 9 deletions(-)

diff --git a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
index a6e536d61..30228a472 100644
--- a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
+++ b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
@@ -191,7 +191,6 @@
 #define CAPTURE_MAX_WIDTH		2592
 #define CAPTURE_MAX_HEIGHT		1944
 #define CAPTURE_BYTESPERLINE(w)		((w) * 10 / 8)
-#define CAPTURE_MBUS_CODE		MEDIA_BUS_FMT_SGRBG10_1X10
 /* Longer than a frame at the slowest rate the sensor's default mode runs. */
 #define CAPTURE_STOP_MS			40
 
@@ -219,6 +218,15 @@
 
 #define SENINF_NUM_TG			4
 
+/* The sensor's flip changes the Bayer order; the hardware does not mind which. */
+static const struct {
+	u32 code;
+	u32 fourcc;
+} seninf_formats[] = {
+	{ MEDIA_BUS_FMT_SGRBG10_1X10, V4L2_PIX_FMT_MTISP_SGRBG10 },
+	{ MEDIA_BUS_FMT_SRGGB10_1X10, V4L2_PIX_FMT_MTISP_SRGGB10 },
+};
+
 static const char * const seninf_clk_names[] = { "camsys", "seninf" };
 
 struct seninf_mclk {
@@ -501,7 +509,7 @@ static const struct v4l2_subdev_video_ops seninf_video_ops = {
 static const struct v4l2_mbus_framefmt seninf_default_fmt = {
 	.width = CAPTURE_MAX_WIDTH,
 	.height = CAPTURE_MAX_HEIGHT,
-	.code = CAPTURE_MBUS_CODE,
+	.code = MEDIA_BUS_FMT_SGRBG10_1X10,
 	.field = V4L2_FIELD_NONE,
 	.colorspace = V4L2_COLORSPACE_RAW,
 };
@@ -516,9 +524,9 @@ static int seninf_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *s
 static int seninf_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
 				 struct v4l2_subdev_mbus_code_enum *code)
 {
-	if (code->index)
+	if (code->index >= ARRAY_SIZE(seninf_formats))
 		return -EINVAL;
-	code->code = CAPTURE_MBUS_CODE;
+	code->code = seninf_formats[code->index].code;
 	return 0;
 }
 
@@ -526,12 +534,17 @@ static int seninf_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *stat
 			  struct v4l2_subdev_format *fmt)
 {
 	struct v4l2_mbus_framefmt *format = &fmt->format;
+	unsigned int i;
 
 	/* The source follows the sink. */
 	if (fmt->pad == SENINF_PAD_SOURCE)
 		return v4l2_subdev_get_fmt(sd, state, fmt);
 
-	format->code = CAPTURE_MBUS_CODE;
+	for (i = 0; i < ARRAY_SIZE(seninf_formats); i++)
+		if (format->code == seninf_formats[i].code)
+			break;
+	if (i == ARRAY_SIZE(seninf_formats))
+		format->code = seninf_formats[0].code;
 	format->width = clamp_t(u32, ALIGN_DOWN(format->width, 4), 4, CAPTURE_MAX_WIDTH);
 	format->height = clamp_t(u32, ALIGN_DOWN(format->height, 2), 2, CAPTURE_MAX_HEIGHT);
 	format->field = V4L2_FIELD_NONE;
@@ -772,6 +785,7 @@ static int seninf_check_format(struct mt6797_seninf *seninf)
 		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
 		.pad = SENINF_PAD_SOURCE,
 	};
+	unsigned int i;
 	int ret;
 
 	ret = v4l2_subdev_call_state_active(&seninf->sd, pad, get_fmt, &fmt);
@@ -779,7 +793,10 @@ static int seninf_check_format(struct mt6797_seninf *seninf)
 		return ret;
 	if (fmt.format.width != seninf->fmt.width || fmt.format.height != seninf->fmt.height)
 		return -EPIPE;
-	return 0;
+	for (i = 0; i < ARRAY_SIZE(seninf_formats); i++)
+		if (fmt.format.code == seninf_formats[i].code)
+			return seninf_formats[i].fourcc == seninf->fmt.pixelformat ? 0 : -EPIPE;
+	return -EPIPE;
 }
 
 static int seninf_start_streaming(struct vb2_queue *q, unsigned int count)
@@ -874,15 +891,34 @@ static int seninf_querycap(struct file *file, void *fh, struct v4l2_capability *
 
 static int seninf_enum_fmt(struct file *file, void *fh, struct v4l2_fmtdesc *f)
 {
-	if (f->index || (f->mbus_code && f->mbus_code != CAPTURE_MBUS_CODE))
+	unsigned int i;
+
+	if (f->mbus_code) {
+		if (f->index)
+			return -EINVAL;
+		for (i = 0; i < ARRAY_SIZE(seninf_formats); i++) {
+			if (f->mbus_code == seninf_formats[i].code) {
+				f->pixelformat = seninf_formats[i].fourcc;
+				return 0;
+			}
+		}
+		return -EINVAL;
+	}
+	if (f->index >= ARRAY_SIZE(seninf_formats))
 		return -EINVAL;
-	f->pixelformat = V4L2_PIX_FMT_MTISP_SGRBG10;
+	f->pixelformat = seninf_formats[f->index].fourcc;
 	return 0;
 }
 
 static void seninf_fill_fmt(struct v4l2_pix_format *fmt)
 {
-	fmt->pixelformat = V4L2_PIX_FMT_MTISP_SGRBG10;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(seninf_formats); i++)
+		if (fmt->pixelformat == seninf_formats[i].fourcc)
+			break;
+	if (i == ARRAY_SIZE(seninf_formats))
+		fmt->pixelformat = seninf_formats[0].fourcc;
 	fmt->width = clamp_t(u32, ALIGN_DOWN(fmt->width, 4), 4, CAPTURE_MAX_WIDTH);
 	fmt->height = clamp_t(u32, ALIGN_DOWN(fmt->height, 2), 2, CAPTURE_MAX_HEIGHT);
 	fmt->field = V4L2_FIELD_NONE;
diff --git a/drivers/media/v4l2-core/v4l2-ioctl.c b/drivers/media/v4l2-core/v4l2-ioctl.c
index 585add23c..9ef09e90e 100644
--- a/drivers/media/v4l2-core/v4l2-ioctl.c
+++ b/drivers/media/v4l2-core/v4l2-ioctl.c
@@ -1408,6 +1408,7 @@ static void v4l_fill_fmtdesc(struct v4l2_fmtdesc *fmt)
 	case V4L2_PIX_FMT_SGRBG10ALAW8:	descr = "8-bit Bayer GRGR/BGBG (A-law)"; break;
 	case V4L2_PIX_FMT_SRGGB10ALAW8:	descr = "8-bit Bayer RGRG/GBGB (A-law)"; break;
 	case V4L2_PIX_FMT_MTISP_SGRBG10:	descr = "10-bit Bayer GRGR/BGBG MediaTek Packed"; break;
+	case V4L2_PIX_FMT_MTISP_SRGGB10:	descr = "10-bit Bayer RGRG/GBGB MediaTek Packed"; break;
 	case V4L2_PIX_FMT_SBGGR10DPCM8:	descr = "8-bit Bayer BGBG/GRGR (DPCM)"; break;
 	case V4L2_PIX_FMT_SGBRG10DPCM8:	descr = "8-bit Bayer GBGB/RGRG (DPCM)"; break;
 	case V4L2_PIX_FMT_SGRBG10DPCM8:	descr = "8-bit Bayer GRGR/BGBG (DPCM)"; break;
diff --git a/include/uapi/linux/videodev2.h b/include/uapi/linux/videodev2.h
index 8e9c90494..cdfb9860b 100644
--- a/include/uapi/linux/videodev2.h
+++ b/include/uapi/linux/videodev2.h
@@ -873,6 +873,7 @@ struct v4l2_pix_format {
 
 /* 10-bit Bayer packed LSB first, 4 pixels in 5 bytes - used for MediaTek cameras */
 #define V4L2_PIX_FMT_MTISP_SGRBG10 v4l2_fourcc('M', 'B', 'g', 'A')
+#define V4L2_PIX_FMT_MTISP_SRGGB10 v4l2_fourcc('M', 'B', 'R', 'A')
 
 /* Vendor specific - used for RK_ISP1 camera sub-system */
 #define V4L2_META_FMT_RK_ISP1_PARAMS	v4l2_fourcc('R', 'K', '1', 'P') /* Rockchip ISP1 3A Parameters */
