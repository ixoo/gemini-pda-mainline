From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Sun, 1 Nov 2026 20:46:09 -0500
Subject: [PATCH 458/458] wifi: mt6797: report the signal threshold

The driver sets the beacon filter flag, and mac80211 refuses a signal
threshold on such an interface unless the driver reports it, so wpa_supplicant's
bgscan could not ask to hear of a weak signal.

Average the signal of the access point's beacons, which the driver still
receives and delivers, and send the threshold events with mac80211's weight
and rule. The average restarts with each lifetime, for a new access point.

Part of the Wi-Fi daily-use plan, phase 4.
---
 drivers/net/wireless/mediatek/mt6797/data.c   | 36 +++++++++++++++++--
 drivers/net/wireless/mediatek/mt6797/join.c   |  2 ++
 .../net/wireless/mediatek/mt6797/mac-priv.h   |  3 ++
 drivers/net/wireless/mediatek/mt6797/main.c   | 13 +++++--
 4 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/data.c b/drivers/net/wireless/mediatek/mt6797/data.c
index 868eb7905..bacf0b88d 100644
--- a/drivers/net/wireless/mediatek/mt6797/data.c
+++ b/drivers/net/wireless/mediatek/mt6797/data.c
@@ -1743,6 +1743,36 @@ static void mt6797_ccmp_pm_beacon(struct mt6797_mac *mac, size_t offset, size_t
 	complete_all(&mac->ccmp_dtim_done);
 }
 
+/* The firmware filters beacons for mac80211's monitor, so its threshold
+ * events are the driver's to send. Same average weight and rule as mac80211's.
+ */
+static void mt6797_mac_cqm_signal(struct mt6797_mac *mac, int signal)
+{
+	enum nl80211_cqm_rssi_threshold_event event;
+	int average;
+
+	mac->cqm_average = mac->cqm_samples ?
+		mac->cqm_average + (signal * 16 - mac->cqm_average) / 4 : signal * 16;
+	if (mac->cqm_samples < UINT_MAX)
+		mac->cqm_samples++;
+	if (!mac->cqm_thold || mac->cqm_samples < 4 || !mac->vif)
+		return;
+	average = mac->cqm_average / 16;
+	if (average < mac->cqm_thold &&
+	    (!mac->cqm_last || average < mac->cqm_last - (int)mac->cqm_hyst))
+		event = NL80211_CQM_RSSI_THRESHOLD_EVENT_LOW;
+	else if (average > mac->cqm_thold &&
+		 (!mac->cqm_last || average > mac->cqm_last + (int)mac->cqm_hyst))
+		event = NL80211_CQM_RSSI_THRESHOLD_EVENT_HIGH;
+	else
+		return;
+	mac->cqm_last = average;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN signal threshold: event=%u average=%d samples=%u\n",
+		 event, average, mac->cqm_samples);
+	ieee80211_cqm_rssi_notify(mac->vif, event, average, GFP_KERNEL);
+}
+
 int mt6797_mac_join_deliver_beacon(struct mt6797_mac *mac, size_t offset,
 				   size_t bytes, unsigned int rcpi,
 					  bool keyed, struct sk_buff_head *received)
@@ -1755,10 +1785,12 @@ int mt6797_mac_join_deliver_beacon(struct mt6797_mac *mac, size_t offset,
 	memset(IEEE80211_SKB_RXCB(skb), 0, sizeof(struct ieee80211_rx_status));
 	IEEE80211_SKB_RXCB(skb)->band = mac->join_chan_band;
 	IEEE80211_SKB_RXCB(skb)->freq = mac->join_chan_freq;
-	if (rcpi <= 220)
+	if (rcpi <= 220) {
 		IEEE80211_SKB_RXCB(skb)->signal = (int)rcpi / 2 - 110;
-	else
+		mt6797_mac_cqm_signal(mac, (int)rcpi / 2 - 110);
+	} else {
 		IEEE80211_SKB_RXCB(skb)->flag |= RX_FLAG_NO_SIGNAL_VAL;
+	}
 	mt6797_ccmp_pm_beacon(mac, offset, bytes);
 	__skb_queue_tail(received, skb);
 	return 0;
diff --git a/drivers/net/wireless/mediatek/mt6797/join.c b/drivers/net/wireless/mediatek/mt6797/join.c
index 61694b577..36fbcf619 100644
--- a/drivers/net/wireless/mediatek/mt6797/join.c
+++ b/drivers/net/wireless/mediatek/mt6797/join.c
@@ -759,6 +759,8 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_submitted = 0;
 	mac->join_sta_removed = false;
 	mac->join_rearm_pending = false;
+	mac->cqm_samples = 0;
+	mac->cqm_last = 0;
 	mt6797_mac_epoch_reset(mac);
 	/* join_next_pid stays monotonic; the PID pool restarts with the epoch. */
 	reinit_completion(&mac->join_channel_done);
diff --git a/drivers/net/wireless/mediatek/mt6797/mac-priv.h b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
index 9924e1aa2..b03967da5 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac-priv.h
+++ b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
@@ -634,6 +634,9 @@ struct mt6797_mac {
 	unsigned int scan_packets;
 	/* A scan while connected: the worker submits it and reads its events. */
 	bool scan_online, scan_online_ready, scan_online_cancel;
+	/* Signal threshold, from the access point's beacons (1/16 dB average). */
+	int cqm_thold, cqm_last, cqm_average;
+	unsigned int cqm_hyst, cqm_samples;
 	/* The firmware's monitor mask is still on from an earlier data phase. */
 	bool monitor_left_on;
 	bool scan_ready, started, scan_used, scan_active, bss_active;
diff --git a/drivers/net/wireless/mediatek/mt6797/main.c b/drivers/net/wireless/mediatek/mt6797/main.c
index ffd8dc04e..0c3af5bef 100644
--- a/drivers/net/wireless/mediatek/mt6797/main.c
+++ b/drivers/net/wireless/mediatek/mt6797/main.c
@@ -1157,7 +1157,8 @@ static int mt6797_mac_add_interface(struct ieee80211_hw *hw,
 	    !mac->closing && !mac->first_error &&
 	    vif->type == NL80211_IFTYPE_STATION &&
 	    ether_addr_equal(vif->addr, hw->wiphy->perm_addr)) {
-		vif->driver_flags |= IEEE80211_VIF_BEACON_FILTER;
+		vif->driver_flags |= IEEE80211_VIF_BEACON_FILTER |
+				     IEEE80211_VIF_SUPPORTS_CQM_RSSI;
 		mac->vif = vif;
 		ret = 0;
 	}
@@ -1174,7 +1175,8 @@ static void mt6797_mac_remove_interface(struct ieee80211_hw *hw,
 	mt6797_mac_cancel_scan(hw, vif);
 	mutex_lock(&mac->mutex);
 	if (mac->vif == vif)
-		vif->driver_flags &= ~IEEE80211_VIF_BEACON_FILTER;
+		vif->driver_flags &= ~(IEEE80211_VIF_BEACON_FILTER |
+				       IEEE80211_VIF_SUPPORTS_CQM_RSSI);
 	mac->vif = NULL;
 	/* Retain the wire BSS lifetime through recovery, never reuse its slot. */
 	mac->closing = true;
@@ -1247,6 +1249,13 @@ static void mt6797_mac_bss_info_changed(struct ieee80211_hw *hw,
 {
 	struct mt6797_mac *mac = hw->priv;
 
+	if (changed & BSS_CHANGED_CQM) {
+		mutex_lock(&mac->mutex);
+		mac->cqm_thold = info->cqm_rssi_thold;
+		mac->cqm_hyst = info->cqm_rssi_hyst;
+		mac->cqm_last = 0;
+		mutex_unlock(&mac->mutex);
+	}
 	if (!(changed & (BSS_CHANGED_BSSID | BSS_CHANGED_BASIC_RATES |
 			 BSS_CHANGED_BEACON_INT)))
 		return;
