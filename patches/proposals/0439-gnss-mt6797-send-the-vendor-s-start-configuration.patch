From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 1 Nov 2026 10:12:53 -0500
Subject: [PATCH] gnss: mt6797: send the vendor's start configuration

The first start sent MNL_INIT_CFG empty, which the vendor host only does
when it has no configuration. Send the 49 bytes mnld builds for chip 0x6797
with no mnl.prop and no clock calibration, in the vendor's order. The NV
download open stays left out. This alone is not expected to avoid the
firmware exception, which is reached by the frame before this one.

Keep 128 bytes before a failure and 1024 after it, and log them in full, so
the firmware's whole dump is on record. Log the configuration and the types
sent. Received GFNS payloads stay out of the log, as they can hold position.

The start stays opt-in with start_engine=1.
---
 drivers/gnss/mt6797-gfns.h               | 28 +++++++++++++++++++++++-
 drivers/gnss/mt6797.c                    | 10 ++++++---
 drivers/soc/mediatek/mt6797-consys.c     | 19 +++++++++++-----
 drivers/soc/mediatek/mt6797-stp-engine.h |  7 +++---
 4 files changed, 52 insertions(+), 12 deletions(-)

diff --git a/drivers/gnss/mt6797-gfns.h b/drivers/gnss/mt6797-gfns.h
index 592e3051d..2c73ed9bf 100644
--- a/drivers/gnss/mt6797-gfns.h
+++ b/drivers/gnss/mt6797-gfns.h
@@ -19,7 +19,7 @@
 #define GFNS_RSP_ACK		0x35	/* the firmware's receive counters */
 #define GFNS_RSP_ACK_RESET	0x36	/* start of the host's 0x7e ACKs */
 #define GFNS_REQ_MNL_INIT	0x13
-#define GFNS_REQ_MNL_INIT_CFG	0x14	/* empty: the firmware's defaults */
+#define GFNS_REQ_MNL_INIT_CFG	0x14
 #define GFNS_REQ_START		0x40
 #define GFNS_REQ_STOP		0x41
 #define GFNS_REQ_DEL_NV		0x44
@@ -27,6 +27,7 @@
 #define GFNS_REQ_ACK		0x7e
 #define GFNS_REQ_UTC		0x83
 #define GFNS_ACK_BYTES		28U
+#define GFNS_CFG_BYTES		49U
 #define GFNS_ACK_EVERY		0x800U
 #define GFNS_KEEP_ALIVE_EVERY	0x400U
 #define GFNS_OVERHEAD		(GFNS_HEADER + 1)
@@ -143,6 +144,31 @@ static inline void gfns_ack(unsigned char out[GFNS_ACK_BYTES], unsigned int rece
 	gfns_put32(out + 24, 0x10);
 }
 
+/*
+ * The initial configuration mnld builds for chip 0x6797 with no mnl.prop and no
+ * clock calibration record: TCXO at 26 MHz, 2000 ppb, a fix per second. The four
+ * calibration words at the end stay zero, as in mnld when that record is absent.
+ */
+static inline void gfns_cfg(unsigned char out[GFNS_CFG_BYTES])
+{
+	unsigned int i;
+
+	for (i = 0; i < GFNS_CFG_BYTES; i++)
+		out[i] = 0;
+	out[0] = 1;			/* if_type */
+	out[3] = 2;			/* dgps_mode */
+	out[5] = 100;			/* pps_duty */
+	out[8] = 0xff;			/* u1ClockType: TCXO */
+	out[9] = 2000 & 0xff;		/* hw_Clock_Drift */
+	out[10] = 2000 >> 8;
+	gfns_put32(out + 11, 26000000);	/* hw_Clock_Freq */
+	gfns_put32(out + 15, 115200);	/* if_link_spd */
+	gfns_put32(out + 19, 1000);	/* fix_interval */
+	gfns_put32(out + 24, 0x800000f0);	/* chip version value, SNR flag */
+	gfns_put32(out + 28, 0xffff6797);	/* chip version type */
+	out[32] = 2;			/* GNSSOPMode */
+}
+
 /* UTC broken down: year since 1900, month from zero; the rest stays zero. */
 static inline void gfns_utc(unsigned char out[12], unsigned int year, unsigned int month,
 			    unsigned int day, unsigned int hour, unsigned int minute,
diff --git a/drivers/gnss/mt6797.c b/drivers/gnss/mt6797.c
index 66a009b54..468a182af 100644
--- a/drivers/gnss/mt6797.c
+++ b/drivers/gnss/mt6797.c
@@ -48,7 +48,7 @@ struct mt6797_gnss {
 static int mt6797_gnss_send(struct mt6797_gnss *gnss, unsigned int type,
 			    const u8 *payload, unsigned int length)
 {
-	u8 frame[GFNS_OVERHEAD + GFNS_ACK_BYTES];
+	u8 frame[GFNS_OVERHEAD + GFNS_CFG_BYTES];
 	unsigned long flags;
 	unsigned int bytes;
 	int ret;
@@ -134,13 +134,15 @@ static int mt6797_gnss_receive(void *context, const u8 *payload, unsigned int le
 static int mt6797_gnss_start(struct mt6797_gnss *gnss)
 {
 	static const u8 delete_nothing[4];
+	u8 cfg[GFNS_CFG_BYTES], utc[12];
 	struct tm time;
-	u8 utc[12];
 	int ret;
 
+	gfns_cfg(cfg);
+	dev_info(gnss->dev, "GFNS start: config %*ph\n", 32, cfg);
 	ret = mt6797_gnss_send(gnss, GFNS_REQ_MNL_INIT, NULL, 0);
 	if (!ret)
-		ret = mt6797_gnss_send(gnss, GFNS_REQ_MNL_INIT_CFG, NULL, 0);
+		ret = mt6797_gnss_send(gnss, GFNS_REQ_MNL_INIT_CFG, cfg, sizeof(cfg));
 	if (!ret)
 		ret = mt6797_gnss_send(gnss, GFNS_REQ_DEL_NV, delete_nothing,
 				       sizeof(delete_nothing));
@@ -152,6 +154,8 @@ static int mt6797_gnss_start(struct mt6797_gnss *gnss)
 	ret = mt6797_gnss_send(gnss, GFNS_REQ_UTC, utc, sizeof(utc));
 	if (!ret)
 		ret = mt6797_gnss_send(gnss, GFNS_REQ_START, NULL, 0);
+	dev_info(gnss->dev, "GFNS start: types 13 14 44 83 40 sent=%u result=%d\n",
+		 gnss->sent, ret);
 	return ret;
 }
 
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index 7997a9403..84ba572ad 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -1719,6 +1719,15 @@ static void mt6797_stp_pump(struct mt6797_stp *s)
 	writel(stp_engine_tx_pending(&s->engine) ? 3 : 1, s->btif + WMT_BTIF_IER);
 }
 
+static void mt6797_stp_dump(const char *what, const unsigned char *bytes,
+			    unsigned int count)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i += 64)
+		pr_err("mt6797-consys: %s +%u: %*ph\n", what, i, min(count - i, 64U), bytes + i);
+}
+
 /*
  * Lock held. Fail-stop: no transmit, retry or resync; power and clocks stay as
  * they are. Receive keeps draining until the last detach, so the firmware is not
@@ -1736,8 +1745,8 @@ static void mt6797_stp_stop_locked(struct mt6797_stp *s)
 		stp_engine_fail(&s->engine, STP_ENGINE_EIO);
 	writel(1, s->btif + WMT_BTIF_IER);
 	count = stp_engine_trail(&s->engine, trail);
-	pr_err("mt6797-consys: STP link trail, %u of %u bytes: %*ph\n", count,
-	       s->engine.trail_count, count, trail);
+	pr_err("mt6797-consys: STP link trail, %u of %u bytes\n", count, s->engine.trail_count);
+	mt6797_stp_dump("trail", trail, count);
 	if (s->wmt_waiting) {
 		s->wmt_waiting = false;
 		complete(&s->wmt_done);
@@ -1957,9 +1966,9 @@ static void mt6797_stp_halt(struct device *dev, struct mt6797_stp *s)
 		 s->engine.rx_duplicates, s->engine.tx_frames, s->engine.tx_acks,
 		 s->wmt_unsolicited, s->wmt_first_length,
 		 min_t(int, s->wmt_first_length, sizeof(s->wmt_first)), s->wmt_first);
-	dev_info(dev, "STP link firmware messages: assert=%u log=%u; after failure %u bytes: %*ph\n",
-		 s->messages[0], s->messages[1], s->engine.after_count,
-		 s->engine.after_count, s->engine.after);
+	dev_info(dev, "STP link firmware messages: assert=%u log=%u; after failure %u bytes\n",
+		 s->messages[0], s->messages[1], s->engine.after_count);
+	mt6797_stp_dump("after", s->engine.after, s->engine.after_count);
 }
 
 /*
diff --git a/drivers/soc/mediatek/mt6797-stp-engine.h b/drivers/soc/mediatek/mt6797-stp-engine.h
index 922ae78f2..97b8ada93 100644
--- a/drivers/soc/mediatek/mt6797-stp-engine.h
+++ b/drivers/soc/mediatek/mt6797-stp-engine.h
@@ -19,7 +19,8 @@
 #define STP_ENGINE_QUEUE 8U
 #define STP_ENGINE_TASK_ASSERT 5U
 #define STP_ENGINE_TASK_LOG 6U
-#define STP_ENGINE_TRAIL 64U
+#define STP_ENGINE_TRAIL 128U
+#define STP_ENGINE_AFTER 1024U
 
 enum stp_engine_error {
 	STP_ENGINE_OK,
@@ -55,7 +56,7 @@ struct stp_engine {
 			unsigned int length);
 	void *message_context;
 	/* The last bytes received before a failure, and the first ones after it. */
-	unsigned char trail[STP_ENGINE_TRAIL], after[STP_ENGINE_TRAIL];
+	unsigned char trail[STP_ENGINE_TRAIL], after[STP_ENGINE_AFTER];
 	unsigned int trail_count, after_count;
 	/* Bound clients; route[] holds one entry per ordinary task. */
 	struct stp_engine_binding bindings[STP_FULL_MAX_CLIENTS];
@@ -229,7 +230,7 @@ static inline int stp_engine_rx(struct stp_engine *e, unsigned char byte,
 	int kind;
 
 	if (e->failed) {
-		if (e->after_count < STP_ENGINE_TRAIL)
+		if (e->after_count < STP_ENGINE_AFTER)
 			e->after[e->after_count++] = byte;
 		return e->failed;
 	}
