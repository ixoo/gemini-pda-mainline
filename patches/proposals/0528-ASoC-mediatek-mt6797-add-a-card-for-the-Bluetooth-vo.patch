From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Tue, 3 Nov 2026 18:50:15 -0500
Subject: [PATCH] ASoC: mediatek: mt6797: add a card for the Bluetooth voice
 path

The upstream btcvsd driver registers a component with no DAIs, so it needs a machine
driver before it has a PCM. On MT6797, Bluetooth voice travels this way and not over
HCI.

Add a separate small card rather than links on the main one, so that the working audio
card neither waits for this driver nor changes if it fails. It has one link over the
dummy DAIs.
---
 .../sound/mediatek,mt6797-btcvsd-sound.yaml   | 31 ++++++++++
 sound/soc/mediatek/Kconfig                    |  9 +++
 sound/soc/mediatek/mt6797/Makefile            |  1 +
 sound/soc/mediatek/mt6797/mt6797-btcvsd.c     | 62 +++++++++++++++++++
 4 files changed, 103 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/mediatek,mt6797-btcvsd-sound.yaml
 create mode 100644 sound/soc/mediatek/mt6797/mt6797-btcvsd.c

diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6797-btcvsd-sound.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6797-btcvsd-sound.yaml
new file mode 100644
index 000000000..82468628c
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6797-btcvsd-sound.yaml
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6797-btcvsd-sound.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 Bluetooth voice sound card
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+properties:
+  compatible:
+    const: mediatek,mt6797-btcvsd-sound
+
+  mediatek,platform:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The mediatek,mtk-btcvsd-snd node.
+
+required:
+  - compatible
+  - mediatek,platform
+
+additionalProperties: false
+
+examples:
+  - |
+    sound {
+        compatible = "mediatek,mt6797-btcvsd-sound";
+        mediatek,platform = <&btcvsd>;
+    };
diff --git a/sound/soc/mediatek/Kconfig b/sound/soc/mediatek/Kconfig
index 3a1e1fa3f..92ae0269b 100644
--- a/sound/soc/mediatek/Kconfig
+++ b/sound/soc/mediatek/Kconfig
@@ -56,6 +56,15 @@ config SND_SOC_MT6797_MT6351
 	  Select Y if you have such device.
 	  If unsure select "N".
 
+config SND_SOC_MT6797_BTCVSD
+	tristate "ASoC card for the MT6797 Bluetooth voice path"
+	depends on SND_SOC_MT6797
+	select SND_SOC_MTK_BTCVSD
+	help
+	  This adds a sound card for the Bluetooth voice path on Mediatek
+	  MT6797 boards, which moves coded packets through CONSYS memory.
+	  If unsure select "N".
+
 config SND_SOC_MT7986
 	tristate "ASoC support for Mediatek MT7986 chip"
 	depends on ARCH_MEDIATEK
diff --git a/sound/soc/mediatek/mt6797/Makefile b/sound/soc/mediatek/mt6797/Makefile
index 150021495..76f09ca22 100644
--- a/sound/soc/mediatek/mt6797/Makefile
+++ b/sound/soc/mediatek/mt6797/Makefile
@@ -12,3 +12,4 @@ obj-$(CONFIG_SND_SOC_MT6797) += snd-soc-mt6797-afe.o
 
 # machine driver
 obj-$(CONFIG_SND_SOC_MT6797_MT6351) += mt6797-mt6351.o
+obj-$(CONFIG_SND_SOC_MT6797_BTCVSD) += mt6797-btcvsd.o
diff --git a/sound/soc/mediatek/mt6797/mt6797-btcvsd.c b/sound/soc/mediatek/mt6797/mt6797-btcvsd.c
new file mode 100644
index 000000000..cad063cd7
--- /dev/null
+++ b/sound/soc/mediatek/mt6797/mt6797-btcvsd.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The MT6797 Bluetooth voice path: btcvsd moves coded packets between the CONSYS
+ * SRAM and one PCM device. A card of its own keeps the main audio card independent.
+ */
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/soc.h>
+
+SND_SOC_DAILINK_DEFS(btcvsd,
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link mt6797_btcvsd_link = {
+	.name = "BTCVSD",
+	.stream_name = "BTCVSD",
+	SND_SOC_DAILINK_REG(btcvsd),
+};
+
+static struct snd_soc_card mt6797_btcvsd_card = {
+	.name = "mt6797-btcvsd",
+	.owner = THIS_MODULE,
+	.dai_link = &mt6797_btcvsd_link,
+	.num_links = 1,
+};
+
+static int mt6797_btcvsd_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &mt6797_btcvsd_card;
+	struct device_node *platform;
+	int ret;
+
+	card->dev = &pdev->dev;
+	platform = of_parse_phandle(pdev->dev.of_node, "mediatek,platform", 0);
+	if (!platform)
+		return dev_err_probe(&pdev->dev, -EINVAL, "no mediatek,platform\n");
+	mt6797_btcvsd_link.platforms->of_node = platform;
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	of_node_put(platform);
+	return ret;
+}
+
+static const struct of_device_id mt6797_btcvsd_match[] = {
+	{ .compatible = "mediatek,mt6797-btcvsd-sound" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, mt6797_btcvsd_match);
+
+static struct platform_driver mt6797_btcvsd_driver = {
+	.driver = {
+		.name = "mt6797-btcvsd",
+		.of_match_table = mt6797_btcvsd_match,
+	},
+	.probe = mt6797_btcvsd_probe,
+};
+module_platform_driver(mt6797_btcvsd_driver);
+
+MODULE_DESCRIPTION("MT6797 Bluetooth voice sound card");
+MODULE_LICENSE("GPL");
-- 
2.43.0

