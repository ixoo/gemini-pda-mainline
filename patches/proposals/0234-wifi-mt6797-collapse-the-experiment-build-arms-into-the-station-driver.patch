 drivers/net/wireless/mediatek/mt6797/hif.c    |  52 -----
 drivers/net/wireless/mediatek/mt6797/hif.h    |   9 -
 .../mediatek/mt6797/join-command-submit.h     |  12 +-
 .../wireless/mediatek/mt6797/join-commands.h  |  22 --
 .../wireless/mediatek/mt6797/lifetime-fence.h |  71 ------
 drivers/net/wireless/mediatek/mt6797/mac.c    | 111 +--------
 .../wireless/mediatek/mt6797/native-diag.h    |   4 -
 .../wireless/mediatek/mt6797/normal_command.h |  64 ------
 .../net/wireless/mediatek/mt6797/pn-epoch.h   |  99 ---------
 10 files changed, 42 insertions(+), 612 deletions(-)
 delete mode 100644 drivers/net/wireless/mediatek/mt6797/lifetime-fence.h
 delete mode 100644 drivers/net/wireless/mediatek/mt6797/pn-epoch.h

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index f8a0388e2..3956584bb 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -1,208 +1,72 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config MT6797_HIF_CORE
-	bool "MT6797 private WLAN HIF transport core"
+	bool "MT6797 WLAN host interface transport"
 	depends on ARM64 && FW_LOADER
 	select CRC32
 	default n
 	help
-	  Build the private ordered AHB transport and bounded ordinary INIT
-	  section implementation. There is no platform probe or runtime caller
-	  until a real CONSYS owner supplies the required powered mapping and
-	  exclusion. This option does not provide a usable Wi-Fi device.
+	  Build the ordered AHB transport, the firmware image loader and the
+	  bounded ordinary INIT section implementation for the MT6797
+	  connectivity subsystem. The CONSYS owner supplies the powered mapping
+	  and exclusion; this option alone provides no Wi-Fi device.
 
 config MT6797_MAC80211
-	bool "MT6797 WLAN regulatory configuration integration"
+	bool "MT6797 WLAN mac80211 station driver"
 	depends on MT6797_HIF_CORE && MAC80211
 	default n
 	help
-	  Register the 2.4 GHz channel inventory with mac80211 and submit
-	  retained configuration under cfg80211 regulatory ownership.
-	  By itself radio and packet operations remain unavailable. This experimental
-	  option does not yet provide a usable station interface.
+	  Register the MT6797 WLAN function with mac80211 as a managed-mode
+	  station: regulatory configuration, passive scan, one WPA2-PSK station
+	  lifetime per boot with firmware-owned encryption and connection
+	  monitoring, checked CCMP receive with host PN validation, and a bounded
+	  programmed-I/O data path. Reconnect, rekey and power save are not yet
+	  supported.
 
+# The following symbols are build-structure facts of the station driver, not
+# user choices. They follow MT6797_MAC80211 and keep the source's existing
+# compile-time structure while the experiment arms are retired one by one.
 config MT6797_HIF_TX_STATUS_PROBE
-	bool "MT6797 bounded WLAN returned-page observation"
-	depends on MT6797_MAC80211
-	default n
-	help
-	  Read interrupt/control and returned-page counters once before normal
-	  commands and twice after configuration, with no intervening commands.
-	  These reads may consume hardware status. No credit refund, IRQ enable,
-	  radio request or packet DMA is performed. Experimental diagnostic only.
+	def_bool MT6797_MAC80211
 
 config MT6797_HIF_TC4_RECONCILE
-	bool "MT6797 bounded normal TC4 credit reconciliation"
-	depends on MT6797_HIF_TX_STATUS_PROBE
-	default n
-	help
-	  Require a zero returned-page baseline and reconcile the complete
-	  post-configuration counter pair against the sole normal TC4 ledger.
-	  Retain separate CPU and free-pool pending counts, refunding only their
-	  minimum within the outstanding debit. No extra completion estimate,
-	  IRQ enable, radio request or packet DMA is performed.
+	def_bool MT6797_MAC80211
 
 config MT6797_PASSIVE_SCAN
-	bool "MT6797 one-shot passive mac80211 scan"
-	depends on MT6797_HIF_TC4_RECONCILE
-	default n
-	help
-	  Admit one standard station-type interface for one passive 2.4 GHz
-	  hardware scan, bounded to permitted channels with no probe requests.
-	  Poll RX and fresh TC4 accounting under the retained exclusive PIO
-	  owner while IRQs stay disabled. Validate native beacon descriptors and
-	  report them through cfg80211. Cancellation, timeout and failure abort
-	  the host request and retire its wire lifetime; they are not firmware
-	  stop acknowledgements. No association, key, data TX or DMA is provided.
-
-config MT6797_SCAN_TUNING_SAMPLE
-	bool "MT6797 bounded read-only scan tuning samples"
-	depends on MT6797_PASSIVE_SCAN
-	default n
-	help
-	  During the sole passive scan, issue at most four read-only firmware
-	  RAM queries for two fixed channel-state words. Match exact replies
-	  within 100 ms using fresh shared command sequences. Samples are
-	  non-atomic software state, not proof of RF tuning or listening time.
-	  No arbitrary register access or register write interface is exposed.
+	def_bool MT6797_MAC80211
 
 config MT6797_STATION_JOIN
-	bool "MT6797 experimental bounded legacy station join"
-	depends on MT6797_PASSIVE_SCAN
-	default n
-	help
-	  Retain one AIS BSS after a successful passive channel-40 scan for a
-	  ten-second host setup budget. A healthy unused handoff may request
-	  deactivation once; poisoned resources remain retired until recovery.
-	  Copy BSS and operating-channel state without retaining stack pointers.
-	  This incomplete implementation leaves management TX closed and has
-	  no keys, data path, DMA or interrupts. Existing passive-scan profiles
-	  do not enable this option.
+	def_bool MT6797_MAC80211
 
 config MT6797_NATIVE_DELIVERY_DIAG
-	bool "MT6797 default-off native-crypto-delivery diagnostic (proposal 0181)"
-	depends on MT6797_STATION_JOIN
-	default n
-	help
-	  A default-off, separately profiled diagnostic that, after one healthy
-	  associated data phase, submits the pinned 16-byte SET_MONITOR command
-	  once, admits a bounded window of ordinary RX as untouched protected
-	  native MPDUs to standard mac80211 with every crypto bypass/strip flag
-	  clear (so mac80211 runs the full CCMP AEAD/MIC and replay check), and
-	  submits one disable on a healthy end. It is armed only by the
-	  native_delivery_diag module parameter and is absent from the build
-	  unless this option is set; the Phase B compile profile does not set it.
-	  Not driver support; a bounded source-grounded crypto-delivery test.
-
-config MT6797_CCMP_50S_IDLE
-	bool "MT6797 default-off 50-second idle-tail comparison"
-	depends on MT6797_CCMP_CHANNEL_RELEASE
-	default n
-	help
-	  Shorten only the data and diagnostic walls to 50 seconds. Keep the
-	  nine-second join privilege, all resource caps and operation bounds.
-	  Use the separately reviewed four-probe leaf. No crypto, RX format,
-	  key/PID reuse or reconnect changes; not sustained support.
+	def_bool MT6797_MAC80211
 
-config MT6797_CCMP_TX_PID_REUSE
-	bool "MT6797 default-off completed TX PID reuse"
-	depends on MT6797_CCMP_CONNECTED_LIFETIME
-	default n
-	help
-	  Recycle ordinary frame IDs only after the exact owned completion and
-	  returned credits. Keep one frame in flight; reserve ID 127 for the
-	  lifetime's deauthentication. Never recycle on timeout or ambiguity.
-	  This does not enable key reuse, rekey or a second station lifetime.
-
-config MT6797_CCMP_CONNECTED_LIFETIME
-	bool "MT6797 default-off connected station lifetime"
-	depends on MT6797_CCMP_CHANNEL_RELEASE && !MT6797_CCMP_50S_IDLE
-	default n
-	help
-	  Keep the initial connected BSS alive until standard teardown or an
-	  existing resource/fault stop. Preserve the pre-data join fence and
-	  per-operation bounds; arm the five-second cleanup fence at data end.
-	  The 60-second sample wall and cumulative join poll quota do not end
-	  connected data. RX/byte/PID/queue caps remain, with no reuse or rekey.
-	  This is not sustained support or a reusable key/station lifecycle.
+config MT6797_CCMP_STABLE_EPOCH
+	def_bool MT6797_MAC80211
 
-config MT6797_CCMP_CHANNEL_RELEASE
-	bool "MT6797 default-off connected data after join privilege release"
-	depends on MT6797_CCMP_INITIAL_GTK
-	default n
-	help
-	  Request nine seconds for joining, then return that privilege during
-	  the existing 60-second initial-key window. Hold new TX across the
-	  existing command credit deadline; retain all resource caps and the
-	  finite teardown. No rekey, reuse, reconnect or sustained support claim.
+config MT6797_CCMP_60S_WINDOW
+	def_bool MT6797_MAC80211
 
 config MT6797_CCMP_INITIAL_GTK
-	bool "MT6797 default-off checked initial GTK compatibility"
-	depends on MT6797_CCMP_60S_WINDOW
-	default n
-	help
-	  Extend the single initial-key experiment with an independently seeded
-	  strict GTK PN context, group/BMC attribution and checked Ethernet RX.
-	  Keep all receive/transport limits and the standard mac80211 handoff.
-	  No rekey, reuse, reconnect or maintained crypto support claim.
-
-config MT6797_CCMP_60S_WINDOW
-	bool "MT6797 default-off 60-second initial-key observation"
-	depends on MT6797_CCMP_MASK_CONTROL
-	default n
-	help
-	  Request exactly 65 seconds of channel ownership and admit a 60-second
-	  data phase only with enough actual grant remaining for its cleanup
-	  tail. Preserve every resource cap and command/frame/cleanup timeout.
-	  Independent of RX format ownership; no sustained support claim.
+	def_bool MT6797_MAC80211
 
-config MT6797_CCMP_STABLE_EPOCH
-	bool "MT6797 default-off monitor-assisted stable PTK compatibility"
-	depends on MT6797_NATIVE_DELIVERY_DIAG
-	default n
-	help
-	  Reuse the admitted finite monitor protocol for one initial station/key
-	  epoch. Checked hardware-CCMP Ethernet RX with driver PN validation uses
-	  standard mac80211 decap. GTK RX, rekey, slot reuse and normal-mode PN
-	  production are not supported. The read-only ccmp_stable_epoch arm is
-	  mutually exclusive with native_delivery_diag. No IRQ/DMA changes.
+config MT6797_CCMP_CHANNEL_RELEASE
+	def_bool MT6797_MAC80211
 
-config MT6797_CCMP_MASK_CONTROL
-	bool "MT6797 default-off observed mask-only control comparison"
-	depends on MT6797_CCMP_STABLE_EPOCH
-	default n
-	help
-	  Compare one observed three-bit firmware control primitive with the
-	  global monitor operation, retaining all initial-PTK diagnostic limits.
-	  Only one fixed address and values 7/0 are admitted. This does not
-	  establish group meanings, firmware integrity or healthy key reuse.
+config MT6797_CCMP_CONNECTED_LIFETIME
+	def_bool MT6797_MAC80211
 
-config MT6797_CCMP_LIFETIME_PREREQUISITES
-	bool "MT6797 dormant protected-lifetime prerequisites"
-	depends on MT6797_CCMP_STABLE_EPOCH
-	default n
-	help
-	  Compile unconsumed host drain-fence and PN-epoch helpers for offline
-	  fixtures. No command, polling, re-arm or admission caller is added.
-	  Firmware retirement evidence remains required before any consumer.
-	  This option does not enable a second protected lifetime.
+config MT6797_CCMP_TX_PID_REUSE
+	def_bool MT6797_MAC80211
 
 config MT6797_CCMP_TX_PUMP
-	bool "MT6797 bounded immediate single-frame TX pump measurement"
-	depends on MT6797_CCMP_CONNECTED_LIFETIME && MT6797_CCMP_TX_PID_REUSE
-	default n
-	help
-	  Poll back-to-back while queued frames, completions or credit remain.
-	  After at most 32 iterations without TX progress, request a 1 ms
-	  yield. Idle polls retain 20 ms. This changes scheduling only, not
-	  in-flight depth, credit accounting, PID ownership, deadlines or join
-	  admission. Enable only in the dedicated throughput measurement profile.
+	def_bool MT6797_MAC80211
 
 config MT6797_CCMP_TX_DEPTH
-	int "MT6797 maximum outstanding ordinary data frames"
+	int
 	depends on MT6797_CCMP_TX_PUMP
 	range 1 4
-	default 1
+	default 4
 	help
-	  Bound ordinary data TX owners by PID, with the existing TC1 ledger.
-	  Management, security and reserved frames retain their single owner.
-	  Use four only in the dedicated throughput measurement profile.
+	  Maximum outstanding ordinary data frames, bounded by PID ownership and
+	  the TC1 page ledger. Management, security and reserved frames keep a
+	  single owner.
