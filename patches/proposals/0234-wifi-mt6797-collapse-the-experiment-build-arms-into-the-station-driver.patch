@@ -307,70 +307,6 @@ mt6797_normal_prepare(struct mt6797_normal_transaction *t,
 	return -EINVAL;
 }
 
-/* Read-only scan diagnostic: exactly two ordinary firmware RAM words.
- * Role 0 is the completed tuning band cache; role 1 contains requested channel
- * metadata. No hardware, special command prefix or arbitrary address is admitted.
- */
-static inline unsigned int mt6797_scan_tuning_address(unsigned int role)
-{
-	return role == 0 ? 0xf006c040U : role == 1 ? 0xf006bf7cU : 0;
-}
-
-static inline int
-mt6797_normal_prepare_scan_tuning(struct mt6797_normal_transaction *t,
-				  unsigned int role, unsigned int sequence,
-				  unsigned char *output, size_t capacity,
-				  struct mt6797_hif_command *command)
-{
-	unsigned int address = mt6797_scan_tuning_address(role);
-	unsigned char payload[8] = {0};
-	int error;
-
-	if (!t || !command || !output)
-		return -EINVAL;
-	*command = (struct mt6797_hif_command){0};
-	if (!address)
-		return -EINVAL;
-	if (t->phase != MT6797_NORMAL_NVRAM_SUBMITTED)
-		return mt6797_normal_abort(t);
-	payload[0] = (unsigned char)address;
-	payload[1] = (unsigned char)(address >> 8);
-	payload[2] = (unsigned char)(address >> 16);
-	payload[3] = (unsigned char)(address >> 24);
-	error = mt6797_normal_encode(t, 0xc0, 0, sequence, payload, 8, 16,
-				     MT6797_NORMAL_CONFIG_TX, output, capacity, command);
-	if (!error)
-		t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
-	return error;
-}
-
-/* Caller owns the single outstanding query and retires it on any error.
- * Matching a reply does not refund TC4 credit or authorize another lifetime.
- */
-static inline int
-mt6797_scan_tuning_reply(const unsigned char *packet, size_t bytes,
-			 unsigned int role, unsigned int sequence,
-			 unsigned int *value)
-{
-	unsigned int address = mt6797_scan_tuning_address(role);
-	unsigned int reflected;
-
-	if (!packet || !value || !address || sequence > 255)
-		return -EINVAL;
-	*value = 0;
-	if (bytes != 16 || mt6797_normal_le16(packet) != 16 ||
-	    mt6797_normal_le16(packet + 2) != 0xe000 || packet[4] != 5 ||
-	    packet[5] != sequence)
-		return -EPROTO;
-	reflected = (unsigned int)packet[8] | ((unsigned int)packet[9] << 8) |
-		((unsigned int)packet[10] << 16) | ((unsigned int)packet[11] << 24);
-	if (reflected != address)
-		return -EPROTO;
-	*value = (unsigned int)packet[12] | ((unsigned int)packet[13] << 8) |
-		((unsigned int)packet[14] << 16) | ((unsigned int)packet[15] << 24);
-	return 0;
-}
