diff --git a/drivers/net/wireless/mediatek/mt6797/join-commands.h b/drivers/net/wireless/mediatek/mt6797/join-commands.h
index f935147b6..44f1fbadc 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-commands.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-commands.h
@@ -310,28 +310,6 @@ mt6797_native_monitor_payload(bool enable, unsigned char channel,
 	return true;
 }
 
-#ifdef CONFIG_MT6797_CCMP_MASK_CONTROL
-/* Observed stock callback's complete Boolean-mask store, not a general MCR API.
- * Group meanings and pending-format ownership remain diagnostic questions.
- */
-#define MT6797_DIAG_MASK_BYTES 8U
-#define MT6797_DIAG_MASK_TARGET 0x800c0068U
-static inline bool
-mt6797_diag_mask_payload(bool enable, unsigned char output[MT6797_DIAG_MASK_BYTES])
-{
-	unsigned int i;
-
-	if (!output)
-		return false;
-	for (i = 0; i < 4; i++)
-		output[i] = MT6797_DIAG_MASK_TARGET >> (8 * i);
-	output[4] = enable ? 7 : 0;
-	output[5] = 0;
