 /*
  * True only when the post-record normal owner is idle with every TC4 page
@@ -1068,44 +1054,6 @@ int mt6797_hif_send_config(struct mt6797_hif *hif,
 	return error;
 }
 
-#if IS_ENABLED(CONFIG_MT6797_SCAN_TUNING_SAMPLE)
