-	error = mt6797_hif_enter(hif, deadline_ns);
-	if (error)
-		goto out;
-	error = mt6797_normal_prepare_scan_tuning(&hif->normal, role, sequence,
-						  hif->scratch, sizeof(hif->scratch), &command);
-	if (error)
-		goto out;
-	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
-					hif->scratch, 16, sizeof(hif->scratch), &transfer);
-	error = mt6797_normal_submitted(&hif->normal, error);
-	if (!error)
-		error = mt6797_hif_guard(hif);
-out:
-	if (error)
-		error = mt6797_hif_fail(hif, error);
-unlock:
-	mutex_unlock(&hif->mutex);
-	return error;
-}
-#endif
 
 /* Read one port-0 packet only when its earlier 89-byte length is unchanged.
