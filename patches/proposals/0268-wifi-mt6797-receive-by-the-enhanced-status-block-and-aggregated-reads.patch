From 73f5ab7d5fc43006004d97b190594a054e143065 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 24 Oct 2026 19:47:15 -0400
Subject: [PATCH] wifi: mt6797: receive by the enhanced status block and
 aggregated reads

After the DMA boots, what remains per received frame is register work:
the length register, the transfer setup, the guard and the status reads.
Do what the vendor's receive path does, by polling: once per worker pass
one 112-byte read of the enhanced status block (the receive queues'
frame counts and up to sixteen lengths each), then one aggregated
data-port transfer per non-empty queue, split by the reported lengths
with the same header check as before and served from that cache. The
worker loop is unchanged; the mode is switched on in WHCR (sixteen
lengths, the enhance bit) at the first receive and read back.

In enhanced mode the block read also consumes WHISR and the sixteen TX
queue release counts (the vendor's rTxInfo, released into its TC
accounting from the block, nic_tx.c). The first boot of this proposal
lost the authentication frame's page credit that way and the join
stopped at its credit wait. The counts the block carries are therefore
merged into the next TX status acquisition, half-word by half-word, and
the credit path is otherwise unchanged.

What the block says is advisory and never poisons receive: a count above
sixteen is served as sixteen and drains next pass, a length outside the
frame bounds leaves that queue unread this pass, a header that disagrees
with its reported length drops that aggregate (frames lost, the
transport retransmits). Each is counted in failures. Poison is reserved
for a bus failure. The data-end record reports the mode, WHCR before and
after, block reads, aggregates, frames, empty passes, failures and the
blocks that carried TX credit. Behind CONFIG_MT6797_HIF_RX_BATCH.

The join guard records its refusal with the words it saw (identity and
ownership registers, the status acquisition, the merge state), so a
credit fault on device names its source instead of a bare status.
---
 drivers/net/wireless/mediatek/mt6797/Kconfig |  10 +
 drivers/net/wireless/mediatek/mt6797/hif.c   | 299 ++++++++++++++++++-
 drivers/net/wireless/mediatek/mt6797/hif.h   |  12 +
 drivers/net/wireless/mediatek/mt6797/mac.c   |  32 +-
 4 files changed, 350 insertions(+), 3 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 9e7141935..8470144b8 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -85,6 +85,16 @@ config MT6797_HIF_DMA_RX
 	  transfer completes by polling the channel's own flag under the
 	  context deadline; a timeout poisons the context like a PIO fault.
 
+config MT6797_HIF_RX_BATCH
+	bool "MT6797 Wi-Fi HIF: receive by the enhanced status block and aggregated reads"
+	depends on MT6797_HIF_DMA_RX
+	help
+	  Once per worker pass read the enhanced status block (receive queue
+	  counts and frame lengths), then read each queue's frames in one
+	  aggregated data-port transfer and serve them from that cache: no
+	  per-frame length register read or guard. The vendor's receive
+	  path by polling; a measurement variable for the receive ceiling.
+
 config MT6797_CCMP_TX_DEPTH
 	int
 	depends on MT6797_CCMP_TX_PUMP
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 674c9ad3a..dea3d7601 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -12,6 +12,7 @@
 #include <linux/io.h>
 #include <linux/ktime.h>
 #include <linux/mutex.h>
+#include <linux/unaligned.h>
 #include <linux/slab.h>
 #include <linux/string.h>
 #endif
@@ -27,6 +28,12 @@
 #define MT6797_RX_SW_FRAME 0xe001U
 #define MT6797_RX_DATA_TYPE 2U
 
+/* Receive batching (0268): one queue's aggregate of sixteen maximum frames, and
+ * the enhanced status block.
+ */
+#define MT6797_HIF_RX_BATCH_QUEUE_BYTES	(16U * ALIGN(MT6797_HIF_RX_MAX_PACKET + 4U, 4))
+#define MT6797_HIF_RX_BATCH_BLOCK_BYTES	112U
+
 struct mt6797_hif {
 	void __iomem *base;
 	/* Serializes this context, transaction and scratch; never external owners. */
@@ -59,6 +66,31 @@ struct mt6797_hif {
 	bool dma_addr2;
 	unsigned int dma_tx, dma_rx, dma_poll_max, dma_failures;
 	u8 scratch[2560];
+	/* Receive batching (0268): the enhanced status block read once per
+	 * worker pass, the aggregated data-port read per queue it names, and
+	 * the frames served from that cache without per-frame register work.
+	 */
+	bool rx_batch_forced, rx_batch_enabled, rx_batch_on, rx_batch_refill;
+	u32 rx_batch_whcr_before, rx_batch_whcr_after;
+	unsigned int rx_batch_reads, rx_batch_aggregates, rx_batch_frames,
+		     rx_batch_empty, rx_batch_max_frames, rx_batch_failures;
+	unsigned int rx_batch_count, rx_batch_next;
+	/* The TX release counts the block carried (the vendor's rTxInfo). In
+	 * enhanced mode the block read consumes WHISR and the queue counts, so
+	 * they are merged into the next TX status acquisition instead of being
+	 * lost; the credit path is otherwise unchanged.
+	 */
+	u32 rx_batch_pending_whisr, rx_batch_pending_wtqcr[8];
+	unsigned int rx_batch_credit_blocks;
+	/* Two queues of up to sixteen frames each, as the block reports them. */
+	struct {
+		u8 port;
+		u16 length;
+		u32 offset;
+	} rx_batch_frame[32];
+
+	u8 rx_batch_block[MT6797_HIF_RX_BATCH_BLOCK_BYTES];
+	u8 *rx_batch_agg;
 };
 
 /* AP-DMA HIF channel 0 registers (window offsets) and fields, as the vendor
@@ -81,7 +113,10 @@ struct mt6797_hif {
 #define MT6797_APDMA_CON_BURST_4_4	(3U << 16)
 #define MT6797_APDMA_CON_INCR		BIT(31)
 #define MT6797_APDMA_LEN_MASK		GENMASK(19, 0)
-#define MT6797_APDMA_BUFFER_BYTES	4096U
+/* One receive queue's aggregate (sixteen frames of the maximum length, each
+ * with its four staged bytes, rounded to the 512-byte block) must fit.
+ */
+#define MT6797_APDMA_BUFFER_BYTES	40960U
 #define MT6797_APDMA_POLL_LIMIT		200000U
 
 /* Register access to the channel window; host fixtures supply the test pair. */
@@ -191,6 +226,11 @@ struct mt6797_hif *mt6797_hif_alloc(void __iomem *base, size_t span,
 	hif = kzalloc_obj(*hif, GFP_KERNEL);
 	if (!hif)
 		return ERR_PTR(-ENOMEM);
+	hif->rx_batch_agg = kzalloc(2U * MT6797_HIF_RX_BATCH_QUEUE_BYTES, GFP_KERNEL);
+	if (!hif->rx_batch_agg) {
+		kfree(hif);
+		return ERR_PTR(-ENOMEM);
+	}
 	hif->base = base;
 	hif->transaction = transaction;
 	hif->io = (struct mt6797_hif_pio_io){
@@ -209,6 +249,8 @@ void mt6797_hif_free(struct mt6797_hif *hif)
 				  hif->dma_phys);
 		clk_disable_unprepare(hif->dma_clk);
 	}
+	if (hif)
+		kfree(hif->rx_batch_agg);
 	kfree(hif);
 }
 
@@ -411,6 +453,205 @@ static int mt6797_hif_read32_locked(struct mt6797_hif *hif, unsigned int reg,
 	return mt6797_hif_read(hif, 0x1000, value);
 }
 
+static int mt6797_hif_write32_locked(struct mt6797_hif *hif, unsigned int reg,
+				     u32 value)
+{
+	int error;
+
+	error = mt6797_hif_write(hif, 0, (1U << 31) | (1U << 28) | (reg << 9) | 4U);
+	if (error)
+		return error;
+	return mt6797_hif_write(hif, 0x1000, value);
+}
+
+/* The enhanced status block (the vendor's ENHANCE_MODE_DATA_STRUCT_T): WHISR,
+ * sixteen TX queue counts, the two receive queues' packet counts and up to
+ * sixteen lengths each, two mailboxes; 112 bytes as one byte-mode read of
+ * the WHISR register.
+ */
+static int mt6797_hif_rx_batch_block(struct mt6797_hif *hif)
+{
+	unsigned int offset, word;
+	int error;
+
+	error = mt6797_hif_write(hif, 0, (1U << 28) | (0x10U << 9) |
+				 MT6797_HIF_RX_BATCH_BLOCK_BYTES);
+	if (error)
+		return error;
+	for (offset = 0; offset < MT6797_HIF_RX_BATCH_BLOCK_BYTES; offset += 4) {
+		error = mt6797_hif_read(hif, 0x1000, &word);
+		if (error)
+			return error;
+		put_unaligned_le32(word, hif->rx_batch_block + offset);
+	}
+	hif->rx_batch_reads++;
+	return 0;
+}
+
+/* Vendor sequence: MAX_HIF_RX_LEN_NUM (bits 13:8) to sixteen and
+ * RX_ENHANCE_MODE_EN (bit 16) in WHCR, then read back.
+ */
+static int mt6797_hif_rx_batch_enable(struct mt6797_hif *hif)
+{
+	u32 whcr;
+	int error;
+
+	error = mt6797_hif_read32_locked(hif, 0x0c, &whcr);
+	if (error)
+		return error;
+	hif->rx_batch_whcr_before = whcr;
+	whcr &= ~(0x3fU << 8);
+	whcr |= (16U << 8) | BIT(16);
+	error = mt6797_hif_write32_locked(hif, 0x0c, whcr);
+	if (error)
+		return error;
+	error = mt6797_hif_read32_locked(hif, 0x0c, &whcr);
+	if (error)
+		return error;
+	hif->rx_batch_whcr_after = whcr;
+	hif->rx_batch_enabled = true;
+	hif->rx_batch_on = (whcr & BIT(16)) && ((whcr >> 8) & 0x3fU) == 16U;
+	return hif->rx_batch_on ? 0 : -EIO;
+}
+
+/* Two sixteen-bit counts in one word (the WTQCR layout), added half by half. */
+static u32 mt6797_hif_add16x2(u32 a, u32 b)
+{
+	u32 lo = (a & 0xffffU) + (b & 0xffffU), hi = (a >> 16) + (b >> 16);
+
+	return min_t(u32, lo, 0xffffU) | (min_t(u32, hi, 0xffffU) << 16);
+}
+
+static unsigned int mt6797_hif_rx_batch_length(const struct mt6797_hif *hif,
+					       unsigned int queue, unsigned int i)
+{
+	return get_unaligned_le16(hif->rx_batch_block + 40 + 32 * queue + 2 * i);
+}
+
+/* One pass's receive work: the block, then per non-empty queue one
+ * aggregated read of every reported frame (each frame occupies its length
+ * plus the four staged bytes, rounded to four), split by the reported
+ * lengths with the same header check the per-frame path applies.
+ *
+ * Only a bus failure (the setup word or a data-port read) is returned, and
+ * the caller poisons the context for it. What the block says is advisory:
+ * a count above sixteen is served as sixteen and the rest drains next
+ * pass; a length the block reports outside the frame bounds leaves that
+ * queue unread this pass; a header that disagrees with its reported length
+ * after the aggregate has been transferred drops that aggregate (its frames
+ * are lost and the transport retransmits them). Each is counted in
+ * failures and none poisons receive for the rest of the boot.
+ */
+static int mt6797_hif_rx_batch_fill(struct mt6797_hif *hif)
+{
+	struct mt6797_hif_pio_result transfer;
+	unsigned int queue, i, n, count = 0, first;
+	bool credited = false;
+	size_t total, offset;
+	int error;
+
+	error = mt6797_hif_rx_batch_block(hif);
+	if (error)
+		return error;
+	hif->rx_batch_pending_whisr |= get_unaligned_le32(hif->rx_batch_block);
+	for (i = 0; i < 8; i++) {
+		u32 word = get_unaligned_le32(hif->rx_batch_block + 4 + 4 * i);
+
+		if (!word)
+			continue;
+		hif->rx_batch_pending_wtqcr[i] =
+			mt6797_hif_add16x2(hif->rx_batch_pending_wtqcr[i], word);
+		credited = true;
+	}
+	if (credited)
+		hif->rx_batch_credit_blocks++;
+	hif->rx_batch_count = 0;
+	hif->rx_batch_next = 0;
+	for (queue = 0; queue < 2; queue++) {
+		u8 *agg = hif->rx_batch_agg + queue * MT6797_HIF_RX_BATCH_QUEUE_BYTES;
+
+		n = get_unaligned_le16(hif->rx_batch_block + 36 + 2 * queue);
+		if (!n)
+			continue;
+		if (n > 16) {
+			hif->rx_batch_failures++;
+			n = 16;
+		}
+		total = 0;
+		for (i = 0; i < n; i++) {
+			unsigned int length = mt6797_hif_rx_batch_length(hif, queue, i);
+
+			if (length < 4 || length > MT6797_HIF_RX_MAX_PACKET)
+				break;
+			total += ALIGN(length + 4U, 4);
+		}
+		if (i < n) {
+			hif->rx_batch_failures++;
+			continue;
+		}
+		error = mt6797_hif_data_transfer(hif, queue ? 0x54 : 0x50,
+						 MT6797_HIF_READ, agg, total,
+						 MT6797_HIF_RX_BATCH_QUEUE_BYTES,
+						 &transfer);
+		if (error)
+			return error;
+		hif->rx_batch_aggregates++;
+		first = count;
+		offset = 0;
+		for (i = 0; i < n; i++) {
+			unsigned int length = mt6797_hif_rx_batch_length(hif, queue, i);
+
+			if (mt6797_normal_le16(agg + offset) != length) {
+				hif->rx_batch_failures++;
+				count = first;
+				break;
+			}
+			hif->rx_batch_frame[count].port = queue;
+			hif->rx_batch_frame[count].length = length;
+			hif->rx_batch_frame[count].offset =
+				queue * MT6797_HIF_RX_BATCH_QUEUE_BYTES + offset;
+			count++;
+			offset += ALIGN(length + 4U, 4);
+		}
+	}
+	hif->rx_batch_count = count;
+	hif->rx_batch_frames += count;
+	if (count > hif->rx_batch_max_frames)
+		hif->rx_batch_max_frames = count;
+	if (!count)
+		hif->rx_batch_empty++;
+	return 0;
+}
+
+/* Called once per worker pass: the next receive may read the block again. */
+void mt6797_hif_rx_batch_pass(struct mt6797_hif *hif)
+{
+	if (hif)
+		hif->rx_batch_refill = true;
+}
+
+void mt6797_hif_rx_batch_stats(const struct mt6797_hif *hif,
+			       struct mt6797_hif_rx_batch_stats *stats)
+{
+	*stats = (struct mt6797_hif_rx_batch_stats){0};
+	if (!hif)
+		return;
+	stats->on = hif->rx_batch_on;
+	stats->whcr_before = hif->rx_batch_whcr_before;
+	stats->whcr_after = hif->rx_batch_whcr_after;
+	stats->reads = hif->rx_batch_reads;
+	stats->aggregates = hif->rx_batch_aggregates;
+	stats->frames = hif->rx_batch_frames;
+	stats->empty = hif->rx_batch_empty;
+	stats->max_frames = hif->rx_batch_max_frames;
+	stats->failures = hif->rx_batch_failures;
+	stats->credit_blocks = hif->rx_batch_credit_blocks;
+	stats->pending_whisr = hif->rx_batch_pending_whisr;
+	stats->pending_wtqcr0 = hif->rx_batch_pending_wtqcr[0];
+	stats->pending_wtqcr7 = hif->rx_batch_pending_wtqcr[7];
+	stats->error = hif->first_error;
+}
+
 int mt6797_hif_read32(struct mt6797_hif *hif, unsigned int reg, u64 deadline_ns,
 		      u32 *value)
 {
@@ -632,6 +873,13 @@ static int mt6797_hif_tx_status(struct mt6797_hif *hif, u64 deadline_ns,
 		if (error)
 			goto poison;
 		status[n].valid_words |= 2U;
+		if (!n) {
+			/* What the enhanced block read consumed since the last
+			 * acquisition (0268); the abnormal bits are checked merged.
+			 */
+			status[n].whisr |= hif->rx_batch_pending_whisr;
+			hif->rx_batch_pending_whisr = 0;
+		}
 		/* Pinned WHISR: abnormal status bit 6, firmware assert bit 31.
 		 * Do not proceed to another read or command after either signal.
 		 */
@@ -645,6 +893,13 @@ static int mt6797_hif_tx_status(struct mt6797_hif *hif, u64 deadline_ns,
 			if (error)
 				goto poison;
 			status[n].valid_words |= 1U << (i + 2);
+			if (!n) {
+				u32 pending = hif->rx_batch_pending_wtqcr[i];
+
+				status[n].wtqcr[i] =
+					mt6797_hif_add16x2(status[n].wtqcr[i], pending);
+				hif->rx_batch_pending_wtqcr[i] = 0;
+			}
 		}
 		if (account && (count == 2 || runtime)) {
 			error = mt6797_normal_reconcile(&reconciled,
@@ -1419,6 +1674,48 @@ static int mt6797_hif_receive(struct mt6797_hif *hif, unsigned int port,
 	error = mt6797_hif_enter(hif, deadline_ns);
 	if (error)
 		goto poison;
+	if (IS_ENABLED(CONFIG_MT6797_HIF_RX_BATCH) || hif->rx_batch_forced) {
+		if (!hif->rx_batch_enabled) {
+			error = mt6797_hif_rx_batch_enable(hif);
+			if (error)
+				goto poison;
+		}
+		if (hif->rx_batch_next >= hif->rx_batch_count && hif->rx_batch_refill) {
+			hif->rx_batch_refill = false;
+			/* A bus failure, the only error the fill returns. */
+			error = mt6797_hif_rx_batch_fill(hif);
+			if (error) {
+				hif->rx_batch_failures++;
+				goto poison;
+			}
+		}
+		if (hif->rx_batch_next >= hif->rx_batch_count) {
+			error = -EAGAIN;
+			goto unlock;
+		}
+		/* Frames are served in the order the block reported them, each
+		 * tagged with its own queue; the caller's port is advisory.
+		 */
+		{
+			unsigned int f = hif->rx_batch_next;
+
+			if (capacity < hif->rx_batch_frame[f].length) {
+				error = -ENOSPC;
+				goto unlock;
+			}
+			hif->rx_batch_next++;
+			memcpy(buffer, hif->rx_batch_agg + hif->rx_batch_frame[f].offset,
+			       hif->rx_batch_frame[f].length);
+			result->logical_bytes = hif->rx_batch_frame[f].length;
+			result->packet_type = mt6797_normal_le16(buffer + 2);
+			result->selected_port = hif->rx_batch_frame[f].port;
+			result->selected_port_valid = true;
+			result->rx_setup = true;
+			result->rx_complete = true;
+			result->staging_bytes = ALIGN(result->logical_bytes + 4U, 4);
+			goto unlock;
+		}
+	}
 	error = mt6797_hif_read32_locked(hif, 0x90, &lengths);
 	if (error)
 		goto poison;
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index 6b7171242..d7800db25 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -134,6 +134,18 @@ int mt6797_hif_attach_dma(struct mt6797_hif *hif, void __iomem *window,
 			  bool addr2);
 #define MT6797_HIF_DMA_MIN_BYTES 64U
 /* DMA transfer counters for the records: zero when no channel is attached. */
+struct mt6797_hif_rx_batch_stats {
+	bool on;
+	u32 whcr_before, whcr_after;
+	unsigned int reads, aggregates, frames, empty, max_frames, failures;
+	unsigned int credit_blocks;
+	u32 pending_whisr, pending_wtqcr0, pending_wtqcr7;
+	int error;
+};
+
+void mt6797_hif_rx_batch_pass(struct mt6797_hif *hif);
+void mt6797_hif_rx_batch_stats(const struct mt6797_hif *hif,
+			       struct mt6797_hif_rx_batch_stats *stats);
 void mt6797_hif_dma_stats(const struct mt6797_hif *hif, unsigned int *tx,
 			  unsigned int *rx, unsigned int *poll_max,
 			  unsigned int *failures);
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index f71611c73..af241a714 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -1807,9 +1807,9 @@ static void mt6797_mac_join_close(struct mt6797_mac *mac)
 
 static int mt6797_mac_join_guard(struct mt6797_mac *mac, u64 deadline)
 {
-	struct mt6797_hif_tx_status status;
+	struct mt6797_hif_tx_status status = {0};
 	struct mt6797_normal_release account;
-	u32 wcir, own;
+	u32 wcir = 0, own = 0;
 	int ret;
 
 	ret = mt6797_hif_read32(mac->hif, 0, deadline, &wcir);
@@ -1821,6 +1821,22 @@ static int mt6797_mac_join_guard(struct mt6797_mac *mac, u64 deadline)
 		ret = -EACCES;
 	if (!ret)
 		ret = mt6797_hif_reconcile_runtime(mac->hif, deadline, &status, &account);
+	if (ret) {
+		/* The guard's refusal, with the words it saw: the identity and
+		 * ownership registers, the status acquisition (valid=0 means it
+		 * was refused before any read), and the receive-batching merge
+		 * state (0268) so a credit fault names its source.
+		 */
+		struct mt6797_hif_rx_batch_stats batch;
+
+		mt6797_hif_rx_batch_stats(mac->hif, &batch);
+		dev_err(wiphy_dev(mac->hw->wiphy),
+			"one-shot WLAN join guard failed: ret=%d wcir=0x%08x own=0x%08x valid=0x%x whcr=0x%08x whisr=0x%08x wtqcr0=0x%08x wtqcr7=0x%08x hif=%d pending_whisr=0x%08x pending0=0x%08x pending7=0x%08x batch_failures=%u credits=%u\n",
+			ret, wcir, own, status.valid_words, status.whcr, status.whisr,
+			status.wtqcr[0], status.wtqcr[7], batch.error, batch.pending_whisr,
+			batch.pending_wtqcr0, batch.pending_wtqcr7, batch.failures,
+			batch.credit_blocks);
+	}
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
 	if (!ret)
 		mt6797_ccmp_observe_guard(&mac->ccmp_observation, &status, &account);
@@ -2818,6 +2834,16 @@ static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 			 "one-shot WLAN HIF DMA transfers: tx=%u rx=%u poll_max=%u failures=%u\n",
 			 dma_tx, dma_rx, dma_poll_max, dma_failures);
 	}
+	{
+		struct mt6797_hif_rx_batch_stats batch;
+
