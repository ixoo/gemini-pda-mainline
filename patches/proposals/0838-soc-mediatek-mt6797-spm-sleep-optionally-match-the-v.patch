From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 21 Nov 2026 20:03:54 -0500
Subject: [PATCH] soc: mediatek: mt6797-spm-sleep: optionally match the vendor
 SODI entry on MP2 and the SMI async DCM

Two differences from the vendor SODI entry, each behind a parameter.

sodi_no_mp2 leaves MP2_AXI_CONFIG alone. In this flag mode the vendor
driver sets ACINACTM only on MP0 and MP1, while the module also writes
the powered-off A72 cluster.

sodi_smi_async ORs SMI_COMMON_ASYNC_DCM (0xc000) into the M4U register
MMU_SMI_ASYNC_CFG before each SODI period and writes the saved word back
after it, as the vendor driver does. It acts only while the display
domain has both power acks and mm_smi_common is ungated, and reports
the saved word in sodi_smi_async_val.
---
 drivers/soc/mediatek/mt6797-spm-sleep.c | 71 +++++++++++++++++++++++--
 1 file changed, 66 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-spm-sleep.c b/drivers/soc/mediatek/mt6797-spm-sleep.c
index 9ee7f0504..5154ea672 100644
--- a/drivers/soc/mediatek/mt6797-spm-sleep.c
+++ b/drivers/soc/mediatek/mt6797-spm-sleep.c
@@ -69,6 +69,7 @@ static const u8 sodi_fw_sha256[SHA256_DIGEST_SIZE] = {
 #define INFRA_AO_PHYS		0x10001000
 #define TOPCKGEN_PHYS		0x10000000
 #define MMSYS_PHYS		0x14000000
+#define M4U_PHYS		0x10205000
 #define CHIPID_PHYS		0x08000000
 #define GICD_PHYS		0x19000000
 /* CPU0's redistributor: the RD frame, then the SGI frame (SGIs and PPIs) */
@@ -304,6 +305,15 @@ module_param(sodi_mark, bool, 0444);
 MODULE_PARM_DESC(sodi_mark, "SODI: SW_DEBUG and SW_RSV_0 start each kick at 0x5a5a0000 plus the kick count");
 static u32 sodi_kicks;
 
+/*
+ * The vendor's driver sets ACINACTM only on MP0 and MP1 in this flag mode
+ * and leaves the A72 cluster's MP2_AXI_CONFIG alone. sodi_no_mp2 does the
+ * same: no write to MP2, and none to restore it.
+ */
+static bool sodi_no_mp2;
+module_param(sodi_no_mp2, bool, 0644);
+MODULE_PARM_DESC(sodi_no_mp2, "SODI: leave MP2_AXI_CONFIG alone, as the vendor's driver does");
+
 static bool sodi_obs_noread;
 module_param(sodi_obs_noread, bool, 0444);
 MODULE_PARM_DESC(sodi_obs_noread, "SODI: the observer only counts its ticks in a period, reading the SPM only once one is stuck");
@@ -452,6 +462,7 @@ static struct {
 	void __iomem *cirq;
 	void __iomem *afe;
 	void __iomem *mmsys;
+	void __iomem *m4u;
 	struct device *afe_dev;
 	u32 cirq_edge[CIRQ_WORDS];
 	u32 cirq_sta[CIRQ_WORDS];
@@ -585,6 +596,38 @@ static const struct kernel_param_ops sodi_mm_cg_ops = {
 module_param_cb(sodi_mm_cg, &sodi_mm_cg_ops, NULL, 0200);
 MODULE_PARM_DESC(sodi_mm_cg, "SODI: 1 logs the MMSYS gates in the vendor's SODI check, 2 also closes them");
 
+/*
+ * Before each SODI entry the vendor's driver ORs SMI_COMMON_ASYNC_DCM
+ * (0xc000) into the M4U's MMU_SMI_ASYNC_CFG and writes the saved word back
+ * after the wake. sodi_smi_async does the same, only while the display
+ * domain has both power acks and mm_smi_common is ungated (MMSYS CG_CON0
+ * bit 0 clear); otherwise it leaves the register alone and reports
+ * ffffffff in sodi_smi_async_val, which holds the last saved word.
+ */
+#define M4U_SMI_ASYNC_CFG	0xb80
+#define SMI_COMMON_ASYNC_DCM	0x0000c000
+#define MMSYS_CG_SMI_COMMON	BIT(0)
+static bool sodi_smi_async;
+module_param(sodi_smi_async, bool, 0644);
+MODULE_PARM_DESC(sodi_smi_async, "SODI: set SMI_COMMON_ASYNC_DCM in the M4U for each period, as the vendor's driver does");
+static uint sodi_smi_async_val;
+module_param(sodi_smi_async_val, uint, 0444);
+MODULE_PARM_DESC(sodi_smi_async_val, "SODI: MMU_SMI_ASYNC_CFG as last saved, ffffffff if the guard refused");
+
+static bool sodi_smi_async_set(u32 *saved)
+{
+	if (!s.m4u || !s.mmsys ||
+	    !(spm_rd(SPM_PWR_STATUS) & spm_rd(SPM_PWR_STATUS_2ND) & PWR_DIS) ||
+	    (readl(s.mmsys + MMSYS_CG_CON0) & MMSYS_CG_SMI_COMMON)) {
+		WRITE_ONCE(sodi_smi_async_val, 0xffffffff);
+		return false;
+	}
+	*saved = readl(s.m4u + M4U_SMI_ASYNC_CFG);
+	writel(*saved | SMI_COMMON_ASYNC_DCM, s.m4u + M4U_SMI_ASYNC_CFG);
+	WRITE_ONCE(sodi_smi_async_val, *saved);
+	return true;
+}
+
 static irqreturn_t spm_irq_handler(int irq, void *data)
 {
 	u32 sta = spm_rd(SPM_IRQ_STA);
@@ -966,6 +1009,9 @@ static int spm_run(const struct spm_scen *sc)
 	u32 con0, con1, settle, axi[3], v, wdt_val = 0;
 	u64 cntp_cval = 0, cntp_ctl = 0;
 	bool obs_cpu = obs.on && cpu_online(SODI_OBS_CPU);
+	bool mp2 = !obs_cpu && !READ_ONCE(sodi_no_mp2);
+	bool smi = false;
+	u32 smi_saved = 0;
 	int i;
 
 	s.entered = false;
@@ -993,14 +1039,17 @@ static int spm_run(const struct spm_scen *sc)
 	writel(axi[0] | ACINACTM, s.mcucfg + MP0_AXI_CONFIG);
 	writel(axi[1] | ACINACTM, s.mcucfg + MP1_AXI_CONFIG);
 	/* With the observer running on CPU8, its cluster keeps taking snoops */
-	if (!obs_cpu)
+	if (mp2)
 		writel(axi[2] | ACINACTM | BIT(0), s.mcucfg + MP2_AXI_CONFIG);
 	if (!(readl(s.mcucfg + MP0_AXI_CONFIG) & ACINACTM)) {
 		writel(axi[0], s.mcucfg + MP0_AXI_CONFIG);
 		writel(axi[1], s.mcucfg + MP1_AXI_CONFIG);
-		writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
+		if (mp2)
+			writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
 		return -EIO;
 	}
+	if (sc->cirq && READ_ONCE(sodi_smi_async))
+		smi = sodi_smi_async_set(&smi_saved);
 
 	for (i = 0; i < ARRAY_SIZE(spm_saved_regs); i++)
 		s.saved[i] = spm_rd(spm_saved_regs[i]);
@@ -1032,7 +1081,10 @@ static int spm_run(const struct spm_scen *sc)
 		s.wake.returned = false;
 		writel(axi[0], s.mcucfg + MP0_AXI_CONFIG);
 		writel(axi[1], s.mcucfg + MP1_AXI_CONFIG);
-		writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
+		if (mp2)
+			writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
+		if (smi)
+			writel(smi_saved, s.m4u + M4U_SMI_ASYNC_CFG);
 		return -EIO;
 	}
 	s.wake.vec_en_reset = spm_rd(PCM_EVENT_VECTOR_EN);
@@ -1129,7 +1181,10 @@ static int spm_run(const struct spm_scen *sc)
 		}
 		writel(axi[0], s.mcucfg + MP0_AXI_CONFIG);
 		writel(axi[1], s.mcucfg + MP1_AXI_CONFIG);
-		writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
+		if (mp2)
+			writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
+		if (smi)
+			writel(smi_saved, s.m4u + M4U_SMI_ASYNC_CFG);
 		return -ETIMEDOUT;
 	}
 
@@ -1267,7 +1322,10 @@ static int spm_run(const struct spm_scen *sc)
 	/* C3 */
 	writel(axi[0], s.mcucfg + MP0_AXI_CONFIG);
 	writel(axi[1], s.mcucfg + MP1_AXI_CONFIG);
-	writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
+	if (mp2)
+		writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
+	if (smi)
+		writel(smi_saved, s.m4u + M4U_SMI_ASYNC_CFG);
 	return s.wake.returned ? 0 : -ETIMEDOUT;
 }
 
@@ -2054,6 +2112,8 @@ static void spm_unmap(void)
 		iounmap(s.afe);
 	if (s.mmsys)
 		iounmap(s.mmsys);
+	if (s.m4u)
+		iounmap(s.m4u);
 	if (s.afe_dev)
 		put_device(s.afe_dev);
 	if (s.topck)
@@ -2152,6 +2212,7 @@ static int __init spm_sleep_init(void)
 	s.cirq = ioremap(CIRQ_PHYS, 0x400);
 	s.afe = ioremap(AFE_PHYS, 0x1000);
 	s.mmsys = ioremap(MMSYS_PHYS, 0x1000);
+	s.m4u = ioremap(M4U_PHYS, 0x1000);
 	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6797-audio");
 	afe_pdev = np ? of_find_device_by_node(np) : NULL;
 	of_node_put(np);
-- 
2.43.0

