From faa630f0acf70730d82d11b3042ea511d82f0af1 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sat, 10 Oct 2026 12:40:21 +0000
Subject: [PATCH 161/161] wifi: mt6797: discard the target's directed clear
 Action frame while active

Runtime 18 delivered both EAPOL frames and sent both replies; the
supplicant completed its handshake and offered both keys; then the frame
gate refused the next received packet and the join fail-stopped before
either key command reached the firmware. The extended refusal summary
named the packet: a 136-byte software-defined frame with groups 1 to 3
and the header at offset 64, descriptor bytes 02 28 18 04 01 00 00 e0
(match flags with the unicast-to-me bit only, channel 40, native 24-byte
header without padding, payload format 0 with BSSID field 1, WLAN index
1, TID 0 and security mode 0, status 0xe000), frame control 0x00d0: an
unprotected Action frame (type 0, subtype 13) from the target to this
station, 72 wire bytes. Its category, body and sequence were not
recorded; runtime 16's refused 136-byte software frame had the same type
word and length. The two key refusals that followed are the same stop
seen from the key path: the pairwise install was waiting on the TC4
ledger when the worker stopped and returned its -EPROTO, and the group
install then met the stopped lifetime (-EOPNOTSUPP); no firmware key
command, credit or removal exists.

Add a decoder (action-frame.h) for exactly that measured class: the
software-frame type word with groups 1 to 3; the match byte exactly
0x02; descriptor bytes 6 to 11 exactly as measured; frame control 0x00d0
with only the Retry bit free; receiver this station, transmitter and
BSSID the target; fragment number 0; at least the category byte after
the header, which is not read. While the station is active, a packet of
that class is discarded: never delivered, no body byte read, no address
copied, each one recorded by its descriptor and header fields, at most
eight per join; the ninth, a protected or Action No Ack frame, another
subtype, a group or other receiver, another peer, other descriptor
values or another status reach the refusal as before. The hardware
acknowledges management frames on its own; no RF submission results, and
no credit, lifecycle or key handling changes.
---
 .../wireless/mediatek/mt6797/action-frame.h   | 79 +++++++++++++++++++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 27 +++++++
 2 files changed, 106 insertions(+)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/action-frame.h

diff --git a/drivers/net/wireless/mediatek/mt6797/action-frame.h b/drivers/net/wireless/mediatek/mt6797/action-frame.h
new file mode 100644
index 000000000..2c3513f58
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/action-frame.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_ACTION_FRAME_H
+#define MT6797_ACTION_FRAME_H
+
+#include "join-events.h"
+
+struct mt6797_join_action_frame {
+	size_t bytes;             /* Wire bytes after the descriptor and groups. */
+	unsigned int fc;          /* Frame control, native header. */
+	unsigned int match;       /* Descriptor match flags (RXD byte 4). */
+	unsigned int status;      /* Descriptor status word (RXD bytes 10..11). */
+	unsigned char wlan, bss;  /* Descriptor WLAN index and BSSID field. */
+	unsigned char sec;        /* Descriptor security mode field. */
+};
+
+/* The class of received packet that ended runtimes 16 and 18 at the frame
+ * gate after message 4, named in runtime 18: a 136-byte software-defined
+ * frame (the vendor's SW_FRAME type word, groups 1 to 3, header at offset
+ * 64) whose logged descriptor bytes were 02 28 18 04 01 00 00 e0 (match flags
+ * with the unicast-to-me bit only, channel 40, native 24-byte header without
+ * padding, payload format 0 with BSSID field 1, WLAN index 1, TID 0 and
+ * security mode 0, status 0xe000) and whose frame control was 0x00d0: an
+ * unprotected Action frame (type 0, subtype 13) with the target as
+ * transmitter and this station as receiver, 72 wire bytes. Its category,
+ * body and sequence were not recorded and none is claimed or read here.
+ *
+ * This decoder names exactly that class so the caller can discard it
+ * without delivery: the software-frame type word with groups 1 to 3; the
+ * match byte exactly 0x02; the descriptor bytes 6 to 11 exactly as measured
+ * (24-byte header, no translation, no padding; format 0 with BSSID field 1;
+ * WLAN index 1, the station's own index; byte 9 zero; status 0xe000, the
+ * same status every admitted management response of this lifetime carries);
+ * frame control 0x00d0 with only the Retry bit free (a retransmission of the
+ * same frame); receiver this station, transmitter and BSSID the target;
+ * fragment number 0; and at least the category byte after the header, which
+ * is not read. Protected frames, Action No Ack and every other subtype,
+ * group-addressed frames, other peers, other descriptor values and other
+ * status words are not this class and reach the caller's refusal. No RF
+ * submission results: the hardware acknowledged the frame on its own.
+ */
+static inline bool
+mt6797_join_action_frame(const unsigned char *packet, size_t bytes,
+			 unsigned char channel, const unsigned char own[6],
+			 const unsigned char ap[6],
+			 struct mt6797_join_action_frame *out)
+{
+	struct mt6797_join_action_frame r;
+	const size_t offset = 16 + 16 + 8 + 24;
+	unsigned int type;
+	const unsigned char *f;
+
+	if (!packet || !own || !ap || !out || bytes < offset + 25 ||
+	    bytes > 4096 || !channel || mt6797_join_le16(packet) != bytes ||
+	    packet[5] != channel)
+		return false;
+	type = mt6797_join_le16(packet + 2);
+	if ((type & 0xe00f) != 0xe001 || ((type >> 9) & 15) != 7)
+		return false;
+	r.match = packet[4];
+	if (r.match != 0x02 || packet[6] != 24 || packet[7] != 0x04 ||
+	    packet[8] != 1 || packet[9] ||
+	    mt6797_join_le16(packet + 10) != 0xe000)
+		return false;
+	f = packet + offset;
+	r.fc = mt6797_join_le16(f);
+	if ((r.fc & 0xf7ff) != 0x00d0)
+		return false;
+	if (memcmp(f + 4, own, 6) || memcmp(f + 10, ap, 6) || memcmp(f + 16, ap, 6) ||
+	    (mt6797_join_le16(f + 22) & 15))
+		return false;
+	r.bytes = bytes - offset;
+	r.status = mt6797_join_le16(packet + 10);
+	r.wlan = packet[8];
+	r.bss = packet[7] >> 2;
+	r.sec = packet[9] >> 4;
+	*out = r;
+	return true;
+}
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 6da68b887..436371878 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -19,6 +19,7 @@
 #include "eapol-rx.h"
 #include "join-refused.h"
 #include "group-data.h"
+#include "action-frame.h"
 #include "join-tx.h"
 #include "join-commands.h"
 
@@ -79,6 +80,7 @@ struct mt6797_mac {
 	unsigned int join_absence_events;
 	/* Phase C1: bounded observation of the AP's first clear EAPOL frames. */
 	unsigned int join_eapol_seen, join_eapol_tx, join_group_discarded;
+	unsigned int join_action_discarded;
 	u64 join_hold_until;
 	/* RSN join: WPA2 declared to the firmware; key commands 0 none, 1
 	 * submitted with credit returned, 2 removed. No key material is kept.
@@ -942,6 +944,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	struct mt6797_hif_rx_result rx;
 	struct mt6797_eapol_rx eapol;
 	struct mt6797_join_group_data group;
+	struct mt6797_join_action_frame action;
 	struct mt6797_join_tx_result result;
 	struct mt6797_join_rx_frame frame;
 	struct mt6797_scan_frame beacon;
@@ -1253,6 +1256,29 @@ static void mt6797_mac_join_work(struct work_struct *work)
 						 group.status, mac->join_group_discarded);
 				continue;
 			}
+#endif
+#if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+			/* The target's unprotected directed Action frame (runtimes 16
+			 * and 18, after message 4; category unknown and unread) is
+			 * irrelevant to the bounded join and is discarded while the
+			 * station is active: never delivered or interpreted, each one
+			 * recorded by its descriptor and header fields, at most eight
+			 * per join, and the ninth or any other shape refused as before.
+			 */
+			if (mac->join_sta_active && !mac->join_deauth_done &&
+			    !mac->join_cleanup_done &&
+			    mt6797_join_action_frame(mac->join_packet, rx.logical_bytes, 40,
+						     mac->hw->wiphy->perm_addr,
+						     mac->join_ap, &action) &&
+			    mac->join_action_discarded < 8) {
+				mac->join_action_discarded++;
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN join action frame discarded: bytes=%zu fc=0x%x match=0x%02x wlan=%u bss=%u sec=%u status=0x%04x count=%u\n",
+					 action.bytes, action.fc, action.match, action.wlan,
+					 action.bss, action.sec, action.status,
+					 mac->join_action_discarded);
+				continue;
+			}
 #endif
 			if (!mt6797_join_rx_frame(mac->join_packet, rx.logical_bytes, 40,
 			    mac->hw->wiphy->perm_addr, mac->join_ap,
@@ -1896,6 +1922,7 @@ static int mt6797_mac_join_add_peer(struct mt6797_mac *mac,
 	mac->join_peer_used = true;
 	mac->join_eapol_seen = 0;
 	mac->join_group_discarded = 0;
+	mac->join_action_discarded = 0;
 	mac->join_hold_until = 0;
 	mac->join_credit_deadline = min_t(u64, mac->join_deadline,
 					  ktime_get_ns() + 100 * NSEC_PER_MSEC);
-- 
