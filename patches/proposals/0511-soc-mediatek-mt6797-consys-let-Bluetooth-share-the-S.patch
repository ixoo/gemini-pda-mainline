From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 2 Nov 2026 22:00:03 -0500
Subject: [PATCH] soc: mediatek: mt6797-consys: let Bluetooth share the STP
 link

The Bluetooth controller is function 0 of CONSYS, on STP task 0 of the link the
GNSS driver already uses. That link refused a second client, and only the GPS
function could be switched.

Let the first client start the link and the last one stop it. Only the first
attach repeats the option query, which proves both directions before anyone relies
on the link.

Export a Bluetooth function control. VCN33-BT goes on before WMT function-on and
off after function-off, as the vendor does, and also goes off if the link has
stopped so the rail is not left on.

Register a child platform device for the Bluetooth driver.
---
 drivers/soc/mediatek/mt6797-consys.c    | 82 ++++++++++++++++++++-----
 include/linux/soc/mediatek/mt6797-stp.h |  2 +
 2 files changed, 69 insertions(+), 15 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index 8abd2836d..0c7e8fad5 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -139,7 +139,8 @@ struct mt6797_consys {
 	struct mt6797_wmt_query wmt_query;
 	struct mt6797_wmt_negotiate wmt_negotiate;
 	struct mt6797_stp stp;
-	struct platform_device *gnss;
+	struct platform_device *gnss, *bt;
+	bool bt_rail;
 	struct {
 		struct mt6797_wmt_full_io io;
 		unsigned char command[WMT_FULL_MAX_PAYLOAD];
@@ -1752,9 +1753,11 @@ static const unsigned char mt6797_stp_check_event[] = {
 	0x02, 0x04, 0x06, 0x00, 0x00, 0x04,
 };
 
-/* WMT function control: the flag byte selects GPS, the last byte on or off. */
+/* WMT function control: the flag byte selects the function, the last byte on or off. */
 static const unsigned char mt6797_stp_gps_on[] = { 0x01, 0x06, 0x02, 0x00, 0x02, 0x01 };
 static const unsigned char mt6797_stp_gps_off[] = { 0x01, 0x06, 0x02, 0x00, 0x02, 0x00 };
+static const unsigned char mt6797_stp_bt_on[] = { 0x01, 0x06, 0x02, 0x00, 0x00, 0x01 };
+static const unsigned char mt6797_stp_bt_off[] = { 0x01, 0x06, 0x02, 0x00, 0x00, 0x00 };
 static const unsigned char mt6797_stp_func_event[] = { 0x02, 0x06, 0x01, 0x00, 0x00 };
 
 /* Lock held. TX-empty interrupt only while bytes wait for the FIFO. */
@@ -2032,8 +2035,9 @@ static void mt6797_stp_halt(struct device *dev, struct mt6797_stp *s)
 
 /*
  * The STP link runs only while a client is attached, so the start chain and a
- * running Wi-Fi see no difference until then. A client's module holds this one,
- * so the owner cannot unload under it.
+ * running Wi-Fi see no difference until then. The first client starts it and the
+ * last one stops it. A client's module holds this one, so the owner cannot unload
+ * under it.
  */
 int mt6797_consys_stp_attach(unsigned int task,
 			     int (*receive)(void *context, const u8 *payload,
@@ -2043,9 +2047,10 @@ int mt6797_consys_stp_attach(unsigned int task,
 	struct mt6797_consys *owner = &mt6797_consys;
 	struct mt6797_stp *s = &owner->stp;
 	unsigned long flags;
+	bool first;
 	int ret;
 
-	if (task != MT6797_STP_TASK_GPS || !receive)
+	if ((task != MT6797_STP_TASK_GPS && task != MT6797_STP_TASK_BT) || !receive)
 		return -EINVAL;
 	mutex_lock(&mt6797_consys_lock);
 	if (!owner->bound || !owner->dev) {
@@ -2057,23 +2062,23 @@ int mt6797_consys_stp_attach(unsigned int task,
 		ret = -EAGAIN;
 		goto out;
 	}
-	if (s->running) {
-		ret = -EBUSY;
-		goto out;
+	first = !s->running;
+	if (first) {
+		ret = mt6797_stp_run(owner->dev, owner);
+		if (ret)
+			goto out;
 	}
-	ret = mt6797_stp_run(owner->dev, owner);
-	if (ret)
-		goto out;
 	spin_lock_irqsave(&s->lock, flags);
 	ret = stp_engine_bind(&s->engine, task, receive, context);
 	spin_unlock_irqrestore(&s->lock, flags);
-	if (!ret)
+	if (!ret && first)
 		ret = mt6797_stp_check(owner->dev, s);
 	if (ret) {
 		spin_lock_irqsave(&s->lock, flags);
 		stp_engine_unbind(&s->engine, task);
 		spin_unlock_irqrestore(&s->lock, flags);
-		mt6797_stp_halt(owner->dev, s);
+		if (first)
+			mt6797_stp_halt(owner->dev, s);
 	}
 out:
 	mutex_unlock(&mt6797_consys_lock);
@@ -2086,13 +2091,16 @@ void mt6797_consys_stp_detach(unsigned int task)
 	struct mt6797_consys *owner = &mt6797_consys;
 	struct mt6797_stp *s = &owner->stp;
 	unsigned long flags;
+	bool last;
 
 	mutex_lock(&mt6797_consys_lock);
 	if (s->running) {
 		spin_lock_irqsave(&s->lock, flags);
 		stp_engine_unbind(&s->engine, task);
+		last = s->engine.client_count == 1;	/* WMT stays bound */
 		spin_unlock_irqrestore(&s->lock, flags);
-		mt6797_stp_halt(owner->dev, s);
+		if (last)
+			mt6797_stp_halt(owner->dev, s);
 	}
 	mutex_unlock(&mt6797_consys_lock);
 }
@@ -2121,6 +2129,41 @@ int mt6797_consys_gps_function(bool on)
 }
 EXPORT_SYMBOL_GPL(mt6797_consys_gps_function);
 
+/*
+ * Process context, attached client. VCN33-BT goes on before the function and off
+ * after it, as the vendor does. The rail goes off even if the link has stopped.
+ */
+int mt6797_consys_bt_function(bool on)
+{
+	struct mt6797_consys *owner = &mt6797_consys;
+	struct mt6797_stp *s = &owner->stp;
+	int ret = -ENODEV;
+
+	mutex_lock(&mt6797_consys_lock);
+	if (!s->running)
+		goto out;
+	if (on) {
+		ret = mt6797_consys_init_rail(owner->vcn33_bt, true, &owner->bt_rail);
+		if (ret)
+			goto rail;
+	}
+	ret = mt6797_stp_wmt(s, on ? mt6797_stp_bt_on : mt6797_stp_bt_off,
+			     sizeof(mt6797_stp_bt_on), mt6797_stp_func_event,
+			     sizeof(mt6797_stp_func_event));
+	if (!ret && s->wmt_event_length != sizeof(mt6797_stp_func_event))
+		ret = -EPROTO;
+	dev_info(owner->dev, "WMT BT function %s: result=%d reply=%u bytes %*ph\n",
+		 on ? "on" : "off", ret, s->wmt_event_length,
+		 min_t(int, s->wmt_event_length, sizeof(s->wmt_event)), s->wmt_event);
+rail:
+	if ((!on || ret) && owner->bt_rail)
+		mt6797_consys_init_rail(owner->vcn33_bt, false, &owner->bt_rail);
+out:
+	mutex_unlock(&mt6797_consys_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_bt_function);
+
 static bool mt6797_stp_has_room(struct mt6797_stp *s)
 {
 	unsigned long flags;
@@ -2140,7 +2183,7 @@ int mt6797_consys_stp_send(unsigned int task, const u8 *data, unsigned int lengt
 	long left = msecs_to_jiffies(MT6797_STP_SEND_WAIT_MS);
 	int ret;
 
-	if (task != MT6797_STP_TASK_GPS)
+	if (task != MT6797_STP_TASK_GPS && task != MT6797_STP_TASK_BT)
 		return -EINVAL;
 	for (;;) {
 		spin_lock_irqsave(&s->lock, flags);
@@ -2668,6 +2711,13 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 				PTR_ERR(mt6797_consys.gnss));
 			mt6797_consys.gnss = NULL;
 		}
+		mt6797_consys.bt = platform_device_register_data(&pdev->dev, "btmt6797",
+								 PLATFORM_DEVID_NONE, NULL, 0);
+		if (IS_ERR(mt6797_consys.bt)) {
+			dev_err(&pdev->dev, "Bluetooth device unavailable (%ld)\n",
+				PTR_ERR(mt6797_consys.bt));
+			mt6797_consys.bt = NULL;
+		}
 #if IS_MODULE(CONFIG_MT6797_MAC80211)
 		ret = device_create_file(&pdev->dev, &dev_attr_wlan_stop);
 		if (ret)
@@ -2704,6 +2754,8 @@ static void mt6797_consys_remove(struct platform_device *pdev)
 		cancel_work_sync(&owner->start_work);
 	if (owner->gnss)
 		platform_device_unregister(owner->gnss);
+	if (owner->bt)
+		platform_device_unregister(owner->bt);
 #if IS_MODULE(CONFIG_MT6797_MAC80211)
 	device_remove_file(dev, &dev_attr_wlan_stop);
 #endif
diff --git a/include/linux/soc/mediatek/mt6797-stp.h b/include/linux/soc/mediatek/mt6797-stp.h
index 34bd204c2..f3cac23d5 100644
--- a/include/linux/soc/mediatek/mt6797-stp.h
+++ b/include/linux/soc/mediatek/mt6797-stp.h
@@ -4,6 +4,7 @@
 
 #include <linux/types.h>
 
+#define MT6797_STP_TASK_BT	0U
 #define MT6797_STP_TASK_GPS	2U
 
 /*
@@ -20,5 +21,6 @@ void mt6797_consys_stp_detach(unsigned int task);
 /* Process context, between attach and detach. */
 int mt6797_consys_stp_send(unsigned int task, const u8 *data, unsigned int length);
 int mt6797_consys_gps_function(bool on);
+int mt6797_consys_bt_function(bool on);
 
 #endif
-- 
2.43.0

