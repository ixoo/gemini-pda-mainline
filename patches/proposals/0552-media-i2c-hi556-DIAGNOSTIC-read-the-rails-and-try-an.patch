From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 15:03:31 -0500
Subject: [PATCH] media: i2c: hi556: DIAGNOSTIC, read the rails and try another
 chip on the bus

Bring-up only, to be dropped with the previous patch. T2 found no ACK from
the sensor with everything reading as asked, and could not show the bus works:
the AW9120 was in shutdown. Bring it out for a moment and read its ID. Print
the PMIC control and voltage registers of the three rails.
---
 drivers/media/i2c/hi556.c | 48 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/drivers/media/i2c/hi556.c b/drivers/media/i2c/hi556.c
index 5aa22ea26..bdaa2e738 100644
--- a/drivers/media/i2c/hi556.c
+++ b/drivers/media/i2c/hi556.c
@@ -4,6 +4,8 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/regmap.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
@@ -1362,6 +1364,50 @@ static void hi556_diag_read(struct hi556 *hi556, u16 addr)
 		 val[0], val[1]);
 }
 
+/* The rail's control and voltage registers, from the PMIC itself. */
+static void hi556_diag_rails(struct hi556 *hi556)
+{
+	static const u16 regs[] = { 0x0a12, 0x0a40, 0x0a58, 0x0ad6, 0x0b00, 0x0b14 };
+	struct regmap *map = regulator_get_regmap(hi556->supplies[0].consumer);
+	unsigned int i, val;
+	int ret;
+
+	if (IS_ERR_OR_NULL(map))
+		return;
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = regmap_read(map, regs[i], &val);
+		dev_info(hi556->dev, "diag: pmic %04x ret %d val %04x\n", regs[i],
+			 ret, val);
+	}
+}
+
+/*
+ * Whether this bus can get an ACK from anything: the AW9120 on the same bus,
+ * out of shutdown for a moment through its enable, GPIO245. It reads as ID.
+ */
+static void hi556_diag_aw9120(struct hi556 *hi556)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&hi556->sd);
+	int gpio = desc_to_gpio(hi556->reset_gpio) - 33 + 245;
+	u8 reg = 0, val[2] = { 0, 0 };
+	struct i2c_msg msgs[2] = {
+		{ .addr = 0x2c, .len = 1, .buf = &reg },
+		{ .addr = 0x2c, .flags = I2C_M_RD, .len = sizeof(val), .buf = val },
+	};
+	int ret;
+
+	ret = gpio_request_one(gpio, GPIOF_OUT_INIT_HIGH, "hi556-diag");
+	if (ret) {
+		dev_info(hi556->dev, "diag: gpio %d request %d\n", gpio, ret);
+		return;
+	}
+	usleep_range(5000, 6000);
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	gpio_set_value(gpio, 0);
+	gpio_free(gpio);
+	dev_info(hi556->dev, "diag: aw9120 ret %d id %02x%02x\n", ret, val[0], val[1]);
+}
+
 /* Bring-up only: keep the rails and clock on so the state can be read. */
 static void hi556_diag_hold(struct hi556 *hi556)
 {
@@ -1369,6 +1415,8 @@ static void hi556_diag_hold(struct hi556 *hi556)
 
 	dev_info(hi556->dev, "diag: holding %u s, mclk %lu Hz\n", diag_hold_s,
 		 clk_get_rate(hi556->clk));
+	hi556_diag_rails(hi556);
+	hi556_diag_aw9120(hi556);
 	for (i = 0; i < diag_hold_s; i++) {
 		hi556_diag_read(hi556, 0x20);
 		hi556_diag_read(hi556, 0x28);
-- 
