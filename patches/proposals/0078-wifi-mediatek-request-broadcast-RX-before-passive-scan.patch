From 835cca4c17226a6002642fbe93929355ee11f9cd Mon Sep 17 00:00:00 2001
From: Codex <codex-experiment@invalid.example>
Date: Fri, 2 Oct 2026 06:15:10 -0400
Subject: [PATCH] wifi: mediatek: request broadcast RX before passive scan

The non-DFS scan completes without receiving management packets. The
selected gen3 RX-mode path sends CID 0x0a with a four-byte filter word
including broadcast. Admit only that exact broadcast request after the
immutable board record, once before the existing scan activation.

Keep one scan lifetime, fixed channels, PIO ownership and bounded RX.
No response is requested or treated as an application acknowledgement.
This experiment tests a setup omission; it does not establish RF or
association support.

Synthetic experiment archive; no DCO certification or upstream submission.
---
 drivers/net/wireless/mediatek/mt6797/mac.c         |  9 +++++++++
 .../net/wireless/mediatek/mt6797/normal_command.h  | 14 ++++++++++++--
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index fede7cf..c6967b2 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -358,6 +358,7 @@ static int mt6797_mac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif
 	struct ieee80211_channel *channel;
 	unsigned int channels[MT6797_PASSIVE_SCAN_CHANNELS], mask = 0, i;
 	u8 payload[MT6797_PASSIVE_SCAN_BYTES], bss[12];
+	u8 broadcast[4] = {8, 0, 0, 0};
 	int ret = -EOPNOTSUPP, slot;
 
 	mutex_lock(&mac->mutex);
@@ -405,6 +406,14 @@ static int mt6797_mac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif
 		mac->first_error = ret;
 		goto out;
 	}
+	/* The normal gen3 RX-mode path requests broadcast reception. Send
+	 * only that supported filter word; no native/monitor selector is used.
+	 * Submission and returned command credit do not prove application.
+	 */
+	ret = mt6797_mac_send(mac, MT6797_NORMAL_SCAN_BROADCAST,
+			      broadcast, sizeof(broadcast));
+	if (ret)
+		goto out;
 	mt6797_scan_bss(hw->wiphy->perm_addr, true, bss);
 	ret = mt6797_mac_send(mac, MT6797_NORMAL_BSS_ACTIVE, bss, sizeof(bss));
 	if (ret)
diff --git a/drivers/net/wireless/mediatek/mt6797/normal_command.h b/drivers/net/wireless/mediatek/mt6797/normal_command.h
index 2081986..7c4ce40 100644
--- a/drivers/net/wireless/mediatek/mt6797/normal_command.h
+++ b/drivers/net/wireless/mediatek/mt6797/normal_command.h
@@ -11,6 +11,7 @@ enum mt6797_normal_kind { MT6797_NORMAL_CAPABILITY, MT6797_NORMAL_NVRAM };
 /* Selected configuration sets and the bounded passive-scan command owner. */
 enum mt6797_normal_config_kind {
 	MT6797_NORMAL_SCAN_V2 = 0x03,
+	MT6797_NORMAL_SCAN_BROADCAST = 0x0a,
 	MT6797_NORMAL_BSS_ACTIVE = 0x11,
 	MT6797_NORMAL_SCAN_CANCEL = 0x1b,
 	MT6797_NORMAL_DOMAIN = 0x0f,
@@ -256,15 +257,24 @@ mt6797_normal_prepare_config(struct mt6797_normal_transaction *t,
 	if (previous == MT6797_NORMAL_NVRAM_SUBMITTED &&
 	    kind != MT6797_NORMAL_DOMAIN && kind != MT6797_NORMAL_TX_CTRL &&
 	    kind != MT6797_NORMAL_SCAN_V2 && kind != MT6797_NORMAL_BSS_ACTIVE &&
-	    kind != MT6797_NORMAL_SCAN_CANCEL)
+	    kind != MT6797_NORMAL_SCAN_CANCEL &&
+	    kind != MT6797_NORMAL_SCAN_BROADCAST)
 		return mt6797_normal_abort(t);
 	if (!payload)
 		return -EINVAL;
 	if ((kind == MT6797_NORMAL_SCAN_V2 || kind == MT6797_NORMAL_BSS_ACTIVE ||
-	     kind == MT6797_NORMAL_SCAN_CANCEL) &&
+	     kind == MT6797_NORMAL_SCAN_CANCEL ||
+	     kind == MT6797_NORMAL_SCAN_BROADCAST) &&
 	    previous != MT6797_NORMAL_NVRAM_SUBMITTED)
 		return mt6797_normal_abort(t);
 	switch (kind) {
+	case MT6797_NORMAL_SCAN_BROADCAST:
+		/* Only the source-defined broadcast request for this scan owner. */
+		if (payload_bytes != 4 || payload[0] != 8 || payload[1] ||
+		    payload[2] || payload[3])
+			return -EINVAL;
+		required = 4;
+		break;
 	case MT6797_NORMAL_SCAN_V2:
 		required = 226;
 		break;
