From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 1 Nov 2026 06:13:51 -0500
Subject: [PATCH] soc: mediatek: mt6797-consys: start the subsystem after probe

Run the start chain from a work item queued at probe instead of waiting
for two root writes to region19_prepare and wmt_negotiate: prepare the
WMT window, then CONN power through the WLAN firmware start. Both
attributes go; wlan_stop stays.

The mac module may now load before the firmware is ready. Its attach is
held and runs as soon as the firmware is up, so the three modules load
in any order at boot. Unloading CONSYS cancels a start that has not run.

Part of the Wi-Fi daily-use plan, phase 2.
---
 .../soc/mediatek/mediatek,mt6797-consys.yaml  |   2 +-
 drivers/net/wireless/mediatek/mt6797/mac.h    |   9 +-
 drivers/soc/mediatek/mt6797-consys.c          | 108 ++++++++++--------
 3 files changed, 69 insertions(+), 50 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
index 46147249e..5a4e4f353 100644
--- a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
@@ -15,7 +15,7 @@ description: |
   after acquiring the common resources, then populates the passive WLAN child.
   The child has no direct power-domain attachment.
 
-  The manager starts the connectivity subsystem on request: CONN power, the
+  The manager starts the connectivity subsystem after probe: CONN power, the
   CONMCU reset release, WMT negotiation over BTIF, the common initialization
   (ROM patches, coexistence and RF calibration), then the WLAN firmware.
 
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.h b/drivers/net/wireless/mediatek/mt6797/mac.h
index a88a927bb..93359f8cc 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.h
+++ b/drivers/net/wireless/mediatek/mt6797/mac.h
@@ -24,10 +24,11 @@ extern const struct mt6797_mac_ops mt6797_mac_attach_ops;
 
 /* Attach the mac80211 layer to the firmware the CONSYS owner started:
  * record, registration, the initial TC4 accounting pair, then scan ready.
- * A re-attach after a detach keeps the firmware's configuration and the
- * TC4 baseline: the layer neither replays the record nor repeats the pair,
- * and continues the boot's command sequence. -ENODEV before the firmware is
- * ready, -EBUSY while attached or after a failed attach.
+ * Before the firmware is ready the layer is held and attached as soon as
+ * it is. A re-attach after a detach keeps the firmware's configuration and
+ * the TC4 baseline: the layer neither replays the record nor repeats the
+ * pair, and continues the boot's command sequence. -EBUSY while attached,
+ * held, or after a failed attach.
  */
 int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops);
 
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index a456e45c4..d6bafbcf1 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -34,6 +34,7 @@
 #include <linux/slab.h>
 #include <linux/string.h>
 #include <linux/sysfs.h>
+#include <linux/workqueue.h>
 #include <linux/soc/mediatek/mtk-pm-domains.h>
 #include <dt-bindings/power/mt6797-power.h>
 
@@ -106,7 +107,12 @@ struct mt6797_consys {
 	bool wlan_ready;
 	bool wlan_attached;
 	bool wlan_configured;
+	/* A mac layer that loaded before the firmware was ready. */
+	const struct mt6797_mac_ops *wlan_pending;
 #endif
+	/* Starts the subsystem once, after probe. */
+	struct device *dev;
+	struct work_struct start_work;
 	struct mt6797_wmt_query wmt_query;
 	struct mt6797_wmt_negotiate wmt_negotiate;
 	struct {
@@ -512,22 +518,6 @@ static int mt6797_consys_prepare_wmt(struct device *dev,
 	return ret;
 }
 
-static ssize_t region19_prepare_store(struct device *dev,
-				      struct device_attribute *attr,
-				      const char *buf, size_t count)
-{
-	int ret;
-
-	if (count != 2 || memcmp(buf, "1\n", 2))
-		return -EINVAL;
-	mutex_lock(&mt6797_consys_lock);
-	ret = mt6797_consys_prepare_wmt(dev, dev_get_drvdata(dev));
-	mutex_unlock(&mt6797_consys_lock);
-	return ret ?: count;
-}
-
-static DEVICE_ATTR_WO(region19_prepare);
-
 /* Associate with CONN only after acquiring the independent shared resources. */
 static int mt6797_consys_attach_off_domain(struct device *dev,
 					   struct generic_pm_domain **domain)
@@ -984,7 +974,7 @@ static int mt6797_consys_drain_boot_events(struct device *dev,
 }
 
 #if IS_ENABLED(CONFIG_MT6797_MAC80211)
-int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops)
+static int mt6797_consys_wlan_attach_locked(const struct mt6797_mac_ops *ops)
 {
 	struct mt6797_consys *owner = &mt6797_consys;
 	struct mt6797_wifi_record *record = NULL;
@@ -992,7 +982,7 @@ int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops)
 	bool reattach;
 	int ret;
 
-	mutex_lock(&mt6797_consys_wlan_lock);
+	lockdep_assert_held(&mt6797_consys_wlan_lock);
 	ret = !owner->wlan_ready ? -ENODEV : owner->wlan_attached ? -EBUSY : 0;
 	if (ret)
 		goto out;
@@ -1024,6 +1014,24 @@ int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops)
 	ops->scan_ready(owner->wlan_hw);
 	owner->wlan_configured = true;
 out:
+	return ret;
+}
+
+/* Attach now if the firmware is ready; otherwise hold the layer and attach
+ * it when the firmware becomes ready.
+ */
+int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops)
+{
+	struct mt6797_consys *owner = &mt6797_consys;
+	int ret = 0;
+
+	mutex_lock(&mt6797_consys_wlan_lock);
+	if (owner->wlan_ready)
+		ret = mt6797_consys_wlan_attach_locked(ops);
+	else if (owner->wlan_attached || owner->wlan_pending)
+		ret = -EBUSY;
+	else
+		owner->wlan_pending = ops;
 	mutex_unlock(&mt6797_consys_wlan_lock);
 	return ret;
 }
@@ -1034,6 +1042,8 @@ void mt6797_consys_wlan_detach(const struct mt6797_mac_ops *ops)
 	struct mt6797_consys *owner = &mt6797_consys;
 
 	mutex_lock(&mt6797_consys_wlan_lock);
+	if (owner->wlan_pending == ops)
+		owner->wlan_pending = NULL;
 	if (owner->wlan_attached && owner->wlan_hw) {
 		ops->unreg(owner->wlan_hw);
 		owner->wlan_hw = NULL;
@@ -1113,7 +1123,9 @@ static DEVICE_ATTR_WO(wlan_stop);
 static void mt6797_consys_probe_firmware_start(struct device *dev,
 					       struct mt6797_consys *owner)
 {
-#if !IS_ENABLED(CONFIG_MT6797_MAC80211)
+#if IS_ENABLED(CONFIG_MT6797_MAC80211)
+	const struct mt6797_mac_ops *ops;
+#else
 	struct mt6797_wifi_record *record = NULL;
 #endif
 	static const u8 start[16] = {
@@ -1279,18 +1291,18 @@ static void mt6797_consys_probe_firmware_start(struct device *dev,
 	if (ret)
 		goto stopped;
 #if IS_ENABLED(CONFIG_MT6797_MAC80211)
+	dev_info(dev, "one-shot WLAN firmware ready; the mac module attaches on load\n");
 	mutex_lock(&mt6797_consys_wlan_lock);
 	owner->wlan_dev = dev;
 	owner->wlan_capability = capability;
 	owner->wlan_ready = true;
+	ops = IS_BUILTIN(CONFIG_MT6797_MAC80211) ? &mt6797_mac_attach_ops :
+						   owner->wlan_pending;
+	owner->wlan_pending = NULL;
+	ret = ops ? mt6797_consys_wlan_attach_locked(ops) : 0;
 	mutex_unlock(&mt6797_consys_wlan_lock);
-#if IS_BUILTIN(CONFIG_MT6797_MAC80211)
-	ret = mt6797_consys_wlan_attach(&mt6797_mac_attach_ops);
 	if (ret)
 		goto stopped;
-#else
-	dev_info(dev, "one-shot WLAN firmware ready; the mac module attaches on load\n");
-#endif
 #else
 	ret = mt6797_wifi_record_prepare(dev, &record);
 	dev_info(dev, "one-shot WLAN private record prepare: status=%d\n", ret);
@@ -1816,17 +1828,13 @@ static void mt6797_consys_probe_power_on(struct device *dev, struct mt6797_consy
 	dev_err(dev, "one-shot CONN power probe stopped (%d); state retained\n", ret);
 }
 
-/* One root request after the caller preserved and prepared the WMT window. */
-static ssize_t wmt_negotiate_store(struct device *dev,
-				   struct device_attribute *attr,
-				   const char *buf, size_t count)
+/* The start after the WMT window is prepared: CONN power through the WLAN
+ * firmware start. The caller holds mt6797_consys_lock.
+ */
+static int mt6797_consys_start_wlan(struct device *dev, struct mt6797_consys *owner)
 {
-	struct mt6797_consys *owner = dev_get_drvdata(dev);
 	int ret;
 
-	if (count != 2 || memcmp(buf, "1\n", 2))
-		return -EINVAL;
-	mutex_lock(&mt6797_consys_lock);
 	if (owner != &mt6797_consys || !owner->bound ||
 	    !owner->wmt_init_complete ||
 	    owner->deferred_start_attempted) {
@@ -1859,11 +1867,25 @@ static ssize_t wmt_negotiate_store(struct device *dev,
 	mt6797_consys_probe_power_on(dev, owner);
 	ret = owner->wmt_query_result;
 out:
-	mutex_unlock(&mt6797_consys_lock);
-	return ret ?: count;
+	return ret;
 }
 
-static DEVICE_ATTR_WO(wmt_negotiate);
+/* Probe queues this once: prepare the WMT window, then start. */
+static void mt6797_consys_start_work(struct work_struct *work)
+{
+	struct mt6797_consys *owner = container_of(work, struct mt6797_consys,
+						   start_work);
+	struct device *dev = owner->dev;
+	int ret;
+
+	mutex_lock(&mt6797_consys_lock);
+	ret = mt6797_consys_prepare_wmt(dev, owner);
+	if (!ret)
+		ret = mt6797_consys_start_wlan(dev, owner);
+	mutex_unlock(&mt6797_consys_lock);
+	if (ret)
+		dev_err(dev, "start stopped (%d)\n", ret);
+}
 
 static int mt6797_consys_probe(struct platform_device *pdev)
 {
@@ -2123,9 +2145,6 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	int observed = mt6797_consys_observe_region19(&pdev->dev,
 						&mt6797_consys);
 
-	if (!observed)
-		observed = device_create_file(&pdev->dev,
-					      &dev_attr_region19_prepare);
 	if (observed) {
 		if (mt6797_consys.region19_window) {
 			iounmap(mt6797_consys.region19_window);
@@ -2135,10 +2154,9 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 			"one-shot region 19 private export failed (%d)\n", observed);
 	}
 	if (mt6797_consys.region19_window) {
-		ret = device_create_file(&pdev->dev, &dev_attr_wmt_negotiate);
-		if (ret)
-			dev_err(&pdev->dev,
-				"one-shot WMT firmware trigger unavailable (%d)\n", ret);
+		mt6797_consys.dev = &pdev->dev;
+		INIT_WORK(&mt6797_consys.start_work, mt6797_consys_start_work);
+		schedule_work(&mt6797_consys.start_work);
 #if IS_MODULE(CONFIG_MT6797_MAC80211)
 		ret = device_create_file(&pdev->dev, &dev_attr_wlan_stop);
 		if (ret)
@@ -2170,9 +2188,9 @@ static void mt6797_consys_remove(struct platform_device *pdev)
 	struct device *dev = &pdev->dev;
 	int stop = -ENODEV, off = 0, ret;
 
-	/* The probe's files first: their writers take the locks below. */
-	device_remove_file(dev, &dev_attr_region19_prepare);
-	device_remove_file(dev, &dev_attr_wmt_negotiate);
+	/* The start and the stop file first: they take the locks below. */
+	if (owner->dev)
+		cancel_work_sync(&owner->start_work);
 #if IS_MODULE(CONFIG_MT6797_MAC80211)
 	device_remove_file(dev, &dev_attr_wlan_stop);
 #endif
-- 
2.43.0

