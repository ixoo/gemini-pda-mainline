From aefb547b97ac86e02bbe42a2e84773e65d35862a Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 2 Nov 2026 22:11:07 -0500
Subject: [PATCH] vt: let a driver hold the console blank

TIOCL_BLANKSCREEN blanks the console until it is explicitly unblanked, unlike a
plain do_blank_screen(), which the next console write wakes. Export that for a
driver that blanks for a physical reason, such as a closed lid.
---
 drivers/tty/vt/vt.c     | 16 ++++++++++++----
 include/linux/vt_kern.h |  1 +
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/drivers/tty/vt/vt.c b/drivers/tty/vt/vt.c
index e99636ab9..17f32f76c 100644
--- a/drivers/tty/vt/vt.c
+++ b/drivers/tty/vt/vt.c
@@ -3633,10 +3633,8 @@ int tioclinux(struct tty_struct *tty, unsigned long arg)
 			scrollfront(vc_cons[fg_console].d, lines);
 		break;
 	case TIOCL_BLANKSCREEN:	/* until explicitly unblanked, not only poked */
-		scoped_guard(console_lock) {
-			ignore_poke = 1;
-			do_blank_screen(0);
-		}
+		scoped_guard(console_lock)
+			do_hold_blank_screen();
 		break;
 	case TIOCL_BLANKEDSCREEN:
 		return console_blanked;
@@ -4720,6 +4718,16 @@ void do_blank_screen(int entering_gfx)
 }
 EXPORT_SYMBOL(do_blank_screen);
 
+/* Blank until do_unblank_screen(), so that a poke does not wake the screen. */
+void do_hold_blank_screen(void)
+{
+	WARN_CONSOLE_UNLOCKED();
+
+	ignore_poke = 1;
+	do_blank_screen(0);
+}
+EXPORT_SYMBOL(do_hold_blank_screen);
+
 /*
  * Called by timer as well as from vt_console_driver
  */
diff --git a/include/linux/vt_kern.h b/include/linux/vt_kern.h
index d008c3d0a..83a484e89 100644
--- a/include/linux/vt_kern.h
+++ b/include/linux/vt_kern.h
@@ -30,6 +30,7 @@ int __vc_resize(struct vc_data *vc, unsigned int cols, unsigned int lines,
 struct vc_data *vc_deallocate(unsigned int console);
 void reset_palette(struct vc_data *vc);
 void do_blank_screen(int entering_gfx);
+void do_hold_blank_screen(void);
 void do_unblank_screen(int leaving_gfx);
 void poke_blanked_console(void);
 int con_font_op(struct vc_data *vc, struct console_font_op *op);
