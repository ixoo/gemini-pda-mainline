From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 1 Nov 2026 10:16:09 -0500
Subject: [PATCH] wifi: mt6797: keep data at three transmit attempts

0436 gave data at the fixed rate the vendor's 30 attempts as well. On
channel 40 at -62 dBm, transmit then read 0.5, 0.6 and 9.5 Mbit/s, against
21-23 before. Keep the higher limit for management and EAPOL, which is
what the lost frames on channel 11 needed, and return data to three.

Part of the Wi-Fi daily-use plan, phase 3.
---
 drivers/net/wireless/mediatek/mt6797/join.c     | 5 +----
 drivers/net/wireless/mediatek/mt6797/mac-priv.h | 7 ++++---
 drivers/net/wireless/mediatek/mt6797/main.c     | 2 +-
 3 files changed, 6 insertions(+), 8 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/join.c b/drivers/net/wireless/mediatek/mt6797/join.c
index 421bf7a15..4ee84a183 100644
--- a/drivers/net/wireless/mediatek/mt6797/join.c
+++ b/drivers/net/wireless/mediatek/mt6797/join.c
@@ -2259,10 +2259,7 @@ void mt6797_mac_join_work(struct work_struct *work)
 									  eth_bytes, 1,
 									  sample ? mac->join_pid : 0,
 									  sample,
-									  500,
-									  per_frame ?
-									  MT6797_TX_ATTEMPTS_RATE_CONTROL :
-									  MT6797_TX_ATTEMPTS,
+									  500, MT6797_TX_ATTEMPTS_DATA,
 									  per_frame,
 									  deadline);
 					if (ret)
diff --git a/drivers/net/wireless/mediatek/mt6797/mac-priv.h b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
index 143820c44..95ea9652e 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac-priv.h
+++ b/drivers/net/wireless/mediatek/mt6797/mac-priv.h
@@ -659,11 +659,12 @@ struct mt6797_mac {
  */
 #define MT6797_JOIN_ATTEMPTS 3
 
-/* Transmit attempts per frame: the vendor's retry limit, which a busy channel
- * needs. Frames at a rate control choice keep mac80211's own limit.
+/* Transmit attempts per frame. Management and EAPOL take the vendor's retry
+ * limit, which a busy channel needs. Data stays at three: at the vendor's limit
+ * transmit fell to 0.5-9.5 Mbit/s on channel 40.
  */
 #define MT6797_TX_ATTEMPTS 30U
-#define MT6797_TX_ATTEMPTS_RATE_CONTROL 3U
+#define MT6797_TX_ATTEMPTS_DATA 3U
 
 /* A current, owned monitor notification is a normal connection loss, not a
  * malformed transport event. End traffic and queue standard core teardown;
diff --git a/drivers/net/wireless/mediatek/mt6797/main.c b/drivers/net/wireless/mediatek/mt6797/main.c
index 17c1c93c3..3191cbcbf 100644
--- a/drivers/net/wireless/mediatek/mt6797/main.c
+++ b/drivers/net/wireless/mediatek/mt6797/main.c
@@ -2160,7 +2160,7 @@ static int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 		mac->rates[i].bitrate = bitrates[i];
 		mac->rates[i].hw_value = codes[i];
 	}
-	/* One rate per ordinary data frame, at MT6797_TX_ATTEMPTS_RATE_CONTROL. */
+	/* One rate per ordinary data frame, at MT6797_TX_ATTEMPTS_DATA. */
 	hw->max_rates = 1;
 	hw->max_rate_tries = 3;
 	mac->band.band = NL80211_BAND_2GHZ;
-- 
