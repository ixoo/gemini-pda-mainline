From dd219cdd52632ed4393df6e15569e43d348e165b Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 20:08:43 -0400
Subject: [PATCH] dt-bindings: soc: mediatek: mt6797-consys: allow the WLAN HIF
 interrupt

The WLAN HIF (the window at 0x180f0000) has its own interrupt line, the
one the vendor device tree gives its wifi@180f0000 node (GIC SPI 283,
level low). The CONSYS node's own interrupt is the WMT/BTIF line and
stays the only one there. Allow one optional interrupt on the wifi
child; without it the WLAN client polls.
---
 .../bindings/soc/mediatek/mediatek,mt6797-consys.yaml        | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
index 78ef54d52..1775ef4b3 100644
--- a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
@@ -209,6 +209,11 @@ properties:
       status: true
       compatible:
         const: mediatek,mt6797-wlan
+      interrupts:
+        maxItems: 1
+        description:
+          The WLAN HIF interrupt (the HIF window at 0x180f0000), level low.
+          Optional; without it the WLAN client polls.
     required:
       - compatible
     additionalProperties: false
-- 
2.43.0

