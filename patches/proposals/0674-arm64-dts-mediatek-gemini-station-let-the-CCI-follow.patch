+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda-station-dvfs.dts
@@ -20,19 +20,28 @@
 /delete-node/ &cluster1_opp;
 
 / {
-	/* VSRAM_L: the SRAM LDOs of CPU0-7 and the CCI, kept above VPROC1. */
+	/*
+	 * VSRAM_L: the SRAM LDOs of CPU0-7 and the CCI, kept above VPROC1. The
+	 * firmware leaves it at 1.10 V with VPROC1 at 1.00 V; it never goes
+	 * below that here, though the vendor's own range starts at 1.0 V.
+	 */
 	vsram_l: regulator-vsram-l {
 		compatible = "mediatek,mt6797-cpu-sram-ldo";
 		mediatek,infracfg = <&infrasys>;
 		regulator-name = "vsram_l";
-		regulator-min-microvolt = <1000000>;
+		regulator-min-microvolt = <1100000>;
 		regulator-max-microvolt = <1200000>;
 		regulator-coupled-with = <&vproc1>;
 		/* The coupler sets the spread itself; the core needs a value. */
 		regulator-coupled-max-spread = <430000>;
 	};
 
-	/* The CCI follows the faster of the two clusters, as the vendor's does. */
+	/*
+	 * The CCI follows the two clusters through the passive governor: each
+	 * cluster's place in its range maps onto the CCI's range and the faster
+	 * one wins. The CCI sets the voltage of its own point, so any mapping
+	 * keeps VPROC1 high enough for it.
+	 */
 	cci: cci {
 		compatible = "mediatek,mt6797-cci";
 		clocks = <&mcusys_pll MT6797_CLK_MCU_CCI>;
@@ -41,10 +50,7 @@ cci: cci {
 		proc-supply = <&vproc1>;
 	};
 
-	/*
-	 * Each CPU point requires the CCI point with the same vendor index; the
-	 * CCI's 169 MHz point is below its sync DCM floor, so 234 MHz stands in.
-	 */
+	/* The CCI's 169 MHz point is below its sync DCM floor of 210 MHz. */
 	ll_dvfs_opp: opp-table-cluster0 {
 		compatible = "operating-points-v2";
 		opp-shared;
