From c798783ba0bff85e5915f05cbf704460205dcd56 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Thu, 22 Oct 2026 17:33:55 -0400
Subject: [PATCH] wifi: mt6797: report bounded pre-key EAPOL admission
 predicates

Name the existing decoder and caller refusal gates without widening them. Log admitted and refused pre-key data descriptors for comparison, including BSS, format, prefix, lengths and activation state. Copy only descriptor metadata, zero-padding a short descriptor; no MSDU payload is logged. The existing two-frame EAPOL limit remains unchanged.
---
 .../net/wireless/mediatek/mt6797/eapol-rx.h   | 218 +++++++++++++++---
 drivers/net/wireless/mediatek/mt6797/mac.c    |  58 ++++-
 2 files changed, 246 insertions(+), 30 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/eapol-rx.h b/drivers/net/wireless/mediatek/mt6797/eapol-rx.h
index b2be8f2..ca7ea64 100644
--- a/drivers/net/wireless/mediatek/mt6797/eapol-rx.h
+++ b/drivers/net/wireless/mediatek/mt6797/eapol-rx.h
@@ -4,6 +4,35 @@
 
 #include "join-events.h"
 
+enum mt6797_eapol_gate {
+	MT6797_EAPOL_OK,
+	MT6797_EAPOL_INPUT,
+	MT6797_EAPOL_BYTE_COUNT,
+	MT6797_EAPOL_PACKET_TYPE,
+	MT6797_EAPOL_CHANNEL,
+	MT6797_EAPOL_WLAN_MATCH,
+	MT6797_EAPOL_MSDU_FORMAT,
+	MT6797_EAPOL_BSS,
+	MT6797_EAPOL_FORMAT,
+	MT6797_EAPOL_SECURITY,
+	MT6797_EAPOL_PREFIX,
+	MT6797_EAPOL_GROUP_BOUNDS,
+	MT6797_EAPOL_VECTOR,
+	MT6797_EAPOL_TRANSLATED_LAYOUT,
+	MT6797_EAPOL_FRAGMENT,
+	MT6797_EAPOL_PEER,
+	MT6797_EAPOL_ETHERTYPE,
+	MT6797_EAPOL_NATIVE_LAYOUT,
+	MT6797_EAPOL_LLC,
+	MT6797_EAPOL_FRAME_CONTROL,
+	MT6797_EAPOL_SOURCE,
+	MT6797_EAPOL_EAPOL_VERSION,
+	MT6797_EAPOL_EAPOL_TYPE,
+	MT6797_EAPOL_EAPOL_LENGTH,
+	MT6797_EAPOL_KEY_DESCRIPTOR,
+	MT6797_EAPOL_KEY_DATA_LENGTH,
+};
+
 struct mt6797_eapol_rx {
 	unsigned char prefix[32];
 	size_t prefix_bytes, offset, bytes;
@@ -28,8 +57,8 @@ struct mt6797_eapol_rx {
  * value has been observed; 0 was a guess and is refused with the frame named.
  * No firmware crypto, key material, transport, allocation or effects here.
  */
-static inline bool
-mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
+static inline enum mt6797_eapol_gate
+mt6797_eapol_rx_gate(const unsigned char *packet, size_t bytes,
 		unsigned char channel, const unsigned char own[6],
 		const unsigned char ap[6], struct mt6797_eapol_rx *out)
 {
@@ -39,14 +68,27 @@ mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
 	const unsigned char *f, *source;
 	bool translated;
 
-	if (!packet || !own || !ap || !out || bytes < 16 || bytes > 4096 ||
-	    !channel || mt6797_join_le16(packet) != bytes ||
-	    (mt6797_join_le16(packet + 2) >> 13) != 2 ||
-	    packet[5] != channel || (packet[4] & 15) != 2 ||
-	    (packet[7] & 3) || ((packet[7] >> 2) != 1 && (packet[7] >> 2) != 15) ||
-	    packet[8] != 1 || packet[9] ||
-	    mt6797_join_le16(packet + 10) != 0xc000)
-		return false;
+	if (!packet || !own || !ap || !out || bytes < 16 || bytes > 4096 || !channel)
+		return MT6797_EAPOL_INPUT;
+	if (mt6797_join_le16(packet) != bytes)
+		return MT6797_EAPOL_BYTE_COUNT;
+	if ((mt6797_join_le16(packet + 2) >> 13) != 2)
+		return MT6797_EAPOL_PACKET_TYPE;
+	if (packet[5] != channel)
+		return MT6797_EAPOL_CHANNEL;
+	if ((packet[4] & 15) != 2)
+		return MT6797_EAPOL_WLAN_MATCH;
+	if (packet[7] & 3)
+		return MT6797_EAPOL_MSDU_FORMAT;
+	if ((packet[7] >> 2) != 1 && (packet[7] >> 2) != 15)
+		return MT6797_EAPOL_BSS;
+	if (packet[8] != 1)
+		return MT6797_EAPOL_FORMAT;
+	if (packet[9])
+		return MT6797_EAPOL_SECURITY;
+	if (mt6797_join_le16(packet + 10) != 0xc000)
+		return MT6797_EAPOL_PREFIX;
+
 	r.bss_index = packet[7] >> 2;
 	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
 	if (groups & 8) {
@@ -63,21 +105,23 @@ mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
 	}
 	if (packet[6] & 0x40)
 		offset += 2;
-	if (offset > bytes || (vector && packet[vector + 9] > 220))
-		return false;
+	if (offset > bytes)
+		return MT6797_EAPOL_GROUP_BOUNDS;
+	if (vector && packet[vector + 9] > 220)
+		return MT6797_EAPOL_VECTOR;
 	translated = packet[6] & 0x80;
 	f = packet + offset;
 	if (translated) {
 		if (!group4 || (packet[6] & 63) != 14 || bytes - offset < 18)
-			return false;
+			return MT6797_EAPOL_TRANSLATED_LAYOUT;
 		fc = mt6797_join_le16(packet + group4);
 		if (mt6797_join_le16(packet + group4 + 8) & 15)
-			return false;
+			return MT6797_EAPOL_FRAGMENT;
 		for (i = 0; i < 6; i++)
 			if (f[i] != own[i] || packet[group4 + 2 + i] != ap[i])
-				return false;
+				return MT6797_EAPOL_PEER;
 		if (f[12] != 0x88 || f[13] != 0x8e)
-			return false;
+			return MT6797_EAPOL_ETHERTYPE;
 		source = f + 6;
 		eapol = offset + 14;
 		r.prefix_bytes = 32;
@@ -98,16 +142,16 @@ mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
 		r.offset = eapol;
 	} else {
 		if ((packet[6] & 63) != 24 || bytes - offset < 36)
-			return false;
+			return MT6797_EAPOL_NATIVE_LAYOUT;
 		fc = mt6797_join_le16(f);
 		if (mt6797_join_le16(f + 22) & 15)
-			return false;
+			return MT6797_EAPOL_FRAGMENT;
 		for (i = 0; i < 6; i++)
 			if (f[4 + i] != own[i] || f[10 + i] != ap[i])
-				return false;
+				return MT6797_EAPOL_PEER;
 		if (f[24] != 0xaa || f[25] != 0xaa || f[26] != 3 ||
 		    f[27] || f[28] || f[29] || f[30] != 0x88 || f[31] != 0x8e)
-			return false;
+			return MT6797_EAPOL_LLC;
 		source = f + 16;
 		eapol = offset + 32;
 		r.offset = offset;
@@ -115,21 +159,139 @@ mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
 	/* Version/type, DS direction, fragment, protection and QoS are fixed.
 	 * Retry and More-Data do not alter header layout or peer identity.
 	 */
-	if ((fc & ~0x2800U) != 0x0208 || (source[0] & 1))
-		return false;
+	if ((fc & ~0x2800U) != 0x0208)
+		return MT6797_EAPOL_FRAME_CONTROL;
+	if (source[0] & 1)
+		return MT6797_EAPOL_SOURCE;
 	/* Complete WPA2-PSK EAPOL-Key (16-byte MIC) and key-data length.
 	 * Supplicant owns nonce, replay, MIC and handshake-state validation.
 	 */
 	length = (packet[eapol + 2] << 8) | packet[eapol + 3];
-	if ((packet[eapol] < 1 || packet[eapol] > 3) ||
-	    packet[eapol + 1] != 3 || length < 95 || length > 2048 ||
-	    bytes - eapol != length + 4 || packet[eapol + 4] != 2 ||
-	    (((unsigned int)packet[eapol + 97] << 8) | packet[eapol + 98]) != length - 95)
-		return false;
+	if (packet[eapol] < 1 || packet[eapol] > 3)
+		return MT6797_EAPOL_EAPOL_VERSION;
+	if (packet[eapol + 1] != 3)
+		return MT6797_EAPOL_EAPOL_TYPE;
+	if (length < 95 || length > 2048 || bytes - eapol != length + 4)
+		return MT6797_EAPOL_EAPOL_LENGTH;
+	if (packet[eapol + 4] != 2)
+		return MT6797_EAPOL_KEY_DESCRIPTOR;
+	if ((((unsigned int)packet[eapol + 97] << 8) | packet[eapol + 98]) != length - 95)
+		return MT6797_EAPOL_KEY_DATA_LENGTH;
+
 	r.bytes = bytes - r.offset;
 	r.signal_valid = vector != 0;
 	r.signal_dbm = vector ? (int)packet[vector + 9] / 2 - 110 : 0;
 	*out = r;
-	return true;
+	return MT6797_EAPOL_OK;
+}
+
+/* Preserve the existing boolean admission API and every body predicate. */
+static inline bool
+mt6797_eapol_rx(const unsigned char *packet, size_t bytes,
+		unsigned char channel, const unsigned char own[6],
+		const unsigned char ap[6], struct mt6797_eapol_rx *out)
+{
+	return mt6797_eapol_rx_gate(packet, bytes, channel, own, ap, out) == MT6797_EAPOL_OK;
+}
+
+/* Descriptor geometry only. Zero means untrusted/truncated group geometry. */
+static inline size_t
+mt6797_eapol_rxd_bytes(const unsigned char *packet, size_t bytes)
+{
+	size_t n = 16;
+	unsigned int groups;
+
+	if (!packet || bytes < 16)
+		return 0;
+	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
+	if (groups & 8)
+		n += 16;
+	if (groups & 1)
+		n += 16;
+	if (groups & 2)
+		n += 8;
+	if (groups & 4)
+		n += 24;
+	return n <= bytes ? n : 0;
+}
+
+/* Diagnostic recognition only, never admission. No search or payload dump. */
+static inline bool
+mt6797_eapol_candidate(const unsigned char *packet, size_t bytes)
+{
+	size_t off = mt6797_eapol_rxd_bytes(packet, bytes);
+	const unsigned char *f;
+
+	if (!off)
+		return false;
+	if (packet[6] & 0x40)
+		off += 2;
+	if (off > bytes)
+		return false;
+	f = packet + off;
+	return (bytes - off >= 18 && f[12] == 0x88 && f[13] == 0x8e && f[15] == 3) ||
+	       (bytes - off >= 36 && f[24] == 0xaa && f[25] == 0xaa &&
+		f[26] == 3 && !f[27] && !f[28] && !f[29] &&
+		f[30] == 0x88 && f[31] == 0x8e && f[33] == 3);
+}
+
+static inline const char *mt6797_eapol_gate_name(enum mt6797_eapol_gate gate)
+{
+	switch (gate) {
+	case MT6797_EAPOL_OK:
+		return "ok";
+	case MT6797_EAPOL_INPUT:
+		return "input";
+	case MT6797_EAPOL_BYTE_COUNT:
+		return "rxd-byte-count";
+	case MT6797_EAPOL_PACKET_TYPE:
+		return "packet-type";
+	case MT6797_EAPOL_CHANNEL:
+		return "channel";
+	case MT6797_EAPOL_WLAN_MATCH:
+		return "rxd-byte4";
+	case MT6797_EAPOL_MSDU_FORMAT:
+		return "msdu-format";
+	case MT6797_EAPOL_BSS:
+		return "bss";
+	case MT6797_EAPOL_FORMAT:
+		return "rxd-byte8";
+	case MT6797_EAPOL_SECURITY:
+		return "rxd-byte9";
+	case MT6797_EAPOL_PREFIX:
+		return "prefix";
+	case MT6797_EAPOL_GROUP_BOUNDS:
+		return "group-bounds";
+	case MT6797_EAPOL_VECTOR:
+		return "vector";
+	case MT6797_EAPOL_TRANSLATED_LAYOUT:
+		return "translated-layout";
+	case MT6797_EAPOL_FRAGMENT:
+		return "fragment";
+	case MT6797_EAPOL_PEER:
+		return "peer";
+	case MT6797_EAPOL_ETHERTYPE:
+		return "ethertype";
+	case MT6797_EAPOL_NATIVE_LAYOUT:
+		return "native-layout";
+	case MT6797_EAPOL_LLC:
+		return "llc";
+	case MT6797_EAPOL_FRAME_CONTROL:
+		return "frame-control";
+	case MT6797_EAPOL_SOURCE:
+		return "source";
+	case MT6797_EAPOL_EAPOL_VERSION:
+		return "eapol-version";
+	case MT6797_EAPOL_EAPOL_TYPE:
+		return "eapol-type";
+	case MT6797_EAPOL_EAPOL_LENGTH:
+		return "eapol-length";
+	case MT6797_EAPOL_KEY_DESCRIPTOR:
+		return "key-descriptor";
+	case MT6797_EAPOL_KEY_DATA_LENGTH:
+		return "key-data-length";
+	default:
+		return "unknown";
+	}
 }
 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 4b453fa..e6ece5f 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -241,6 +241,7 @@ struct mt6797_mac {
 	unsigned int join_absence_events;
 	/* Phase C1: bounded observation of the AP's first clear EAPOL frames. */
 	unsigned int join_eapol_seen, join_eapol_tx, join_group_discarded;
+	unsigned int join_eapol_trace; /* bounded metadata-only pre-key observation */
 	unsigned int join_action_discarded, join_group_action_discarded;
 	unsigned int join_keyed_beacons;
 	unsigned int join_beacons_delivered;
@@ -1491,6 +1492,7 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_key_done_second = false;
 	mac->join_group_key_id = 0;
 	mac->join_eapol_seen = 0;
+	mac->join_eapol_trace = 0;
 	mac->join_eapol_tx = 0;
 	mac->join_group_discarded = 0;
 	mac->join_action_discarded = 0;
@@ -2904,12 +2906,51 @@ static int mt6797_mac_join_deliver_beacon(struct mt6797_mac *mac, size_t offset,
 }
 #endif
 
+/* Pre-key data RXDs only. Header groups are metadata; never copy the MSDU.
+ * Missing descriptor groups leave the remainder zero, with header_bytes named.
+ */
+static void mt6797_mac_eapol_trace(struct mt6797_mac *mac, size_t bytes,
+				 const char *verdict, const char *predicate,
+				 enum mt6797_eapol_gate gate, size_t eapol_bytes)
+{
+	const u8 *p = mac->join_packet;
+	u8 header[32] = {0};
+	size_t descriptor, copied, offset, frame_bytes = 0;
+
+	if (mac->join_key_pairwise_submitted || bytes < 16 ||
+	    (mt6797_join_le16(p + 2) >> 13) != 2)
+		return;
+	if (++mac->join_eapol_trace > 64) {
+		if (mac->join_eapol_trace == 65)
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN EAPOL trace suppressed: limit=64\n");
+		return;
+	}
+	descriptor = mt6797_eapol_rxd_bytes(p, bytes);
+	copied = descriptor ? min_t(size_t, descriptor, sizeof(header)) : 16;
+	memcpy(header, p, copied);
+	offset = descriptor + ((p[6] & 0x40) ? 2 : 0);
+	if (descriptor && offset <= bytes)
+		frame_bytes = bytes - offset;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN EAPOL admission: ordinal=%u verdict=%s predicate=%s candidate=%u body_examined=%u body_valid=%u activated=%u bss_configured=%u seen=%u bss=%u msdu_format=%u format=0x%02x p8=0x%02x p9=0x%02x prefix=0x%04x rx_bytes=%zu frame_bytes=%zu eapol_bytes=%zu channel=%u translated=%u header_bytes=%zu rxd32=%*phN\n",
+		 mac->join_eapol_trace, verdict, predicate,
+		 mt6797_eapol_candidate(p, bytes),
+		 gate == MT6797_EAPOL_OK || gate >= MT6797_EAPOL_EAPOL_VERSION,
+		 gate == MT6797_EAPOL_OK, mac->join_sta_active,
+		 mac->join_bss_configured, mac->join_eapol_seen,
+		 p[7] >> 2, p[7] & 3, p[6], p[8], p[9], mt6797_join_le16(p + 10),
+		 bytes, frame_bytes, eapol_bytes, p[5], !!(p[6] & 0x80),
+		 copied, (int)sizeof(header), header);
+}
+
 static void mt6797_mac_join_work(struct work_struct *work)
 {
 	struct mt6797_mac *mac = container_of(to_delayed_work(work),
 				      struct mt6797_mac, join_work);
 	struct mt6797_hif_rx_result rx;
 	struct mt6797_eapol_rx eapol;
+	enum mt6797_eapol_gate eapol_gate;
 	struct mt6797_join_group_data group;
 	struct mt6797_data_rx data;
 	struct mt6797_join_action_frame action;
@@ -3568,8 +3609,10 @@ submitted:
 			 * association flag and routes it to the connection owner. Any
 			 * other shape, or a third frame, reaches the refusal below.
 			 */
-			if (mt6797_eapol_rx(mac->join_packet, rx.logical_bytes, 40,
-					    mac->hw->wiphy->perm_addr, mac->join_ap, &eapol) &&
+			eapol_gate = mt6797_eapol_rx_gate(mac->join_packet, rx.logical_bytes,
+							40, mac->hw->wiphy->perm_addr,
+							mac->join_ap, &eapol);
+			if (eapol_gate == MT6797_EAPOL_OK &&
 			    mac->join_assoc_received && !mac->join_assoc_status &&
 			    !mac->join_deauth_done && !mac->join_cleanup_done &&
 			    mac->join_eapol_seen < 2 &&
@@ -3587,6 +3630,8 @@ submitted:
 			     */
 			    ((eapol.bss_index == 15 && !mac->join_bss_configured) ||
 			     (eapol.bss_index == 1 && mac->join_sta_active))) {
+				mt6797_mac_eapol_trace(mac, rx.logical_bytes, "admitted", "ok",
+						       eapol_gate, eapol.bytes);
 				mac->join_eapol_seen++;
 				skb = dev_alloc_skb(eapol.prefix_bytes + eapol.bytes);
 				if (!skb) {
@@ -3614,6 +3659,14 @@ submitted:
 #endif
 				continue;
 			}
+			mt6797_mac_eapol_trace(mac, rx.logical_bytes, "refused",
+				eapol_gate != MT6797_EAPOL_OK ? mt6797_eapol_gate_name(eapol_gate) :
+				!mac->join_assoc_received || mac->join_assoc_status ? "association" :
+				mac->join_deauth_done ? "deauth-ended" :
+				mac->join_cleanup_done ? "cleanup-done" :
+				mac->join_eapol_seen >= 2 ? "delivery-cap" : "bss-interval",
+				eapol_gate, eapol_gate == MT6797_EAPOL_OK ? eapol.bytes : 0);
+
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
 			/* Phase C3: during the data phase, after both key credits and
 			 * before the deauthentication, a protected firmware-decrypted
@@ -4635,6 +4688,7 @@ static int mt6797_mac_join_add_peer(struct mt6797_mac *mac,
 	/* Reserve before any PIO: failure never authorizes a second peer attempt. */
 	mac->join_peer_used = true;
 	mac->join_eapol_seen = 0;
+	mac->join_eapol_trace = 0;
 	mac->join_group_discarded = 0;
 	mac->join_action_discarded = 0;
 	mac->join_group_action_discarded = 0;
-- 
