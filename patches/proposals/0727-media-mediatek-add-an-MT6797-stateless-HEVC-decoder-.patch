+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MT6797_VDEC
+	tristate "MediaTek MT6797 video decoder (stateless prototype)"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on V4L_MEM2MEM_DRIVERS
+	depends on VIDEO_DEV && OF && PM
+	select MEDIA_CONTROLLER
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	help
+	  Prototype V4L2 stateless HEVC decoder for the MT6797 video decoder
+	  block. It programs the decoder registers from the CPU for every
+	  picture, decoding Main profile 8-bit 4:2:0 HEVC slices submitted
+	  through the request API, and outputs MM21 frames. Say M to build it
+	  as a module; nothing loads it automatically.
