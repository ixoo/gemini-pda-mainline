From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 7 Nov 2026 14:57:19 -0500
Subject: [PATCH] dt-bindings: clock: mediatek: add the MT6797 A53 cluster PLLs

The two Cortex-A53 clusters of MT6797 each run from a PLL in MCUMIXED,
followed by a post-divider and a cluster clock divider, and the MCU
frequency-hopping controller in the same block retunes those PLLs. The
secure firmware shares the block, so a driver also needs the DVFSP
handoff that grants hardware semaphore 3, and the semaphore clock.

Describe the provider and number its two clocks.
---
 .../clock/mediatek,mt6797-mcusys-pll.yaml     | 76 +++++++++++++++++++
 .../clock/mediatek,mt6797-mcusys.h            |  8 ++
 2 files changed, 84 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/mediatek,mt6797-mcusys-pll.yaml
 create mode 100644 include/dt-bindings/clock/mediatek,mt6797-mcusys.h

diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6797-mcusys-pll.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6797-mcusys-pll.yaml
new file mode 100644
index 000000000..3ae7ea755
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6797-mcusys-pll.yaml
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6797-mcusys-pll.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 Cortex-A53 cluster PLLs
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description:
+  The MCUMIXED block holds the PLLs, post-dividers and cluster clock dividers
+  of the two Cortex-A53 clusters, and the MCU frequency-hopping controller that
+  retunes those PLLs. The secure firmware shares the block, so every access
+  holds the DVFSP hardware semaphore, reached through the DVFSP handoff.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-mcusys-pll
+
+  reg:
+    items:
+      - description: MCUMIXED PLL, divider and FHCTL registers
+      - description: MCUCFG, read once for the sync DCM state
+      - description:
+          TOPCKGEN, whose CLK_MISC_CFG_0 opens the MAINPLL path the cluster
+          takes during a post-divider change
+
+  reg-names:
+    items:
+      - const: mcumixed
+      - const: mcucfg
+      - const: topckgen
+
+  clocks:
+    items:
+      - description: clock of the DVFSP hardware semaphore
+
+  clock-names:
+    items:
+      - const: sema
+
+  access-controllers:
+    maxItems: 1
+    description: the DVFSP handoff that owns the CSPM window
+
+  '#clock-cells':
+    const: 1
+    description: see include/dt-bindings/clock/mediatek,mt6797-mcusys.h
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - access-controllers
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt6797-clk.h>
+
+    clock-controller@1001a000 {
+        compatible = "mediatek,mt6797-mcusys-pll";
+        reg = <0x1001a000 0x1000>, <0x10220000 0x1000>,
+              <0x10000000 0x1000>;
+        reg-names = "mcumixed", "mcucfg", "topckgen";
+        clocks = <&infrasys CLK_INFRA_I2C_APPM>;
+        clock-names = "sema";
+        access-controllers = <&dvfsp_handoff>;
+        #clock-cells = <1>;
+    };
diff --git a/include/dt-bindings/clock/mediatek,mt6797-mcusys.h b/include/dt-bindings/clock/mediatek,mt6797-mcusys.h
new file mode 100644
index 000000000..ebfa93b8b
--- /dev/null
+++ b/include/dt-bindings/clock/mediatek,mt6797-mcusys.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+#ifndef _DT_BINDINGS_CLK_MEDIATEK_MT6797_MCUSYS_H
+#define _DT_BINDINGS_CLK_MEDIATEK_MT6797_MCUSYS_H
+
+#define MT6797_CLK_MCU_LL	0	/* CPU0-3 */
+#define MT6797_CLK_MCU_L	1	/* CPU4-7 */
+
+#endif
-- 
