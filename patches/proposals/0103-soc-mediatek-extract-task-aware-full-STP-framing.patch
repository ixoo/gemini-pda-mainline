From a0444e5f6bd319168c6a32d14627110c9b9cda68 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sun, 4 Oct 2026 12:07:20 -0400
Subject: [PATCH] soc: mediatek: extract task-aware full STP framing

Prepare ordinary task framing for the shared Bluetooth/WMT transport.
Keep the selected full-mode 2048-byte ceiling and exclude the separate
firmware-message tasks 5/6. Preserve the WMT API, task filter and 1005-byte
command limit over the shared codec.

Add an owner-held byte parser without link sequence or acknowledgement
state. It exposes complete CRC-checked payloads and refuses terminally;
shared task delivery, IRQ lifetime and reset epochs remain later work.

Host fixtures pass strict warnings and ASan/UBSan for task framing and the
four existing WMT codec/state/stream/TX tests. This internal draft uses a
synthetic non-certifying author and is not submission-ready. No device
access or hardware result is claimed.
---
 drivers/soc/mediatek/stp-full-stream.h |  55 ++++++++++++
 drivers/soc/mediatek/stp-full.h        | 120 +++++++++++++++++++++++++
 drivers/soc/mediatek/wmt-full-stp.h    |  81 +++++------------
 3 files changed, 195 insertions(+), 61 deletions(-)
 create mode 100644 drivers/soc/mediatek/stp-full-stream.h
 create mode 100644 drivers/soc/mediatek/stp-full.h

diff --git a/drivers/soc/mediatek/stp-full-stream.h b/drivers/soc/mediatek/stp-full-stream.h
new file mode 100644
index 0000000..051aedb
--- /dev/null
+++ b/drivers/soc/mediatek/stp-full-stream.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_STP_FULL_STREAM_H
+#define MT6797_STP_FULL_STREAM_H
+#include "stp-full.h"
+
+/*
+ * Owner-held persistent storage, never a kernel stack allocation. Consume the
+ * completed payload before resetting storage for the next frame. Link sequence
+ * and ACK state are separate and must not be reset at these frame boundaries.
+ */
+struct stp_full_stream {
+	unsigned char frame[STP_FULL_MAX_FRAME];
+	unsigned int used, needed;
+	int terminal;
+};
+
+static inline void stp_full_stream_init(struct stp_full_stream *stream)
+{
+	stream->used = 0;
+	stream->needed = 4;
+	stream->terminal = 0;
+}
+
+/*
+ * Incomplete=0, ACK=1, data=2, terminal refusal=-1. Aggregate frame/byte/time
+ * budgets and task delivery belong to the shared owner, not individual tasks.
+ */
+static inline int stp_full_stream_byte(struct stp_full_stream *stream,
+				       unsigned char byte, struct stp_full_frame *result)
+{
+	unsigned int length;
+	int kind;
+
+	if (!stream || !result)
+		return -1;
+	if (stream->terminal || stream->used >= sizeof(stream->frame))
+		goto refuse;
+	stream->frame[stream->used++] = byte;
+	if (stream->used == 4) {
+		if (stp_full_header(stream->frame, stream->used, &length))
+			goto refuse;
+		stream->needed = length ? length + 6 : 4;
+	}
+	if (stream->used < stream->needed)
+		return 0;
+	kind = stp_full_decode(stream->frame, stream->used, result);
+	if (kind < 0)
+		goto refuse;
+	stream->terminal = 1;
+	return kind + 1;
+refuse:
+	stream->terminal = -1;
+	return -1;
+}
+#endif
diff --git a/drivers/soc/mediatek/stp-full.h b/drivers/soc/mediatek/stp-full.h
new file mode 100644
index 0000000..442db6c
--- /dev/null
+++ b/drivers/soc/mediatek/stp-full.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_STP_FULL_H
+#define MT6797_STP_FULL_H
+
+/* Selected Gemian full-mode parser ceiling, despite the 12-bit wire length. */
+#define STP_FULL_MAX_PAYLOAD 2048U
+#define STP_FULL_MAX_FRAME (STP_FULL_MAX_PAYLOAD + 6U)
+#define STP_FULL_TASK_BT 0U
+#define STP_FULL_TASK_GPS 2U
+#define STP_FULL_TASK_WMT 4U
+#define STP_FULL_TASK_NONE 8U
+
+struct stp_full_frame {
+	unsigned int sequence, acknowledgement, task, length;
+	const unsigned char *payload;
+};
+
+/* Tasks 5/6 are firmware messages with a separate vendor framing path. */
+static inline int stp_full_task(unsigned int task)
+{
+	return task <= 4 || task == 7;
+}
+
+static inline unsigned int stp_full_crc(const unsigned char *data,
+					unsigned int length)
+{
+	unsigned int crc = 0;
+	unsigned int i, bit;
+
+	for (i = 0; i < length; i++) {
+		crc ^= data[i];
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ ((crc & 1) ? 0xa001U : 0);
+	}
+	return crc;
+}
+
+/* Disjoint caller buffers. No output mutation on invalid arguments. */
+static inline int stp_full_encode(unsigned char *out, unsigned int capacity,
+				  const unsigned char *payload, unsigned int length,
+				  unsigned int task, unsigned int sequence,
+				  unsigned int acknowledgement)
+{
+	unsigned int crc, i;
+
+	if (!out || !payload || !length || length > STP_FULL_MAX_PAYLOAD ||
+	    !stp_full_task(task) || sequence > 7 || acknowledgement > 7 ||
+	    capacity < length + 6)
+		return -1;
+	crc = stp_full_crc(payload, length);
+	out[0] = 0x80 | (sequence << 3) | acknowledgement;
+	out[1] = (task << 4) | (length >> 8);
+	out[2] = length & 0xff;
+	out[3] = (out[0] + out[1] + out[2]) & 0xff;
+	for (i = 0; i < length; i++)
+		out[i + 4] = payload[i];
+	out[length + 4] = crc & 0xff;
+	out[length + 5] = crc >> 8;
+	return length + 6;
+}
+
+static inline int stp_full_ack(unsigned char *out, unsigned int capacity,
+			       unsigned int acknowledgement)
+{
+	if (!out || capacity < 4 || acknowledgement > 7)
+		return -1;
+	out[0] = 0x80 | acknowledgement;
+	out[1] = 0;
+	out[2] = 0;
+	out[3] = out[0];
+	return 4;
+}
+
+/*
+ * Checks ordinary full-mode headers only. NAK/resync/firmware-message traffic
+ * needs a separately reviewed path. Length changes only after acceptance.
+ */
+static inline int stp_full_header(const unsigned char *frame, unsigned int bytes,
+				  unsigned int *length)
+{
+	unsigned int n;
+
+	if (!frame || !length || bytes < 4 || (frame[0] & 0xc0) != 0x80 ||
+	    (frame[1] & 0x80) ||
+	    ((frame[0] + frame[1] + frame[2]) & 0xff) != frame[3])
+		return -1;
+	n = ((frame[1] & 15) << 8) | frame[2];
+	if ((!n && frame[1]) || n > STP_FULL_MAX_PAYLOAD ||
+	    (n && !stp_full_task((frame[1] >> 4) & 7)))
+		return -1;
+	*length = n;
+	return 0;
+}
+
+/*
+ * ACK=0, data=1, refusal=-1 with result unchanged. No link state mutation;
+ * payload aliases input. Owner validates shared sequence/ACK and task lifetime.
+ */
+static inline int stp_full_decode(const unsigned char *frame, unsigned int bytes,
+				  struct stp_full_frame *result)
+{
+	unsigned int length, crc;
+
+	if (!result || stp_full_header(frame, bytes, &length))
+		return -1;
+	if (bytes != (length ? length + 6 : 4))
+		return -1;
+	if (length) {
+		crc = frame[length + 4] | (frame[length + 5] << 8);
+		if (crc != stp_full_crc(frame + 4, length))
+			return -1;
+	}
+	result->sequence = (frame[0] >> 3) & 7;
+	result->acknowledgement = frame[0] & 7;
+	result->task = length ? (frame[1] >> 4) & 7 : STP_FULL_TASK_NONE;
+	result->length = length;
+	result->payload = length ? frame + 4 : 0;
+	return length ? 1 : 0;
+}
+#endif
