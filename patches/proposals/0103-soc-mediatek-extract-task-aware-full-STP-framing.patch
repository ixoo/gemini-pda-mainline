-	result->acknowledgement = frame[0] & 7;
-	result->length = length;
-	result->payload = length ? frame + 4 : 0;
-	return length ? 1 : 0;
+	kind = stp_full_decode(frame, bytes, &decoded);
+	if (kind < 0 || decoded.length > WMT_FULL_MAX_PAYLOAD ||
+	    (kind && decoded.task != STP_FULL_TASK_WMT))
+		return -1;
+	result->sequence = decoded.sequence;
+	result->acknowledgement = decoded.acknowledgement;
+	result->length = decoded.length;
+	result->payload = decoded.payload;
+	return kind;
 }
