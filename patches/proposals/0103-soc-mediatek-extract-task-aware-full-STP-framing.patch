 static inline int wmt_full_ack(unsigned char *out, unsigned int capacity,
 			       unsigned int acknowledgement)
 {
-	if (!out || capacity < 4 || acknowledgement > 7)
-		return -1;
-	out[0] = 0x80 | acknowledgement;
-	out[1] = 0;
-	out[2] = 0;
-	out[3] = out[0];
