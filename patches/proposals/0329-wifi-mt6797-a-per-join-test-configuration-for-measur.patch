diff --git a/drivers/net/wireless/mediatek/mt6797/testcfg-parse.h b/drivers/net/wireless/mediatek/mt6797/testcfg-parse.h
new file mode 100644
index 000000000..a25cd7f08
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/testcfg-parse.h
@@ -0,0 +1,189 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_TESTCFG_PARSE_H
+#define MT6797_TESTCFG_PARSE_H
+
+/* One join's test configuration (CONFIG_MT6797_WIFI_TESTCONFIG): the
+ * class-B variables only, each overriding the build for one association.
+ * Transmit side only: the advertised HT capability, the receive width and
+ * the join channel stay as built.
+ */
+struct mt6797_testcfg {
+	unsigned char rate;	/* the data descriptor's fixed rate code */
+	bool bw40;		/* FIX_BW_40, on an HT40 grant only */
+	bool sgi;		/* short GI, when the peer advertises it */
+	bool agg;		/* receive A-MPDU in the station record */
+	bool peek;		/* the WHISR peek before the status block */
+};
+
+#define MT6797_TESTCFG_ENTRIES 16U
+#define MT6797_TESTCFG_NAME 32U
+
+/* A schedule entry as written, with its verdict. */
+struct mt6797_testcfg_entry {
+	struct mt6797_testcfg cfg;
+	char name[MT6797_TESTCFG_NAME];
+	const char *refused;	/* NULL when valid */
+};
+
+static inline bool mt6797_testcfg_is(const char *s, size_t n, const char *word)
+{
+	size_t i;
+
+	for (i = 0; word[i]; i++)
+		if (i >= n || s[i] != word[i])
+			return false;
+	return i == n;
+}
+
+/* "x=0" or "x=1" for the word x; -1 when s is not that item. */
+static inline int mt6797_testcfg_flag(const char *s, size_t n, const char *word)
+{
+	size_t w = 0;
+
+	while (word[w])
+		w++;
+	if (n != w + 2 || s[w] != '=' || !mt6797_testcfg_is(s, w, word))
+		return -1;
+	return s[w + 1] == '0' ? 0 : s[w + 1] == '1' ? 1 : -1;
+}
+
+static inline int mt6797_testcfg_hex(char c)
+{
+	return c >= '0' && c <= '9' ? c - '0' :
+	       c >= 'a' && c <= 'f' ? c - 'a' + 10 :
+	       c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+}
+
+/* One item of an entry: 20M<k> or 40M<k> (HT MCS k at that transmit width),
+ * bw=20|40, rate=fixed:0xNN, sgi[=0|1], agg=0|1, peek=0|1, or default (the
+ * build). NULL on success, else why the item is refused.
+ */
+static inline const char *
+mt6797_testcfg_item(const char *s, size_t n, const struct mt6797_testcfg *base,
+		    struct mt6797_testcfg *c)
+{
+	int v;
+
+	if (n == 4 && (s[0] == '2' || s[0] == '4') && s[1] == '0' && s[2] == 'M' &&
+	    s[3] >= '0' && s[3] <= '7') {
+		c->bw40 = s[0] == '4';
+		c->rate = 0x80 | (s[3] - '0');
+		return NULL;
+	}
+	if (mt6797_testcfg_is(s, n, "default")) {
+		*c = *base;
+		return NULL;
+	}
+	if (mt6797_testcfg_is(s, n, "sgi")) {
+		c->sgi = true;
+		return NULL;
+	}
+	v = mt6797_testcfg_flag(s, n, "sgi");
+	if (v >= 0) {
+		c->sgi = v;
+		return NULL;
+	}
+	v = mt6797_testcfg_flag(s, n, "agg");
+	if (v >= 0) {
+		c->agg = v;
+		return NULL;
+	}
+	v = mt6797_testcfg_flag(s, n, "peek");
+	if (v >= 0) {
+		c->peek = v;
+		return NULL;
+	}
+	if (mt6797_testcfg_is(s, n, "bw=20") || mt6797_testcfg_is(s, n, "bw=40")) {
+		c->bw40 = s[3] == '4';
+		return NULL;
+	}
+	if (n > 13 && mt6797_testcfg_is(s, 13, "rate=fixed:0x")) {
+		int hi = mt6797_testcfg_hex(s[13]);
+		int lo = n == 15 ? mt6797_testcfg_hex(s[14]) : 0;
+
+		if (n > 15 || hi < 0 || lo < 0)
+			return "bad rate code";
+		v = n == 15 ? hi << 4 | lo : hi;
+		/* 0 is the firmware's selector, which needs 0277's state 2. */
+		if (!v)
+			return "rate code 0";
+		c->rate = v;
+		return NULL;
+	}
+	if (mt6797_testcfg_is(s, n, "rate=minstrel") ||
+	    (n >= 8 && mt6797_testcfg_is(s, 8, "minstrel")))
+		return "minstrel needs per-frame transmit status";
+	return "unknown item";
+}
+
+/* One entry: items joined by '+', applied over the build's configuration.
+ * NULL on success, else why it is refused; *c is then unspecified.
+ */
+static inline const char *
+mt6797_testcfg_entry(const char *s, size_t n, const struct mt6797_testcfg *base,
+		     struct mt6797_testcfg *c)
+{
+	const char *why;
+	size_t i = 0, j;
+
+	*c = *base;
+	if (!n)
+		return "empty entry";
+	while (i <= n) {
+		for (j = i; j < n && s[j] != '+'; j++)
+			;
+		if (j == i)
+			return "empty item";
+		why = mt6797_testcfg_item(s + i, j - i, base, c);
+		if (why)
+			return why;
+		i = j + 1;
+	}
+	return NULL;
+}
+
+static inline bool mt6797_testcfg_space(char c)
+{
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r';
+}
+
+/* A schedule: entries separated by ',', blanks around them ignored. An
+ * empty schedule has no entries (the build's configuration for every join).
+ * Every entry is kept with its verdict; a refused one is applied as the
+ * previous configuration. Returns the entry count, or -1 when there are
+ * more than MT6797_TESTCFG_ENTRIES or an entry's name does not fit.
+ */
+static inline int
+mt6797_testcfg_schedule(const char *s, size_t n, const struct mt6797_testcfg *base,
+			struct mt6797_testcfg_entry *out)
+{
+	size_t i = 0, j, a, b, k;
+	unsigned int count = 0;
+
+	while (n && mt6797_testcfg_space(s[n - 1]))
+		n--;
+	while (i < n && mt6797_testcfg_space(s[i]))
+		i++;
+	if (i == n)
+		return 0;
+	while (i <= n) {
+		for (j = i; j < n && s[j] != ','; j++)
+			;
+		for (a = i; a < j && mt6797_testcfg_space(s[a]); a++)
+			;
+		for (b = j; b > a && mt6797_testcfg_space(s[b - 1]); b--)
+			;
+		if (count == MT6797_TESTCFG_ENTRIES || b - a >= MT6797_TESTCFG_NAME)
+			return -1;
+		for (k = 0; k < b - a; k++)
+			out[count].name[k] = s[a + k];
+		out[count].name[k] = 0;
+		out[count].refused = mt6797_testcfg_entry(s + a, b - a, base,
+							  &out[count].cfg);
+		count++;
+		i = j + 1;
+	}
+	return count;
+}
+
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/testcfg.c b/drivers/net/wireless/mediatek/mt6797/testcfg.c
new file mode 100644
index 000000000..6fd8571d1
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/testcfg.c
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The per-join test surface (CONFIG_MT6797_WIFI_TESTCONFIG). The harness
+ * cycles the association; each join takes the next schedule entry, and each
+ * data phase end appends that lifetime's measurements. No device access.
+ */
+#include <linux/debugfs.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "testcfg.h"
+
+#define MT6797_TESTCFG_LINES 16U
+#define MT6797_TESTCFG_APPLIED 160U
+#define MT6797_TESTCFG_STATS 448U
+#define MT6797_TESTCFG_TEXT 512U
+
+struct mt6797_testcfg_state {
+	struct mutex lock;	/* everything below */
+	struct dentry *dir;
+	struct mt6797_testcfg build, last;
+	struct mt6797_testcfg_entry entries[MT6797_TESTCFG_ENTRIES];
+	unsigned int count, next, lifetime;
+	/* applied and not yet measured; the previous one not ok */
+	bool pending, recover;
+	char name[MT6797_TESTCFG_NAME];
+	char schedule[MT6797_TESTCFG_TEXT];
+	char applied[MT6797_TESTCFG_LINES][MT6797_TESTCFG_APPLIED];
+	char stats[MT6797_TESTCFG_LINES][MT6797_TESTCFG_STATS];
+	unsigned int applied_n, stats_n, dropped;
+};
+
+static void mt6797_testcfg_rewind(struct mt6797_testcfg_state *t)
+{
+	t->next = 0;
+	t->pending = false;
+	t->recover = false;
+	t->last = t->build;
+	t->applied_n = 0;
+	t->stats_n = 0;
+	t->dropped = 0;
+}
+
+void mt6797_testcfg_next(struct mt6797_testcfg_state *t, unsigned int lifetime,
+			 struct mt6797_testcfg *cfg, char *line, size_t bytes)
+{
+	const struct mt6797_testcfg_entry *e = NULL;
+	const char *source;
+	unsigned int index = 0;
+
+	mutex_lock(&t->lock);
+	/* A lifetime applied but never measured ended before its data phase. */
+	if (t->pending)
+		t->recover = true;
+	if (!t->count) {
+		*cfg = t->build;
+		source = "build";
+	} else if (t->recover) {
+		*cfg = t->build;
+		source = "recovery";
+	} else if (t->next >= t->count) {
+		*cfg = t->build;
+		source = "after-schedule";
+	} else {
+		index = t->next + 1;
+		e = &t->entries[t->next++];
+		*cfg = e->refused ? t->last : e->cfg;
+		source = e->refused ?: "schedule";
+	}
+	t->recover = false;
+	t->pending = true;
+	t->last = *cfg;
+	t->lifetime = lifetime;
+	strscpy(t->name, e ? e->name : "-", sizeof(t->name));
+	scnprintf(line, bytes,
+		  "lifetime=%u entry=%u config=%s rate=0x%02x bw=%u sgi=%u agg=%u peek=%u source=%s%s",
+		  lifetime, index, t->name, cfg->rate, cfg->bw40 ? 40 : 20, cfg->sgi,
+		  cfg->agg, cfg->peek, e && e->refused ? "refused:" : "", source);
+	if (t->applied_n < MT6797_TESTCFG_LINES)
+		strscpy(t->applied[t->applied_n++], line, MT6797_TESTCFG_APPLIED);
+	else
+		t->dropped++;
+	mutex_unlock(&t->lock);
+}
+
+const char *mt6797_testcfg_stats(struct mt6797_testcfg_state *t, const char *body,
+				 bool ok)
+{
+	char *line = NULL;
+
+	mutex_lock(&t->lock);
+	if (t->pending) {
+		t->pending = false;
+		t->recover = !ok;
+		if (t->stats_n < MT6797_TESTCFG_LINES) {
+			line = t->stats[t->stats_n++];
+			scnprintf(line, MT6797_TESTCFG_STATS,
+				  "lifetime=%u config=%s ok=%u %s", t->lifetime,
+				  t->name, ok, body);
+		} else {
+			t->dropped++;
+		}
+	}
+	mutex_unlock(&t->lock);
+	return line;
+}
+
+/* The file's text, composed under the lock; read in one or more pieces. */
+static ssize_t mt6797_testcfg_read(struct file *file, char __user *buf,
+				   size_t size, loff_t *pos)
+{
+	struct mt6797_testcfg_state *t = file->private_data;
+	const char *name = file->f_path.dentry->d_name.name;
+	size_t cap = MT6797_TESTCFG_LINES * MT6797_TESTCFG_STATS + 64;
+	unsigned int i;
+	size_t n = 0;
+	ssize_t ret;
+	char *text;
+
+	text = kmalloc(cap, GFP_KERNEL);
+	if (!text)
+		return -ENOMEM;
+	mutex_lock(&t->lock);
+	if (!strcmp(name, "testcfg")) {
+		n = scnprintf(text, cap, "%s\nentries=%u next=%u\n", t->schedule,
+			      t->count, t->next);
+		for (i = 0; i < t->count; i++)
+			if (t->entries[i].refused)
+				n += scnprintf(text + n, cap - n, "entry=%u config=%s refused=%s\n",
+					       i + 1, t->entries[i].name, t->entries[i].refused);
+	} else if (!strcmp(name, "applied")) {
+		for (i = 0; i < t->applied_n; i++)
+			n += scnprintf(text + n, cap - n, "%s\n", t->applied[i]);
+	} else {
+		for (i = 0; i < t->stats_n; i++)
+			n += scnprintf(text + n, cap - n, "%s\n", t->stats[i]);
+		if (t->dropped)
+			n += scnprintf(text + n, cap - n, "dropped=%u\n", t->dropped);
+	}
+	mutex_unlock(&t->lock);
+	ret = simple_read_from_buffer(buf, size, pos, text, n);
+	kfree(text);
+	return ret;
+}
+
+/* A whole schedule, started at its first entry; the previous one stays
+ * if this one does not fit. Returns the entry count or an error.
+ */
+int mt6797_testcfg_set(struct mt6797_testcfg_state *t, char *text)
+{
+	struct mt6797_testcfg_entry *entries;
+	size_t size = strlen(text);
+	int count;
+
+	if (size >= MT6797_TESTCFG_TEXT)
+		return -EINVAL;
+	entries = kcalloc(MT6797_TESTCFG_ENTRIES, sizeof(*entries), GFP_KERNEL);
+	if (!entries)
+		return -ENOMEM;
+	count = mt6797_testcfg_schedule(text, size, &t->build, entries);
+	if (count >= 0) {
+		mutex_lock(&t->lock);
+		memcpy(t->entries, entries, sizeof(t->entries));
+		t->count = count;
+		t->next = 0;
+		strscpy(t->schedule, strim(text), sizeof(t->schedule));
+		mutex_unlock(&t->lock);
+	}
+	kfree(entries);
+	return count < 0 ? -EINVAL : count;
+}
+
+/* testcfg takes a whole schedule; reset clears applied and stats and
+ * starts the schedule again.
+ */
+static ssize_t mt6797_testcfg_write(struct file *file, const char __user *buf,
+				    size_t size, loff_t *pos)
+{
+	struct mt6797_testcfg_state *t = file->private_data;
+	char *text;
+	int ret;
+
+	if (*pos || size >= MT6797_TESTCFG_TEXT)
+		return -EINVAL;
+	if (strcmp(file->f_path.dentry->d_name.name, "testcfg")) {
+		mutex_lock(&t->lock);
+		mt6797_testcfg_rewind(t);
+		mutex_unlock(&t->lock);
+		return size;
+	}
+	text = memdup_user_nul(buf, size);
+	if (IS_ERR(text))
+		return PTR_ERR(text);
+	ret = mt6797_testcfg_set(t, text);
+	kfree(text);
+	if (ret < 0)
+		return ret;
+	return size;
+}
+
+static const struct file_operations mt6797_testcfg_ops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = mt6797_testcfg_read,
+	.write = mt6797_testcfg_write,
+	.llseek = default_llseek,
+};
+
+struct mt6797_testcfg_state *mt6797_testcfg_register(const struct mt6797_testcfg *build)
+{
+	struct mt6797_testcfg_state *t;
+
+	t = kzalloc_obj(*t, GFP_KERNEL);
+	if (!t)
+		return ERR_PTR(-ENOMEM);
+	mutex_init(&t->lock);
+	t->build = *build;
+	mt6797_testcfg_rewind(t);
+	t->dir = debugfs_create_dir("mt6797_wifi", NULL);
+	debugfs_create_file("testcfg", 0600, t->dir, t, &mt6797_testcfg_ops);
+	debugfs_create_file("applied", 0400, t->dir, t, &mt6797_testcfg_ops);
+	debugfs_create_file("stats", 0400, t->dir, t, &mt6797_testcfg_ops);
+	debugfs_create_file("reset", 0200, t->dir, t, &mt6797_testcfg_ops);
+	return t;
+}
+
+void mt6797_testcfg_unregister(struct mt6797_testcfg_state *t)
+{
+	if (IS_ERR_OR_NULL(t))
+		return;
+	debugfs_remove_recursive(t->dir);
+	kfree(t);
+}
