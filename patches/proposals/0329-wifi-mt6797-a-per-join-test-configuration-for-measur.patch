From 661ecc08490e85bc45cc1091b5130deb70bbcb28 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 26 Oct 2026 19:56:13 -0400
Subject: [PATCH] wifi: mt6797: a per-join test configuration for measurement
 builds

Each comparison of a transmit or receive variable has cost one boot:
build, boot2 write, the owner's selection, one measured lifetime and
the return. The lifecycle harness already cycles the association within
one boot (disconnect, teardown, rearm, rejoin). Let each lifetime run
its own configuration, so that one boot measures a whole matrix.

CONFIG_MT6797_WIFI_TESTCONFIG adds /sys/kernel/debug/mt6797_wifi:
- testcfg takes a comma-separated schedule. Each join takes the next
  entry at its channel grant. An entry is items joined by '+':
  - 20M<k> or 40M<k>: HT MCS k at that transmit width;
  - bw=20|40;
  - rate=fixed:0xNN;
  - sgi[=0|1];
  - agg=0|1: receive A-MPDU in the state-3 station record;
  - peek=0|1: the WHISR peek;
  - default.
  Each entry applies over the build's configuration.
- applied holds one line per lifetime: the entry, the resolved values
  and their source. The same line is logged at the grant.
- stats holds one line per lifetime, appended and logged at the data
  phase end:
  - frames and Mbit/s each way over the data phase;
  - the first three sampled transmit rate words;
  - first-attempt completions;
  - refused receive frames;
  - the reorder window's held, released, timeouts and holes;
  - the worker's cost per pass;
  - the ledger.
- reset clears applied and stats and restarts the schedule.

CONFIG_MT6797_WIFI_TESTCONFIG_SCHEDULE seeds the schedule at probe and
logs it. One build can then carry its whole matrix, with no write from
the device side.

Only the transmit side changes. The advertised HT capability, the
receive width and the join channel stay as built. The entry's rate
code replaces the build's in the ordinary data descriptor (bytes 11,
26-27). The width (byte 25) and the guard interval (byte 27 bit 7)
follow it, at an HT40 grant and when the peer advertises short GI.

The rules keep a typo or a failed lifetime from voiding a boot:
- An empty schedule is the build throughout.
- A refused entry is logged with its reason and keeps the previous
  configuration.
- A lifetime that did not end by disconnect with a clean ledger, or
  that was never measured, is followed by one at the build's
  configuration, and the waiting entry runs after it.
- Rate code 0 is refused, because the firmware's selector needs the
  state-2 record. Minstrel is refused, because ordinary data frames
  carry no per-frame transmit status.

The option also turns on the per-phase cost, transmit rate-word and
attempt, and receive rate-word records, which lose their own prompts.
With it off there is no debugfs directory and none of those records.
It depends on HT40 transmit, receive aggregation, the WHISR peek and
credit retirement. Short GI on ordinary data is compiled in when
either CONFIG_MT6797_HT_SGI_TX or this option is set.
---
 drivers/net/wireless/mediatek/mt6797/Kconfig  |  46 +++-
 drivers/net/wireless/mediatek/mt6797/Makefile |   1 +
 drivers/net/wireless/mediatek/mt6797/hif.c    |  63 ++++-
 drivers/net/wireless/mediatek/mt6797/hif.h    |  14 +-
 drivers/net/wireless/mediatek/mt6797/mac.c    | 186 +++++++++++++-
 .../wireless/mediatek/mt6797/testcfg-parse.h  | 189 ++++++++++++++
 .../net/wireless/mediatek/mt6797/testcfg.c    | 237 ++++++++++++++++++
 .../net/wireless/mediatek/mt6797/testcfg.h    |  28 +++
 8 files changed, 739 insertions(+), 25 deletions(-)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/testcfg-parse.h
 create mode 100644 drivers/net/wireless/mediatek/mt6797/testcfg.c
 create mode 100644 drivers/net/wireless/mediatek/mt6797/testcfg.h

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index f44aa1600..e00c06ab1 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -107,8 +107,38 @@ config MT6797_HIF_RX_PEEK
 	  firmware-assert (bit 31) bits fail the HIF here as they do in the
 	  block.
 
+config MT6797_WIFI_TESTCONFIG
+	bool "MT6797 Wi-Fi measurement build: per-join test configuration and records"
+	depends on MT6797_STATION_JOIN && DEBUG_FS && MT6797_HT40_TX && \
+		   MT6797_RX_AMPDU && MT6797_HIF_RX_PEEK && MT6797_DATA_CREDIT_RETIRE
+	help
+	  A measurement build. /sys/kernel/debug/mt6797_wifi holds testcfg, a
+	  comma-separated schedule of which each join takes the next entry,
+	  and applied and stats, one line per lifetime; writing reset clears
+	  them and starts the schedule again. An entry is items joined by
+	  '+': 20M<k> or 40M<k> (HT MCS k at that transmit width), bw=20|40,
+	  rate=fixed:0xNN, sgi[=0|1], agg=0|1 (receive A-MPDU), peek=0|1 or
+	  default, each over the build's configuration. Transmit side only:
+	  the advertised HT capability and the receive width stay as built.
+	  An empty schedule is the build throughout; a refused entry keeps the
+	  previous configuration, and a lifetime that did not end cleanly is
+	  followed by one at the build's. It also turns on the per-phase cost,
+	  transmit rate-word and attempt, and receive rate records. Off for
+	  normal use: no debugfs directory and none of those records.
+
+config MT6797_WIFI_TESTCONFIG_SCHEDULE
+	string "MT6797 Wi-Fi measurement build: the schedule at boot"
+	depends on MT6797_WIFI_TESTCONFIG
+	default ""
+	help
+	  The testcfg schedule the driver starts with, as if written before
+	  the first join, so that one build carries its whole matrix with no
+	  write from the device side. Empty is the build's configuration
+	  throughout; a schedule that does not fit is logged and left empty.
+
 config MT6797_PASS_COST_RECORD
-	bool "MT6797 Wi-Fi diagnostic: record the worker's cost per phase"
+	bool
+	default MT6797_WIFI_TESTCONFIG
 	depends on MT6797_STATION_JOIN
 	help
 	  Accumulate, for every worker pass that starts in the data phase, the
@@ -117,7 +147,7 @@ config MT6797_PASS_COST_RECORD
 	  (and, within it, the time inside the HIF receive call), the
 	  transmit completions handed to mac80211, and the receive delivery
 	  to mac80211. Printed once when the data phase ends. A measurement
-	  for the per-frame cost; off for normal use.
+	  for the per-frame cost, on with CONFIG_MT6797_WIFI_TESTCONFIG.
 
 config MT6797_DIAG_DROP_ASSOC_RESP_LIFETIME
 	int "MT6797 Wi-Fi diagnostic: drop the first association response of one lifetime"
@@ -133,16 +163,19 @@ config MT6797_DIAG_DROP_ASSOC_RESP_LIFETIME
 	  disables it; a diagnostic, never for normal use.
 
 config MT6797_RX_RATE_RECORD
-	bool "MT6797 Wi-Fi: record the received rate word (logging only)"
+	bool
+	default MT6797_WIFI_TESTCONFIG
 	help
 	  Count the receive vector's mode and rate of every queued data frame
 	  and print the distinct values at the data-phase end. The rate the
 	  access point sends toward this station, which decides whether a
 	  receive ceiling is the path or the station's own capability
-	  advertisement. No behaviour changes.
+	  advertisement. No behaviour changes. On with
+	  CONFIG_MT6797_WIFI_TESTCONFIG.
 
 config MT6797_TX_DONE_RATE_RECORD
-	bool "MT6797 Wi-Fi: record the firmware rate words of the data phase (per-phase histogram)"
+	bool
+	default MT6797_WIFI_TESTCONFIG
 	depends on MT6797_STATION_JOIN
 	help
 	  Count every ordinary data completion by its status and the rate word
@@ -151,7 +184,8 @@ config MT6797_TX_DONE_RATE_RECORD
 	  per-frame line. Says what rate the firmware sent at, within the
 	  sealed logger's byte cap at any chunk count. The same completions'
 	  attempt counts (ucTxCount) print as a second histogram, the air
-	  retries of the sampled frames. Logging only.
+	  retries of the sampled frames. Logging only; on with
+	  CONFIG_MT6797_WIFI_TESTCONFIG.
 
 config MT6797_DATA_FIXED_RATE_CODE
 	hex "MT6797 Wi-Fi: fixed rate code of ordinary data descriptors"
diff --git a/drivers/net/wireless/mediatek/mt6797/Makefile b/drivers/net/wireless/mediatek/mt6797/Makefile
index 25cbb2521..aecbc5628 100644
--- a/drivers/net/wireless/mediatek/mt6797/Makefile
+++ b/drivers/net/wireless/mediatek/mt6797/Makefile
@@ -13,3 +13,4 @@ obj-y += firmware-probe.o
 obj-y += record-prepare.o
 obj-$(CONFIG_MT6797_MAC80211) += mac.o
 obj-$(CONFIG_MT6797_MAC80211) += snapshot.o
+obj-$(CONFIG_MT6797_WIFI_TESTCONFIG) += testcfg.o
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index dd8294790..b4e8aa76a 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -84,8 +84,13 @@ struct mt6797_hif {
 #ifdef CONFIG_MT6797_HT40_TX
 	bool data_bw40;	/* under the mutex (0324) */
 #endif
-#ifdef CONFIG_MT6797_HT_SGI_TX
+#ifdef MT6797_DATA_SGI
 	bool data_sgi;	/* under the mutex (0327) */
+#endif
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	/* This join's test configuration, under the mutex. */
+	u8 data_rate;
+	bool rx_ampdu, rx_peek;
 #endif
 	/* Receive batching (0268): the enhanced status block read once per
 	 * worker pass, the aggregated data-port read per queue it names, and
@@ -270,9 +275,27 @@ struct mt6797_hif *mt6797_hif_alloc(void __iomem *base, size_t span,
 		.read = mt6797_hif_read,
 	};
 	mutex_init(&hif->mutex);
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	hif->data_rate = MT6797_DATA_FIXED_RATE_CODE;
+	hif->rx_ampdu = true;
+	hif->rx_peek = true;
+#endif
 	return hif;
 }
 
+/* The ordinary data rate code, receive A-MPDU and the WHISR peek: this
+ * join's in a measurement build, else the build's.
+ */
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+#define mt6797_hif_data_rate(hif) ((hif)->data_rate)
+#define mt6797_hif_rx_ampdu(hif) ((hif)->rx_ampdu)
+#define mt6797_hif_rx_peek(hif) ((hif)->rx_peek)
+#else
+#define mt6797_hif_data_rate(hif) ((void)(hif), MT6797_DATA_FIXED_RATE_CODE)
+#define mt6797_hif_rx_ampdu(hif) ((void)(hif), true)
+#define mt6797_hif_rx_peek(hif) ((void)(hif), true)
+#endif
+
 void mt6797_hif_free(struct mt6797_hif *hif)
 {
 	if (hif && hif->dma) {
@@ -569,7 +592,7 @@ static int mt6797_hif_rx_batch_fill(struct mt6797_hif *hif)
 	int error;
 
 #ifdef CONFIG_MT6797_HIF_RX_PEEK
-	{
+	if (mt6797_hif_rx_peek(hif)) {
 		u32 whisr;
 
 		/* WHISR alone first (0322): its done bits are read-only and
@@ -1463,8 +1486,10 @@ int mt6797_hif_join_station_qos(struct mt6797_hif *hif, unsigned int sequence,
 		 * FEATURE_OPT_CMD_ENABLED (77, 2) and the vendor's HT ucRxBaSize
 		 * 64 (93), as cnm_mem.c sends them.
 		 */
-		payload[77] = 2;
-		payload[93] = 64;
+		if (mt6797_hif_rx_ampdu(hif)) {
+			payload[77] = 2;
+			payload[93] = 64;
+		}
 #endif
 	}
 	return mt6797_hif_send_join_command(hif, 0x13, sequence, payload,
@@ -1712,16 +1737,24 @@ int mt6797_hif_send_data_report(struct mt6797_hif *hif, const u8 *frame,
 						&command);
 	if (error)
 		goto unlock;
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	/* This join's rate code over the build's: the fixed-rate bit (byte
+	 * 11) and u2FixedRate (bytes 26-27).
+	 */
+	hif->scratch[11] = hif->data_rate ? 0x80 : 0;
+	hif->scratch[26] = (hif->data_rate << 2) & 255;
+	hif->scratch[27] = (hif->data_rate << 2) >> 8;
+#endif
 #ifdef CONFIG_MT6797_HT40_TX
 	/* DW6 byte 25: the fixed rate's bandwidth, FIX_BW_40 (0324). */
-	if (hif->data_bw40 && MT6797_DATA_FIXED_RATE_CODE)
+	if (hif->data_bw40 && mt6797_hif_data_rate(hif))
 		hif->scratch[25] = 5;
 #endif
-#ifdef CONFIG_MT6797_HT_SGI_TX
+#ifdef MT6797_DATA_SGI
 	/* DW6 byte 27 bit 7: u2FixedRate's guard interval, for an HT mixed
 	 * mode fixed rate only (0327).
 	 */
-	if (hif->data_sgi && ((MT6797_DATA_FIXED_RATE_CODE >> 6) & 7) == 2)
+	if (hif->data_sgi && ((mt6797_hif_data_rate(hif) >> 6) & 7) == 2)
 		hif->scratch[27] |= 0x80;
 #endif
 	error = mt6797_hif_enter(hif, deadline_ns);
@@ -1742,7 +1775,7 @@ int mt6797_hif_send_data_report(struct mt6797_hif *hif, const u8 *frame,
 	return error;
 }
 
-#ifdef CONFIG_MT6797_HT_SGI_TX
+#ifdef MT6797_DATA_SGI
 void mt6797_hif_set_data_sgi(struct mt6797_hif *hif, bool sgi)
 {
 	if (!hif)
@@ -1753,6 +1786,20 @@ void mt6797_hif_set_data_sgi(struct mt6797_hif *hif, bool sgi)
 }
 #endif
 
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+void mt6797_hif_set_testcfg(struct mt6797_hif *hif, unsigned int rate, bool agg,
+			    bool peek)
+{
+	if (!hif)
+		return;
+	mutex_lock(&hif->mutex);
+	hif->data_rate = rate;
+	hif->rx_ampdu = agg;
+	hif->rx_peek = peek;
+	mutex_unlock(&hif->mutex);
+}
+#endif
+
 #ifdef CONFIG_MT6797_HT40_TX
 void mt6797_hif_set_data_bw40(struct mt6797_hif *hif, bool bw40)
 {
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index 2243e72b8..cd818119e 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -11,6 +11,13 @@
 #include "hif_ordinary_section.h"
 #include "normal_command.h"
 
+/* Short GI on ordinary data: by the peer's capability (0327), or per join
+ * in a measurement build.
+ */
+#if defined(CONFIG_MT6797_HT_SGI_TX) || defined(CONFIG_MT6797_WIFI_TESTCONFIG)
+#define MT6797_DATA_SGI
+#endif
+
 struct mt6797_hif;
 
 struct mt6797_hif_section_request {
@@ -336,10 +343,15 @@ int mt6797_hif_send_data(struct mt6797_hif *hif, const u8 *frame,
 /* Ordinary data descriptors carry the fixed-rate bandwidth FIX_BW_40 (0324). */
 void mt6797_hif_set_data_bw40(struct mt6797_hif *hif, bool bw40);
 #endif
-#ifdef CONFIG_MT6797_HT_SGI_TX
+#ifdef MT6797_DATA_SGI
 /* Ordinary data descriptors with an HT fixed rate set the short GI bit (0327). */
 void mt6797_hif_set_data_sgi(struct mt6797_hif *hif, bool sgi);
 #endif
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+/* This join's data rate code, receive A-MPDU and WHISR peek. */
+void mt6797_hif_set_testcfg(struct mt6797_hif *hif, unsigned int rate, bool agg,
+			    bool peek);
+#endif
 int mt6797_hif_send_data_report(struct mt6797_hif *hif, const u8 *frame,
 				size_t frame_bytes, u8 wlan, u8 pid,
 				bool status_report,
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 740429ed4..faaa5da04 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -12,6 +12,9 @@
 #include <net/mac80211.h>
 
 #include "snapshot.h"
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+#include "testcfg.h"
+#endif
 #include "hif.h"
 #include "mac.h"
 #include "record-prepare.h"
@@ -353,6 +356,15 @@ struct mt6797_mac {
 	u8 join_sco;
 	/* This lifetime's data with the short guard interval (0327). */
 	bool join_data_sgi;
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	/* The per-join test surface, this lifetime's configuration (applied
+	 * at its channel grant), and the data bytes the driver moved.
+	 */
+	struct mt6797_testcfg_state *testcfg;
+	struct mt6797_testcfg testcfg_now;
+	u8 testcfg_lifetime;
+	u64 testcfg_tx_bytes, testcfg_rx_bytes;
+#endif
 	bool join_scan_ready, join_peer_used, join_peer_ready;
 	bool join_auth_received, join_auth_ok, join_authenticated;
 	bool join_assoc_received;
@@ -1590,6 +1602,10 @@ static void mt6797_ccmp_receive(struct mt6797_mac *mac, struct sk_buff *skb)
 	}
 	if (ready)
 		mac->ccmp_rx_delivered++;
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	if (ready)
+		mac->testcfg_rx_bytes += skb->len;
+#endif
 #ifdef CONFIG_MT6797_DATA_PHASE_SERIES
 	if (ready && ethernet) {
 		u64 now = ktime_get_ns();
@@ -2315,6 +2331,60 @@ static void mt6797_mac_epoch_reset(struct mt6797_mac *mac)
 	mac->ccmp_key_disables = 0;
 }
 
+/* This lifetime's data width and receive A-MPDU: the build's, narrowed by
+ * the per-join test configuration in a measurement build.
+ */
+static bool __maybe_unused mt6797_mac_data_bw40(const struct mt6797_mac *mac)
+{
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	if (!mac->testcfg_now.bw40)
+		return false;
+#endif
+	return IS_ENABLED(CONFIG_MT6797_HT40_TX) && mac->join_sco == 3;
+}
+
+static bool __maybe_unused mt6797_mac_rx_ampdu(const struct mt6797_mac *mac)
+{
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	if (!mac->testcfg_now.agg)
+		return false;
+#endif
+	return IS_ENABLED(CONFIG_MT6797_RX_AMPDU);
+}
+
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+static void mt6797_mac_testcfg_build(struct mt6797_testcfg *c)
+{
+	*c = (struct mt6797_testcfg){
+		.rate = MT6797_DATA_FIXED_RATE_CODE,
+		.bw40 = true,
+		.sgi = IS_ENABLED(CONFIG_MT6797_HT_SGI_TX),
+		.agg = true,
+		.peek = true,
+	};
+}
+
+/* Once per lifetime, at its channel grant: the next schedule entry. */
+static void mt6797_mac_testcfg_apply(struct mt6797_mac *mac)
+{
+	char line[160];
+
+	if (mac->testcfg_lifetime == mac->join_lifetimes)
+		return;
+	mac->testcfg_lifetime = mac->join_lifetimes;
+	if (mac->testcfg) {
+		mt6797_testcfg_next(mac->testcfg, mac->join_lifetimes,
+				    &mac->testcfg_now, line, sizeof(line));
+	} else {
+		mt6797_mac_testcfg_build(&mac->testcfg_now);
+		strscpy(line, "no test surface: the build", sizeof(line));
+	}
+	mt6797_hif_set_testcfg(mac->hif, mac->testcfg_now.rate,
+			       mac->testcfg_now.agg, mac->testcfg_now.peek);
+	dev_info(wiphy_dev(mac->hw->wiphy), "one-shot WLAN testcfg: %s\n", line);
+}
+#endif
+
 static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 {
 	unsigned long flags;
@@ -2398,6 +2468,10 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_data_rx_group = 0;
 	mac->join_data_rx_dropped = 0;
 	mac->ccmp_rx_delivered = 0;
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	mac->testcfg_tx_bytes = 0;
+	mac->testcfg_rx_bytes = 0;
+#endif
 	mac->ccmp_queued_beyond = 0;
 	memset(mac->tx_latency, 0, sizeof(mac->tx_latency));
 	mac->tx_latency_n = 0;
@@ -2919,11 +2993,14 @@ static int mt6797_mac_join_control_event(struct mt6797_mac *mac, size_t bytes)
 			ktime_get_ns() + (u64)interval * NSEC_PER_MSEC);
 #endif
 		complete_all(&mac->join_channel_done);
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+		mt6797_mac_testcfg_apply(mac);
+#endif
 #ifdef CONFIG_MT6797_HT40_TX
 		/* This lifetime's data at 40 MHz only on the HT40 grant (0324). */
-		mt6797_hif_set_data_bw40(mac->hif, mac->join_sco == 3);
+		mt6797_hif_set_data_bw40(mac->hif, mt6797_mac_data_bw40(mac));
 #endif
-#ifdef CONFIG_MT6797_HT_SGI_TX
+#ifdef MT6797_DATA_SGI
 		/* No short GI until the peer's HT capability says so (0327). */
 		mac->join_data_sgi = false;
 		mt6797_hif_set_data_sgi(mac->hif, false);
@@ -3733,6 +3810,58 @@ static void mt6797_native_diag_step(struct mt6797_mac *mac)
 }
 #endif
 
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+/* The lifetime's measurements as far as the driver sees them, over its data
+ * phase: frames and Mbit/s each way, the first three sampled rate words,
+ * first-attempt completions, refused receive frames, the reorder window, the
+ * worker's cost per pass and the ledger. A lifetime is ok when it ended by
+ * disconnect with nothing failed, expired, faulted or left.
+ */
+static void mt6797_mac_testcfg_stats(struct mt6797_mac *mac, const char *reason)
+{
+	u64 ns = max_t(u64, ktime_get_ns() - mac->join_data_started, 1);
+	u64 tx = div64_u64(mac->testcfg_tx_bytes * 800000ULL, ns);
+	u64 rx = div64_u64(mac->testcfg_rx_bytes * 800000ULL, ns);
+	u64 cost = mac->cost_ns[MT6797_COST_STATUS] + mac->cost_ns[MT6797_COST_SUBMIT] +
+		   mac->cost_ns[MT6797_COST_RECEIVE] +
+		   mac->cost_ns[MT6797_COST_COMPLETION] +
+		   mac->cost_ns[MT6797_COST_DELIVERY];
+	unsigned int k, tid, attempts = 0, holes = 0;
+	char rates[72], body[384];
+	const char *line;
+	size_t n = 0;
+	bool ok;
+
+	if (!mac->testcfg)
+		return;
+	for (k = 0; k < 3 && k < ARRAY_SIZE(mac->tx_rates) && mac->tx_rates[k].count; k++)
+		n += scnprintf(rates + n, sizeof(rates) - n, "%s%u/0x%04x=%u",
+			       k ? "," : "", mac->tx_rates[k].key >> 16,
+			       mac->tx_rates[k].key & 0xffff, mac->tx_rates[k].count);
+	for (k = 0; k < ARRAY_SIZE(mac->tx_attempts); k++)
+		attempts += mac->tx_attempts[k];
+	for (tid = 0; tid < MT6797_RX_REORDER_TIDS; tid++)
+		holes += mac->rx_reorder[tid].holes;
+	ok = !strcmp(reason, "disconnect") && !mac->join_data_tx_failed &&
