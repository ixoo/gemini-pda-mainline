From 55c7a090aa470e7b88d56d7de73b195fcdcf21d4 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 24 Oct 2026 12:38:03 -0400
Subject: [PATCH] wifi: mt6797: serve the receive port before submission in a
 busy pass

Proposal 0236 submits every admissible data frame, up to the in-flight
depth, before the pass runs its receive loop, so a busy pass serves
transmit first and receive with what remains. The RX re-baseline measured
the cost: receive throughput fell from 9.9-10.0 Mbit/s before 0236 to
7.0-7.6 Mbit/s on four boots with it (device-side 16-18 to 10.5-14 Mbit/s
per chunk), while transmit rose from 1.2 to 3.2 Mbit/s.

When the previous pass's receive loop delivered frames, drain the receive
port first and submit afterwards in the same pass; otherwise the pass is
unchanged. Depth, the page budget, the credit model and the admission are
untouched; only the order inside a busy pass moves. The passes that served
receive first are counted and printed with the data-end record so the
measurement can see how often the reorder engaged. One variable for one
boot, graded in both directions against 6.99 and 3.198 Mbit/s.

Compile-tested in the development VM, strict checkpatch clean. Not yet
run on the device.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 32 ++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 3cdc3eb82..89d5e18ef 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -240,6 +240,12 @@ struct mt6797_mac {
 	unsigned int ccmp_key_disables;
 	/* Scans that mac80211 never followed with a join; boot-scoped. */
 	unsigned int join_idle_scans;
+	/* The last pass's receive loop delivered frames: the next pass serves
+	 * the receive port before it submits (proposal 0256). Passes that did
+	 * so are counted for the data-end record.
+	 */
+	bool join_rx_busy;
+	unsigned int join_rx_first_passes;
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
 	/* Copied stack state only: no BSS/STA/chanctx pointer is retained. */
 	u8 join_bssid[ETH_ALEN];
@@ -1690,6 +1696,8 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_data_tx_failed = 0;
 	mac->join_data_tx_failures_in_row = 0;
 	mac->join_data_expired = 0;
+	mac->join_rx_busy = false;
+	mac->join_rx_first_passes = 0;
 	mac->join_inflight_data = false;
 	mac->join_last_acked = false;
 	mac->join_credit_pending = false;
@@ -2804,6 +2812,9 @@ static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 		 mac->join_data_rx_unicast, mac->join_data_rx_group, mac->join_data_rx_dropped,
 		 mac->join_data_tx_queued, mac->join_data_tx_done, mac->join_data_tx_failed,
 		 mac->join_data_credits);
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join RX-first passes: count=%u\n",
+		 mac->join_rx_first_passes);
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
 	if (ccmp_stable_epoch)
 		dev_info(wiphy_dev(mac->hw->wiphy),
@@ -3219,6 +3230,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 #endif
 	bool running, ack = false, completed_internal = false, select;
 	unsigned int submits = 0;
+	bool rx_first = false, rx_resume = false;
 #ifdef CONFIG_MT6797_CCMP_TX_PUMP
 	bool pump_progress = false;
 #endif
@@ -3433,8 +3445,22 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	channel_release_holds_tx = ret;
 	ret = 0;
 #endif
+	/* 0236 submits every admissible data frame before the receive loop, so
+	 * a busy pass serves transmit first and receive with what remains; the
+	 * RX re-baseline measured that at about 30 % of receive throughput.
+	 * When the previous pass received frames, drain the receive port first
+	 * and submit afterwards. Depth, page budget, credit and admission are
+	 * unchanged; only the order inside the pass moves.
+	 */
+	rx_first = mac->join_rx_busy && mac->join_data_phase && !mac->join_data_ended;
 select_more:
 	branch = 3;
+	if (rx_first) {
+		rx_first = false;
+		rx_resume = true;
+		mac->join_rx_first_passes++;
+		goto receive;
+	}
 	select = !mac->join_inflight && !mac->join_page_debt;
 #ifdef CONFIG_MT6797_CCMP_CHANNEL_RELEASE
 	if (channel_release_holds_tx)
@@ -3655,6 +3681,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 			}
 		}
 	}
+receive:
 	for (n = 0; n < 8; n++) {
 		bool got = false;
 #ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
@@ -4454,6 +4481,11 @@ static void mt6797_mac_join_work(struct work_struct *work)
 		if (!got)
 			break;
 	}
+	mac->join_rx_busy = !skb_queue_empty(&received);
+	if (rx_resume) {
+		rx_resume = false;
+		goto select_more;
+	}
 	ret = mt6797_snapshot_tick(mac->snapshot);
 	if (ret)
 		goto failed;
-- 
