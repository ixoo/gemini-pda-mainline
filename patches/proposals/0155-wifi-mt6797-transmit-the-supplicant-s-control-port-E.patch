index a06e02f54..b125a8b1a 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-tx.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-tx.h
@@ -59,4 +59,56 @@ mt6797_join_tx_descriptor(const unsigned char *frame, size_t bytes,
 	*pages = (total + 127U) / 128U;
 	return true;
 }
+
+#define MT6797_JOIN_ETH_MAX_BYTES 1518U
+
+/* Original encoder from the pinned public gen3 nicTxComposeSecurityFrameDesc
+ * path: one Ethernet II EAPOL frame on the same TC4 owner, header format
+ * non-802.11 with the Ethernet II flag, Ethernet-type offset after the
+ * descriptor and the 12 address bytes, TID 0, the station's WLAN index,
+ * own-MAC index 1, the bounded lifetime and attempt count, the fixed OFDM
+ * 6 Mbps rate and a PID with TX status to the MCU. The firmware builds the
+ * 802.11 header; no sequence number, type or subtype is encoded. No
+ * transport, station lifetime, destination or channel admission here.
+ */
+static inline bool
+mt6797_join_tx_security_descriptor(const unsigned char *frame, size_t bytes,
+				   unsigned char wlan, unsigned char pid,
+				   unsigned int lifetime_ms, unsigned int attempt_count,
+				   unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+				   unsigned int *pages)
+{
+	unsigned char d[MT6797_JOIN_TX_DESC_BYTES] = {0};
+	unsigned int lifetime, total, count, i;
+
+	if (!frame || !output || !pages || bytes < 14 + 4 ||
+	    bytes > MT6797_JOIN_ETH_MAX_BYTES || wlan > 30 || !pid || pid > 127 ||
+	    !lifetime_ms || lifetime_ms > 10000 || !attempt_count || attempt_count > 30)
+		return false;
+	/* Unicast Ethernet II EAPOL only: no group destination or source. */
+	if ((frame[0] & 1) || (frame[6] & 1) || frame[12] != 0x88 || frame[13] != 0x8e)
+		return false;
+	lifetime = (lifetime_ms * 1000U / 1024U) >> 5;
+	if (!lifetime)
+		lifetime = 1;
+	if (lifetime > 255)
+		lifetime = 255;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	count = attempt_count << 11;
+	d[0] = total; d[1] = total >> 8;
+	d[2] = (MT6797_JOIN_TX_DESC_BYTES + 12) / 2; /* Ethernet type after the addresses. */
+	d[3] = 0x88; /* TC4: MCU port, queue 1. */
+	d[4] = wlan;
+	d[5] = 0x90; /* Long descriptor, non-802.11 header, Ethernet II. */
+	d[7] = 1U << 2; /* Own-MAC 1. */
+	d[10] = lifetime;
+	d[11] = 0x80; /* Fixed rate enabled, zero power offset. */
+	d[12] = count; d[13] = count >> 8;
+	d[20] = pid; d[21] = 2; /* TX status to MCU. */
+	d[26] = (0x4bU << 2) & 255; d[27] = (0x4bU << 2) >> 8;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = d[i];
+	*pages = (total + 127U) / 128U;
+	return true;
+}
 #endif
