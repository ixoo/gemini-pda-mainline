From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 22:25:36 -0500
Subject: [PATCH] media: mediatek: mt6797-seninf: start with buffers queued
 before streaming on

When an application starts the stream before queueing, vb2 reports streaming while it
hands over the first buffer, just before start_streaming. The driver enqueued it with
the block off, lost it, and then dropped every frame. Keep its own flag.

Also shorten the format descriptions, which overflowed the 32 bytes the ioctl has.
---
 .../media/platform/mediatek/seninf/mt6797-seninf.c | 14 ++++++++++++--
 drivers/media/v4l2-core/v4l2-ioctl.c               |  4 ++--
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
index a30c559cd..5bf9799b5 100644
--- a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
+++ b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
@@ -274,10 +274,11 @@ struct mt6797_seninf {
 	struct v4l2_pix_format fmt;
 	bool registered;
 
-	spinlock_t buf_lock;		/* The two below and the sequence. */
+	spinlock_t buf_lock;		/* The state below. */
 	struct list_head buffers;
 	struct seninf_buffer *cur;
 	u32 last_wcnt;
+	bool camsv_on;
 	u32 sequence;
 };
 
@@ -704,6 +705,7 @@ static void camsv_start(struct mt6797_seninf *seninf)
 	spin_lock_irq(&seninf->buf_lock);
 	seninf->sequence = 0;
 	seninf->last_wcnt = 0;
+	seninf->camsv_on = true;
 	camsv_arm_next(seninf);
 	if (seninf->cur)
 		writel(lower_32_bits(vb2_dma_contig_plane_dma_addr(&seninf->cur->vb.vb2_buf, 0)),
@@ -726,6 +728,10 @@ static void camsv_stop(struct mt6797_seninf *seninf)
 {
 	void __iomem *sv = seninf->camsv;
 
+	spin_lock_irq(&seninf->buf_lock);
+	seninf->camsv_on = false;
+	spin_unlock_irq(&seninf->buf_lock);
+
 	writel(readl(sv + CAMSV_TG_VF_CON) & ~CAMSV_TG_VF_CON_EN, sv + CAMSV_TG_VF_CON);
 	writel(readl(sv + CAMSV_TG_SEN_MODE) & ~CAMSV_TG_SEN_MODE_CMOS_EN, sv + CAMSV_TG_SEN_MODE);
 	msleep(CAPTURE_STOP_MS);
@@ -787,7 +793,11 @@ static void seninf_buf_queue(struct vb2_buffer *vb)
 
 	spin_lock_irqsave(&seninf->buf_lock, flags);
 	list_add_tail(&buf->list, &seninf->buffers);
-	if (vb2_is_streaming(vb->vb2_queue))
+	/*
+	 * Not vb2_is_streaming(): that is already true when vb2 hands over the buffers
+	 * just before start_streaming, with the block still off.
+	 */
+	if (seninf->camsv_on)
 		camsv_arm_next(seninf);
 	spin_unlock_irqrestore(&seninf->buf_lock, flags);
 }
diff --git a/drivers/media/v4l2-core/v4l2-ioctl.c b/drivers/media/v4l2-core/v4l2-ioctl.c
index 9ef09e90e..9004498c1 100644
--- a/drivers/media/v4l2-core/v4l2-ioctl.c
+++ b/drivers/media/v4l2-core/v4l2-ioctl.c
@@ -1407,8 +1407,8 @@ static void v4l_fill_fmtdesc(struct v4l2_fmtdesc *fmt)
 	case V4L2_PIX_FMT_SGBRG10ALAW8:	descr = "8-bit Bayer GBGB/RGRG (A-law)"; break;
 	case V4L2_PIX_FMT_SGRBG10ALAW8:	descr = "8-bit Bayer GRGR/BGBG (A-law)"; break;
 	case V4L2_PIX_FMT_SRGGB10ALAW8:	descr = "8-bit Bayer RGRG/GBGB (A-law)"; break;
-	case V4L2_PIX_FMT_MTISP_SGRBG10:	descr = "10-bit Bayer GRGR/BGBG MediaTek Packed"; break;
-	case V4L2_PIX_FMT_MTISP_SRGGB10:	descr = "10-bit Bayer RGRG/GBGB MediaTek Packed"; break;
+	case V4L2_PIX_FMT_MTISP_SGRBG10:	descr = "10-bit GRBG MediaTek Packed"; break;
+	case V4L2_PIX_FMT_MTISP_SRGGB10:	descr = "10-bit RGGB MediaTek Packed"; break;
 	case V4L2_PIX_FMT_SBGGR10DPCM8:	descr = "8-bit Bayer BGBG/GRGR (DPCM)"; break;
 	case V4L2_PIX_FMT_SGBRG10DPCM8:	descr = "8-bit Bayer GBGB/RGRG (DPCM)"; break;
 	case V4L2_PIX_FMT_SGRBG10DPCM8:	descr = "8-bit Bayer GRGR/BGBG (DPCM)"; break;
