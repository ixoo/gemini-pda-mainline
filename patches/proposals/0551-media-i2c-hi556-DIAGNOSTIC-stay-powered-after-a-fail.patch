From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 14:54:19 -0500
Subject: [PATCH] media: i2c: hi556: DIAGNOSTIC, stay powered after a failed
 chip ID

Bring-up only, to be dropped. With diag_hold_s set, a failed chip ID keeps
the rails and clock on and retries once a second, so the pins, clock and
rails can be read while they should be live.
---
 drivers/media/i2c/hi556.c | 46 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/drivers/media/i2c/hi556.c b/drivers/media/i2c/hi556.c
index bb58f151d..5aa22ea26 100644
--- a/drivers/media/i2c/hi556.c
+++ b/drivers/media/i2c/hi556.c
@@ -1343,6 +1343,50 @@ static int hi556_resume(struct device *dev)
 	return 0;
 }
 
+static unsigned int diag_hold_s;
+module_param(diag_hold_s, uint, 0444);
+MODULE_PARM_DESC(diag_hold_s, "After a failed chip ID, stay powered and retry for this long");
+
+static void hi556_diag_read(struct hi556 *hi556, u16 addr)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&hi556->sd);
+	u8 reg[2] = { HI556_REG_CHIP_ID >> 8, HI556_REG_CHIP_ID & 0xff };
+	u8 val[2] = { 0, 0 };
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .len = sizeof(reg), .buf = reg },
+		{ .addr = addr, .flags = I2C_M_RD, .len = sizeof(val), .buf = val },
+	};
+	int ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+
+	dev_info(hi556->dev, "diag: addr 0x%02x ret %d id %02x%02x\n", addr, ret,
+		 val[0], val[1]);
+}
+
+/* Bring-up only: keep the rails and clock on so the state can be read. */
+static void hi556_diag_hold(struct hi556 *hi556)
+{
+	unsigned int i;
+
+	dev_info(hi556->dev, "diag: holding %u s, mclk %lu Hz\n", diag_hold_s,
+		 clk_get_rate(hi556->clk));
+	for (i = 0; i < diag_hold_s; i++) {
+		hi556_diag_read(hi556, 0x20);
+		hi556_diag_read(hi556, 0x28);
+		if (i == diag_hold_s / 2) {
+			/* The vendor's order and its longer steps. */
+			gpiod_set_value_cansleep(hi556->powerdown_gpio, 1);
+			gpiod_set_value_cansleep(hi556->reset_gpio, 1);
+			msleep(10);
+			gpiod_set_value_cansleep(hi556->reset_gpio, 0);
+			msleep(10);
+			gpiod_set_value_cansleep(hi556->powerdown_gpio, 0);
+			msleep(10);
+			dev_info(hi556->dev, "diag: reset and power-down pulsed\n");
+		}
+		msleep(1000);
+	}
+}
+
 static int hi556_probe(struct i2c_client *client)
 {
 	struct hi556 *hi556;
@@ -1407,6 +1451,8 @@ static int hi556_probe(struct i2c_client *client)
 		ret = hi556_identify_module(hi556);
 		if (ret) {
 			dev_err(hi556->dev, "failed to find sensor: %d\n", ret);
+			if (diag_hold_s)
+				hi556_diag_hold(hi556);
 			goto probe_error_power_off;
 		}
 	}
