From 68e4f710136611aed0caa9e9ec12c3fda73dea53 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 24 Oct 2026 17:26:57 -0400
Subject: [PATCH 4/6] wifi: mt6797: record the firmware rate word of every TX
 completion

The TX-done event carries the rate word and the retry count the firmware
used for the frame when its flag bit 0 is set; the driver parses both but
logs only the count. Behind a new option, log one extra line per
completion with the rate word and the flags, so that a frame which ends
with status 3 can be named by the rate it was sent at. Measurement
profiles only; the existing completion line is unchanged and no classifier
reads the new one.

Signed-off-by: Julien Etienne <julien.etienne@gmail.com>
(cherry picked from commit 3406c3a292197b7c03bbfa467d373caf58c3b4db)
---
 drivers/net/wireless/mediatek/mt6797/Kconfig | 9 +++++++++
 drivers/net/wireless/mediatek/mt6797/mac.c   | 6 ++++++
 2 files changed, 15 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 66f61da98..90e7520df 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -116,6 +116,15 @@ config MT6797_DATA_FIXED_RATE_CODE
 	  variable for the per-frame air time; the default is the rate the
 	  series has always used.
 
+config MT6797_TX_DONE_RATE_RECORD
+	bool "MT6797 Wi-Fi: record the firmware rate word of every TX completion"
+	depends on MT6797_STATION_JOIN
+	help
+	  Log one line per transmit completion with the rate word and flags
+	  the firmware reports, so the rate a frame was sent at can be read
+	  from the sealed log. Measurement profiles only; the record is not
+	  parsed by any classifier.
+
 config MT6797_CCMP_TX_DEPTH
 	int
 	depends on MT6797_CCMP_TX_PUMP
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 01751a395..ad28e9b37 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -3955,6 +3955,12 @@ static void mt6797_mac_join_work(struct work_struct *work)
 					 "one-shot WLAN join TX done: pid=%u status=%u advanced=%u count=%u\n",
 					 mac->join_pid, result.status, !!(result.flags & 1),
 					 result.count);
+#if IS_ENABLED(CONFIG_MT6797_TX_DONE_RATE_RECORD)
+				/* The firmware's rate word for the frame, valid with flag bit 0. */
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN join TX rate: pid=%u status=%u rate=0x%04x flags=0x%02x\n",
+					 mac->join_pid, result.status, result.rate, result.flags);
+#endif
 #endif
 #ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
 				mt6797_ccmp_tx_timing(mac, mac->join_pid, result.status,
-- 
