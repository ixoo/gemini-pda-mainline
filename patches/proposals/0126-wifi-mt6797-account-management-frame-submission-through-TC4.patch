From df12b5652e8ddd5ca66768cbcea327235372cc77 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 5 Oct 2026 23:58:52 +0000
Subject: [PATCH] wifi: mt6797: account management frame submission through TC4

Original preparation for one bounded legacy station join. This checkpoint
is compile-only and incomplete; no device operation is admitted.
---
 .../wireless/mediatek/mt6797/join-submit.h    | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/join-submit.h

diff --git a/drivers/net/wireless/mediatek/mt6797/join-submit.h b/drivers/net/wireless/mediatek/mt6797/join-submit.h
new file mode 100644
index 000000000..bc5c47430
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/join-submit.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_JOIN_SUBMIT_H
+#define MT6797_JOIN_SUBMIT_H
+
+#include "normal_command.h"
+#include "join-tx.h"
+
+/* Prepare one management frame through the same TC4 owner as commands.
+ * The descriptor counts toward firmware pages; bus padding does not.
+ * No command sequence is consumed: TXdone matches the single-use frame PID.
+ * Caller owns exclusive station/channel admission and the PID ledger.
+ * No previous page debt may overlap this bounded submission.
+ */
+static inline int
+mt6797_join_prepare_management(struct mt6797_normal_transaction *t,
+	const unsigned char *frame, size_t bytes, unsigned char wlan,
+	unsigned char pid, unsigned int lifetime_ms, unsigned int attempt_count,
+	unsigned char *output, size_t capacity, struct mt6797_hif_command *command)
+{
+	unsigned char descriptor[MT6797_JOIN_TX_DESC_BYTES];
+	struct mt6797_hif_command encoded;
+	unsigned int pages;
+	size_t total, i;
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!t || !output || !command)
+		return -EINVAL;
+	if (t->phase != MT6797_NORMAL_NVRAM_SUBMITTED || !t->used_sequences ||
+	    !t->tc4_limit || t->tc4_limit > 0xffffU || t->tc4_free > t->tc4_limit)
+		return mt6797_normal_abort(t);
+	if (!mt6797_join_tx_descriptor(frame, bytes, wlan, pid, lifetime_ms,
+				      attempt_count, descriptor, &pages))
+		return -EINVAL;
+	if (t->tc4_free != t->tc4_limit)
+		return -EBUSY;
+	if (t->tc4_free < pages)
+		return -ENOSPC;
+	total = MT6797_JOIN_TX_DESC_BYTES + bytes;
+	error = mt6797_hif_encode_command(0x34, MT6797_HIF_WRITE,
+					  MT6797_HIF_PIO_ONLY, total, capacity, &encoded);
+	if (error)
+		return error;
+	for (i = 0; i < encoded.transfer_bytes; i++)
+		output[i] = 0;
+	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
+		output[i] = descriptor[i];
+	for (i = 0; i < bytes; i++)
+		output[MT6797_JOIN_TX_DESC_BYTES + i] = frame[i];
+	t->tc4_free -= pages;
+	t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	t->phase = MT6797_NORMAL_CONFIG_TX;
+	*command = encoded;
+	return 0;
+}
+#endif
