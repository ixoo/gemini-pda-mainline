From f13842249c7f5de0f924ee007ecb4e4eec6495b3 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 14:25:31 -0400
Subject: [PATCH] wifi: mt6797: record a per-second backpressure series and
 receive gaps

The backpressure record counts the data phase's stops and wakes as one
total, so it cannot say whether mac80211's queues were stopped while
the device was receiving: the question that decides whether the
device's TCP acknowledgements, which share the one data queue, are ever
held by it. The driver does not know the measurement's phases, so it
records time instead: behind CONFIG_MT6797_DATA_PHASE_SERIES, per
second of the data phase, the stops, the wakes, the queue's high-water
mark, the kilobytes delivered to mac80211 and the data frames queued
for transmit, printed at the data end with the phase's start on the
kernel clock for alignment with the run's own markers.

A receive stall inferred from a chunk total cannot be attributed. Also
record each gap of more than 200 ms between delivered data frames (at
most 32, the overflow counted): its start, its duration, the bytes
delivered in the 200-400 ms before it (with that window's length) and
in the 200 ms after it, the data frames queued and retired during it,
and the queue length, frames in flight, credit pages outstanding and
stop state when it ended. Logging only; nothing changes with the option
off.

The first form recorded the bytes before a gap as the phase's
cumulative count beside a delta after it, so the pair could not be read
as one window; both are deltas now.
---
 drivers/net/wireless/mediatek/mt6797/Kconfig |  17 ++
 drivers/net/wireless/mediatek/mt6797/mac.c   | 154 +++++++++++++++++++
 2 files changed, 171 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 855382b55..65d0f139c 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -154,6 +154,23 @@ config MT6797_TX_BACKPRESSURE
 	  wakes, the drops and the queue's high-water mark. Nothing changes
 	  with this off.
 
+config MT6797_DATA_PHASE_SERIES
+	bool "MT6797 Wi-Fi: per-second backpressure series and receive-gap windows (logging only)"
+	depends on MT6797_TX_BACKPRESSURE && MT6797_DATA_CREDIT_RETIRE && MT6797_CCMP_STABLE_EPOCH
+	help
+	  The backpressure record counts stops and wakes for the whole data
+	  phase, so it cannot say whether the queue stopped while the device
+	  was receiving. Record, per second of the data phase, the stops, the
+	  wakes, the queue's high-water mark, the kilobytes delivered to
+	  mac80211 and the data frames queued for transmit, printed at the
+	  data end on the kernel clock so a run aligns them with its own
+	  markers. Also record each gap of more than 200 ms between delivered
+	  data frames (at most 32): its start, duration, the bytes delivered
+	  in the 200-400 ms before it (with that window's length) and in the
+	  200 ms after it, the data frames queued and
+	  retired during it, and the queue, in-flight and credit state at its
+	  end. Nothing else changes.
+
 config MT6797_DATA_TX_QUEUE_FRAMES
 	int "MT6797 Wi-Fi: ordinary data frames the driver queues ahead of submission"
 	depends on MT6797_STATION_JOIN
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index e07f91ea1..86eec1c11 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -162,6 +162,11 @@ static inline bool mt6797_join_pid_complete(struct mt6797_join_pid_pool *p,
 #define MT6797_JOIN_DATA_TX_STOP (MT6797_JOIN_DATA_TX_QUEUE - MT6797_JOIN_DATA_TX_QUEUE / 8U)
 #define MT6797_JOIN_DATA_TX_WAKE (MT6797_JOIN_DATA_TX_QUEUE / 2U)
 #define MT6797_JOIN_DATA_TX_QUEUE_BYTES (MT6797_JOIN_DATA_TX_QUEUE * 1550U)
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+#define MT6797_SERIES_SECONDS 96U
+#define MT6797_RX_GAPS 32U
+#define MT6797_RX_GAP_NS (200ULL * NSEC_PER_MSEC)
+#endif
 #define MT6797_JOIN_DATA_TX_FAILURES 8U
 /* PIDs 1..127 are consumed in order by management, security and data frames;
  * ordinary data stops at 126 so the reserved deauthentication always has one.
@@ -237,6 +242,25 @@ struct mt6797_mac {
 	/* mac80211's queues stopped while the data queue is at its bound (0282). */
 	bool tx_queues_stopped;
 	unsigned int tx_queue_stops, tx_queue_wakes, tx_dropped_full, tx_queue_high_water;
+#endif
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+	/* Per-second data-phase series and receive gaps (0283), logging only. */
+	struct mt6797_data_second {
+		u16 stops, wakes, rx_kib, tx_queued;
+		u8 high;
+	} series[MT6797_SERIES_SECONDS];
+	unsigned int series_used, series_beyond;
+	struct mt6797_rx_gap {
+		u64 start_ns;
+		u32 duration_ms, before_ms, rx_bytes_before, rx_bytes_after;
+		u32 tx_queued, tx_retired;
+		u16 queue_len, pages;
+		u8 inflight, stopped;
+	} rx_gaps[MT6797_RX_GAPS];
+	unsigned int rx_gap_count, rx_gaps_beyond;
+	u64 rx_last_ns, rx_gap_after_until, rx_snap_ns[2];
+	u32 rx_bytes_total, rx_series_bytes, rx_last_tx_queued, rx_last_retired;
+	u32 rx_snap_bytes[2];
 #endif
 	unsigned int join_page_debt, join_polls, join_packets;
 	bool join_running, join_open, join_retired;
@@ -1067,6 +1091,24 @@ static void mt6797_ccmp_connection_lost(struct mt6797_mac *mac, const char *sour
 }
 #endif
 
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+static int mt6797_series_second(struct mt6797_mac *mac, u64 now)
+{
+	u64 second;
+
+	if (!mac->join_data_phase || mac->join_data_ended || now < mac->join_data_started)
+		return -1;
+	second = (now - mac->join_data_started) / NSEC_PER_SEC;
+	if (second >= MT6797_SERIES_SECONDS) {
+		mac->series_beyond++;
+		return -1;
+	}
+	if (second >= mac->series_used)
+		mac->series_used = second + 1;
+	return second;
+}
+#endif
+
 /* Called only in the common serialized RX/TX-status batch, outside MAC locks.
  * Withdrawal fences eligibility then waits for this batch before key removal
  * callbacks complete. RCU covers pubsta and the entire core RX handoff.
@@ -1095,6 +1137,53 @@ static void mt6797_ccmp_receive(struct mt6797_mac *mac, struct sk_buff *skb)
 	}
 	if (ready)
 		mac->ccmp_rx_delivered++;
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+	if (ready && ethernet) {
+		u64 now = ktime_get_ns();
+		int second = mt6797_series_second(mac, now);
+
+		if (second >= 0) {
+			struct mt6797_data_second *b = &mac->series[second];
+			struct mt6797_rx_gap *g;
+
+			mac->rx_series_bytes += skb->len;
+			b->rx_kib = min(b->rx_kib + (mac->rx_series_bytes >> 10), 0xffffU);
+			mac->rx_series_bytes &= 1023;
+			if (mac->rx_last_ns && now - mac->rx_last_ns > MT6797_RX_GAP_NS &&
+			    mac->rx_gap_count >= MT6797_RX_GAPS) {
+				mac->rx_gaps_beyond++;
+			} else if (mac->rx_last_ns && now - mac->rx_last_ns > MT6797_RX_GAP_NS) {
+				g = &mac->rx_gaps[mac->rx_gap_count++];
+				g->start_ns = mac->rx_last_ns;
+				g->duration_ms = (now - mac->rx_last_ns) / NSEC_PER_MSEC;
+				/* bytes in the 200-400 ms before the gap, a delta like the after */
+				g->before_ms = (mac->rx_last_ns - mac->rx_snap_ns[0]) /
+					       NSEC_PER_MSEC;
+				g->rx_bytes_before = mac->rx_bytes_total - mac->rx_snap_bytes[0];
+				g->rx_bytes_after = 0;
+				g->tx_queued = mac->join_data_tx_queued - mac->rx_last_tx_queued;
+				g->tx_retired = mac->credit_retired - mac->rx_last_retired;
+				g->queue_len = min(skb_queue_len(&mac->join_queue), 0xffffU);
+				g->pages = min(mac->credit_retire_pages, 0xffffU);
+				g->inflight = mac->data_slots.count;
+				g->stopped = mac->tx_queues_stopped;
+				mac->rx_gap_after_until = now + MT6797_RX_GAP_NS;
+			}
+			if (mac->rx_gap_count && now < mac->rx_gap_after_until)
+				mac->rx_gaps[mac->rx_gap_count - 1].rx_bytes_after += skb->len;
+			mac->rx_bytes_total += skb->len;
+			if (now - mac->rx_snap_ns[1] >= MT6797_RX_GAP_NS) {
+				mac->rx_snap_ns[0] = mac->rx_snap_ns[1];
+				mac->rx_snap_bytes[0] = mac->rx_snap_bytes[1];
+				mac->rx_snap_ns[1] = now;
+				mac->rx_snap_bytes[1] = mac->rx_bytes_total;
+			}
+			mac->rx_last_ns = now;
+			mac->rx_last_tx_queued = mac->join_data_tx_queued;
+			mac->rx_last_retired = mac->credit_retired;
+		}
+	}
+#endif
 	mutex_unlock(&mac->mutex);
 	if (ready)
 		ieee80211_rx_napi(mac->hw, sta, skb, NULL);
@@ -1845,6 +1934,21 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->tx_queue_wakes = 0;
 	mac->tx_dropped_full = 0;
 	mac->tx_queue_high_water = 0;
+#endif
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+	memset(mac->series, 0, sizeof(mac->series));
+	mac->series_used = 0;
+	mac->series_beyond = 0;
+	mac->rx_gap_count = 0;
+	mac->rx_gaps_beyond = 0;
+	mac->rx_last_ns = 0;
+	mac->rx_gap_after_until = 0;
+	mac->rx_bytes_total = 0;
+	memset(mac->rx_snap_ns, 0, sizeof(mac->rx_snap_ns));
+	memset(mac->rx_snap_bytes, 0, sizeof(mac->rx_snap_bytes));
+	mac->rx_series_bytes = 0;
+	mac->rx_last_tx_queued = 0;
+	mac->rx_last_retired = 0;
 #endif
 	mac->join_inflight_data = false;
 	mac->join_last_acked = false;
@@ -3055,6 +3159,34 @@ static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 		 mac->tx_queues_stopped, mac->tx_queue_high_water,
 		 MT6797_JOIN_DATA_TX_QUEUE);
 #endif
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+	{
+		unsigned int i;
+
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN data series: started_ns=%llu seconds=%u beyond=%u gaps=%u gaps_beyond=%u gap_ms=200\n",
+			 mac->join_data_started, mac->series_used, mac->series_beyond,
+			 mac->rx_gap_count, mac->rx_gaps_beyond);
+		for (i = 0; i < mac->series_used; i++)
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN data second: sec=%u stops=%u wakes=%u high=%u rx_kib=%u tx_queued=%u\n",
+				 i, mac->series[i].stops, mac->series[i].wakes,
+				 mac->series[i].high, mac->series[i].rx_kib,
+				 mac->series[i].tx_queued);
+		for (i = 0; i < mac->rx_gap_count; i++) {
+			const struct mt6797_rx_gap *g = &mac->rx_gaps[i];
+
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN data rx gap: n=%u start_ns=%llu at_ms=%llu duration_ms=%u before_ms=%u rx_bytes_before=%u rx_bytes_after=%u tx_queued=%u tx_retired=%u queue=%u inflight=%u pages=%u stopped=%u\n",
+				 i, g->start_ns,
+				 (g->start_ns - mac->join_data_started) / NSEC_PER_MSEC,
+				 g->duration_ms, g->before_ms, g->rx_bytes_before,
+				 g->rx_bytes_after,
+				 g->tx_queued, g->tx_retired, g->queue_len, g->inflight,
+				 g->pages, g->stopped);
+		}
+	}
+#endif
 #ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
 	dev_info(wiphy_dev(mac->hw->wiphy),
 		 "one-shot WLAN join data credit retire end: retired=%u expired=%u pid_faults=%u wait_avg_us=%llu wait_max_us=%llu left_pages=%u inflight_max=%u samples=%u reports=%u\n",
@@ -3860,6 +3992,14 @@ static void mt6797_mac_join_work(struct work_struct *work)
 			mac->tx_queues_stopped = false;
 			mac->tx_queue_wakes++;
 			wake = true;
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+			{
+				int second = mt6797_series_second(mac, ktime_get_ns());
+
+				if (second >= 0)
+					mac->series[second].wakes++;
+			}
+#endif
 		}
 #endif
 		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
@@ -6440,6 +6580,9 @@ static void mt6797_mac_tx(struct ieee80211_hw *hw,
 #ifdef CONFIG_MT6797_TX_BACKPRESSURE
 	bool stop = false;
 #endif
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+	int second;
+#endif
 
 	/* Phase C2: the supplicant's control-port EAPOL frames, built by
 	 * mac80211 as non-QoS To-DS data frames with the LLC/SNAP EAPOL type to
@@ -6519,6 +6662,17 @@ static void mt6797_mac_tx(struct ieee80211_hw *hw,
 				mac->tx_queue_stops++;
 				stop = true;
 			}
+#ifdef CONFIG_MT6797_DATA_PHASE_SERIES
+			second = mt6797_series_second(mac, ktime_get_ns());
+			if (second >= 0) {
+				struct mt6797_data_second *b = &mac->series[second];
+				unsigned int len = min(skb_queue_len(&mac->join_queue), 0xffU);
+
+				b->tx_queued = min(b->tx_queued + 1U, 0xffffU);
+				b->stops += stop;
+				b->high = max_t(unsigned int, b->high, len);
+			}
+#endif
 		} else if (mac->join_open && mac->join_data_phase &&
 			   !mac->join_data_ended) {
 			mac->tx_dropped_full++;
-- 
2.43.0

