+++ b/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
@@ -29,6 +29,9 @@ mt6797_join_prepare_command(struct mt6797_normal_transaction *t,
 			return -EINVAL;
 		required = 4;
 		break;
+	case 0x12:
