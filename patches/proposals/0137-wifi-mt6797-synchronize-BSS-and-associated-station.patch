diff --git a/drivers/net/wireless/mediatek/mt6797/join-commands.h b/drivers/net/wireless/mediatek/mt6797/join-commands.h
index dfad1238e..d5f7ee696 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-commands.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-commands.h
@@ -76,6 +76,53 @@ mt6797_join_station_payload(const unsigned char *ap, unsigned int state,
 	return true;
 }
 
+#define MT6797_JOIN_BSS_BYTES 88U
+
+/* Public gen3 CMD_SET_BSS_INFO including its 20-byte RLM tail.
+ * One legacy 5 GHz AIS BSS, connected (enum 0), Open System/no cipher.
+ * Natural alignment leaves reserved bytes at 49 and 61..63.
+ */
+static inline bool
+mt6797_join_bss_payload(const unsigned char *ap, const unsigned char *ssid,
+	unsigned int ssid_bytes, unsigned int desired_rates,
+	unsigned int basic_rates, bool short_preamble,
+	unsigned char output[MT6797_JOIN_BSS_BYTES])
+{
+	unsigned char p[MT6797_JOIN_BSS_BYTES] = {0};
+	unsigned int i, any = 0;
+
+	if (!ap || !ssid || !output || !ssid_bytes || ssid_bytes > 32 ||
+	    (ap[0] & 1) || !desired_rates || (desired_rates & ~0x3fc0U) ||
+	    !basic_rates || (basic_rates & ~desired_rates) ||
+	    !(desired_rates & (1U << 6)))
+		return false;
+	for (i = 0; i < 6; i++)
+		any |= ap[i];
+	if (!any)
+		return false;
+	p[3] = ssid_bytes;
+	for (i = 0; i < ssid_bytes; i++)
+		p[4 + i] = ssid[i];
+	for (i = 0; i < 6; i++)
+		p[36 + i] = ap[i];
+	p[44] = desired_rates; p[45] = desired_rates >> 8;
+	p[46] = basic_rates; p[47] = basic_rates >> 8;
+	p[48] = 1; /* AP STA index. */
+	p[50] = 0x4b; /* Fixed OFDM 6 Mbps. */
+	p[52] = 3; /* PHY_TYPE_OFDM_INDEX, not a bitmap. */
+	p[54] = 1; /* ENUM_ENCRYPTION_DISABLED, not encryption-enabled enum 0. */
+	p[55] = 8; /* PHY_TYPE_BIT_OFDM. */
+	/* BSS 0, BMC 0, private AIS index 0, disconnect threshold default 0. */
+	p[69] = 2; p[70] = 40;
+	p[81] = short_preamble;
+	p[82] = 1; /* 5 GHz always uses short slot time. */
+	/* Public rlmFillSyncCmdParam uses the legacy basic set here too. */
+	p[86] = basic_rates; p[87] = basic_rates >> 8;
+	for (i = 0; i < MT6797_JOIN_BSS_BYTES; i++)
+		output[i] = p[i];
+	return true;
+}
+
 static inline bool
 mt6797_join_remove_station(unsigned char output[4])
 {
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
