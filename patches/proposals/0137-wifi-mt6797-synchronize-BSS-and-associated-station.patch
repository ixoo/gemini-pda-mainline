diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 880b442c9..95a868f8c 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -646,6 +646,20 @@ int mt6797_hif_join_filter(struct mt6797_hif *hif, unsigned int sequence,
 					   sizeof(payload), deadline_ns);
 }
 
+int mt6797_hif_join_bss(struct mt6797_hif *hif, unsigned int sequence,
+	const u8 *ap, const u8 *ssid, unsigned int ssid_bytes,
+	unsigned int desired_rates, unsigned int basic_rates,
+	bool short_preamble, u64 deadline_ns)
+{
