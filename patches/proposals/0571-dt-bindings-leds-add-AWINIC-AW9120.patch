From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 20:30:00 -0500
Subject: [PATCH 571/573] dt-bindings: leds: add AWINIC AW9120

An I2C controller with 20 current sinks, each with its own PWM and current
limit. Outputs group into RGB LEDs under multi-led nodes, or stand alone.

The enable pin is required because the chip stays in shutdown without it.
The supplies aren't described: nothing here has needed them, and the Gemini
PDA's wiring of them is unknown.
---
 .../bindings/leds/awinic,aw9120.yaml          | 136 ++++++++++++++++++
 1 file changed, 136 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/awinic,aw9120.yaml

diff --git a/Documentation/devicetree/bindings/leds/awinic,aw9120.yaml b/Documentation/devicetree/bindings/leds/awinic,aw9120.yaml
new file mode 100644
index 000000000..60636b2c8
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/awinic,aw9120.yaml
@@ -0,0 +1,136 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/awinic,aw9120.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: AWINIC AW9120 20-channel LED controller
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description:
+  An I2C controller with 20 current sinks, each with 8-bit PWM and a current
+  limit of up to 24.5 mA in steps of 3.5 mA. Outputs LED1 to LED20 are numbered
+  0 to 19 here, as in the chip's instructions.
+
+properties:
+  compatible:
+    const: awinic,aw9120
+
+  reg:
+    maxItems: 1
+
+  enable-gpios:
+    maxItems: 1
+    description: The active-high PDN pin. Its rising edge resets the chip.
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+patternProperties:
+  "^multi-led-[0-9]+$":
+    type: object
+    $ref: leds-class-multicolor.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      "#address-cells":
+        const: 1
+
+      "#size-cells":
+        const: 0
+
+    patternProperties:
+      "^led@([0-9a-f]|1[0-3])$":
+        $ref: "#/$defs/output"
+        unevaluatedProperties: false
+
+    required:
+      - "#address-cells"
+      - "#size-cells"
+
+  "^led@([0-9a-f]|1[0-3])$":
+    $ref: "#/$defs/output"
+    unevaluatedProperties: false
+
+$defs:
+  output:
+    type: object
+    $ref: common.yaml#
+
+    properties:
+      reg:
+        maximum: 19
+
+      led-max-microamp:
+        minimum: 3500
+        maximum: 24500
+        multipleOf: 3500
+        default: 3500
+
+    required:
+      - reg
+      - color
+
+required:
+  - compatible
+  - reg
+  - enable-gpios
+  - "#address-cells"
+  - "#size-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/leds/common.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        led-controller@2c {
+            compatible = "awinic,aw9120";
+            reg = <0x2c>;
+            enable-gpios = <&pio 245 GPIO_ACTIVE_HIGH>;
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            multi-led-1 {
+                color = <LED_COLOR_ID_RGB>;
+                function = LED_FUNCTION_INDICATOR;
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                led@0 {
+                    reg = <0>;
+                    color = <LED_COLOR_ID_RED>;
+                    led-max-microamp = <3500>;
+                };
+
+                led@1 {
+                    reg = <1>;
+                    color = <LED_COLOR_ID_GREEN>;
+                    led-max-microamp = <3500>;
+                };
+
+                led@2 {
+                    reg = <2>;
+                    color = <LED_COLOR_ID_BLUE>;
+                    led-max-microamp = <3500>;
+                };
+            };
+
+            led@12 {
+                reg = <18>;
+                color = <LED_COLOR_ID_RED>;
+                function = LED_FUNCTION_CAPSLOCK;
+                led-max-microamp = <3500>;
+            };
+        };
+    };
