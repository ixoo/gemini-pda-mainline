From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 31 Oct 2026 15:16:51 -0400
Subject: [PATCH] iio: adc: mt6359-auxadc: add the MT6351 battery voltage
 channel

The Gemini PDA reads its pack voltage on MT6351 channel 1 (ISENSE), as
the vendor fuel gauge does with the BQ25896 power path: a request bit in
RQST0, the AP's own 15-bit result in ADC25 with ready bit 15, scaled by
three against the 1.8 V reference.
---
 drivers/iio/adc/mt6359-auxadc.c                      | 6 ++++++
 include/dt-bindings/iio/adc/mediatek,mt6351-auxadc.h | 1 +
 2 files changed, 7 insertions(+)

diff --git a/drivers/iio/adc/mt6359-auxadc.c b/drivers/iio/adc/mt6359-auxadc.c
index 8508887c4..70e38c2ed 100644
--- a/drivers/iio/adc/mt6359-auxadc.c
+++ b/drivers/iio/adc/mt6359-auxadc.c
@@ -208,10 +208,16 @@ struct mtk_pmic_auxadc_info {
 
 static const struct iio_chan_spec mt6351_auxadc_channels[] = {
 	MTK_PMIC_IIO_CHAN(MT6351, batt_temp, BAT_TEMP, 3, 12, IIO_TEMP),
+	MTK_PMIC_IIO_CHAN(MT6351, bat_adc, BATADC, 25, 15, IIO_VOLTAGE),
 };
 
 static const struct mtk_pmic_auxadc_chan mt6351_auxadc_ch_desc[] = {
 	MTK_PMIC_ADC_CHAN(BAT_TEMP, PMIC_AUXADC_RQST0, 3, PMIC_AUXADC_IMP0, 8, 8, 2, 1),
+	/*
+	 * The pack voltage. With the BQ25896 power path the vendor reads it on
+	 * channel 1 (ISENSE), from the AP's own result register ADC25.
+	 */
+	MTK_PMIC_ADC_CHAN(BATADC, PMIC_AUXADC_RQST0, 1, PMIC_AUXADC_IMP0, 8, 128, 3, 1),
 };
 
 /*
diff --git a/include/dt-bindings/iio/adc/mediatek,mt6351-auxadc.h b/include/dt-bindings/iio/adc/mediatek,mt6351-auxadc.h
index e546457a6..eaa5724a3 100644
--- a/include/dt-bindings/iio/adc/mediatek,mt6351-auxadc.h
+++ b/include/dt-bindings/iio/adc/mediatek,mt6351-auxadc.h
@@ -5,5 +5,6 @@
 
 /* ADC Channel Index */
 #define MT6351_AUXADC_BAT_TEMP		0
+#define MT6351_AUXADC_BATADC		1
 
 #endif
-- 
2.43.0

