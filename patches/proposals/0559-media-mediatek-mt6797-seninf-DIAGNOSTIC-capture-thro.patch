From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 17:38:59 -0500
Subject: [PATCH] media: mediatek: mt6797-seninf: DIAGNOSTIC, capture through
 frame buffer control

The first capture wrote nothing. The vendor library gates this DMA behind frame
buffer control, so enable it with one buffer and queue that buffer. Log the
generator and DMA status while the frame runs.
---
 .../platform/mediatek/seninf/mt6797-seninf.c  | 47 ++++++++++++++++---
 1 file changed, 41 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
index 130b21f22..3efca4a32 100644
--- a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
+++ b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
@@ -130,11 +130,20 @@
 #define CAMSV_SW_CTL_RST_TRIG		BIT(0)
 #define CAMSV_SW_CTL_RST_STA		BIT(1)
 #define CAMSV_SW_CTL_SW_RST		BIT(2)
+#define CAMSV_IMGO_FBC			0x02c
+#define CAMSV_IMGO_FBC_RCNT_INC		BIT(0)
 #define CAMSV_CLK_EN			0x030
 #define CAMSV_CLK_EN_VAL		(BIT(0) | BIT(2) | BIT(15))
 #define CAMSV_PAK			0x04c
 #define CAMSV_PAK_MASK			GENMASK(5, 0)
 #define CAMSV_PAK_RAW10			1
+#define CAMSV_FBC_IMGO_CTL1		0x110
+#define CAMSV_FBC_IMGO_CTL1_FLUSH	BIT(16)
+#define CAMSV_FBC_IMGO_CTL1_EN		(BIT(15) | BIT(22))
+#define CAMSV_FBC_IMGO_CTL1_NUM(n)	((u32)(n) << 24)
+#define CAMSV_FBC_IMGO_CTL2		0x114
+#define CAMSV_FBC_IMGO_ENQ_ADDR		0x118
+#define CAMSV_FBC_IMGO_CUR_ADDR		0x11c
 #define CAMSV_SPECIAL_FUN_EN		0x218
 #define CAMSV_SPECIAL_FUN_VAL		0x61000000
 #define CAMSV_IMGO_BASE_ADDR		0x220
@@ -144,6 +153,7 @@
 #define CAMSV_IMGO_STRIDE		0x238
 #define CAMSV_IMGO_STRIDE_BUS16		0x1010000
 #define CAMSV_IMGO_CROP			0x248
+#define CAMSV_IMGO_ERR_STAT		0x444
 #define CAMSV_DMA_RSV1			0x470
 #define CAMSV_DMA_RSV6			0x484
 #define CAMSV_TG_SEN_MODE		0x500
@@ -154,6 +164,11 @@
 #define CAMSV_TG_VF_CON_SINGLE		BIT(1)
 #define CAMSV_TG_SEN_GRAB_PXL		0x508
 #define CAMSV_TG_SEN_GRAB_LIN		0x50c
+#define CAMSV_TG_SOF_CNT		0x520
+#define CAMSV_TG_DAT_NO			0x530
+#define CAMSV_TG_FRM_CNT_ST		0x534
+#define CAMSV_TG_FRMSIZE_ST		0x538
+#define CAMSV_TG_INTER_ST		0x53c
 #define CAMSV_TG_SUB_PERIOD		0x574
 #define CAMSV_DMA_FRAME_HEADER_EN	0xc00
 
@@ -653,12 +668,23 @@ static void seninf_camsv_dump(struct mt6797_seninf *seninf, const char *when)
 		 when, readl(sv + CAMSV_MODULE_EN), readl(sv + CAMSV_INT_STATUS),
 		 readl(sv + CAMSV_TG_VF_CON), readl(sv + CAMSV_TG_SEN_MODE),
 		 readl(sv + CAMSV_TG_SEN_GRAB_PXL), readl(sv + CAMSV_TG_SEN_GRAB_LIN));
+	dev_info(seninf->dev,
+		 "camsv %s: sof %08x dat %08x frm %08x size %08x inter %08x\n",
+		 when, readl(sv + CAMSV_TG_SOF_CNT), readl(sv + CAMSV_TG_DAT_NO),
+		 readl(sv + CAMSV_TG_FRM_CNT_ST), readl(sv + CAMSV_TG_FRMSIZE_ST),
+		 readl(sv + CAMSV_TG_INTER_ST));
+	dev_info(seninf->dev,
+		 "camsv %s: fbc1 %08x fbc2 %08x enq %08x cur %08x err %08x cam_mux %08x\n",
+		 when, readl(sv + CAMSV_FBC_IMGO_CTL1), readl(sv + CAMSV_FBC_IMGO_CTL2),
+		 readl(sv + CAMSV_FBC_IMGO_ENQ_ADDR), readl(sv + CAMSV_FBC_IMGO_CUR_ADDR),
+		 readl(sv + CAMSV_IMGO_ERR_STAT), readl(seninf->base + SENINF_TOP_CAM_MUX));
 }
 
 /*
- * One frame into a bounded buffer. The generator runs in single mode, and the
- * DMA's size registers bound the write. A guard after the buffer shows whether
- * it was overrun. The larb is left in its reset state, with no M4U.
+ * One frame into a bounded buffer. Frame buffer control holds one buffer, so the
+ * DMA stops after it, and the DMA's size registers bound the write. A guard after
+ * the buffer shows whether it was overrun. The larb is left in its reset state,
+ * with no M4U.
  */
 static int seninf_capture_once(struct mt6797_seninf *seninf)
 {
@@ -733,7 +759,8 @@ static int seninf_capture_once(struct mt6797_seninf *seninf)
 	writel((u32)CAPTURE_WIDTH << 16, sv + CAMSV_TG_SEN_GRAB_PXL);
 	writel((u32)CAPTURE_HEIGHT << 16, sv + CAMSV_TG_SEN_GRAB_LIN);
 	writel(CAMSV_FMT_SEL_BAYER10, sv + CAMSV_FMT_SEL);
-	writel(0, sv + CAMSV_INT_EN);
+	/* No handler: this only makes the status readable. The line is not requested. */
+	writel(0x7fffffff, sv + CAMSV_INT_EN);
 	writel((readl(sv + CAMSV_PAK) & ~CAMSV_PAK_MASK) | CAMSV_PAK_RAW10, sv + CAMSV_PAK);
 	writel(0, sv + CAMSV_DMA_FRAME_HEADER_EN);
 	writel(readl(sv + CAMSV_DMA_RSV1) & ~BIT(31), sv + CAMSV_DMA_RSV1);
@@ -747,6 +774,12 @@ static int seninf_capture_once(struct mt6797_seninf *seninf)
 	writel(CAPTURE_STRIDE | CAMSV_IMGO_STRIDE_BUS16, sv + CAMSV_IMGO_STRIDE);
 	writel(0, sv + CAMSV_IMGO_CROP);
 
+	writel(CAMSV_FBC_IMGO_CTL1_FLUSH, sv + CAMSV_FBC_IMGO_CTL1);
+	writel(0, sv + CAMSV_FBC_IMGO_CTL1);
+	writel(CAMSV_FBC_IMGO_CTL1_NUM(1) | CAMSV_FBC_IMGO_CTL1_EN, sv + CAMSV_FBC_IMGO_CTL1);
+	writel(lower_32_bits(seninf->frame_dma), sv + CAMSV_FBC_IMGO_ENQ_ADDR);
+	writel(readl(sv + CAMSV_IMGO_FBC) | CAMSV_IMGO_FBC_RCNT_INC, sv + CAMSV_IMGO_FBC);
+
 	writel(CAMSV_MODULE_EN_TG | CAMSV_MODULE_EN_PAK | CAMSV_MODULE_EN_IMGO |
 	       CAMSV_MODULE_EN_DB, sv + CAMSV_MODULE_EN);
 	seninf_camsv_dump(seninf, "before");
@@ -756,8 +789,10 @@ static int seninf_capture_once(struct mt6797_seninf *seninf)
 	       sv + CAMSV_TG_VF_CON);
 
 	/* Two frame times at the sensor's 30 frames a second, and some margin. */
-	msleep(150);
-	seninf_camsv_dump(seninf, "after");
+	for (i = 0; i < 5; i++) {
+		msleep(30);
+		seninf_camsv_dump(seninf, "during");
+	}
 
 	writel(readl(sv + CAMSV_TG_VF_CON) & ~CAMSV_TG_VF_CON_EN, sv + CAMSV_TG_VF_CON);
 	writel(readl(sv + CAMSV_TG_SEN_MODE) & ~CAMSV_TG_SEN_MODE_CMOS_EN, sv + CAMSV_TG_SEN_MODE);
-- 
2.43.0

