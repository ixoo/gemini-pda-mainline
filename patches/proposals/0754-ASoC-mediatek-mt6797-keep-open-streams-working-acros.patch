From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Thu, 12 Nov 2026 19:12:08 -0500
Subject: [PATCH] ASoC: mediatek: mt6797: keep open streams working across a
 system suspend

The AUDIO domain loses the AFE registers in a system suspend. A stream
that was open through it is resumed with prepare and start only, which do
not set the memif addresses, format or rate again, so the AFE plays from a
zero address range: on the Gemini PDA, aplay left running across an s2idle
cycle got "mtk_afe_pcm_pointer hw_ptr err" until it failed with -EIO.

Give mtk_afe_suspend() and mtk_afe_resume() the memif, rate, format and
routing registers to save and restore.
---
 sound/soc/mediatek/mt6797/mt6797-afe-pcm.c | 26 ++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/sound/soc/mediatek/mt6797/mt6797-afe-pcm.c b/sound/soc/mediatek/mt6797/mt6797-afe-pcm.c
index 10cc4ed..e2b5702 100644
--- a/sound/soc/mediatek/mt6797/mt6797-afe-pcm.c
+++ b/sound/soc/mediatek/mt6797/mt6797-afe-pcm.c
@@ -385,11 +385,31 @@ static const struct snd_soc_dapm_route mt6797_memif_routes[] = {
 	{"UL_MONO_2_CH1", "ADDA_UL_CH2", "ADDA Capture"},
 };
 
+/*
+ * Saved across a system suspend for streams that stay open through it: they
+ * resume with prepare and start, which do not program the memif addresses,
+ * format or rate again. The routing is saved too, so the AFE matches DAPM.
+ */
+static const unsigned int mt6797_afe_backup_list[] = {
+	AFE_DAC_CON0, AFE_DAC_CON1, AFE_MEMIF_MSB, AFE_MEMIF_HD_MODE,
+	AFE_MEMIF_HDALIGN,
+	AFE_DL1_BASE, AFE_DL1_END, AFE_DL2_BASE, AFE_DL2_END,
+	AFE_DL3_BASE, AFE_DL3_END, AFE_AWB_BASE, AFE_AWB_END,
+	AFE_VUL_BASE, AFE_VUL_END, AFE_VUL_D2_BASE, AFE_VUL_D2_END,
+	AFE_DAI_BASE, AFE_DAI_END, AFE_MOD_DAI_BASE, AFE_MOD_DAI_END,
+	AFE_CONN0, AFE_CONN1, AFE_CONN2, AFE_CONN3, AFE_CONN4, AFE_CONN5,
+	AFE_CONN6, AFE_CONN7, AFE_CONN8, AFE_CONN9, AFE_CONN10, AFE_CONN11,
+	AFE_CONN12, AFE_CONN13, AFE_CONN14, AFE_CONN15, AFE_CONN16,
+	AFE_CONN17, AFE_CONN18, AFE_CONN19, AFE_CONN20, AFE_CONN21,
+	AFE_CONN22, AFE_CONN23, AFE_CONN24, AFE_CONN25, AFE_CONN26,
+	AFE_CONN27, AFE_CONN28, AFE_CONN29, AFE_CONN_24BIT,
+};
+
 /*
  * The AFE stays runtime active, but a system suspend still powers its AUDIO
  * domain off once every device in it has suspended, which resets the AFE.
- * Stop it before and set it up again after, as runtime PM would. Every AFE
- * control is a DAPM one, so DAPM rewrites the routing at the next stream.
+ * Stop it before and set it up again after, as runtime PM would, and put the
+ * registers above back.
  */
 static const struct snd_soc_component_driver mt6797_afe_pcm_dai_component = {
 	.name = "mt6797-afe-pcm-dai",
@@ -860,6 +880,8 @@ static int mt6797_afe_pcm_dev_probe(struct platform_device *pdev)
 
 	afe->runtime_resume = mt6797_afe_runtime_resume;
 	afe->runtime_suspend = mt6797_afe_runtime_suspend;
+	afe->reg_back_up_list = mt6797_afe_backup_list;
+	afe->reg_back_up_list_num = ARRAY_SIZE(mt6797_afe_backup_list);
 
 	platform_set_drvdata(pdev, afe);
 
