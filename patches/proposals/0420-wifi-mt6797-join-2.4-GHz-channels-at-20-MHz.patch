diff --git a/drivers/net/wireless/mediatek/mt6797/mcu.h b/drivers/net/wireless/mediatek/mt6797/mcu.h
index 68cfd0c43..9a3dc803c 100644
--- a/drivers/net/wireless/mediatek/mt6797/mcu.h
+++ b/drivers/net/wireless/mediatek/mt6797/mcu.h
@@ -879,28 +879,48 @@ static inline bool mt6797_join_filter_payload(unsigned char output[4])
 	return true;
 }
 
-/* mac80211's published 5 GHz band has OFDM rates in positions 0..7.
+/* mac80211's published 5 GHz band has OFDM rates in positions 0..7, after the
+ * four CCK rates at 2.4 GHz. Every frame's fixed rate is OFDM 6 Mbit/s, so a
+ * network without that rate is refused.
  * The gen3 software rate set reserves positions 0..5 before OFDM 6 Mbps.
  * Validate both sets before modifying outputs; this establishes no peer state.
  */
 static inline bool
-mt6797_join_legacy_rates(unsigned int supported, unsigned int basic,
+mt6797_join_legacy_rates(bool band_2g, unsigned int supported, unsigned int basic,
 			 unsigned int *desired_rates, unsigned int *basic_rates)
 {
-	if (!desired_rates || !basic_rates || !supported || (supported & ~0xffU) ||
-	    !basic || (basic & ~supported) || !(supported & 1U))
+	if (!desired_rates || !basic_rates || !supported ||
+	    (supported & ~(band_2g ? 0xfffU : 0xffU)) ||
+	    !basic || (basic & ~supported) || !(supported & (band_2g ? 0x10U : 1U)))
 		return false;
+	/* 2.4 GHz lists the four CCK rates first; they are positions 0..3. */
+	if (band_2g) {
+		*desired_rates = (supported & 15) | (supported >> 4) << 6;
+		*basic_rates = (basic & 15) | (basic >> 4) << 6;
+		return true;
+	}
 	*desired_rates = supported << 6;
 	*basic_rates = basic << 6;
 	return true;
 }
 
-/* Original payload encoders for one legacy 5 GHz, 20 MHz join. Slot indices
+/* As cnm_mem.c sets ucPhyTypeSet: OFDM at 5 GHz, ERP at 2.4 GHz, with HR/DSSS
+ * unless the basic rates are OFDM. The caller adds the HT bit.
+ */
+static inline unsigned char
+mt6797_join_phy_set(bool band_2g, unsigned int basic_rates)
+{
+	if (!band_2g)
+		return 8;
