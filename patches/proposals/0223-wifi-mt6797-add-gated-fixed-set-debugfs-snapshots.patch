From ae728f6e654947faf877e889bb1eab40f6e744be Mon Sep 17 00:00:00 2001
From: Gemini experiment <experiment@invalid>
Date: Wed, 21 Oct 2026 20:07:35 -0400
Subject: [PATCH] wifi: add a gated fixed-set debugfs snapshot mechanism

Default-off diagnostic mechanism with an empty provider. No firmware
addresses, wire encoder, setter or boot-time trigger are included.
This experiment is non-certifying and not submission-ready.
---
 drivers/net/wireless/mediatek/mt6797/Makefile |   1 +
 drivers/net/wireless/mediatek/mt6797/mac.c    |  88 +++-
 .../wireless/mediatek/mt6797/snapshot-sets.h  |  58 ++
 .../net/wireless/mediatek/mt6797/snapshot.c   | 498 ++++++++++++++++++
 .../net/wireless/mediatek/mt6797/snapshot.h   |  51 ++
 5 files changed, 693 insertions(+), 3 deletions(-)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/snapshot-sets.h
 create mode 100644 drivers/net/wireless/mediatek/mt6797/snapshot.c
 create mode 100644 drivers/net/wireless/mediatek/mt6797/snapshot.h

diff --git a/drivers/net/wireless/mediatek/mt6797/Makefile b/drivers/net/wireless/mediatek/mt6797/Makefile
index 497d0ae..25cbb25 100644
--- a/drivers/net/wireless/mediatek/mt6797/Makefile
+++ b/drivers/net/wireless/mediatek/mt6797/Makefile
@@ -12,3 +12,4 @@ obj-y += firmware-prepare.o
 obj-y += firmware-probe.o
 obj-y += record-prepare.o
 obj-$(CONFIG_MT6797_MAC80211) += mac.o
+obj-$(CONFIG_MT6797_MAC80211) += snapshot.o
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index e0465dd..9e086c6 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* MT6797 gen3 configuration and cfg80211 regulatory ownership. */
 #include <linux/etherdevice.h>
+#include <linux/err.h>
 #include <linux/completion.h>
 #include <linux/ktime.h>
 #include <linux/jiffies.h>
@@ -10,6 +11,7 @@
 #include <linux/workqueue.h>
 #include <net/mac80211.h>
 
+#include "snapshot.h"
 #include "hif.h"
 #include "mac.h"
 #include "record-prepare.h"
@@ -42,6 +44,10 @@ module_param(ccmp_stable_epoch, bool, 0444);
 MODULE_PARM_DESC(ccmp_stable_epoch,
 		 "Arm one monitor-assisted stable PTK epoch; excludes native_delivery_diag");
 #endif
+static bool snapshot_enable;
+module_param(snapshot_enable, bool, 0444);
+MODULE_PARM_DESC(snapshot_enable,
+		 "Enable fixed-set snapshots; debugfs gate defaults off");
 #include "join-tx.h"
 #include "join-commands.h"
 #ifdef CONFIG_MT6797_CCMP_TX_PID_REUSE
@@ -165,6 +171,7 @@ struct mt6797_ccmp_observation {
 
 struct mt6797_mac {
 	struct mt6797_hif *hif;
+	struct mt6797_snapshot *snapshot;
 	/* Order: RTNL -> this mutex -> HIF mutex. No CONSYS callback here. */
 	struct mutex mutex;
 	struct ieee80211_supported_band band, band_5g;
@@ -351,6 +358,57 @@ struct mt6797_mac {
 #endif
 };
 
+#if IS_ENABLED(CONFIG_MT6797_PASSIVE_SCAN) && IS_ENABLED(CONFIG_CFG80211_DEBUGFS)
+static bool mt6797_mac_snapshot_ready(void *owner)
+{
+	struct mt6797_mac *mac = owner;
+
+	/* configured is published only after firmware start and configuration. */
+	return READ_ONCE(mac->configured) && !READ_ONCE(mac->first_error) &&
+	       !READ_ONCE(mac->closing);
+}
+
+static int mt6797_mac_snapshot_empty(void *owner, u32 address,
+				   unsigned int ordinal, u64 deadline,
+				   struct mt6797_snapshot_word *word)
+{
+	return -EOPNOTSUPP;
+}
+
+static void mt6797_mac_snapshot_kick(void *owner)
+{
+	struct mt6797_mac *mac = owner;
+
+	mod_delayed_work(system_wq, &mac->join_work, 0);
+}
+
+/* Public mechanism: no ranges, wire encoding, or diagnostic command backend. */
+static const struct mt6797_snapshot_ops mt6797_mac_snapshot_ops = {
+	.ready = mt6797_mac_snapshot_ready,
+	.step = mt6797_mac_snapshot_empty,
+	.kick = mt6797_mac_snapshot_kick,
+};
+
+static void mt6797_mac_snapshot_shutdown(void *owner)
+{
+	struct mt6797_mac *mac = owner;
+	unsigned long flags;
+
+	/* Close admission and fence self-rearming before cancelling the worker. */
+	mt6797_snapshot_disable(mac->snapshot);
+	mutex_lock(&mac->mutex);
+	mac->closing = true;
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mt6797_snapshot_fail(mac->snapshot, -ENODEV);
+	mutex_unlock(&mac->mutex);
+	cancel_delayed_work_sync(&mac->join_work);
+	mt6797_snapshot_unregister(mac->snapshot);
+	mac->snapshot = NULL;
+}
+#endif
+
 #ifdef CONFIG_MT6797_CCMP_TX_PID_REUSE
 /* Mutex held; selection already owns the skb but has not submitted it. */
 static int mt6797_ccmp_assign_pid(struct mt6797_mac *mac, bool reserved)
@@ -1477,6 +1535,7 @@ static void mt6797_mac_join_close(struct mt6797_mac *mac)
 	 * rendezvous is the only admitted reset route and never reaches here.
 	 */
 	mutex_lock(&mac->mutex);
+	mt6797_snapshot_fail(mac->snapshot, -ENETDOWN);
 	mac->join_retired = true;
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
 	if (ccmp_stable_epoch)
@@ -2823,7 +2882,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	struct mt6797_scan_frame beacon;
 	struct sk_buff_head received, discard;
 	struct sk_buff *skb, *completed = NULL, *internal = NULL;
-	unsigned long flags;
+	unsigned long flags, snapshot_delay;
 	unsigned int n, port, pages;
 	u64 now, deadline, grant_end;
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
@@ -2909,8 +2968,10 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	running = mac->join_running;
 	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
-	if (!running || mac->join_retired)
+	if (!running || mac->join_retired) {
+		mt6797_snapshot_fail(mac->snapshot, -ENOLINK);
 		goto unlock;
+	}
 	now = ktime_get_ns();
 	branch = 1;
 #ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
@@ -3910,6 +3971,9 @@ management_frame:
 		if (!got)
 			break;
 	}
+	ret = mt6797_snapshot_tick(mac->snapshot);
+	if (ret)
+		goto failed;
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
 	branch = 8;
 	ret = mt6797_mac_join_cleanup_step(mac);
@@ -3935,12 +3999,15 @@ management_frame:
 		schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
 	}
 #endif
+	snapshot_delay = mt6797_snapshot_active(mac->snapshot) ?
+		1 : msecs_to_jiffies(20);
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	if (mac->join_running)
-		schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
+		schedule_delayed_work(&mac->join_work, snapshot_delay);
 	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
 	goto unlock;
 failed:
+	mt6797_snapshot_fail(mac->snapshot, ret);
 	ret = mt6797_mac_join_fail_stop(mac, ret, branch, &discard, &internal);
 unlock:
 	mutex_unlock(&mac->mutex);
@@ -5788,6 +5855,21 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 		ieee80211_unregister_hw(hw);
 		goto free_hw;
 	}
+#if IS_ENABLED(CONFIG_MT6797_PASSIVE_SCAN) && IS_ENABLED(CONFIG_CFG80211_DEBUGFS)
+	mac->snapshot = mt6797_snapshot_register(dev, hw->wiphy->debugfsdir,
+				&mt6797_mac_snapshot_ops, mac, snapshot_enable);
+	if (IS_ERR(mac->snapshot)) {
+		dev_warn(dev, "snapshot interface unavailable: %ld\n",
+			 PTR_ERR(mac->snapshot));
+		mac->snapshot = NULL;
+	} else if (mac->snapshot) {
+		ret = devm_add_action_or_reset(dev, mt6797_mac_snapshot_shutdown, mac);
+		if (ret) {
+			ieee80211_unregister_hw(hw);
+			goto free_hw;
+		}
+	}
+#endif
 	*out = hw;
 	return 0;
 free_hw:
diff --git a/drivers/net/wireless/mediatek/mt6797/snapshot-sets.h b/drivers/net/wireless/mediatek/mt6797/snapshot-sets.h
new file mode 100644
index 0000000..40eda73
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/snapshot-sets.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_SNAPSHOT_SETS_H
+#define MT6797_SNAPSHOT_SETS_H
+
+#define MT6797_SNAPSHOT_MAX_WORDS 2048U
+
+struct mt6797_snapshot_range {
+	unsigned int first;
+	unsigned int words;
+};
+
+struct mt6797_snapshot_set {
+	const char *name;
+	const struct mt6797_snapshot_range *ranges;
+	unsigned int nranges;
+};
+
+/* Zero rejects the entire table; no truncated or wrapped set is admitted. */
+static inline unsigned int
+mt6797_snapshot_set_words(const struct mt6797_snapshot_set *set)
+{
+	unsigned int total = 0, i;
+
+	if (!set || !set->name || !*set->name || !set->ranges || !set->nranges)
+		return 0;
+	for (i = 0; i < set->nranges; i++) {
+		const struct mt6797_snapshot_range *r = &set->ranges[i];
+
+		if (!r->words || (r->first & 3) ||
+		    r->words > MT6797_SNAPSHOT_MAX_WORDS - total ||
+		    r->words - 1 > (0xffffffffU - r->first) / 4)
+			return 0;
+		total += r->words;
+	}
+	return total;
+}
+
+/* Only an ordinal into an already compiled set; no userspace address input. */
+static inline int
+mt6797_snapshot_set_address(const struct mt6797_snapshot_set *set,
+			    unsigned int ordinal, unsigned int *address)
+{
+	unsigned int i;
+
+	if (!address || ordinal >= mt6797_snapshot_set_words(set))
+		return 0;
+	for (i = 0; i < set->nranges; i++) {
+		const struct mt6797_snapshot_range *r = &set->ranges[i];
+
+		if (ordinal < r->words) {
+			*address = r->first + 4 * ordinal;
+			return 1;
+		}
+		ordinal -= r->words;
+	}
+	return 0;
+}
+#endif
diff --git a/drivers/net/wireless/mediatek/mt6797/snapshot.c b/drivers/net/wireless/mediatek/mt6797/snapshot.c
new file mode 100644
index 0000000..f6a14ce
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/snapshot.c
@@ -0,0 +1,498 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded fixed-set snapshots. This file contains no firmware protocol. */
+#include <linux/capability.h>
+#include <linux/completion.h>
+#include <linux/debugfs.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/kref.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/workqueue.h>
+
+#include "snapshot.h"
+
+struct mt6797_snapshot_result {
+	struct kref ref;
+	struct completion done;
+	const struct mt6797_snapshot_set *set;
+	u64 generation, started, deadline, finished;
+	unsigned int words, total;
+	int error;
+	bool terminal;
+	__le32 data[MT6797_SNAPSHOT_MAX_WORDS];
+};
+
+struct mt6797_snapshot {
+	struct kref ref;
+	struct mutex lock;
+	struct delayed_work timeout;
+	struct dentry *dir;
+	const struct mt6797_snapshot_ops *ops;
+	void *owner;
+	struct mt6797_snapshot_result *last;
+	u64 generation;
+	unsigned int selected;
+	bool gate, dying, poisoned, abort_pending;
+};
+
+struct mt6797_snapshot_file {
+	struct mt6797_snapshot *snapshot;
+	struct mt6797_snapshot_result *result;
+	struct mutex lock;
+	char text[384];
+	unsigned int text_bytes;
+};
+
+static void mt6797_snapshot_result_free(struct kref *ref)
+{
+	kfree_sensitive(container_of(ref, struct mt6797_snapshot_result, ref));
+}
+
+static void mt6797_snapshot_free(struct kref *ref)
+{
+	struct mt6797_snapshot *s = container_of(ref, struct mt6797_snapshot, ref);
+
+	if (s->last)
+		kref_put(&s->last->ref, mt6797_snapshot_result_free);
+	kfree(s);
+}
+
+static void mt6797_snapshot_finish(struct mt6797_snapshot *s, int error)
+{
+	struct mt6797_snapshot_result *r = s->last;
+
+	if (!r || r->terminal)
+		return;
+	r->error = error;
+	r->finished = ktime_get_ns();
+	r->terminal = true;
+	if (error) {
+		s->poisoned = true;
+		s->abort_pending = true;
+	}
+	complete_all(&r->done);
+}
+
+static void mt6797_snapshot_timeout(struct work_struct *work)
+{
+	struct mt6797_snapshot *s = container_of(to_delayed_work(work),
+					struct mt6797_snapshot, timeout);
+
+	mutex_lock(&s->lock);
+	if (!s->dying && s->last && !s->last->terminal &&
+	    ktime_get_ns() >= s->last->deadline) {
+		mt6797_snapshot_finish(s, -ETIMEDOUT);
+		if (s->ops->kick)
+			s->ops->kick(s->owner);
+	}
+	mutex_unlock(&s->lock);
+}
+
+static int mt6797_snapshot_open(struct inode *inode, struct file *file)
+{
+	struct mt6797_snapshot *s = inode->i_private;
+	struct mt6797_snapshot_file *f;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	f = kzalloc(sizeof(*f), GFP_KERNEL_ACCOUNT);
+	if (!f)
+		return -ENOMEM;
+	mutex_init(&f->lock);
+	mutex_lock(&s->lock);
+	if (s->dying) {
+		mutex_unlock(&s->lock);
+		kfree(f);
+		return -ENODEV;
+	}
+	kref_get(&s->ref);
+	f->snapshot = s;
+	file->private_data = f;
+	mutex_unlock(&s->lock);
+	return nonseekable_open(inode, file);
+}
+
+static int mt6797_snapshot_release(struct inode *inode, struct file *file)
+{
+	struct mt6797_snapshot_file *f = file->private_data;
+
+	if (f->result)
+		kref_put(&f->result->ref, mt6797_snapshot_result_free);
+	kref_put(&f->snapshot->ref, mt6797_snapshot_free);
+	kfree(f);
+	return 0;
+}
+
+static ssize_t mt6797_snapshot_control_read(struct file *file, char __user *buf,
+					  size_t size, loff_t *pos)
+{
+	struct mt6797_snapshot_file *f = file->private_data;
+	struct mt6797_snapshot *s = f->snapshot;
+	char *text = f->text;
+	struct mt6797_snapshot_result *r;
+	int n;
+	ssize_t ret;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	if (mutex_lock_interruptible(&f->lock))
+		return -ERESTARTSYS;
+	if (f->text_bytes)
+		goto cached;
+	mutex_lock(&s->lock);
+	r = s->last;
+	if (!strcmp(file->f_path.dentry->d_name.name, "gate"))
+		n = scnprintf(text, sizeof(f->text), "%u\n", s->gate);
+	else if (!strcmp(file->f_path.dentry->d_name.name, "set"))
+		n = scnprintf(text, sizeof(f->text), "%s\n",
+			s->selected < s->ops->nsets ?
+			s->ops->sets[s->selected].name : "none");
+	else
+		n = scnprintf(text, sizeof(f->text),
+			"state=%s words_collected=%u total_words=%u last_error=%d generation=%llu set=%s gate=%u poisoned=%u start_ns=%llu finish_ns=%llu\n",
+			!r ? "idle" : !r->terminal ? "running" :
+			r->error ? "error" : "complete", r ? r->words : 0,
+			r ? r->total : 0, r ? r->error : 0,
+			r ? r->generation : 0, r ? r->set->name : "none",
+			s->gate, s->poisoned, r ? r->started : 0,
+			r ? r->finished : 0);
+	mutex_unlock(&s->lock);
+	f->text_bytes = n;
+cached:
+	ret = simple_read_from_buffer(buf, size, pos, text, f->text_bytes);
+	mutex_unlock(&f->lock);
+	return ret;
+}
+
+static ssize_t mt6797_snapshot_control_write(struct file *file,
+					   const char __user *buf, size_t size,
+					   loff_t *pos)
+{
+	struct mt6797_snapshot_file *f = file->private_data;
+	struct mt6797_snapshot *s = f->snapshot;
+	char name[32], *selection;
+	unsigned int i;
+	bool gate;
+	int ret;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	if (!size || size >= sizeof(name) || *pos)
+		return -EINVAL;
+	if (copy_from_user(name, buf, size))
+		return -EFAULT;
+	name[size] = 0;
+	selection = strim(name);
+	mutex_lock(&s->lock);
+	if (s->dying) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (!strcmp(file->f_path.dentry->d_name.name, "gate")) {
+		ret = kstrtobool(selection, &gate);
+		if (!ret)
+			s->gate = gate;
+		goto out;
+	}
+	if (s->last && !s->last->terminal) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = -EINVAL;
+	for (i = 0; i < s->ops->nsets; i++) {
+		if (!strcmp(selection, s->ops->sets[i].name)) {
+			s->selected = i;
+			ret = 0;
+			break;
+		}
+	}
+out:
+	mutex_unlock(&s->lock);
+	return ret ? ret : size;
+}
+
+static int mt6797_snapshot_start(struct mt6797_snapshot_file *f)
+{
+	struct mt6797_snapshot *s = f->snapshot;
+	struct mt6797_snapshot_result *r;
+	int ret;
+
+	mutex_lock(&s->lock);
+	if (s->dying) {
+		ret = -ENODEV;
+		goto out;
+	}
+	/* Gate-off reads retrieve the retained result, never issue a query. */
+	if (!s->gate) {
+		ret = s->last ? 0 : -EACCES;
+		if (!ret) {
+			f->result = s->last;
+			kref_get(&f->result->ref);
+		}
+		goto out;
+	}
+	if (s->poisoned || s->abort_pending) {
+		ret = -EIO;
+		goto out;
+	}
+	if (s->last && !s->last->terminal) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (s->selected >= s->ops->nsets) {
+		ret = -ENODATA;
+		goto out;
+	}
+	if (!s->ops->ready(s->owner)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (s->generation == U64_MAX) {
+		ret = -EOVERFLOW;
+		goto out;
+	}
+	r = kzalloc(sizeof(*r), GFP_KERNEL_ACCOUNT);
+	if (!r) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	kref_init(&r->ref);
+	init_completion(&r->done);
+	r->set = &s->ops->sets[s->selected];
+	r->total = mt6797_snapshot_set_words(r->set);
+	r->generation = ++s->generation;
+	r->started = ktime_get_ns();
+	r->deadline = r->started + (u64)MT6797_SNAPSHOT_TIMEOUT_MS * NSEC_PER_MSEC;
+	if (s->last)
+		kref_put(&s->last->ref, mt6797_snapshot_result_free);
+	s->last = r;
+	f->result = r;
+	kref_get(&r->ref);
+	mod_delayed_work(system_unbound_wq, &s->timeout,
+			 msecs_to_jiffies(MT6797_SNAPSHOT_TIMEOUT_MS));
+	if (s->ops->kick)
+		s->ops->kick(s->owner);
+	ret = 0;
+out:
+	mutex_unlock(&s->lock);
+	return ret;
+}
+
+static ssize_t mt6797_snapshot_read(struct file *file, char __user *buf,
+				    size_t size, loff_t *pos)
+{
+	struct mt6797_snapshot_file *f = file->private_data;
+	struct mt6797_snapshot_result *r;
+	struct mt6797_snapshot *s = f->snapshot;
+	long waited;
+	u64 now;
+	ssize_t ret;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	if (!size)
+		return 0;
+	if (mutex_lock_interruptible(&f->lock))
+		return -ERESTARTSYS;
+	if (!f->result) {
+		ret = mt6797_snapshot_start(f);
+		if (ret)
+			goto out;
+	}
+	r = f->result;
+	now = ktime_get_ns();
+	waited = now >= r->deadline ? 0 :
+		wait_for_completion_interruptible_timeout(&r->done,
+			nsecs_to_jiffies(r->deadline - now) + 1);
+	if (waited < 0) {
+		ret = waited;
+		goto out;
+	}
+	if (!waited) {
+		mutex_lock(&s->lock);
+		if (s->last == r) {
+			mt6797_snapshot_finish(s, -ETIMEDOUT);
+			if (s->ops->kick)
+				s->ops->kick(s->owner);
+		}
+		mutex_unlock(&s->lock);
+	}
+	if (!r->words && r->error)
+		ret = r->error;
+	else
+		ret = simple_read_from_buffer(buf, size, pos, r->data,
+					      r->words * sizeof(r->data[0]));
+out:
+	mutex_unlock(&f->lock);
+	return ret;
+}
+
+#define MT6797_SNAPSHOT_OPS(name, reader, writer) \
+static const struct file_operations name = { \
+	.owner = THIS_MODULE, .open = mt6797_snapshot_open, \
+	.release = mt6797_snapshot_release, .read = reader, .write = writer, \
+	.llseek = NULL, \
+}
+MT6797_SNAPSHOT_OPS(mt6797_snapshot_control_ops,
+		    mt6797_snapshot_control_read, mt6797_snapshot_control_write);
+MT6797_SNAPSHOT_OPS(mt6797_snapshot_status_ops,
+		    mt6797_snapshot_control_read, NULL);
+MT6797_SNAPSHOT_OPS(mt6797_snapshot_data_ops, mt6797_snapshot_read, NULL);
+
+struct mt6797_snapshot *
+mt6797_snapshot_register(struct device *dev, struct dentry *parent,
+			const struct mt6797_snapshot_ops *ops, void *owner, bool enabled)
+{
+	struct mt6797_snapshot *s;
+	struct dentry *entry;
+	unsigned int i;
+
+	if (!enabled || IS_ERR_OR_NULL(parent) || !ops || !ops->ready || !ops->step)
+		return NULL;
+	if (ops->nsets && !ops->sets)
+		return ERR_PTR(-EINVAL);
+	for (i = 0; i < ops->nsets; i++)
+		if (mt6797_snapshot_set_words(&ops->sets[i]) <= 0)
+			return ERR_PTR(-EINVAL);
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return ERR_PTR(-ENOMEM);
+	kref_init(&s->ref);
+	mutex_init(&s->lock);
+	INIT_DELAYED_WORK(&s->timeout, mt6797_snapshot_timeout);
+	s->ops = ops;
+	s->owner = owner;
+	s->selected = ops->nsets;
+	s->dir = debugfs_create_dir("mt6797_snapshot", parent);
+	if (IS_ERR_OR_NULL(s->dir)) {
+		kref_put(&s->ref, mt6797_snapshot_free);
+		return NULL;
+	}
+	entry = debugfs_create_file("set", 0600, s->dir, s, &mt6797_snapshot_control_ops);
+	if (IS_ERR_OR_NULL(entry))
+		goto fail;
+	entry = debugfs_create_file("snapshot", 0400, s->dir, s, &mt6797_snapshot_data_ops);
+	if (IS_ERR_OR_NULL(entry))
+		goto fail;
+	entry = debugfs_create_file("status", 0400, s->dir, s, &mt6797_snapshot_status_ops);
+	if (IS_ERR_OR_NULL(entry))
+		goto fail;
+	/* Gate publication is last. No read can start during partial creation. */
+	entry = debugfs_create_file("gate", 0600, s->dir, s, &mt6797_snapshot_control_ops);
+	if (IS_ERR_OR_NULL(entry))
+		goto fail;
+	return s;
+fail:
+	mt6797_snapshot_unregister(s);
+	return ERR_PTR(-ENOMEM);
+}
+
+int mt6797_snapshot_tick(struct mt6797_snapshot *s)
+{
+	struct mt6797_snapshot_word word = {};
+	struct mt6797_snapshot_result *r;
+	u32 address;
+	int ret;
+
+	if (IS_ERR_OR_NULL(s))
+		return 0;
+	mutex_lock(&s->lock);
+	if (s->dying || !s->last) {
+		mutex_unlock(&s->lock);
+		return 0;
+	}
+	r = s->last;
+	if (s->abort_pending) {
+		s->abort_pending = false;
+		ret = r->error;
+		mutex_unlock(&s->lock);
+		return s->ops->abort ? s->ops->abort(s->owner, ret) : 0;
+	}
+	if (r->terminal) {
+		mutex_unlock(&s->lock);
+		return 0;
+	}
+	kref_get(&r->ref);
+	ret = mt6797_snapshot_set_address(r->set, r->words, &address) ? 0 : -EINVAL;
+	mutex_unlock(&s->lock);
+	/* Never hold the result/control lock across a backend or command lock. */
+	if (!ret)
+		ret = s->ops->step(s->owner, address, r->words, r->deadline, &word);
+	mutex_lock(&s->lock);
+	if (!r->terminal) {
+		if (ret == -EINPROGRESS && word.valid)
+			ret = -EPROTO;
+		if (word.valid && r->words < r->total)
+			r->data[r->words++] = cpu_to_le32(word.value);
+		if (ret && ret != -EINPROGRESS)
+			mt6797_snapshot_finish(s, ret);
+		else if (!ret && !word.valid)
+			mt6797_snapshot_finish(s, -EPROTO);
+		else if (!ret && r->words == r->total)
+			mt6797_snapshot_finish(s, 0);
+	}
+	if (r->terminal)
+		ret = r->error;
+	else
+		ret = 0;
+	if (ret)
+		s->abort_pending = false;
+	mutex_unlock(&s->lock);
+	if (ret)
+		ret = s->ops->abort ? s->ops->abort(s->owner, ret) : 0;
+	kref_put(&r->ref, mt6797_snapshot_result_free);
+	return ret;
+}
+
+void mt6797_snapshot_fail(struct mt6797_snapshot *s, int error)
+{
+	if (IS_ERR_OR_NULL(s))
+		return;
+	mutex_lock(&s->lock);
+	mt6797_snapshot_finish(s, error);
+	s->abort_pending = false;
+	mutex_unlock(&s->lock);
+	if (s->ops->abort)
+		s->ops->abort(s->owner, error);
+}
+
+bool mt6797_snapshot_active(struct mt6797_snapshot *s)
+{
+	bool active;
+
+	if (IS_ERR_OR_NULL(s))
+		return false;
+	mutex_lock(&s->lock);
+	active = s->last && (!s->last->terminal || s->abort_pending);
+	mutex_unlock(&s->lock);
+	return active;
+}
+
+void mt6797_snapshot_disable(struct mt6797_snapshot *s)
+{
+	if (IS_ERR_OR_NULL(s))
+		return;
+	mutex_lock(&s->lock);
+	if (s->dying) {
+		mutex_unlock(&s->lock);
+		return;
+	}
+	s->dying = true;
+	s->gate = false;
+	mt6797_snapshot_finish(s, -ENODEV);
+	mutex_unlock(&s->lock);
+	cancel_delayed_work_sync(&s->timeout);
+	debugfs_remove_recursive(s->dir);
+}
+
+void mt6797_snapshot_unregister(struct mt6797_snapshot *s)
+{
+	if (IS_ERR_OR_NULL(s))
+		return;
+	mt6797_snapshot_disable(s);
+	kref_put(&s->ref, mt6797_snapshot_free);
+}
