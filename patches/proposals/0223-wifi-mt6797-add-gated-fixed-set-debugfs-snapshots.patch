@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_SNAPSHOT_H
+#define MT6797_SNAPSHOT_H
+
+#include <linux/types.h>
+
+#include "snapshot-sets.h"
+
+#define MT6797_SNAPSHOT_TIMEOUT_MS 60000U
+
+struct device;
+struct dentry;
+struct mt6797_snapshot;
+
+struct mt6797_snapshot_word {
+	u32 value;
+	bool valid;
+};
+
+struct mt6797_snapshot_ops {
+	const struct mt6797_snapshot_set *sets;
+	unsigned int nsets;
+	/* Pure memory predicate: no locks, I/O, or firmware effects. */
+	bool (*ready)(void *owner);
+	/* Called AFTER ordinary RX/TX service, under the driver's MAC mutex.
+	 * At most one query may be outstanding. -EINPROGRESS is not a retry.
+	 * Return a valid word once, on success or a terminal partial result.
+	 * Command locking must be per query, never across the snapshot.
+	 */
+	int (*step)(void *owner, u32 address, unsigned int ordinal, u64 deadline,
+		    struct mt6797_snapshot_word *word);
+	/* Caller holds the MAC mutex. Poison an indeterminate transaction;
+	 * neither gate toggles nor a later read may clear fatal poison.
+	 * Return a driver error only if the transport/lifetime is poisoned.
+	 */
+	int (*abort)(void *owner, int error);
+	/* Nonblocking scheduling only; must not acquire MAC/HIF locks. */
+	void (*kick)(void *owner);
+};
+
+struct mt6797_snapshot *
+mt6797_snapshot_register(struct device *dev, struct dentry *parent,
+			const struct mt6797_snapshot_ops *ops, void *owner, bool enabled);
+/* Caller has stopped the MAC worker; no backend call can race destruction. */
+void mt6797_snapshot_disable(struct mt6797_snapshot *snapshot);
+void mt6797_snapshot_unregister(struct mt6797_snapshot *snapshot);
+int mt6797_snapshot_tick(struct mt6797_snapshot *snapshot);
+void mt6797_snapshot_fail(struct mt6797_snapshot *snapshot, int error);
+bool mt6797_snapshot_active(struct mt6797_snapshot *snapshot);
+
+#endif
