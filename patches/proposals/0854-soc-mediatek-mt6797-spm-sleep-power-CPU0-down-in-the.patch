From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Tue, 24 Nov 2026 08:59:26 -0500
Subject: [PATCH] soc: mediatek: mt6797-spm-sleep: power CPU0 down in the SODI
 idle state

The SODI cpuidle state kept CPU0 powered and coherent in WFI. In that
entry the program's master pause can hang at a low CPU0 operating point,
and no operating point was found safe (stage D5, D5ap-D5ay). Powering
CPU0 down through PSCI CPU_SUSPEND, as the vendor does, removed the hang
in test periods: 15 of 15 at 221 MHz (D6a), 228 periods in the two-state
setup (D6b), and timer, Wi-Fi, display and key wakes (D6b-D6g).

Use that entry in the idle state too:
- clear flag 0 and power CPU0 down for every SODI idle entry, with the
  same checks as the test periods (CPU0 the only online CPU, every other
  core and cluster off);
- leave the RCU idle calls to arm64 cpu_suspend() on that path, which
  makes them itself;
- save and restore the timer compare values around the entry, since
  CPU0 comes back with its timer registers reset;
- set flag 13 (no resource events) from sodi_no_event, as in the
  power-down test periods, alongside sodi_keep_26m;
- rate-limit the power-down refusal messages, which the idle loop can
  repeat.

The state stays off until enabled in sysfs, and is only entered with
CPU0 alone and the backlight blank. Its exit latency and target
residency are unchanged and not yet measured for this entry.
---
 drivers/soc/mediatek/mt6797-spm-sleep.c | 35 ++++++++++++++++++-------
 1 file changed, 26 insertions(+), 9 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-spm-sleep.c b/drivers/soc/mediatek/mt6797-spm-sleep.c
index fd71c2057..c5fa655d2 100644
--- a/drivers/soc/mediatek/mt6797-spm-sleep.c
+++ b/drivers/soc/mediatek/mt6797-spm-sleep.c
@@ -6,8 +6,8 @@
  * powered in WFI (SPM_FLAG_DIS_CPU_PDN) and a PCM-timer wake. The program
  * is not part of this driver: it is read at load time from the owner's own
  * copy of the vendor file and checked against its SHA-256. No PSCI or SiP
- * call is made, except PSCI CPU_SUSPEND in SODI test periods with
- * sodi_cpu_pdn set.
+ * call is made, except PSCI CPU_SUSPEND in the SODI idle state and in
+ * SODI test periods with sodi_cpu_pdn set.
  *
  * The register sequence follows the project's analysis in
  * docs/hardware/mt6797-spm-sleep.md and the S1 write list in
@@ -1211,14 +1211,14 @@ static int spm_run(const struct spm_scen *sc)
 
 		/* The observer's CPU8 included: the vendor has CPU0 alone */
 		if (num_online_cpus() != 1) {
-			dev_info(&s.pdev->dev, "sodi pdn: %u CPUs online, refused\n",
-				 num_online_cpus());
+			dev_info_ratelimited(&s.pdev->dev, "sodi pdn: %u CPUs online, refused\n",
+					     num_online_cpus());
 			return -EBUSY;
 		}
 
 		if ((st & CPU_PWR_OTHERS) || (st2 & CPU_PWR2_OTHERS)) {
-			dev_info(&s.pdev->dev, "sodi pdn: CPU power status %08x %08x, buck iso %08x: another core or cluster is on, refused\n",
-				 st, st2, spm_rd(CPU_EXT_BUCK_ISO));
+			dev_info_ratelimited(&s.pdev->dev, "sodi pdn: CPU power status %08x %08x, buck iso %08x: another core or cluster is on, refused\n",
+					     st, st2, spm_rd(CPU_EXT_BUCK_ISO));
 			return -EBUSY;
 		}
 		s.wake.cpu_pwr = st;
@@ -1453,7 +1453,8 @@ static int spm_run(const struct spm_scen *sc)
 
 	/* C2: CPU0 waits; the PCM-return interrupt ends the sleep */
 	s.wake.cnt_kick = __arch_counter_get_cntvct();
-	if (sc->idle)
+	/* With the power-down, arm64 cpu_suspend() tells RCU itself */
+	if (sc->idle && !pdn)
 		ct_cpuidle_enter();
 	/* The loop's dsb completes these before the first WFI */
 	if (late && !pdn) {
@@ -1518,7 +1519,7 @@ static int spm_run(const struct spm_scen *sc)
 		if (mp2)
 			writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
 	}
-	if (sc->idle)
+	if (sc->idle && !pdn)
 		ct_cpuidle_exit();
 	if (crumbs)
 		dev_info(&s.pdev->dev, "sodi crumb %u: back, returned=%d loops=%u\n",
@@ -2167,6 +2168,7 @@ static int sodi_idle_enter(struct cpuidle_device *dev,
 			   struct cpuidle_driver *drv, int index)
 {
 	u64 t0 = __arch_counter_get_cntvct(), left, us, cntv, cntp;
+	u64 cntv_cval, cntp_cval;
 	enum sodi_no busy;
 	int ret;
 
@@ -2199,10 +2201,15 @@ static int sodi_idle_enter(struct cpuidle_device *dev,
 
 	cntv = read_sysreg(cntv_ctl_el0);
 	cntp = read_sysreg(cntp_ctl_el0);
+	/* CPU0 comes back from the power-down with its timer registers reset */
+	cntv_cval = read_sysreg(cntv_cval_el0);
+	cntp_cval = read_sysreg(cntp_cval_el0);
 	write_sysreg(cntv | ARCH_TIMER_CTRL_IT_MASK, cntv_ctl_el0);
 	write_sysreg(cntp | ARCH_TIMER_CTRL_IT_MASK, cntp_ctl_el0);
 	isb();
 	ret = spm_run(&s.idle);
+	write_sysreg(cntv_cval, cntv_cval_el0);
+	write_sysreg(cntp_cval, cntp_cval_el0);
 	write_sysreg(cntv, cntv_ctl_el0);
 	write_sysreg(cntp, cntp_ctl_el0);
 	isb();
@@ -2239,7 +2246,7 @@ static struct cpuidle_driver sodi_idle_driver = {
 			.target_residency = SODI_IDLE_MIN_US,
 			.flags = CPUIDLE_FLAG_RCU_IDLE | CPUIDLE_FLAG_OFF,
 			.name = "SODI",
-			.desc = "SPM SODI, CPU0 alone, dark",
+			.desc = "SODI, CPU0 alone, powered down",
 		},
 	},
 	.state_count = 2,
@@ -2304,6 +2311,16 @@ static void sodi_idle_register(void)
 	s.idle.flags = (s.flags & ~BIT(7)) | BIT(3) | SODI_FLAG_CG_MODE;
 	if (sodi_keep_26m)
 		s.idle.flags |= SODI_FLAG_KEEP_26M;
+	/* As in the power-down test periods (D6): no resource events */
+	if (sodi_no_event)
+		s.idle.flags |= SODI_FLAG_NO_EVENT;
+	/*
+	 * CPU0 powered down through PSCI, as the vendor does: with CPU0 kept
+	 * powered and coherent, the program's master pause can hang at a low
+	 * operating point (D5ap-D5ay); the power-down entry removed that (D6).
+	 */
+	s.idle.cpu_pdn = true;
+	s.idle.flags &= ~BIT(0);
 	sodi_idle_driver.cpumask = (struct cpumask *)cpumask_of(0);
 	sodi_idle_driver.state_count = clamp(sodi_idle_states, 1U, 2U);
 	ret = cpuidle_register(&sodi_idle_driver, NULL);
-- 
2.43.0

