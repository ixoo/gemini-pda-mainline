From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Tue, 24 Nov 2026 08:59:26 -0500
Subject: [PATCH] soc: mediatek: mt6797-spm-sleep: power CPU0 down in the SODI
 idle state

The SODI cpuidle state kept CPU0 powered and coherent in WFI. In that
entry the program's master pause can hang at a low CPU0 operating point,
and no operating point was found safe (stage D5, D5ap-D5ay). Powering
CPU0 down through PSCI CPU_SUSPEND, as the vendor does, removed the hang
in test periods: 15 of 15 at 221 MHz (D6a), 228 periods in the two-state
setup (D6b), and timer, Wi-Fi, display and key wakes (D6b-D6g).

Use that entry in the idle state too:
- clear flag 0 and power CPU0 down for every SODI idle entry, with the
  same checks as the test periods (CPU0 the only online CPU, now counted
  as such in the idle state's refusals, every other core and cluster
  off);
- leave the RCU idle calls to arm64 cpu_suspend() on that path, which
  makes them itself;
- save and restore the timer compare values around the entry, since
  CPU0 comes back with its timer registers reset;
- set flag 13 (no resource events) from sodi_no_event, as in the
  power-down test periods, alongside sodi_keep_26m; the idle state takes
  both at load;
- raise the state's exit latency to 5 ms and target residency to 20 ms,
  deliberately conservative: the firmware saves and restores the GIC on
  each side, and the costs are not yet measured;
- back off for 1 s after eight periods in a row shorter than 20 ms, so a
  wake source stuck on (CONN2AP with the Wi-Fi interface down) cannot
  hold CPU0 in a loop of power-down cycles;
- rate-limit the power-down refusal messages, which the idle loop can
  repeat.

The state stays off until enabled in sysfs, and is only entered with
CPU0 alone and the backlight blank.
---
 drivers/soc/mediatek/mt6797-spm-sleep.c | 93 +++++++++++++++++++------
 1 file changed, 73 insertions(+), 20 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-spm-sleep.c b/drivers/soc/mediatek/mt6797-spm-sleep.c
index fd71c2057..41b8229e5 100644
--- a/drivers/soc/mediatek/mt6797-spm-sleep.c
+++ b/drivers/soc/mediatek/mt6797-spm-sleep.c
@@ -6,8 +6,8 @@
  * powered in WFI (SPM_FLAG_DIS_CPU_PDN) and a PCM-timer wake. The program
  * is not part of this driver: it is read at load time from the owner's own
  * copy of the vendor file and checked against its SHA-256. No PSCI or SiP
- * call is made, except PSCI CPU_SUSPEND in SODI test periods with
- * sodi_cpu_pdn set.
+ * call is made, except PSCI CPU_SUSPEND in the SODI idle state and in
+ * SODI test periods with sodi_cpu_pdn set.
  *
  * The register sequence follows the project's analysis in
  * docs/hardware/mt6797-spm-sleep.md and the S1 write list in
@@ -251,7 +251,7 @@ static const u8 sodi_fw_sha256[SHA256_DIGEST_SIZE] = {
 
 static bool sodi_no_event;
 module_param(sodi_no_event, bool, 0644);
-MODULE_PARM_DESC(sodi_no_event, "SODI: set SODI_NO_EVENT, so no resource handler runs");
+MODULE_PARM_DESC(sodi_no_event, "SODI: set SODI_NO_EVENT, so no resource handler runs (the idle state takes it at load)");
 
 /*
  * SPM_FLAG_DIS_SRCCLKEN_LOW, set in the vendor's SODI flags: the program then
@@ -261,7 +261,7 @@ MODULE_PARM_DESC(sodi_no_event, "SODI: set SODI_NO_EVENT, so no resource handler
 
 static bool sodi_keep_26m;
 module_param(sodi_keep_26m, bool, 0644);
-MODULE_PARM_DESC(sodi_keep_26m, "SODI: set DIS_SRCCLKEN_LOW, so 26 MHz and infra stay forced awake");
+MODULE_PARM_DESC(sodi_keep_26m, "SODI: set DIS_SRCCLKEN_LOW, so 26 MHz and infra stay forced awake (the idle state takes it at load)");
 
 /*
  * A test period started with CPU0 at a low operating point hangs in the
@@ -1211,14 +1211,14 @@ static int spm_run(const struct spm_scen *sc)
 
 		/* The observer's CPU8 included: the vendor has CPU0 alone */
 		if (num_online_cpus() != 1) {
-			dev_info(&s.pdev->dev, "sodi pdn: %u CPUs online, refused\n",
-				 num_online_cpus());
+			dev_info_ratelimited(&s.pdev->dev, "sodi pdn: %u CPUs online, refused\n",
+					     num_online_cpus());
 			return -EBUSY;
 		}
 
 		if ((st & CPU_PWR_OTHERS) || (st2 & CPU_PWR2_OTHERS)) {
-			dev_info(&s.pdev->dev, "sodi pdn: CPU power status %08x %08x, buck iso %08x: another core or cluster is on, refused\n",
-				 st, st2, spm_rd(CPU_EXT_BUCK_ISO));
+			dev_info_ratelimited(&s.pdev->dev, "sodi pdn: CPU power status %08x %08x, buck iso %08x: another core or cluster is on, refused\n",
+					     st, st2, spm_rd(CPU_EXT_BUCK_ISO));
 			return -EBUSY;
 		}
 		s.wake.cpu_pwr = st;
@@ -1453,7 +1453,8 @@ static int spm_run(const struct spm_scen *sc)
 
 	/* C2: CPU0 waits; the PCM-return interrupt ends the sleep */
 	s.wake.cnt_kick = __arch_counter_get_cntvct();
-	if (sc->idle)
+	/* With the power-down, arm64 cpu_suspend() tells RCU itself */
+	if (sc->idle && !pdn)
 		ct_cpuidle_enter();
 	/* The loop's dsb completes these before the first WFI */
 	if (late && !pdn) {
@@ -1472,7 +1473,8 @@ static int spm_run(const struct spm_scen *sc)
 		 * waiting for CPU0's standby with flag 0 clear, and CPU0's next
 		 * WFI would let it power CPU0 off with no firmware context. So
 		 * from here to spm_restore(), whose PCM reset stops the program,
-		 * interrupts stay off and CPU0 takes no WFI.
+		 * interrupts stay off and CPU0 takes no WFI. sodi_idle_refuse()'s
+		 * WFI comes after this function returns.
 		 */
 		dsb(sy);
 		s.wake.pdn_ret = cpu_pm_enter();
@@ -1518,7 +1520,7 @@ static int spm_run(const struct spm_scen *sc)
 		if (mp2)
 			writel(axi[2], s.mcucfg + MP2_AXI_CONFIG);
 	}
-	if (sc->idle)
+	if (sc->idle && !pdn)
 		ct_cpuidle_exit();
 	if (crumbs)
 		dev_info(&s.pdev->dev, "sodi crumb %u: back, returned=%d loops=%u\n",
@@ -1837,7 +1839,7 @@ static struct i2c_adapter *spm_i2c6(void)
 enum sodi_no {
 	SODI_GO, NO_AP_DMA, NO_USB, NO_MSDC, NO_AUDIO,
 	NO_BROKEN, NO_CPUS, NO_LIT, NO_SUSPEND, NO_SHORT, NO_I2C, NO_SPM,
-	NO_PENDING, NO_COUNT
+	NO_PENDING, NO_BACKOFF, NO_COUNT
 };
 
 static const char * const sodi_no_name[NO_COUNT] = {
@@ -1847,6 +1849,7 @@ static const char * const sodi_no_name[NO_COUNT] = {
 	[NO_SUSPEND] = "suspend or test", [NO_SHORT] = "timer due",
 	[NO_I2C] = "I2C6 busy", [NO_SPM] = "PCM or modem busy",
 	[NO_PENDING] = "interrupt pending",
+	[NO_BACKOFF] = "short periods back-off",
 };
 
 static enum sodi_no sodi_busy(void)
@@ -1878,6 +1881,23 @@ static u64 sodi_timer_left(void);
 #define SODI_IDLE_EXIT_US	1000
 #define SODI_IDLE_MIN_US	2000
 
+/*
+ * The idle state with CPU0 powered down: the firmware saves and restores the
+ * GIC on each side, so entry and exit cost far more than the WFI numbers
+ * above. Deliberately conservative until measured (D7a): enter only for 20 ms
+ * or more, and end the period 5 ms before the next local timer event.
+ */
+#define SODI_PDN_EXIT_US	5000
+#define SODI_PDN_MIN_US		20000
+
+/*
+ * A wake source stuck on (CONN2AP with the Wi-Fi interface down, D6e) ends
+ * every period at once. After this many periods in a row shorter than
+ * SODI_PDN_MIN_US, the state is refused for SODI_BACKOFF_MS.
+ */
+#define SODI_SHORT_RUN		8
+#define SODI_BACKOFF_MS		1000
+
 #define SODI_HOLD_WAIT_MS	100
 
 static int sodi_hold_get(struct freq_qos_request *req,
@@ -2086,6 +2106,8 @@ static struct {
 	u64 tried, entered, refused[NO_COUNT];
 	u64 wake[ARRAY_SIZE(sodi_wake_bit)], wake_other;
 	u64 cnt_entry, cnt_sleep, cnt_exit, cnt_sleep_max;
+	u64 backoff_end, backoffs;
+	unsigned int short_run;
 	u32 cirq_hits[CIRQ_LINES];
 	int err;
 	bool broken;
@@ -2145,6 +2167,18 @@ static void sodi_idle_count(u64 t0)
 	u32 r12 = s.wake.r12, hit = 0;
 
 	st.entered++;
+	if (sleep < mul_u64_u64_div_u64(SODI_PDN_MIN_US, arch_timer_get_cntfrq(),
+					USEC_PER_SEC)) {
+		if (++st.short_run >= SODI_SHORT_RUN) {
+			st.short_run = 0;
+			st.backoffs++;
+			st.backoff_end = __arch_counter_get_cntvct() +
+				mul_u64_u64_div_u64(SODI_BACKOFF_MS, arch_timer_get_cntfrq(),
+						    MSEC_PER_SEC);
+		}
+	} else {
+		st.short_run = 0;
+	}
 	st.cnt_entry += s.wake.cnt_kick - t0;
 	st.cnt_sleep += sleep;
 	st.cnt_sleep_max = max(st.cnt_sleep_max, sleep);
@@ -2167,13 +2201,17 @@ static int sodi_idle_enter(struct cpuidle_device *dev,
 			   struct cpuidle_driver *drv, int index)
 {
 	u64 t0 = __arch_counter_get_cntvct(), left, us, cntv, cntp;
+	u64 cntv_cval, cntp_cval;
 	enum sodi_no busy;
 	int ret;
 
 	st.tried++;
 	if (st.broken)
 		return sodi_idle_refuse(NO_BROKEN);
-	if (!spm_cpus_alone())
+	if (t0 < st.backoff_end)
+		return sodi_idle_refuse(NO_BACKOFF);
+	/* The power-down needs CPU0 alone: the observer's CPU8 counts too */
+	if (num_online_cpus() != 1)
 		return sodi_idle_refuse(NO_CPUS);
 	if (!backlight_is_blank(s.bl))
 		return sodi_idle_refuse(NO_LIT);
@@ -2182,7 +2220,7 @@ static int sodi_idle_enter(struct cpuidle_device *dev,
 	left = sodi_timer_left();
 	us = left == U64_MAX ? U64_MAX :
 		mul_u64_u64_div_u64(left, USEC_PER_SEC, arch_timer_get_cntfrq());
-	if (us < SODI_IDLE_MIN_US)
+	if (us < SODI_PDN_MIN_US)
 		return sodi_idle_refuse(NO_SHORT);
 	if (!i2c_trylock_bus(s.i2c6, I2C_LOCK_ROOT_ADAPTER))
 		return sodi_idle_refuse(NO_I2C);
@@ -2192,17 +2230,22 @@ static int sodi_idle_enter(struct cpuidle_device *dev,
 		return sodi_idle_refuse(busy);
 	}
 
-	us = min_t(u64, us - SODI_IDLE_EXIT_US,
+	us = min_t(u64, us - SODI_PDN_EXIT_US,
 		   (u64)clamp(READ_ONCE(sodi_idle_max_ms), 1U, 2000U) * 1000);
 	s.idle.ticks = max_t(u64, div_u64(us * 32768, USEC_PER_SEC), 1);
 	s.idle.wake_src = (READ_ONCE(sodi_wake_src) & SODI_WAKE_SRC) | BIT(0);
 
 	cntv = read_sysreg(cntv_ctl_el0);
 	cntp = read_sysreg(cntp_ctl_el0);
+	/* CPU0 comes back from the power-down with its timer registers reset */
+	cntv_cval = read_sysreg(cntv_cval_el0);
+	cntp_cval = read_sysreg(cntp_cval_el0);
 	write_sysreg(cntv | ARCH_TIMER_CTRL_IT_MASK, cntv_ctl_el0);
 	write_sysreg(cntp | ARCH_TIMER_CTRL_IT_MASK, cntp_ctl_el0);
 	isb();
 	ret = spm_run(&s.idle);
+	write_sysreg(cntv_cval, cntv_cval_el0);
+	write_sysreg(cntp_cval, cntp_cval_el0);
 	write_sysreg(cntv, cntv_ctl_el0);
 	write_sysreg(cntp, cntp_ctl_el0);
 	isb();
@@ -2235,11 +2278,11 @@ static struct cpuidle_driver sodi_idle_driver = {
 		},
 		{
 			.enter = sodi_idle_enter,
-			.exit_latency = SODI_IDLE_EXIT_US,
-			.target_residency = SODI_IDLE_MIN_US,
+			.exit_latency = SODI_PDN_EXIT_US,
+			.target_residency = SODI_PDN_MIN_US,
 			.flags = CPUIDLE_FLAG_RCU_IDLE | CPUIDLE_FLAG_OFF,
 			.name = "SODI",
-			.desc = "SPM SODI, CPU0 alone, dark",
+			.desc = "SODI, CPU0 alone, powered down",
 		},
 	},
 	.state_count = 2,
@@ -2255,8 +2298,8 @@ static int sodi_idle_show(struct seq_file *m, void *v)
 {
 	unsigned int i;
 
-	seq_printf(m, "tried %llu\nentered %llu\nstopped %d\nerror %d\n",
-		   st.tried, st.entered, st.broken, st.err);
+	seq_printf(m, "tried %llu\nentered %llu\nstopped %d\nerror %d\nbackoffs %llu\n",
+		   st.tried, st.entered, st.broken, st.err, st.backoffs);
 	for (i = 1; i < NO_COUNT; i++)
 		seq_printf(m, "refused %s: %llu\n", sodi_no_name[i], st.refused[i]);
 	for (i = 0; i < ARRAY_SIZE(sodi_wake_bit); i++)
@@ -2304,6 +2347,16 @@ static void sodi_idle_register(void)
 	s.idle.flags = (s.flags & ~BIT(7)) | BIT(3) | SODI_FLAG_CG_MODE;
 	if (sodi_keep_26m)
 		s.idle.flags |= SODI_FLAG_KEEP_26M;
+	/* As in the power-down test periods (D6): no resource events */
+	if (sodi_no_event)
+		s.idle.flags |= SODI_FLAG_NO_EVENT;
+	/*
+	 * CPU0 powered down through PSCI, as the vendor does: with CPU0 kept
+	 * powered and coherent, the program's master pause can hang at a low
+	 * operating point (D5ap-D5ay); the power-down entry removed that (D6).
+	 */
+	s.idle.cpu_pdn = true;
+	s.idle.flags &= ~BIT(0);
 	sodi_idle_driver.cpumask = (struct cpumask *)cpumask_of(0);
 	sodi_idle_driver.state_count = clamp(sodi_idle_states, 1U, 2U);
 	ret = cpuidle_register(&sodi_idle_driver, NULL);
-- 
