From 54de752b93e248cca4932a8a21923659c898c3ab Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 09:52:47 -0400
Subject: [PATCH 3/4] wifi: mt6797: retire ordinary data frames on credit
 arrival

Every ordinary data descriptor requests a transmit-status report to the
MCU with a PID, and the frame is retired on the firmware's TX-done event
received through the receive path, about 6 ms after the bus write once the
air time is taken out (the 54 Mbit/s sweep). The vendor sets the PID and
the MCU report together only for frames with a completion handler
(nicTxFillDesc) and releases plain data's transmit resources on the page
counts the firmware returns (nicTxReleaseResource); it never retires a
frame at the bus write, and the first attempt at this lever (0272), which
did, lost the bound on the frames the firmware held for the air and
collapsed the receive direction.

Behind CONFIG_MT6797_DATA_CREDIT_RETIRE an ordinary data frame goes out
without a PID or a status report and is retired when the TC1 page credits
returned since the frames submitted before it cover its own pages, in
submission order; the in-flight depth stays the bound, the 750 ms slot
deadline the backstop (an expired frame frees its host PID and counts as
failed), and pages left over with no frame in flight are dropped so a
frame is never retired by credits that preceded it. mac80211 is told the
frame was transmitted without an acknowledgment report, never a loss.
Management and security frames keep their PID, their report and the
TX-done event. The instrument: four early retire records and one line at
the data end with the count, the expiries, the PID-pool faults, the mean
and maximum wait from submission to retirement, the unmatched pages and
the deepest in-flight count. A measurement variable for the transmit
completion latency; nothing changes with the option off.
---
 drivers/net/wireless/mediatek/mt6797/Kconfig  |  13 ++
 drivers/net/wireless/mediatek/mt6797/hif.c    |  27 +++-
 drivers/net/wireless/mediatek/mt6797/hif.h    |   5 +
 .../net/wireless/mediatek/mt6797/join-depth.h |  57 +++++++-
 .../wireless/mediatek/mt6797/join-submit.h    |  31 +++-
 .../net/wireless/mediatek/mt6797/join-tx.h    |  35 ++++-
 drivers/net/wireless/mediatek/mt6797/mac.c    | 138 +++++++++++++++++-
 7 files changed, 275 insertions(+), 31 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 2cc6f8136..4d204f1e5 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -129,6 +129,19 @@ config MT6797_DATA_FIXED_RATE_CODE
 	  variable for the per-frame air time; the default is the rate the
 	  series has always used.
 
+config MT6797_DATA_CREDIT_RETIRE
+	bool "MT6797 Wi-Fi: retire ordinary data frames on credit arrival"
+	depends on MT6797_CCMP_TX_PID_REUSE && MT6797_CCMP_TX_PUMP
+	help
+	  Send ordinary data descriptors without a PID or the MCU transmit
+	  status report, as the vendor does for frames without a completion
+	  handler, and retire each frame when the TC1 page credits the
+	  firmware returns cover it, in submission order; the in-flight depth
+	  stays the bound and the 750 ms slot deadline the backstop. Never
+	  retired at submission. Management and security frames keep their
+	  reports and the TX done event. A measurement variable for the
+	  transmit completion latency, with its own record on the data end.
+
 config MT6797_CCMP_TX_DEPTH
 	int
 	depends on MT6797_CCMP_TX_PUMP
