 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/join-tx.h b/drivers/net/wireless/mediatek/mt6797/join-tx.h
index 66a13d82a..eec4321bb 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-tx.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-tx.h
@@ -142,17 +142,24 @@ mt6797_join_tx_security_descriptor(const unsigned char *frame, size_t bytes,
  * type or subtype is encoded. No transport, lifetime or admission here.
  */
 static inline bool
-mt6797_join_tx_data_descriptor(const unsigned char *frame, size_t bytes,
-			       unsigned char wlan, unsigned char pid,
-			       unsigned int lifetime_ms, unsigned int attempt_count,
-			       unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
-			       unsigned int *pages)
+mt6797_join_tx_data_descriptor_report(const unsigned char *frame, size_t bytes,
+				      unsigned char wlan, unsigned char pid,
+				      bool status_report,
+				      unsigned int lifetime_ms, unsigned int attempt_count,
+				      unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+				      unsigned int *pages)
 {
 	unsigned char d[MT6797_JOIN_TX_DESC_BYTES] = {0};
 	unsigned int lifetime, total, count, i;
 
+	/* Without a status report the descriptor carries no PID: the vendor
+	 * sets the PID and the MCU report together, only for frames with a
+	 * completion handler (nicTxFillDesc), and releases plain data on the
+	 * page counts.
+	 */
 	if (!frame || !output || !pages || bytes < MT6797_JOIN_ETH_MIN_BYTES ||
-	    bytes > MT6797_JOIN_ETH_MAX_BYTES || wlan > 30 || !pid || pid > 127 ||
+	    bytes > MT6797_JOIN_ETH_MAX_BYTES || wlan > 30 ||
+	    (status_report ? (!pid || pid > 127) : pid != 0) ||
 	    !lifetime_ms || lifetime_ms > 10000 || !attempt_count || attempt_count > 30)
 		return false;
 	if ((frame[6] & 1) || (frame[12] == 0x88 && frame[13] == 0x8e))
@@ -175,7 +182,9 @@ mt6797_join_tx_data_descriptor(const unsigned char *frame, size_t bytes,
 	/* Fixed rate enabled unless the code is 0, zero power offset. */
 	d[11] = MT6797_DATA_FIXED_RATE_CODE ? 0x80 : 0;
 	d[12] = count; d[13] = count >> 8;
-	d[20] = pid; d[21] = 2; /* TX status to MCU. */
+	if (status_report) {
+		d[20] = pid; d[21] = 2; /* TX status to MCU. */
+	}
 	d[26] = (MT6797_DATA_FIXED_RATE_CODE << 2) & 255;
 	d[27] = (MT6797_DATA_FIXED_RATE_CODE << 2) >> 8;
 	for (i = 0; i < MT6797_JOIN_TX_DESC_BYTES; i++)
@@ -183,4 +192,16 @@ mt6797_join_tx_data_descriptor(const unsigned char *frame, size_t bytes,
 	*pages = (total + 127U) / 128U;
 	return true;
 }
+
+static inline bool
+mt6797_join_tx_data_descriptor(const unsigned char *frame, size_t bytes,
+			       unsigned char wlan, unsigned char pid,
+			       unsigned int lifetime_ms, unsigned int attempt_count,
+			       unsigned char output[MT6797_JOIN_TX_DESC_BYTES],
+			       unsigned int *pages)
+{
+	return mt6797_join_tx_data_descriptor_report(frame, bytes, wlan, pid, true,
+						     lifetime_ms, attempt_count,
+						     output, pages);
+}
 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index fd5c3ebf2..311d9f637 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -396,6 +396,17 @@ struct mt6797_mac {
 	 * pages owed on that pool, counts, and the in-flight frame's class.
 	 */
 	unsigned int join_data_page_debt, join_data_tx_queued, join_data_tx_done;
+#ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
+	/* Ordinary data retired on credit arrival: the pages returned and not
+	 * yet matched to a frame, the counts, the wait from submission to
+	 * retirement, and the retired frames the worker has yet to report.
+	 */
+	struct sk_buff_head credit_retired_queue;
+	unsigned int credit_retire_pages, credit_retired, credit_retire_ordinal;
+	unsigned int credit_retire_records, credit_retire_expired;
+	unsigned int credit_retire_pid_faults, credit_retire_inflight_max;
+	u64 credit_retire_wait_sum_ns, credit_retire_wait_max_ns;
+#endif
 	unsigned int join_data_tx_failed, join_data_tx_failures_in_row;
 	unsigned int join_data_expired;
 	bool join_inflight_data;
@@ -1780,6 +1791,17 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_data_tx_failed = 0;
 	mac->join_data_tx_failures_in_row = 0;
 	mac->join_data_expired = 0;
+#ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
+	mac->credit_retire_pages = 0;
+	mac->credit_retired = 0;
+	mac->credit_retire_ordinal = 0;
+	mac->credit_retire_records = 0;
+	mac->credit_retire_expired = 0;
+	mac->credit_retire_pid_faults = 0;
+	mac->credit_retire_inflight_max = 0;
+	mac->credit_retire_wait_sum_ns = 0;
+	mac->credit_retire_wait_max_ns = 0;
+#endif
 	mac->join_inflight_data = false;
 	mac->join_last_acked = false;
 	mac->join_credit_pending = false;
@@ -1873,6 +1895,10 @@ static void mt6797_mac_join_close(struct mt6797_mac *mac)
 	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
 	while ((skb = mt6797_data_pop(&mac->data_slots)))
 		__skb_queue_tail(&discard, skb);
+#ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
+	while ((skb = skb_dequeue(&mac->credit_retired_queue)))
+		__skb_queue_tail(&discard, skb);
+#endif
 	if (mac->join_inflight) {
 		__skb_queue_tail(&discard, mac->join_inflight);
 		mac->join_inflight = NULL;
@@ -1890,6 +1916,55 @@ static void mt6797_mac_join_close(struct mt6797_mac *mac)
 	}
 }
 
+#ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
+/* Ordinary data goes out without a PID or an MCU status report and is
+ * retired here, on the TC1 page credits the firmware returns, in submission
+ * order: a frame is retired when the pages returned since the frames before
+ * it cover its own pages. The vendor releases its transmit resources on
+ * these counts (nicTxReleaseResource) and never retires plain data at the
+ * bus write; the first attempt at this lever (0272) retired at submission
+ * and lost the in-flight bound. Pages left over with no frame in flight are
+ * dropped, so a frame is never retired by credits that preceded it; a frame
+ * the credits never cover expires on its slot deadline. mac80211 is told
+ * the frame was transmitted without an acknowledgment report. Caller holds
+ * mac->mutex.
+ */
+static void mt6797_mac_credit_retire(struct mt6797_mac *mac, unsigned int pages)
+{
+	struct mt6797_data_owner taken;
+	struct sk_buff *skb;
+	u64 now = ktime_get_ns();
+
+	mac->credit_retire_pages += pages;
+	while ((skb = mt6797_data_take_oldest(&mac->data_slots,
+					      mac->credit_retire_pages, &taken))) {
+		u64 wait = now > taken.submitted ? now - taken.submitted : 0;
+
+		mac->credit_retire_pages -= taken.pages;
+		if (!mt6797_join_pid_complete(&mac->ccmp_pid_pool, taken.pid))
+			mac->credit_retire_pid_faults++;
+		mac->credit_retired++;
+		mac->join_data_tx_done++;
+		mac->join_data_tx_failures_in_row = 0;
+		mac->credit_retire_wait_sum_ns += wait;
+		if (wait > mac->credit_retire_wait_max_ns)
+			mac->credit_retire_wait_max_ns = wait;
+		if (mac->credit_retire_records < 4) {
+			mac->credit_retire_records++;
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join data credit retire: pid=%u pages=%u wait_us=%llu left_pages=%u inflight=%u\n",
+				 taken.pid, taken.pages, wait / NSEC_PER_USEC,
+				 mac->credit_retire_pages, mac->data_slots.count);
+		}
+		ieee80211_tx_info_clear_status(IEEE80211_SKB_CB(skb));
+		IEEE80211_SKB_CB(skb)->flags |= IEEE80211_TX_STAT_NOACK_TRANSMITTED;
+		skb_queue_tail(&mac->credit_retired_queue, skb);
+	}
+	if (!mt6797_data_credit_outstanding(&mac->data_slots))
+		mac->credit_retire_pages = 0;
+}
+#endif
+
 static int mt6797_mac_join_guard(struct mt6797_mac *mac, u64 deadline)
 {
 	struct mt6797_hif_tx_status status = {0};
@@ -1947,6 +2022,9 @@ static int mt6797_mac_join_guard(struct mt6797_mac *mac, u64 deadline)
 		mac->join_data_page_debt -= account.tc1_released;
 		if (account.tc1_released) {
 			mac->join_data_credits += account.tc1_released;
+#ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
+			mt6797_mac_credit_retire(mac, account.tc1_released);
+#endif
 			if (mac->join_data_credit_records < MT6797_JOIN_DATA_CREDIT_RECORDS) {
 				mac->join_data_credit_records++;
 				dev_info(wiphy_dev(mac->hw->wiphy),
@@ -2906,6 +2984,16 @@ static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 		 mac->ccmp_rx_delivered,
 		 mac->join_data_tx_queued, mac->join_data_tx_done, mac->join_data_tx_failed,
 		 mac->join_data_credits);
+#ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join data credit retire end: retired=%u expired=%u pid_faults=%u wait_avg_us=%llu wait_max_us=%llu left_pages=%u inflight_max=%u\n",
+		 mac->credit_retired, mac->credit_retire_expired,
+		 mac->credit_retire_pid_faults,
+		 mac->credit_retired ? mac->credit_retire_wait_sum_ns /
+		 mac->credit_retired / NSEC_PER_USEC : 0,
+		 mac->credit_retire_wait_max_ns / NSEC_PER_USEC,
+		 mac->credit_retire_pages, mac->credit_retire_inflight_max);
+#endif
 	{
