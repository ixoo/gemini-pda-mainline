diff --git a/drivers/net/wireless/mediatek/mt6797/join-depth.h b/drivers/net/wireless/mediatek/mt6797/join-depth.h
index 6c37559e3..d4b499568 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-depth.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-depth.h
@@ -12,6 +12,11 @@ struct mt6797_data_owner {
 	void *frame;
 	unsigned long long deadline;
 	unsigned char pid;
+	/* A frame retired on credit arrival: the pages it was charged, its
+	 * submission order and time; zero pages for a frame with a status report.
+	 */
+	unsigned int pages, ordinal;
+	unsigned long long submitted;
 };
 
 struct mt6797_data_slots {
@@ -48,7 +53,9 @@ mt6797_data_put(struct mt6797_data_slots *s, unsigned char pid, void *frame,
 		return false;
 	for (i = 0; i < MT6797_DATA_DEPTH; i++) {
 		if (!s->owner[i].frame) {
-			s->owner[i] = (struct mt6797_data_owner){frame, deadline, pid};
+			s->owner[i] = (struct mt6797_data_owner){ .frame = frame,
+								  .deadline = deadline,
+								  .pid = pid };
 			s->count++;
 			return true;
 		}
@@ -56,6 +63,23 @@ mt6797_data_put(struct mt6797_data_slots *s, unsigned char pid, void *frame,
 	return false;
 }
 
+/* Put a frame that will be retired on credit arrival, with its pages. */
+static inline bool
+mt6797_data_put_credit(struct mt6797_data_slots *s, unsigned char pid, void *frame,
+		       unsigned long long deadline, unsigned int pages,
+		       unsigned int ordinal, unsigned long long submitted)
+{
+	struct mt6797_data_owner *o;
+
+	if (!pages || !mt6797_data_put(s, pid, frame, deadline))
+		return false;
+	o = mt6797_data_find(s, pid);
+	o->pages = pages;
+	o->ordinal = ordinal;
+	o->submitted = submitted;
+	return true;
+}
+
 static inline void *mt6797_data_take(struct mt6797_data_slots *s, unsigned char pid)
 {
 	struct mt6797_data_owner *o = mt6797_data_find(s, pid);
@@ -94,6 +118,37 @@ mt6797_data_take_expired(struct mt6797_data_slots *s, unsigned long long now,
 	return NULL;
 }
 
+/* The oldest credit-retired frame (lowest ordinal) whose pages the credits
+ * cover, taken out of its slot with a copy of its owner; NULL when none.
+ */
+static inline void *
+mt6797_data_take_oldest(struct mt6797_data_slots *s, unsigned int credit_pages,
+			struct mt6797_data_owner *copy)
+{
+	const struct mt6797_data_owner *oldest = NULL;
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame && s->owner[i].pages &&
+		    (!oldest || s->owner[i].ordinal < oldest->ordinal))
+			oldest = &s->owner[i];
+	if (!oldest || oldest->pages > credit_pages)
+		return NULL;
+	*copy = *oldest;
+	return mt6797_data_take(s, copy->pid);
+}
+
+static inline bool
+mt6797_data_credit_outstanding(const struct mt6797_data_slots *s)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6797_DATA_DEPTH; i++)
+		if (s->owner[i].frame && s->owner[i].pages)
+			return true;
+	return false;
+}
+
 static inline bool
 mt6797_data_expired(const struct mt6797_data_slots *s, unsigned long long now)
 {
diff --git a/drivers/net/wireless/mediatek/mt6797/join-submit.h b/drivers/net/wireless/mediatek/mt6797/join-submit.h
