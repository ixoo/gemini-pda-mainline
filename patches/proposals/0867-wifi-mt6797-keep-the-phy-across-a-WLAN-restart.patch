 	if (mac->ccmp_loss_deferred) {
 		mac->ccmp_loss_deferred = false;
@@ -2422,6 +2446,120 @@ static int mt6797_mac_load_record(struct mt6797_mac *mac,
 	return ret;
 }
 
+/* Called with RTNL and the mutex held. */
+static int mt6797_mac_configure(struct mt6797_mac *mac,
+				const struct mt6797_wifi_record *record,
+				bool reattach)
+{
+	int ret;
+
+	/* An earlier layer may have left the monitor mask on. */
+	mac->monitor_left_on = reattach;
+	/* A re-attach finds the firmware configured; never replay the record.
+	 * The country may have changed while no driver was loaded, and the
+	 * notifier compares later updates with what this instance sent.
+	 */
+	if (reattach) {
+		mac->configured = true;
+		ret = mt6797_mac_send_regulatory(mac);
+	} else {
+		ret = mt6797_mac_load_record(mac, record);
+	}
+	if (ret) {
+		mac->first_error = ret;
+		mac->closing = true;
+	}
+	return ret;
+}
+
+/*
+ * A restart's first half. The firmware lifetime ends and the phy stays
+ * registered: an associated interface is disconnected while the firmware is
+ * still there, the join and the scan close as a stop closes them, and then
+ * nothing is left to reach the HIF, which CONSYS frees. The interface itself
+ * stays as mac80211 has it.
+ */
+static void mt6797_mac_halt(struct ieee80211_hw *hw)
+{
+	struct mt6797_mac *mac = hw->priv;
+
+	wiphy_lock(hw->wiphy);
+	if (mac->vif && mac->vif->cfg.assoc) {
+		ieee80211_connection_loss(mac->vif);
+		wiphy_work_flush(hw->wiphy, NULL);
+	}
+	mt6797_mac_join_close(mac);
+	mt6797_mac_cancel_scan(hw, NULL);
+	mutex_lock(&mac->mutex);
+	WRITE_ONCE(mac->halted, true);
+	mac->closing = true;
+	if (!mac->first_error)
+		mac->first_error = -ESHUTDOWN;
+	mac->scan_ready = false;
+	mutex_unlock(&mac->mutex);
+	if (mac->irq > 0)
+		disable_irq(mac->irq);
+	cancel_delayed_work_sync(&mac->ccmp_loss_work);
+	cancel_work_sync(&mac->ps_work);
+	cancel_delayed_work_sync(&mac->scan_work);
+	cancel_delayed_work_sync(&mac->join_work);
+	if (mac->irq > 0)
+		free_irq(mac->irq, mac);
+	mac->irq = 0;
+	skb_queue_purge(&mac->join_queue);
+	skb_queue_purge(&mac->credit_retired_queue);
+	mutex_lock(&mac->mutex);
+	mac->hif = NULL;
+	mutex_unlock(&mac->mutex);
+	wiphy_unlock(hw->wiphy);
+	dev_info(wiphy_dev(hw->wiphy), "WLAN lifetime halted; phy kept\n");
+}
+
+/*
+ * A restart's second half: the kept phy gets the new firmware. The lifetime
+ * starts from zero as a registration's does; mac80211's interface, the bands
+ * and its settings stay. Under the wiphy lock no mac80211 call runs, and
+ * the queue lock keeps the transmit path out while the lifetime is cleared.
+ */
+static int mt6797_mac_resume(struct device *dev, struct ieee80211_hw *hw,
+			     struct mt6797_hif *hif,
+			     const struct mt6797_wifi_record *record,
+			     bool reattach, int sequence)
+{
+	struct mt6797_mac *mac = hw->priv;
+	unsigned long flags;
+	int ret;
+
+	rtnl_lock();
+	wiphy_lock(hw->wiphy);
+	mutex_lock(&mac->mutex);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	memset(&mac->lifetime, 0, sizeof(mac->lifetime));
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mac->hif = hif;
+	mac->sequence = sequence;
+	mac->join_next_pid = 1;
+	mac->ccmp_pid_pool.next = 1;
+	reinit_completion(&mac->join_channel_done);
+	reinit_completion(&mac->join_sta_done);
+	reinit_completion(&mac->join_credit_done);
+	reinit_completion(&mac->join_frame_done);
+	reinit_completion(&mac->ccmp_key_done);
+	reinit_completion(&mac->ccmp_cleanup_done);
+	reinit_completion(&mac->ccmp_dtim_done);
+	WRITE_ONCE(mac->halted, false);
+	ret = mt6797_mac_configure(mac, record, reattach);
+	mutex_unlock(&mac->mutex);
+	wiphy_unlock(hw->wiphy);
+	rtnl_unlock();
+	if (!ret) {
+		mac->irq = mt6797_mac_request_irq(dev, mac);
+		dev_info(dev, "one-shot WLAN interrupt: irq=%d\n", mac->irq);
+	}
+	dev_info(dev, "WLAN lifetime resumed on the kept phy: status=%d\n", ret);
+	return ret;
+}
+
 static int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 			       const struct mt6797_normal_capability *capability,
 			       const struct mt6797_wifi_record *record, bool reattach,
@@ -2441,7 +2579,6 @@ static int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 
 	if (!out)
 		return -EINVAL;
-	*out = NULL;
 	if (!dev || !hif || !capability || !record)
 		return -EINVAL;
 	if (capability->product != 0x6797 || capability->firmware_own != 0x0403 ||
@@ -2460,6 +2597,8 @@ static int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 			return sequence;
 		sequence = max(sequence, 5);
 	}
+	if (*out)
+		return mt6797_mac_resume(dev, *out, hif, record, reattach, sequence);
 	hw = ieee80211_alloc_hw(sizeof(*mac), &mt6797_mac_ops);
 	if (!hw)
 		return -ENOMEM;
@@ -2579,22 +2718,7 @@ static int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 	 */
 	rtnl_lock();
 	mutex_lock(&mac->mutex);
-	/* An earlier layer may have left the monitor mask on. */
-	mac->monitor_left_on = reattach;
-	/* A re-attach finds the firmware configured; never replay the record.
-	 * The country may have changed while no driver was loaded, and the
-	 * notifier compares later updates with what this instance sent.
-	 */
-	if (reattach) {
-		mac->configured = true;
-		ret = mt6797_mac_send_regulatory(mac);
-	} else {
-		ret = mt6797_mac_load_record(mac, record);
-	}
-	if (ret) {
-		mac->first_error = ret;
-		mac->closing = true;
-	}
+	ret = mt6797_mac_configure(mac, record, reattach);
 	mutex_unlock(&mac->mutex);
 	rtnl_unlock();
 	if (ret) {
@@ -2645,6 +2769,7 @@ const struct mt6797_mac_ops mt6797_mac_attach_ops = {
 	.reg = mt6797_mac_register,
 	.scan_ready = mt6797_mac_scan_ready,
 	.unreg = mt6797_mac_unregister,
+	.halt = mt6797_mac_halt,
 };
 
 #if IS_MODULE(CONFIG_MT6797_MAC80211)
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index a6bf864a5..9e6bc8af3 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -1081,7 +1081,8 @@ static void mt6797_consys_wlan_detach_now(const struct mt6797_mac_ops *ops)
 	mutex_lock(&mt6797_consys_wlan_lock);
 	if (owner->wlan_pending == ops)
 		owner->wlan_pending = NULL;
-	if (owner->wlan_attached && owner->wlan_hw) {
+	/* A halted phy is kept without being attached. */
+	if (owner->wlan_hw) {
 		ops->unreg(owner->wlan_hw);
 		owner->wlan_hw = NULL;
 		owner->wlan_attached = false;
@@ -1090,6 +1091,21 @@ static void mt6797_consys_wlan_detach_now(const struct mt6797_mac_ops *ops)
 	mutex_unlock(&mt6797_consys_wlan_lock);
 }
 
+/* End the firmware lifetime and keep the phy: no layer is attached until the
+ * restart attaches the kept phy again.
+ */
+static void mt6797_consys_wlan_halt_now(const struct mt6797_mac_ops *ops)
+{
+	struct mt6797_consys *owner = &mt6797_consys;
+
+	mutex_lock(&mt6797_consys_wlan_lock);
+	if (owner->wlan_attached && owner->wlan_hw) {
+		ops->halt(owner->wlan_hw);
+		owner->wlan_attached = false;
+	}
+	mutex_unlock(&mt6797_consys_wlan_lock);
+}
+
 static void mt6797_consys_wlan_restart_work(struct work_struct *work);
 static DECLARE_DELAYED_WORK(mt6797_consys_wlan_restart, mt6797_consys_wlan_restart_work);
 
@@ -1100,10 +1116,11 @@ void mt6797_consys_wlan_detach(const struct mt6797_mac_ops *ops)
 }
 EXPORT_SYMBOL_GPL(mt6797_consys_wlan_detach);
 
-/* What a module reload did by hand: detach the mac layer, unbind and bind
- * CONSYS, which powers CONN off and starts the firmware afresh, and attach
- * again once it is ready. wlan0 comes back as a new interface. A fault during
- * the start or the attach leaves Wi-Fi down; nothing here retries.
+/* What a module reload did by hand, with the phy kept: halt the mac layer,
+ * unbind and bind CONSYS, which powers CONN off and starts the firmware afresh,
+ * and attach the kept phy again once it is ready. wlan0 stays the same
+ * interface, so rfkill and userspace see no device leave. A fault during the
+ * start or the attach leaves Wi-Fi down; nothing here retries.
  */
 static void mt6797_consys_wlan_restart_work(struct work_struct *work)
 {
@@ -1121,7 +1138,7 @@ static void mt6797_consys_wlan_restart_work(struct work_struct *work)
 		return;
 	}
 	dev_info(dev, "WLAN restart: begin\n");
-	mt6797_consys_wlan_detach_now(ops);
+	mt6797_consys_wlan_halt_now(ops);
 	ret = device_reprobe(dev);
 	if (!ret)
 		ret = mt6797_consys_wlan_attach(ops);
