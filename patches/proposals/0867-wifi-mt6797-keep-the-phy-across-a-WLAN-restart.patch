 	mt6797_mac_join_send_ps(mac);
 	mutex_unlock(&mac->mutex);
@@ -1928,6 +1950,8 @@ static void mt6797_mac_loss_work(struct work_struct *work)
 	struct mt6797_mac *mac = container_of(work, struct mt6797_mac,
 					      ccmp_loss_work.work);
 
