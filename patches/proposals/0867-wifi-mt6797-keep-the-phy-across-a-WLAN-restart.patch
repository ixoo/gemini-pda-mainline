 /* A passive scan interface is not an associated station or a data path. */
+/* Called with the mutex held. A restart is requested once per lifetime; false
+ * when CONSYS is built in and cannot restart.
+ */
+bool mt6797_mac_request_restart(struct mt6797_mac *mac)
+{
+	if (!IS_MODULE(CONFIG_MTK_MT6797_CONSYS))
+		return false;
+	if (!mac->restart_pending) {
+		mac->restart_pending = true;
+		mt6797_consys_wlan_request_restart();
+	}
+	return true;
+}
