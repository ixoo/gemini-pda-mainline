 				size_t frame_bytes, u8 wlan, u8 pid,
 				bool status_report,
 				unsigned int lifetime_ms, unsigned int attempt_count,
-				u64 deadline_ns)
+				const struct mt6797_tx_rate *rate, u64 deadline_ns)
 {
 	struct mt6797_hif_pio_result transfer;
 	struct mt6797_hif_command command;
@@ -1757,6 +1757,9 @@ int mt6797_hif_send_data_report(struct mt6797_hif *hif, const u8 *frame,
 	if (hif->data_sgi && ((mt6797_hif_data_rate(hif) >> 6) & 7) == 2)
 		hif->scratch[27] |= 0x80;
 #endif
+	/* mac80211's rate control choice for this frame, over all of those. */
+	if (rate)
+		mt6797_tx_rate_descriptor(rate, hif->scratch);
 	error = mt6797_hif_enter(hif, deadline_ns);
 	if (error)
 		goto fail;
@@ -1817,7 +1820,7 @@ int mt6797_hif_send_data(struct mt6797_hif *hif, const u8 *frame,
 			 u64 deadline_ns)
 {
 	return mt6797_hif_send_data_report(hif, frame, frame_bytes, wlan, pid, true,
-					   lifetime_ms, attempt_count, deadline_ns);
+					   lifetime_ms, attempt_count, NULL, deadline_ns);
 }
 
