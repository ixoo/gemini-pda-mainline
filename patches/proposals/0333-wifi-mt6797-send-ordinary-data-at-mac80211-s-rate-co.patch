@@ -115,11 +118,13 @@ mt6797_testcfg_item(const char *s, size_t n, const struct mt6797_testcfg *base,
 		if (!v)
 			return "rate code 0";
 		c->rate = v;
+		c->minstrel = false;
+		return NULL;
+	}
+	if (mt6797_testcfg_is(s, n, "rate=minstrel")) {
+		c->minstrel = true;
