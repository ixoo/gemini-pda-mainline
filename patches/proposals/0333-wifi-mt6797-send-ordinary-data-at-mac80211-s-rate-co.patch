 mt6797_testcfg_item(const char *s, size_t n, const struct mt6797_testcfg *base,
@@ -69,6 +71,7 @@ mt6797_testcfg_item(const char *s, size_t n, const struct mt6797_testcfg *base,
 	    s[3] >= '0' && s[3] <= '7') {
 		c->txbw40 = s[0] == '4';
 		c->rate = 0x80 | (s[3] - '0');
+		c->minstrel = false;
 		return NULL;
 	}
