 drivers/net/wireless/mediatek/mt6797/mac.c    | 103 ++++++++++++++++--
 .../wireless/mediatek/mt6797/testcfg-parse.h  |  15 ++-
 .../net/wireless/mediatek/mt6797/testcfg.c    |   5 +-
 .../net/wireless/mediatek/mt6797/tx-rate.h    |  60 ++++++++++
 7 files changed, 190 insertions(+), 19 deletions(-)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/tx-rate.h

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index c0f441ec0..e9642d100 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -118,7 +118,7 @@ config MT6797_WIFI_TESTCONFIG
 	  them and starts the schedule again. An entry is items joined by
 	  '+': 20M<k> or 40M<k> (HT MCS k at that transmit width),
 	  txbw=20|40, rxbw=20|40 (the advertised width and the join accepted),
-	  rate=fixed:0xNN, sgi[=0|1], agg=0|1 (receive A-MPDU), peek=0|1 or
+	  rate=fixed:0xNN, rate=minstrel (mac80211's rate control), sgi[=0|1], agg=0|1 (receive A-MPDU), peek=0|1 or
 	  default, each over the build's configuration.
 	  An empty schedule is the build throughout; a refused entry keeps the
 	  previous configuration, and a lifetime that did not end cleanly is
@@ -126,6 +126,19 @@ config MT6797_WIFI_TESTCONFIG
 	  transmit rate-word and attempt, and receive rate records. Off for
 	  normal use: no debugfs directory and none of those records.
 
+config MT6797_DATA_RATE_CONTROL
+	bool "MT6797 Wi-Fi: ordinary data at mac80211's rate control choice"
+	depends on MT6797_STATION_JOIN
+	help
+	  Send each ordinary data frame at the rate mac80211's rate control
+	  (minstrel_ht) chose for it, with its width and guard interval,
+	  instead of the fixed rate code, and report that rate and the MCU's
+	  attempt count in the frame's status. With credit retire only the
+	  sampled frames and the rate control's probes carry a status report,
+	  so the rate control learns from those. Management, security and
+	  EAPOL frames keep their fixed rate. In a measurement build this is
+	  the build's configuration; rate=minstrel selects it per join.
+
 config MT6797_WIFI_TESTCONFIG_SCHEDULE
 	string "MT6797 Wi-Fi measurement build: the schedule at boot"
 	depends on MT6797_WIFI_TESTCONFIG
