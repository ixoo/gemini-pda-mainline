diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index d2a1a7303..ddf5ba258 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -471,6 +471,8 @@ struct mt6797_mac {
 	 */
 	unsigned int tx_attempts[9];
 #endif
+	/* Rate control lifetime frames sent at the fixed rate (0333). */
+	unsigned int tx_rate_fallbacks;
 #ifdef CONFIG_MT6797_RX_RATE_RECORD
 	/* Received-rate record (logging only): the first receive-vector word's
 	 * mode and rate of each queued data frame, by distinct value.
@@ -2344,6 +2346,68 @@ static bool __maybe_unused mt6797_mac_data_bw40(const struct mt6797_mac *mac)
 	return IS_ENABLED(CONFIG_MT6797_HT40_TX) && mac->join_sco == 3;
 }
 
+/* This lifetime's ordinary data at mac80211's rate control choice. */
+static bool __maybe_unused mt6797_mac_data_minstrel(const struct mt6797_mac *mac)
+{
+#ifdef CONFIG_MT6797_WIFI_TESTCONFIG
+	return mac->testcfg_now.minstrel;
+#else
+	return IS_ENABLED(CONFIG_MT6797_DATA_RATE_CONTROL);
+#endif
+}
+
+/* One ordinary data frame's rate: mac80211's first choice in a rate control
+ * lifetime, as the descriptor carries it; 40 MHz only on the HT40 join, so
+ * a stray width flag cannot put wide frames on a 20 MHz association.
+ * Otherwise the frame goes at the fixed rate and its status names no rate
+ * (index -1), so the rate control learns nothing from it; in a rate control
+ * lifetime that fallback is counted, since it should never be taken.
+ */
+static const struct mt6797_tx_rate * __maybe_unused
+mt6797_mac_tx_rate(struct mt6797_mac *mac, struct sk_buff *skb,
+		   struct mt6797_tx_rate *r)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_tx_rate *rate = &info->control.rates[0];
+	const struct ieee80211_supported_band *sband = mac->hw->wiphy->bands[info->band];
+	int legacy = sband && rate->idx >= 0 && rate->idx < sband->n_bitrates ?
+		     sband->bitrates[rate->idx].hw_value : -1;
+
+	bool w40 = rate->flags & IEEE80211_TX_RC_40_MHZ_WIDTH;
+
+	if (!mt6797_mac_data_minstrel(mac))
+		goto fixed;
+	if ((!w40 || mac->join_sco == 3) &&
+	    mt6797_tx_rate_map(rate->idx, rate->flags & IEEE80211_TX_RC_MCS,
+			       rate->flags & IEEE80211_TX_RC_VHT_MCS, w40,
+			       rate->flags & IEEE80211_TX_RC_SHORT_GI, legacy, r))
+		return r;
+	mac->tx_rate_fallbacks++;
+fixed:
+	/* control.rates is status.rates (one union): this is the status. */
+	rate->idx = -1;
+	return NULL;
+}
+
+/* The status of a reported frame sent at its own rate: that one rate, for
+ * the attempts the MCU counted. mac80211's rate choice and the status rates
+ * share their storage, so the rate sent is already in status.rates[0]
+ * (ieee80211_tx_info_clear_status keeps it); the build fails if that ever
+ * stops being true.
+ */
+static void __maybe_unused mt6797_mac_tx_rate_status(struct sk_buff *skb, unsigned int attempts)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+
+	BUILD_BUG_ON(offsetof(struct ieee80211_tx_info, control.rates) !=
+		     offsetof(struct ieee80211_tx_info, status.rates));
+
+	if (info->status.rates[0].idx < 0)
+		return;
+	info->status.rates[0].count = clamp(attempts, 1U, 31U);
+	info->status.rates[1].idx = -1;
+}
+
 static bool __maybe_unused mt6797_mac_rx_ampdu(const struct mt6797_mac *mac)
 {
 #ifdef CONFIG_MT6797_WIFI_TESTCONFIG
@@ -2358,6 +2422,7 @@ static void mt6797_mac_testcfg_build(struct mt6797_testcfg *c)
 {
 	*c = (struct mt6797_testcfg){
 		.rate = MT6797_DATA_FIXED_RATE_CODE,
+		.minstrel = IS_ENABLED(CONFIG_MT6797_DATA_RATE_CONTROL),
 		.txbw40 = true,
 		.rxbw40 = true,
 		.sgi = IS_ENABLED(CONFIG_MT6797_HT_SGI_TX),
@@ -2510,6 +2575,7 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_data_tx_failed = 0;
 	mac->join_data_tx_failures_in_row = 0;
 	mac->join_data_expired = 0;
+	mac->tx_rate_fallbacks = 0;
 #ifdef CONFIG_MT6797_DATA_CREDIT_RETIRE
 	mac->credit_retire_pages = 0;
 	mac->credit_retired = 0;
@@ -3870,14 +3936,14 @@ static void mt6797_mac_testcfg_stats(struct mt6797_mac *mac, const char *reason)
 	     !mac->credit_retire_expired && !mac->credit_retire_pid_faults &&
 	     !mac->credit_retire_pages;
 	scnprintf(body, sizeof(body),
-		  "reason=%s elapsed_ms=%llu tx_frames=%u tx_bytes=%llu rx_frames=%u rx_bytes=%llu rates=%s first_attempt=%u/%u rx_refused=%u held=%u released=%u timeouts=%u holes=%u passes=%u pass_ns=%llu tx_failed=%u expired=%u pid_faults=%u left_pages=%u",
+		  "reason=%s elapsed_ms=%llu tx_frames=%u tx_bytes=%llu rx_frames=%u rx_bytes=%llu rates=%s first_attempt=%u/%u rx_refused=%u held=%u released=%u timeouts=%u holes=%u passes=%u pass_ns=%llu rate_fallbacks=%u tx_failed=%u expired=%u pid_faults=%u left_pages=%u",
 		  reason, div_u64(ns, NSEC_PER_MSEC), mac->join_data_tx_queued,
 		  mac->testcfg_tx_bytes, mac->ccmp_rx_delivered, mac->testcfg_rx_bytes,
 		  n ? rates : "-", mac->tx_attempts[1], attempts, mac->qos_rx_refused,
 		  mac->rx_reorder_held, mac->rx_reorder_released,
 		  mac->rx_reorder_timeouts, holes, mac->cost_passes,
 		  mac->cost_passes ? div_u64(cost, mac->cost_passes) : 0,
-		  mac->join_data_tx_failed, mac->credit_retire_expired,
+		  mac->tx_rate_fallbacks, mac->join_data_tx_failed, mac->credit_retire_expired,
 		  mac->credit_retire_pid_faults, mac->credit_retire_pages);
 	line = mt6797_testcfg_stats(mac->testcfg, body, ok);
 	if (line)
@@ -4537,6 +4603,8 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	struct sk_buff *skb, *completed = NULL, *internal = NULL;
 	const bool credit_retire = IS_ENABLED(CONFIG_MT6797_DATA_CREDIT_RETIRE) &&
 				   MT6797_DATA_DEPTH > 1;
+	const struct mt6797_tx_rate *per_frame;
+	struct mt6797_tx_rate rate;
 	bool sample = false;
 #ifdef CONFIG_MT6797_TX_BACKPRESSURE
 	bool wake = false;
@@ -4943,6 +5011,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 				reinit_completion(&mac->join_frame_done);
 				pages = (MT6797_JOIN_TX_DESC_BYTES + eth_bytes + 127) / 128;
 				if (!port) {
+					per_frame = mt6797_mac_tx_rate(mac, skb, &rate);
 					/* Retired on credit arrival: no PID in the descriptor
 					 * and no status report; the host PID keys the slot.
 					 */
@@ -4955,17 +5024,25 @@ static void mt6797_mac_join_work(struct work_struct *work)
 						 CONFIG_MT6797_TX_REPORT_SAMPLE &&
 						 ++mac->tx_sample_counter >=
 						 CONFIG_MT6797_TX_REPORT_SAMPLE;
-					if (sample) {
+					if (sample)
 						mac->tx_sample_counter = 0;
+					/* A rate control probe always reports, or its rate
+					 * is never learnt.
+					 */
+					if (credit_retire && per_frame &&
+					    (IEEE80211_SKB_CB(skb)->flags &
+					     IEEE80211_TX_CTL_RATE_CTRL_PROBE))
+						sample = true;
+					if (sample)
 						mac->tx_samples++;
-					}
 #endif
 					ret = mt6797_hif_send_data_report(mac->hif, mac->join_eth,
 									  eth_bytes, 1,
 									  (credit_retire && !sample) ?
 									  0 : mac->join_pid,
 									  !credit_retire || sample,
-									  500, 3, deadline);
+									  500, 3, per_frame,
+									  deadline);
 					if (ret)
 						goto failed;
 					mac->join_inflight_data = true;
@@ -4975,16 +5052,20 @@ static void mt6797_mac_join_work(struct work_struct *work)
 #endif
 					if (!mac->join_data_tx_done && !mac->join_data_tx_failed)
 						dev_info(wiphy_dev(mac->hw->wiphy),
-							 "one-shot WLAN join data TX: first pid=%u pages=%u bytes=%zu rate=0x%02x report=%u bw40=%u sgi=%u\n",
+							 "one-shot WLAN join data TX: first pid=%u pages=%u bytes=%zu rate=0x%02x report=%u bw40=%u sgi=%u minstrel=%u\n",
 							 mac->join_pid, pages, eth_bytes,
+							 per_frame ? per_frame->code :
 #ifdef CONFIG_MT6797_WIFI_TESTCONFIG
 							 mac->testcfg_now.rate,
 #else
 							 MT6797_DATA_FIXED_RATE_CODE,
 #endif
 							 !credit_retire,
+							 per_frame ? per_frame->bw40 :
 							 mt6797_mac_data_bw40(mac),
-							 mac->join_data_sgi);
+							 per_frame ? per_frame->sgi :
+							 mac->join_data_sgi,
+							 mt6797_mac_data_minstrel(mac));
 					mac->join_frame_deadline = ktime_get_ns() + 750 * NSEC_PER_MSEC;
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
 					mac->ccmp_observation.submit_pid = mac->join_pid;
@@ -5325,6 +5406,8 @@ static void mt6797_mac_join_work(struct work_struct *work)
 				if (ack)
 					IEEE80211_SKB_CB(completed)->flags |= IEEE80211_TX_STAT_ACK;
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+				if (mac->join_inflight_data)
+					mt6797_mac_tx_rate_status(completed, result.count);
 				if (mac->join_inflight_data) {
 					/* A data frame the AP did not acknowledge is reported
 					 * to mac80211 and counted, never a fault by itself;
@@ -7976,6 +8059,7 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 	static const int bitrates[] = {
 		10, 20, 55, 110, 60, 90, 120, 180, 240, 360, 480, 540,
 	};
+	static const u16 codes[] = MT6797_LEGACY_RATE_CODES;
 	struct ieee80211_hw *hw;
 	struct mt6797_mac *mac;
 	const u8 *data;
@@ -8088,8 +8172,11 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 	}
 	for (i = 0; i < ARRAY_SIZE(bitrates); i++) {
 		mac->rates[i].bitrate = bitrates[i];
-		mac->rates[i].hw_value = i;
+		mac->rates[i].hw_value = codes[i];
 	}
+	/* One rate per ordinary data frame, at the descriptor's three attempts. */
+	hw->max_rates = 1;
+	hw->max_rate_tries = 3;
 	mac->band.band = NL80211_BAND_2GHZ;
 	mac->band.channels = mac->channels;
 	mac->band.n_channels = MT6797_2G_CHANNELS;
