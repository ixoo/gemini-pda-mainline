--- a/drivers/leds/rgb/Kconfig
+++ b/drivers/leds/rgb/Kconfig
@@ -2,6 +2,18 @@
 
 if LEDS_CLASS_MULTICOLOR
 
+config LEDS_AW9120
+	tristate "LED support for the AWINIC AW9120"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  This option enables support for the AWINIC AW9120, a 20-channel LED
+	  controller with an I2C interface found in the Gemini PDA. Outputs
+	  are grouped into multicolor or single LEDs in the device tree.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called leds-aw9120.
+
 config LEDS_GROUP_MULTICOLOR
 	tristate "LEDs group multi-color support"
 	depends on OF
