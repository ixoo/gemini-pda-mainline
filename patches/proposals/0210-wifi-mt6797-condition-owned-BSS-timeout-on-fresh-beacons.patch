From 9b49fa293d6ecb307129eb07678ca12cf8ff3d93 Mon Sep 17 00:00:00 2001
From: Codex Experiment <codex-experiment@example.invalid>
Date: Sun, 18 Oct 2026 16:28:23 -0400
Subject: [PATCH] wifi: mt6797: condition owned BSS timeout on fresh owned
 beacons

GTK4 reported BSS 0/reason 6 with admitted beacon age 71 ms at the
repeated near-30-second event. Continue only in the current authorized
initial-key data lifetime with a known non-future owned beacon clock
strictly below two committed beacon intervals, in nanoseconds.

Checked-data age remains diagnostic: a quiet healthy station can have no
checked data for seconds. Count and log exact observations without
interpreting reason 6. Refuse stale, foreign or invalid states and keep
all other event families unchanged. No command, key, page-credit or
TX-completion transition occurs here.

Internal experiment archive, synthetic non-certifying author identity;
no DCO certification and not an upstream submission.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 51 +++++++++++++++-------
 1 file changed, 36 insertions(+), 15 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index a5fbb71..7d87b8e 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -220,6 +220,7 @@ struct mt6797_mac {
 	unsigned int ccmp_gtk_arp_withheld;
 	unsigned int ccmp_gtk_queued, ccmp_gtk_arp_handoff;
 	u64 ccmp_last_checked_rx, ccmp_last_beacon_rx;
+	unsigned int ccmp_timeout_continued;
 #endif
 	struct ieee80211_sta __rcu *ccmp_sta;
 	/* Cookies only: never dereferenced, withdrawn before DISABLE_KEY returns. */
@@ -454,29 +455,44 @@ checked:
 }
 
 #ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
-/* Observe only the already acquired timeout body, preserving its fatal refusal.
- * The host queue clock covers strictly checked PTK/GTK, not firmware beacons
- * or the vendor receiver's broader last-RX clock. It authorizes no ignore path.
+/* A current owned timeout is informational only with strictly fresh owned
+ * beacons. Checked-data age is diagnostic, never a quiet-station liveness
+ * requirement. The numeric reason is not interpreted; no credit/TX transition.
  */
-static void mt6797_ccmp_timeout_observe(const struct mt6797_mac *mac, size_t bytes)
+static bool mt6797_ccmp_timeout_continue(struct mt6797_mac *mac, size_t bytes)
 {
-	u64 now, age = 0, beacon_age = 0;
-	bool known, beacon_known;
+	u64 now, checked_age = 0, beacon_age = 0, beacon_limit;
+	bool known, beacon_known, continuing;
 
 	if (!ccmp_stable_epoch || !mt6797_join_event(mac->join_packet, bytes, 0x13, 4) ||
 	    mac->join_packet[5])
-		return;
+		return false;
 	now = ktime_get_ns();
 	known = mac->ccmp_queued && mac->ccmp_last_checked_rx <= now;
 	if (known)
-		age = (now - mac->ccmp_last_checked_rx) / NSEC_PER_MSEC;
+		checked_age = now - mac->ccmp_last_checked_rx;
 	beacon_known = mac->join_beacons_delivered && mac->ccmp_last_beacon_rx <= now;
 	if (beacon_known)
-		beacon_age = (now - mac->ccmp_last_beacon_rx) / NSEC_PER_MSEC;
+		beacon_age = now - mac->ccmp_last_beacon_rx;
+	beacon_limit = 2ULL * mac->join_beacon_interval * 1024 * NSEC_PER_USEC;
+	continuing = !mac->join_packet[8] && mt6797_ccmp_rx_ready(mac) &&
+		mac->ccmp_gtk && mac->ccmp_gtk_rx.active && mac->ccmp_gtk_rx.authorized &&
+		mac->join_bss_valid && mac->join_beacon_interval &&
+		mac->join_bss_configured && mac->join_sta_active &&
+		mac->join_key_pairwise == 1 && mac->join_key_group == 1 &&
+		!mac->join_cleanup_stage && !mac->native_diag_sample_done &&
+		now < mac->join_data_deadline && now < mac->join_grant_deadline &&
+		beacon_known && beacon_age < beacon_limit;
+	if (continuing)
+		mac->ccmp_timeout_continued++;
 	dev_info(wiphy_dev(mac->hw->wiphy),
-		 "one-shot WLAN CCMP BSS timeout observation: bss=%u reason=%u checked_rx_known=%u checked_rx_age_ms=%llu beacon_known=%u beacon_count=%u beacon_age_ms=%llu\n",
-		 mac->join_packet[8], mac->join_packet[9], (unsigned int)known, age,
-		 (unsigned int)beacon_known, mac->join_beacons_delivered, beacon_age);
+		 "one-shot WLAN CCMP BSS timeout observation: bss=%u reason=%u checked_rx_known=%u checked_rx_age_ms=%llu beacon_known=%u beacon_count=%u beacon_age_ms=%llu beacon_interval_tu=%u continuing=%u count=%u\n",
+		 mac->join_packet[8], mac->join_packet[9], (unsigned int)known,
+		 checked_age / NSEC_PER_MSEC, (unsigned int)beacon_known,
+		 mac->join_beacons_delivered, beacon_age / NSEC_PER_MSEC,
+		 mac->join_beacon_interval, (unsigned int)continuing,
+		 mac->ccmp_timeout_continued);
+	return continuing;
 }
 #endif
 
@@ -1345,6 +1361,10 @@ static int mt6797_mac_join_control_event(struct mt6797_mac *mac, size_t bytes)
 	if (bytes < 8 || !mt6797_join_event(mac->join_packet, bytes,
 					    mac->join_packet[4], bytes - 8))
 		return -EPROTO;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	if (mac->join_packet[4] == 0x13)
+		return mt6797_ccmp_timeout_continue(mac, bytes) ? 0 : -EPROTO;
+#endif
 	/* Same bounded notifications as the proven scan consumer; no body log. */
 	if (mac->join_packet[4] == 0x27)
 		return 0;
@@ -1555,6 +1575,10 @@ static void mt6797_native_diag_rx_report(struct mt6797_mac *mac)
 			 "one-shot WLAN checked GTK counters: withheld_arp=%u queued_ptk=%u queued_gtk=%u delivered_arp=%u\n",
 			 mac->ccmp_gtk_arp_withheld, mac->ccmp_queued - mac->ccmp_gtk_queued,
 			 mac->ccmp_gtk_queued, mac->ccmp_gtk_arp_handoff);
+	if (ccmp_stable_epoch)
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN CCMP BSS monitor counters: continued=%u\n",
+			 mac->ccmp_timeout_continued);
 #endif
 	for (p = 0; p < 4; p++) {
 		const unsigned int *t = mac->native_diag_rx[p].type;
@@ -2685,9 +2709,6 @@ submitted:
 				branch = 6;
 				ret = mt6797_mac_join_control_event(mac, rx.logical_bytes);
 				if (ret) {
-#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
-					mt6797_ccmp_timeout_observe(mac, rx.logical_bytes);
-#endif
 					/* Header metadata only: no body bytes, no address. */
 					dev_info(wiphy_dev(mac->hw->wiphy),
 						 "one-shot WLAN join control event refused: status=%d bytes=%zu type=0x%04x id=0x%02x seq=%u\n",
-- 
