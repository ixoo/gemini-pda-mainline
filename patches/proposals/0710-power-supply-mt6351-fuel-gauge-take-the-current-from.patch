From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 11 Nov 2026 11:23:27 -0500
Subject: [PATCH] power: supply: mt6351-fuel-gauge: take the current
 from the coulomb counter

On the Gemini under mainline, FG_CURRENT_OUT has read 0 to 3 counts
(0 to about 1.1 mA) with the screen lit on battery, while the coulomb
counter over the same time showed a few hundred milliamps. The vendor
kernel reads the same register with the same latch sequence and gets
plausible values, so the cause lies on the mainline side and is not known.
A current that reads near zero leaves the status at the wrong state and
takes the I x R correction out of the capacity.

Read the whole 35-bit counter, its two's complement value with the
fraction below bit 14 that the vendor's 17-bit slice drops, and report
the current as its change over a window of at least 5 s. The register
is used only until the first window closes, about 5 s after probe; a
debug message gives both for comparison. The charge counter keeps its
units and gains the fraction.
---
 drivers/power/supply/mt6351-fuel-gauge.c | 91 ++++++++++++++++++++----
 1 file changed, 78 insertions(+), 13 deletions(-)

diff --git a/drivers/power/supply/mt6351-fuel-gauge.c b/drivers/power/supply/mt6351-fuel-gauge.c
index bfdefd1..80eaf12 100644
--- a/drivers/power/supply/mt6351-fuel-gauge.c
+++ b/drivers/power/supply/mt6351-fuel-gauge.c
@@ -16,6 +16,7 @@
 #include <linux/bitfield.h>
 #include <linux/delay.h>
 #include <linux/iio/consumer.h>
+#include <linux/math64.h>
 #include <linux/interrupt.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
@@ -29,6 +30,7 @@
 #define MT6351_FGADC_CON0		0x0ca4
 #define MT6351_FGADC_CON1		0x0ca6	/* FG_CAR[34:19] */
 #define MT6351_FGADC_CON2		0x0ca8	/* FG_CAR[18:3] */
+#define MT6351_FGADC_CON3		0x0caa	/* FG_CAR[2:0] */
 #define MT6351_FGADC_CON11		0x0cba	/* FG_CURRENT_OUT */
 /* The software read controls in CON0's upper byte; the lower byte is left. */
 #define MT6351_FG_CTRL_MASK		GENMASK(15, 8)
@@ -39,11 +41,19 @@
 #define MT6351_FG_POLL_US		1000
 #define MT6351_FG_TIMEOUT_US		100000
 
-/* 158.122 uA per count and 44.98 uAh per counter step, for a 20 mOhm sense. */
+/*
+ * 158.122 uA per current count, and 44.98 uAh per step of FG_CAR bit 14, the
+ * vendor's counter unit, for a 20 mOhm sense. The counter is a 35-bit two's
+ * complement value; the bits below 14 are its fraction.
+ */
 #define MT6351_FG_CURRENT_NA		158122
 #define MT6351_FG_CHARGE_NAH		44983
+#define MT6351_FG_CAR_FRAC_BITS		14
 #define MT6351_FG_SENSE_BASE_MOHM	20
 
+/* The current is the counter's change over at least this long. */
+#define MT6351_FG_WINDOW_MS		5000
+
 /*
  * Within this current, the battery is reported as not charging while a supply
  * is online, and as discharging otherwise.
@@ -62,6 +72,12 @@ struct mt6351_fg {
 	u32 sense_mohm;
 	u32 car_tune;
 	u32 resistance_mohm;
+	/* The counter window the current is taken over, under the lock. */
+	ktime_t win_start;
+	s64 win_car;
+	bool win_valid;
+	int win_ua;
+	bool win_ua_valid;
 };
 
 /*
@@ -74,6 +90,51 @@ static s64 mt6351_fg_scale(struct mt6351_fg *fg, s64 count, s64 unit)
 		       (s64)fg->sense_mohm * 100 * 1000);
 }
 
+/* A raw counter value in nAh, for this board's sense resistor and CAR tune. */
+static s64 mt6351_fg_car_nah(struct mt6351_fg *fg, s64 car)
+{
+	u64 nah = mul_u64_u64_div_u64(abs(car),
+				      MT6351_FG_CHARGE_NAH * MT6351_FG_SENSE_BASE_MOHM *
+				      fg->car_tune,
+				      ((u64)fg->sense_mohm * 100) << MT6351_FG_CAR_FRAC_BITS);
+
+	return car < 0 ? -(s64)nah : nah;
+}
+
+/*
+ * The battery current is the counter's change over a window of at least
+ * MT6351_FG_WINDOW_MS. The instantaneous FG_CURRENT_OUT register is only used
+ * until the first window closes: on the Gemini under mainline it has read a
+ * few counts while the counter, and the vendor kernel's reads of the same
+ * register, showed hundreds of milliamps.
+ */
+static void mt6351_fg_window(struct mt6351_fg *fg, s64 car, int reg_ua)
+{
+	ktime_t now = ktime_get_boottime();
+	s64 ms, dq_nah;
+
+	if (!fg->win_valid) {
+		fg->win_start = now;
+		fg->win_car = car;
+		fg->win_valid = true;
+		return;
+	}
+
+	ms = ktime_ms_delta(now, fg->win_start);
+	if (ms < MT6351_FG_WINDOW_MS)
+		return;
+
+	/* nAh over ms: x 3600 gives uA. */
+	dq_nah = mt6351_fg_car_nah(fg, car - fg->win_car);
+	fg->win_ua = div_s64(dq_nah * 3600, ms);
+	fg->win_ua_valid = true;
+	fg->win_start = now;
+	fg->win_car = car;
+
+	dev_dbg(fg->dev, "%lld ms: counter %d uA, FG_CURRENT_OUT %d uA\n",
+		ms, fg->win_ua, reg_ua);
+}
+
 /*
  * The latched read, as the vendor does it: request the latch, wait for the
  * latch status, read the current and the counter, clear, wait for the status
@@ -81,8 +142,8 @@ static s64 mt6351_fg_scale(struct mt6351_fg *fg, s64 count, s64 unit)
  */
 static int mt6351_fg_read(struct mt6351_fg *fg, int *current_ua, int *charge_uah)
 {
-	unsigned int con0, cur, car_h, car_l, raw;
-	s64 count;
+	unsigned int con0, cur, car_h, car_l, car_f;
+	s64 count, car;
 	int ret;
 
 	guard(mutex)(&fg->lock);
@@ -106,6 +167,8 @@ static int mt6351_fg_read(struct mt6351_fg *fg, int *current_ua, int *charge_uah
 		ret = regmap_read(fg->regmap, MT6351_FGADC_CON1, &car_h);
 	if (!ret)
 		ret = regmap_read(fg->regmap, MT6351_FGADC_CON2, &car_l);
+	if (!ret)
+		ret = regmap_read(fg->regmap, MT6351_FGADC_CON3, &car_f);
 
 	/* Clear and release even after a failed read. */
 	regmap_update_bits(fg->regmap, MT6351_FGADC_CON0, MT6351_FG_CTRL_MASK,
@@ -122,17 +185,16 @@ static int mt6351_fg_read(struct mt6351_fg *fg, int *current_ua, int *charge_uah
 	*current_ua = mt6351_fg_scale(fg, count, MT6351_FG_CURRENT_NA);
 
 	/*
-	 * The vendor's 17-bit slice of the 35-bit counter, with the sign in
-	 * CAR[34]; 0 and 0x1ffff are its zero sentinels.
+	 * The whole 35-bit counter. The vendor keeps only bits 30:14, with
+	 * bit 34 as the sign, which leaves 44.98 uAh steps (103 uAh on this
+	 * board); the full value is the same count with its fraction.
 	 */
-	raw = (car_l >> 11) | ((car_h & 0xfff) << 5);
-	if (raw == 0 || raw == 0x1ffff)
-		count = 0;
-	else if (car_h & BIT(15))
-		count = -(s64)(0x1ffff - raw);
-	else
-		count = raw;
-	*charge_uah = mt6351_fg_scale(fg, count, MT6351_FG_CHARGE_NAH);
+	car = sign_extend64(((u64)car_h << 19) | ((u64)car_l << 3) | (car_f & 0x7), 34);
+	*charge_uah = div_s64(mt6351_fg_car_nah(fg, car), 1000);
+
+	mt6351_fg_window(fg, car, *current_ua);
+	if (fg->win_ua_valid)
+		*current_ua = fg->win_ua;
 
 	return 0;
 }
@@ -316,6 +378,9 @@ static int mt6351_fg_probe(struct platform_device *pdev)
 			      info->factory_internal_resistance_uohm / 1000 : 0;
 	WRITE_ONCE(fg->info, info);
 
+	/* Open the first current window now, so the current is known 5 s on. */
+	mt6351_fg_read(fg, &ret, &ret);
+
 	/*
 	 * A charger attached while the system sleeps wakes it, so that the
 	 * charger's own policy, such as a charge limit, applies at once.
-- 
2.54.0 (Apple Git-157)

