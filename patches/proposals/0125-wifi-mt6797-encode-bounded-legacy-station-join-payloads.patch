From 95dcf07a9bc04992e236968a4b8301cf727e68f4 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 5 Oct 2026 23:58:51 +0000
Subject: [PATCH] wifi: mt6797: encode bounded legacy station join payloads

Original preparation for one bounded legacy station join. This checkpoint
is compile-only and incomplete; no device operation is admitted.
---
 .../wireless/mediatek/mt6797/join-commands.h  | 86 +++++++++++++++++++
 1 file changed, 86 insertions(+)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/join-commands.h

diff --git a/drivers/net/wireless/mediatek/mt6797/join-commands.h b/drivers/net/wireless/mediatek/mt6797/join-commands.h
new file mode 100644
index 000000000..4bb82cb17
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/join-commands.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_JOIN_COMMANDS_H
+#define MT6797_JOIN_COMMANDS_H
+
+#include "join-events.h"
+
+#define MT6797_JOIN_STA_BYTES 124U
+
+/* Original payload encoders for one legacy 5 GHz, 20 MHz join. Slot indices
+ * are project reservations, not firmware allocation acknowledgements.
+ * The caller must establish the exclusive BSS/peer lifetime first.
+ */
+static inline bool
+mt6797_join_station_payload(const unsigned char *ap, unsigned int state,
+	unsigned int aid, unsigned int desired_rates, unsigned int basic_rates,
+	unsigned char output[MT6797_JOIN_STA_BYTES])
+{
+	unsigned char p[MT6797_JOIN_STA_BYTES] = {0};
+	unsigned int i, any = 0;
+
+	if (!ap || !output || (ap[0] & 1) || (state != 1 && state != 3) ||
+	    (state == 1 && aid) || (state == 3 && (!aid || aid > 2007)) ||
+	    !desired_rates || (desired_rates & ~0x3fc0U) ||
+	    !basic_rates || (basic_rates & ~desired_rates) ||
+	    !(desired_rates & (1U << 6)))
+		return false;
+	for (i = 0; i < 6; i++)
+		any |= ap[i];
+	if (!any)
+		return false;
+	p[0] = 1; /* STA index 1. */
+	p[1] = 0x41; /* Legacy AP: legacy bit 0, AP role bit 6. */
+	for (i = 0; i < 6; i++)
+		p[2 + i] = ap[i];
+	p[8] = aid; p[9] = aid >> 8;
+	p[10] = 1; /* Listen interval, no station power-save admission. */
+	p[13] = 8; /* PHY OFDM 5 GHz only. BSS index 0. */
+	p[14] = desired_rates; p[15] = desired_rates >> 8;
+	p[16] = basic_rates; p[17] = basic_rates >> 8;
+	p[20] = state;
+	p[51] = state == 3; /* Activation response required only for state 3. */
+	p[54] = 1; /* AP WLAN index 1, BMC index 0. */
+	p[68] = 3; /* Legacy RTS policy. */
+	p[74] = 0x4b; /* Default fixed rate OFDM 6 Mbps. */
+	p[76] = 1; p[77] = 1; /* Command option DISABLED, not AUTO (0). */
+	for (i = 0; i < MT6797_JOIN_STA_BYTES; i++)
+		output[i] = p[i];
+	return true;
+}
+
+static inline bool
+mt6797_join_remove_station(unsigned char output[4])
+{
+	if (!output)
+		return false;
+	output[0] = 0; /* Remove one STA, not every station in a BSS. */
+	output[1] = 1;
+	output[2] = 0;
+	output[3] = 0;
+	return true;
+}
+
+static inline bool
+mt6797_join_channel_payload(unsigned char token, unsigned char channel,
+	unsigned int interval_ms, bool abort, unsigned char output[16])
+{
+	unsigned char p[16] = {0};
+	unsigned int i;
+
+	if (!output || !token || (!abort &&
+	    (channel != 40 || !interval_ms || interval_ms > 10000)))
+		return false;
+	p[1] = token; /* BSS 0, project-owned single-use token. */
+	p[2] = abort; /* Request 0, abort 1. */
+	if (!abort) {
+		p[3] = channel;
+		p[5] = 2; /* 5 GHz, no secondary offset, 20/40 width enum 0. */
+		/* JOIN request type 0, center segments and reserved bytes zero. */
+		p[12] = interval_ms; p[13] = interval_ms >> 8;
+		p[14] = interval_ms >> 16; p[15] = interval_ms >> 24;
+	}
+	for (i = 0; i < 16; i++)
+		output[i] = p[i];
+	return true;
+}
+#endif
-- 
