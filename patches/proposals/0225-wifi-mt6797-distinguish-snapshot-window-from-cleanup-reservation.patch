From 12f200dbe98be55143005a2e195d4d317a1507c9 Mon Sep 17 00:00:00 2001
From: Gemini experiment tooling <gemini-experiment@example.invalid>
Date: Thu, 22 Oct 2026 16:10:37 -0400
Subject: [PATCH] wifi: distinguish snapshot window from reserved cleanup

Report whether the host native window is active, below its sample limit and not withdrawn. The existing cleanup flag is a latched reservation and remains visible. No firmware access is added.
---
 drivers/net/wireless/mediatek/mt6797/mac.c      | 6 ++++++
 drivers/net/wireless/mediatek/mt6797/snapshot.c | 4 +++-
 drivers/net/wireless/mediatek/mt6797/snapshot.h | 1 +
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 7b3f5e7..4b453fa 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -376,6 +376,7 @@ static void mt6797_mac_snapshot_readiness(void *owner,
 		!READ_ONCE(mac->join_assoc_status);
 	state->ptk_present = READ_ONCE(mac->join_key_pairwise) == 1;
 	state->gtk_present = READ_ONCE(mac->join_key_group) == 1;
+	/* This is the latched deauth reservation, not active teardown. */
 	state->cleanup = READ_ONCE(mac->join_cleanup_requested);
 #endif
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
@@ -383,6 +384,11 @@ static void mt6797_mac_snapshot_readiness(void *owner,
 #endif
 #ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
 	state->mac_state = READ_ONCE(mac->native_diag_state);
+	state->window_open = state->mac_state == MT6797_ND_ACTIVE &&
+		!READ_ONCE(mac->native_diag_sample_done);
+#ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
+	state->window_open = state->window_open && !READ_ONCE(mac->ccmp_closed);
+#endif
 #endif
 	/* Empty public provider retains its original admission policy. */
 	state->ready = state->configured && !state->error && !state->closing;
diff --git a/drivers/net/wireless/mediatek/mt6797/snapshot.c b/drivers/net/wireless/mediatek/mt6797/snapshot.c
index 805964e..d810685 100644
--- a/drivers/net/wireless/mediatek/mt6797/snapshot.c
+++ b/drivers/net/wireless/mediatek/mt6797/snapshot.c
@@ -142,7 +142,7 @@ static bool mt6797_snapshot_inspect(struct mt6797_snapshot *s,
 	return false;
 }
 
-#define SNAPSHOT_READY_FORMAT "ready=%u epoch_enabled=%u configured=%u running=%u data_active=%u associated=%u ptk_present=%u gtk_present=%u closing=%u error=%u cleanup=%u end=%u mac_state=0x%08x"
+#define SNAPSHOT_READY_FORMAT "ready=%u epoch_enabled=%u configured=%u running=%u data_active=%u window_open=%u associated=%u ptk_present=%u gtk_present=%u closing=%u error=%u cleanup=%u end=%u mac_state=0x%08x"
 
 static ssize_t mt6797_snapshot_control_read(struct file *file, char __user *buf,
 					  size_t size, loff_t *pos)
@@ -183,6 +183,7 @@ static ssize_t mt6797_snapshot_control_read(struct file *file, char __user *buf,
 			r ? r->finished : 0, readiness_valid,
 			readiness.ready, readiness.epoch_enabled,
 			readiness.configured, readiness.running, readiness.data_active,
+			readiness.window_open,
 			readiness.associated, readiness.ptk_present, readiness.gtk_present,
 			readiness.closing, readiness.error, readiness.cleanup,
 			readiness.end, readiness.mac_state);
@@ -285,6 +286,7 @@ static int mt6797_snapshot_start(struct mt6797_snapshot_file *f)
 			SNAPSHOT_READY_FORMAT "\n", readiness_valid,
 			readiness.ready, readiness.epoch_enabled,
 			readiness.configured, readiness.running, readiness.data_active,
+			readiness.window_open,
 			readiness.associated, readiness.ptk_present, readiness.gtk_present,
 			readiness.closing, readiness.error, readiness.cleanup,
 			readiness.end, readiness.mac_state);
diff --git a/drivers/net/wireless/mediatek/mt6797/snapshot.h b/drivers/net/wireless/mediatek/mt6797/snapshot.h
index 6341071..e20de1b 100644
--- a/drivers/net/wireless/mediatek/mt6797/snapshot.h
+++ b/drivers/net/wireless/mediatek/mt6797/snapshot.h
@@ -21,6 +21,7 @@ struct mt6797_snapshot_word {
 struct mt6797_snapshot_readiness {
 	bool ready, epoch_enabled, configured, running, data_active, associated;
 	bool ptk_present, gtk_present, closing, error, cleanup, end;
+	bool window_open;
 	u32 mac_state;
 };
 
