From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Thu, 5 Nov 2026 18:06:25 -0500
Subject: [PATCH] soc: mediatek: mt6797-consys: let the FM receiver use the
 STP link

The FM receiver behind CONSYS is WMT function 1 and talks on STP task 1, the
same way GNSS uses task 2 and Bluetooth task 0. The link refused task 1 and
only the GPS and Bluetooth functions could be switched.

Accept task 1 for attach and send, export an FM function control with the
command 01 06 02 00 01 and the on or off byte, and register a child platform
device for the FM driver. The function needs no rail of its own: the vendor's
FM-only VCN28 step is for co-clock mode, which this board's WMT_SOC.cfg turns
off, and the common power-on already holds VCN28.
---
 drivers/soc/mediatek/mt6797-consys.c    | 46 +++++++++++++++++++++++--
 include/linux/soc/mediatek/mt6797-stp.h |  2 ++
 2 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index aa3830e6e..571ff2ea6 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -139,7 +139,7 @@ struct mt6797_consys {
 	struct mt6797_wmt_query wmt_query;
 	struct mt6797_wmt_negotiate wmt_negotiate;
 	struct mt6797_stp stp;
-	struct platform_device *gnss, *bt;
+	struct platform_device *gnss, *bt, *fm;
 	bool bt_rail;
 	struct {
 		struct mt6797_wmt_full_io io;
@@ -1758,6 +1758,8 @@ static const unsigned char mt6797_stp_gps_on[] = { 0x01, 0x06, 0x02, 0x00, 0x02,
 static const unsigned char mt6797_stp_gps_off[] = { 0x01, 0x06, 0x02, 0x00, 0x02, 0x00 };
 static const unsigned char mt6797_stp_bt_on[] = { 0x01, 0x06, 0x02, 0x00, 0x00, 0x01 };
 static const unsigned char mt6797_stp_bt_off[] = { 0x01, 0x06, 0x02, 0x00, 0x00, 0x00 };
+static const unsigned char mt6797_stp_fm_on[] = { 0x01, 0x06, 0x02, 0x00, 0x01, 0x01 };
+static const unsigned char mt6797_stp_fm_off[] = { 0x01, 0x06, 0x02, 0x00, 0x01, 0x00 };
 static const unsigned char mt6797_stp_func_event[] = { 0x02, 0x06, 0x01, 0x00, 0x00 };
 
 /* Lock held. TX-empty interrupt only while bytes wait for the FIFO. */
@@ -2068,7 +2070,8 @@ int mt6797_consys_stp_attach(unsigned int task,
 	bool first, bound;
 	int ret;
 
-	if ((task != MT6797_STP_TASK_GPS && task != MT6797_STP_TASK_BT) || !receive)
+	if ((task != MT6797_STP_TASK_GPS && task != MT6797_STP_TASK_BT &&
+	     task != MT6797_STP_TASK_FM) || !receive)
 		return -EINVAL;
 	mutex_lock(&mt6797_consys_lock);
 	if (!owner->bound || !owner->dev) {
@@ -2187,6 +2190,33 @@ int mt6797_consys_bt_function(bool on)
 }
 EXPORT_SYMBOL_GPL(mt6797_consys_bt_function);
 
+/*
+ * Process context, attached client. Function 1 needs no rail of its own: the
+ * FM-only VCN28 step is for co-clock mode, which this board's WMT_SOC.cfg turns
+ * off, and the common power-on already holds VCN28.
+ */
+int mt6797_consys_fm_function(bool on)
+{
+	struct mt6797_consys *owner = &mt6797_consys;
+	struct mt6797_stp *s = &owner->stp;
+	int ret = -ENODEV;
+
+	mutex_lock(&mt6797_consys_lock);
+	if (s->running) {
+		ret = mt6797_stp_wmt(s, on ? mt6797_stp_fm_on : mt6797_stp_fm_off,
+				     sizeof(mt6797_stp_fm_on), mt6797_stp_func_event,
+				     sizeof(mt6797_stp_func_event));
+		if (!ret && s->wmt_event_length != sizeof(mt6797_stp_func_event))
+			ret = -EPROTO;
+		dev_info(owner->dev, "WMT FM function %s: result=%d reply=%u bytes %*ph\n",
+			 on ? "on" : "off", ret, s->wmt_event_length,
+			 min_t(int, s->wmt_event_length, sizeof(s->wmt_event)), s->wmt_event);
+	}
+	mutex_unlock(&mt6797_consys_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_fm_function);
+
 static bool mt6797_stp_has_room(struct mt6797_stp *s)
 {
 	unsigned long flags;
@@ -2206,7 +2236,8 @@ int mt6797_consys_stp_send(unsigned int task, const u8 *data, unsigned int lengt
 	long left = msecs_to_jiffies(MT6797_STP_SEND_WAIT_MS);
 	int ret;
 
-	if (task != MT6797_STP_TASK_GPS && task != MT6797_STP_TASK_BT)
+	if (task != MT6797_STP_TASK_GPS && task != MT6797_STP_TASK_BT &&
+	    task != MT6797_STP_TASK_FM)
 		return -EINVAL;
 	for (;;) {
 		spin_lock_irqsave(&s->lock, flags);
@@ -2741,6 +2772,13 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 				PTR_ERR(mt6797_consys.bt));
 			mt6797_consys.bt = NULL;
 		}
+		mt6797_consys.fm = platform_device_register_data(&pdev->dev, "mt6797-fm",
+								 PLATFORM_DEVID_NONE, NULL, 0);
+		if (IS_ERR(mt6797_consys.fm)) {
+			dev_err(&pdev->dev, "FM device unavailable (%ld)\n",
+				PTR_ERR(mt6797_consys.fm));
+			mt6797_consys.fm = NULL;
+		}
 #if IS_MODULE(CONFIG_MT6797_MAC80211)
 		ret = device_create_file(&pdev->dev, &dev_attr_wlan_stop);
 		if (ret)
@@ -2779,6 +2817,8 @@ static void mt6797_consys_remove(struct platform_device *pdev)
 		platform_device_unregister(owner->gnss);
 	if (owner->bt)
 		platform_device_unregister(owner->bt);
+	if (owner->fm)
+		platform_device_unregister(owner->fm);
 #if IS_MODULE(CONFIG_MT6797_MAC80211)
 	device_remove_file(dev, &dev_attr_wlan_stop);
 #endif
diff --git a/include/linux/soc/mediatek/mt6797-stp.h b/include/linux/soc/mediatek/mt6797-stp.h
index f3cac23d5..7f75f7b1f 100644
--- a/include/linux/soc/mediatek/mt6797-stp.h
+++ b/include/linux/soc/mediatek/mt6797-stp.h
@@ -5,6 +5,7 @@
 #include <linux/types.h>
 
 #define MT6797_STP_TASK_BT	0U
+#define MT6797_STP_TASK_FM	1U
 #define MT6797_STP_TASK_GPS	2U
 
 /*
@@ -22,5 +23,6 @@ void mt6797_consys_stp_detach(unsigned int task);
 int mt6797_consys_stp_send(unsigned int task, const u8 *data, unsigned int length);
 int mt6797_consys_gps_function(bool on);
 int mt6797_consys_bt_function(bool on);
+int mt6797_consys_fm_function(bool on);
 
 #endif
-- 
2.43.0

