 drivers/pinctrl/mediatek/pinctrl-mt6797.c     | 56 +++++++++++++++++++
 drivers/pinctrl/mediatek/pinctrl-mtk-mt6797.h | 12 ++--
 2 files changed, 62 insertions(+), 6 deletions(-)

