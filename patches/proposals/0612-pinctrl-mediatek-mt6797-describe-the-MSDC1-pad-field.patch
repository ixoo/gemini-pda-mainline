+	PIN_FIELD_CALC(130, 133, 2, 0x0c0, 0x10, 20, 4, 32, 1),
+	PIN_FIELD_CALC(134, 134, 2, 0x0c0, 0x10, 24, 4, 32, 0),
+};
+
+static const struct mtk_pin_field_calc mt6797_pin_rdsel_range[] = {
+	PIN_FIELD_CALC(129, 129, 2, 0x0a0, 0x10, 8, 6, 32, 0),
+	PIN_FIELD_CALC(130, 133, 2, 0x0a0, 0x10, 14, 6, 32, 1),
