From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 14 Nov 2026 18:44:12 -0500
Subject: [PATCH] power: supply: mt6351-fuel-gauge: base the headroom on the
 latest resistance estimate

The headroom dropped its aged-cell assumption as soon as the resistance
counted as learned or restored: after the first learning step, or after
userspace wrote back the DT's own value, saved beside a learned full
charge. On station-work-126 current_max read 4.83 A, which implies about
0.2 Ohm, on a cell measured at 0.3-0.4 Ohm. The learned value moves in
small steps from the new-cell value, so it understates an aged cell's
resistance for many updates.

Use the larger of the learned resistance and the latest accepted
estimate, at the battery's temperature. Before any estimate, keep the
aged-cell assumption unless userspace restored a value other than the
DT's.
---
 drivers/power/supply/mt6351-fuel-gauge.c | 23 ++++++++++++++++-------
 1 file changed, 16 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/mt6351-fuel-gauge.c b/drivers/power/supply/mt6351-fuel-gauge.c
index 6e50c2b..ec980c4 100644
--- a/drivers/power/supply/mt6351-fuel-gauge.c
+++ b/drivers/power/supply/mt6351-fuel-gauge.c
@@ -163,9 +163,11 @@
 #define MT6351_FG_HEADROOM_UV		3100000
 #define MT6351_FG_HEADROOM_BAND_UA	100000
 /*
- * Until the resistance has been learned or restored, the headroom assumes an
- * aged cell, at up to this many times the DT's new-cell value, so that it
- * never overstates what the battery can supply.
+ * The headroom must not overstate what the battery can supply. It uses the
+ * larger of the learned resistance and the latest accepted estimate, since
+ * the learned value approaches a new cell's slowly. Before any estimate, and
+ * unless userspace has restored a value other than the DT's, it assumes an
+ * aged cell at up to this many times the DT's new-cell value.
  */
 #define MT6351_FG_R_UNKNOWN_FACTOR	3
 
@@ -209,8 +211,10 @@ struct mt6351_fg {
 	bool rl_done;
 	ktime_t r_time;
 	bool r_updated;
-	/* The resistance was learned or restored since probe. */
+	/* A value other than the DT's was restored, and the latest estimate. */
 	bool r_known;
+	s64 r_raw25_uohm;
+	bool r_raw_valid;
 	/* The previous window's current and closing voltage, for the step estimate. */
 	int win_prev_ua;
 	int win_prev_uv;
@@ -444,7 +448,9 @@ static void mt6351_fg_headroom(struct mt6351_fg *fg)
 		return;
 
 	r = max_t(s64, mt6351_fg_r_uohm(fg, mc), 1);
-	if (!fg->r_known)
+	if (fg->r_raw_valid)
+		r = max(r, div64_s64(r * fg->r_raw25_uohm, fg->r25_uohm));
+	else if (!fg->r_known)
 		r = max(r, div_s64(r * MT6351_FG_R_UNKNOWN_FACTOR * fg->r_design_uohm,
 				   fg->r25_uohm));
 	fg->headroom_ua = clamp_t(s64, div64_s64((s64)(ocv - MT6351_FG_HEADROOM_UV) * 1000000, r),
@@ -701,13 +707,14 @@ static bool mt6351_fg_learn_r(struct mt6351_fg *fg, ktime_t now, int ua, s64 ful
 		r, ocv, uv, ua, mc);
 	if (r < MT6351_FG_R_MIN_UOHM || r > MT6351_FG_R_MAX_UOHM)
 		return false;
+	fg->r_raw25_uohm = r;
+	fg->r_raw_valid = true;
 
 	step = clamp_t(s64, div_s64(r - fg->r25_uohm, 16),
 		       -div_s64(fg->r25_uohm, 10), div_s64(fg->r25_uohm, 10));
 	fg->r25_uohm += step;
 	fg->r_time = now;
 	fg->r_updated = true;
-	fg->r_known = true;
 	dev_info(fg->dev, "resistance %lld uOhm at 25 C\n", fg->r25_uohm);
 
 	return step != 0;
@@ -1085,7 +1092,9 @@ static ssize_t learned_resistance_uohm_store(struct device *dev,
 
 	scoped_guard(mutex, &fg->lock) {
 		fg->r25_uohm = r;
-		fg->r_known = true;
+		/* A restored value was learned; the DT's own was not. */
+		if (r != fg->r_design_uohm)
+			fg->r_known = true;
 	}
 	power_supply_changed(fg->psy);
 
-- 
