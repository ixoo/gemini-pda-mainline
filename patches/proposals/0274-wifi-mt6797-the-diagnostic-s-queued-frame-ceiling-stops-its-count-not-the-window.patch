From 6b596eb057f8f39382a9ed8d57d282b887fb8a4f Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 08:16:05 -0400
Subject: [PATCH 4/4] wifi: mt6797: the diagnostic's queued-frame ceiling stops
 its count, not the window

The native-delivery diagnostic ended its sample window, and with it the
data phase, when the CCMP path had queued MT6797_CCMP_DIAG_CHECKED_MAX
frames, and refused to queue frames beyond it. A measured receive of five
one-megabyte chunks with a probe beside it reached that ceiling and the
window closed under the measurement, before the host's disconnect. A
ceiling on the diagnostic's own count must never close the window or
refuse delivery: beyond it the frames are delivered and counted apart
(`beyond=` on the ccmp-stable end line), the count itself saturates, and
the ceiling value is unchanged.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 23 ++++++++++++++--------
 1 file changed, 15 insertions(+), 8 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 790821485..e33cdb3b5 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -327,6 +327,7 @@ struct mt6797_mac {
 	unsigned int ccmp_gtk_arp_withheld;
 	unsigned int ccmp_gtk_queued, ccmp_gtk_arp_handoff;
 	unsigned int ccmp_rx_delivered; /* data frames handed to mac80211 */
+	unsigned int ccmp_queued_beyond; /* frames past the diagnostic's count ceiling */
 #ifdef CONFIG_MT6797_RX_RATE_RECORD
 	/* Received-rate record (logging only): the first receive-vector word's
 	 * mode and rate of each queued data frame, by distinct value.
@@ -713,7 +714,7 @@ static int mt6797_ccmp_queue_rx(struct mt6797_mac *mac, size_t bytes,
 	unsigned int rx_flags = RX_FLAG_8023 | RX_FLAG_DECRYPTED | RX_FLAG_IV_STRIPPED |
 		RX_FLAG_MIC_STRIPPED | RX_FLAG_PN_VALIDATED | RX_FLAG_NO_SIGNAL_VAL;
 
-	if (!mt6797_ccmp_rx_ready(mac) || mac->ccmp_queued >= MT6797_CCMP_DIAG_CHECKED_MAX)
+	if (!mt6797_ccmp_rx_ready(mac))
 		return 0;
 	/* Allocate before the PN decision commits highwater. */
 	skb = dev_alloc_skb(bytes);
@@ -753,7 +754,16 @@ static int mt6797_ccmp_queue_rx(struct mt6797_mac *mac, size_t bytes,
 		dev_info(wiphy_dev(mac->hw->wiphy),
 			 "one-shot WLAN ccmp-stable RX: first ethernet_bytes=%zu flags=0x%x\n",
 			 view.bytes, rx_flags);
-	mac->ccmp_queued++;
+	/* The diagnostic's queued-frame ceiling is a ceiling on its own count,
+	 * never on delivery or the data window: a measured receive of five
+	 * one-megabyte chunks with a probe beside it crossed 8192 and the
+	 * window closed under the measurement. Beyond the ceiling the frames
+	 * are delivered and counted apart.
+	 */
+	if (mac->ccmp_queued < MT6797_CCMP_DIAG_CHECKED_MAX)
+		mac->ccmp_queued++;
+	else
+		mac->ccmp_queued_beyond++;
 #ifdef CONFIG_MT6797_RX_RATE_RECORD
 	if (!mt6797_rx_vector_word(mac->join_packet, bytes, &rate_word)) {
 		mac->rx_rates_absent++;
@@ -1711,6 +1721,7 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 	mac->join_data_rx_group = 0;
 	mac->join_data_rx_dropped = 0;
 	mac->ccmp_rx_delivered = 0;
+	mac->ccmp_queued_beyond = 0;
 #ifdef CONFIG_MT6797_RX_RATE_RECORD
 	memset(mac->rx_rates, 0, sizeof(mac->rx_rates));
 	mac->rx_rates_other = 0;
@@ -2695,10 +2706,6 @@ static int mt6797_native_diag_pre_read(struct mt6797_mac *mac)
 	     mac->native_diag_bytes + MT6797_HIF_RX_MAX_PACKET >
 	     MT6797_NATIVE_DIAG_BYTES_MAX))
 		mac->native_diag_sample_done = true;
-#ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
-	if (ccmp_stable_epoch && mac->ccmp_queued >= MT6797_CCMP_DIAG_CHECKED_MAX)
-		mac->native_diag_sample_done = true;
-#endif
 	/* The window is over on a sample ceiling OR any data-phase end (lower
 	 * deadline / PID budget / association loss).
 	 */
@@ -2906,8 +2913,8 @@ static void mt6797_mac_join_end_data(struct mt6797_mac *mac, const char *reason)
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
 	if (ccmp_stable_epoch)
 		dev_info(wiphy_dev(mac->hw->wiphy),
-			 "one-shot WLAN ccmp-stable end: queued=%u no_reuse=1\n",
-			 mac->ccmp_queued);
+			 "one-shot WLAN ccmp-stable end: queued=%u beyond=%u no_reuse=1\n",
+			 mac->ccmp_queued, mac->ccmp_queued_beyond);
 #endif
 	dev_info(wiphy_dev(mac->hw->wiphy),
 		 "one-shot WLAN join data group1: uni_present=%u uni_absent=%u grp_present=%u grp_absent=%u uni_masks=0x%x grp_masks=0x%x\n",
-- 
