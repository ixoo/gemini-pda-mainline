From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Thu, 5 Nov 2026 20:47:08 -0500
Subject: [PATCH] ASoC: mediatek: mt6797: add a hostless FM path to the
 downlink

Add a Hostless FM front end and an I2S0 input on each ADDA downlink
mixer, so the CONSYS I2S input can play on the headphones and speakers
without a memory interface: the front end's capture side starts the
CONNSYS_I2S back end, and its playback side reaches the ADDA back end
through the new mixer switches. The vendor routes FM through hardware
gain 1 first; this path goes straight to the downlink, and the
receiver's own volume sets the level.
---
 sound/soc/mediatek/mt6797/mt6797-afe-common.h |  1 +
 sound/soc/mediatek/mt6797/mt6797-dai-adda.c   |  2 ++
 .../soc/mediatek/mt6797/mt6797-dai-hostless.c | 24 +++++++++++++++++++
 3 files changed, 27 insertions(+)

diff --git a/sound/soc/mediatek/mt6797/mt6797-afe-common.h b/sound/soc/mediatek/mt6797/mt6797-afe-common.h
index 28149c037..4f0359c62 100644
--- a/sound/soc/mediatek/mt6797/mt6797-afe-common.h
+++ b/sound/soc/mediatek/mt6797/mt6797-afe-common.h
@@ -30,6 +30,7 @@ enum {
 	MT6797_DAI_HOSTLESS_LPBK,
 	MT6797_DAI_HOSTLESS_SPEECH,
 	MT6797_DAI_CONNSYS_I2S,
+	MT6797_DAI_HOSTLESS_FM,
 	MT6797_DAI_NUM,
 };
 
diff --git a/sound/soc/mediatek/mt6797/mt6797-dai-adda.c b/sound/soc/mediatek/mt6797/mt6797-dai-adda.c
index b28853fcd..6ff674f1d 100644
--- a/sound/soc/mediatek/mt6797/mt6797-dai-adda.c
+++ b/sound/soc/mediatek/mt6797/mt6797-dai-adda.c
@@ -26,6 +26,7 @@ static const struct snd_kcontrol_new mtk_adda_dl_ch1_mix[] = {
 				    I_PCM_1_CAP_CH1, 1, 0),
 	SOC_DAPM_SINGLE_AUTODISABLE("PCM_2_CAP_CH1", AFE_CONN3,
 				    I_PCM_2_CAP_CH1, 1, 0),
+	SOC_DAPM_SINGLE_AUTODISABLE("I2S0_CH1", AFE_CONN3, I_I2S0_CH1, 1, 0),
 };
 
 static const struct snd_kcontrol_new mtk_adda_dl_ch2_mix[] = {
@@ -47,6 +48,7 @@ static const struct snd_kcontrol_new mtk_adda_dl_ch2_mix[] = {
 				    I_PCM_1_CAP_CH2, 1, 0),
 	SOC_DAPM_SINGLE_AUTODISABLE("PCM_2_CAP_CH2", AFE_CONN4,
 				    I_PCM_2_CAP_CH2, 1, 0),
+	SOC_DAPM_SINGLE_AUTODISABLE("I2S0_CH2", AFE_CONN4, I_I2S0_CH2, 1, 0),
 };
 
 static int mtk_adda_ul_event(struct snd_soc_dapm_widget *w,
diff --git a/sound/soc/mediatek/mt6797/mt6797-dai-hostless.c b/sound/soc/mediatek/mt6797/mt6797-dai-hostless.c
index ed23e6a53..2cf84240e 100644
--- a/sound/soc/mediatek/mt6797/mt6797-dai-hostless.c
+++ b/sound/soc/mediatek/mt6797/mt6797-dai-hostless.c
@@ -31,6 +31,11 @@ static const struct snd_soc_dapm_route mtk_dai_hostless_routes[] = {
 	{"Hostless Speech UL", NULL, "PCM 1 Capture"},
 	{"Hostless Speech UL", NULL, "PCM 2 Capture"},
 	{"Hostless Speech UL", NULL, "ADDA Capture"},
+
+	/* Hostless FM: the second I2S input, from CONSYS, to the downlink */
+	{"ADDA_DL_CH1", "I2S0_CH1", "Hostless FM DL"},
+	{"ADDA_DL_CH2", "I2S0_CH2", "Hostless FM DL"},
+	{"Hostless FM UL", NULL, "Connsys I2S"},
 };
 
 /* dai ops */
@@ -96,6 +101,25 @@ static struct snd_soc_dai_driver mtk_dai_hostless_driver[] = {
 		},
 		.ops = &mtk_dai_hostless_ops,
 	},
+	{
+		.name = "Hostless FM DAI",
+		.id = MT6797_DAI_HOSTLESS_FM,
+		.playback = {
+			.stream_name = "Hostless FM DL",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = MTK_HOSTLESS_RATES,
+			.formats = MTK_HOSTLESS_FORMATS,
+		},
+		.capture = {
+			.stream_name = "Hostless FM UL",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = MTK_HOSTLESS_RATES,
+			.formats = MTK_HOSTLESS_FORMATS,
+		},
+		.ops = &mtk_dai_hostless_ops,
+	},
 };
 
 int mt6797_dai_hostless_register(struct mtk_base_afe *afe)
-- 
2.43.0

