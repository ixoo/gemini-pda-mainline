From 049cc0f17cff6696446039d3b4c1df7e29da3d28 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Tue, 13 Oct 2026 21:37:40 +0000
Subject: [PATCH] wifi: mt6797: count native RX eligibility and name HIF
 refusals

ND3 consumed 200 packets but delivered no native MPDU. Its final branch4
EPROTO followed the closed-state deauth submission, without metadata to
distinguish advertised RX length refusal from staged header mismatch.
DHCP never bound. Aggregate bytes at ACTIVE do not classify protection,
packet type or decoder invocation.

Retain the exact protocol refusal, no-copy and poison decisions. Attach
failure-only values already read to each existing HIF gate and log them
only in the native diagnostic. Report native descriptor type, phase,
first eligibility rejection and admission-blocked counts once at the
terminal. Pending accounting stays distinct from ACTIVE; drain and
inherited CLOSED stay distinct. No payload samples, new I/O, radio action,
retry, budget change or crypto bypass flag.

One descriptor-only scalar sample at the first actual admitted decoder
call disambiguates observed channel/header/group values. Fields are
absent unless at least 16 buffered bytes exist. No MPDU, address, IV,
PN, key or payload is logged. Metadata uses a separate prefix, preserving
the original classifier's strict native state/RX/fault grammar.

Paired actual-HIF and native-RX host tests exercise both refusal gates,
absent metadata, no-copy/poison, unchanged transport call counts and
eligibility outputs. Extracted hook tests cover phase attribution and
bounded terminal output. These are synthetic tests, not a live firmware
or crypto result.

Internal experiment archive, not submission-ready; no DCO certification.
---
 .../net/wireless/mediatek/mt6797/data-rx.h    | 87 +++++++++++-----
 drivers/net/wireless/mediatek/mt6797/hif.c    |  6 ++
 drivers/net/wireless/mediatek/mt6797/hif.h    |  8 ++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 99 ++++++++++++++++++-
 4 files changed, 171 insertions(+), 29 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/data-rx.h b/drivers/net/wireless/mediatek/mt6797/data-rx.h
index c3a19c7..3c8e5e6 100644
--- a/drivers/net/wireless/mediatek/mt6797/data-rx.h
+++ b/drivers/net/wireless/mediatek/mt6797/data-rx.h
@@ -249,23 +249,51 @@ mt6797_data_rx_llc_mismatch(const unsigned char *packet, size_t bytes,
  * MIC and replay check authenticate it. Every translated, plain, non-CCMP,
  * non-peer, short or malformed ordinary frame is withheld (returns false).
  */
-static inline bool
-mt6797_data_rx_native(const unsigned char *packet, size_t bytes, unsigned char channel,
-		      const unsigned char own[6], const unsigned char ap[6],
-		      size_t *mpdu_off, size_t *mpdu_len)
+/* First failed eligibility gate, not an authentication or firmware verdict. */
+enum mt6797_native_rx_gate {
+	MT6797_NATIVE_RX_OK,
+	MT6797_NATIVE_RX_INPUT,
+	MT6797_NATIVE_RX_LENGTH,
+	MT6797_NATIVE_RX_TYPE,
+	MT6797_NATIVE_RX_CHANNEL,
+	MT6797_NATIVE_RX_TRANSLATED,
+	MT6797_NATIVE_RX_MSDU,
+	MT6797_NATIVE_RX_FCS,
+	MT6797_NATIVE_RX_HEADER,
+	MT6797_NATIVE_RX_SPAN,
+	MT6797_NATIVE_RX_FRAME_TYPE,
+	MT6797_NATIVE_RX_UNPROTECTED,
+	MT6797_NATIVE_RX_DS,
+	MT6797_NATIVE_RX_FRAME_SHAPE,
+	MT6797_NATIVE_RX_PEER,
+	MT6797_NATIVE_RX_DESTINATION,
+	MT6797_NATIVE_RX_CCMP_SHAPE,
+	MT6797_NATIVE_RX_GATES,
+};
+
+static inline enum mt6797_native_rx_gate
+mt6797_data_rx_native_gate(const unsigned char *packet, size_t bytes,
+			   unsigned char channel, const unsigned char own[6],
+			   const unsigned char ap[6], size_t *mpdu_off,
+			   size_t *mpdu_len)
 {
 	size_t offset = 16;
 	unsigned int groups, fc, hdrlen, subtype, i;
 	const unsigned char *m;
 
 	if (!packet || !own || !ap || !mpdu_off || !mpdu_len ||
-	    bytes < 16 || bytes > 4096 || !channel ||
-	    mt6797_join_le16(packet) != bytes ||
-	    (mt6797_join_le16(packet + 2) >> 13) != 2 ||	/* RX data descriptor format */
-	    packet[5] != channel ||
-	    (packet[6] & 0x80) != 0 ||				/* native: header translation OFF */
-	    (packet[7] & 0x03) != 0)			/* MSDU0 (no AMSDU subframe) */
-		return false;
+	    bytes < 16 || bytes > 4096 || !channel)
+		return MT6797_NATIVE_RX_INPUT;
+	if (mt6797_join_le16(packet) != bytes)
+		return MT6797_NATIVE_RX_LENGTH;
+	if ((mt6797_join_le16(packet + 2) >> 13) != 2)
+		return MT6797_NATIVE_RX_TYPE;
+	if (packet[5] != channel)
+		return MT6797_NATIVE_RX_CHANNEL;
+	if (packet[6] & 0x80)				/* header translation OFF */
+		return MT6797_NATIVE_RX_TRANSLATED;
+	if (packet[7] & 0x03)				/* MSDU0 (no AMSDU subframe) */
+		return MT6797_NATIVE_RX_MSDU;
 	/* No reliance on the descriptor security-mode/error fields (a translated-
 	 * decrypted shape); CCMP is derived from the original MPDU below.
 	 */
@@ -279,7 +307,7 @@ mt6797_data_rx_native(const unsigned char *packet, size_t bytes, unsigned char c
 	 * authenticates.
 	 */
 	if (mt6797_join_le16(packet + 10) & 0x0002)
-		return false;
+		return MT6797_NATIVE_RX_FCS;
 	groups = (mt6797_join_le16(packet + 2) >> 9) & 15;
 	/* The source walk (nicRxFillRFB) adds any present status groups in 4/1/2/3
 	 * order, then the BIT(6) header-offset pad; group 4's presence is NOT the
@@ -299,32 +327,34 @@ mt6797_data_rx_native(const unsigned char *packet, size_t bytes, unsigned char c
 		offset += 2;					/* BIT(6) header-offset pad */
 	hdrlen = packet[6] & 0x3f;				/* reported 802.11 header length */
 	if (hdrlen != 24 && hdrlen != 26)
-		return false;
+		return MT6797_NATIVE_RX_HEADER;
 	if (offset > bytes || bytes - offset < hdrlen + 8 + 8)	/* + CCMP header + MIC */
-		return false;
+		return MT6797_NATIVE_RX_SPAN;
 	m = packet + offset;
 	fc = mt6797_join_le16(m);
 	subtype = (fc >> 4) & 15;
-	if ((fc & 3) != 0 ||					/* version 0 */
-	    (fc & 0x0c) != 0x08 ||				/* type data */
-	    (fc & 0x4000) == 0 ||				/* Protected */
-	    (fc & 0x0300) != 0x0200 ||				/* FromDS, not ToDS */
-	    (fc & 0x0400) != 0 ||				/* no More Fragments */
+	if ((fc & 3) != 0 || (fc & 0x0c) != 0x08)		/* version 0, type data */
+		return MT6797_NATIVE_RX_FRAME_TYPE;
+	if ((fc & 0x4000) == 0)				/* Protected */
+		return MT6797_NATIVE_RX_UNPROTECTED;
+	if ((fc & 0x0300) != 0x0200)			/* FromDS, not ToDS */
+		return MT6797_NATIVE_RX_DS;
+	if ((fc & 0x0400) != 0 ||				/* no More Fragments */
 	    (fc & 0x8000) != 0 ||				/* no Order/+HTC */
 	    (subtype != 0 && subtype != 8) ||			/* data or QoS-data only */
 	    (subtype == 8 && hdrlen != 26) ||			/* QoS-data => 26-byte header */
 	    (subtype == 0 && hdrlen != 24) ||			/* data => 24-byte header */
 	    (mt6797_join_le16(m + 22) & 0x000f) != 0)		/* fragment number 0 */
-		return false;
+		return MT6797_NATIVE_RX_FRAME_SHAPE;
 	for (i = 0; i < 6; i++)
 		if (m[10 + i] != ap[i])				/* addr2 (TA/BSSID) == ap */
-			return false;
+			return MT6797_NATIVE_RX_PEER;
 	if (m[4] & 1) {						/* group-addressed */
 		/* accepted as a group frame */
 	} else {
 		for (i = 0; i < 6; i++)
 			if (m[4 + i] != own[i])			/* addr1 == own for unicast */
-				return false;
+				return MT6797_NATIVE_RX_DESTINATION;
 	}
 	/* CCMP-SHAPED eligibility (not proven CCMP until the standard mac80211 AEAD):
 	 * the CCMP header's reserved byte 2 is zero, byte 3 has the Ext-IV bit set and
@@ -333,10 +363,19 @@ mt6797_data_rx_native(const unsigned char *packet, size_t bytes, unsigned char c
 	if (m[hdrlen + 2] != 0 ||
 	    (m[hdrlen + 3] & 0x20) == 0 ||
 	    (m[hdrlen + 3] & 0x1f) != 0)
-		return false;
+		return MT6797_NATIVE_RX_CCMP_SHAPE;
 	*mpdu_off = offset;
 	*mpdu_len = bytes - offset;
-	return true;
+	return MT6797_NATIVE_RX_OK;
+}
+
+static inline bool
+mt6797_data_rx_native(const unsigned char *packet, size_t bytes, unsigned char channel,
+		      const unsigned char own[6], const unsigned char ap[6],
+		      size_t *mpdu_off, size_t *mpdu_len)
+{
+	return mt6797_data_rx_native_gate(packet, bytes, channel, own, ap,
+					 mpdu_off, mpdu_len) == MT6797_NATIVE_RX_OK;
 }
 
 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 4b51fcb..4416dfd 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -1113,6 +1113,8 @@ int mt6797_hif_receive_packet(struct mt6797_hif *hif, unsigned int port,
 		goto unlock;
 	}
 	if (logical < 4 || logical > MT6797_HIF_RX_MAX_PACKET) {
+		result->protocol_refusal = MT6797_HIF_RX_REFUSAL_LENGTH;
+		result->selected_length = logical;
 		error = -EPROTO;
 		goto poison;
 	}
@@ -1136,6 +1138,10 @@ int mt6797_hif_receive_packet(struct mt6797_hif *hif, unsigned int port,
 	if (error)
 		goto poison;
 	if (mt6797_normal_le16(hif->scratch) != logical) {
+		result->protocol_refusal = MT6797_HIF_RX_REFUSAL_HEADER;
+		result->selected_length = logical;
+		result->header_length = mt6797_normal_le16(hif->scratch);
+		result->header_valid = true;
 		error = -EPROTO;
 		goto poison;
 	}
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index e967698..dea1dbd 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -74,6 +74,14 @@ struct mt6797_hif_rx_result {
 	size_t staging_bytes, logical_bytes;
 	unsigned int packet_type;
 	bool pre_valid, rx_setup, rx_complete, post_valid;
+	/* Failure-only observations; zero is absent unless the valid bit is set. */
+	enum {
+		MT6797_HIF_RX_REFUSAL_NONE,
+		MT6797_HIF_RX_REFUSAL_LENGTH,
+		MT6797_HIF_RX_REFUSAL_HEADER,
+	} protocol_refusal;
+	unsigned int selected_length, header_length;
+	bool header_valid;
 };
 
 /* One interrupt/control and eight returned-page register reads. WHISR and
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index b70e4bd..799676a 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -171,6 +171,11 @@ struct mt6797_mac {
 	bool native_diag_sample_done;	/* a sample ceiling was crossed */
 	unsigned int native_diag_retire_reads, native_diag_retire_bytes;
 	u64 native_diag_started, native_diag_retire_started;
+	struct {
+		unsigned int type[8], gate[MT6797_NATIVE_RX_GATES], window_blocked;
+	} native_diag_rx[4];
+	bool native_diag_rx_reported;
+	bool native_diag_rxd_sampled;
 #endif
 	u64 join_data_deadline, join_data_started;
 	const char *join_data_end_reason;
@@ -1200,6 +1205,45 @@ static int mt6797_mac_join_control_event(struct mt6797_mac *mac, size_t bytes)
 }
 
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+#ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
+/* At the consumed-packet hook: pending, active, owed drain, inherited closed.
+ * Freeze the bucket before dispatch; a later ACTIVE transition cannot relabel
+ * an ENABLE_PENDING packet. IDLE and DISABLE_PENDING consume no native sample.
+ */
+static int mt6797_native_diag_rx_phase(unsigned int state, bool over)
+{
+	if (state == MT6797_ND_ENABLE_PENDING || state == MT6797_ND_ACTIVE)
+		return over ? 2 : state == MT6797_ND_ACTIVE ? 1 : 0;
+	return state == MT6797_ND_CLOSED ? 3 : -1;
+}
+
+/* Once per lifetime, at a healthy or failed terminal; at most eight lines.
+ * Descriptor type is bits15:13, not a claim about protection or authentication.
+ * Gate0 is eligibility only; blocked means the decoder was NOT invoked.
+ */
+static void mt6797_native_diag_rx_report(struct mt6797_mac *mac)
+{
+	unsigned int p;
+
+	if (!mac->native_diag_engaged || mac->native_diag_rx_reported)
+		return;
+	mac->native_diag_rx_reported = true;
+	for (p = 0; p < 4; p++) {
+		const unsigned int *t = mac->native_diag_rx[p].type;
+		const unsigned int *g = mac->native_diag_rx[p].gate;
+
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN native RX classes: phase=%u t0=%u t1=%u t2=%u t3=%u t4=%u t5=%u t6=%u t7=%u\n",
+			 p, t[0], t[1], t[2], t[3], t[4], t[5], t[6], t[7]);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN native RX gates: phase=%u blocked=%u eligible=%u input=%u length=%u type=%u channel=%u translated=%u msdu=%u fcs=%u header=%u span=%u frame_type=%u unprotected=%u ds=%u frame_shape=%u peer=%u destination=%u ccmp_shape=%u\n",
+			 p, mac->native_diag_rx[p].window_blocked,
+			 g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7], g[8],
+			 g[9], g[10], g[11], g[12], g[13], g[14], g[15], g[16]);
+	}
+}
+#endif
+
 /* Poller-owned finite teardown. A returned page proves submission, not reuse. */
 static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 {
@@ -1288,6 +1332,9 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 		dev_info(wiphy_dev(mac->hw->wiphy),
 			 "one-shot WLAN join cleanup: stage=3 credits=returned slots=retired deauth=%u\n",
 			 mac->join_deauth_done);
+#ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
+		mt6797_native_diag_rx_report(mac);
+#endif
 		/* This API only queues work; no synchronous MLME call under our mutex. */
 		if (mac->vif && mac->started)
 			ieee80211_connection_loss(mac->vif);
@@ -1609,6 +1656,9 @@ static int mt6797_mac_join_fail_stop(struct mt6797_mac *mac, int ret,
 		"one-shot WLAN join stopped: status=%d first=%d submitted=0x%x debt=%u cleanup=%u branch=%u\n",
 		ret, mac->first_error, mac->join_submitted,
 		mac->join_page_debt, mac->join_cleanup_stage, branch);
+#ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
+	mt6797_native_diag_rx_report(mac);
+#endif
 #else
 	(void)branch;
 #endif
@@ -1708,6 +1758,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	bool running, ack = false, completed_internal = false, select;
 #ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
 	bool nd_stop = false, nd_over = false;
+	int nd_phase;
 #endif
 	/* Diagnostic only: which phase of this tick stopped the lifetime (the
 	 * footer that prints it exists in station-join builds only).
@@ -2023,6 +2074,16 @@ submitted:
 			branch = 4;
 			ret = mt6797_hif_receive_packet(mac->hif, port, deadline,
 				 mac->join_packet, sizeof(mac->join_packet), &rx);
+#ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
+			if (ret == -EPROTO && rx.protocol_refusal != MT6797_HIF_RX_REFUSAL_NONE)
+				dev_info(wiphy_dev(mac->hw->wiphy),
+					 "one-shot WLAN native HIF refused: gate=%s port=%u pre_valid=%u pre_wrplr=0x%08x selected=%u header_valid=%u header=%u setup=%u complete=%u staging=%zu post_valid=%u post_wrplr=0x%08x\n",
+					 rx.protocol_refusal == MT6797_HIF_RX_REFUSAL_LENGTH ?
+					 "wrplr-length" : "header-length", port, rx.pre_valid,
+					 rx.pre_wrplr, rx.selected_length, rx.header_valid,
+					 rx.header_length, rx.rx_setup, rx.rx_complete,
+					 rx.staging_bytes, rx.post_valid, rx.post_wrplr);
+#endif
 			if (ret == -EAGAIN) {
 				ret = 0;
 				continue;
@@ -2045,6 +2106,9 @@ submitted:
 			nd_over = (mac->native_diag_state == MT6797_ND_ENABLE_PENDING ||
 				   mac->native_diag_state == MT6797_ND_ACTIVE) &&
 				  (mac->native_diag_sample_done || mac->join_data_ended);
+			nd_phase = mt6797_native_diag_rx_phase(mac->native_diag_state, nd_over);
+			if (mac->native_diag_engaged && nd_phase >= 0)
+				mac->native_diag_rx[nd_phase].type[rx.packet_type >> 13]++;
 			if (mac->native_diag_state == MT6797_ND_ENABLE_PENDING ||
 			    mac->native_diag_state == MT6797_ND_ACTIVE) {
 				if (!nd_over) {
@@ -2266,11 +2330,36 @@ submitted:
 					mac->native_diag_total, mac->native_diag_native,
 					mac->native_diag_bytes };
 				size_t mo, ml;
-
-				if (mt6797_native_diag_admit(mac->native_diag_state, &nb) &&
-				    mt6797_data_rx_native(mac->join_packet, rx.logical_bytes, 40,
-							  mac->hw->wiphy->perm_addr,
-							  mac->join_ap, &mo, &ml)) {
+				enum mt6797_native_rx_gate gate = MT6797_NATIVE_RX_INPUT;
+				bool admitted;
+
+				admitted = mt6797_native_diag_admit(mac->native_diag_state, &nb);
+				if (admitted)
+					gate = mt6797_data_rx_native_gate(mac->join_packet,
+									  rx.logical_bytes, 40,
+									  mac->hw->wiphy->perm_addr,
+									  mac->join_ap, &mo, &ml);
+				if (admitted && !mac->native_diag_rxd_sampled) {
+					bool valid = rx.logical_bytes >= 16;
+					const u8 *d = mac->join_packet;
+
+					mac->native_diag_rxd_sampled = true;
+					dev_info(wiphy_dev(mac->hw->wiphy),
+						 "one-shot WLAN native RX descriptor: phase=%d bytes=%zu fields_valid=%u type=0x%04x channel=%u header=0x%02x groups=0x%x msdu=%u status=0x%04x\n",
+						 nd_phase, rx.logical_bytes, valid,
+						 valid ? mt6797_join_le16(d + 2) : 0,
+						 valid ? d[5] : 0, valid ? d[6] : 0,
+						 valid ? (mt6797_join_le16(d + 2) >> 9) & 15 : 0,
+						 valid ? d[7] & 3 : 0,
+						 valid ? mt6797_join_le16(d + 10) : 0);
+				}
+				if (nd_phase >= 0) {
+					if (admitted)
+						mac->native_diag_rx[nd_phase].gate[gate]++;
+					else
+						mac->native_diag_rx[nd_phase].window_blocked++;
+				}
+				if (admitted && gate == MT6797_NATIVE_RX_OK) {
 					skb = dev_alloc_skb(ml);
 					if (!skb) {
 						ret = -ENOMEM;
