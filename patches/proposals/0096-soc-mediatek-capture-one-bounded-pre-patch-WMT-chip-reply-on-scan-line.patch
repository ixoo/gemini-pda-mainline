+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -41,6 +41,7 @@
 #endif
 #include "mt6797-wmt-query.h"
 #include "mt6797-wmt-negotiate.h"
+#include "mt6797-wmt-identity-io.h"
 
 #define MT6797_CONSYS_REMAP_REG	0x10001340
 #define MT6797_CONSYS_SLEEP_MASK_REG	0x10001350
@@ -94,6 +95,8 @@ struct mt6797_consys {
 #endif
 	struct mt6797_wmt_query wmt_query;
 	struct mt6797_wmt_negotiate wmt_negotiate;
+	struct mt6797_wmt_identity_io wmt_identity;
+	bool wmt_identity_only;
 	bool wmt_negotiate_only;
 	bool wmt_query_only;
 	int wmt_query_result;
@@ -1259,6 +1262,31 @@ static void mt6797_consys_probe_emi_set(struct device *dev,
 }
 
 /* One attempt per boot. Keep every acquired vote after any uncertain effect. */
+static int mt6797_consys_wmt_identity(struct device *dev,
+				      struct mt6797_consys *owner)
+{
+	struct mt6797_wmt_identity_io *io = &owner->wmt_identity;
+	int ret;
+
+	ret = mt6797_wmt_query_setup(&owner->wmt_query);
+	if (!ret)
+		ret = mt6797_wmt_identity_prepare(io, owner->wmt_query.btif,
+						  owner->wmt_query.irq,
+						  jiffies + msecs_to_jiffies(500));
+	if (!ret)
+		ret = mt6797_wmt_identity_capture(io);
+	dev_info(dev,
+		 "one-shot WMT identity capture: result=%d tx=%u rx=%u services=%u terminal=%d clocks-held=%d\n",
+		 ret, io->tx_count, io->rx_count, io->services, io->terminal,
+		 owner->wmt_query.clocks_held);
+	/* Private sealed evidence only; no added hardware observation. */
+	print_hex_dump(KERN_INFO, "WMT identity capture TX: ", DUMP_PREFIX_OFFSET,
+		       16, 1, io->command, io->tx_count, false);
+	print_hex_dump(KERN_INFO, "WMT identity capture RX: ", DUMP_PREFIX_OFFSET,
+		       16, 1, io->received, io->rx_count, false);
+	return ret;
+}
+
 static int mt6797_consys_wmt_exchange(struct device *dev,
 				      struct mt6797_consys *owner)
 {
@@ -1269,6 +1297,8 @@ static int mt6797_consys_wmt_exchange(struct device *dev,
 	if (ret < 0)
 		return ret;
 	owner->wmt_query.irq = ret;
+	if (owner->wmt_identity_only)
+		return mt6797_consys_wmt_identity(dev, owner);
 	if (!owner->wmt_negotiate_only) {
 		ret = mt6797_wmt_query_once(&owner->wmt_query);
 		dev_info(dev,
@@ -1557,6 +1587,15 @@ static ssize_t wmt_default_query_store(struct device *dev,
 
 static DEVICE_ATTR_WO(wmt_default_query);
 
+static ssize_t wmt_identity_capture_store(struct device *dev,
+					  struct device_attribute *attr,
+					  const char *buf, size_t count)
+{
+	return firmware_start_after_wmt_store(dev, attr, buf, count);
+}
+
+static DEVICE_ATTR_WO(wmt_identity_capture);
+
 static ssize_t wmt_negotiate_store(struct device *dev,
 				   struct device_attribute *attr,
 				   const char *buf, size_t count)
@@ -1579,7 +1618,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	void __iomem *hif = NULL, *emi_selector = NULL;
 	bool power_probe, chip_id_probe, reset_release_probe, hif_probe;
 	bool emi_set_probe, emi_copy_probe, firmware_start_probe;
-	bool region19_observe, deferred_start, wmt_query, wmt_negotiate;
+	bool region19_observe, deferred_start, wmt_query, wmt_negotiate, wmt_identity;
 	struct resource reservation = {};
 	int ret;
 
@@ -1606,11 +1645,14 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 					  "mediatek,one-shot-wmt-default-query");
 	wmt_negotiate = of_property_read_bool(pdev->dev.of_node,
 					      "mediatek,one-shot-wmt-negotiate");
-	if (wmt_query && wmt_negotiate) {
+	wmt_identity = of_property_read_bool(pdev->dev.of_node,
+					     "mediatek,one-shot-wmt-identity-capture");
+	if ((wmt_query && wmt_negotiate) ||
+	    (wmt_identity && (wmt_query || wmt_negotiate))) {
 		ret = -EINVAL;
 		goto out_unlock;
 	}
-	wmt_query |= wmt_negotiate;
+	wmt_query |= wmt_negotiate | wmt_identity;
 	if (wmt_query && !deferred_start) {
 		ret = -EINVAL;
 		goto out_unlock;
@@ -1845,6 +1887,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	}
 	mt6797_consys.wmt_query_only = wmt_query;
 	mt6797_consys.wmt_negotiate_only = wmt_negotiate;
+	mt6797_consys.wmt_identity_only = wmt_identity;
 	mt6797_consys.vcn18 = vcn18;
 	mt6797_consys.vcn28 = vcn28;
 	mt6797_consys.vcn33_wifi = vcn33_wifi;
@@ -1885,7 +1928,8 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	}
 	if (deferred_start && mt6797_consys.region19_window) {
 		ret = device_create_file(&pdev->dev,
-					 wmt_negotiate ? &dev_attr_wmt_negotiate :
+					 wmt_identity ? &dev_attr_wmt_identity_capture :
+				 wmt_negotiate ? &dev_attr_wmt_negotiate :
 					 wmt_query ? &dev_attr_wmt_default_query :
 					 &dev_attr_firmware_start_after_wmt);
 		if (ret)
diff --git a/drivers/soc/mediatek/mt6797-wmt-identity-io.h b/drivers/soc/mediatek/mt6797-wmt-identity-io.h
new file mode 100644
index 000000000..e2cef9e2e
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-wmt-identity-io.h
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_WMT_IDENTITY_IO_H
+#define MT6797_WMT_IDENTITY_IO_H
+#include <linux/completion.h>
+#include <linux/errno.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include "wmt-identity-read.h"
+#include "wmt-full-stp-tx.h"
+
+#define WMT_IDENTITY_SERVICES 64U
+#define WMT_IDENTITY_RX_BYTES 32U
+#define WMT_IDENTITY_RX_QUOTA 8U
+
+/* Capture-only chip read. Persistent CONSYS-owned storage, mandatory mode,
+ * retained clocks, idle DMA, normal bank and empty FIFOs are caller gates.
+ * No WMT reply parser, retry, reset, resynchronization, flush or power cleanup.
+ * Deadline expiry ends capture; it never means accepted identity.
+ */
+struct mt6797_wmt_identity_io {
+	void __iomem *btif;
+	unsigned char command[26], received[WMT_IDENTITY_RX_BYTES];
+	struct wmt_full_tx tx;
+	unsigned int rx_count, tx_count, services;
+	unsigned long deadline;
+	/* Serializes FIFO progress, terminal state and timeout retirement. */
+	spinlock_t lock;
+	struct completion done;
+	int irq, prepared, attempted, armed, terminal, result;
+};
+
+static int mt6797_wmt_identity_prepare(struct mt6797_wmt_identity_io *io,
+				       void __iomem *btif, int irq, unsigned long deadline)
+{
+	unsigned long now = jiffies;
+
+	if (!io || !btif || irq <= 0 || time_after_eq(now, deadline) ||
+	    deadline - now > msecs_to_jiffies(500))
+		return -EINVAL;
+	if (io->prepared)
+		return -EBUSY;
+	memset(io, 0, sizeof(*io));
+	io->prepared = 1;
+	io->btif = btif;
+	io->irq = irq;
+	io->deadline = deadline;
+	init_completion(&io->done);
+	spin_lock_init(&io->lock);
+	wmt_identity_read(0, io->command, sizeof(io->command));
+	/* Reuse bounded byte accounting, not full-STP frame validation. */
+	io->tx.frame = io->command;
+	io->tx.length = sizeof(io->command);
+	return 0;
+}
+
+/* Lock held. Resources/storage remain retained after IRQ retirement. */
+static void mt6797_wmt_identity_retire(struct mt6797_wmt_identity_io *io, int result)
+{
+	if (io->terminal)
+		return;
+	writel(0, io->btif + 4);
+	io->result = result;
+	io->terminal = 1;
+	if (io->armed) {
+		disable_irq_nosync(io->irq);
+		io->armed = 0;
+	}
+	complete(&io->done);
+}
+
+static void mt6797_wmt_identity_service(struct mt6797_wmt_identity_io *io, int initial)
+{
+	const unsigned char *bytes;
+	unsigned int iir, quota = 0, actual = 0;
+	int offered;
+
+	if (io->terminal)
+		return;
+	if (time_after_eq(jiffies, io->deadline) ||
+	    io->services == WMT_IDENTITY_SERVICES) {
+		mt6797_wmt_identity_retire(io, -ETIMEDOUT);
+		return;
+	}
+	if (initial && (io->services ||
+			(readl(io->btif + 0x14) & 0x61) != 0x60)) {
+		mt6797_wmt_identity_retire(io, -EBUSY);
+		return;
+	}
+	io->services++;
+	iir = readl(io->btif + 8);
+	if ((initial && (iir & 0x44)) || (!initial && !(iir & 0x46)) ||
+	    ((iir & 0x44) && !wmt_full_tx_done(&io->tx))) {
+		mt6797_wmt_identity_retire(io, -EPROTO);
+		return;
+	}
+	while ((iir & 0x44) && quota < WMT_IDENTITY_RX_QUOTA) {
+		if (io->rx_count == sizeof(io->received)) {
+			mt6797_wmt_identity_retire(io, -EOVERFLOW);
+			return;
+		}
+		if (time_after_eq(jiffies, io->deadline)) {
+			mt6797_wmt_identity_retire(io, -ETIMEDOUT);
+			return;
+		}
+		io->received[io->rx_count++] = readb(io->btif);
+		quota++;
+		iir = readl(io->btif + 8);
+	}
+	if (!wmt_full_tx_done(&io->tx)) {
+		offered = wmt_full_tx_batch(&io->tx, readl(io->btif + 0x14),
+					    time_after_eq(jiffies, io->deadline), &bytes);
+		if (offered < 0) {
+			mt6797_wmt_identity_retire(io, -ETIMEDOUT);
+			return;
+		}
+		while (actual < (unsigned int)offered &&
+		       !time_after_eq(jiffies, io->deadline)) {
+			writeb(bytes[actual++], io->btif);
+			io->tx_count++;
+		}
+		if (offered && wmt_full_tx_commit(&io->tx, actual,
+						  time_after_eq(jiffies, io->deadline))) {
+			mt6797_wmt_identity_retire(io, -ETIMEDOUT);
+			return;
+		}
+		if (wmt_full_tx_done(&io->tx))
+			writel(1, io->btif + 4);
+	}
+}
+
+static irqreturn_t mt6797_wmt_identity_irq(int irq, void *data)
+{
+	struct mt6797_wmt_identity_io *io = data;
+	unsigned long flags;
+
+	if (irq != io->irq)
+		return IRQ_NONE;
+	spin_lock_irqsave(&io->lock, flags);
+	mt6797_wmt_identity_service(io, 0);
+	spin_unlock_irqrestore(&io->lock, flags);
+	return IRQ_HANDLED;
+}
+
+/* Process context, one attempt even if IRQ registration fails. Caller never
+ * interprets timeout or captured bytes as permission for later initialization.
+ */
+static int mt6797_wmt_identity_capture(struct mt6797_wmt_identity_io *io)
+{
+	unsigned long flags, now, remaining;
+	int ret;
+
+	if (!io || !io->prepared || io->attempted)
+		return -EINVAL;
+	io->attempted = 1;
+	ret = request_irq(io->irq, mt6797_wmt_identity_irq, IRQF_NO_AUTOEN,
+			  "mt6797-wmt-identity", io);
+	if (ret) {
+		io->result = ret;
+		io->terminal = 1;
+		complete(&io->done);
+		return ret;
+	}
+	spin_lock_irqsave(&io->lock, flags);
+	writel(3, io->btif + 4);
+	mt6797_wmt_identity_service(io, 1);
+	if (!io->terminal)
+		io->armed = 1;
+	spin_unlock_irqrestore(&io->lock, flags);
+	if (io->armed) {
+		enable_irq(io->irq);
+		now = jiffies;
+		remaining = time_after_eq(now, io->deadline) ? 0 : io->deadline - now;
+		wait_for_completion_timeout(&io->done, remaining);
+		spin_lock_irqsave(&io->lock, flags);
+		if (!io->terminal)
+			mt6797_wmt_identity_retire(io, -ETIMEDOUT);
+		spin_unlock_irqrestore(&io->lock, flags);
+	}
+	synchronize_irq(io->irq);
+	ret = io->result;
+	free_irq(io->irq, io);
+	return ret;
+}
+#endif
