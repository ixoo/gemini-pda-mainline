  * Register meanings come from reverse engineering. The programming sequence
@@ -622,10 +622,11 @@ static int mvdec_hevc_walk(struct mvdec_hevc_pic *p, struct mvdec_hevc_walk *w)
 static int mvdec_hevc_buf(struct mvdec_ctx *ctx, struct vb2_buffer *vb,
 			  struct mvdec_hevc_buf *b)
 {
+	const struct mvdec_mv_buf *mv = &ctx->mv[vb->index];
 	dma_addr_t y, c;
 
-	/* The slot id is 5 bits and is programmed as slot + 1. */
-	if (vb->index >= MVDEC_HEVC_SLOTS || !ctx->mv[vb->index].cpu)
+	if (!mv->cpu ||
+	    mv->size < mvdec_hevc_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height))
 		return -EINVAL;
 	y = vb2_dma_contig_plane_dma_addr(vb, 0);
 	c = vb2_dma_contig_plane_dma_addr(vb, 1);
@@ -634,12 +635,32 @@ static int mvdec_hevc_buf(struct mvdec_ctx *ctx, struct vb2_buffer *vb,
 		return -EINVAL;
 	b->y = lower_32_bits(y);
 	b->c = lower_32_bits(c);
