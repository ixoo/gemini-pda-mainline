 	if (ret)
@@ -1171,8 +1196,8 @@ int mvdec_hevc_run(struct mvdec_ctx *ctx, struct vb2_v4l2_buffer *src,
 	mvdec_hevc_write_scaling(p, run->scaling);
 	mvdec_hevc_write_params(p, reg_c8(&w, s->last_rps_count));
 
-	s->held |= BIT(p->cur.slot);
-	s->poc[p->cur.slot] = p->dec->pic_order_cnt_val;
