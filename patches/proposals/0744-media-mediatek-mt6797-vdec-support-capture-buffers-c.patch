@@ -1143,13 +1165,16 @@ int mvdec_hevc_run(struct mvdec_ctx *ctx, struct vb2_v4l2_buffer *src,
 	p->idr = p->sl->nal_unit_type == HEVC_NAL_IDR_W_RADL ||
 		 p->sl->nal_unit_type == HEVC_NAL_IDR_N_LP;
 
+	ret = mvdec_hevc_slots(ctx, p, &dst->vb2_buf);
+	if (ret)
+		goto out;
 	ret = mvdec_hevc_buf(ctx, &dst->vb2_buf, &p->cur);
