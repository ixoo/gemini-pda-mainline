-	b->slot = vb->index;
+	b->mv = lower_32_bits(mv->dma);
+	/* Programmed as slot + 1; unused for a buffer without a slot (EC). */
+	b->slot = ctx->slot[vb->index] - 1;
 	b->lt = 0;
 	return 0;
 }
 
+/* Hardware slots for the current picture and every picture in the DPB. */
+static int mvdec_hevc_slots(struct mvdec_ctx *ctx, const struct mvdec_hevc_pic *p,
+			    struct vb2_buffer *dst)
+{
+	struct vb2_queue *vq = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	unsigned int i, n = p->dec->num_active_dpb_entries;
+	u64 bufs = BIT_ULL(dst->index);
+	struct vb2_buffer *vb;
+
+	if (n > V4L2_HEVC_DPB_ENTRIES_NUM_MAX)
+		return -EINVAL;
+	for (i = 0; i < n; i++) {
+		vb = vb2_find_buffer(vq, p->dec->dpb[i].timestamp);
+		if (vb)
+			bufs |= BIT_ULL(vb->index);
+	}
+	return mvdec_map_slots(ctx, bufs);
+}
+
 static int mvdec_hevc_ref(struct mvdec_ctx *ctx, struct mvdec_hevc_pic *p,
 			  unsigned int idx, struct mvdec_hevc_buf *b)
 {
@@ -724,7 +745,8 @@ static int mvdec_hevc_lists(struct mvdec_ctx *ctx, struct mvdec_hevc_pic *p)
  * buffers that hold a decoded picture, the one with the nearest POC, the
