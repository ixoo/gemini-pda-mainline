diff --git a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c
index 57fe5c476..966ac4c16 100644
--- a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c
+++ b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c
@@ -340,6 +340,54 @@ static int mvdec_buf_out_validate(struct vb2_buffer *vb)
 	return 0;
 }
 
+/* VP9 keeps its single collocated-MV buffer in its working buffers. */
+static size_t mvdec_mv_size(struct mvdec_ctx *ctx)
+{
+	u32 codec = ctx->src_fmt.pixelformat;
+
+	if (mvdec_is_vp9(codec))
+		return 0;
+	if (mvdec_is_h264(codec))
+		return mvdec_h264_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height);
+	return mvdec_hevc_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height);
+}
+
+/* Each capture buffer gets its collocated-MV buffer, whenever it is created. */
+static int mvdec_buf_init(struct vb2_buffer *vb)
+{
+	struct mvdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct mvdec_mv_buf *mv;
+	size_t size;
+
+	if (V4L2_TYPE_IS_OUTPUT(vb->type))
+		return 0;
+	if (vb->index >= VIDEO_MAX_FRAME)
+		return -EINVAL;
+	size = mvdec_mv_size(ctx);
+	if (!size)
+		return 0;
+	mv = &ctx->mv[vb->index];
+	mv->cpu = dma_alloc_coherent(ctx->dev->dev, size, &mv->dma, GFP_KERNEL);
+	if (!mv->cpu)
+		return -ENOMEM;
+	mv->size = size;
+	return 0;
+}
+
+static void mvdec_buf_cleanup(struct vb2_buffer *vb)
+{
+	struct mvdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct mvdec_mv_buf *mv;
+
+	if (V4L2_TYPE_IS_OUTPUT(vb->type) || vb->index >= VIDEO_MAX_FRAME)
+		return;
+	mv = &ctx->mv[vb->index];
+	if (!mv->cpu)
+		return;
+	dma_free_coherent(ctx->dev->dev, mv->size, mv->cpu, mv->dma);
+	mv->cpu = NULL;
+}
+
 static void mvdec_buf_queue(struct vb2_buffer *vb)
 {
 	struct mvdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
@@ -379,23 +427,9 @@ static void mvdec_free_aux(struct mvdec_ctx *ctx)
 	}
 }
 
-static void mvdec_free_mv(struct mvdec_ctx *ctx)
-{
-	unsigned int i;
-
-	for (i = 0; i < VIDEO_MAX_FRAME; i++) {
-		if (!ctx->mv[i].cpu)
-			continue;
-		dma_free_coherent(ctx->dev->dev, ctx->mv[i].size, ctx->mv[i].cpu,
-				  ctx->mv[i].dma);
-		ctx->mv[i].cpu = NULL;
-	}
-}
-
 static int mvdec_start_streaming(struct vb2_queue *vq, unsigned int count)
 {
 	struct mvdec_ctx *ctx = vb2_get_drv_priv(vq);
-	size_t size;
 	unsigned int i;
 
 	if (V4L2_TYPE_IS_OUTPUT(vq->type))
@@ -404,25 +438,11 @@ static int mvdec_start_streaming(struct vb2_queue *vq, unsigned int count)
 	memset(&ctx->hevc, 0, sizeof(ctx->hevc));
 	memset(&ctx->h264, 0, sizeof(ctx->h264));
 	memset(&ctx->vp9, 0, sizeof(ctx->vp9));
-	/*
-	 * One zeroed collocated-MV buffer per capture buffer. VP9 keeps a
-	 * single one, for the previous frame, in its working buffers.
-	 */
-	if (mvdec_is_vp9(ctx->src_fmt.pixelformat))
-		size = 0;
-	else if (mvdec_is_h264(ctx->src_fmt.pixelformat))
-		size = mvdec_h264_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height);
-	else
-		size = mvdec_hevc_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height);
-	for (i = 0; size && i < vb2_get_num_buffers(vq) && i < VIDEO_MAX_FRAME; i++) {
-		ctx->mv[i].size = size;
-		ctx->mv[i].cpu = dma_alloc_coherent(ctx->dev->dev, size,
-						    &ctx->mv[i].dma, GFP_KERNEL);
-		if (!ctx->mv[i].cpu) {
-			mvdec_free_mv(ctx);
-			return -ENOMEM;
-		}
-	}
+	memset(ctx->slot, 0, sizeof(ctx->slot));
+	/* Each stream starts with zeroed collocated-MV buffers. */
+	for (i = 0; i < VIDEO_MAX_FRAME; i++)
+		if (ctx->mv[i].cpu)
+			memset(ctx->mv[i].cpu, 0, ctx->mv[i].size);
 	if (mvdec_is_h264(ctx->src_fmt.pixelformat) ||
 	    mvdec_is_vp9(ctx->src_fmt.pixelformat)) {
 		int ret = mvdec_is_vp9(ctx->src_fmt.pixelformat) ?
@@ -430,7 +450,6 @@ static int mvdec_start_streaming(struct vb2_queue *vq, unsigned int count)
 
 		if (ret) {
 			mvdec_free_aux(ctx);
-			mvdec_free_mv(ctx);
 			return ret;
 		}
 	}
@@ -452,14 +471,14 @@ static void mvdec_stop_streaming(struct vb2_queue *vq)
 		v4l2_ctrl_request_complete(vbuf->vb2_buf.req_obj.req, &ctx->hdl);
 		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
 	}
-	if (!V4L2_TYPE_IS_OUTPUT(vq->type)) {
-		mvdec_free_mv(ctx);
+	if (!V4L2_TYPE_IS_OUTPUT(vq->type))
 		mvdec_free_aux(ctx);
-	}
 }
 
 static const struct vb2_ops mvdec_qops = {
 	.queue_setup		= mvdec_queue_setup,
+	.buf_init		= mvdec_buf_init,
+	.buf_cleanup		= mvdec_buf_cleanup,
 	.buf_prepare		= mvdec_buf_prepare,
 	.buf_out_validate	= mvdec_buf_out_validate,
 	.buf_queue		= mvdec_buf_queue,
@@ -690,7 +709,6 @@ static int mvdec_release(struct file *file)
 	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
 	mutex_unlock(&vdev->lock);
 	v4l2_ctrl_handler_free(&ctx->hdl);
-	mvdec_free_mv(ctx);
 	mvdec_free_aux(ctx);
 	kvfree(ctx);
 	return 0;
diff --git a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-h264.c b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-h264.c
index b0a63029a..4b9b53258 100644
--- a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-h264.c
+++ b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-h264.c
@@ -16,7 +16,7 @@
  * Supported: frame-based decoding with Annex-B start codes, the whole picture
  * in one OUTPUT buffer starting with the first slice's start code,
  * progressive (frame_mbs_only) 8-bit 4:2:0 Baseline, Main and High streams
- * without slice groups, SP or SI slices, at most 17 capture buffers.
+ * without slice groups, SP or SI slices.
  * Everything else is rejected with -EINVAL before the decoder starts.
  *
  * Register meanings come from reverse engineering. The sequence follows the
@@ -59,8 +59,6 @@
 #define H264_NAL_SLICE		1
 #define H264_NAL_IDR		5
 
-/* Capture buffers the 5-bit slot field of the list attributes can name. */
-#define H264_SLOTS		17
 /* Prefetch margin past the data that the bitstream window covers. */
 #define H264_BS_MARGIN		0x100
 #define H264_LIST_REGS		32
@@ -250,9 +248,11 @@ static int mvdec_h264_check(struct mvdec_ctx *ctx, const struct mvdec_h264_run *
 static int mvdec_h264_buf(struct mvdec_ctx *ctx, struct vb2_buffer *vb,
 			  struct mvdec_h264_buf *b)
 {
+	const struct mvdec_mv_buf *mv = &ctx->mv[vb->index];
 	dma_addr_t y, c;
 
-	if (vb->index >= H264_SLOTS || !ctx->mv[vb->index].cpu)
+	if (!ctx->slot[vb->index] || !mv->cpu ||
+	    mv->size < mvdec_h264_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height))
 		return -EINVAL;
 	y = vb2_dma_contig_plane_dma_addr(vb, 0);
 	c = vb2_dma_contig_plane_dma_addr(vb, 1);
@@ -261,11 +261,31 @@ static int mvdec_h264_buf(struct mvdec_ctx *ctx, struct vb2_buffer *vb,
 		return -EINVAL;
 	b->y = lower_32_bits(y);
 	b->c = lower_32_bits(c);
-	b->mv = lower_32_bits(ctx->mv[vb->index].dma);
-	b->slot = vb->index;
+	b->mv = lower_32_bits(mv->dma);
+	b->slot = ctx->slot[vb->index] - 1;
 	return 0;
 }
 
+/* Hardware slots for the current picture and the references in the DPB. */
+static int mvdec_h264_slots(struct mvdec_ctx *ctx, const struct mvdec_h264_pic *p,
+			    struct vb2_buffer *dst)
+{
+	struct vb2_queue *vq = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	const struct v4l2_h264_dpb_entry *dpb = p->dec->dpb;
+	u64 bufs = BIT_ULL(dst->index);
+	struct vb2_buffer *vb;
+	unsigned int i;
+
+	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
+		if (!(dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+			continue;
+		vb = vb2_find_buffer(vq, dpb[i].reference_ts);
+		if (vb)
+			bufs |= BIT_ULL(vb->index);
+	}
+	return mvdec_map_slots(ctx, bufs);
+}
+
 /*
  * Resolve every active DPB entry to its capture buffer and build the initial
  * (default) lists. The hardware applies ref_pic_list_modification() itself.
@@ -788,6 +808,9 @@ int mvdec_h264_run(struct mvdec_ctx *ctx, struct vb2_v4l2_buffer *src,
 	p->h = (p->sps->pic_height_in_map_units_minus1 + 1) * 16;
 	p->pitch = ctx->dst_fmt.plane_fmt[0].bytesperline;
 
+	ret = mvdec_h264_slots(ctx, p, &dst->vb2_buf);
+	if (ret)
+		goto out;
 	ret = mvdec_h264_buf(ctx, &dst->vb2_buf, &p->cur);
 	if (ret)
 		goto out;
