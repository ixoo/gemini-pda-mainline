diff --git a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec.h b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec.h
index 496a84c23..5b5d94ea4 100644
--- a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec.h
+++ b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec.h
@@ -6,6 +6,7 @@
 #ifndef _MT6797_VDEC_H
 #define _MT6797_VDEC_H
 
+#include <linux/bitops.h>
 #include <linux/clk.h>
 #include <linux/io.h>
 #include <linux/mutex.h>
@@ -103,14 +104,17 @@ struct mvdec_mv_buf {
 	size_t size;
 };
 
-/* Capture buffers the 5-bit HEVC slot ids can name (programmed as slot + 1). */
-#define MVDEC_HEVC_SLOTS	17
+/*
+ * Hardware picture slots: up to 16 references and the current picture. The
+ * vendor DPB never holds more pictures, so higher slot ids are untested.
+ */
+#define MVDEC_SLOTS		17
 
 /* HEVC state kept across pictures (mt6797-vdec-hevc.c). */
 struct mvdec_hevc_state {
 	u32 last_rps_count;		/* size of the last explicit slice RPS */
-	u32 held;			/* capture buffers holding a picture */
-	s32 poc[MVDEC_HEVC_SLOTS];	/* POC last decoded into each buffer */
+	u64 held;			/* capture buffers holding a picture */
+	s32 poc[VIDEO_MAX_FRAME];	/* POC last decoded into each buffer */
 };
 
 /* VP9 symbol counts whose rows the decoder pads (mt6797-vdec-vp9.c). */
@@ -154,6 +158,7 @@ struct mvdec_ctx {
 	struct v4l2_pix_format_mplane src_fmt;
 	struct v4l2_pix_format_mplane dst_fmt;
 	struct mvdec_mv_buf mv[VIDEO_MAX_FRAME];
+	u8 slot[VIDEO_MAX_FRAME];	/* hardware slot + 1 per buffer, 0: none */
 	struct mvdec_hevc_state hevc;
 	struct mvdec_h264_state h264;
 	struct mvdec_vp9_state vp9;
@@ -165,6 +170,36 @@ static inline struct mvdec_ctx *fh_to_ctx(struct v4l2_fh *fh)
 	return container_of(fh, struct mvdec_ctx, fh);
 }
 
+/*
+ * Map the capture buffers in @bufs (a mask of vb2 indices: the current
+ * picture and its references) to hardware slots. A buffer keeps its slot
+ * while it stays in the set and loses it when it leaves. A buffer without a
+ * slot takes its own index when that is free, so up to MVDEC_SLOTS buffers
+ * map one to one, and otherwise the lowest free slot.
+ */
+static inline int mvdec_map_slots(struct mvdec_ctx *ctx, u64 bufs)
+{
+	unsigned int i, s;
+	u32 used = 0;
+
+	for (i = 0; i < VIDEO_MAX_FRAME; i++) {
+		if (!(bufs & BIT_ULL(i)))
+			ctx->slot[i] = 0;
+		else if (ctx->slot[i])
+			used |= BIT(ctx->slot[i] - 1);
+	}
+	for (i = 0; i < VIDEO_MAX_FRAME; i++) {
+		if (!(bufs & BIT_ULL(i)) || ctx->slot[i])
+			continue;
+		s = i < MVDEC_SLOTS && !(used & BIT(i)) ? i : ffz(used);
+		if (s >= MVDEC_SLOTS)
+			return -EINVAL;
+		used |= BIT(s);
+		ctx->slot[i] = s + 1;
+	}
+	return 0;
+}
+
 static inline u32 mvdec_read(struct mvdec_dev *vdev, u32 off)
 {
 	return readl(vdev->base + off);
