From e98ab63f45adabf1e36c573da74b7ddd4b6ef8e9 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 17:42:30 -0400
Subject: [PATCH] wifi: mt6797: keep one CCMP replay counter per TID

Security-relevant. Boot S refused twelve unicast QoS data frames at
the PN check (pn=lower): both receive checks kept one replay counter
for all TIDs, so once the access point sent on more than one TID a
frame on one TID could fall below the counter another TID had advanced.
CCMP requires a receiver to keep a replay counter per TID, because a
transmitter's frames on different TIDs may be reordered against each
other; mac80211 keeps them so (rx_pn[tid]).

Both the pairwise and the group context now keep eight counters: TID
0's is the existing field, which a non-QoS data frame shares as in
mac80211, and TIDs 1-7 are new. A frame is checked against its own
TID's counter and advances only that one. Every counter stays strict:
nothing at or below its TID's last PN is accepted, and no check is
relaxed. A QoS TID of 8 or more (TSPEC, never negotiated) is refused.
Each counter is seeded at key installation from mac80211's receive
sequence for that TID, and cleared with the context as before. The
refusal record names the frame's TID and the context whose counter
refused it.
---
 .../wireless/mediatek/mt6797/ccmp-gtk-rx.h    | 14 +++++----
 .../net/wireless/mediatek/mt6797/ccmp-rx.h    | 27 +++++++++++++----
 drivers/net/wireless/mediatek/mt6797/mac.c    | 30 ++++++++++++++-----
 3 files changed, 53 insertions(+), 18 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/ccmp-gtk-rx.h b/drivers/net/wireless/mediatek/mt6797/ccmp-gtk-rx.h
index ff377615d..c1922ea39 100644
--- a/drivers/net/wireless/mediatek/mt6797/ccmp-gtk-rx.h
+++ b/drivers/net/wireless/mediatek/mt6797/ccmp-gtk-rx.h
@@ -8,7 +8,8 @@
  * the PTK shape/status/PN contract, changing only group key class, ID, index
  * and RA. A valid group does not make firmware integrity independently proven.
  * False preserves every input/context/output byte; true advances only this
- * context's strict PN after complete validation. No delivery or key lookup.
+ * context's strict PN for the frame's TID after complete validation (0292).
+ * No delivery or key lookup.
  */
 static inline bool
 mt6797_ccmp_gtk_rx_check(const unsigned char *packet, size_t bytes,
@@ -18,7 +19,8 @@ mt6797_ccmp_gtk_rx_check(const unsigned char *packet, size_t bytes,
 	struct mt6797_ccmp_rx r;
 	unsigned char pn[6];
 	size_t offset = 48; /* base16, mandatory Group4 at16, Group1 at32 */
-	unsigned int groups, fc, i;
+	unsigned int groups, fc, i, tid;
+	unsigned char *last;
 	bool greater = false, own_any = false, ap_any = false, source_any = false;
 	const unsigned char *ethernet;
 
@@ -71,10 +73,12 @@ mt6797_ccmp_gtk_rx_check(const unsigned char *packet, size_t bytes,
 	    (((unsigned int)ethernet[12] << 8) | ethernet[13]) < 0x0600 ||
 	    (ethernet[12] == 0x88 && ethernet[13] == 0x8e))
 		return false;
+	tid = packet[9] & 15;
+	last = tid ? context->tid_pn[tid - 1] : context->pn;
 	for (i = 0; i < 6; i++) {
-		if (pn[i] < context->pn[i])
+		if (pn[i] < last[i])
 			return false;
-		if (pn[i] > context->pn[i]) {
+		if (pn[i] > last[i]) {
 			greater = true;
 			break;
 		}
@@ -84,7 +88,7 @@ mt6797_ccmp_gtk_rx_check(const unsigned char *packet, size_t bytes,
 	r.offset = offset;
 	r.bytes = bytes - offset;
 	for (i = 0; i < 6; i++)
-		context->pn[i] = pn[i];
+		last[i] = pn[i];
 	*out = r;
 	return true;
 }
diff --git a/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h b/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h
index fa319052f..c5ca91500 100644
--- a/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h
+++ b/drivers/net/wireless/mediatek/mt6797/ccmp-rx.h
@@ -13,6 +13,15 @@
 #define MT6797_CCMP_RX_QOS_BIT 0U
 #endif
 
+/* CCMP keeps one replay counter per TID, and mac80211 keeps them so
+ * (rx_pn[tid]): a frame is checked against its own TID's counter and
+ * advances only that one. TID 0's counter is pn, which a non-QoS data frame
+ * shares, as in mac80211; TIDs 1-7 are tid_pn. Every counter stays strict:
+ * nothing at or below its TID's last PN is accepted. A QoS TID of 8 or more
+ * (TSPEC, never negotiated here) is refused (0292).
+ */
+#define MT6797_CCMP_RX_TIDS 8U
+
 /* Descriptor byte 9 carries the cipher in its high nibble (CCMP, 4) and the
  * frame's TID in its low nibble (boot P). With WMM a QoS data frame is
  * admitted on any TID whose QoS control holds only that TID (normal
@@ -26,7 +35,8 @@ static inline bool mt6797_ccmp_rx_tid_ok(const unsigned char *packet, unsigned i
 	if ((packet[9] & 0xf0) != 0x40)
 		return false;
 	if (fc & MT6797_CCMP_RX_QOS_BIT)
-		return !(qos & ~0x000fU) && (qos & 15) == (packet[9] & 15U);
+		return !(qos & ~0x000fU) && (qos & 15) == (packet[9] & 15U) &&
+		       (qos & 15) < MT6797_CCMP_RX_TIDS;
 	return !qos && !(packet[9] & 15);
 }
 
@@ -41,6 +51,7 @@ struct mt6797_ccmp_rx_context {
 	unsigned int cipher;
 	unsigned char key_bytes, key_id, wlan_index, rxd_bssid, channel;
 	unsigned char own[6], ap[6], pn[6];
+	unsigned char tid_pn[MT6797_CCMP_RX_TIDS - 1][6]; /* TIDs 1-7 (0292) */
 };
 
 struct mt6797_ccmp_rx {
@@ -51,7 +62,8 @@ struct mt6797_ccmp_rx {
  * Provisional public gen3/mt7603 descriptor contract, not firmware assurance.
  * Only non-BA, non-QoS, unfragmented CCMP128 unicast with Group4+Group1 is
  * accepted. Status0xc000 excludes the source-defined errors and aggregation.
- * Group1 first6 LE PN is converted to mac80211 order and checked strictly.
+ * Group1 first6 LE PN is converted to mac80211 order and checked strictly
+ * against the frame's own TID's counter (0292).
  * No flags/delivery/logging/MMIO. False preserves ALL context/output bytes;
  * true commits only the validated PN and Ethernet view, under caller locking.
  */
@@ -63,7 +75,8 @@ mt6797_ccmp_rx_check(const unsigned char *packet, size_t bytes,
 	struct mt6797_ccmp_rx r;
 	unsigned char pn[6];
 	size_t offset = 48; /* base16, mandatory Group4 at16, Group1 at32 */
-	unsigned int groups, fc, i;
+	unsigned int groups, fc, i, tid;
+	unsigned char *last;
 	bool greater = false, own_any = false, ap_any = false, source_any = false;
 	const unsigned char *ethernet;
 
@@ -115,10 +128,12 @@ mt6797_ccmp_rx_check(const unsigned char *packet, size_t bytes,
 	    (((unsigned int)ethernet[12] << 8) | ethernet[13]) < 0x0600 ||
 	    (ethernet[12] == 0x88 && ethernet[13] == 0x8e))
 		return false;
+	tid = packet[9] & 15;
+	last = tid ? context->tid_pn[tid - 1] : context->pn;
 	for (i = 0; i < 6; i++) {
-		if (pn[i] < context->pn[i])
+		if (pn[i] < last[i])
 			return false;
-		if (pn[i] > context->pn[i]) {
+		if (pn[i] > last[i]) {
 			greater = true;
 			break;
 		}
@@ -128,7 +143,7 @@ mt6797_ccmp_rx_check(const unsigned char *packet, size_t bytes,
 	r.offset = offset;
 	r.bytes = bytes - offset;
 	for (i = 0; i < 6; i++)
-		context->pn[i] = pn[i];
+		last[i] = pn[i];
 	*out = r;
 	return true;
 }
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 07d73c70d..056fd7db8 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -813,7 +813,8 @@ static bool mt6797_ccmp_llc_mismatch(struct mt6797_mac *mac, size_t bytes)
  * with the first of them that differs from the admitted shape. Lengths,
  * flags and the PN's order only; no address or payload byte. The status
  * word's bits that differ from the admitted 0xc000 are named as the pinned
- * nic_rx.h names them (0290).
+ * nic_rx.h names them (0290). The PN's order is against the counter of the
+ * frame's own TID in the context its WLAN index selects, both named (0292).
  */
 static void mt6797_ccmp_rx_refused(struct mt6797_mac *mac, size_t bytes)
 {
@@ -824,8 +825,9 @@ static void mt6797_ccmp_rx_refused(struct mt6797_mac *mac, size_t bytes)
 	};
 	const u8 *p = mac->join_packet;
 	const struct mt6797_ccmp_rx_context *c;
-	unsigned int groups, fc = 0x10000, qos = 0x10000, i, diff, n = 0;
+	unsigned int groups, fc = 0x10000, qos = 0x10000, i, diff, n = 0, tid;
 	const char *field, *pn = "n/a";
+	const unsigned char *last;
 	char status[144];
 
 #ifdef CONFIG_MT6797_WMM_QOS_DATA
@@ -847,6 +849,8 @@ static void mt6797_ccmp_rx_refused(struct mt6797_mac *mac, size_t bytes)
 	}
 	groups = (mt6797_join_le16(p + 2) >> 9) & 15;
 	c = p[8] == 2 ? &mac->ccmp_gtk_rx : &mac->ccmp_rx;
+	tid = p[9] & 15;
+	last = tid >= MT6797_CCMP_RX_TIDS ? NULL : tid ? c->tid_pn[tid - 1] : c->pn;
 	diff = mt6797_join_le16(p + 10) ^ 0xc000;
 	for (i = 0; i < 16; i++)
 		if (diff & BIT(i))
@@ -857,9 +861,11 @@ static void mt6797_ccmp_rx_refused(struct mt6797_mac *mac, size_t bytes)
 	if (groups & 8) {
 		fc = mt6797_join_le16(p + 16);
 		qos = mt6797_join_le16(p + 26);
+	}
+	if ((groups & 8) && last) {
 		for (i = 0; i < 6; i++) {
-			if (p[32 + 5 - i] != c->pn[i]) {
-				pn = p[32 + 5 - i] > c->pn[i] ? "greater" : "lower";
+			if (p[32 + 5 - i] != last[i]) {
+				pn = p[32 + 5 - i] > last[i] ? "greater" : "lower";
 				break;
 			}
 		}
@@ -878,10 +884,11 @@ static void mt6797_ccmp_rx_refused(struct mt6797_mac *mac, size_t bytes)
 		mt6797_join_le32(p + 28) ? "ht-control" :
 		strcmp(pn, "greater") ? "pn" : "other";
 	dev_info(wiphy_dev(mac->hw->wiphy),
-		 "one-shot WLAN data rx refused: n=%u field=%s bytes=%zu groups=0x%x p4=0x%02x p6=0x%02x p7=0x%02x wlan=%u p9=0x%02x prefix=0x%04x status=%s fc=0x%04x qos=0x%04x ht=0x%08x pn=%s\n",
+		 "one-shot WLAN data rx refused: n=%u field=%s bytes=%zu groups=0x%x p4=0x%02x p6=0x%02x p7=0x%02x wlan=%u p9=0x%02x prefix=0x%04x status=%s fc=0x%04x qos=0x%04x ht=0x%08x pn=%s tid=%u counter=%s\n",
 		 mac->ccmp_rx_refused, field, bytes, groups, p[4], p[6], p[7], p[8], p[9],
 		 mt6797_join_le16(p + 10), status, fc, qos,
-		 (groups & 8) ? mt6797_join_le32(p + 28) : 0, pn);
+		 (groups & 8) ? mt6797_join_le32(p + 28) : 0, pn, tid,
+		 p[8] == 2 ? "group" : "pairwise");
 }
 
 /* Caller holds the MAC mutex and has already admitted this ACTIVE RX. */
@@ -6411,7 +6418,8 @@ static int mt6797_mac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	unsigned long flags;
 	int ret;
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
-	struct ieee80211_key_seq seed;
+	struct ieee80211_key_seq seed, tid_seed[MT6797_CCMP_RX_TIDS - 1];
+	unsigned int tid;
 
 	if (ccmp_stable_epoch && cmd == DISABLE_KEY)
 		return mt6797_ccmp_disable_key(mac);
@@ -6461,6 +6469,8 @@ static int mt6797_mac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 		mutex_unlock(&mac->mutex);
 		mutex_lock(&mac->ccmp_receive_mutex);
 		ieee80211_get_key_rx_seq(key, 0, &seed);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			ieee80211_get_key_rx_seq(key, tid, &tid_seed[tid - 1]);
 		mutex_unlock(&mac->ccmp_receive_mutex);
 		mutex_lock(&mac->mutex);
 		if (mac->ccmp_closed || mac->first_error || mac->closing ||
@@ -6475,6 +6485,8 @@ static int mt6797_mac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	if (ccmp_stable_epoch && pairwise) {
 		mac->ccmp_ptk_attempted = true;
 		ieee80211_get_key_rx_seq(key, 0, &seed);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			ieee80211_get_key_rx_seq(key, tid, &tid_seed[tid - 1]);
 		reinit_completion(&mac->ccmp_key_done);
 	}
 #endif
@@ -6533,6 +6545,8 @@ static int mt6797_mac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 			goto failed;
 		}
 		memcpy(mac->ccmp_rx.pn, seed.ccmp.pn, 6);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			memcpy(mac->ccmp_rx.tid_pn[tid - 1], tid_seed[tid - 1].ccmp.pn, 6);
 		memcpy(mac->ccmp_rx.own, hw->wiphy->perm_addr, 6);
 		memcpy(mac->ccmp_rx.ap, mac->join_ap, 6);
 		mac->ccmp_rx.cipher = key->cipher;
@@ -6561,6 +6575,8 @@ static int mt6797_mac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 			goto failed;
 		}
 		memcpy(mac->ccmp_gtk_rx.pn, seed.ccmp.pn, 6);
+		for (tid = 1; tid < MT6797_CCMP_RX_TIDS; tid++)
+			memcpy(mac->ccmp_gtk_rx.tid_pn[tid - 1], tid_seed[tid - 1].ccmp.pn, 6);
 		memcpy(mac->ccmp_gtk_rx.own, hw->wiphy->perm_addr, 6);
 		memcpy(mac->ccmp_gtk_rx.ap, mac->join_ap, 6);
 		mac->ccmp_gtk_rx.cipher = key->cipher;
-- 
2.43.0

