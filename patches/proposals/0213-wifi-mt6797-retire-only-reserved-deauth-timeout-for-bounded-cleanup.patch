From 60e48ac5c73fc510b69a84c458e963c99141f1c7 Mon Sep 17 00:00:00 2001
From: Codex Experiment <codex-experiment@example.invalid>
Date: Sun, 18 Oct 2026 17:33:14 -0400
Subject: [PATCH] wifi: mt6797: retire only reserved deauth timeout for bounded
 cleanup

Preserve the existing management completion bound. Retire only the owned
cleanup frame, count a missing completion, and keep its page charged.
Permit the first PM abort against one retained page, then require the
full ledger before advancing. Late status for that retired PID cannot
free a second skb or release credit.

No deadline extension, page refund, PID reuse, key reuse, reconnect or
broad unknown-event tolerance. Internal experiment archive, synthetic
non-certifying author; no DCO certification and not an upstream submission.
---
 drivers/net/wireless/mediatek/mt6797/hif.c    |  59 +++++++++-
 drivers/net/wireless/mediatek/mt6797/hif.h    |   3 +
 .../mediatek/mt6797/join-command-submit.h     |  40 +++++++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 108 +++++++++++++++++-
 4 files changed, 203 insertions(+), 7 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 97c87a3..c6c1505 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -605,9 +605,11 @@ unlock:
 	return error;
 }
 
-static int mt6797_hif_send_join_command(struct mt6797_hif *hif,
-	unsigned int cid, unsigned int sequence, const u8 *payload,
-	size_t payload_bytes, bool sensitive, u64 deadline_ns)
+static int
+mt6797_hif_send_join_command_debt(struct mt6797_hif *hif,
+				  unsigned int cid, unsigned int sequence,
+				  const u8 *payload, size_t payload_bytes, bool sensitive,
+				  u64 deadline_ns, unsigned int deauth_pages)
 {
 	struct mt6797_hif_pio_result transfer;
 	struct mt6797_hif_command command;
@@ -623,8 +625,24 @@ static int mt6797_hif_send_join_command(struct mt6797_hif *hif,
 		error = -EIO;
 		goto unlock;
 	}
-	error = mt6797_join_prepare_command(&hif->normal, cid, sequence,
-		payload, payload_bytes, hif->scratch, sizeof(hif->scratch), &command);
+	if (deauth_pages) {
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+		if (cid != 0x17 || payload_bytes != 4 || payload[0] || payload[1] ||
+		    payload[2] || payload[3]) {
+			error = -EINVAL;
+			goto unlock;
+		}
+		error = mt6797_join_prepare_cleanup_abort(&hif->normal, sequence,
+							  deauth_pages, hif->scratch,
+							  sizeof(hif->scratch), &command);
+#else
+		error = -EOPNOTSUPP;
+#endif
+	} else {
+		error = mt6797_join_prepare_command(&hif->normal, cid, sequence,
+						    payload, payload_bytes, hif->scratch,
+						    sizeof(hif->scratch), &command);
+	}
 	if (error)
 		goto unlock;
 	error = mt6797_hif_enter(hif, deadline_ns);
@@ -646,6 +664,14 @@ unlock:
 	return error;
 }
 
+static int mt6797_hif_send_join_command(struct mt6797_hif *hif,
+					unsigned int cid, unsigned int sequence, const u8 *payload,
+					size_t payload_bytes, bool sensitive, u64 deadline_ns)
+{
+	return mt6797_hif_send_join_command_debt(hif, cid, sequence, payload,
+						 payload_bytes, sensitive, deadline_ns, 0);
+}
+
 int mt6797_hif_join_filter(struct mt6797_hif *hif, unsigned int sequence,
 			   u64 deadline_ns)
 {
@@ -692,6 +718,29 @@ int mt6797_hif_join_pm_abort(struct mt6797_hif *hif, unsigned int sequence,
 	return mt6797_hif_send_join_command(hif, 0x17, sequence, payload,
 					   sizeof(payload), false, deadline_ns);
 }
+
+int mt6797_hif_join_pm_abort_debt(struct mt6797_hif *hif, unsigned int sequence,
+				  unsigned int deauth_pages, u64 deadline_ns)
+{
+	u8 payload[4] = {0};
+
+	if (deauth_pages != 1)
+		return -EINVAL;
+	return mt6797_hif_send_join_command_debt(hif, 0x17, sequence, payload,
+						 sizeof(payload), false, deadline_ns, deauth_pages);
+}
+
+bool mt6797_hif_cleanup_abort_ready(struct mt6797_hif *hif)
+{
+	bool ready;
+
+	if (!hif || !mutex_trylock(&hif->mutex))
+		return false;
+	ready = mt6797_join_cleanup_abort_ready(&hif->normal, 1);
+	mutex_unlock(&hif->mutex);
+	return ready;
+}
+
 #endif
 
 int mt6797_hif_join_station(struct mt6797_hif *hif, unsigned int sequence,
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index 3e13546..aaafe55 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -226,6 +226,9 @@ int mt6797_hif_join_pm_connected(struct mt6797_hif *hif, unsigned int sequence,
 				 u64 deadline_ns);
 int mt6797_hif_join_pm_abort(struct mt6797_hif *hif, unsigned int sequence,
 			     u64 deadline_ns);
+int mt6797_hif_join_pm_abort_debt(struct mt6797_hif *hif, unsigned int sequence,
+				  unsigned int deauth_pages, u64 deadline_ns);
+bool mt6797_hif_cleanup_abort_ready(struct mt6797_hif *hif);
 #endif
 int mt6797_hif_join_station(struct mt6797_hif *hif, unsigned int sequence,
 	const u8 *ap, unsigned int state, unsigned int aid,
diff --git a/drivers/net/wireless/mediatek/mt6797/join-command-submit.h b/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
index a648d58..e1d726d 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
@@ -109,4 +109,44 @@ mt6797_join_prepare_command(struct mt6797_normal_transaction *t,
 		t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
 	return error;
 }
+
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+/* One retired deauthentication may still own one TC4 page. No refund, quota
+ * change or ordinary command admission: only the first PM abort may use the
+ * remaining pool, and the caller must await the whole ledger before advancing.
+ */
+static inline bool
+mt6797_join_cleanup_abort_ready(const struct mt6797_normal_transaction *t,
+				unsigned int deauth_pages)
+{
+	return t && deauth_pages == 1 &&
+		t->phase == MT6797_NORMAL_NVRAM_SUBMITTED && t->used_sequences &&
+		t->tc4_limit > 1 && t->tc4_limit <= 0xffffU &&
+		t->tc4_free == t->tc4_limit - 1 &&
+		t->tc4_pending_cpu <= 1 && t->tc4_pending_ffa <= 1 &&
+		t->tc1_free == t->tc1_limit && !t->tc1_pending;
+}
+
+static inline int
+mt6797_join_prepare_cleanup_abort(struct mt6797_normal_transaction *t,
+				  unsigned int sequence, unsigned int deauth_pages,
+				  unsigned char *output,
+				  size_t capacity, struct mt6797_hif_command *command)
+{
+	const unsigned char payload[4] = {0};
+	int error;
+
+	if (command)
+		*command = (struct mt6797_hif_command){0};
+	if (!sequence || sequence > 255 || !output || !command ||
+	    !mt6797_join_cleanup_abort_ready(t, deauth_pages))
+		return -EBUSY;
+	error = mt6797_normal_encode(t, 0x17, 1, sequence, payload, sizeof(payload),
+				     12, MT6797_NORMAL_CONFIG_TX, output, capacity, command);
+	if (!error)
+		t->config_return_phase = MT6797_NORMAL_NVRAM_SUBMITTED;
+	return error;
+}
+#endif
+
 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 7e7e460..c261a00 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -227,6 +227,8 @@ struct mt6797_mac {
 	bool ccmp_dtim_valid, ccmp_pm_attempted, ccmp_pm_connected;
 	bool ccmp_pm_abort_pending, ccmp_pm_abort_credited;
 	bool ccmp_loss_reported;
+	unsigned int ccmp_deauth_timeouts, ccmp_deauth_late;
+	u8 ccmp_deauth_retired_pid;
 #endif
 	struct ieee80211_sta __rcu *ccmp_sta;
 	/* Cookies only: never dereferenced, withdrawn before DISABLE_KEY returns. */
@@ -490,6 +492,71 @@ static void mt6797_ccmp_timeout_observe(struct mt6797_mac *mac, size_t bytes)
 		 mac->join_beacon_interval, mac->ccmp_timeout_observed);
 }
 
+/* Only the reserved, driver-owned deauth may retire without TX status. Its
+ * page remains charged. Neither mac80211 ACK status nor firmware retirement
+ * is invented; every other frame timeout is still fatal.
+ */
+static bool mt6797_ccmp_deauth_retire(struct mt6797_mac *mac, u64 now,
+				      struct sk_buff_head *discard, struct sk_buff **internal)
+{
+	if (!ccmp_stable_epoch || mac->ccmp_deauth_timeouts || mac->first_error ||
+	    mac->closing || mac->join_retired || mac->scan_active || !mac->join_running ||
+	    !mac->join_data_phase || !mac->join_data_ended || !mac->ccmp_pm_connected ||
+	    !mac->join_cleanup_requested || mac->join_cleanup_done || mac->join_cleanup_stage ||
+	    !mac->join_sta_active || mac->native_diag_state != MT6797_ND_CLOSED ||
+	    !mac->join_internal || mac->join_inflight != mac->join_internal ||
+	    mac->join_inflight_data || mac->join_internal->len != 26 ||
+	    mt6797_join_le16(mac->join_internal->data) != 0x00c0 ||
+	    !mac->join_pid || mac->join_pid > 127 || mac->join_page_debt > 1 ||
+	    mac->join_credit_pending || mac->join_data_page_debt ||
+	    now < mac->join_frame_deadline || now >= mac->join_deadline ||
+	    !discard || !internal || *internal)
+		return false;
+	mac->ccmp_deauth_timeouts++;
+	mac->ccmp_deauth_retired_pid = mac->join_pid;
+	*internal = mac->join_internal;
+	__skb_queue_tail(discard, mac->join_internal);
+	mac->join_inflight = NULL;
+	mac->join_internal = NULL;
+	mac->join_last_acked = false;
+	complete_all(&mac->join_frame_done);
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN deauth completion missing: pid=%u timeouts=%u debt=%u acked=0 no_reuse=1\n",
+		 mac->ccmp_deauth_retired_pid, mac->ccmp_deauth_timeouts, mac->join_page_debt);
+	return true;
+}
+
+static bool mt6797_ccmp_deauth_abort_owed(const struct mt6797_mac *mac)
+{
+	return ccmp_stable_epoch && mac->ccmp_deauth_timeouts == 1 &&
+		mac->join_cleanup_requested && mac->join_data_ended &&
+		!mac->first_error && !mac->closing && !mac->join_retired &&
+		!mac->join_cleanup_stage && mac->ccmp_pm_connected &&
+		!mac->ccmp_pm_abort_pending && !mac->ccmp_pm_abort_credited &&
+		mac->join_page_debt == 1 && !mac->join_inflight;
+}
+
+/* A late completion for this lifetime's one retired PID cannot own a second
+ * skb or credit. Unknown PIDs, invalid status and malformed events still fail.
+ */
+static bool mt6797_ccmp_deauth_late(struct mt6797_mac *mac, size_t bytes)
+{
+	struct mt6797_join_tx_result result;
+
+	if (!ccmp_stable_epoch || !mac->ccmp_deauth_timeouts ||
+	    !mac->join_running || !mac->join_cleanup_requested || mac->join_retired ||
+	    mac->first_error || mac->closing ||
+	    !mt6797_join_tx_done(mac->join_packet, bytes,
+				 mac->ccmp_deauth_retired_pid, 1, &result) ||
+	    (result.status > 7 && (result.status < 32 || result.status > 34)))
+		return false;
+	mac->ccmp_deauth_late++;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN retired deauth completion: pid=%u status=%u late=%u no_credit=1\n",
+		 mac->ccmp_deauth_retired_pid, result.status, mac->ccmp_deauth_late);
+	return true;
+}
+
 /* MAC mutex held; this standard API only queues work, never calls back here.
  * A finite healthy terminal and a fatal live-data stop share one notification.
  */
@@ -1655,14 +1722,24 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	queued = !skb_queue_empty(&mac->join_queue);
 	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	if (queued || mac->join_inflight ||
+	    (mac->join_page_debt && !mt6797_ccmp_deauth_abort_owed(mac)) ||
+#else
 	if (queued || mac->join_inflight || mac->join_page_debt ||
+#endif
 	    mac->join_credit_pending)
 		return 0;
 #ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
 	if (!mt6797_native_diag_cleanup_allowed(mac->native_diag_state))
 		return 0;	/* wait for the native enable/disable to retire first */
 #endif
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	if (mac->join_sta_active && !mac->join_deauth_done &&
+	    !(ccmp_stable_epoch && mac->ccmp_deauth_timeouts == 1))
+#else
 	if (mac->join_sta_active && !mac->join_deauth_done)
+#endif
 		return 0;
 	/* TC1 pages of the last data frame may return after its TX status; the
 	 * ledger must be whole before a cleanup command, so wait for them (the
@@ -1675,7 +1752,13 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 	ret = mt6797_mac_join_guard(mac, deadline);
 	if (ret)
 		return ret;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	if (!mt6797_hif_normal_idle(mac->hif) &&
+	    !(mt6797_ccmp_deauth_abort_owed(mac) &&
+	      mt6797_hif_cleanup_abort_ready(mac->hif))) {
+#else
 	if (!mt6797_hif_normal_idle(mac->hif)) {
+#endif
 		/* Diagnostic only: name the host ledger terms behind this refusal
 		 * (no hardware read), then end the lifetime exactly as before.
 		 * The snapshot is a second trylock taken after the failed check,
@@ -1705,13 +1788,19 @@ static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
 			 "one-shot WLAN PM abort credit: returned=1\n");
 	}
 	if (ccmp_stable_epoch && mac->ccmp_pm_connected) {
+		unsigned int deauth_debt = mt6797_ccmp_deauth_abort_owed(mac) ? 1 : 0;
+
 		if (mac->sequence > 253)
 			return -ENOSPC;
 		mac->join_credit_deadline = deadline;
 		reinit_completion(&mac->join_credit_done);
 		mac->join_credit_pending = true;
-		mac->join_page_debt = 1;
-		ret = mt6797_hif_join_pm_abort(mac->hif, mac->sequence++, deadline);
+		mac->join_page_debt = deauth_debt + 1;
+		if (deauth_debt)
+			ret = mt6797_hif_join_pm_abort_debt(mac->hif, mac->sequence++,
+							    deauth_debt, deadline);
+		else
+			ret = mt6797_hif_join_pm_abort(mac->hif, mac->sequence++, deadline);
 		dev_info(wiphy_dev(mac->hw->wiphy),
 			 "one-shot WLAN PM abort: sequence=%u status=%d\n", mac->sequence - 1, ret);
 		if (!ret)
@@ -2194,7 +2283,15 @@ static int mt6797_mac_join_fail_stop(struct mt6797_mac *mac, int ret,
 		mac->join_inflight = NULL;
 	}
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	/* This tick may already own the retired deauth in discard. Preserve its
+	 * free path if a later guard/cleanup command fails in the same tick.
+	 */
+	if (!*internal)
+		*internal = mac->join_internal;
+#else
 	*internal = mac->join_internal;
+#endif
 	mac->join_internal = NULL;
 #else
 	*internal = NULL;
@@ -2380,6 +2477,9 @@ static void mt6797_mac_join_work(struct work_struct *work)
 		goto unlock;
 	now = ktime_get_ns();
 	branch = 1;
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+	mt6797_ccmp_deauth_retire(mac, now, &discard, &internal);
+#endif
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
 	if (now >= mac->join_deadline && !mac->first_error && !mac->closing) {
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
@@ -2708,6 +2808,10 @@ submitted:
 						(unsigned int)rx.logical_bytes;
 				}
 			}
+#endif
+#ifdef CONFIG_MT6797_CCMP_INITIAL_GTK
+			if (mt6797_ccmp_deauth_late(mac, rx.logical_bytes))
+				continue;
 #endif
 			if (mt6797_join_event(mac->join_packet, rx.logical_bytes, 0x0f, 16)) {
 				if (!mac->join_inflight ||
