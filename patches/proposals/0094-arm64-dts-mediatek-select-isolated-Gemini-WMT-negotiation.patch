From d3a2cb0002e40ee2ce997b80e93cff571acfc359 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sat, 3 Oct 2026 12:11:56 +0000
Subject: [PATCH 94/94] arm64: dts: mediatek: select isolated Gemini WMT
 negotiation

Change only the diagnostic selector; preserve BTIF resources, clocks,
IRQ and the disabled WLAN child. No automatic negotiation occurs at
probe.

Internal experiment archive; synthetic non-certifying author, no DCO.
Compile-review only; no hardware result.
---
 arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
index 7a44ddd..2c51e3f 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -89,7 +89,7 @@
 		clocks = <&infrasys CLK_INFRA_BTIF>, <&infrasys CLK_INFRA_AP_DMA>;
 		clock-names = "btif", "ap-dma";
 		interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_LOW>;
-		mediatek,one-shot-wmt-default-query;
+		mediatek,one-shot-wmt-negotiate;
 		mediatek,one-shot-power-probe;
 		mediatek,one-shot-chip-id-probe;
 		mediatek,one-shot-reset-release-probe;
-- 
