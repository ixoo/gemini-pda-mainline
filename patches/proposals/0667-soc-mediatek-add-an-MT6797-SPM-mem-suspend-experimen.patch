 drivers/soc/mediatek/Makefile           |   1 +
 drivers/soc/mediatek/mt6797-spm-sleep.c | 794 ++++++++++++++++++++++++
 3 files changed, 809 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-spm-sleep.c

