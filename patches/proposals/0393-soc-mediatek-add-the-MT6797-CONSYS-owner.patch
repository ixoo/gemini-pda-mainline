From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 1 Nov 2026 05:42:32 -0500
Subject: [PATCH 393/394] soc: mediatek: add the MT6797 CONSYS owner

Claim the shared CONSYS resources at probe and start the connectivity
subsystem on request. A root write to region19_prepare and then to
wmt_negotiate runs the start chain: CONN power with the chip ID check,
the CONMCU reset release, WMT negotiation over BTIF, the common
initialization (ROM patches, coexistence, RF calibration), the WLAN host
interface, the firmware copy into the protected EMI window and the WLAN
firmware start. The mac module then attaches. wlan_stop stops the
firmware, and unloading the module powers CONN off so that a later load
starts again from off.

The station series selected each stage with a device tree property; the
chain is now fixed and the driver reads none of them. The WMT and STP
helpers move into one header, mt6797-wmt.h.

Part of the clean MT6797 Wi-Fi series (Wi-Fi daily-use plan, phase 1).
---
 drivers/soc/mediatek/Kconfig         |   13 +
 drivers/soc/mediatek/Makefile        |    1 +
 drivers/soc/mediatek/mt6797-consys.c | 2251 ++++++++++++++++++++++++++
 drivers/soc/mediatek/mt6797-wmt.h    | 1771 ++++++++++++++++++++
 4 files changed, 4036 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-consys.c
 create mode 100644 drivers/soc/mediatek/mt6797-wmt.h

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index 0ab2e061f..a33ab375c 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -45,6 +45,19 @@ config MTK_INFRACFG
 	  INFRACFG controller contains various infrastructure registers not
 	  directly associated to any device.
 
+config MTK_MT6797_CONSYS
+	tristate "MediaTek MT6797 shared CONSYS reservation owner"
+	depends on ARM64 && OF && OF_RESERVED_MEM
+	depends on MT6797_HIF_CORE || !MT6797_HIF_CORE
+	select CRYPTO_LIB_SHA256
+	help
+	  Claim the boot-allocated no-map CONSYS firmware reservation on MT6797.
+	  The claim is retained for the built-in owner's lifetime. This does not
+	  power CONSYS, set a remap or grant a WLAN firmware load.
+
+	  As a module (mt6797-consys), unloading it stops the WLAN firmware
+	  and powers CONN off, so the next load starts it again.
+
 config MTK_MT6797_A72_POWER
 	bool "MediaTek MT6797 Cortex-A72 power resource observer"
 	depends on ARM64 && ARCH_MEDIATEK && OF
