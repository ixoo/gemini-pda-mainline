+#include "../../net/wireless/mediatek/mt6797/firmware.h"
+#include "../../net/wireless/mediatek/mt6797/hif.h"
+#include "../../net/wireless/mediatek/mt6797/record-prepare.h"
+#if IS_ENABLED(CONFIG_MT6797_MAC80211)
+#include "../../net/wireless/mediatek/mt6797/mac.h"
+#endif
+#include "mt6797-wmt.h"
+
+#define MT6797_CONSYS_REMAP_REG	0x10001340
+#define MT6797_CONSYS_SLEEP_MASK_REG	0x10001350
+#define MT6797_CONSYS_SLEEP_MASK	BIT(8)
+#define MT6797_CONSYS_CHIP_ID_REG	0x18070008
+#define MT6797_CONSYS_MCU_ACR_REG	0x18070110
+#define MT6797_CONSYS_MCU_ACR_MBIST	BIT(18)
+#define MT6797_CONSYS_AFE_REG	0x180b6000
+#define MT6797_CONSYS_AFE_SIZE	0x100
+#define MT6797_CONSYS_HIF_REG	0x180f0000
+#define MT6797_CONSYS_HIF_SIZE	0x1100
+#define MT6797_CONSYS_HIF_DMA_REG	0x11000080
+#define MT6797_CONSYS_HIF_DMA_SIZE	0x80
+#define MT6797_CONSYS_HIF_DATA_PORT	0x1000
+#define MT6797_CONSYS_EMI_SELECTOR_REG	0x10001f00
+#define MT6797_HIF_CMD_SETUP	0x0000
+#define MT6797_HIF_CMD52_DATA	0x0004
+#define MT6797_HIF_CMD53_DATA	0x1000
+#define MT6797_HIF_CCCR_IOEX	0x0002
+#define MT6797_HIF_CCCR_IORX	0x0003
+#define MT6797_HIF_WIFI_FUNCTION	BIT(1)
+#define MT6797_HIF_WCIR_ID	0x0279
+#define MT6797_HIF_WHLPCR	0x0004
+#define MT6797_HIF_WRPLR	0x0090
+#define MT6797_HIF_DRIVER_OWN	BIT(8)
+#define MT6797_HIF_DRIVER_OWN_REQUEST	BIT(9)
+#define MT6797_HIF_FW_OWN_SET	BIT(8)
+#define MT6797_HIF_WLAN_READY	BIT(21)
+#define MT6797_BOOT_EVENT_MAX	8U
+#define MT6797_BOOT_DEBUG_EVENT	0x27U
+#define MT6797_BOOT_SLEEPY_EVENT	0x07U
+#define MT6797_EMI_MPU_READ	0x82000208
+#define MT6797_EMI_MPU_SET	0x82000209
+#define MT6797_EMI_REGION18	18U
+#define MT6797_EMI_REGION18_RANGE	0x0370
+#define MT6797_EMI_REGION18_POLICY	0x03b0
+#define MT6797_EMI_REGION19_RANGE	0x0378
+#define MT6797_EMI_REGION19_POLICY	0x03b8
+#define MT6797_EMI_REGION23_RANGE	0x0398
+#define MT6797_EMI_REGION23_POLICY	0x03bc
+#define MT6797_EMI_REGION1_RANGE	0x0168
+#define MT6797_EMI_REGION19	19U
+#define MT6797_EMI_COPY_POLICY	0x00b6da28
+#define MT6797_EMI_FINAL_POLICY	0x00b6da2d
+#define MT6797_WMT_CLEAR_BYTES	(343 * SZ_1K)
+#define MT6797_REMAP_OFF_VALUE	0x180e0000
+#define MT6351_VCN33_ACTIVE	(BIT(3) | BIT(1))
+#define MT6351_VCN28_HW_CONTROL	BIT(3)
+#define MT6351_VCN28_ENABLE	BIT(1)
+#define MT6351_VCN28_CLOCK_SELECT	(GENMASK(7, 5) | GENMASK(13, 11))
+#define MT6351_VCN28_CLOCK_EXPECTED	((3 << 5) | (3 << 11))
+
+struct mt6797_consys {
+#if IS_ENABLED(CONFIG_MT6797_MAC80211)
+	/* Built-in owner retains powered HIF and wiphy for the whole boot. */
+	struct ieee80211_hw *wlan_hw;
+	/* The started firmware, kept for the one mac80211 attach. */
+	struct device *wlan_dev;
+	struct mt6797_normal_capability wlan_capability;
+	bool wlan_ready;
+	bool wlan_attached;
+	bool wlan_configured;
+#endif
+	struct mt6797_wmt_query wmt_query;
+	struct mt6797_wmt_negotiate wmt_negotiate;
+	struct {
+		struct mt6797_wmt_full_io io;
+		unsigned char command[WMT_FULL_MAX_PAYLOAD];
+		unsigned char calibration[8];
+		struct wmt_init_step step;
+		unsigned int completed, antenna_mode, calibration_bytes;
+		int result;
+		bool bt_rail, wifi_rail;
+	} common_init;
+	int wmt_query_result;
+	void __iomem *remap;
+	void __iomem *sleep_mask;
+	void __iomem *chip_id;
+	void __iomem *mcu_acr;
+	void __iomem *afe;
+	void __iomem *hif;
+	void __iomem *hif_dma;
+	void __iomem *emi_selector;
+	void __iomem *emi_window;
+	u8 __iomem *region19_window;
+	struct mt6797_wlan_firmware *wlan_image;
+	struct resource reservation;
+	struct regulator *vcn18;
+	struct regulator *vcn28;
+	struct regulator *vcn33_wifi;
+	struct regulator *vcn33_bt;
+	struct reset_control *conmcu_reset;
+	struct generic_pm_domain *conn_domain;
+	bool bound;
+	bool emi_set_attempted;
+	bool emi_sealed;
+	bool emi_copy_attempted;
+	struct mt6797_init_transaction fw_transaction;
+	struct mt6797_hif *fw_hif;
+	bool fw_start_attempted;
+	bool wmt_init_attempted;
+	bool wmt_init_complete;
+	bool deferred_start_attempted;
+	/* Votes taken by the start, returned on unload. */
+	bool vcn18_on, vcn28_on, conn_on, hif_vcn33_on;
+};
+
+static DEFINE_MUTEX(mt6797_consys_lock);
+static struct mt6797_consys mt6797_consys;
+#if IS_ENABLED(CONFIG_MT6797_MAC80211)
+static DEFINE_MUTEX(mt6797_consys_wlan_lock);
+#endif
+
+static int mt6797_consys_check_supplies(struct device_node *node)
+{
+	static const char * const names[] = {
+		"vcn18-supply", "vcn28-supply", "vcn33-wifi-supply",
+	};
+	struct device_node *supply;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		supply = of_parse_phandle(node, names[i], 0);
+		if (!supply)
+			return -EINVAL;
+		of_node_put(supply);
+	}
+
+	return 0;
+}
+
+/* The power probe writes an MT6351-specific bit outside regulator enable. */
+static int mt6797_consys_check_vcn28_source(struct device_node *consumer)
+{
+	struct device_node *supply, *regulators, *pmic;
+	int ret;
+
+	supply = of_parse_phandle(consumer, "vcn28-supply", 0);
+	if (!supply)
+		return -EINVAL;
+	regulators = of_get_parent(supply);
+	pmic = regulators ? of_get_parent(regulators) : NULL;
+	ret = of_node_name_eq(supply, "ldo-vcn28") &&
+	      regulators && of_device_is_compatible(regulators,
+						     "mediatek,mt6351-regulator") &&
+	      pmic && of_device_is_compatible(pmic, "mediatek,mt6351") ?
+	      0 : -EINVAL;
+	of_node_put(pmic);
+	of_node_put(regulators);
+	of_node_put(supply);
+	return ret;
+}
+
+static int mt6797_consys_check_other_regions(struct device_node *root,
+					     struct device_node *target,
+					      u64 base, u64 end)
+{
+	struct device_node *node;
+	struct reserved_mem *other;
+	u64 other_end;
+
+	for_each_child_of_node(root, node) {
+		if (node == target)
+			continue;
+		other = of_reserved_mem_lookup(node);
+		if (!other || !other->size)
+			continue;
+		if (other->size - 1 > ~(u64)0 - other->base) {
+			of_node_put(node);
+			return -ERANGE;
+		}
+		other_end = other->base + other->size - 1;
+		if (base <= other_end && other->base <= end) {
+			of_node_put(node);
+			return -EBUSY;
+		}
+	}
+
+	return 0;
+}
+
+static int mt6797_consys_resolve(struct device_node *consumer,
+				 struct resource *reservation)
+{
+	struct device_node *target, *parent, *root;
+	struct resource boot = {};
+	struct reserved_mem *rmem;
+	u64 end;
+	int address_cells, size_cells;
+	int ret = -EINVAL;
+
+	if (of_reserved_mem_region_count(consumer) != 1 ||
+	    !of_device_is_available(consumer) ||
+	    of_node_check_flag(consumer, OF_DYNAMIC) ||
+	    of_node_check_flag(consumer, OF_DETACHED))
+		return -EINVAL;
+
+	target = of_parse_phandle(consumer, "memory-region", 0);
+	if (!target)
+		return -ENODEV;
+	parent = of_get_parent(target);
+	root = of_find_node_by_path("/reserved-memory");
+	if (!root || parent != root || !of_device_is_available(root) ||
+	    !of_device_is_available(target) ||
+	    of_node_check_flag(root, OF_DYNAMIC) ||
+	    of_node_check_flag(root, OF_DETACHED) ||
+	    of_node_check_flag(target, OF_DYNAMIC) ||
+	    of_node_check_flag(target, OF_DETACHED) ||
+	    !of_device_is_compatible(target, "mediatek,consys-reserve-memory") ||
+	    !of_property_read_bool(target, "no-map") ||
+	    of_property_read_bool(target, "reusable") ||
+	    of_property_read_bool(target, "no-map-fixup") ||
+	    of_device_is_compatible(target, "shared-dma-pool") ||
+	    of_device_is_compatible(target, "restricted-dma-pool"))
+		goto out;
+	address_cells = of_n_addr_cells(target);
+	size_cells = of_n_size_cells(target);
+	/* Match the boot-allocated form, whose node has no static reg. */
+	if (address_cells < 1 || address_cells > 2 ||
+	    size_cells < 1 || size_cells > 2 ||
+	    of_find_property(target, "reg", NULL) ||
+	    of_property_count_u32_elems(target, "size") != size_cells ||
+	    of_property_count_u32_elems(target, "alignment") != address_cells ||
+	    of_property_count_u32_elems(target, "alloc-ranges") !=
+						address_cells + size_cells)
+		goto out;
+
+	rmem = of_reserved_mem_lookup(target);
+	if (!rmem) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (rmem->ops || rmem->priv) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (rmem->size < SZ_1M || !IS_ALIGNED(rmem->base, SZ_1M) ||
+	    rmem->base > U32_MAX || SZ_1M - 1 > U32_MAX - rmem->base ||
+	    rmem->size - 1 > ~(u64)0 - rmem->base) {
+		ret = -ERANGE;
+		goto out;
+	}
+	end = rmem->base + rmem->size - 1;
+	ret = of_reserved_mem_region_to_resource(consumer, 0, &boot);
+	if (ret)
+		goto out;
+	if (resource_type(&boot) != IORESOURCE_MEM ||
+	    boot.start != rmem->base || boot.end != end) {
+		ret = -ESTALE;
+		goto out;
+	}
+	ret = mt6797_consys_check_other_regions(root, target, rmem->base, end);
+	if (!ret)
+		*reservation = boot;
+out:
+	of_node_put(root);
+	of_node_put(parent);
+	of_node_put(target);
+	return ret;
+}
+
+/* Match the entire no-map boot reservation, not just its first MiB. */
+static int mt6797_consys_check_boot_resource(struct resource *res, void *arg)
+{
+	const struct resource *reservation = arg;
+
+	if (res->start != reservation->start ||
+	    res->end != reservation->end ||
+	    resource_type(res) != IORESOURCE_MEM ||
+	    (res->flags & IORESOURCE_SYSRAM))
+		return -EBUSY;
+
+	return 1;
+}
+
+static int mt6797_consys_boot_reserved(struct resource *reservation)
+{
+	int ret;
+
+	ret = walk_iomem_res_desc(IORES_DESC_NONE,
+				  IORESOURCE_MEM | IORESOURCE_BUSY,
+				  reservation->start, reservation->end,
+				  reservation,
+				  mt6797_consys_check_boot_resource);
+	if (ret == 1)
+		return 0;
+	return ret < 0 ? ret : -ENODEV;
+}
+
+/* Sample only the neighboring WMT window; preserve every byte for its owner. */
+static int mt6797_consys_observe_region19(struct device *dev,
+					  struct mt6797_consys *owner)
+{
+	phys_addr_t start = owner->reservation.start + SZ_512K;
+	u8 __iomem *window;
+	u32 nonzero_bytes = 0;
+	unsigned int populated_pages = 0, page, offset;
+	int first_page = -1, last_page = -1;
+
+	window = ioremap(start, SZ_512K);
+	if (!window)
+		return -ENOMEM;
+	for (page = 0; page < SZ_512K / SZ_4K; page++) {
+		unsigned int page_nonzero = 0;
+
+		for (offset = 0; offset < SZ_4K; offset++)
+			page_nonzero += !!readb(window + page * SZ_4K + offset);
+		nonzero_bytes += page_nonzero;
+		if (page_nonzero) {
+			populated_pages++;
+			if (first_page < 0)
+				first_page = page;
+			last_page = page;
+		}
+	}
+	owner->region19_window = window;
+	dev_info(dev,
+		 "one-shot region 19 read-only: start=%pa bytes=%u nonzero=%u pages=%u first=%d last=%d\n",
+		 &start, SZ_512K, nonzero_bytes, populated_pages,
+		 first_page, last_page);
+	return 0;
+}
+
+static u32 mt6797_consys_read_emi(u32 offset);
+
+/* Region 18 as an earlier start sealed it over the WLAN firmware window. */
+static bool mt6797_consys_region18_sealed(struct mt6797_consys *owner,
+					  u32 range, u32 policy)
+{
+	phys_addr_t start = owner->reservation.start;
+	phys_addr_t end = start + SZ_512K - 1;
+
+	return range == (((u32)(start >> 16) << 16) | (u32)(end >> 16)) &&
+	       policy == MT6797_EMI_FINAL_POLICY;
+}
+
+/*
+ * The EMI protection and remap that an earlier start in this boot left,
+ * which an unload keeps: region 19 at its copy policy over the WMT window,
+ * region 18 sealed, region 23 clear and the remap set. A later start
+ * accepts exactly this state as well as the boot's clear one, as the
+ * vendor keeps both regions across CONN power cycles.
+ */
+static bool mt6797_consys_emi_kept(struct mt6797_consys *owner)
+{
+	phys_addr_t start = owner->reservation.start + SZ_512K;
+	phys_addr_t end = start + SZ_512K - 1;
+
+	return mt6797_consys_read_emi(MT6797_EMI_REGION1_RANGE) == 0x44604460 &&
+	       mt6797_consys_read_emi(MT6797_EMI_REGION19_RANGE) ==
+		(((u32)(start >> 16) << 16) | (u32)(end >> 16)) &&
+	       mt6797_consys_read_emi(MT6797_EMI_REGION19_POLICY) ==
+		MT6797_EMI_COPY_POLICY &&
+	       mt6797_consys_region18_sealed(owner,
+					     mt6797_consys_read_emi(MT6797_EMI_REGION18_RANGE),
+			mt6797_consys_read_emi(MT6797_EMI_REGION18_POLICY)) &&
+	       !mt6797_consys_read_emi(MT6797_EMI_REGION23_RANGE) &&
+	       !mt6797_consys_read_emi(MT6797_EMI_REGION23_POLICY) &&
+	       readl(owner->remap) == (MT6797_REMAP_OFF_VALUE |
+		((u32)owner->reservation.start >> 20) | BIT(12));
+}
+
+/* Called with the owner lock held; no CONN power or firmware action. */
+static int mt6797_consys_prepare_wmt(struct device *dev,
+				     struct mt6797_consys *owner)
+{
+	struct arm_smccc_res res;
+	phys_addr_t start, end;
+	u32 remap_before, remap_after, requested, expected_range;
+	u32 region1, range18, policy18, range19, policy19;
+	u32 range23, policy23, range, policy;
+	unsigned int i;
+	int ret;
+
+	if (owner != &mt6797_consys || !owner->bound ||
+	    !owner->region19_window || owner->wmt_init_attempted) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = mtk_pm_domain_confirmed_off(owner->conn_domain);
+	if (ret)
+		goto out;
+	remap_before = readl(owner->remap);
+	region1 = mt6797_consys_read_emi(MT6797_EMI_REGION1_RANGE);
+	range18 = mt6797_consys_read_emi(MT6797_EMI_REGION18_RANGE);
+	policy18 = mt6797_consys_read_emi(MT6797_EMI_REGION18_POLICY);
+	range19 = mt6797_consys_read_emi(MT6797_EMI_REGION19_RANGE);
+	policy19 = mt6797_consys_read_emi(MT6797_EMI_REGION19_POLICY);
+	range23 = mt6797_consys_read_emi(MT6797_EMI_REGION23_RANGE);
+	policy23 = mt6797_consys_read_emi(MT6797_EMI_REGION23_POLICY);
+	dev_info(dev, "one-shot WMT before: remap=0x%08x region1=0x%08x region18=0x%08x/0x%08x\n",
+		 remap_before, region1, range18, policy18);
+	dev_info(dev, "one-shot WMT before: region19=0x%08x/0x%08x region23=0x%08x/0x%08x CONN=off\n",
+		 range19, policy19, range23, policy23);
+	start = owner->reservation.start + SZ_512K;
+	end = start + SZ_512K - 1;
+	expected_range = ((u32)(start >> 16) << 16) | (u32)(end >> 16);
+	requested = ((u32)owner->reservation.start >> 20) | BIT(12);
+	if (mt6797_consys_emi_kept(owner)) {
+		dev_info(dev, "WMT setup kept from an earlier start: region 19, region 18 and remap as set\n");
+		owner->wmt_init_attempted = true;
+		remap_after = remap_before;
+		goto clear;
+	}
+	if (remap_before != MT6797_REMAP_OFF_VALUE ||
+	    region1 != 0x44604460 || range18 || policy18 || range19 ||
+	    policy19 || range23 || policy23) {
+		ret = -EBUSY;
+		goto out;
+	}
+	owner->wmt_init_attempted = true;
+	arm_smccc_smc(MT6797_EMI_MPU_SET, start, end,
+		      (MT6797_EMI_REGION19 << 27) | MT6797_EMI_COPY_POLICY,
+		      0, 0, 0, 0, &res);
+	ret = (s32)(u32)res.a0;
+	range = mt6797_consys_read_emi(MT6797_EMI_REGION19_RANGE);
+	policy = mt6797_consys_read_emi(MT6797_EMI_REGION19_POLICY);
+	dev_info(dev, "one-shot WMT region19: status=%d range=0x%08x policy=0x%08x\n",
+		 ret, range, policy);
+	if (ret || range != expected_range ||
+	    policy != MT6797_EMI_COPY_POLICY) {
+		ret = ret ?: -EIO;
+		goto stopped;
+	}
+	ret = mtk_pm_domain_confirmed_off(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	writel(remap_before | requested, owner->remap);
+	remap_after = readl(owner->remap);
+	dev_info(dev, "one-shot WMT remap: before=0x%08x after=0x%08x expected=0x%08x\n",
+		 remap_before, remap_after, remap_before | requested);
+	if (remap_after != (remap_before | requested)) {
+		ret = -EIO;
+		goto stopped;
+	}
+clear:
+	ret = mtk_pm_domain_confirmed_off(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	memset_io(owner->region19_window, 0, MT6797_WMT_CLEAR_BYTES);
+	/* Complete the AP clear before checking every byte through the mapping. */
+	mb();
+	for (i = 0; i < MT6797_WMT_CLEAR_BYTES; i++) {
+		if (readb(owner->region19_window + i)) {
+			ret = -EIO;
+			goto stopped;
+		}
+	}
+	ret = mtk_pm_domain_confirmed_off(owner->conn_domain);
+	if (ret || readl(owner->remap) != remap_after ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION19_RANGE) != expected_range ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION19_POLICY) !=
+						MT6797_EMI_COPY_POLICY) {
+		ret = ret ?: -EIO;
+		goto stopped;
+	}
+	dev_info(dev, "one-shot WMT setup complete: clear=%u verified, CONN held off\n",
+		 MT6797_WMT_CLEAR_BYTES);
+	owner->wmt_init_complete = true;
+	ret = 0;
+	goto out;
+
+stopped:
+	dev_err(dev, "one-shot WMT setup stopped (%d); state retained\n", ret);
+out:
+	return ret;
+}
+
+static ssize_t region19_prepare_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	int ret;
+
+	if (count != 2 || memcmp(buf, "1\n", 2))
+		return -EINVAL;
+	mutex_lock(&mt6797_consys_lock);
+	ret = mt6797_consys_prepare_wmt(dev, dev_get_drvdata(dev));
+	mutex_unlock(&mt6797_consys_lock);
+	return ret ?: count;
+}
+
+static DEVICE_ATTR_WO(region19_prepare);
+
+/* Associate with CONN only after acquiring the independent shared resources. */
+static int mt6797_consys_attach_off_domain(struct device *dev,
+					   struct generic_pm_domain **domain)
+{
+	struct of_phandle_args spec;
+	int ret;
+
+	if (dev->pm_domain)
+		return -EINVAL;
+
+	ret = of_parse_phandle_with_args(dev->of_node,
+					 "mediatek,conn-power-domain",
+					 "#power-domain-cells", 0, &spec);
+	if (ret)
+		return ret;
+	if (spec.args_count != 1 || spec.args[0] != MT6797_POWER_DOMAIN_CONN ||
+	    !of_device_is_compatible(spec.np, "mediatek,mt6797-power-controller")) {
+		ret = -EINVAL;
+		goto put_node;
+	}
+	ret = of_genpd_add_device(&spec, dev);
+	if (ret == -ENOENT)
+		ret = -EPROBE_DEFER;
+	if (ret)
+		goto put_node;
+	*domain = pd_to_genpd(dev->pm_domain);
+	ret = mtk_pm_domain_confirmed_off(*domain);
+	if (ret)
+		pm_genpd_remove_device(dev);
+put_node:
+	of_node_put(spec.np);
+	return ret;
+}
+
+/* This service reads one EMI MPU register; it does not change protection. */
+static u32 mt6797_consys_read_emi(u32 offset)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MT6797_EMI_MPU_READ, offset, 0, 0, 0, 0, 0, 0, &res);
+	return (u32)res.a0;
+}
+
+/* WMT leaves region 19 protected; the WLAN start expects exactly that. */
+static bool mt6797_consys_region19_admitted(struct mt6797_consys *owner,
+					    u32 range, u32 policy)
+{
+	return owner->wmt_init_complete && owner->deferred_start_attempted &&
+	       range ==
+	       (((u32)((owner->reservation.start + SZ_512K) >> 16) << 16) |
+		(u32)((owner->reservation.start + SZ_1M - 1) >> 16)) &&
+	       policy == MT6797_EMI_COPY_POLICY;
+}
+
+/* Sample the first-load protection premise only after powered ID admission. */
+static bool mt6797_consys_probe_powered_emi(struct device *dev,
+					    struct mt6797_consys *owner)
+{
+	u32 region23_before, region23_after, control;
+	u32 region18, policy18, region19, policy19, policy23;
+	bool region19_admitted;
+	int ret;
+
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto skipped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EIO;
+		goto skipped;
+	}
+	region23_before = mt6797_consys_read_emi(0x0398);
+	control = mt6797_consys_read_emi(0x0168);
+	region18 = mt6797_consys_read_emi(0x0370);
+	policy18 = mt6797_consys_read_emi(0x03b0);
+	region19 = mt6797_consys_read_emi(0x0378);
+	policy19 = mt6797_consys_read_emi(0x03b8);
+	policy23 = mt6797_consys_read_emi(0x03bc);
+	region23_after = mt6797_consys_read_emi(0x0398);
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto skipped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EIO;
+		goto skipped;
+	}
+	region19_admitted = mt6797_consys_region19_admitted(owner, region19,
+							    policy19);
+	dev_info(dev,
+		 "one-shot CONN EMI powered: control1=0x%08x region23-before=0x%08x region23-after=0x%08x\n",
+		 control, region23_before, region23_after);
+	dev_info(dev,
+		 "one-shot CONN EMI powered: region18=0x%08x policy18=0x%08x region19=0x%08x policy19=0x%08x policy23=0x%08x\n",
+		 region18, policy18, region19, policy19, policy23);
+	return control == 0x44604460 && !region23_before && !region23_after &&
+	       ((!region18 && !policy18) ||
+		mt6797_consys_region18_sealed(owner, region18, policy18)) &&
+	       !policy23 && region19_admitted;
+
+skipped:
+	dev_err(dev, "one-shot CONN EMI powered skipped: owner status %d\n", ret);
+	return false;
+}
+
+/* Caller has confirmed CONN power, chip identity and asserted MCU reset. */
+static void mt6797_consys_init_afe(struct mt6797_consys *owner)
+{
+	static const struct {
+		u32 offset;
+		u32 value;
+	} settings[] = {
+		{ 0x20, 0x180b0160 },
+		{ 0x50, 0xb8925421 },
+		{ 0x54, 0x00006401 },
+		{ 0x60, 0xb8925421 },
+		{ 0x64, 0x00006401 },
+		{ 0x68, 0x08400000 },
+		{ 0x6c, 0x0c110200 },
+		{ 0x70, 0x012a020a },
+		{ 0x84, 0x00006401 },
+		{ 0x88, 0x08400000 },
+		{ 0x90, 0x012a020a },
+	};
+	unsigned int i;
+
+	if (!owner->afe)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(settings); i++)
+		writel(settings[i].value, owner->afe + settings[i].offset);
+}
+
+/* Do not undo an uncertain MCU write or reset transition in this one-shot boot. */
+static bool mt6797_consys_probe_reset_release(struct device *dev,
+					      struct mt6797_consys *owner)
+{
+	u32 before, after, chip_id;
+	int ret;
+
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	chip_id = readl(owner->chip_id);
+	if (chip_id != 0x0279) {
+		ret = -ENODEV;
+		goto stopped;
+	}
+	before = readl(owner->mcu_acr);
+	writel(before | MT6797_CONSYS_MCU_ACR_MBIST, owner->mcu_acr);
+	after = readl(owner->mcu_acr);
+	dev_info(dev, "one-shot CONN MCU ACR: before=0x%08x after=0x%08x\n",
+		 before, after);
+	if (after != (before | MT6797_CONSYS_MCU_ACR_MBIST)) {
+		ret = -EIO;
+		goto stopped;
+	}
+	mt6797_consys_init_afe(owner);
+	ret = reset_control_deassert(owner->conmcu_reset);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 0) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	msleep(20);
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 0) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	chip_id = readl(owner->chip_id);
+	dev_info(dev, "one-shot CONN MCU reset released: chip-id=0x%08x, domain ON\n",
+		 chip_id);
+	if (chip_id != 0x0279) {
+		dev_err(dev, "one-shot CONN MCU reset release: unexpected chip ID; state retained\n");
+		return false;
+	}
+	return true;
+
+stopped:
+	dev_err(dev, "one-shot CONN MCU reset release stopped (%d); state retained\n",
+		ret);
+	return false;
+}
+
+/* CMD52 function-zero access through the claimed AHB SDIO-like aperture. */
+static u8 mt6797_consys_hif_cccr_read(struct mt6797_consys *owner, u32 reg)
+{
+	writel(reg << 9, owner->hif + MT6797_HIF_CMD_SETUP);
+	return readl(owner->hif + MT6797_HIF_CMD52_DATA);
+}
+
+static void mt6797_consys_hif_cccr_write(struct mt6797_consys *owner,
+					 u32 reg, u8 value)
+{
+	writel(BIT(31) | (reg << 9) | value,
+	       owner->hif + MT6797_HIF_CMD_SETUP);
+	writel(value, owner->hif + MT6797_HIF_CMD52_DATA);
+}
+
+/* Match only the Gemian PALDO, function-enable and pre-DMA WCIR path. */
+static bool mt6797_consys_probe_hif(struct device *dev,
+				    struct mt6797_consys *owner)
+{
+	struct regmap *pmic;
+	unsigned int bt_control, wifi_control;
+	u32 wcir;
+	u8 ioex, iorx;
+	int ret;
+
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 0) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	if (readl(owner->chip_id) != MT6797_HIF_WCIR_ID) {
+		ret = -ENODEV;
+		goto stopped;
+	}
+	ret = regulator_is_enabled(owner->vcn33_wifi);
+	if (ret) {
+		ret = ret < 0 ? ret : -EBUSY;
+		goto stopped;
+	}
+	pmic = regulator_get_regmap(owner->vcn33_wifi);
+	if (IS_ERR(pmic)) {
+		ret = PTR_ERR(pmic);
+		goto stopped;
+	}
+	ret = regmap_read(pmic, MT6351_LDO_VCN33_BT_CON0, &bt_control);
+	if (ret)
+		goto stopped;
+	ret = regmap_read(pmic, MT6351_LDO_VCN33_WIFI_CON0, &wifi_control);
+	if (ret)
+		goto stopped;
+	dev_info(dev, "one-shot HIF VCN33 before: BT=0x%04x WiFi=0x%04x\n",
+		 bt_control, wifi_control);
+	if ((bt_control | wifi_control) & MT6351_VCN33_ACTIVE) {
+		ret = -EBUSY;
+		goto stopped;
+	}
+	ret = regulator_set_voltage(owner->vcn33_wifi, 3300000, 3300000);
+	if (ret)
+		goto stopped;
+	ret = regulator_enable(owner->vcn33_wifi);
+	if (ret)
+		goto stopped;
+	owner->hif_vcn33_on = true;
+	ret = regulator_is_enabled(owner->vcn33_wifi);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 0) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	ioex = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IOEX);
+	iorx = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IORX);
+	dev_info(dev, "one-shot HIF before enable: IOEx=0x%02x IORx=0x%02x\n",
+		 ioex, iorx);
+	if (ioex || iorx) {
+		ret = -EBUSY;
+		goto stopped;
+	}
+	mt6797_consys_hif_cccr_write(owner, MT6797_HIF_CCCR_IOEX,
+				     MT6797_HIF_WIFI_FUNCTION);
+	ioex = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IOEX);
+	iorx = mt6797_consys_hif_cccr_read(owner, MT6797_HIF_CCCR_IORX);
+	dev_info(dev, "one-shot HIF after enable: IOEx=0x%02x IORx=0x%02x\n",
+		 ioex, iorx);
+	if (ioex != MT6797_HIF_WIFI_FUNCTION ||
+	    iorx != MT6797_HIF_WIFI_FUNCTION) {
+		ret = -EIO;
+		goto stopped;
+	}
+	writel(BIT(28) | 4, owner->hif + MT6797_HIF_CMD_SETUP);
+	wcir = readl(owner->hif + MT6797_HIF_CMD53_DATA);
+	dev_info(dev, "one-shot HIF WCIR=0x%08x\n", wcir);
+	if ((wcir & 0xffff) != MT6797_HIF_WCIR_ID) {
+		ret = -ENODEV;
+		goto stopped;
+	}
+	dev_info(dev, "one-shot HIF function ready; firmware and DMA held\n");
+	return true;
+
+stopped:
+	dev_err(dev, "one-shot HIF stopped (%d); state retained\n", ret);
+	return false;
+}
+
+#if IS_ENABLED(CONFIG_MT6797_HIF_CORE)
+/* These function-1 CMD53 accesses share the owner's serial setup/data pair. */
+static u32 mt6797_consys_hif_f1_read(struct mt6797_consys *owner, u32 reg)
+{
+	writel(BIT(28) | (reg << 9) | 4, owner->hif + MT6797_HIF_CMD_SETUP);
+	return readl(owner->hif + MT6797_HIF_CMD53_DATA);
+}
+
+static void mt6797_consys_hif_f1_write(struct mt6797_consys *owner,
+				       u32 reg, u32 value)
+{
+	writel(BIT(31) | BIT(28) | (reg << 9) | 4,
+	       owner->hif + MT6797_HIF_CMD_SETUP);
+	writel(value, owner->hif + MT6797_HIF_CMD53_DATA);
+}
+
+static int mt6797_consys_observe_tx_status(struct device *dev,
+					   struct mt6797_consys *owner, bool post)
+{
+	struct mt6797_hif_tx_status status[2];
+	struct mt6797_normal_release account[2];
+	unsigned int count = post ? 2 : 1;
+	unsigned int n, i, snapshot;
+	int ret;
+
+	if (1)
+		ret = mt6797_hif_account_tx_status(owner->fw_hif,
+						   ktime_get_ns() + NSEC_PER_SEC, count, status,
+				account);
+	else
+		ret = mt6797_hif_observe_tx_status(owner->fw_hif,
+						   ktime_get_ns() + NSEC_PER_SEC, count, status);
+	for (n = 0; n < count; n++) {
+		snapshot = n + (post ? 1 : 0);
+		dev_info(dev,
+			 "one-shot WLAN TX status: snapshot=%u status=%d valid=0x%03x WHCR=0x%08x WHISR=0x%08x\n",
+			 snapshot, ret, status[n].valid_words,
+			 status[n].whcr, status[n].whisr);
+		for (i = 0; i < 8; i++)
+			if (status[n].valid_words & (1U << (i + 2)))
+				dev_info(dev,
+					 "one-shot WLAN returned pages: snapshot=%u word=%u value=0x%08x\n",
+					 snapshot, i, status[n].wtqcr[i]);
+	}
+	if (1) {
+		for (n = 0; n < count; n++)
+			dev_info(dev,
+				 "one-shot WLAN TC4 reconciliation: snapshot=%u status=%d released=%u free=%u pending_cpu=%u pending_ffa=%u\n",
+				 n + (post ? 1 : 0), ret,
+				 account[n].released_pages, account[n].tc4_free,
+				 account[n].pending_cpu, account[n].pending_ffa);
+	}
+	return ret;
+}
+
+/* Debug and sleepy notices precede normal configuration. Keep active host
+ * ownership through the exact sleepy notice; no low-power handoff is made.
+ * Any other event or malformed notice stops this bounded session.
+ */
+static int mt6797_consys_drain_boot_events(struct device *dev,
+					   struct mt6797_consys *owner)
+{
+	struct mt6797_hif_rx_result rx;
+	u64 deadline = ktime_get_ns() + NSEC_PER_SEC;
+	u8 *packet;
+	u32 last = 0, whlpcr;
+	unsigned int count = 0;
+	unsigned int debug = 0, sleepy = 0;
+	int ret = -E2BIG;
+
+	packet = kmalloc(MT6797_HIF_RX_MAX_PACKET, GFP_KERNEL);
+	if (!packet)
+		return -ENOMEM;
+	while (count < MT6797_BOOT_EVENT_MAX) {
+		ret = mt6797_hif_receive_packet(owner->fw_hif, 0, deadline,
+						packet, MT6797_HIF_RX_MAX_PACKET,
+						&rx);
+		/* Keep metadata from this existing read before admission refuses it.
+		 * Do not dump event bodies or consume another packet for diagnosis.
+		 */
+		dev_info(dev,
+			 "one-shot WLAN boot RX: attempt=%u status=%d pre_valid=%u pre=0x%08x setup=%u complete=%u staging=%zu post_valid=%u post=0x%08x len=%zu type=0x%04x\n",
+			 count + 1, ret, rx.pre_valid, rx.pre_wrplr,
+			 rx.rx_setup, rx.rx_complete, rx.staging_bytes,
+			 rx.post_valid, rx.post_wrplr, rx.logical_bytes,
+			 rx.packet_type);
+		if (!ret && rx.logical_bytes >= 8 && rx.packet_type == 0xe000)
+			dev_info(dev,
+				 "one-shot WLAN boot event: attempt=%u id=0x%02x seq=%u\n",
+				 count + 1, packet[4], packet[5]);
+		if (ret == -EAGAIN) {
+			last = rx.pre_wrplr;
+			ret = last >> 16 ? -EBUSY : 0;
+			break;
+		}
+		if (ret)
+			break;
+		last = rx.post_wrplr;
+		if (rx.logical_bytes < 8 || rx.packet_type != 0xe000) {
+			ret = -EPROTO;
+			break;
+		}
+		if (packet[4] == MT6797_BOOT_DEBUG_EVENT) {
+			debug++;
+		} else if (packet[4] == MT6797_BOOT_SLEEPY_EVENT) {
+			if (rx.logical_bytes != 12) {
+				ret = -EPROTO;
+				break;
+			}
+			/* Admit only boolean state values; retain the active owner.
+			 * Reserved bytes and unsolicited sequence are not an ACK.
+			 */
+			whlpcr = 0;
+			ret = -EPROTO;
+			if (packet[8] <= 1)
+				ret = mt6797_hif_read32(owner->fw_hif,
+							MT6797_HIF_WHLPCR,
+						       deadline, &whlpcr);
+			if (!ret && !(whlpcr & MT6797_HIF_DRIVER_OWN))
+				ret = -EACCES;
+			dev_info(dev,
+				 "one-shot WLAN boot sleepy: status=%d state=%u WHLPCR=0x%08x\n",
+				 ret, packet[8], whlpcr);
+			if (ret)
+				break;
+			sleepy++;
+		} else {
+			ret = -EPROTO;
+			break;
+		}
+		count++;
+		if (!last)
+			break;
+		if (last >> 16) {
+			ret = -EBUSY;
+			break;
+		}
+	}
+	if (!ret && count == MT6797_BOOT_EVENT_MAX && last)
+		ret = -E2BIG;
+	dev_info(dev,
+		 "one-shot WLAN boot event drain: status=%d count=%u debug=%u sleepy=%u post=0x%08x\n",
+		 ret, count, debug, sleepy, last);
+	kfree_sensitive(packet);
+	return ret;
+}
+
+#if IS_ENABLED(CONFIG_MT6797_MAC80211)
+int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops)
+{
+	struct mt6797_consys *owner = &mt6797_consys;
+	struct mt6797_wifi_record *record = NULL;
+	struct device *dev;
+	bool reattach;
+	int ret;
+
+	mutex_lock(&mt6797_consys_wlan_lock);
+	ret = !owner->wlan_ready ? -ENODEV : owner->wlan_attached ? -EBUSY : 0;
+	if (ret)
+		goto out;
+	/* One attempt: a failed attach may leave firmware state behind. */
+	owner->wlan_attached = true;
+	reattach = owner->wlan_configured;
+	dev = owner->wlan_dev;
+	ret = mt6797_wifi_record_prepare(dev, &record);
+	dev_info(dev, "one-shot WLAN private record prepare: status=%d\n", ret);
+	if (!ret) {
+		ret = ops->reg(dev, owner->fw_hif, &owner->wlan_capability,
+			       record, reattach, &owner->wlan_hw);
+		dev_info(dev, "one-shot WLAN regulatory configuration: status=%d%s\n",
+			 ret, reattach ? " (kept from the first attach)" : "");
+	}
+	mt6797_wifi_record_release(record);
+	if (ret)
+		goto out;
+	/* The accounting pair sets the TC4 baseline once per boot. The only
+	 * later normal sender is the RTNL-serialized notifier.
+	 */
+	if (!reattach) {
+		rtnl_lock();
+		ret = mt6797_consys_observe_tx_status(dev, owner, true);
+		rtnl_unlock();
+		if (ret)
+			goto out;
+	}
+	ops->scan_ready(owner->wlan_hw);
+	owner->wlan_configured = true;
+out:
+	mutex_unlock(&mt6797_consys_wlan_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_wlan_attach);
+
+void mt6797_consys_wlan_detach(const struct mt6797_mac_ops *ops)
+{
+	struct mt6797_consys *owner = &mt6797_consys;
+
+	mutex_lock(&mt6797_consys_wlan_lock);
+	if (owner->wlan_attached && owner->wlan_hw) {
+		ops->unreg(owner->wlan_hw);
+		owner->wlan_hw = NULL;
+		owner->wlan_attached = false;
+		dev_info(owner->wlan_dev, "one-shot WLAN mac detached; firmware kept\n");
+	}
+	mutex_unlock(&mt6797_consys_wlan_lock);
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_wlan_detach);
+
+#if IS_MODULE(CONFIG_MT6797_MAC80211)
+/*
+ * The stop half of a firmware restart (experiment R1), once per boot, with
+ * the mac layer detached: the vendor's adapter stop, NIC_POWER_CTRL power
+ * mode 1, then WLAN_READY polled for at most one second. Only when it
+ * clears are FW own set and VCN33-WIFI switched off. A timeout stops here
+ * with nothing more done; no mailbox interrupt, assert or reset follows.
+ * The firmware stays stopped until CONN is powered off and on again.
+ */
+static int mt6797_consys_wlan_stop(struct device *dev, struct mt6797_consys *owner)
+{
+	u32 wcir = 0, whlpcr;
+	int sequence, ret;
+
+	lockdep_assert_held(&mt6797_consys_wlan_lock);
+	ret = !owner->wlan_ready ? -ENODEV : owner->wlan_attached ? -EBUSY : 0;
+	if (ret)
+		return ret;
+	owner->wlan_ready = false;
+	sequence = mt6797_hif_next_sequence(owner->fw_hif);
+	if (sequence < 0) {
+		ret = sequence;
+		goto stopped;
+	}
+	sequence = max(sequence, 5);
+	ret = mt6797_hif_power_off(owner->fw_hif, sequence,
+				   ktime_get_ns() + NSEC_PER_SEC, &wcir);
+	dev_info(dev, "WLAN stop: power-off status=%d sequence=%d WCIR=0x%08x\n",
+		 ret, sequence, wcir);
+	if (ret)
+		goto stopped;
+	mt6797_consys_hif_f1_write(owner, MT6797_HIF_WHLPCR, MT6797_HIF_FW_OWN_SET);
+	usleep_range(1000, 1500);
+	whlpcr = mt6797_consys_hif_f1_read(owner, MT6797_HIF_WHLPCR);
+	ret = regulator_disable(owner->vcn33_wifi);
+	if (!ret)
+		owner->hif_vcn33_on = false;
+	dev_info(dev, "WLAN stop: FW own WHLPCR=0x%08x, VCN33-WIFI off=%d enabled=%d\n",
+		 whlpcr, ret, regulator_is_enabled(owner->vcn33_wifi));
+	if (ret)
+		goto stopped;
+	dev_info(dev, "WLAN stopped\n");
+	return 0;
+stopped:
+	dev_err(dev, "WLAN stop stopped (%d); nothing escalated, state retained\n", ret);
+	return ret;
+}
+
+static ssize_t wlan_stop_store(struct device *dev, struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	int ret;
+
+	if (count != 2 || memcmp(buf, "1\n", 2))
+		return -EINVAL;
+	mutex_lock(&mt6797_consys_wlan_lock);
+	ret = mt6797_consys_wlan_stop(dev, &mt6797_consys);
+	mutex_unlock(&mt6797_consys_wlan_lock);
+	return ret ?: count;
+}
+
+static DEVICE_ATTR_WO(wlan_stop);
+#endif
+#endif
