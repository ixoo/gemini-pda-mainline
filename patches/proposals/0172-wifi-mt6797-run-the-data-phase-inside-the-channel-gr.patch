+		/* Both keys installed: open the bounded data phase inside the
+		 * grant; the reserved deauthentication waits for its end and
+		 * cleanup stage 1 returns the privilege. A phase that cannot open
+		 * ends the lifetime below.
 		 */
 		ret = mt6797_mac_join_release_channel(mac);
 		if (ret)
