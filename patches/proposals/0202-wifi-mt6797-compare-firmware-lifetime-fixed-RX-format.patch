 	    ktime_get_ns() >= mac->join_data_deadline)
@@ -3174,6 +3213,20 @@ static void mt6797_mac_scan_work(struct work_struct *work)
 			ret = mt6797_hif_receive_runtime_packet(mac->hif, port, deadline,
 								mac->scan_packet,
