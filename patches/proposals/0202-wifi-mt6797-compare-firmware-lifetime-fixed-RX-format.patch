 	return error;
 }
 
+#ifdef CONFIG_MT6797_CCMP_FIXED_RX_FORMAT
+/* Caller excludes all other normal senders until the one-page debit retires.
+ * Credit is command-buffer retirement, not a firmware application/queue fence.
+ */
+int mt6797_hif_configure_rx_format(struct mt6797_hif *hif,
+		unsigned int sequence, u64 deadline_ns, enum mt6797_rx_format_phase *phase)
+{
+	struct mt6797_hif_tx_status status;
+	struct mt6797_normal_release account;
+	u8 payload[MT6797_DIAG_MASK_BYTES];
+	u64 now = ktime_get_ns();
+	bool submitted = false;
+	int ret;
+
+	if (!phase)
+		return -EINVAL;
+	*phase = MT6797_RX_FORMAT_ADMISSION;
+	if (!hif || (deadline_ns > now && deadline_ns - now > 100000000ULL))
+		return -EINVAL;
+	if (!mutex_trylock(&hif->mutex))
+		return -EBUSY;
+	if (hif->first_error || !hif->tx_status_accounting_baseline ||
+	    !hif->tx_status_normal_attempted)
+		ret = -EIO;
+	else
+		ret = hif->rx_format_attempted ? -EALREADY : 0;
+	if (!ret)
+		hif->rx_format_attempted = true;
+	mutex_unlock(&hif->mutex);
+	if (ret)
+		return ret;
+	mt6797_diag_mask_payload(true, payload);
+	*phase = MT6797_RX_FORMAT_PRIOR_CREDIT;
+	for (;;) {
+		if (mt6797_hif_normal_idle(hif)) {
+			if (submitted) {
+				*phase = MT6797_RX_FORMAT_DONE;
+				return 0;
+			}
+			/* Retire prior normal configuration before charging this page. */
+			*phase = MT6797_RX_FORMAT_SUBMIT;
+			ret = mt6797_hif_send_config(hif, MT6797_NORMAL_RX_FORMAT, sequence,
+						   payload, sizeof(payload), deadline_ns);
+			if (ret)
+				return ret;
+			submitted = true;
+			*phase = MT6797_RX_FORMAT_CREDIT;
+		}
+		ret = mt6797_hif_reconcile_runtime(hif, deadline_ns, &status, &account);
+		if (ret)
+			return ret;
+		if (!mt6797_hif_normal_idle(hif))
+			usleep_range(20000, 21000);
+	}
+}
+#endif
