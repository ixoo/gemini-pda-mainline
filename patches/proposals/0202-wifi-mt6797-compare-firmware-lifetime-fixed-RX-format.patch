+
+#ifdef CONFIG_MT6797_CCMP_FIXED_RX_FORMAT
+int mt6797_mac_prepare_rx_format(struct ieee80211_hw *hw)
+{
+	struct mt6797_mac *mac = hw->priv;
+	enum mt6797_rx_format_phase phase = MT6797_RX_FORMAT_ADMISSION;
+	int ret;
+
+	ASSERT_RTNL();
+	mutex_lock(&mac->mutex);
+	if (mac->rx_format_attempted || mac->scan_ready || mac->started ||
+	    mac->vif || mac->scan_used || !mac->configured ||
+	    mac->closing || mac->first_error || mac->sequence > 255) {
+		ret = mac->first_error ? mac->first_error : -EIO;
+	} else {
+		mac->rx_format_attempted = true;
+		ret = mt6797_hif_configure_rx_format(mac->hif, mac->sequence++,
+				ktime_get_ns() + 100 * NSEC_PER_MSEC, &phase);
+	}
+	if (ret) {
+		if (!mac->first_error)
+			mac->first_error = ret;
+		mac->closing = true;
+		mac->rx_format_ready = false;
+		mac->scan_ready = false;
+	} else {
+		mac->rx_format_ready = true;
+	}
+	dev_info(wiphy_dev(hw->wiphy),
+		 "one-shot WLAN fixed RX format: status=%d phase=%u credited=%u mask=7 scope=firmware\n",
+		 ret, (unsigned int)phase, (unsigned int)!ret);
+	if (ret) {
+		struct mt6797_hif_ledger ledger;
+
+		/* Last host accounting, not a fresh register acquisition. */
+		mt6797_hif_normal_ledger(mac->hif, &ledger);
+		dev_info(wiphy_dev(hw->wiphy),
+			 "one-shot WLAN fixed RX host ledger: locked=%u phase=%u free=%u limit=%u cpu=%u ffa=%u\n",
+			 ledger.locked, ledger.phase, ledger.tc4_free, ledger.tc4_limit,
+			 ledger.pending_cpu, ledger.pending_ffa);
+	}
+	mutex_unlock(&mac->mutex);
+	return ret;
+}
+#endif
+
 void mt6797_mac_scan_ready(struct ieee80211_hw *hw)
 {
 #if IS_ENABLED(CONFIG_MT6797_PASSIVE_SCAN)
 	struct mt6797_mac *mac = hw->priv;
 
 	mutex_lock(&mac->mutex);
+#ifdef CONFIG_MT6797_CCMP_FIXED_RX_FORMAT
+	if (!mac->rx_format_ready)
+		goto unlock;
+#endif
 	if (mac->configured && !mac->closing && !mac->first_error)
 		mac->scan_ready = true;
+#ifdef CONFIG_MT6797_CCMP_FIXED_RX_FORMAT
+unlock:
+#endif
 	mutex_unlock(&mac->mutex);
 #endif
 }
