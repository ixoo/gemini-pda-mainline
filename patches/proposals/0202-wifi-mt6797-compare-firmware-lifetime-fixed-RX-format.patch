 drivers/net/wireless/mediatek/mt6797/hif.c    |  60 ++++++++++
 drivers/net/wireless/mediatek/mt6797/hif.h    |   9 ++
 .../mediatek/mt6797/join-command-submit.h     |   5 +
 drivers/net/wireless/mediatek/mt6797/mac.c    | 106 ++++++++++++++++++
