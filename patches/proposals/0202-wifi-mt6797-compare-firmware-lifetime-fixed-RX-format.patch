 9 files changed, 237 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 9be3a5c..e430dfa 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -104,6 +104,17 @@ config MT6797_CCMP_STABLE_EPOCH
 	  production are not supported. The read-only ccmp_stable_epoch arm is
 	  mutually exclusive with native_delivery_diag. No IRQ/DMA changes.
 
+config MT6797_CCMP_FIXED_RX_FORMAT
+	bool "MT6797 default-off firmware-lifetime RX format comparison"
+	depends on MT6797_CCMP_MASK_CONTROL && MT6797_HIF_TX_STATUS_PROBE
+	default n
+	help
+	  Configure the observed fixed metadata mask once after initial TC4
+	  reconciliation, before scan-ready. Keep its format for the firmware
+	  instance; station data-window transitions are local, without mask
+	  commands. Preserve all initial-PTK limits and rejection gates. No
+	  firmware queue fence, integrity, key reuse or maintained support claim.
+
 config MT6797_CCMP_MASK_CONTROL
 	bool "MT6797 default-off observed mask-only control comparison"
 	depends on MT6797_CCMP_STABLE_EPOCH
