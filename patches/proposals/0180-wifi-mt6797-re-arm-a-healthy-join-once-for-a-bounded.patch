From 69c664e0601fed34d21945922c82c727f7316db0 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 12 Oct 2026 12:30:00 +0000
Subject: [PATCH 180/180] wifi: mt6797: re-arm a healthy join once for a
 bounded two-lifetime station

After the one healthy join reaches its stage-3 cleanup and mac80211 drives the
station down to NOTEXIST, re-arm the driver to its pre-scan baseline so a
second connect and its scan can run in the same boot. The two facts rendezvous
in either order: sta_state records the NOTEXIST teardown in join_sta_removed
and never poisons merely because the worker's cleanup is still in progress;
the already-serialized join_work performs the one reset after both are seen,
with the queue empty, no page/data debt, no credit pending and no in-flight
frame, through mt6797_join_rearm_ready() in join-rearm.h.

The two-lifetime bound is enforced at the first effectful submission, not at a
third activation: hw_scan counts the lifetime where it admits the scan (before
any scan/peer/channel/key write) and refuses a third scan once two have been
admitted, so no third cycle reaches a peer, channel or key command. A re-arm
is likewise refused once two lifetimes have started. mt6797_mac_join_rearm
resets only the per-lifetime state, re-opens the scan cycle, advances the
channel token and station sequence with a u8 wrap that refuses to re-arm
rather than reuse a value, reinitialises the four completions exactly once
after both teardowns, and leaves first_error/closing untouched; the
device-wide fatal poison path (fail_stop/regulatory on an ambiguous command or
ownership loss) is unchanged and stays permanently non-rearmable. A regulatory
restore is benign once the healthy quiescent terminal is reached (cleanup done:
deauth sent, keys removed, channel returned, no active TX) so the expected idle
restore no longer poisons the next join, while an active lifetime still retires.
Only a healthy terminal re-arms, so a fault re-arms nothing and stops the run.

This is a bounded source-supported prototype, not production reusability. It is
not an authenticated key-completion barrier: the lifetime-2 ACTIVATE response
authenticates activation only, and EVENT_ID_ADD_PKEY_DONE carries no sequence
or generation, so a late lifetime-1 key-done could substitute for a delayed or
lost lifetime-2 one and still total two. Matching counts and station liveness
bound, they do not authenticate; the residual firmware key-event incarnation
contract is unsettled and a passing two-lifetime run does not settle it. No
crypto, replay, operational or sustained-operation claim follows.
---
 .../net/wireless/mediatek/mt6797/join-rearm.h |  48 +++++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 200 +++++++++++++++++-
 2 files changed, 245 insertions(+), 3 deletions(-)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/join-rearm.h

diff --git a/drivers/net/wireless/mediatek/mt6797/join-rearm.h b/drivers/net/wireless/mediatek/mt6797/join-rearm.h
new file mode 100644
index 000000000..4610ef67f
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/join-rearm.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_JOIN_REARM_H
+#define MT6797_JOIN_REARM_H
+
+/* Pure decision for the bounded two-lifetime re-arm (proposal 0180), split out
+ * so its ordering and gate are host-testable without the kernel. The two facts
+ * - the worker's healthy stage-3 cleanup (cleanup_done) and the mac80211
+ * station teardown (sta_removed) - may arrive in either order; re-arm only when
+ * both are seen, the lifetime is quiescent (empty queue implied by cleanup_done,
+ * no debt, no in-flight frame, no credit pending), exactly the two expected key
+ * removals are credited with both key-done windows and no third, and the
+ * two-lifetime cap is not reached. A u8 wire-identity wrap or an exhausted
+ * command sequence refuses re-arm (the caller poisons) rather than reuse a value.
+ * This is not an authenticated key-completion barrier: the counts bound, they do
+ * not authenticate a generationless ADD_PKEY_DONE.
+ */
+enum mt6797_join_rearm_decision {
+	MT6797_JOIN_REARM_NO = 0,
+	MT6797_JOIN_REARM_YES,
+	MT6797_JOIN_REARM_WRAP,
+};
+
+struct mt6797_join_rearm_state {
+	bool cleanup_done, sta_removed, poisoned;
+	bool key_done, key_done_second;
+	bool inflight, credit_pending;
+	unsigned int key_pairwise, key_group;
+	unsigned int page_debt, data_page_debt;
+	unsigned char lifetimes, channel_token, sta_sequence;
+	unsigned int sequence;
+};
+
+static inline enum mt6797_join_rearm_decision
+mt6797_join_rearm_ready(const struct mt6797_join_rearm_state *s)
+{
+	if (!s->cleanup_done || !s->sta_removed || s->poisoned)
+		return MT6797_JOIN_REARM_NO;
+	if (s->lifetimes >= 2 ||
+	    s->key_pairwise != 2 || s->key_group != 2 ||
+	    !s->key_done || !s->key_done_second ||
+	    s->inflight || s->page_debt || s->data_page_debt || s->credit_pending)
+		return MT6797_JOIN_REARM_NO;
+	if (s->channel_token == 255 || s->sta_sequence == 255 || s->sequence > 248)
+		return MT6797_JOIN_REARM_WRAP;
+	return MT6797_JOIN_REARM_YES;
+}
+
+#endif /* MT6797_JOIN_REARM_H */
