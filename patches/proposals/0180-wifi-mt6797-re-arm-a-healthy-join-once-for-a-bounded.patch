+#include "join-rearm.h"
 #include "action-frame.h"
 #include "join-tx.h"
 #include "join-commands.h"
@@ -88,6 +89,15 @@ struct mt6797_mac {
 	unsigned int join_queue_bytes, join_seen, join_tx_allowed, join_rx_allowed;
 	unsigned int join_page_debt, join_polls, join_packets;
 	bool join_running, join_open, join_retired;
+	/* Reusable bounded two-lifetime milestone (proposal 0180): the mac80211
+	 * station teardown (sta_state -> NOTEXIST) and the worker's healthy
+	 * stage-3 cleanup rendezvous in either order; the already-serialized
+	 * join_work does the one reset after both. At most two lifetimes are
