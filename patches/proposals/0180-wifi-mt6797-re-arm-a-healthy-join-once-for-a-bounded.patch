@@ -270,6 +280,13 @@ static bool mt6797_mac_join_regulatory_stop(struct mt6797_mac *mac,
 
 	if (!mac->join_scan_ready && !mac->join_peer_used)
 		return false;
+	/* 0180: a healthy quiescent terminal (stage-3 cleanup done: deauth sent,
+	 * keys removed, channel returned, no active TX) makes the expected idle
+	 * regulatory restore benign; do not poison it, so a subsequent fresh
+	 * scan/beacon re-admits normally. An active lifetime still retires.
+	 */
+	if (mac->join_cleanup_done)
+		return false;
 	if (mac->join_running && !mac->join_retired) {
 		mt6797_mac_join_fail_stop(mac, -ECANCELED, 9, discard, internal);
 		return true;
@@ -717,6 +734,139 @@ static bool mt6797_mac_join_frame(struct mt6797_mac *mac, struct sk_buff *skb)
 	return true;
 }
 
+/* Re-arm the driver to its pre-scan baseline for a second lifetime, called
+ * only from the serialized join_work after BOTH the healthy stage-3 cleanup
+ * and the mac80211 station teardown (NOTEXIST) have been observed, with the
+ * queue empty, no debt, no in-flight frame and the lifetime not poisoned.
+ * first_error/closing are left untouched (they must be clear to reach here).
+ * Wire identities advance and a u8 wrap refuses the re-arm rather than reuse
+ * a value; key/absence events do not gain identities. Returns -EOWNERDEAD to
+ * ask the caller to poison on wrap, 0 on a completed re-arm.
+ */
+static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+
+	/* The caller (join_work) re-arms only on MT6797_JOIN_REARM_YES from
+	 * mt6797_join_rearm_ready(), which has already proved the rendezvous,
+	 * the quiescent gate and that the wire identities do not wrap.
+	 */
+	mac->join_channel_token++;
+	mac->join_sta_sequence++;
+	/* Scan cycle re-opened; the radio (scan_ready), vif, configured and
+	 * started state and the monotonic mac->sequence are left as they are.
+	 */
+	mac->scan_used = false;
+	mac->scan_active = false;
+	mac->bss_active = false;
+	mac->scan_count = 0;
+	mac->scan_channels = 0;
+	mac->scan_polls = 0;
+	mac->scan_packets = 0;
+	mac->scan_beacon = false;
+	mac->scan_credit = false;
+	mac->scan_frame_seen = false;
+	mac->scan_started_ns = 0;
+	mac->join_scan_ready = false;
+	mac->join_peer_used = false;
+	mac->join_peer_ready = false;
+	mac->join_auth_received = false;
+	mac->join_auth_ok = false;
+	mac->join_authenticated = false;
+	mac->join_assoc_received = false;
+	mac->join_assoc_status = 0;
+	mac->join_aid = 0;
+	mac->join_bss_valid = false;
+	mac->join_channel_valid = false;
+	mac->join_bss_configured = false;
+	mac->join_short_preamble = false;
+	mac->join_channel_pending = false;
+	mac->join_channel_granted = false;
+	mac->join_channel_released = false;
+	mac->join_sta_pending = false;
+	mac->join_sta_active = false;
+	mac->join_peer_refusal_logged = false;
+	mac->join_channel_refusal_logged = false;
+	mac->join_data_phase = false;
+	mac->join_data_ended = false;
+	mac->join_cleanup_requested = false;
+	mac->join_cleanup_done = false;
+	mac->join_deauth_done = false;
+	mac->join_cleanup_stage = 0;
+	mac->join_rsn = false;
+	mac->join_key_pairwise = 0;
+	mac->join_key_group = 0;
+	mac->join_key_pairwise_submitted = false;
+	mac->join_key_group_submitted = false;
+	mac->join_key_done = false;
+	mac->join_key_done_second = false;
+	mac->join_group_key_id = 0;
+	mac->join_eapol_seen = 0;
+	mac->join_eapol_tx = 0;
+	mac->join_group_discarded = 0;
+	mac->join_action_discarded = 0;
+	mac->join_group_action_discarded = 0;
+	mac->join_keyed_beacons = 0;
+	mac->join_beacons_delivered = 0;
+	mac->join_cleanup_group_discarded = 0;
+	mac->join_data_llc_discarded = 0;
+	mac->join_absence_events = 0;
+	mac->join_data_rx_unicast = 0;
+	mac->join_data_rx_group = 0;
+	mac->join_data_rx_dropped = 0;
+	mac->join_data_rx_outside = 0;
+	mac->join_data_g1_uni_present = 0;
+	mac->join_data_g1_uni_absent = 0;
+	mac->join_data_g1_grp_present = 0;
+	mac->join_data_g1_grp_absent = 0;
+	mac->join_data_uni_masks = 0;
+	mac->join_data_grp_masks = 0;
+	mac->join_data_credits = 0;
+	mac->join_data_credit_records = 0;
+	mac->join_data_page_debt = 0;
+	mac->join_data_tx_queued = 0;
+	mac->join_data_tx_done = 0;
+	mac->join_data_tx_failed = 0;
+	mac->join_data_tx_failures_in_row = 0;
+	mac->join_inflight_data = false;
+	mac->join_last_acked = false;
+	mac->join_credit_pending = false;
+	mac->join_channel_pending = false;
+	mac->join_sta_pending = false;
+	mac->join_page_debt = 0;
+	mac->join_polls = 0;
+	mac->join_packets = 0;
+	mac->join_seen = 0;
+	mac->join_tx_allowed = 0;
+	mac->join_rx_allowed = 0;
+	mac->join_deadline = 0;
+	mac->join_frame_deadline = 0;
+	mac->join_grant_deadline = 0;
+	mac->join_credit_deadline = 0;
+	mac->join_data_deadline = 0;
+	mac->join_data_started = 0;
+	mac->join_hold_until = 0;
+	mac->join_pid = 0;
+	mac->join_submitted = 0;
+	mac->join_sta_removed = false;
+	mac->join_rearm_pending = false;
+	/* join_next_pid stays monotonic: lifetime 2 uses fresh TX pids, never reused. */
+	reinit_completion(&mac->join_channel_done);
+	reinit_completion(&mac->join_sta_done);
+	reinit_completion(&mac->join_credit_done);
+	reinit_completion(&mac->join_frame_done);
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	mac->join_running = false;
+	mac->join_open = false;
+	mac->join_queue_bytes = 0;
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mac->join_retired = false;
+	dev_info(wiphy_dev(mac->hw->wiphy),
+		 "one-shot WLAN join rearm: lifetime=%u token=%u sta_seq=%u sequence=%u\n",
+		 mac->join_lifetimes, mac->join_channel_token, mac->join_sta_sequence,
+		 mac->sequence);
+}
+
 static void mt6797_mac_join_close(struct mt6797_mac *mac)
 {
 	unsigned long flags;
@@ -724,9 +874,16 @@ static void mt6797_mac_join_close(struct mt6797_mac *mac)
 	struct sk_buff *skb, *internal = NULL;
 
 	skb_queue_head_init(&discard);
-	/* Fence every producer before cancellation, preserving idle eligibility. */
+	/* Fence every producer before cancellation, preserving idle eligibility.
+	 * 0180: an explicit close (stop/remove/poison) permanently invalidates
+	 * re-arm and clears any queued re-arm under the mutex BEFORE the
+	 * unlock/cancel gap, so a re-arm pass cannot reopen the fence; the healthy
+	 * rendezvous is the only admitted reset route and never reaches here.
+	 */
 	mutex_lock(&mac->mutex);
 	mac->join_retired = true;
+	mac->join_closed = true;
+	mac->join_rearm_pending = false;
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	mac->join_running = false;
 	mac->join_open = false;
@@ -920,8 +1077,8 @@ static int mt6797_mac_join_control_event(struct mt6797_mac *mac, size_t bytes)
 		}
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
 		dev_info(wiphy_dev(mac->hw->wiphy),
-			 "one-shot WLAN join activation: sequence=%u state=3\n",
-			 mac->join_sta_sequence);
+			 "one-shot WLAN join activation: sequence=%u state=3 lifetime=%u\n",
+			 mac->join_sta_sequence, mac->join_lifetimes);
 #endif
 		return 0;
 	}
@@ -1379,6 +1536,66 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	skb_queue_head_init(&received);
 	skb_queue_head_init(&discard);
 	mutex_lock(&mac->mutex);
+#if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+	/* Dedicated re-arm pass (proposal 0180), checked before the running/retired
+	 * bail because a healthy stage-3 terminal has set join_retired and cleared
+	 * join_running. Poison here is first_error||closing only, never the healthy
+	 * retirement. received/discard are freshly empty, so no local SKB is at risk.
+	 */
+	if (mac->join_rearm_pending) {
+		bool queue_empty;
+
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		queue_empty = skb_queue_empty(&mac->join_queue);
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		{
+		const struct mt6797_join_rearm_state rs = {
+			.cleanup_done = mac->join_cleanup_done,
+			.sta_removed = mac->join_sta_removed,
+			.poisoned = mac->first_error || mac->closing,
+			.key_done = mac->join_key_done,
+			.key_done_second = mac->join_key_done_second,
+			.inflight = !!mac->join_inflight,
+			.credit_pending = mac->join_credit_pending,
+			.queue_empty = queue_empty,
+			.key_pairwise = mac->join_key_pairwise,
+			.key_group = mac->join_key_group,
+			.page_debt = mac->join_page_debt,
+			.data_page_debt = mac->join_data_page_debt,
+			.lifetimes = mac->join_lifetimes,
+			.channel_token = mac->join_channel_token,
+			.sta_sequence = mac->join_sta_sequence,
+			.sequence = mac->sequence,
+			.next_pid = mac->join_next_pid,
+		};
+
+		mac->join_rearm_pending = false;
+		switch (mac->join_closed ? MT6797_JOIN_REARM_NO :
+			mt6797_join_rearm_ready(&rs)) {
+		case MT6797_JOIN_REARM_YES:
+			mt6797_mac_join_rearm(mac);
+			break;
+		case MT6797_JOIN_REARM_WRAP:
+			if (!mac->first_error)
+				mac->first_error = -EOWNERDEAD;
+			mac->closing = true;
+			dev_err(wiphy_dev(mac->hw->wiphy),
+				"one-shot WLAN join rearm wrap: token=%u sta_seq=%u sequence=%u next_pid=%u\n",
+				mac->join_channel_token, mac->join_sta_sequence,
+				mac->sequence, mac->join_next_pid);
+			break;
+		case MT6797_JOIN_REARM_NO:
+			dev_info(wiphy_dev(mac->hw->wiphy),
+				 "one-shot WLAN join rearm refused: lifetimes=%u closed=%u cleanup=%u sta_removed=%u keys=%u%u done=%u%u queue_empty=%u\n",
+				 mac->join_lifetimes, mac->join_closed, mac->join_cleanup_done,
+				 mac->join_sta_removed, mac->join_key_pairwise, mac->join_key_group,
+				 mac->join_key_done, mac->join_key_done_second, queue_empty);
+			break;
+		}
+		}
+		goto unlock;
+	}
+#endif
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	running = mac->join_running;
 	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
@@ -2071,6 +2288,21 @@ static void mt6797_mac_join_work(struct work_struct *work)
 	ret = mt6797_mac_join_cleanup_step(mac);
 	if (ret)
 		goto failed;
+	/* Rendezvous (proposal 0180): both the worker's healthy stage-3 cleanup
+	 * and the mac80211 station teardown (NOTEXIST) observed, the lifetime
+	 * quiescent and not poisoned, under the two-lifetime cap -> re-arm once
+	 * here in the serialized worker. A wire-identity wrap poisons instead.
+	 */
+	/* Rendezvous (0180): once the healthy stage-3 cleanup and the mac80211
+	 * NOTEXIST teardown are both seen and the lifetime is not poisoned, queue
+	 * the dedicated re-arm pass (handled at the worker top). Scheduling, not an
+	 * inline reset, so the re-arm never runs while this pass holds local SKBs.
+	 */
+	if (mac->join_cleanup_done && mac->join_sta_removed && !mac->join_closed &&
+	    !mac->first_error && !mac->closing && !mac->join_rearm_pending) {
+		mac->join_rearm_pending = true;
+		schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
+	}
 #endif
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	if (mac->join_running)
@@ -2241,7 +2473,8 @@ static int mt6797_mac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif
 
 	mutex_lock(&mac->mutex);
 	if (!mac->scan_ready || !mac->started || mac->vif != vif ||
-	    mac->closing || mac->first_error || mac->scan_used)
+	    mac->closing || mac->first_error || mac->scan_used ||
+	    mac->join_lifetimes >= 2)
 		goto out;
 	/* mac80211 may append supported-rate IEs internally. There are no
 	 * probe requests in this passive form, so no IEs are transmitted.
@@ -2278,6 +2511,12 @@ static int mt6797_mac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif
 	 * cannot be retried or treated as an effect-free rejection.
 	 */
 	mac->scan_used = true;
+	/* 0180: count the lifetime at its first effectful submission (this scan),
+	 * so a third cycle is refused here before any scan/peer/channel/key write,
+	 * not only at a third activation.
+	 */
+	if (mac->join_lifetimes < U8_MAX)
+		mac->join_lifetimes++;
 	ret = mt6797_mac_scan_guard(mac, ktime_get_ns() + NSEC_PER_SEC);
 	if (ret) {
 		mac->first_error = ret;
@@ -3092,17 +3331,33 @@ static int mt6797_mac_sta_state(struct ieee80211_hw *hw,
 			bool close = true;
 
 			mutex_lock(&mac->mutex);
+			/* 0180: record the mac80211 station teardown barrier; the
+			 * worker re-arms once the healthy cleanup also completes. This
+			 * never poisons merely because cleanup is still in progress.
+			 */
+			if (vif == mac->vif && new == IEEE80211_STA_NOTEXIST)
+				mac->join_sta_removed = true;
 			if (vif == mac->vif && mac->join_data_phase && !mac->join_data_ended)
 				mt6797_mac_join_end_data(mac, "disconnect");
-			if (vif == mac->vif && mac->join_peer_used &&
-			    !mac->join_retired && !mac->first_error && !mac->closing) {
-				int ret = mt6797_mac_join_request_cleanup(mac);
-
-				if (!ret) {
+			if (vif == mac->vif && !mac->first_error && !mac->closing) {
+				if (mac->join_cleanup_done && !mac->join_closed) {
+					/* 0180: healthy terminal already reached; queue the
+					 * serialized re-arm and never join_close (no poison).
+					 */
 					close = false;
-				} else {
-					mac->first_error = ret;
-					mac->closing = true;
+					if (!mac->join_rearm_pending) {
+						mac->join_rearm_pending = true;
+						schedule_delayed_work(&mac->join_work, 0);
+					}
+				} else if (mac->join_peer_used && !mac->join_retired) {
+					int ret = mt6797_mac_join_request_cleanup(mac);
+
+					if (!ret)
+						close = false;
+					else {
+						mac->first_error = ret;
+						mac->closing = true;
+					}
 				}
 			}
 			mutex_unlock(&mac->mutex);
