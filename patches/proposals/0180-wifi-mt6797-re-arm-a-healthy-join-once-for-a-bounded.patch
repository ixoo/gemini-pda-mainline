From bb0b6a7078899f2ead1334b35cbc4ccbf54f189f Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 12 Oct 2026 12:30:00 +0000
Subject: [PATCH 180/180] wifi: mt6797: re-arm a healthy join once for a
 bounded two-lifetime station

After one healthy join reaches its stage-3 cleanup and mac80211 drives the
station to NOTEXIST, re-arm the driver to its pre-scan baseline so a second
connect and scan run in the same boot. The healthy stage-3 terminal already
stops the worker (it sets join_retired and clears join_running), so the re-arm
cannot run on the normal worker path: both the cleanup and the NOTEXIST
teardown route through a dedicated serialized re-arm pass checked at the top of
join_work before the running/retired bail. Whichever of the two completes
second queues that pass (the worker when stage 3 sees join_sta_removed; the
sta_state NOTEXIST callback when the healthy terminal is already done, without
join_close). join_sta_removed records the teardown and the healthy sta_state
path never poisons; only first_error/closing (an ambiguous command or ownership
loss) poisons, and that path still join_closes permanently.

The re-arm decision is the pure mt6797_join_rearm_ready() (join-rearm.h):
poison is first_error||closing, never the healthy join_retired stop; it also
requires the queue empty, no debt, no credit pending, no in-flight frame,
exactly the two credited key removals with both key-done and no third, the
two-lifetime cap unreached, and enough fresh wire-identity capacity (channel
token, station sequence, command sequence and the monotonic TX pid space, none
of which is reused) or it refuses as a wrap that poisons. The two-lifetime
bound is enforced at the first effectful submission: hw_scan counts the
lifetime where it admits the scan and refuses a third scan before any
peer/channel/key write. mt6797_mac_join_rearm resets only per-lifetime state
(including join_pid and the join_submitted mask, keeping join_next_pid
monotonic), reinitialises the four completions once, and leaves
first_error/closing untouched. A regulatory restore is benign only at the
healthy quiescent terminal; an active lifetime still retires. Only a healthy
terminal re-arms, so a fault re-arms nothing and stops the run.

Bounded source-supported prototype, not production reuse and not an
authenticated key-completion barrier: the lifetime-2 ACTIVATE authenticates
activation only, and the generationless ADD_PKEY_DONE means a late lifetime-1
key-done could substitute for a delayed or lost lifetime-2 one and still total
two; matching counts bound, they do not authenticate, and a passing two-lifetime
run does not settle that residual firmware contract. No crypto, replay,
operational or sustained-operation claim follows.
---
 .../net/wireless/mediatek/mt6797/join-rearm.h |  53 ++++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 279 +++++++++++++++++-
 2 files changed, 320 insertions(+), 12 deletions(-)
 create mode 100644 drivers/net/wireless/mediatek/mt6797/join-rearm.h

diff --git a/drivers/net/wireless/mediatek/mt6797/join-rearm.h b/drivers/net/wireless/mediatek/mt6797/join-rearm.h
new file mode 100644
index 000000000..75f5e07cb
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/join-rearm.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_JOIN_REARM_H
+#define MT6797_JOIN_REARM_H
+
+/* Pure decision for the bounded two-lifetime re-arm (proposal 0180), split out
+ * so its ordering and gate are host-testable without the kernel. The two facts
+ * - the worker's healthy stage-3 cleanup (cleanup_done) and the mac80211
+ * station teardown (sta_removed) - may arrive in either order; re-arm only when
+ * both are seen, the lifetime is quiescent (empty queue implied by cleanup_done,
+ * no debt, no in-flight frame, no credit pending), exactly the two expected key
+ * removals are credited with both key-done windows and no third, and the
+ * two-lifetime cap is not reached. A u8 wire-identity wrap or an exhausted
+ * command sequence refuses re-arm (the caller poisons) rather than reuse a value.
+ * `poisoned` is the device-wide fatal state (first_error or closing or an ambiguous
+ * ownership loss), NOT the healthy stage-3 stop (which also sets join_retired); the
+ * caller must pass first_error||closing so a healthy retirement can still re-arm.
+ * This is not an authenticated key-completion barrier: the counts bound, they do
+ * not authenticate a generationless ADD_PKEY_DONE.
+ */
+enum mt6797_join_rearm_decision {
+	MT6797_JOIN_REARM_NO = 0,
+	MT6797_JOIN_REARM_YES,
+	MT6797_JOIN_REARM_WRAP,
+};
+
+struct mt6797_join_rearm_state {
+	bool cleanup_done, sta_removed, poisoned;
+	bool key_done, key_done_second;
+	bool inflight, credit_pending, queue_empty;
+	unsigned int key_pairwise, key_group;
+	unsigned int page_debt, data_page_debt;
+	unsigned char lifetimes, channel_token, sta_sequence;
+	unsigned int sequence, next_pid;
+};
+
+static inline enum mt6797_join_rearm_decision
+mt6797_join_rearm_ready(const struct mt6797_join_rearm_state *s)
+{
+	if (!s->cleanup_done || !s->sta_removed || s->poisoned)
+		return MT6797_JOIN_REARM_NO;
+	if (s->lifetimes >= 2 ||
+	    s->key_pairwise != 2 || s->key_group != 2 ||
+	    !s->key_done || !s->key_done_second ||
+	    s->inflight || s->page_debt || s->data_page_debt || s->credit_pending ||
+	    !s->queue_empty)
+		return MT6797_JOIN_REARM_NO;
+	if (s->channel_token == 255 || s->sta_sequence == 255 || s->sequence > 248 ||
+	    s->next_pid > 63)
+		return MT6797_JOIN_REARM_WRAP;
+	return MT6797_JOIN_REARM_YES;
+}
+
+#endif /* MT6797_JOIN_REARM_H */
