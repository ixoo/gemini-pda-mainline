From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 16:54:08 -0500
Subject: [PATCH 556/556] media: mediatek: mt6797-seninf: DIAGNOSTIC, debugfs
 to start and watch a stream

Bring-up only, to be dropped when a capture node exists. Start a stream, pick
a test pattern, and read the receiver and mux status without a capture path.
---
 .../platform/mediatek/seninf/mt6797-seninf.c  | 90 ++++++++++++++++++-
 1 file changed, 88 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
index 383c9e0a7..424082bec 100644
--- a/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
+++ b/drivers/media/platform/mediatek/seninf/mt6797-seninf.c
@@ -17,6 +17,7 @@
 #include <linux/bits.h>
 #include <linux/clk.h>
 #include <linux/clk-provider.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/mod_devicetable.h>
@@ -28,6 +29,7 @@
 #include <linux/spinlock.h>
 
 #include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-fwnode.h>
 #include <media/v4l2-subdev.h>
@@ -154,6 +156,7 @@ struct mt6797_seninf {
 	unsigned int settle;
 	bool hsrx_delay;
 	bool streaming;
+	struct dentry *debugfs;
 };
 
 static void seninf_update(struct mt6797_seninf *seninf, u32 reg, u32 mask, u32 val)
@@ -503,6 +506,80 @@ static void seninf_rx_exit(struct mt6797_seninf *seninf)
 	v4l2_device_unregister(&seninf->v4l2_dev);
 }
 
+/* Bring-up only: there is no capture node yet to start a stream from. */
+static int seninf_dbg_stream_set(void *data, u64 val)
+{
+	struct mt6797_seninf *seninf = data;
+
+	return seninf_s_stream(&seninf->sd, !!val);
+}
+DEFINE_DEBUGFS_ATTRIBUTE(seninf_dbg_stream, NULL, seninf_dbg_stream_set, "%llu\n");
+
+static int seninf_dbg_pattern_set(void *data, u64 val)
+{
+	struct mt6797_seninf *seninf = data;
+	struct v4l2_ctrl *ctrl;
+
+	if (!seninf->sensor)
+		return -ENODEV;
+	ctrl = v4l2_ctrl_find(seninf->sensor->ctrl_handler, V4L2_CID_TEST_PATTERN);
+	if (!ctrl)
+		return -ENOTTY;
+	return v4l2_ctrl_s_ctrl(ctrl, val);
+}
+DEFINE_DEBUGFS_ATTRIBUTE(seninf_dbg_pattern, NULL, seninf_dbg_pattern_set, "%llu\n");
+
+static int seninf_dbg_status_show(struct seq_file *s, void *unused)
+{
+	struct mt6797_seninf *seninf = s->private;
+	void __iomem *ncsi2 = seninf->base + SENINF_NCSI2(SENINF_RX_IF);
+	void __iomem *mux = seninf->base + SENINF_MUX(SENINF_RX_IF);
+	void __iomem *rx = seninf->mipi_rx + MIPI_RX_CSI1A;
+	unsigned int i;
+	u32 val;
+
+	if (pm_runtime_get_if_active(seninf->dev) <= 0) {
+		seq_puts(s, "off\n");
+		return 0;
+	}
+
+	seq_printf(s, "ctrl %08x ctrl2 %08x top_mux %08x\n",
+		   readl(seninf->base + SENINF_CTRL(SENINF_RX_IF)),
+		   readl(seninf->base + SENINF_CTRL2(SENINF_RX_IF)),
+		   readl(seninf->base + SENINF_TOP_MUX));
+	seq_printf(s, "ncsi2 ctl %08x settle %08x\n",
+		   readl(ncsi2 + NCSI2_CTL), readl(ncsi2 + NCSI2_LNRD_TIMING));
+	val = readl(ncsi2 + NCSI2_INT_STATUS);
+	seq_printf(s, "ncsi2 int %08x clk_fsm %08x data_fsm %08x frame_line %08x\n",
+		   val, readl(ncsi2 + NCSI2_CLK_FSM), readl(ncsi2 + NCSI2_DATA_FSM),
+		   readl(ncsi2 + NCSI2_FRAME_LINE));
+	writel(val, ncsi2 + NCSI2_INT_STATUS);
+	val = readl(mux + MUX_INT_STATUS);
+	seq_printf(s, "mux ctrl %08x int %08x size %08x\n",
+		   readl(mux + MUX_CTRL), val, readl(mux + MUX_SIZE));
+	writel(val, mux + MUX_INT_STATUS);
+	for (i = 0; i < 6; i++)
+		seq_printf(s, "mux debug%u %08x\n", i + 1, readl(mux + MUX_DEBUG(i)));
+	seq_printf(s, "rx con00 %08x %08x\n", readl(rx + MIPI_RX_CON00),
+		   readl(seninf->mipi_rx + MIPI_RX_CSI1B + MIPI_RX_CON00));
+
+	pm_runtime_put(seninf->dev);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(seninf_dbg_status);
+
+static void seninf_debugfs_init(struct mt6797_seninf *seninf)
+{
+	struct dentry *dir = debugfs_create_dir("mt6797-seninf", NULL);
+
+	seninf->debugfs = dir;
+	debugfs_create_file_unsafe("stream", 0200, dir, seninf, &seninf_dbg_stream);
+	debugfs_create_file_unsafe("pattern", 0200, dir, seninf, &seninf_dbg_pattern);
+	debugfs_create_file("status", 0400, dir, seninf, &seninf_dbg_status_fops);
+	debugfs_create_u32("settle", 0600, dir, &seninf->settle);
+	debugfs_create_bool("hsrx_delay", 0600, dir, &seninf->hsrx_delay);
+}
+
 static int seninf_runtime_suspend(struct device *dev)
 {
 	struct mt6797_seninf *seninf = dev_get_drvdata(dev);
@@ -598,12 +675,21 @@ static int seninf_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	return seninf_rx_init(seninf);
+	ret = seninf_rx_init(seninf);
+	if (ret)
+		return ret;
+
+	if (seninf->mipi_rx)
+		seninf_debugfs_init(seninf);
+	return 0;
 }
 
 static void seninf_remove(struct platform_device *pdev)
 {
-	seninf_rx_exit(platform_get_drvdata(pdev));
+	struct mt6797_seninf *seninf = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(seninf->debugfs);
+	seninf_rx_exit(seninf);
 }
 
 static const struct of_device_id seninf_of_match[] = {
-- 
