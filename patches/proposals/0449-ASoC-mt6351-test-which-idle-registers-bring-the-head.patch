From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Sun, 1 Nov 2026 17:46:54 -0500
Subject: [PATCH] ASoC: mt6351: test which idle registers bring the headphone
 noise

Test only, not for upstream. On the Gemini PDA the idle headphone output
picks up a burst every 30 s, starting from the first stream. Eight
registers differ after that stream, so finding the one by rebuilding
would take a build and a boot for each.

Add a parameter that puts groups of them back to the values read before
the first stream, once the output is off. The default, 0, changes nothing,
and each group is rewritten by the next power-up.
---
 sound/soc/codecs/mt6351.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/sound/soc/codecs/mt6351.c b/sound/soc/codecs/mt6351.c
index 976770c..514a250 100644
--- a/sound/soc/codecs/mt6351.c
+++ b/sound/soc/codecs/mt6351.c
@@ -712,6 +712,31 @@ static int mt_aif_in_event(struct snd_soc_dapm_widget *w,
 	return 0;
 }
 
+/* Test only: which values from before the first stream to put back after one. */
+static unsigned int idle_restore;
+module_param(idle_restore, uint, 0644);
+MODULE_PARM_DESC(idle_restore,
+		 "bit 0 ANA_CON1, 1 AFUNC, 2 ZCD_CON3, 3 DL configuration");
+
+static void mt_hp_idle_restore(struct snd_soc_component *cmpnt)
+{
+	struct regmap *map = cmpnt->regmap;
+
+	if (idle_restore & BIT(0))
+		regmap_update_bits(map, MT6351_AUDDEC_ANA_CON1, 0x2000, 0x0);
+	if (idle_restore & BIT(1)) {
+		regmap_write(map, MT6351_AFUNC_AUD_CON2, 0x0000);
+		regmap_write(map, MT6351_AFUNC_AUD_CON0, 0xd021);
+	}
+	if (idle_restore & BIT(2))
+		regmap_write(map, MT6351_ZCD_CON3, 0x0012);
+	if (idle_restore & BIT(3)) {
+		regmap_write(map, MT6351_AFE_DL_SRC2_CON0_H, 0x0300);
+		regmap_write(map, MT6351_AFE_DL_SDM_CON1, 0x003a);
+		regmap_write(map, MT6351_AFE_PMIC_NEWIF_CFG0, 0x9330);
+	}
+}
+
 static int mt_hp_event(struct snd_soc_dapm_widget *w,
 		       struct snd_kcontrol *kcontrol,
 		       int event)
@@ -832,6 +857,7 @@ static int mt_hp_event(struct snd_soc_dapm_widget *w,
 
 		/* apply volume setting */
 		hp_gain_ramp_set(cmpnt, HP_GAIN_RESTORE);
+		mt_hp_idle_restore(cmpnt);
 		break;
 	default:
 		break;
