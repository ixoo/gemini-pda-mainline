From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 4 Nov 2026 14:30:00 -0500
Subject: [PATCH 545/550] dt-bindings: media: i2c: add Hynix Hi-556

The sensor has a driver but no binding yet.
---
 .../bindings/media/i2c/hynix,hi556.yaml       | 98 +++++++++++++++++++
 1 file changed, 98 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/hynix,hi556.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/hynix,hi556.yaml b/Documentation/devicetree/bindings/media/i2c/hynix,hi556.yaml
new file mode 100644
index 000000000..93f8cbabd
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/hynix,hi556.yaml
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/hynix,hi556.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Hynix Hi-556 5 Mpixel raw image sensor
+
+maintainers:
+  - Gemini PDA Mainline Project
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: hynix,hi556
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: The sensor's input clock, 19.2 or 24 MHz.
+
+  clock-names:
+    const: clk
+
+  dovdd-supply: true
+  avdd-supply: true
+  dvdd-supply: true
+
+  reset-gpios:
+    maxItems: 1
+
+  powerdown-gpios:
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@20 {
+            compatible = "hynix,hi556";
+            reg = <0x20>;
+            clocks = <&seninf 1>;
+            clock-names = "clk";
+            dovdd-supply = <&vcamio>;
+            avdd-supply = <&vcama>;
+            dvdd-supply = <&vcamd>;
+            reset-gpios = <&pio 33 GPIO_ACTIVE_LOW>;
+            powerdown-gpios = <&pio 29 GPIO_ACTIVE_LOW>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2>;
+                    link-frequencies = /bits/ 64 <437000000>;
+                };
+            };
+        };
+    };
-- 
