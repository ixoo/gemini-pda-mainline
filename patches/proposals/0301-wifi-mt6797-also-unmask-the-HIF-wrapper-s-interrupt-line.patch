From e628a846a260e0083e954ebb8da9708ae4375005 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 25 Oct 2026 20:31:59 -0400
Subject: [PATCH] wifi: mt6797: also unmask the HIF wrapper's interrupt line

Boot AA armed WHIER (0x0 to 0x7) and WHLPCR INT_EN (0x100 to 0x101)
with status 0 and took no interrupt in a clean data phase. The vendor
pairs WHLPCR INT_EN with a raw write to the wrapper's line mask in the
direct window: sdio.h defines __enable_irq() as writel(0, base + 0x200)
and __disable_irq() as writel(0x01, base + 0x200), and
nicEnableInterrupt() calls __enable_irq() after INT_EN_SET. Neither
earlier change writes it, so the line was most likely still masked at
the wrapper.

Arm now unmasks the line (0x200 = 0) after INT_EN_SET, and disarm masks
it (0x200 = 0x01) before INT_EN_CLR, each read back and recorded
(mask=before>after on the armed and disarmed lines). Nothing else
changes.
---
 drivers/net/wireless/mediatek/mt6797/hif.c | 27 ++++++++++++++++++++++
 drivers/net/wireless/mediatek/mt6797/hif.h |  1 +
 drivers/net/wireless/mediatek/mt6797/mac.c | 10 ++++----
 3 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 9bf85cec2..62e35a934 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -480,6 +480,24 @@ static int mt6797_hif_read32_locked(struct mt6797_hif *hif, unsigned int reg,
 #define MT6797_HIF_WHIER_ARMED 0x00000007U
 #define MT6797_HIF_WHLPCR_INT_EN_SET BIT(0)
 #define MT6797_HIF_WHLPCR_INT_EN_CLR BIT(1)
+/* The wrapper's line mask in the direct window (sdio.h: __enable_irq()
+ * writes 0 to base + 0x200, __disable_irq() writes 0x01), the one raw
+ * write the vendor pairs with WHLPCR INT_EN in nicEnableInterrupt (0301).
+ */
+#define MT6797_HIF_LINE_MASK 0x200U
+
+static int mt6797_hif_line_mask_locked(struct mt6797_hif *hif, u32 value,
+				       u32 *before, u32 *after)
+{
+	int error = mt6797_hif_guard(hif);
+
+	if (error)
+		return error;
+	*before = readl((u8 __iomem *)hif->base + MT6797_HIF_LINE_MASK);
+	writel(value, (u8 __iomem *)hif->base + MT6797_HIF_LINE_MASK);
+	*after = readl((u8 __iomem *)hif->base + MT6797_HIF_LINE_MASK);
+	return mt6797_hif_guard(hif);
+}
 
 static int mt6797_hif_write32_locked(struct mt6797_hif *hif, unsigned int reg,
 				     u32 value)
@@ -513,10 +531,19 @@ int mt6797_hif_set_interrupt(struct mt6797_hif *hif, bool enable,
 	if (!error && enable)
 		error = mt6797_hif_write32_locked(hif, MT6797_HIF_WHIER_REG,
 						  MT6797_HIF_WHIER_ARMED);
+	/* Disarm masks the wrapper line before clearing INT_EN; arm unmasks
+	 * it after setting INT_EN, as nicEnableInterrupt does (0301).
+	 */
+	if (!error && !enable)
+		error = mt6797_hif_line_mask_locked(hif, 0x01, &record->mask_before,
+						    &record->mask_after);
 	if (!error)
 		error = mt6797_hif_write32_locked(hif, MT6797_HIF_WHLPCR_REG,
 						  enable ? MT6797_HIF_WHLPCR_INT_EN_SET :
 						  MT6797_HIF_WHLPCR_INT_EN_CLR);
+	if (!error && enable)
+		error = mt6797_hif_line_mask_locked(hif, 0, &record->mask_before,
+						    &record->mask_after);
 	if (!error)
 		error = mt6797_hif_read32_locked(hif, MT6797_HIF_WHIER_REG,
 						 &record->whier_after);
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index 3ada984e3..c5c85d80d 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -152,6 +152,7 @@ void mt6797_hif_rx_batch_stats(const struct mt6797_hif *hif,
 /* WHIER and WHLPCR read before and after one arm or disarm. */
 struct mt6797_hif_irq_record {
 	u32 whier_before, whier_after, whlpcr_before, whlpcr_after;
+	u32 mask_before, mask_after;	/* the wrapper line mask at 0x200 (0301) */
 };
 
 /* Arm (WHIER TX, RX0 and RX1 done, then WHLPCR INT_EN_SET) or disarm (WHLPCR
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 11b8f4a1d..02c0c71f5 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -3440,10 +3440,11 @@ static void mt6797_mac_hif_irq_pass(struct mt6797_mac *mac)
 			enable_irq(mac->hif_irq);
 		}
 		dev_info(wiphy_dev(mac->hw->wiphy),
-			 "one-shot WLAN HIF interrupt armed: irq=%d status=%d whier=0x%08x>0x%08x whlpcr=0x%08x>0x%08x\n",
+			 "one-shot WLAN HIF interrupt armed: irq=%d status=%d whier=0x%08x>0x%08x whlpcr=0x%08x>0x%08x mask=0x%08x>0x%08x\n",
 			 mac->hif_irq, mac->hif_irq_arm_status, mac->hif_irq_on.whier_before,
 			 mac->hif_irq_on.whier_after, mac->hif_irq_on.whlpcr_before,
-			 mac->hif_irq_on.whlpcr_after);
+			 mac->hif_irq_on.whlpcr_after, mac->hif_irq_on.mask_before,
+			 mac->hif_irq_on.mask_after);
 		return;
 	}
 	if (mac->hif_irq_armed && !want) {
@@ -3454,10 +3455,11 @@ static void mt6797_mac_hif_irq_pass(struct mt6797_mac *mac)
 		mac->hif_irq_disarm_status = mt6797_hif_set_interrupt(mac->hif, false, deadline,
 								      &mac->hif_irq_off);
 		dev_info(wiphy_dev(mac->hw->wiphy),
-			 "one-shot WLAN HIF interrupt disarmed: irq=%d status=%d taken=%u rearmed=%u whlpcr=0x%08x>0x%08x\n",
+			 "one-shot WLAN HIF interrupt disarmed: irq=%d status=%d taken=%u rearmed=%u whlpcr=0x%08x>0x%08x mask=0x%08x>0x%08x\n",
 			 mac->hif_irq, mac->hif_irq_disarm_status, READ_ONCE(mac->hif_irq_taken),
 			 mac->hif_irq_rearmed, mac->hif_irq_off.whlpcr_before,
-			 mac->hif_irq_off.whlpcr_after);
+			 mac->hif_irq_off.whlpcr_after, mac->hif_irq_off.mask_before,
+			 mac->hif_irq_off.mask_after);
 		return;
 	}
 	if (mac->hif_irq_armed && atomic_xchg(&mac->hif_irq_masked, 0)) {
-- 
