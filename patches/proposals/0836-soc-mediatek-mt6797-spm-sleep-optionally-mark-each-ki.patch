From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Fri, 20 Nov 2026 16:06:45 -0500
Subject: [PATCH] soc: mediatek: mt6797-spm-sleep: optionally mark each kick in
 the SPM software registers

A hung SODI period leaves no CPU able to log where the program stopped,
and the RAM console is lost when the reset lands in the other system.

The program writes SW_DEBUG and SW_RSV_0 to 0 near its start (0x413,
0x419) and SW_RSV_0 to the wake status at its exit. With sodi_mark both
start each kick at 0x5a5a0000 plus the kick count instead of 0. Read after
a watchdog reset, the marker places the hung period: never reached 0x413,
froze between there and the exit, or reached the exit. A value the
bootloader writes shows the registers do not survive the reset.
---
 drivers/soc/mediatek/mt6797-spm-sleep.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/mediatek/mt6797-spm-sleep.c b/drivers/soc/mediatek/mt6797-spm-sleep.c
index ef4eb9cf8..60075a90f 100644
--- a/drivers/soc/mediatek/mt6797-spm-sleep.c
+++ b/drivers/soc/mediatek/mt6797-spm-sleep.c
@@ -289,6 +289,20 @@ static bool sodi_obs;
 module_param(sodi_obs, bool, 0444);
 MODULE_PARM_DESC(sodi_obs, "SODI: CPU8 samples the PCM in periods, prints after a stuck one");
 
+/*
+ * The program writes SW_DEBUG and SW_RSV_0 to 0 at 0x413/0x419 and SW_RSV_0
+ * to the wake status at its exit. With sodi_mark, both start each kick at
+ * 0x5a5a0000 plus the kick count instead, so after a hang and a watchdog
+ * reset the marker still there means the program never reached 0x413, a 0
+ * means it froze between there and its exit, and a wake status means it
+ * reached the exit. A value the bootloader writes means they do not survive.
+ */
+#define SODI_MARK		0x5a5a0000
+static bool sodi_mark;
+module_param(sodi_mark, bool, 0444);
+MODULE_PARM_DESC(sodi_mark, "SODI: SW_DEBUG and SW_RSV_0 start each kick at 0x5a5a0000 plus the kick count");
+static u32 sodi_kicks;
+
 static bool sodi_obs_noread;
 module_param(sodi_obs_noread, bool, 0444);
 MODULE_PARM_DESC(sodi_obs_noread, "SODI: the observer only counts its ticks in a period, reading the SPM only once one is stuck");
@@ -1029,7 +1043,13 @@ static int spm_run(const struct spm_scen *sc)
 	spm_wr(SPM_MAS_PAUSE2_MASK_B, 0xffffffff);
 	spm_wr(PCM_REG_DATA_INI, 0);
 	spm_wr(SPM_SW_FLAG, sc->flags);
-	spm_wr(SPM_SW_RSV_0, 0);
+	if (sodi_mark) {
+		sodi_kicks++;
+		spm_wr(SPM_SW_DEBUG, SODI_MARK | (sodi_kicks & 0xffff));
+		spm_wr(SPM_SW_RSV_0, SODI_MARK | (sodi_kicks & 0xffff));
+	} else {
+		spm_wr(SPM_SW_RSV_0, 0);
+	}
 	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) | SPM_LOCK_INFRA_DCM);
 
 	/* D5q: has the IM fetch settled? Refuse the period if not */
-- 
2.43.0

