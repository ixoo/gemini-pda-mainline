 .../soc/mediatek/mediatek,mt6797-consys.yaml  | 170 ++++++++++++++++++
 1 file changed, 170 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
new file mode 100644
index 000000000..46147249e
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
@@ -0,0 +1,170 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6797-consys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 shared connectivity resources
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description: |
+  The CONSYS manager owns the boot-allocated no-map firmware reservation
+  shared by WLAN and WMT. It attaches to a confirmed-OFF CONN domain only
+  after acquiring the common resources, then populates the passive WLAN child.
+  The child has no direct power-domain attachment.
+
+  The manager starts the connectivity subsystem on request: CONN power, the
+  CONMCU reset release, WMT negotiation over BTIF, the common initialization
+  (ROM patches, coexistence and RF calibration), then the WLAN firmware.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-consys
+
+  reg:
+    items:
+      - description: Four-byte shared remap register at TOPCKGEN 0x1340.
+      - description: Four-byte CONN-to-AP sleep mask at TOPCKGEN 0x1350.
+      - description: Read-only CONSYS chip ID at 0x18070008.
+      - description: CONSYS MCU ACR at 0x18070110.
+      - description: AHB SDIO-like Wi-Fi HIF at 0x180f0000.
+      - description: Read-only EMI address-translation selector at 0x10001f00.
+      - description: BTIF controller at 0x1100c000.
+      - description: BTIF AP-DMA TX channel at 0x11000a00.
+      - description: BTIF AP-DMA RX channel at 0x11000a80.
+      - description: Wi-Fi HIF AP-DMA channel 0 at 0x11000080.
+      - description: Connectivity analog front-end at 0x180b6000.
+
+  reg-names:
+    items:
+      - const: remap
+      - const: conn2ap-sleep-mask
+      - const: chip-id
+      - const: mcu-acr
+      - const: wifi-hif
+      - const: emi-selector
+      - const: btif
+      - const: btif-dma-tx
+      - const: btif-dma-rx
+      - const: wifi-hif-dma
+      - const: afe
+
+  clocks:
+    items:
+      - description: BTIF controller clock.
+      - description: Shared AP-DMA clock for channel idle observations.
+
+  clock-names:
+    items:
+      - const: btif
+      - const: ap-dma
+
+  interrupts:
+    maxItems: 1
+
+  mediatek,coex-antenna-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: Board WMT coexistence antenna mode sent by common init.
+
+  memory-region:
+    maxItems: 1
+    description: Boot-allocated no-map CONSYS firmware reservation.
+
+  vcn18-supply:
+    description: Common 1.8 V connectivity supply.
+
+  vcn28-supply:
+    description: Common 2.8 V connectivity supply.
+
+  vcn33-wifi-supply:
+    description: Wi-Fi 3.3 V supply.
+
+  vcn33-bt-supply:
+    description: Bluetooth 3.3 V supply.
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: con-mcu
+
+  power-domains: false
+
+  wifi:
+    type: object
+    description: Passive WLAN firmware client populated after CONSYS binds.
+    properties:
+      status: true
+      compatible:
+        const: mediatek,mt6797-wlan
+    required:
+      - compatible
+    additionalProperties: false
+
+  mediatek,conn-power-domain:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    maxItems: 1
+    description: |
+      Modern MT6797 CONN domain, attached by the manager during probe without
+      a power-on request. Do not use power-domains on the manager itself.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - interrupts
+  - memory-region
+  - vcn18-supply
+  - vcn28-supply
+  - vcn33-wifi-supply
+  - vcn33-bt-supply
+  - resets
+  - reset-names
+  - mediatek,coex-antenna-mode
+  - mediatek,conn-power-domain
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        consys@10001340 {
+            compatible = "mediatek,mt6797-consys";
+            reg = <0 0x10001340 0 4>, <0 0x10001350 0 4>,
+                  <0 0x18070008 0 4>, <0 0x18070110 0 4>,
+                  <0 0x180f0000 0 0x1100>, <0 0x10001f00 0 4>,
+                  <0 0x1100c000 0 0x1000>, <0 0x11000a00 0 0x80>,
+                  <0 0x11000a80 0 0x80>, <0 0x11000080 0 0x80>,
+                  <0 0x180b6000 0 0x100>;
+            reg-names = "remap", "conn2ap-sleep-mask", "chip-id", "mcu-acr",
+                        "wifi-hif", "emi-selector",
+                        "btif", "btif-dma-tx", "btif-dma-rx", "wifi-hif-dma",
+                        "afe";
+            clocks = <&infrasys 1>, <&infrasys 2>;
+            clock-names = "btif", "ap-dma";
+            interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_LOW>;
+            memory-region = <&consys_reserved>;
+            vcn18-supply = <&vcn18>;
+            vcn28-supply = <&vcn28>;
+            vcn33-wifi-supply = <&vcn33_wifi>;
+            vcn33-bt-supply = <&vcn33_bt>;
+            resets = <&watchdog 12>;
+            reset-names = "con-mcu";
+            mediatek,conn-power-domain = <&conn_power 0>;
+            mediatek,coex-antenna-mode = <1>;
+
+            wifi {
+                compatible = "mediatek,mt6797-wlan";
+            };
+        };
+    };
