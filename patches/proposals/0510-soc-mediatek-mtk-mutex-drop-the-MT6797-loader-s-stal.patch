From bab7b7255d746d07766cff31bd5d722c6611566d Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 2 Nov 2026 21:52:11 -0500
Subject: [PATCH] soc: mediatek: mtk-mutex: drop the MT6797 loader's stale
 members

The MT6797 loader leaves the display PWM in mutex 0 alongside the pipeline, and
the DRM path neither adds nor removes it. A member's register updates wait for the
mutex's frame start, so once the pipeline stops, a brightness change no longer
takes effect. On the Gemini the console blank stops the pipeline and then turns the
backlight off: CON_1 reads duty 0, the live level stays at 0x200, and the panel
glows while asleep. Start from no members when the pipeline starts.
---
 drivers/soc/mediatek/mtk-mutex.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/mediatek/mtk-mutex.c b/drivers/soc/mediatek/mtk-mutex.c
index 9f31b3cda..90713d7cf 100644
--- a/drivers/soc/mediatek/mtk-mutex.c
+++ b/drivers/soc/mediatek/mtk-mutex.c
@@ -379,6 +379,7 @@ struct mtk_mutex_data {
 	const u16 mutex_mod1_reg;
 	const u16 mutex_sof_reg;
 	const bool no_clk;
+	const bool clear_loader_mod;
 };
 
 struct mtk_mutex_ctx {
@@ -814,6 +815,7 @@ static const struct mtk_mutex_data mt6797_mutex_driver_data = {
 	.mutex_mod1_reg = MT2701_MUTEX0_MOD1,
 	.mutex_sof_reg = MT2701_MUTEX0_SOF0,
 	.no_clk = true,
+	.clear_loader_mod = true,
 };
 
 static const struct mtk_mutex_data mt8167_mutex_driver_data = {
@@ -937,7 +939,21 @@ int mtk_mutex_prepare(struct mtk_mutex *mutex)
 {
 	struct mtk_mutex_ctx *mtx = container_of(mutex, struct mtk_mutex_ctx,
 						 mutex[mutex->id]);
-	return clk_prepare_enable(mtx->clk);
+	int ret;
+
+	ret = clk_prepare_enable(mtx->clk);
+	if (ret)
+		return ret;
+
+	/*
+	 * A member's register updates wait for this mutex's frame start, so a
+	 * member the loader left behind and no client owns stops updating when
+	 * the pipeline stops.
+	 */
+	if (mtx->data->clear_loader_mod)
+		writel_relaxed(0, mtx->regs + DISP_REG_MUTEX_MOD(mtx, 0, mutex->id));
+
+	return 0;
 }
 EXPORT_SYMBOL_GPL(mtk_mutex_prepare);
 
