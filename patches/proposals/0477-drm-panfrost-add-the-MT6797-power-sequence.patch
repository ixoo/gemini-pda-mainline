diff --git a/drivers/gpu/drm/panfrost/panfrost_mt6797.c b/drivers/gpu/drm/panfrost/panfrost_mt6797.c
new file mode 100644
index 000000000..b7353f7c0
--- /dev/null
+++ b/drivers/gpu/drm/panfrost/panfrost_mt6797.c
@@ -0,0 +1,333 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The MT6797 power sequence around Panfrost's generic one.
+ *
+ * The vendor order is GPU LDOs, VGPU, VCG, MFG_ASYNC, MFG, cores, BG3D, 100 us,
+ * bus protection release, async timing. Panfrost powers the domains first and
+ * has no LDO or protection step, so these callbacks supply what comes before
+ * and after. Everything here runs only while this module binds or unbinds.
+ *
+ * This is a fixed point: 1.0 V, the mux on a running clock and no OPP table.
+ * The MFGPLL is not touched. The vendor parks its divider across a change, and
+ * that transition has not been reviewed.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/reset.h>
+#include <linux/soc/mediatek/infracfg.h>
+#include <linux/thermal.h>
+
+#include "panfrost_device.h"
+#include "panfrost_mt6797.h"
+
+#define MT6797_GPULDO_EN		0xfbc
+#define MT6797_GPULDO_EN_ALL		0x1ff
+#define MT6797_GPULDO_VOSEL_0_3		0xfc0
+#define MT6797_GPULDO_VOSEL_4_7		0xfc4
+#define MT6797_GPULDO_VOSEL_8		0xfc8
+#define MT6797_GPULDO_RSV_H_0_7		0xfd8
+#define MT6797_GPULDO_RSV_H_8		0xfe4
+
+#define MT6797_MFG_PROT_MASK		(BIT(21) | BIT(23))
+#define MT6797_MFG_PROT_TIMEOUT_US	10000
+
+#define MT6797_MFG_ASYNC_CON		0x1c
+/* The vendor selects this from the table maximum, not the current rate. */
+#define MT6797_MFG_ASYNC_TIMING		0xa
+#define MT6797_MFG_DEBUG_SEL		0x180
+#define MT6797_MFG_DEBUG_A		0x184
+#define MT6797_MFG_DEBUG_IDLE		BIT(2)
+#define MT6797_MFG_IDLE_TIMEOUT_US	100000
+
+#define MT6797_VGPU_UV			1000000
+/* syspll_d3, the faster parent allowed here, sits at the vendor's 365 MHz point. */
+#define MT6797_MAX_RATE			365000000
+#define MT6797_MAX_START_MCELSIUS	55000
+
+static int mt6797_parent;
+module_param_named(mt6797_parent, mt6797_parent, int, 0444);
+MODULE_PARM_DESC(mt6797_parent, "MT6797 GPU clock: 0 = clk26m (default), 1 = syspll_d3");
+
+/*
+ * RSV_H_8 is bits 3:0. The station read bit 15 of that register set, which the
+ * register table does not describe, so unlike the vendor's write this leaves it.
+ */
+static const struct {
+	u32 reg;
+	u32 mask;
+	u32 val;
+} mt6797_ldo_setup[] = {
+	{ MT6797_GPULDO_RSV_H_0_7, GENMASK(31, 0), 0x88888888 },
+	{ MT6797_GPULDO_RSV_H_8, GENMASK(3, 0), 0x00000008 },
+	{ MT6797_GPULDO_VOSEL_0_3, GENMASK(31, 0), 0x0f0f0f0f },
+	{ MT6797_GPULDO_VOSEL_4_7, GENMASK(31, 0), 0x0f0f0f0f },
+	{ MT6797_GPULDO_VOSEL_8, GENMASK(31, 0), 0x0000000f },
+};
+
+struct panfrost_mt6797 {
+	struct regulator *vgpu;
+	struct regmap *infracfg;
+	struct regmap *mfg;
+};
+
+static int mt6797_check_temperature(struct device *dev)
+{
+	struct thermal_zone_device *tz;
+	int temp, ret;
+
+	tz = thermal_zone_get_zone_by_name("soc-thermal");
+	if (IS_ERR(tz))
+		return dev_err_probe(dev, PTR_ERR(tz), "no SoC thermal zone\n");
+
+	ret = thermal_zone_get_temp(tz, &temp);
+	if (ret)
+		return dev_err_probe(dev, ret, "no SoC temperature\n");
+
+	if (temp >= MT6797_MAX_START_MCELSIUS)
+		return dev_err_probe(dev, -EBUSY, "SoC at %d mC, not starting\n", temp);
+
+	dev_info(dev, "mt6797: SoC at %d mC\n", temp);
+	return 0;
+}
+
+static int mt6797_set_clocks(struct device *dev)
+{
+	struct clk *sel, *parent, *sel_52m, *parent_52m;
+	unsigned long rate;
+	int ret;
+
+	sel = devm_clk_get(dev, "mfg-sel");
+	if (IS_ERR(sel))
+		return PTR_ERR(sel);
+	parent = devm_clk_get(dev, mt6797_parent == 1 ? "mfg-syspll-d3" : "mfg-26m");
+	if (IS_ERR(parent))
+		return PTR_ERR(parent);
+	sel_52m = devm_clk_get(dev, "mfg-52m-sel");
+	if (IS_ERR(sel_52m))
+		return PTR_ERR(sel_52m);
+	parent_52m = devm_clk_get(dev, "mfg-52m-parent");
+	if (IS_ERR(parent_52m))
+		return PTR_ERR(parent_52m);
+
+	ret = clk_set_parent(sel_52m, parent_52m);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set the 52M parent\n");
+
+	ret = clk_set_parent(sel, parent);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set the GPU clock parent\n");
+
+	rate = clk_get_rate(sel);
+	if (!rate || rate > MT6797_MAX_RATE)
+		return dev_err_probe(dev, -ERANGE, "GPU clock at %lu Hz\n", rate);
+
+	dev_info(dev, "mt6797: GPU clock %lu Hz, 52M clock %lu Hz\n", rate,
+		 clk_get_rate(sel_52m));
+	return 0;
+}
+
+static void mt6797_log_inherited(struct device *dev, struct panfrost_mt6797 *mt)
+{
+	u32 en = 0, vosel = 0, vosel8 = 0, rsv = 0, rsv8 = 0, prot = 0, sta = 0;
+
+	regmap_read(mt->infracfg, MT6797_GPULDO_EN, &en);
+	regmap_read(mt->infracfg, MT6797_GPULDO_VOSEL_0_3, &vosel);
+	regmap_read(mt->infracfg, MT6797_GPULDO_VOSEL_8, &vosel8);
+	regmap_read(mt->infracfg, MT6797_GPULDO_RSV_H_0_7, &rsv);
+	regmap_read(mt->infracfg, MT6797_GPULDO_RSV_H_8, &rsv8);
+	regmap_read(mt->infracfg, INFRA_TOPAXI_PROTECTEN, &prot);
+	regmap_read(mt->infracfg, INFRA_TOPAXI_PROTECTSTA1, &sta);
+
+	dev_info(dev, "mt6797: inherited LDO en %#x vosel %#x/%#x rsv %#x/%#x, protect %#x/%#x\n",
+		 en, vosel, vosel8, rsv, rsv8, prot, sta);
+}
+
+static int mt6797_setup_ldos(struct device *dev, struct panfrost_mt6797 *mt)
+{
+	u32 val;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(mt6797_ldo_setup); i++) {
+		ret = regmap_update_bits(mt->infracfg, mt6797_ldo_setup[i].reg,
+					 mt6797_ldo_setup[i].mask, mt6797_ldo_setup[i].val);
+		if (ret)
+			return ret;
+
+		ret = regmap_read(mt->infracfg, mt6797_ldo_setup[i].reg, &val);
+		if (ret)
+			return ret;
+
+		if ((val & mt6797_ldo_setup[i].mask) != mt6797_ldo_setup[i].val)
+			return dev_err_probe(dev, -EIO, "LDO %#x reads %#x, wrote %#x\n",
+					     mt6797_ldo_setup[i].reg, val, mt6797_ldo_setup[i].val);
+	}
+
+	return 0;
+}
+
+static int mt6797_protect(struct panfrost_mt6797 *mt, bool on)
+{
+	u32 val;
+
+	regmap_update_bits(mt->infracfg, INFRA_TOPAXI_PROTECTEN, MT6797_MFG_PROT_MASK,
+			   on ? MT6797_MFG_PROT_MASK : 0);
+
+	return regmap_read_poll_timeout(mt->infracfg, INFRA_TOPAXI_PROTECTSTA1, val,
+					(val & MT6797_MFG_PROT_MASK) ==
+					(on ? MT6797_MFG_PROT_MASK : 0),
+					10, MT6797_MFG_PROT_TIMEOUT_US);
+}
+
+/* Before the domains. Nothing has touched the hardware when this defers. */
+static int mt6797_power_early(struct panfrost_device *pfdev)
+{
+	struct device *dev = pfdev->base.dev;
+	struct device_node *np = dev->of_node;
+	struct reset_control *rstc;
+	struct panfrost_mt6797 *mt;
+	struct clk *core;
+	u32 en;
+	int ret;
+
+	mt = devm_kzalloc(dev, sizeof(*mt), GFP_KERNEL);
+	if (!mt)
+		return -ENOMEM;
+	pfdev->platform_data = mt;
+
+	/* Panfrost asks for these after the domains; refuse without them here. */
+	core = devm_clk_get(dev, NULL);
+	if (IS_ERR(core))
+		return PTR_ERR(core);
+
+	mt->vgpu = devm_regulator_get(dev, "mali");
+	if (IS_ERR(mt->vgpu))
+		return PTR_ERR(mt->vgpu);
+
+	mt->infracfg = syscon_regmap_lookup_by_phandle(np, "mediatek,infracfg");
+	if (IS_ERR(mt->infracfg))
+		return PTR_ERR(mt->infracfg);
+
+	mt->mfg = syscon_regmap_lookup_by_phandle(np, "mediatek,mfgsys");
+	if (IS_ERR(mt->mfg))
+		return PTR_ERR(mt->mfg);
+
+	rstc = reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(rstc))
+		return PTR_ERR(rstc);
+
+	ret = mt6797_check_temperature(dev);
+	if (ret)
+		goto err_put_reset;
+
+	ret = regulator_get_voltage(mt->vgpu);
+	if (ret != MT6797_VGPU_UV) {
+		ret = dev_err_probe(dev, -ERANGE, "VGPU at %d uV\n", ret);
+		goto err_put_reset;
+	}
+
+	mt6797_log_inherited(dev, mt);
+
+	ret = mt6797_set_clocks(dev);
+	if (ret)
+		goto err_put_reset;
+
+	ret = mt6797_setup_ldos(dev, mt);
+	if (ret)
+		goto err_put_reset;
+
+	/* The vendor's one pulse at init, with the domains still off. */
+	reset_control_assert(rstc);
+	udelay(1);
+	reset_control_deassert(rstc);
+	reset_control_put(rstc);
+
+	ret = mt6797_protect(mt, true);
+	if (ret)
+		return dev_err_probe(dev, ret, "MFG bus protection not acknowledged\n");
+
+	ret = regmap_write(mt->infracfg, MT6797_GPULDO_EN, MT6797_GPULDO_EN_ALL);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(mt->infracfg, MT6797_GPULDO_EN, &en);
+	if (!ret && en != MT6797_GPULDO_EN_ALL)
+		ret = dev_err_probe(dev, -EIO, "LDO enable reads %#x\n", en);
+	if (ret)
+		goto err_ldo;
+
+	ret = regulator_enable(mt->vgpu);
+	if (ret)
+		goto err_ldo;
+
+	dev_info(dev, "mt6797: VGPU on at %d uV\n", regulator_get_voltage(mt->vgpu));
+	return 0;
+
+err_ldo:
+	regmap_write(mt->infracfg, MT6797_GPULDO_EN, 0);
+	return ret;
+
+err_put_reset:
+	reset_control_put(rstc);
+	return ret;
+}
+
+/* After the domains and BG3D, before the first GPU register. */
+static int mt6797_power_late(struct panfrost_device *pfdev)
+{
+	struct panfrost_mt6797 *mt = pfdev->platform_data;
+	struct device *dev = pfdev->base.dev;
+	u32 before = 0, after = 0;
+	int ret;
+
+	udelay(100);
+
+	ret = mt6797_protect(mt, false);
+	if (ret)
+		return dev_err_probe(dev, ret, "MFG bus protection release not acknowledged\n");
+
+	regmap_read(mt->mfg, MT6797_MFG_ASYNC_CON, &before);
+	regmap_update_bits(mt->mfg, MT6797_MFG_ASYNC_CON, MT6797_MFG_ASYNC_TIMING,
+			   MT6797_MFG_ASYNC_TIMING);
+	regmap_read(mt->mfg, MT6797_MFG_ASYNC_CON, &after);
+
+	dev_info(dev, "mt6797: MFG_ASYNC_CON %#x -> %#x\n", before, after);
+	return 0;
+}
+
+/* Before BG3D stops. */
+static void mt6797_unpower_early(struct panfrost_device *pfdev)
+{
+	struct panfrost_mt6797 *mt = pfdev->platform_data;
+	struct device *dev = pfdev->base.dev;
+	u32 val;
+
+	regmap_write(mt->mfg, MT6797_MFG_DEBUG_SEL, 0x3);
+	if (regmap_read_poll_timeout(mt->mfg, MT6797_MFG_DEBUG_A, val,
+				     val & MT6797_MFG_DEBUG_IDLE, 10,
+				     MT6797_MFG_IDLE_TIMEOUT_US))
+		dev_warn(dev, "mt6797: MFG not idle before power off: %#x\n", val);
+
+	if (mt6797_protect(mt, true))
+		dev_warn(dev, "mt6797: MFG bus protection not acknowledged at power off\n");
+}
+
+/* After the domains. Vendor order: VGPU off, then the LDOs. */
+static void mt6797_unpower_late(struct panfrost_device *pfdev)
+{
+	struct panfrost_mt6797 *mt = pfdev->platform_data;
+
+	regulator_disable(mt->vgpu);
+	regmap_write(mt->infracfg, MT6797_GPULDO_EN, 0);
+}
+
+const struct panfrost_platform_ops panfrost_mt6797_ops = {
+	.power_early = mt6797_power_early,
+	.power_late = mt6797_power_late,
+	.unpower_early = mt6797_unpower_early,
+	.unpower_late = mt6797_unpower_late,
+};
