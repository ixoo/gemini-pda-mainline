 drivers/gpu/drm/panfrost/panfrost_drv.c       |   9 +
 drivers/gpu/drm/panfrost/panfrost_mt6797.c    | 333 ++++++++++++++++++
 drivers/gpu/drm/panfrost/panfrost_mt6797.h    |   8 +
 7 files changed, 416 insertions(+), 6 deletions(-)
 create mode 100644 drivers/gpu/drm/panfrost/panfrost_mt6797.c
 create mode 100644 drivers/gpu/drm/panfrost/panfrost_mt6797.h

