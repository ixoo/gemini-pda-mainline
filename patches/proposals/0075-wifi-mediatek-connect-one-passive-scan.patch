diff --git a/drivers/net/wireless/mediatek/mt6797/scan-wire.h b/drivers/net/wireless/mediatek/mt6797/scan-wire.h
new file mode 100644
index 0000000..60d5365
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt6797/scan-wire.h
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original encoders/decoder from the pinned gen3 scan and RX contracts. */
+#ifndef MT6797_SCAN_WIRE_H
+#define MT6797_SCAN_WIRE_H
+
+#include "normal_command.h"
+
+#define MT6797_PASSIVE_SCAN_BYTES 226U
+#define MT6797_PASSIVE_SCAN_CHANNELS 13U
+
+/* One exclusive AIS BSS (0), own-MAC slot 1, unencrypted BMC slot 0.
+ * These slots remain reserved until the retained firmware session ends.
+ * This is a submission layout, never an activation acknowledgement.
+ */
+static inline void
+mt6797_scan_bss(const unsigned char *mac, bool active, unsigned char output[12])
+{
+	unsigned int i;
+
+	for (i = 0; i < 12; i++)
+		output[i] = 0;
+	output[1] = active;
+	output[3] = 1;
+	for (i = 0; i < 6; i++)
+		output[4 + i] = mac[i];
+}
+
+/* Passive-only V2, no SSID, probe, IE, random address or reserved extension.
+ * Caller has checked each channel against current cfg80211 permissions.
+ */
+static inline int
+mt6797_scan_request(unsigned int sequence, const unsigned int *channels,
+		    unsigned int count, unsigned char *output)
+{
+	unsigned int i, j;
+
+	if (!output || !channels || !sequence || sequence > 255 ||
+	    !count || count > MT6797_PASSIVE_SCAN_CHANNELS)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		if (!channels[i] || channels[i] > MT6797_PASSIVE_SCAN_CHANNELS)
+			return -EINVAL;
+		for (j = 0; j < i; j++)
+			if (channels[i] == channels[j])
+				return -EINVAL;
+	}
+	for (i = 0; i < MT6797_PASSIVE_SCAN_BYTES; i++)
+		output[i] = 0;
+	output[0] = sequence;
+	/* Retain the firmware default dwell. The selected host comments disagree
+	 * on nonzero V2 units; the host independently bounds the whole scan.
+	 */
+	output[158] = 4; /* SCAN_CHANNEL_SPECIFIED */
+	output[159] = count;
+	for (i = 0; i < count; i++) {
+		output[160 + 2 * i] = 1; /* BAND_2G4 */
+		output[161 + 2 * i] = channels[i];
+	}
+	return 0;
+}
+
+/* Match the payload scan sequence before any caller state changes. The
+ * retained image's ordinary constructor emits 24 bytes and outer sequence 0.
+ * A normal completion is not a cancellation or event-drain acknowledgement.
+ */
+static inline int
+mt6797_scan_done(const unsigned char *packet, size_t bytes,
+		 unsigned int sequence, unsigned int channel_count)
+{
+	if (!packet || bytes != 24 || mt6797_normal_le16(packet) != bytes ||
+	    mt6797_normal_le16(packet + 2) != 0xe000 || packet[4] != 0x0d ||
+	    packet[5] || !sequence || sequence > 255 ||
+	    !channel_count || channel_count > MT6797_PASSIVE_SCAN_CHANNELS)
+		return -EPROTO;
+	if (packet[8] != sequence)
+		return -EAGAIN;
+	if (packet[13] != 7 || packet[12] != channel_count)
+		return -EPROTO;
+	return 0;
+}
+
+struct mt6797_scan_frame {
+	size_t offset, bytes;
+	unsigned int channel, rcpi;
+};
+
+/* Only native unprotected beacon/probe-response management frames. The RX
+ * groups occur in wire order 4,1,2,3, with source-defined sizes 16,16,8,24.
+ * Never reinterpret translated Ethernet data or incomplete metadata as 802.11.
+ */
+static inline int
+mt6797_scan_frame(const unsigned char *packet, size_t bytes,
+		  struct mt6797_scan_frame *frame)
+{
+	unsigned int type, groups, fc, flags, rcpi;
+	size_t offset = 16, vector = 0;
+
+	if (!frame)
+		return -EINVAL;
+	*frame = (struct mt6797_scan_frame){0};
+	if (!packet || bytes < 16 || mt6797_normal_le16(packet) != bytes)
+		return -EPROTO;
+	type = mt6797_normal_le16(packet + 2);
+	if ((type & 0xe00f) != 0xe001)
+		return -EOPNOTSUPP;
+	groups = (type >> 9) & 15;
+	if (groups & 8)
+		offset += 16;
+	if (groups & 1)
+		offset += 16;
+	if (groups & 2)
+		offset += 8;
+	if (groups & 4) {
+		vector = offset;
+		offset += 24;
+	}
+	if (offset > bytes)
+		return -EPROTO;
+	if (packet[6] & 0x40)
+		offset += 2;
+	if (offset > bytes || bytes - offset < 36)
+		return -EPROTO;
+	flags = mt6797_normal_le16(packet + 10);
+	if ((packet[6] & 0x80) || (packet[6] & 0x3f) != 24 ||
+	    (packet[9] & 0xf0) || (packet[7] & 3) || (flags & 0x07fe))
+		return -EOPNOTSUPP;
+	fc = mt6797_normal_le16(packet + offset);
+	if ((fc & 0x00ff) != 0x0080 && (fc & 0x00ff) != 0x0050)
+		return -EOPNOTSUPP;
+	if ((fc & 0xc700) || (mt6797_normal_le16(packet + offset + 22) & 15))
+		/* No DS, fragmentation, protection or HT-control interpretation. */
+		return -EOPNOTSUPP;
+	if (!vector)
+		return -EOPNOTSUPP;
+	rcpi = packet[vector + 9];
+	if (rcpi > 220 || !packet[5] || packet[5] > MT6797_PASSIVE_SCAN_CHANNELS)
+		return -EOPNOTSUPP;
+	frame->offset = offset;
+	frame->bytes = bytes - offset;
+	frame->channel = packet[5];
+	frame->rcpi = rcpi;
+	return 0;
+}
+
+#endif
