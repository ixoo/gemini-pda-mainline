@@ -2,7 +2,7 @@
 #ifndef GEMINI_WMT_FULL_STP_STATE_H
 #define GEMINI_WMT_FULL_STP_STATE_H
 #include "wmt-full-stp.h"
-#include "stp-full-link.h"
+#include "stp-full-task.h"
 
 /*
  * Single WMT command client over one shared link. The current IRQ owner still
@@ -34,36 +34,52 @@ static inline int wmt_full_sent(struct wmt_full_state *state, unsigned int seque
 	return 0;
 }
 
-/* WMT event validation stays a client rule, before shared link mutation. */
+/* Immutable expected event, valid throughout the serialized IRQ exchange. */
+struct wmt_full_expect {
+	const struct wmt_full_state *state;
+	const unsigned char *payload;
+	unsigned int length;
+};
+
+static inline int wmt_full_event(void *context, const unsigned char *payload,
+				 unsigned int length)
+{
+	const struct wmt_full_expect *expected = context;
+	unsigned int i;
+
+	if (!expected->payload || expected->state->event_seen ||
+	    length > WMT_FULL_MAX_PAYLOAD || length != expected->length)
+		return -1;
+	for (i = 0; i < length; i++)
+		if (payload[i] != expected->payload[i])
+			return -1;
+	return 0;
+}
+
+/* WMT validation uses the task router before committing shared link credit. */
 static inline int wmt_full_receive(struct wmt_full_state *state,
 				   const unsigned char *frame, unsigned int bytes,
 				   const unsigned char *expected,
 				   unsigned int expected_length)
 {
-	struct wmt_full_frame decoded;
+	struct wmt_full_expect event = { state, expected, expected_length };
+	struct stp_full_client client = {
+		.task = STP_FULL_TASK_WMT, .receive = wmt_full_event, .context = &event,
+	};
+	struct stp_full_link next;
 	struct stp_full_frame received;
-	unsigned int i;
 	int kind;
 
 	if (!state || !state->active)
 		return -1;
-	kind = wmt_full_decode(frame, bytes, &decoded);
-	if (kind < 0)
-		return -1;
-	if (decoded.acknowledgement != state->transport.peer_ack &&
-	    decoded.acknowledgement != state->sent_sequence)
+	next = state->transport;
+	kind = stp_full_task_receive(&next, frame, bytes, &client, 1, &received);
+	if (kind < 0 || kind == 2)
 		return -1;
-	if (kind) {
-		if (!expected || state->event_seen ||
-		    decoded.sequence != state->transport.rx_next ||
-		    decoded.length != expected_length)
-			return -1;
-		for (i = 0; i < expected_length; i++)
-			if (decoded.payload[i] != expected[i])
-				return -1;
-	}
-	if (stp_full_link_receive(&state->transport, frame, bytes, &received) != kind)
+	if (received.acknowledgement != state->transport.peer_ack &&
+	    received.acknowledgement != state->sent_sequence)
 		return -1;
+	state->transport = next;
 	if (state->transport.peer_ack == state->sent_sequence)
 		state->acknowledged = 1;
 	if (kind)
