From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Thu, 5 Nov 2026 21:18:57 -0500
Subject: [PATCH 595/602] usb: typec: let a port driver set the port type of a
 dual-role port

A dual-role port starts with the port type it was registered with, and
only userspace can change it, by writing the port_type attribute. A port
driver that has to start a dual-role port as a sink only, for example
because its hardware cannot prefer one role while toggling, can only do
so behind the class's back, and the attribute then reports the wrong
type.

Move the body of port_type_store() into typec_set_port_type() and
export it. The attribute behaves as before.
---
 drivers/usb/typec/class.c | 58 +++++++++++++++++++++++----------------
 include/linux/usb/typec.h |  1 +
 2 files changed, 35 insertions(+), 24 deletions(-)

diff --git a/drivers/usb/typec/class.c b/drivers/usb/typec/class.c
index 0977581ad..a1dffcaa4 100644
--- a/drivers/usb/typec/class.c
+++ b/drivers/usb/typec/class.c
@@ -1855,42 +1855,52 @@ static ssize_t power_role_show(struct device *dev,
 }
 static DEVICE_ATTR_RW(power_role);
 
+/**
+ * typec_set_port_type - Change the port type of a dual-role port
+ * @port: The USB Type-C port
+ * @type: The new port type
+ *
+ * Does what writing the port_type attribute does: the port driver's
+ * port_type_set operation, then the recorded type. A driver can use it to
+ * start a dual-role port as a source or a sink only, and the attribute
+ * still reports what the port does.
+ */
+int typec_set_port_type(struct typec_port *port, enum typec_port_type type)
+{
+	int ret = 0;
+
+	if (port->cap->type != TYPEC_PORT_DRP ||
+	    !port->ops || !port->ops->port_type_set)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&port->port_type_lock);
+	if (port->port_type != type) {
+		ret = port->ops->port_type_set(port, type);
+		if (!ret)
+			port->port_type = type;
+	}
+	mutex_unlock(&port->port_type_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(typec_set_port_type);
+
 static ssize_t
 port_type_store(struct device *dev, struct device_attribute *attr,
 			const char *buf, size_t size)
 {
 	struct typec_port *port = to_typec_port(dev);
 	int ret;
-	enum typec_port_type type;
-
-	if (port->cap->type != TYPEC_PORT_DRP ||
-	    !port->ops || !port->ops->port_type_set) {
-		dev_dbg(dev, "changing port type not supported\n");
-		return -EOPNOTSUPP;
-	}
 
 	ret = sysfs_match_string(typec_port_power_roles, buf);
 	if (ret < 0)
 		return ret;
 
-	type = ret;
-	mutex_lock(&port->port_type_lock);
-
-	if (port->port_type == type) {
-		ret = size;
-		goto unlock_and_ret;
-	}
-
-	ret = port->ops->port_type_set(port, type);
-	if (ret)
-		goto unlock_and_ret;
-
-	port->port_type = type;
-	ret = size;
+	ret = typec_set_port_type(port, ret);
+	if (ret == -EOPNOTSUPP)
+		dev_dbg(dev, "changing port type not supported\n");
 
-unlock_and_ret:
-	mutex_unlock(&port->port_type_lock);
-	return ret;
+	return ret ? ret : size;
 }
 
 static ssize_t
diff --git a/include/linux/usb/typec.h b/include/linux/usb/typec.h
index d61ec3821..9b92543f6 100644
--- a/include/linux/usb/typec.h
+++ b/include/linux/usb/typec.h
@@ -352,6 +352,7 @@ int typec_set_orientation(struct typec_port *port,
 			  enum typec_orientation orientation);
 enum typec_orientation typec_get_orientation(struct typec_port *port);
 int typec_set_mode(struct typec_port *port, int mode);
+int typec_set_port_type(struct typec_port *port, enum typec_port_type type);
 
 void *typec_get_drvdata(struct typec_port *port);
 
