From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 11 Nov 2026 16:01:09 -0500
Subject: [PATCH] power: supply: mt6351-fuel-gauge: report the charge now and
 full

UPower picks charge units only when the battery has charge_full. It then
takes the energy from charge_now and the rate from current_now, both
times the design voltage, and estimates the time to full and to empty.
Without charge_full it falls back to energy units, finds no energy_now or
power_now, and reports 0 Wh and no time estimates, as on the Gemini.

Report charge_now as the counted charge behind the capacity, clamped to
the full charge, and charge_full as the design capacity: the gauge does
not learn the cell's real capacity.
---
 drivers/power/supply/mt6351-fuel-gauge.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/mt6351-fuel-gauge.c b/drivers/power/supply/mt6351-fuel-gauge.c
index 090492f..9913aae 100644
--- a/drivers/power/supply/mt6351-fuel-gauge.c
+++ b/drivers/power/supply/mt6351-fuel-gauge.c
@@ -242,7 +242,8 @@ static int mt6351_fg_voltage(struct mt6351_fg *fg, int *uv)
  * battery has rested long enough for the voltage to settle, for example held
  * at a charge limit on the charger. Until then, the OCV reading is reported.
  */
-static int mt6351_fg_capacity(struct mt6351_fg *fg, int ua, int *capacity)
+static int mt6351_fg_capacity(struct mt6351_fg *fg, int ua, int *capacity,
+			      int *charge_uah)
 {
 	s64 full = fg->info->charge_full_design_uah;
 	int uv, mc, ret;
@@ -267,6 +268,7 @@ static int mt6351_fg_capacity(struct mt6351_fg *fg, int ua, int *capacity)
 		ret = clamp(ret, 0, 100);
 		if (!fg->win_ua_valid || full <= 0) {
 			*capacity = ret;
+			*charge_uah = div_s64(max_t(s64, full, 0) * ret, 100);
 			return 0;
 		}
 		dev_dbg(fg->dev, "%s OCV reading: %d uV at %d uA, %d mC: %d %%\n",
@@ -277,7 +279,9 @@ static int mt6351_fg_capacity(struct mt6351_fg *fg, int ua, int *capacity)
 	}
 
 	uah = fg->anchor_uah + div_s64(mt6351_fg_car_nah(fg, fg->car - fg->anchor_car), 1000);
-	*capacity = clamp_t(s64, div64_s64(uah * 100 + full / 2, full), 0, 100);
+	uah = clamp_t(s64, uah, 0, full);
+	*capacity = div64_s64(uah * 100 + full / 2, full);
+	*charge_uah = uah;
 
 	return 0;
 }
@@ -308,6 +312,7 @@ static int mt6351_fg_get_property(struct power_supply *psy,
 			return ret;
 		val->intval = mc / 100;
 		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
 		val->intval = fg->info->charge_full_design_uah;
 		return 0;
@@ -344,7 +349,9 @@ static int mt6351_fg_get_property(struct power_supply *psy,
 			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
 		return 0;
 	case POWER_SUPPLY_PROP_CAPACITY:
-		return mt6351_fg_capacity(fg, ua, &val->intval);
+		return mt6351_fg_capacity(fg, ua, &val->intval, &uah);
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		return mt6351_fg_capacity(fg, ua, &ret, &val->intval);
 	default:
 		return -EINVAL;
 	}
@@ -358,6 +365,8 @@ static const enum power_supply_property mt6351_fg_props[] = {
 	POWER_SUPPLY_PROP_CURRENT_NOW,
 	POWER_SUPPLY_PROP_CHARGE_COUNTER,
 	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
 	POWER_SUPPLY_PROP_TEMP,
 	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
