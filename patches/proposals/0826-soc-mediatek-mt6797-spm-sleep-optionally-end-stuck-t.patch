From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Wed, 18 Nov 2026 19:53:02 -0500
Subject: [PATCH] soc: mediatek: mt6797-spm-sleep: optionally end stuck test
 periods with the PCM watchdog

A hung SODI period leaves the PCM kicked and not idle, and CPU0 does not
resume even on its own timer; about 30 s later the chip resets. The SPM
program session reads the latches as the PCM's watchdog state, and every
program exit arms the PCM watchdog itself.

Add sodi_pcm_wdt (default off). In sodi_once periods it sets the PCM
watchdog to the PCM timer plus 2 s, in wake mode, and adds its wake
source (r12 bit 13). A period that would hang should then return with the
full wake record instead of a reset. The watchdog bits and value found
are restored after the period (stage D5p).
---
 drivers/soc/mediatek/mt6797-spm-sleep.c | 29 ++++++++++++++++++++++---
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-spm-sleep.c b/drivers/soc/mediatek/mt6797-spm-sleep.c
index ae110f20b..d80ea262f 100644
--- a/drivers/soc/mediatek/mt6797-spm-sleep.c
+++ b/drivers/soc/mediatek/mt6797-spm-sleep.c
@@ -101,6 +101,7 @@ static const u8 sodi_fw_sha256[SHA256_DIGEST_SIZE] = {
 #define PCM_REG_DATA_INI	0x028
 #define PCM_PWR_IO_EN		0x02c
 #define PCM_TIMER_VAL		0x030
+#define PCM_WDT_VAL		0x034
 #define PCM_EVENT_VECTOR0	0x040
 #define SPM_SW_INT_CLEAR	0x094
 #define SPM_SCP_MAILBOX		0x098
@@ -142,7 +143,7 @@ static const u8 sodi_fw_sha256[SHA256_DIGEST_SIZE] = {
 #define EN_IM_SLEEP_DVS		BIT(3)
 #define PCM_SW_RESET		BIT(15)
 #define PCM_TIMER_EN		BIT(5)
-#define PCM_WDT_BITS		(BIT(9) | BIT(8))
+#define PCM_WDT_BITS		(BIT(9) | BIT(8))	/* WDT_WAKE_MODE, WDT_EN */
 /* event lock, SRAM isolation and sleep, non-replace IM, MIF and SCP APB */
 #define PCM_CON1_INIT		0x5c48
 #define PCM_FSM_STA_DEF		0x48490
@@ -175,6 +176,10 @@ static const u8 sodi_fw_sha256[SHA256_DIGEST_SIZE] = {
  */
 #define SODI_WAKE_SRC		0x0f57c5f5
 #define WAKE_APXGPT		BIT(4)
+/* The PCM watchdog, in wake mode, ends the period instead of resetting */
+#define WAKE_PCM_WDT		BIT(13)
+/* The PCM watchdog's margin past the PCM timer: 2 s at 32,768 Hz */
+#define SODI_PCM_WDT_MARGIN	65536
 
 /*
  * SYS_CIRQ records edge interrupts while the GIC is masked and wakes the
@@ -224,6 +229,10 @@ static bool sodi_no_event;
 module_param(sodi_no_event, bool, 0644);
 MODULE_PARM_DESC(sodi_no_event, "SODI: set SODI_NO_EVENT, so no resource handler runs");
 
+static bool sodi_pcm_wdt;
+module_param(sodi_pcm_wdt, bool, 0644);
+MODULE_PARM_DESC(sodi_pcm_wdt, "SODI: the PCM watchdog ends a stuck test period 2 s late");
+
 /* The I2C controller the programs reset (I2C6: the CPU bucks) */
 #define I2C6_PHYS		0x1100e000
 
@@ -293,6 +302,7 @@ struct spm_scen {
 	bool slots;		/* load the PMIC wrapper's suspend phase */
 	bool cirq;		/* clone edge interrupts into SYS_CIRQ */
 	bool idle;		/* from cpuidle: own the SPM's GIC enable, RCU idle */
+	bool pcm_wdt;		/* the PCM watchdog wakes the program (D5p) */
 	bool ready;
 };
 
@@ -772,7 +782,7 @@ static void spm_cirq_disable(void)
  */
 static int spm_run(const struct spm_scen *sc)
 {
-	u32 con0, con1, settle, axi[3], v;
+	u32 con0, con1, settle, axi[3], v, wdt_val = 0;
 	u64 cntp_cval = 0, cntp_ctl = 0;
 	int i;
 
@@ -877,7 +887,13 @@ static int spm_run(const struct spm_scen *sc)
 
 	/* S15-S17: wake timer, wake sources, interrupt mask */
 	spm_wr(PCM_TIMER_VAL, sc->ticks);
-	spm_wr(PCM_CON1, spm_rd(PCM_CON1) | SPM_KEY | PCM_TIMER_EN);
+	v = PCM_TIMER_EN;
+	if (sc->pcm_wdt) {
+		wdt_val = spm_rd(PCM_WDT_VAL);
+		spm_wr(PCM_WDT_VAL, sc->ticks + SODI_PCM_WDT_MARGIN);
+		v |= PCM_WDT_BITS;
+	}
+	spm_wr(PCM_CON1, spm_rd(PCM_CON1) | SPM_KEY | v);
 	spm_wr(SPM_WAKEUP_EVENT_MASK, ~sc->wake_src);
 	v = spm_rd(SPM_IRQ_MASK) & BIT(2);
 	spm_wr(SPM_IRQ_MASK, v | ISRM_RET_IRQ_AUX);
@@ -989,6 +1005,10 @@ static int spm_run(const struct spm_scen *sc)
 
 	/* X3, X4 (wrapper slots): back to the state before entry */
 	spm_restore();
+	if (sc->pcm_wdt) {
+		spm_wr(PCM_CON1, SPM_KEY | (spm_rd(PCM_CON1) & ~PCM_WDT_BITS) | con1);
+		spm_wr(PCM_WDT_VAL, wdt_val);
+	}
 	spm_gates_restore();
 
 	/* C3 */
@@ -1166,6 +1186,9 @@ static int sodi_once(u64 ms)
 	s.sodi.flags = (s.flags & ~BIT(7)) | BIT(3) | SODI_FLAG_CG_MODE;
 	if (READ_ONCE(sodi_no_event))
 		s.sodi.flags |= SODI_FLAG_NO_EVENT;
+	s.sodi.pcm_wdt = READ_ONCE(sodi_pcm_wdt);
+	if (s.sodi.pcm_wdt)
+		s.sodi.wake_src |= WAKE_PCM_WDT;
 	if (sodi_pdn)
 		s.sodi.flags &= ~SODI_FLAG_CG_MODE;
 
-- 
2.43.0

