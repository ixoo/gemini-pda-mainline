new file mode 100644
index 000000000..c2c5e50ba
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6797-seninf.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6797-seninf.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 sensor interface
+
+maintainers:
+  - Gemini PDA Mainline Project
+
+description:
+  The sensor interface holds the SoC's CSI-2 receivers and the timing
+  generators that drive the master clock pads CMMCLK0 to CMMCLK3.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-seninf
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: CAMSYS register clock
+      - description: SENINF clock
+      - description: CAMTG clock, the source of the master clocks
+
+  clock-names:
+    items:
+      - const: camsys
+      - const: seninf
+      - const: camtg
+
+  power-domains:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+    description: The master clock pad, 0 to 3.
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - power-domains
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt6797-clk.h>
+    #include <dt-bindings/power/mt6797-power.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        seninf: seninf@1a040000 {
+            compatible = "mediatek,mt6797-seninf";
+            reg = <0 0x1a040000 0 0x4000>;
+            clocks = <&camsys CLK_CAM_CAMSYS>,
+                     <&camsys CLK_CAM_SENINF>,
+                     <&camsys CLK_CAM_CAMTG>;
+            clock-names = "camsys", "seninf", "camtg";
+            power-domains = <&scpsys MT6797_POWER_DOMAIN_ISP>;
+            #clock-cells = <1>;
+        };
+    };
