From 8bda6e6e9adba0d0ad6a7c5db18f5989435941cd Mon Sep 17 00:00:00 2001
From: Gemini PDA experiment <experiment.invalid>
Date: Mon, 28 Sep 2026 21:44:35 -0400
Subject: [PATCH] soc: mediatek: probe bounded MT6797 WLAN firmware start

After the observed EMI copy and seal, use the bounded HIF
CONFIG/ACK/PDA and START implementation for the retained image.
Admit only a fresh driver-owned INIT phase, retain resources after
uncertain effects, and report readiness without a network interface
or radio commands.
---
 .../soc/mediatek/mediatek,mt6797-consys.yaml  |  15 ++
 .../boot/dts/mediatek/mt6797-gemini-pda.dts   |   1 +
 .../mediatek/mt6797/firmware-prepare.c        |  71 ++++++++
 .../mediatek/mt6797/firmware-prepare.h        |  18 ++
 drivers/soc/mediatek/mt6797-consys.c          | 170 +++++++++++++++++-
 5 files changed, 269 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
index 9870169..30e9a0c 100644
--- a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6797-consys.yaml
@@ -101,6 +101,15 @@ properties:
       then request the final policy. Retain all effects until reboot; do not
       start firmware or use DMA.
 
+  mediatek,one-shot-firmware-start-probe:
+    type: boolean
+    description: |
+      After a successful two-section EMI copy and final policy readback,
+      claim driver ownership, submit both ordinary sections by bounded PIO
+      CONFIG/ACK/PDA, and make one WIFI_START request with a finite ready
+      observation. Retain all resources until reboot. No packet DMA, scan,
+      calibration, association or network interface is enabled.
+
   wifi:
     type: object
     description: Passive WLAN firmware client populated after CONSYS binds.
@@ -196,6 +205,12 @@ allOf:
     then:
       required:
         - mediatek,one-shot-emi-set-probe
+  - if:
+      required:
+        - mediatek,one-shot-firmware-start-probe
+    then:
+      required:
+        - mediatek,one-shot-emi-copy-probe
 
 examples:
   - |
diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
index 919f979..3f26381 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -89,6 +89,7 @@
 		mediatek,one-shot-hif-probe;
 		mediatek,one-shot-emi-set-probe;
 		mediatek,one-shot-emi-copy-probe;
+		mediatek,one-shot-firmware-start-probe;
 		memory-region = <&consys_reserved>;
 		vcn18-supply = <&mt6351_vcn18_reg>;
 		vcn28-supply = <&mt6351_vcn28_reg>;
diff --git a/drivers/net/wireless/mediatek/mt6797/firmware-prepare.c b/drivers/net/wireless/mediatek/mt6797/firmware-prepare.c
index 5cefb10..4463c05 100644
--- a/drivers/net/wireless/mediatek/mt6797/firmware-prepare.c
+++ b/drivers/net/wireless/mediatek/mt6797/firmware-prepare.c
@@ -3,9 +3,14 @@
 
 #include <linux/errno.h>
 #include <linux/firmware.h>
+#include <linux/bits.h>
+#include <linux/ktime.h>
 #include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
 
 #include "firmware-prepare.h"
+#include "hif.h"
 
 struct mt6797_wlan_firmware {
 	const struct firmware *blob;
@@ -107,6 +112,72 @@ int mt6797_wlan_firmware_copy_emi(const struct mt6797_wlan_firmware *image,
 	return 0;
 }
 
+int mt6797_wlan_firmware_submit_ordinary(const struct mt6797_wlan_firmware *image,
+					 struct mt6797_hif *hif,
+					 struct mt6797_wlan_ordinary_result *result)
+{
+	struct mt6797_hif_section_result submitted;
+	struct mt6797_hif_section_request request;
+	struct mtke_view section;
+	u8 config[20];
+	unsigned int i;
+	u32 mode;
+	int ret;
+
+	if (!image || !image->plan.valid || !hif || !result ||
+	    image->plan.sections != 4 || image->plan.ordinary_sections != 2)
+		return -EINVAL;
+	*result = (struct mt6797_wlan_ordinary_result){ .failed_index = 2 };
+	for (i = 0; i < image->plan.sections; i++) {
+		ret = mtke_get(&image->plan.image, i, &section);
+		if (ret)
+			return -EINVAL;
+		if (section.emi)
+			continue;
+		if (i >= 2 || !section.length || section.encrypted > 1 ||
+		    section.key_index > 3)
+			return -EINVAL;
+		mode = BIT(31) | (i == 0 ? BIT(3) : 0);
+		if (section.encrypted)
+			mode |= BIT(0) | (section.key_index << 1);
+		memset(config, 0, sizeof(config));
+		put_unaligned_le16(sizeof(config), config);
+		put_unaligned_le16(0x8000, config + 2);
+		config[4] = 1;
+		config[5] = 0xa0;
+		config[7] = i + 1;
+		put_unaligned_le32(section.destination, config + 8);
+		put_unaligned_le32(section.length, config + 12);
+		put_unaligned_le32(mode, config + 16);
+		request = (struct mt6797_hif_section_request) {
+			.kind = MT6797_SECTION_ORDINARY,
+			.config = config,
+			.config_bytes = sizeof(config),
+			.sequence = i + 1,
+			.data = section.data,
+			.length = section.length,
+		};
+		result->failed_index = i;
+		ret = mt6797_hif_download_section(hif, &request,
+						  ktime_get_ns() + NSEC_PER_SEC,
+						  &submitted);
+		result->firmware_status = submitted.firmware_status;
+		result->partial_submitted = submitted.submitted;
+		if (ret)
+			return ret;
+		if (submitted.submitted != section.length)
+			return -EIO;
+		result->sections++;
+		result->bytes += section.length;
+		result->partial_submitted = 0;
+	}
+	result->failed_index = 2;
+	if (result->sections != image->plan.ordinary_sections ||
+	    result->bytes != image->plan.ordinary_bytes)
+		return -EIO;
+	return 0;
+}
+
 void mt6797_wlan_firmware_release(struct mt6797_wlan_firmware *image)
 {
 	if (!image)
diff --git a/drivers/net/wireless/mediatek/mt6797/firmware-prepare.h b/drivers/net/wireless/mediatek/mt6797/firmware-prepare.h
index 2c1270d..0ffaa98 100644
--- a/drivers/net/wireless/mediatek/mt6797/firmware-prepare.h
+++ b/drivers/net/wireless/mediatek/mt6797/firmware-prepare.h
@@ -23,6 +23,16 @@ struct mt6797_wlan_emi_copy_result {
 	size_t bytes;
 };
 
+struct mt6797_wlan_ordinary_result {
+	unsigned int sections;
+	size_t bytes;
+	unsigned int failed_index;
+	unsigned int firmware_status;
+	size_t partial_submitted;
+};
+
+struct mt6797_hif;
+
 /* Preparation alone is passive. The returned object owns immutable firmware
  * bytes and its complete plan until release. No hardware admission or
  * executable section view is exposed by preparation. An effectful caller
@@ -45,6 +55,14 @@ int mt6797_wlan_firmware_copy_emi(const struct mt6797_wlan_firmware *image,
 					      u32 offset, const u8 *data, size_t bytes),
 				  void *owner,
 				  struct mt6797_wlan_emi_copy_result *result);
+/* Submit exactly the two validated ordinary sections through the owned HIF.
+ * Every CONFIG and PDA action may be partial; failure poisons the transaction.
+ * Success reports submission only, not firmware execution or permission to
+ * release the image, HIF or shared CONSYS resources.
+ */
+int mt6797_wlan_firmware_submit_ordinary(const struct mt6797_wlan_firmware *image,
+					 struct mt6797_hif *hif,
+					 struct mt6797_wlan_ordinary_result *result);
 void mt6797_wlan_firmware_release(struct mt6797_wlan_firmware *image);
 
 #endif
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index 87a2699..fa1f3bd 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -8,6 +8,7 @@
 #include <linux/io.h>
 #include <linux/ioport.h>
 #include <linux/kernel.h>
+#include <linux/ktime.h>
 #include <linux/limits.h>
 #include <linux/mutex.h>
 #include <linux/mfd/mt6351/registers.h>
@@ -26,6 +27,7 @@
 #include <dt-bindings/power/mt6797-power.h>
 
 #include "../../net/wireless/mediatek/mt6797/firmware-prepare.h"
+#include "../../net/wireless/mediatek/mt6797/hif.h"
 
 #define MT6797_CONSYS_REMAP_REG	0x10001340
 #define MT6797_CONSYS_SLEEP_MASK_REG	0x10001350
@@ -43,6 +45,11 @@
 #define MT6797_HIF_CCCR_IORX	0x0003
 #define MT6797_HIF_WIFI_FUNCTION	BIT(1)
 #define MT6797_HIF_WCIR_ID	0x0279
+#define MT6797_HIF_WHLPCR	0x0004
+#define MT6797_HIF_WRPLR	0x0090
+#define MT6797_HIF_DRIVER_OWN	BIT(8)
+#define MT6797_HIF_DRIVER_OWN_REQUEST	BIT(9)
+#define MT6797_HIF_WLAN_READY	BIT(21)
 #define MT6797_EMI_MPU_READ	0x82000208
 #define MT6797_EMI_MPU_SET	0x82000209
 #define MT6797_EMI_REGION18	18U
@@ -79,6 +86,9 @@ struct mt6797_consys {
 	bool emi_set_attempted;
 	bool emi_sealed;
 	bool emi_copy_attempted;
+	struct mt6797_init_transaction fw_transaction;
+	struct mt6797_hif *fw_hif;
+	bool fw_start_attempted;
 };
 
 static DEFINE_MUTEX(mt6797_consys_lock);
@@ -522,6 +532,138 @@ stopped:
 	return false;
 }
 
+#if IS_ENABLED(CONFIG_MT6797_HIF_CORE)
+/* These function-1 CMD53 accesses share the owner's serial setup/data pair. */
+static u32 mt6797_consys_hif_f1_read(struct mt6797_consys *owner, u32 reg)
+{
+	writel(BIT(28) | (reg << 9) | 4, owner->hif + MT6797_HIF_CMD_SETUP);
+	return readl(owner->hif + MT6797_HIF_CMD53_DATA);
+}
+
+static void mt6797_consys_hif_f1_write(struct mt6797_consys *owner,
+					      u32 reg, u32 value)
+{
+	writel(BIT(31) | BIT(28) | (reg << 9) | 4,
+	       owner->hif + MT6797_HIF_CMD_SETUP);
+	writel(value, owner->hif + MT6797_HIF_CMD53_DATA);
+}
+
+/* No IRQ consumer or competing HIF driver is registered in this one-shot boot. */
+static void mt6797_consys_probe_firmware_start(struct device *dev,
+					       struct mt6797_consys *owner)
+{
+	static const u8 start[16] = {
+		16, 0, 0, 0x80, 2, 0xa0, 0, 3,
+	};
+	struct mt6797_wlan_ordinary_result ordinary = {};
+	u64 deadline;
+	u32 whlpcr, wrplr, wcir = 0;
+	unsigned int i;
+	bool own_requested = false;
+	int ret;
+
+	ret = mtk_pm_domain_confirmed_on(owner->conn_domain);
+	if (ret)
+		goto stopped;
+	ret = reset_control_status(owner->conmcu_reset);
+	if (ret != 0) {
+		ret = ret < 0 ? ret : -EIO;
+		goto stopped;
+	}
+	if (!owner->emi_sealed || !owner->emi_window || !owner->wlan_image ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION18_POLICY) !=
+	    MT6797_EMI_FINAL_POLICY) {
+		ret = -EINVAL;
+		goto stopped;
+	}
+	whlpcr = mt6797_consys_hif_f1_read(owner, MT6797_HIF_WHLPCR);
+	dev_info(dev, "one-shot WLAN HIF ownership before: WHLPCR=0x%08x\n",
+		 whlpcr);
+	if (!(whlpcr & MT6797_HIF_DRIVER_OWN)) {
+		own_requested = true;
+		mt6797_consys_hif_f1_write(owner, MT6797_HIF_WHLPCR,
+					  MT6797_HIF_DRIVER_OWN_REQUEST);
+		for (i = 0; i < 2048; i++) {
+			usleep_range(1000, 1500);
+			whlpcr = mt6797_consys_hif_f1_read(owner,
+							 MT6797_HIF_WHLPCR);
+			if (whlpcr & MT6797_HIF_DRIVER_OWN)
+				break;
+		}
+	}
+	dev_info(dev,
+		 "one-shot WLAN HIF ownership after: WHLPCR=0x%08x requested=%d\n",
+		 whlpcr, own_requested);
+	if (!(whlpcr & MT6797_HIF_DRIVER_OWN)) {
+		ret = -ETIMEDOUT;
+		goto stopped;
+	}
+	wrplr = mt6797_consys_hif_f1_read(owner, MT6797_HIF_WRPLR);
+	wcir = mt6797_consys_hif_f1_read(owner, 0);
+	dev_info(dev,
+		 "one-shot WLAN INIT before: WRPLR=0x%08x WCIR=0x%08x\n",
+		 wrplr, wcir);
+	if (wrplr || (wcir & 0xffff) != MT6797_HIF_WCIR_ID ||
+	    (wcir & MT6797_HIF_WLAN_READY)) {
+		ret = -EBUSY;
+		goto stopped;
+	}
+	/* This is the first INIT transaction after function enable in this boot. */
+	owner->fw_transaction.free_pages = 104;
+	owner->fw_transaction.start_free_pages = 104;
+	owner->fw_hif = mt6797_hif_alloc(owner->hif,
+					  MT6797_CONSYS_HIF_SIZE,
+					  &owner->fw_transaction);
+	if (IS_ERR(owner->fw_hif)) {
+		ret = PTR_ERR(owner->fw_hif);
+		owner->fw_hif = NULL;
+		goto stopped;
+	}
+	ret = mt6797_wlan_firmware_submit_ordinary(owner->wlan_image,
+						 owner->fw_hif, &ordinary);
+	dev_info(dev,
+		 "one-shot WLAN ordinary transfer: status=%d completed=%u/2 bytes=%zu/14832 failed_index=%u firmware_status=%u partial=%zu\n",
+		 ret, ordinary.sections, ordinary.bytes, ordinary.failed_index,
+		 ordinary.firmware_status, ordinary.partial_submitted);
+	if (ret)
+		goto stopped;
+	ret = mt6797_hif_read32(owner->fw_hif, 0,
+				ktime_get_ns() + NSEC_PER_SEC, &wcir);
+	if (ret || (wcir & MT6797_HIF_WLAN_READY) ||
+	    (wcir & 0xffff) != MT6797_HIF_WCIR_ID ||
+	    mt6797_consys_read_emi(MT6797_EMI_REGION18_POLICY) !=
+	    MT6797_EMI_FINAL_POLICY) {
+		ret = ret ?: -EIO;
+		goto stopped;
+	}
+	owner->fw_start_attempted = true;
+	deadline = ktime_get_ns() + NSEC_PER_SEC;
+	ret = mt6797_hif_start_submit(owner->fw_hif, start, sizeof(start), 3,
+					     deadline);
+	dev_info(dev, "one-shot WLAN START submit: status=%d\n", ret);
+	if (ret)
+		goto stopped;
+	do {
+		ret = mt6797_hif_start_observe_ready(owner->fw_hif, &wcir);
+		if (ret == -EAGAIN)
+			usleep_range(10000, 12000);
+	} while (ret == -EAGAIN);
+	dev_info(dev, "one-shot WLAN START ready: status=%d WCIR=0x%08x\n",
+		 ret, wcir);
+	if (ret || (wcir & 0xffff) != MT6797_HIF_WCIR_ID) {
+		ret = ret ?: -ENODEV;
+		goto stopped;
+	}
+	dev_info(dev, "one-shot WLAN firmware ready; radio commands and DMA held\n");
+	return;
+
+stopped:
+	dev_err(dev,
+		"one-shot WLAN firmware stopped (%d); ordinary=%u/2 start=%d, state retained\n",
+		ret, ordinary.sections, owner->fw_start_attempted);
+}
+#endif
+
 /* One diagnostic SMC pair; retain the reserved window and powered owner. */
 #if IS_ENABLED(CONFIG_MT6797_HIF_CORE)
 static int mt6797_consys_copy_emi_section(void *context, unsigned int index,
@@ -554,7 +696,7 @@ static int mt6797_consys_copy_emi_section(void *context, unsigned int index,
 
 static void mt6797_consys_probe_emi_set(struct device *dev,
 					struct mt6797_consys *owner,
-					bool copy_probe)
+					bool copy_probe, bool firmware_start_probe)
 {
 	struct arm_smccc_res res;
 	struct mt6797_wlan_firmware_summary summary;
@@ -674,8 +816,15 @@ seal:
 	}
 	owner->emi_sealed = true;
 	dev_info(dev,
-		 "one-shot EMI region 18 sealed; copy=%d, firmware start and DMA held\n",
+		 "one-shot EMI region 18 sealed; copy=%d, firmware start gated and DMA held\n",
 		 copy_probe);
+#if IS_ENABLED(CONFIG_MT6797_HIF_CORE)
+	if (firmware_start_probe)
+		mt6797_consys_probe_firmware_start(dev, owner);
+#else
+	if (firmware_start_probe)
+		dev_err(dev, "one-shot WLAN firmware unavailable: HIF core disabled\n");
+#endif
 	return;
 
 stopped:
@@ -699,7 +848,8 @@ stopped:
 static void mt6797_consys_probe_power_on(struct device *dev, struct mt6797_consys *owner,
 					 bool chip_id_probe, bool reset_release_probe,
 					 bool hif_probe, bool emi_set_probe,
-					 bool emi_copy_probe)
+					 bool emi_copy_probe,
+					 bool firmware_start_probe)
 {
 	struct regmap *pmic;
 	unsigned int vcn28;
@@ -860,7 +1010,8 @@ static void mt6797_consys_probe_power_on(struct device *dev, struct mt6797_consy
 				    mt6797_consys_probe_hif(dev, owner) &&
 				    emi_set_probe)
 					mt6797_consys_probe_emi_set(dev, owner,
-							     emi_copy_probe);
+								     emi_copy_probe,
+								     firmware_start_probe);
 			}
 			else if (reset_release_probe)
 				dev_err(dev, "one-shot CONN MCU reset release skipped: EMI gate\n");
@@ -884,7 +1035,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 	void __iomem *sleep_mask = NULL, *chip_id = NULL, *mcu_acr = NULL;
 	void __iomem *hif = NULL, *emi_selector = NULL;
 	bool power_probe, chip_id_probe, reset_release_probe, hif_probe;
-	bool emi_set_probe, emi_copy_probe;
+	bool emi_set_probe, emi_copy_probe, firmware_start_probe;
 	struct resource reservation = {};
 	int ret;
 
@@ -901,6 +1052,8 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 					      "mediatek,one-shot-emi-set-probe");
 	emi_copy_probe = of_property_read_bool(pdev->dev.of_node,
 					       "mediatek,one-shot-emi-copy-probe");
+	firmware_start_probe = of_property_read_bool(pdev->dev.of_node,
+						   "mediatek,one-shot-firmware-start-probe");
 	if (chip_id_probe && !power_probe) {
 		ret = -EINVAL;
 		goto out_unlock;
@@ -921,6 +1074,11 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 		ret = -EINVAL;
 		goto out_unlock;
 	}
+	if (firmware_start_probe &&
+	    (!emi_copy_probe || !IS_ENABLED(CONFIG_MT6797_HIF_CORE))) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
 	if (mt6797_consys.bound) {
 		ret = -EBUSY;
 		goto out_unlock;
@@ -1083,7 +1241,7 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 		mt6797_consys_probe_power_on(&pdev->dev, &mt6797_consys,
 					    chip_id_probe, reset_release_probe,
 					    hif_probe, emi_set_probe,
-					    emi_copy_probe);
+					    emi_copy_probe, firmware_start_probe);
 out_unlock:
 	mutex_unlock(&mt6797_consys_lock);
 	return ret;
-- 
