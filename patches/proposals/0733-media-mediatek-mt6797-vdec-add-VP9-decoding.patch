+	u32 inter_mode[7][4];
+	u32 y_mode[4][12];
+	u32 uv_mode[10][10];
+	u32 partition[16][4];
+	u32 interp[4][4];
+	u32 tx8[2][2];
+	u32 tx16[2][4];
+	u32 tx32[2][4];
+	u32 skip[3][4];
+	u32 joint[4];
+	struct {
+		u32 sign[2];
+		u32 class0[2];
