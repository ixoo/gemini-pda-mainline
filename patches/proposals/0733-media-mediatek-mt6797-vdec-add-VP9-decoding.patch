 	depends on VIDEO_DEV && OF && PM
 	select MEDIA_CONTROLLER
 	select V4L2_H264
+	select V4L2_VP9
 	select VIDEOBUF2_DMA_CONTIG
 	select V4L2_MEM2MEM_DEV
 	help
-	  Prototype V4L2 stateless HEVC and H.264 decoder for the MT6797
+	  Prototype V4L2 stateless HEVC, H.264 and VP9 decoder for the MT6797
 	  video decoder block. It programs the decoder registers from the CPU
-	  for every picture, decoding 8-bit 4:2:0 HEVC Main and progressive
-	  H.264 Baseline, Main and High slices submitted through the request
