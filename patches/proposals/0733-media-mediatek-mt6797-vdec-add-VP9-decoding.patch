 .../platform/mediatek/mt6797-vdec/Makefile    |    3 +-
 .../mediatek/mt6797-vdec/mt6797-vdec-core.c   |   76 +-
 .../mediatek/mt6797-vdec/mt6797-vdec-vp9.c    | 1221 +++++++++++++++++
 .../mediatek/mt6797-vdec/mt6797-vdec.h        |   49 +-
