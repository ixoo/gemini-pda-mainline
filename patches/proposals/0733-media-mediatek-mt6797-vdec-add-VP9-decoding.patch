diff --git a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c
index cb7facee0..57fe5c476 100644
--- a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c
+++ b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-core.c
@@ -4,9 +4,10 @@
  *
  * The VDEC has no firmware: the CPU programs its registers for every
  * picture. This driver exposes it as a stateless memory-to-memory decoder
- * (HEVC or H.264 slices in, MM21 frames out). Without an IOMMU on this platform the
- * decoder uses physical addresses, so LARB1's per-port MMU enable is cleared
- * after every power-up and buffers are allocated below 4 GiB.
+ * (HEVC or H.264 slices or VP9 frames in, MM21 frames out). Without an IOMMU
+ * on this platform the decoder uses physical addresses, so LARB1's per-port
+ * MMU enable is cleared after every power-up and buffers are allocated below
+ * 4 GiB.
  */
 
 #include <linux/delay.h>
@@ -30,7 +31,15 @@ static bool mvdec_is_h264(u32 fourcc)
 	return fourcc == V4L2_PIX_FMT_H264_SLICE;
 }
 
-/* HEVC frames are padded to 64x64 CTBs, H.264 frames to 16x32 tiles. */
+static bool mvdec_is_vp9(u32 fourcc)
+{
+	return fourcc == V4L2_PIX_FMT_VP9_FRAME;
+}
+
+/*
+ * HEVC frames are padded to 64x64 CTBs, VP9 frames to 64x64 superblocks and
+ * H.264 frames to 16x32 tiles.
+ */
 static void mvdec_fill_dst(struct v4l2_pix_format_mplane *pix, u32 codec)
 {
 	unsigned int w, h;
@@ -62,7 +71,7 @@ static void mvdec_clamp(struct v4l2_pix_format_mplane *pix)
 static void mvdec_fill_src(struct v4l2_pix_format_mplane *pix)
 {
 	mvdec_clamp(pix);
-	if (!mvdec_is_h264(pix->pixelformat))
+	if (!mvdec_is_h264(pix->pixelformat) && !mvdec_is_vp9(pix->pixelformat))
 		pix->pixelformat = V4L2_PIX_FMT_HEVC_SLICE;
 	pix->num_planes = 1;
 	pix->field = V4L2_FIELD_NONE;
@@ -86,6 +95,7 @@ static int mvdec_enum_fmt_out(struct file *file, void *priv,
 {
 	static const u32 fmts[] = {
 		V4L2_PIX_FMT_HEVC_SLICE, V4L2_PIX_FMT_H264_SLICE,
+		V4L2_PIX_FMT_VP9_FRAME,
 	};
 
 	if (f->index >= ARRAY_SIZE(fmts))
@@ -107,7 +117,8 @@ static int mvdec_enum_framesizes(struct file *file, void *priv,
 				 struct v4l2_frmsizeenum *fs)
 {
 	if (fs->index || (fs->pixel_format != V4L2_PIX_FMT_HEVC_SLICE &&
-			  fs->pixel_format != V4L2_PIX_FMT_H264_SLICE))
+			  fs->pixel_format != V4L2_PIX_FMT_H264_SLICE &&
+			  fs->pixel_format != V4L2_PIX_FMT_VP9_FRAME))
 		return -EINVAL;
 	fs->type = V4L2_FRMSIZE_TYPE_STEPWISE;
 	fs->stepwise.min_width = MVDEC_MIN_SIZE;
@@ -247,6 +258,11 @@ static const struct v4l2_ctrl_config mvdec_ctrls[] = {
 	  .min = V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN,
 	  .max = V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN,
 	  .def = V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN },
+	{ .id = V4L2_CID_STATELESS_VP9_FRAME },
+	{ .id = V4L2_CID_MPEG_VIDEO_VP9_PROFILE,
+	  .min = V4L2_MPEG_VIDEO_VP9_PROFILE_0,
+	  .max = V4L2_MPEG_VIDEO_VP9_PROFILE_0,
+	  .def = V4L2_MPEG_VIDEO_VP9_PROFILE_0 },
 };
 
 static int mvdec_init_ctrls(struct mvdec_ctx *ctx)
@@ -387,12 +403,18 @@ static int mvdec_start_streaming(struct vb2_queue *vq, unsigned int count)
 
 	memset(&ctx->hevc, 0, sizeof(ctx->hevc));
 	memset(&ctx->h264, 0, sizeof(ctx->h264));
-	/* One zeroed collocated-MV buffer per capture buffer. */
-	if (mvdec_is_h264(ctx->src_fmt.pixelformat))
+	memset(&ctx->vp9, 0, sizeof(ctx->vp9));
+	/*
+	 * One zeroed collocated-MV buffer per capture buffer. VP9 keeps a
+	 * single one, for the previous frame, in its working buffers.
+	 */
+	if (mvdec_is_vp9(ctx->src_fmt.pixelformat))
+		size = 0;
+	else if (mvdec_is_h264(ctx->src_fmt.pixelformat))
 		size = mvdec_h264_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height);
 	else
 		size = mvdec_hevc_mv_size(ctx->dst_fmt.width, ctx->dst_fmt.height);
-	for (i = 0; i < vb2_get_num_buffers(vq) && i < VIDEO_MAX_FRAME; i++) {
+	for (i = 0; size && i < vb2_get_num_buffers(vq) && i < VIDEO_MAX_FRAME; i++) {
 		ctx->mv[i].size = size;
 		ctx->mv[i].cpu = dma_alloc_coherent(ctx->dev->dev, size,
 						    &ctx->mv[i].dma, GFP_KERNEL);
@@ -401,8 +423,10 @@ static int mvdec_start_streaming(struct vb2_queue *vq, unsigned int count)
 			return -ENOMEM;
 		}
 	}
-	if (mvdec_is_h264(ctx->src_fmt.pixelformat)) {
-		int ret = mvdec_h264_start(ctx);
+	if (mvdec_is_h264(ctx->src_fmt.pixelformat) ||
+	    mvdec_is_vp9(ctx->src_fmt.pixelformat)) {
+		int ret = mvdec_is_vp9(ctx->src_fmt.pixelformat) ?
+			  mvdec_vp9_start(ctx) : mvdec_h264_start(ctx);
 
 		if (ret) {
 			mvdec_free_aux(ctx);
@@ -498,15 +522,19 @@ static void mvdec_device_run(void *priv)
 	struct mvdec_dev *vdev = ctx->dev;
 	struct vb2_v4l2_buffer *src, *dst;
 	bool h264 = mvdec_is_h264(ctx->src_fmt.pixelformat);
+	bool vp9 = mvdec_is_vp9(ctx->src_fmt.pixelformat);
 	struct mvdec_hevc_run run = {};
 	struct mvdec_h264_run run264 = {};
+	struct mvdec_vp9_run run_vp9 = {};
 	int ret;
 
 	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
 	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
 	v4l2_ctrl_request_setup(src->vb2_buf.req_obj.req, &ctx->hdl);
 
-	if (h264) {
+	if (vp9) {
+		run_vp9.frame = mvdec_ctrl(ctx, V4L2_CID_STATELESS_VP9_FRAME, NULL);
+	} else if (h264) {
 		run264.sps = mvdec_ctrl(ctx, V4L2_CID_STATELESS_H264_SPS, NULL);
 		run264.pps = mvdec_ctrl(ctx, V4L2_CID_STATELESS_H264_PPS, NULL);
 		run264.scaling = mvdec_ctrl(ctx,
@@ -541,7 +569,9 @@ static void mvdec_device_run(void *priv)
 	writel(0, vdev->larb + MVDEC_LARB_MMU_EN);
 
 	vdev->running = ctx;
-	if (h264)
+	if (vp9)
+		ret = mvdec_vp9_run(ctx, src, dst, &run_vp9);
+	else if (h264)
 		ret = mvdec_h264_run(ctx, src, dst, &run264);
 	else
 		ret = mvdec_hevc_run(ctx, src, dst, &run);
@@ -579,9 +609,14 @@ static irqreturn_t mvdec_irq(int irq, void *data)
 static irqreturn_t mvdec_irq_thread(int irq, void *data)
 {
 	struct mvdec_dev *vdev = data;
-
-	if (cancel_delayed_work(&vdev->watchdog))
-		mvdec_job_done(vdev, VB2_BUF_STATE_DONE);
+	enum vb2_buffer_state state = VB2_BUF_STATE_DONE;
+
+	if (!cancel_delayed_work(&vdev->watchdog))
+		return IRQ_HANDLED;
+	/* VP9 reads its probabilities and counts back before completion. */
+	if (vdev->running && mvdec_is_vp9(vdev->running->src_fmt.pixelformat))
+		state = mvdec_vp9_done(vdev->running);
+	mvdec_job_done(vdev, state);
 	return IRQ_HANDLED;
 }
 
@@ -606,11 +641,12 @@ static int mvdec_open(struct file *file)
 	struct mvdec_ctx *ctx;
 	int ret;
 
-	ctx = kzalloc_obj(*ctx);
+	/* Large: the VP9 probability contexts live here. */
+	ctx = kvzalloc_obj(*ctx);
 	if (!ctx)
 		return -ENOMEM;
 	if (mutex_lock_interruptible(&vdev->lock)) {
-		kfree(ctx);
+		kvfree(ctx);
 		return -ERESTARTSYS;
 	}
 	v4l2_fh_init(&ctx->fh, video_devdata(file));
@@ -639,7 +675,7 @@ static int mvdec_open(struct file *file)
 err_fh:
 	v4l2_fh_exit(&ctx->fh);
 	mutex_unlock(&vdev->lock);
-	kfree(ctx);
+	kvfree(ctx);
 	return ret;
 }
 
@@ -656,7 +692,7 @@ static int mvdec_release(struct file *file)
 	v4l2_ctrl_handler_free(&ctx->hdl);
 	mvdec_free_mv(ctx);
 	mvdec_free_aux(ctx);
-	kfree(ctx);
+	kvfree(ctx);
 	return 0;
 }
 
diff --git a/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-vp9.c b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-vp9.c
new file mode 100644
index 000000000..5518a8f72
--- /dev/null
+++ b/drivers/media/platform/mediatek/mt6797-vdec/mt6797-vdec-vp9.c
@@ -0,0 +1,1221 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MT6797 VDEC: VP9 register programming.
+ *
+ * The decoder has no firmware. For every frame the CPU resets the core,
+ * programs the frame header, segmentation, loop filter and dequantisation
+ * registers, the reference and output buffers and the tile layout, and loads
+ * the frame context into the probability SRAM. The V4L2 frame control stands
+ * in for the uncompressed header, so the bit reader starts on the compressed
+ * header. The hardware bool decoder parses that header and applies the
+ * forward probability updates to the SRAM itself; the CPU reads only tx_mode
+ * and reference_select through it. After the decode interrupt the CPU copies
+ * the updated probabilities and the symbol counts out by DMA, adapts the
+ * saved frame context and stores it (mvdec_vp9_done()).
+ *
+ * Supported: profile 0 (8-bit 4:2:0) frames, one per OUTPUT buffer and
+ * starting at its first byte (userspace splits superframes), with references
+ * of the frame's own size. A show_existing_frame needs no decode and never
+ * reaches the driver. Everything else is rejected with -EINVAL before the
+ * decoder starts.
+ *
+ * Register meanings come from reverse engineering. The sequence follows the
+ * vendor programming model but has not been compared with a hardware trace.
+ */
+
+#include <linux/bits.h>
+#include <linux/iopoll.h>
+#include <linux/minmax.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+#include <media/v4l2-vp9.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "mt6797-vdec.h"
+
+/* VP9 VLD: bit reader, bool decoder, header registers, probability SRAM */
+#define VVLD_PEEK		0x00	/* 32-bit window, no shift */
+#define VVLD_SHIFT(n)		(4 * (n))	/* shift n = 1..32 bits */
+#define VVLD_BOOL_BIT		0x84	/* one bool-coded bit */
+#define VVLD_BOOL_2BIT		0x88	/* two bool-coded bits */
+#define VVLD_ENABLE		0xa4
+#define VVLD_FRAME		0xa8
+#define VVLD_SEG_FEATURES	0xac
+#define VVLD_REFS		0xb0
+#define VVLD_TX_MODE		0xb4
+#define VVLD_START		0xb8
+#define VVLD_TILE_MODE		0xbc
+#define VVLD_TILES		0xc4
+#define VVLD_UPDATE		0xc8	/* forward update command */
+#define VVLD_UPDATE_DONE	0xcc
+#define VVLD_TILE_RESET		0x100
+#define VVLD_TILE_FIFO		0x104
+#define VVLD_BOOL_INIT		0x110
+#define VVLD_BOOL_READY		BIT(16)
+#define VVLD_BITS		0x138	/* bits consumed */
+#define VVLD_BITS_RESET		0x144
+#define VVLD_ERROR		0x15c
+#define VVLD_SRAM_A_ADDR	0x198	/* 16 bytes per line */
+#define VVLD_SRAM_A_DATA	0x19c
+#define VVLD_SRAM_B_ADDR	0x1a0	/* 4 bytes per line */
+#define VVLD_SRAM_B_DATA	0x1a4
+#define VVLD_SRAM_WRITE		BIT(16)
+#define VVLD_COUNT_CLEAR	0x1a8
+#define VVLD_DMA_SEL		0x1dc
+#define VVLD_DMA_ADDR		0x1e0
+#define VVLD_DMA_KICK		0x1e8
+#define VVLD_DMA_DONE		0x1ec
+#define VVLD_SEG_TREE0		0x1f0
+#define VVLD_SEG_TREE1		0x1f4
+#define VVLD_SEG_PRED		0x1f8
+
+/* VVLD_UPDATE commands: parse one group of forward updates into the SRAM. */
+#define UPD_TX			BIT(0)
+#define UPD_COEF		BIT(1)
+#define UPD_SKIP		BIT(2)
+#define UPD_INTER_MODE		BIT(3)
+#define UPD_INTERP		BIT(4)
+#define UPD_INTRA_INTER		BIT(5)
+#define UPD_COMP_INTER		BIT(6)
+#define UPD_SINGLE_REF		BIT(7)
+#define UPD_COMP_REF		BIT(8)
+#define UPD_Y_MODE		BIT(9)
+#define UPD_PARTITION		BIT(10)
+#define UPD_MV_INT		BIT(11)
+#define UPD_MV_FP		BIT(12)
+#define UPD_MV_HP		BIT(13)
+
+/* VVLD_DMA_SEL: tables the decoder can copy out after a frame */
+#define DMA_COUNTS		1
+#define DMA_PROBS		2
+
+#define VLD_FETCH		0x8c
+#define VLD_FETCH_STATUS	0xe8
+#define VLD_STATUS		0xf4
+#define VLD_CTRL		0x108
+
+/* Margin past the data that the bitstream window covers. */
+#define VP9_BS_MARGIN		0x200
+/* At most this many tiles are queued through VVLD_TILE_FIFO. */
+#define VP9_FIFO_TILES		8
+#define VP9_MAX_TILES		256
+
+#define VP9_PROB_SIZE		0xa00
+#define VP9_COUNT_SIZE		0x4000
+#define VP9_TILE_LIST_SIZE	0x1000
+#define VP9_COEF_LINE		20	/* SRAM bytes per tx, plane, ref and band */
+#define VP9_COEF_LINES		96
+
+/* Working buffers in ctx->aux[] */
+enum {
+	VP9_AUX_MV,			/* motion vectors, read and written */
+	VP9_AUX_TILE,			/* tile list when the FIFO is too short */
+	VP9_AUX_SEG,			/* segment ids, read and written */
+	VP9_AUX_PROB,			/* probability table image */
+	VP9_AUX_COUNT,			/* symbol counts */
+	VP9_AUX_NUM,
+};
+
+/*
+ * The probability table as the SRAM holds it and as DMA copies it out: the
+ * coefficient lines (16 bytes in the A half, 4 in the B half), then the A
+ * half of the other contexts from 0x780 and their B half from 0x980.
+ */
+struct vp9_field {
+	u16 img;		/* offset in the table image */
+	u16 ctx;		/* offset in struct v4l2_vp9_frame_context */
+	u8 rows;
+	u8 len;			/* bytes per row */
+	u8 stride;		/* image bytes per row */
+	bool tx_skip;		/* tx or skip probabilities */
+};
+
+#define VP9_FIELD(i, m, r, l, s, t) \
+	{ i, offsetof(struct v4l2_vp9_frame_context, m), r, l, s, t }
+
+static const struct vp9_field vp9_fields[] = {
+	VP9_FIELD(0x780, y_mode, 4, 9, 16, false),
+	VP9_FIELD(0x7c0, interp_filter, 4, 2, 16, false),
+	VP9_FIELD(0x820, comp_mode, 1, 5, 0, false),
+	VP9_FIELD(0x830, comp_ref, 1, 5, 0, false),
+	VP9_FIELD(0x840, single_ref, 1, 10, 0, false),
+	VP9_FIELD(0x850, mv.joint, 1, 3, 0, false),
+	VP9_FIELD(0x860, mv.sign[0], 1, 1, 0, false),
+	VP9_FIELD(0x861, mv.classes[0], 1, 10, 0, false),
+	VP9_FIELD(0x870, mv.sign[1], 1, 1, 0, false),
+	VP9_FIELD(0x871, mv.classes[1], 1, 10, 0, false),
+	VP9_FIELD(0x880, mv.class0_bit[0], 1, 1, 0, false),
+	VP9_FIELD(0x881, mv.bits[0], 1, 10, 0, false),
+	VP9_FIELD(0x890, mv.class0_bit[1], 1, 1, 0, false),
+	VP9_FIELD(0x891, mv.bits[1], 1, 10, 0, false),
+	VP9_FIELD(0x8a0, mv.class0_fr[0], 1, 6, 0, false),
+	VP9_FIELD(0x8a6, mv.fr[0], 1, 3, 0, false),
+	VP9_FIELD(0x8a9, mv.class0_hp[0], 1, 1, 0, false),
+	VP9_FIELD(0x8aa, mv.hp[0], 1, 1, 0, false),
+	VP9_FIELD(0x8b0, mv.class0_fr[1], 1, 6, 0, false),
+	VP9_FIELD(0x8b6, mv.fr[1], 1, 3, 0, false),
+	VP9_FIELD(0x8b9, mv.class0_hp[1], 1, 1, 0, false),
+	VP9_FIELD(0x8ba, mv.hp[1], 1, 1, 0, false),
+	VP9_FIELD(0x8c0, uv_mode, 10, 9, 16, false),
+	VP9_FIELD(0x980, partition, 16, 3, 4, false),
+	VP9_FIELD(0x9c0, inter_mode, 7, 3, 4, false),
+	VP9_FIELD(0x9dc, skip, 1, 3, 0, true),
+	VP9_FIELD(0x9e0, tx8, 2, 1, 4, true),
+	VP9_FIELD(0x9e8, tx16, 2, 2, 4, true),
+	VP9_FIELD(0x9f0, tx32, 2, 3, 4, true),
+	VP9_FIELD(0x9f8, is_inter, 1, 4, 0, false),
+};
+
+/* SRAM loads after the coefficient lines, in the vendor order. */
+struct vp9_sram_run {
+	u16 addr_reg;
+	u16 line;
+	u16 img;
+	u8 words;
+};
+
+static const struct vp9_sram_run vp9_sram_runs[] = {
+	{ VVLD_SRAM_A_ADDR, 0x1d0, 0x8c0, 40 },	/* uv_mode */
+	{ VVLD_SRAM_A_ADDR, 0x180, 0x780, 16 },	/* y_mode */
+	{ VVLD_SRAM_A_ADDR, 0x190, 0x7c0, 16 },	/* interp_filter */
+	{ VVLD_SRAM_B_ADDR, 0x060, 0x980, 16 },	/* partition */
+	{ VVLD_SRAM_B_ADDR, 0x07e, 0x9f8, 1 },	/* is_inter */
+	{ VVLD_SRAM_A_ADDR, 0x1a8, 0x820, 2 },	/* comp_mode */
+	{ VVLD_SRAM_A_ADDR, 0x1ac, 0x830, 2 },	/* comp_ref */
+	{ VVLD_SRAM_A_ADDR, 0x1b0, 0x840, 3 },	/* single_ref */
+	{ VVLD_SRAM_B_ADDR, 0x078, 0x9e0, 6 },	/* tx8, tx16, tx32 */
+	{ VVLD_SRAM_B_ADDR, 0x077, 0x9dc, 1 },	/* skip */
+	{ VVLD_SRAM_B_ADDR, 0x070, 0x9c0, 7 },	/* inter_mode */
+	{ VVLD_SRAM_A_ADDR, 0x1b4, 0x850, 1 },	/* mv joint */
+	{ VVLD_SRAM_A_ADDR, 0x1b8, 0x860, 24 },	/* mv components */
+};
