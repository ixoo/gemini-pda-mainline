+/* The receive callback fills the FIFO under the spinlock. */
+static void mt6797_fm_rds_reset(struct mt6797_fm *fm)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&fm->lock, flags);
+	kfifo_reset(&fm->rds);
+	spin_unlock_irqrestore(&fm->lock, flags);
+}
