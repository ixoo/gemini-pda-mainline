+static int mt6797_fm_open(struct file *file)
+{
+	struct mt6797_fm *fm = video_drvdata(file);
+	int ret;
+
+	mutex_lock(&fm->mutex);
+	ret = v4l2_fh_open(file);
+	if (!ret && v4l2_fh_is_singular_file(file)) {
+		ret = mt6797_fm_on(fm);
+		if (ret)
+			v4l2_fh_release(file);
+	}
+	mutex_unlock(&fm->mutex);
+	return ret;
+}
+
+static int mt6797_fm_release(struct file *file)
+{
+	struct mt6797_fm *fm = video_drvdata(file);
+
+	mutex_lock(&fm->mutex);
+	if (v4l2_fh_is_singular_file(file) && fm->powered)
+		mt6797_fm_off(fm);
+	v4l2_fh_release(file);
+	mutex_unlock(&fm->mutex);
+	return 0;
+}
