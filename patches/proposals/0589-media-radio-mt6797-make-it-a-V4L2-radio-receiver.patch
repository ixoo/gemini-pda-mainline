+/*
+ * An RDS event: sin and cos, then groups of blocks A to D, the corrected-bit
+ * count and the CRC flags, all 16 bit. A set flag means a good block.
+ */
+static void fm_rds(struct mt6797_fm *fm)
+{
+	static const u8 good[4] = { 0x08, 0x04, 0x02, 0x01 };
+	unsigned int n = min_t(unsigned int, fm->length, FM_EVENT_MAX);
+	unsigned int g, i;
+	bool any = false;
+
+	for (g = 4; g + 12 <= n; g += 12) {
+		u16 crc = fm->payload[g + 10] | fm->payload[g + 11] << 8;
+		u16 blk_b = fm->payload[g + 2] | fm->payload[g + 3] << 8;
+
+		for (i = 0; i < 4; i++) {
+			struct v4l2_rds_data d = {
+				.lsb = fm->payload[g + 2 * i],
+				.msb = fm->payload[g + 2 * i + 1],
+				.block = i,
+			};
+
+			/* Version B groups carry C' in the third block. */
+			if (i == 2 && (blk_b & BIT(11)))
+				d.block = V4L2_RDS_BLOCK_C_ALT;
+			if (!(crc & good[i]))
+				d.block |= V4L2_RDS_BLOCK_ERROR;
+			kfifo_put(&fm->rds, d);
+		}
+		any = true;
+	}
+	if (any) {
+		fm->rds_seen = jiffies;
+		wake_up_interruptible(&fm->rds_wait);
+	}
+}
