+static ssize_t mt6797_fm_read(struct file *file, char __user *buf, size_t count,
+			      loff_t *ppos)
+{
+	struct mt6797_fm *fm = video_drvdata(file);
+	unsigned int copied;
+	int ret;
+
+	count -= count % sizeof(struct v4l2_rds_data);
+	if (!count)
+		return 0;
+	if (mutex_lock_interruptible(&fm->mutex))
+		return -ERESTARTSYS;
+	while (kfifo_is_empty(&fm->rds)) {
+		mutex_unlock(&fm->mutex);
+		if (file->f_flags & O_NONBLOCK)
+			return -EWOULDBLOCK;
+		ret = wait_event_interruptible(fm->rds_wait, !kfifo_is_empty(&fm->rds));
+		if (ret)
+			return ret;
+		if (mutex_lock_interruptible(&fm->mutex))
