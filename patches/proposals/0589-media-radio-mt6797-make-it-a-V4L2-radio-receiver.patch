+/*
+ * Called with the mutex held, from an ioctl or from the power-up. Values are
+ * kept while off and applied by the next power-up.
+ */
+static int mt6797_fm_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct mt6797_fm *fm = container_of(ctrl->handler, struct mt6797_fm, ctrls);
+
+	if (!fm->powered)
+		return 0;
+	switch (ctrl->id) {
+	case V4L2_CID_AUDIO_MUTE:
+		return fm_set_bits(fm, FM_REG_MUTE, ctrl->val ? 0x0003 : 0x0000, 0xfffc);
+	case V4L2_CID_AUDIO_VOLUME:
+		return fm_reg_write(fm, FM_REG_VOLUME, fm_volume[ctrl->val]);
+	case V4L2_CID_TUNE_DEEMPHASIS:
+		return mt6797_fm_set_deemphasis(fm, ctrl->val);
+	}
+	return -EINVAL;
+}
