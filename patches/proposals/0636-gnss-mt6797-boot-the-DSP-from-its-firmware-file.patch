From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sat, 7 Nov 2026 08:11:00 -0500
Subject: [PATCH] gnss: mt6797: boot the DSP from its firmware file

Userspace has booted the DSP itself: it sent the boot header, then the
image in 1400-byte fragments, waiting for each acknowledgment. Move that
into the driver, so that the DSP image is loaded like other firmware and
no userspace program has to carry it.

The firmware file mediatek/mt6797/gnss_dsp_6797.bin holds the 106-byte
boot header followed by the image. Opening the device now loads it, sends
the header and fragments as frames on STP task 2, and waits for each
acknowledgment, with up to five tries and growing waits. Bytes after the
last acknowledgment, from the started DSP, go to userspace unparsed, as
before. Open fails if the boot does not complete.

The frames are those userspace sent before, sent in pieces of at most
1024 bytes, which is how the gnss core split them.
---
 drivers/gnss/Kconfig  |   6 +-
 drivers/gnss/mt6797.c | 279 ++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 273 insertions(+), 12 deletions(-)

diff --git a/drivers/gnss/Kconfig b/drivers/gnss/Kconfig
index 811d99bd2..ed2fd89b4 100644
--- a/drivers/gnss/Kconfig
+++ b/drivers/gnss/Kconfig
@@ -33,9 +33,9 @@ config GNSS_MT6797
 	tristate "MediaTek MT6797 CONSYS GNSS DSP support"
 	depends on MTK_MT6797_CONSYS
 	help
-	  Say Y here to carry the host protocol of the GNSS DSP inside the
-	  MT6797 connectivity subsystem over the shared STP link. Userspace
-	  loads the DSP image and computes positions.
+	  Say Y here to boot the GNSS DSP inside the MT6797 connectivity
+	  subsystem from its firmware file and carry its host protocol over
+	  the shared STP link. Userspace computes positions.
 
 	  To compile this driver as a module, choose M here: the module will
 	  be called gnss-mt6797.
diff --git a/drivers/gnss/mt6797.c b/drivers/gnss/mt6797.c
index cc10bfb0c..807eb9bed 100644
--- a/drivers/gnss/mt6797.c
+++ b/drivers/gnss/mt6797.c
@@ -2,39 +2,282 @@
 /*
  * MediaTek MT6797 CONSYS GNSS DSP.
  *
- * The DSP is reached through STP task 2 and speaks a binary host protocol. This
- * driver only carries it: userspace loads the DSP image, feeds the DSP each
- * second, and computes positions from its measurements. Opening the device
- * switches the WMT GPS function on, and closing it switches it off.
+ * The DSP is reached through STP task 2 and speaks a binary host protocol.
+ * Opening the device switches the WMT GPS function on and boots the DSP from
+ * its firmware file; closing it switches the function off. After the boot this
+ * driver only carries the protocol: userspace feeds the DSP each second and
+ * computes positions from its measurements.
  */
 
+#include <linux/completion.h>
 #include <linux/err.h>
 #include <linux/errno.h>
+#include <linux/firmware.h>
 #include <linux/gnss.h>
 #include <linux/gpio/consumer.h>
+#include <linux/jiffies.h>
+#include <linux/minmax.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/property.h>
+#include <linux/slab.h>
 #include <linux/soc/mediatek/mt6797-stp.h>
+#include <linux/spinlock.h>
+#include <linux/unaligned.h>
+
+#define MT6797_GNSS_FIRMWARE	"mediatek/mt6797/gnss_dsp_6797.bin"
+
+/*
+ * The firmware file is the boot header followed by the image. The header
+ * gives the image's size in 16-bit words at byte 14 and its fragment count
+ * at byte 22.
+ */
+#define MT6797_GNSS_HEADER_SIZE		106
+#define MT6797_GNSS_FRAGMENT_SIZE	1400
+
+#define MT6797_GNSS_ID_HEADER		0xfe08
+#define MT6797_GNSS_ID_FRAGMENT		0xfe0c
+#define MT6797_GNSS_ID_HEADER_ACK	0xfe31
+#define MT6797_GNSS_ID_FRAGMENT_ACK	0xfe32
+
+/* Each frame is AA F0, length, ID, payload, sum, AA 0F, with AA and DE escaped. */
+#define MT6797_GNSS_MARK		0xaa
+#define MT6797_GNSS_ESCAPE		0xde
+#define MT6797_GNSS_FRAME_MAX		(2 * (4 + 2 + MT6797_GNSS_FRAGMENT_SIZE + 2) + 4)
+/* Acknowledgements are short; longer frames are not parsed during the boot. */
+#define MT6797_GNSS_ACK_MAX		32
+/* The link has carried the boot in 1024-byte pieces since the gnss core split it. */
+#define MT6797_GNSS_SEND_MAX		1024
+#define MT6797_GNSS_TRIES		5
 
 struct mt6797_gnss {
 	struct device *dev;
 	struct gnss_device *gdev;
 	struct gpio_desc *lna;
+	u8 *frame;
+
+	/* Protects the boot state below against the receive callback. */
+	spinlock_t lock;
+	bool booting;
+	unsigned int wanted_id, wanted_seq, last_seq;
+	struct completion acked;
+
 	/* Written only by the link's receive callback between attach and detach. */
+	u8 ack[MT6797_GNSS_ACK_MAX];
+	unsigned int ack_length;
+	bool in_frame, escaped, marked;
 	unsigned int received, dropped;
 };
 
+/* Checks one unescaped frame against the acknowledgment being waited for. */
+static bool mt6797_gnss_is_wanted(struct mt6797_gnss *gnss)
+{
+	const u8 *f = gnss->ack;
+	unsigned int length, i;
+	u16 sum = 0;
+
+	if (gnss->ack_length < 8)
+		return false;
+	length = (get_unaligned_le16(f) & 0xfff) - 4;
+	if (gnss->ack_length != 4 + length + 2 || length < 2)
+		return false;
+	for (i = 0; i < 4 + length; i++)
+		sum += f[i];
+	return sum == get_unaligned_le16(f + 4 + length) &&
+	       get_unaligned_le16(f + 2) == gnss->wanted_id &&
+	       get_unaligned_le16(f + 4) == gnss->wanted_seq;
+}
+
+/* Parses boot bytes up to the last acknowledgment and returns how many it used. */
+static unsigned int mt6797_gnss_parse(struct mt6797_gnss *gnss, const u8 *data,
+				      unsigned int length)
+{
+	unsigned int i;
+
+	for (i = 0; i < length; i++) {
+		u8 c = data[i];
+
+		if (gnss->marked) {
+			gnss->marked = false;
+			if (c == 0xf0) {
+				gnss->in_frame = true;
+				gnss->escaped = false;
+				gnss->ack_length = 0;
+			} else if (c == 0x0f && gnss->in_frame) {
+				gnss->in_frame = false;
+				if (mt6797_gnss_is_wanted(gnss)) {
+					complete(&gnss->acked);
+					if (gnss->wanted_id == MT6797_GNSS_ID_FRAGMENT_ACK &&
+					    gnss->wanted_seq == gnss->last_seq) {
+						gnss->booting = false;
+						return i + 1;
+					}
+				}
+			}
+			continue;
+		}
+		if (c == MT6797_GNSS_MARK) {
+			gnss->marked = true;
+			continue;
+		}
+		if (!gnss->in_frame)
+			continue;
+		if (gnss->escaped) {
+			gnss->escaped = false;
+			c = c == 0xdf ? MT6797_GNSS_MARK : c == 0xe0 ? MT6797_GNSS_ESCAPE : c;
+		} else if (c == MT6797_GNSS_ESCAPE) {
+			gnss->escaped = true;
+			continue;
+		}
+		if (gnss->ack_length == MT6797_GNSS_ACK_MAX)
+			gnss->in_frame = false;
+		else
+			gnss->ack[gnss->ack_length++] = c;
+	}
+	return length;
+}
+
 /* Hard interrupt context, serialized by the link lock. */
 static int mt6797_gnss_receive(void *context, const u8 *payload, unsigned int length)
 {
 	struct mt6797_gnss *gnss = context;
+	unsigned int used = 0;
 
 	gnss->received += length;
-	gnss->dropped += length - gnss_insert_raw(gnss->gdev, payload, length);
+	spin_lock(&gnss->lock);
+	if (gnss->booting)
+		used = mt6797_gnss_parse(gnss, payload, length);
+	spin_unlock(&gnss->lock);
+	if (used < length)
+		gnss->dropped += length - used -
+				 gnss_insert_raw(gnss->gdev, payload + used, length - used);
+	return 0;
+}
+
+static unsigned int mt6797_gnss_put(u8 *out, const u8 *data, unsigned int length, u16 *sum)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < length; i++) {
+		*sum += data[i];
+		if (data[i] == MT6797_GNSS_MARK || data[i] == MT6797_GNSS_ESCAPE) {
+			out[n++] = MT6797_GNSS_ESCAPE;
+			out[n++] = data[i] == MT6797_GNSS_MARK ? 0xdf : 0xe0;
+		} else {
+			out[n++] = data[i];
+		}
+	}
+	return n;
+}
+
+static unsigned int mt6797_gnss_build(u8 *out, u16 id, const u8 *prefix,
+				      unsigned int prefix_length, const u8 *data,
+				      unsigned int length)
+{
+	u8 head[4], tail[2];
+	unsigned int n = 0;
+	u16 sum = 0;
+
+	put_unaligned_le16(4 + prefix_length + length, head);
+	put_unaligned_le16(id, head + 2);
+	out[n++] = MT6797_GNSS_MARK;
+	out[n++] = 0xf0;
+	n += mt6797_gnss_put(out + n, head, sizeof(head), &sum);
+	n += mt6797_gnss_put(out + n, prefix, prefix_length, &sum);
+	n += mt6797_gnss_put(out + n, data, length, &sum);
+	put_unaligned_le16(sum, tail);
+	n += mt6797_gnss_put(out + n, tail, sizeof(tail), &sum);
+	out[n++] = MT6797_GNSS_MARK;
+	out[n++] = 0x0f;
+	return n;
+}
+
+static int mt6797_gnss_send(const u8 *data, unsigned int length)
+{
+	unsigned int sent, n;
+	int ret;
+
+	for (sent = 0; sent < length; sent += n) {
+		n = min_t(unsigned int, length - sent, MT6797_GNSS_SEND_MAX);
+		ret = mt6797_consys_stp_send(MT6797_STP_TASK_GPS, data + sent, n);
+		if (ret)
+			return ret;
+	}
 	return 0;
 }
 
+/* Sends one boot frame and waits for its acknowledgment, retrying as libmnl does. */
+static int mt6797_gnss_send_acked(struct mt6797_gnss *gnss, unsigned int length,
+				  u16 ack_id, u16 seq)
+{
+	unsigned int wait = 200, try;
+	int ret;
+
+	spin_lock_irq(&gnss->lock);
+	gnss->wanted_id = ack_id;
+	gnss->wanted_seq = seq;
+	reinit_completion(&gnss->acked);
+	spin_unlock_irq(&gnss->lock);
+	for (try = 0; try < MT6797_GNSS_TRIES; try++, wait *= 2) {
+		ret = mt6797_gnss_send(gnss->frame, length);
+		if (ret)
+			return ret;
+		if (wait_for_completion_timeout(&gnss->acked, msecs_to_jiffies(wait)))
+			return 0;
+	}
+	return -ETIMEDOUT;
+}
+
+static int mt6797_gnss_boot(struct mt6797_gnss *gnss)
+{
+	const struct firmware *fw;
+	unsigned int count, i, n;
+	const u8 *image;
+	size_t size;
+	u8 seq[2];
+	int ret;
+
+	ret = request_firmware(&fw, MT6797_GNSS_FIRMWARE, gnss->dev);
+	if (ret)
+		return ret;
+	size = fw->size - min_t(size_t, fw->size, MT6797_GNSS_HEADER_SIZE);
+	count = DIV_ROUND_UP(size, MT6797_GNSS_FRAGMENT_SIZE);
+	if (!size || size != 2 * get_unaligned_le16(fw->data + 14) ||
+	    count != get_unaligned_le16(fw->data + 22)) {
+		dev_err(gnss->dev, "%s does not match its header\n", MT6797_GNSS_FIRMWARE);
+		ret = -EINVAL;
+		goto out;
+	}
+	image = fw->data + MT6797_GNSS_HEADER_SIZE;
+	spin_lock_irq(&gnss->lock);
+	gnss->last_seq = count;
+	spin_unlock_irq(&gnss->lock);
+
+	n = mt6797_gnss_build(gnss->frame, MT6797_GNSS_ID_HEADER, NULL, 0, fw->data,
+			      MT6797_GNSS_HEADER_SIZE);
+	ret = mt6797_gnss_send_acked(gnss, n, MT6797_GNSS_ID_HEADER_ACK, 0);
+	if (ret) {
+		dev_err(gnss->dev, "no answer to the boot header: %d\n", ret);
+		goto out;
+	}
+	for (i = 0; i < count; i++) {
+		unsigned int offset = i * MT6797_GNSS_FRAGMENT_SIZE;
+
+		put_unaligned_le16(i + 1, seq);
+		n = mt6797_gnss_build(gnss->frame, MT6797_GNSS_ID_FRAGMENT, seq, sizeof(seq),
+				      image + offset,
+				      min_t(size_t, size - offset, MT6797_GNSS_FRAGMENT_SIZE));
+		ret = mt6797_gnss_send_acked(gnss, n, MT6797_GNSS_ID_FRAGMENT_ACK, i + 1);
+		if (ret) {
+			dev_err(gnss->dev, "no acknowledgment for fragment %u: %d\n", i + 1, ret);
+			goto out;
+		}
+	}
+out:
+	release_firmware(fw);
+	return ret;
+}
+
 static int mt6797_gnss_open(struct gnss_device *gdev)
 {
 	struct mt6797_gnss *gnss = gnss_get_drvdata(gdev);
@@ -42,15 +285,27 @@ static int mt6797_gnss_open(struct gnss_device *gdev)
 
 	gnss->received = 0;
 	gnss->dropped = 0;
+	gnss->in_frame = false;
+	gnss->marked = false;
+	gnss->booting = true;
 	ret = mt6797_consys_stp_attach(MT6797_STP_TASK_GPS, mt6797_gnss_receive, gnss);
 	if (ret)
 		return ret;
 	gpiod_set_value_cansleep(gnss->lna, 1);
 	ret = mt6797_consys_gps_function(true);
-	if (ret) {
-		gpiod_set_value_cansleep(gnss->lna, 0);
-		mt6797_consys_stp_detach(MT6797_STP_TASK_GPS);
-	}
+	if (ret)
+		goto err_lna;
+	ret = mt6797_gnss_boot(gnss);
+	if (ret)
+		goto err_function;
+	/* The last acknowledgment ended the boot: later bytes go to userspace. */
+	return 0;
+
+err_function:
+	mt6797_consys_gps_function(false);
+err_lna:
+	gpiod_set_value_cansleep(gnss->lna, 0);
+	mt6797_consys_stp_detach(MT6797_STP_TASK_GPS);
 	return ret;
 }
 
@@ -87,6 +342,11 @@ static int mt6797_gnss_probe(struct platform_device *pdev)
 	gnss = devm_kzalloc(&pdev->dev, sizeof(*gnss), GFP_KERNEL);
 	if (!gnss)
 		return -ENOMEM;
+	gnss->frame = devm_kmalloc(&pdev->dev, MT6797_GNSS_FRAME_MAX, GFP_KERNEL);
+	if (!gnss->frame)
+		return -ENOMEM;
+	spin_lock_init(&gnss->lock);
+	init_completion(&gnss->acked);
 	/* The control is described on the CONSYS node, this device's parent. */
 	gnss->lna = devm_fwnode_gpiod_get(&pdev->dev, dev_fwnode(pdev->dev.parent), "gps-lna",
 					  GPIOD_OUT_LOW, "gps-lna");
@@ -130,3 +390,4 @@ module_platform_driver(mt6797_gnss_driver);
 MODULE_DESCRIPTION("MediaTek MT6797 CONSYS GNSS DSP");
 MODULE_LICENSE("GPL");
 MODULE_ALIAS("platform:mt6797-gnss");
+MODULE_FIRMWARE(MT6797_GNSS_FIRMWARE);
-- 
2.43.0

