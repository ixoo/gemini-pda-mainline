From 8d5454caf1ab89b32af7a8bd5af1df0829bac23b Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 2 Nov 2026 20:15:29 -0500
Subject: [PATCH] drm/panel: nt36672e: let the Gemini continue from the
 loader's panel state

The Gemini's loader initialises the panel and the vendor kernel inherits it
on a cold boot. Do the same by default: with adopt set the driver sends no
panel command, drives no reset line and enables no supply. This separates
pipeline bring-up from the panel's power and init sequence, so a failure in
one cannot look like the other.

Declare the mode clock that makes the DSI host ask for 880 Mbit/s per lane, the
rate the PLL word on a running panel reads. It was derived from a debug field
that gave 833 Mbit/s. Declare 8 bpc, so the pipeline's dither stays in relay.
Add an off-by-default parameter that logs read-only DCS registers, to identify
the panel on a named unit without writing to it.
---
 .../gpu/drm/panel/panel-novatek-nt36672e.c    | 74 +++++++++++++++----
 1 file changed, 61 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36672e.c b/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
index 202117fc9..b9fed9ea4 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
@@ -36,6 +36,7 @@ struct panel_desc {
 	unsigned int lanes;
 	const char *panel_name;
 	void (*init_sequence)(struct mipi_dsi_multi_context *ctx);
+	bool can_adopt;
 	unsigned int power_on_delay_ms;
 	unsigned int reset_high_delay_ms;
 	unsigned int reset_low_delay_ms;
@@ -52,8 +53,22 @@ struct nt36672e_panel {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data supplies[3];
 	const struct panel_desc *desc;
+	bool adopted;
 };
 
+/*
+ * The loader has already reset and initialised the Gemini panel, and the vendor
+ * kernel continues from that state on a cold boot too. Adopting it sends no
+ * panel command and touches no reset line or supply.
+ */
+static bool adopt = true;
+module_param(adopt, bool, 0444);
+MODULE_PARM_DESC(adopt, "Continue from the loader's Gemini panel state");
+
+static bool read_identity;
+module_param(read_identity, bool, 0444);
+MODULE_PARM_DESC(read_identity, "Log DCS reads when an adopted panel is prepared");
+
 #define NT36672E_DCS_SWITCH_PAGE	0xff
 
 #define nt36672e_switch_page(ctx, page) \
@@ -745,12 +760,34 @@ static int nt36672e_off(struct nt36672e_panel *panel)
 	return ctx.accum_err;
 }
 
+/* Log what the panel answers. Only reads, for identifying it on a named unit. */
+static void nt36672e_log_identity(struct nt36672e_panel *ctx)
+{
+	static const u8 regs[] = { 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0xda, 0xdb, 0xdc };
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		u8 val = 0;
+		ssize_t ret = mipi_dsi_dcs_read(dsi, regs[i], &val, 1);
+
+		dev_info(&dsi->dev, "DCS read 0x%02x: %zd bytes, 0x%02x\n",
+			 regs[i], ret, val);
+	}
+}
+
 static int nt36672e_panel_prepare(struct drm_panel *panel)
 {
 	struct nt36672e_panel *ctx = to_nt36672e_panel(panel);
 	struct mipi_dsi_device *dsi = ctx->dsi;
 	int ret;
 
+	if (ctx->adopted) {
+		if (read_identity)
+			nt36672e_log_identity(ctx);
+		return 0;
+	}
+
 	ret = nt36672e_power_on(ctx);
 	if (ret < 0)
 		return ret;
@@ -771,6 +808,9 @@ static int nt36672e_panel_unprepare(struct drm_panel *panel)
 	struct mipi_dsi_device *dsi = ctx->dsi;
 	int ret;
 
+	if (ctx->adopted)
+		return 0;
+
 	nt36672e_off(ctx);
 
 	ret = nt36672e_power_off(ctx);
@@ -822,7 +862,8 @@ static const char * const gemini_regulator_names[] = {
 
 static const struct drm_display_mode gemini_1080x2160_60hz = {
 	.name = "1080x2160",
-	.clock = 138839,
+	/* 880 Mbit/s on four lanes at 24 bpp, the PLL word read from a running panel. */
+	.clock = 146667,
 	.hdisplay = 1080,
 	.hsync_start = 1090,
 	.hsync_end = 1132,
@@ -847,6 +888,7 @@ static const struct panel_desc gemini_panel_desc = {
 	.lanes = 4,
 	.panel_name = "Gemini NT36672 1080x2160 panel",
 	.init_sequence = nt36672e_gemini_1080x2160_init,
+	.can_adopt = true,
 	.power_on_delay_ms = 20,
 	.reset_high_delay_ms = 10,
 	.reset_low_delay_ms = 10,
@@ -871,6 +913,8 @@ static int nt36672e_panel_get_modes(struct drm_panel *panel, struct drm_connecto
 	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
 	connector->display_info.width_mm = ctx->desc->width_mm;
 	connector->display_info.height_mm = ctx->desc->height_mm;
+	if (ctx->desc->can_adopt)
+		connector->display_info.bpc = 8;
 	drm_mode_probed_add(connector, mode);
 
 	return 1;
@@ -904,20 +948,24 @@ static int nt36672e_panel_probe(struct mipi_dsi_device *dsi)
 	    ctx->desc->num_supplies > ARRAY_SIZE(ctx->supplies))
 		return -EINVAL;
 
-	for (i = 0; i < ctx->desc->num_supplies; i++) {
-		ctx->supplies[i].supply = ctx->desc->supply_names[i];
-		ctx->supplies[i].init_load_uA = regulator_enable_loads[i];
+	ctx->adopted = adopt && ctx->desc->can_adopt;
+	if (!ctx->adopted) {
+		for (i = 0; i < ctx->desc->num_supplies; i++) {
+			ctx->supplies[i].supply = ctx->desc->supply_names[i];
+			ctx->supplies[i].init_load_uA = regulator_enable_loads[i];
+		}
+
+		ret = devm_regulator_bulk_get(dev, ctx->desc->num_supplies,
+					      ctx->supplies);
+		if (ret < 0)
+			return ret;
+
+		ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+		if (IS_ERR(ctx->reset_gpio))
+			return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+					     "Failed to get reset-gpios\n");
 	}
 
-	ret = devm_regulator_bulk_get(dev, ctx->desc->num_supplies,
-				      ctx->supplies);
-	if (ret < 0)
-		return ret;
-
-	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
-	if (IS_ERR(ctx->reset_gpio))
-		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "Failed to get reset-gpios\n");
-
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
