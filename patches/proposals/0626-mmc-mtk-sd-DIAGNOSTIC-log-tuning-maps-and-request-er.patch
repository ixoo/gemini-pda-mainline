From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Fri, 6 Nov 2026 15:21:09 -0500
Subject: [PATCH] mmc: mtk-sd: DIAGNOSTIC log tuning maps and request errors

On the Gemini PDA's eMMC at HS200, some multi-block reads fail without
a log line, and the block driver re-reads them one sector at a time.
mtk-sd reports its tuning pass maps, chosen delay and request errors
only through dev_dbg, and the station kernel has neither dynamic debug
nor tracing.

Print at info level the pass map and chosen phase of each tuning scan,
the final shared delay with its edge, and, rate-limited, each command
or data error outside tuning, with the interrupt events and the
current pad-tune and IOCON registers. Behaviour is unchanged.

For diagnosis on this board only, not for upstream.
---
 drivers/mmc/host/mtk-sd.c | 25 +++++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/drivers/mmc/host/mtk-sd.c b/drivers/mmc/host/mtk-sd.c
index 1098911..b184f5d 100644
--- a/drivers/mmc/host/mtk-sd.c
+++ b/drivers/mmc/host/mtk-sd.c
@@ -1427,11 +1427,11 @@ static bool msdc_cmd_done(struct msdc_host *host, int events,
 			host->error |= REQ_CMD_TMO;
 		}
 	}
-	if (cmd->error)
-		dev_dbg(host->dev,
-				"%s: cmd=%d arg=%08X; rsp %08X; cmd_error=%d\n",
-				__func__, cmd->opcode, cmd->arg, rsp[0],
-				cmd->error);
+	if ((cmd->error || sbc_error) && !mmc_op_tuning(cmd->opcode))
+		dev_info_ratelimited(host->dev,
+			"cmd error: cmd %u arg %#x rsp %#x error %d sbc_error %d events %#x\n",
+			cmd->opcode, cmd->arg, rsp[0], cmd->error,
+			sbc_error ? mrq->sbc->error : 0, events);
 
 	msdc_cmd_next(host, mrq, cmd);
 	return true;
@@ -1631,7 +1631,15 @@ static void msdc_data_xfer_done(struct msdc_host *host, u32 events,
 		if ((events & MSDC_INT_XFER_COMPL) && (!stop || !stop->error)) {
 			data->bytes_xfered = data->blocks * data->blksz;
 		} else {
-			dev_dbg(host->dev, "interrupt events: %x\n", events);
+			if (!mmc_op_tuning(mrq->cmd->opcode))
+				dev_info_ratelimited(host->dev,
+					"data error: events %#x cmd %u arg %#x blocks %u pad_tune %#x %#x iocon %#x\n",
+					events, mrq->cmd->opcode, mrq->cmd->arg,
+					data->blocks,
+					readl(host->base + host->dev_comp->pad_tune_reg),
+					readl(host->base + host->dev_comp->pad_tune_reg +
+					      TUNING_REG2_FIXED_OFFEST),
+					readl(host->base + MSDC_IOCON));
 			msdc_reset_hw(host);
 			host->error |= REQ_DAT_ERR;
 			data->bytes_xfered = 0;
@@ -2244,7 +2252,7 @@ static struct msdc_delay_phase get_best_delay(struct msdc_host *host, u64 delay)
 		final_phase = (start_final + len_final / 3) % PAD_DELAY_FULL;
 	else
 		final_phase = (start_final + len_final / 2) % PAD_DELAY_FULL;
-	dev_dbg(host->dev, "phase: [map:%016llx] [maxlen:%d] [final:%d]\n",
+	dev_info(host->dev, "phase: [map:%016llx] [maxlen:%d] [final:%d]\n",
 		delay, len_final, final_phase);
 
 	delay_phase.maxlen = len_final;
@@ -2575,7 +2583,8 @@ skip_fall:
 	msdc_set_cmd_delay(host, final_delay);
 	msdc_set_data_delay(host, final_delay);
 
-	dev_dbg(host->dev, "Final pad delay: %x\n", final_delay);
+	dev_info(host->dev, "Final pad delay: %x, %s edge\n", final_delay,
+		 final_maxlen == final_rise_delay.maxlen ? "rising" : "falling");
 	return final_delay == 0xff ? -EIO : 0;
 }
 
