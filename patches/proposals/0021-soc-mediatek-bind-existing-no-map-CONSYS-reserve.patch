From e40913a0b835ccbc6ed49fbf5e366f121ee828e8 Mon Sep 17 00:00:00 2001
From: MT6797 internal experiment <nobody@example.invalid>
Date: Sat, 26 Sep 2026 22:50:41 -0400
Subject: [PATCH] soc: mediatek: bind existing no-map CONSYS reservation

ARM64 registers the allocated no-map reserved memory as a busy iomem
resource before the platform owner probes. A second request_mem_region()
for its first MiB conflicts with that existing reservation. Require one
busy non-System-RAM resource covering the verified first MiB and retain a
single owner binding instead. The boot reservation itself continues to
exclude ordinary competing resource requests.

Internal experiment patch with a synthetic snapshot parent. No DCO
certification.
---
 drivers/soc/mediatek/mt6797-consys.c | 44 +++++++++++++++++++++-------
 1 file changed, 34 insertions(+), 10 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
index d739c41..d50497a 100644
--- a/drivers/soc/mediatek/mt6797-consys.c
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -16,9 +16,9 @@
 #define MT6797_CONSYS_REMAP_REG	0x10001340
 
 struct mt6797_consys {
-	struct resource *claimed;
 	void __iomem *remap;
 	phys_addr_t base;
+	bool bound;
 };
 
 static DEFINE_MUTEX(mt6797_consys_lock);
@@ -132,19 +132,48 @@ out:
 	return ret;
 }
 
+/* ARM64 already owns no-map boot memory as a busy reserved resource. */
+static int mt6797_consys_check_boot_resource(struct resource *res, void *arg)
+{
+	const u64 *base = arg;
+
+	if (res->start != *base || res->end != *base + SZ_1M - 1 ||
+	    resource_type(res) != IORESOURCE_MEM ||
+	    (res->flags & IORESOURCE_SYSRAM))
+		return -EBUSY;
+
+	return 1;
+}
+
+static int mt6797_consys_boot_reserved(u64 base)
+{
+	int ret;
+
+	ret = walk_iomem_res_desc(IORES_DESC_NONE,
+				  IORESOURCE_MEM | IORESOURCE_BUSY,
+				  base, base + SZ_1M - 1, &base,
+				  mt6797_consys_check_boot_resource);
+	if (ret == 1)
+		return 0;
+	return ret < 0 ? ret : -ENODEV;
+}
+
 static int mt6797_consys_probe(struct platform_device *pdev)
 {
-	struct resource *remap_resource, *claim;
+	struct resource *remap_resource;
 	void __iomem *remap;
 	u64 base;
 	int ret;
 
 	mutex_lock(&mt6797_consys_lock);
-	if (mt6797_consys.claimed) {
+	if (mt6797_consys.bound) {
 		ret = -EBUSY;
 		goto out_unlock;
 	}
 	ret = mt6797_consys_resolve(pdev->dev.of_node, &base);
+	if (ret)
+		goto out_unlock;
+	ret = mt6797_consys_boot_reserved(base);
 	if (ret)
 		goto out_unlock;
 	remap_resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
@@ -160,16 +189,11 @@ static int mt6797_consys_probe(struct platform_device *pdev)
 		ret = PTR_ERR(remap);
 		goto out_unlock;
 	}
-	claim = request_mem_region(base, SZ_1M, "mt6797-consys");
-	if (!claim) {
-		ret = -EBUSY;
-		goto out_unlock;
-	}
 	mt6797_consys.base = base;
 	mt6797_consys.remap = remap;
-	mt6797_consys.claimed = claim;
+	mt6797_consys.bound = true;
 	platform_set_drvdata(pdev, &mt6797_consys);
-	dev_info(&pdev->dev, "claimed boot CONSYS MiB and shared remap register\n");
+	dev_info(&pdev->dev, "bound boot CONSYS reserve and claimed shared remap register\n");
 out_unlock:
 	mutex_unlock(&mt6797_consys_lock);
 	return ret;
-- 
