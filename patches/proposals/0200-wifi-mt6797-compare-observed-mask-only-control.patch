From a1772f3410b1099b8609d0365edc0d2394fa5935 Mon Sep 17 00:00:00 2001
From: Codex Experiment <codex-experiment@example.invalid>
Date: Sat, 17 Oct 2026 22:19:28 -0400
Subject: [PATCH] wifi: mt6797: compare observed mask-only control

The observed stock monitor callback performs one full-word Boolean-mask
store. Compare only that source-observed operation with global
SET_MONITOR, using the standard ACCESS_REG SET command under the
existing serialized TC4 owner.

Add a default-off stable-epoch-only option. Admit only one fixed
address, an eight-byte payload and complete values 7/0; reject
SET_MONITOR in the comparison build. Preserve sequence, credit,
deadlines, RX equality/complete-transfer/poison/no-copy, PN/key and
lifetime rules.

This is a bounded availability comparison. Group meanings, pending-
length publication, firmware integrity and key retirement remain
unproved. No generic register control API or maintained support claim.

Internal experiment archive, synthetic non-certifying author identity;
no DCO certification and not an upstream submission.
---
 drivers/net/wireless/mediatek/mt6797/Kconfig  | 10 +++++++++
 drivers/net/wireless/mediatek/mt6797/hif.c    | 15 +++++++++++++
 drivers/net/wireless/mediatek/mt6797/hif.h    |  6 +++++
 .../mediatek/mt6797/join-command-submit.h     | 12 +++++++++-
 .../wireless/mediatek/mt6797/join-commands.h  | 22 +++++++++++++++++++
 drivers/net/wireless/mediatek/mt6797/mac.c    | 14 ++++++++++++
 6 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 8b302d2..9be3a5c 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -103,3 +103,13 @@ config MT6797_CCMP_STABLE_EPOCH
 	  standard mac80211 decap. GTK RX, rekey, slot reuse and normal-mode PN
 	  production are not supported. The read-only ccmp_stable_epoch arm is
 	  mutually exclusive with native_delivery_diag. No IRQ/DMA changes.
+
+config MT6797_CCMP_MASK_CONTROL
+	bool "MT6797 default-off observed mask-only control comparison"
+	depends on MT6797_CCMP_STABLE_EPOCH
+	default n
+	help
+	  Compare one observed three-bit firmware control primitive with the
+	  global monitor operation, retaining all initial-PTK diagnostic limits.
+	  Only one fixed address and values 7/0 are admitted. This does not
+	  establish group meanings, firmware integrity or healthy key reuse.
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index ca8a451..501dda8 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -735,6 +735,21 @@ int mt6797_hif_native_monitor(struct mt6797_hif *hif, unsigned int sequence,
 }
 #endif
 
+#ifdef CONFIG_MT6797_CCMP_MASK_CONTROL
+/* Same shared owner/credit path as SET_MONITOR; no readback or retry.
+ * Zero proves PIO submission, not control completion or resource retirement.
+ */
+int mt6797_hif_diag_mask(struct mt6797_hif *hif, unsigned int sequence,
+			 bool enable, u64 deadline_ns)
+{
+	u8 payload[MT6797_DIAG_MASK_BYTES];
+
+	mt6797_diag_mask_payload(enable, payload);
+	return mt6797_hif_send_join_command(hif, 0xc0, sequence, payload,
+					   sizeof(payload), false, deadline_ns);
+}
+#endif
+
 /*
  * True only when the post-record normal owner is idle with every TC4 page
  * returned. A busy context reads as not idle, so callers fail closed.
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index 514bcfe..d44064e 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -234,6 +234,12 @@ int mt6797_hif_native_monitor(struct mt6797_hif *hif, unsigned int sequence,
 			      bool enable, u8 channel, u64 deadline_ns);
 #endif
 
+#ifdef CONFIG_MT6797_CCMP_MASK_CONTROL
+/* Default-off exact observed mask operation, using the existing TC4 owner. */
+int mt6797_hif_diag_mask(struct mt6797_hif *hif, unsigned int sequence,
+			 bool enable, u64 deadline_ns);
+#endif
+
 /* One native bounded management frame through the existing TC4 PIO owner.
  * Process context only. Caller owns station/channel generation, destination,
  * exact frame-body admission and single-use PID. No overlapping page debt.
diff --git a/drivers/net/wireless/mediatek/mt6797/join-command-submit.h b/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
index 9eb955d..db7657d 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-command-submit.h
@@ -44,7 +44,17 @@ mt6797_join_prepare_command(struct mt6797_normal_transaction *t,
 	case 0x1c:
 		required = 16;
 		break;
-#ifdef CONFIG_MT6797_NATIVE_DELIVERY_DIAG
+#ifdef CONFIG_MT6797_CCMP_MASK_CONTROL
+	case 0xc0:
+		/* Only the exact observed store; reject lengths before field reads. */
+		if (bytes != MT6797_DIAG_MASK_BYTES ||
+		    mt6797_join_le32(payload) != MT6797_DIAG_MASK_TARGET ||
+		    (mt6797_join_le32(payload + 4) != 0 &&
+		     mt6797_join_le32(payload + 4) != 7))
+			return -EINVAL;
+		required = MT6797_DIAG_MASK_BYTES;
+		break;
+#elif defined(CONFIG_MT6797_NATIVE_DELIVERY_DIAG)
 	case 0xfc:
 		/* CMD_ID_SET_MONITOR, the default-off native-crypto-delivery
 		 * diagnostic's one 16-byte SET_MONITOR (proposal 0181). Present
diff --git a/drivers/net/wireless/mediatek/mt6797/join-commands.h b/drivers/net/wireless/mediatek/mt6797/join-commands.h
index 228e7cb..704e38d 100644
--- a/drivers/net/wireless/mediatek/mt6797/join-commands.h
+++ b/drivers/net/wireless/mediatek/mt6797/join-commands.h
@@ -304,4 +304,26 @@ mt6797_native_monitor_payload(bool enable, unsigned char channel,
 	output[2] = channel;	    /* ucPriChannel; band/SCO/width/S1/S2 stay 0 */
 	return true;
 }
+#ifdef CONFIG_MT6797_CCMP_MASK_CONTROL
+/* Observed stock callback's complete Boolean-mask store, not a general MCR API.
+ * Group meanings and pending-format ownership remain diagnostic questions.
+ */
+#define MT6797_DIAG_MASK_BYTES 8U
+#define MT6797_DIAG_MASK_TARGET 0x800c0068U
+static inline bool
+mt6797_diag_mask_payload(bool enable, unsigned char output[MT6797_DIAG_MASK_BYTES])
+{
+	unsigned int i;
+
+	if (!output)
+		return false;
+	for (i = 0; i < 4; i++)
+		output[i] = MT6797_DIAG_MASK_TARGET >> (8 * i);
+	output[4] = enable ? 7 : 0;
+	output[5] = 0;
+	output[6] = 0;
+	output[7] = 0;
+	return true;
+}
+#endif
 #endif
diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 31ef759..579e562 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -1798,10 +1798,20 @@ static void mt6797_native_diag_step(struct mt6797_mac *mac)
 	act = mt6797_native_diag_transition(&c);
 	mac->native_diag_state = c.state;
 	if (act == MT6797_ND_ACT_SUBMIT_ENABLE || act == MT6797_ND_ACT_SUBMIT_DISABLE) {
+#ifdef CONFIG_MT6797_CCMP_MASK_CONTROL
+		rc = mt6797_hif_diag_mask(mac->hif, mac->sequence++,
+					act == MT6797_ND_ACT_SUBMIT_ENABLE,
+					min_t(u64, mac->join_deadline,
+					      ktime_get_ns() + 100 * NSEC_PER_MSEC));
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN mask-control submission: enable=%u status=%d\n",
+			 (unsigned int)(act == MT6797_ND_ACT_SUBMIT_ENABLE), rc);
+#else
 		rc = mt6797_hif_native_monitor(mac->hif, mac->sequence++,
 					       act == MT6797_ND_ACT_SUBMIT_ENABLE, 40,
 					       min_t(u64, mac->join_deadline,
 						     ktime_get_ns() + 100 * NSEC_PER_MSEC));
+#endif
 		if (rc) {
 			if (!mac->first_error)
 				mac->first_error = rc;
@@ -4608,6 +4618,10 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
 #ifdef CONFIG_MT6797_CCMP_STABLE_EPOCH
 	if (ccmp_stable_epoch && native_delivery_diag)
 		return -EINVAL;
+#endif
+#ifdef CONFIG_MT6797_CCMP_MASK_CONTROL
+	if (!ccmp_stable_epoch)
+		return -EINVAL;
 #endif
 	if (capability->product != 0x6797 || capability->firmware_own != 0x0403 ||
 	    capability->firmware_peer || capability->rf_cal_fail ||
-- 
