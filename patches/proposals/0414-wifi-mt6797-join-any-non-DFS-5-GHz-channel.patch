+	u16 join_chan_freq;
+	/* Its secondary offset at HT40: 1 (above) or 3 (below), else 0 (0323). */
 	u8 join_sco;
 	/* This lifetime's data at mac80211's rate control choice. */
 	bool join_data_minstrel;
diff --git a/drivers/net/wireless/mediatek/mt6797/main.c b/drivers/net/wireless/mediatek/mt6797/main.c
index 2c7b6ce31..007c9cd32 100644
--- a/drivers/net/wireless/mediatek/mt6797/main.c
+++ b/drivers/net/wireless/mediatek/mt6797/main.c
