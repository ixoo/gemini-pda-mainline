@@ -1744,7 +1748,8 @@ static int mt6797_ccmp_channel_release_step(struct mt6797_mac *mac, u64 now)
 	mac->ccmp_channel_release_pending = true;
 	mac->ccmp_channel_release_sequence = mac->sequence++;
 	ret = mt6797_hif_join_channel(mac->hif, mac->ccmp_channel_release_sequence,
-				      mac->join_channel_token, 40, 0, true, deadline);
+				      mac->join_channel_token, mac->join_chan_number,
+					      0, true, deadline);
 	mt6797_mac_join_refused(mac, ret);
 	dev_info(wiphy_dev(mac->hw->wiphy),
 		 "one-shot WLAN connected channel release: credited=0 sequence=%u status=%d observed_ns=%llu pm_offset_ns=%llu debt=%u\n",
@@ -2529,7 +2534,7 @@ void mt6797_mac_join_work(struct work_struct *work)
 				const u8 *f = mac->join_packet + beacon.offset;
 
 				if (mac->join_assoc_received && !mac->join_assoc_status &&
-				    !mac->join_cleanup_done && beacon.channel == 40 &&
+				    !mac->join_cleanup_done && beacon.channel == mac->join_chan_number &&
 				    (mt6797_join_le16(f) & 0x00ff) == 0x0080 &&
 				    ether_addr_equal(f + 10, mac->join_ap) &&
 				    ether_addr_equal(f + 16, mac->join_ap)) {
@@ -2550,7 +2555,8 @@ void mt6797_mac_join_work(struct work_struct *work)
 			 * (0176), counted; a beacon cannot be a fence either.
 			 */
 			if (mac->join_key_group == 1 && !mac->join_cleanup_done &&
-			    mt6797_join_keyed_beacon(mac->join_packet, rx.logical_bytes, 40,
+			    mt6797_join_keyed_beacon(mac->join_packet, rx.logical_bytes,
+						     mac->join_chan_number,
 						     mac->join_ap, MT6797_JOIN_BMC_WLAN_INDEX,
 						     &action)) {
 				ret = mt6797_mac_join_deliver_beacon(mac, 16 + 16 + 8 + 24,
@@ -2571,7 +2577,8 @@ void mt6797_mac_join_work(struct work_struct *work)
 			 * other shape, or a frame past the bound, reaches the refusal below.
 			 */
 			eapol_gate = mt6797_eapol_rx_gate(mac->join_packet, rx.logical_bytes,
-							  40, mac->hw->wiphy->perm_addr,
