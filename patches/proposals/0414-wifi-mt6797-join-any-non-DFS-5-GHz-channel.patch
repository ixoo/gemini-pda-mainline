+							  mac->hw->wiphy->perm_addr,
 							mac->join_ap, &eapol);
 			if (eapol_gate == MT6797_EAPOL_OK &&
 			    mac->join_assoc_received && !mac->join_assoc_status &&
@@ -2609,7 +2616,7 @@ void mt6797_mac_join_work(struct work_struct *work)
 				memset(IEEE80211_SKB_RXCB(skb), 0,
 				       sizeof(struct ieee80211_rx_status));
 				IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
-				IEEE80211_SKB_RXCB(skb)->freq = 5200;
+				IEEE80211_SKB_RXCB(skb)->freq = mac->join_chan_freq;
 				if (eapol.signal_valid)
 					IEEE80211_SKB_RXCB(skb)->signal = eapol.signal_dbm;
 				else
@@ -2661,7 +2668,8 @@ void mt6797_mac_join_work(struct work_struct *work)
 				    !mac->join_assoc_status && !mac->join_cleanup_done &&
 				    !mac->join_deauth_done &&
 				    mt6797_native_beacon(mac->join_packet, rx.logical_bytes,
-							 40, mac->join_ap, &nbcn)) {
+							 mac->join_chan_number,
+							 mac->join_ap, &nbcn)) {
 					ret = mt6797_mac_join_deliver_beacon(mac, nbcn.offset,
 									     nbcn.bytes, nbcn.rcpi,
 									     false, &received);
@@ -2679,7 +2687,8 @@ void mt6797_mac_join_work(struct work_struct *work)
 			/* The strict directed management path; no ordinary legacy
 			 * data fallback.
 			 */
-			if (!mt6797_join_rx_frame(mac->join_packet, rx.logical_bytes, 40,
+			if (!mt6797_join_rx_frame(mac->join_packet, rx.logical_bytes,
+						  mac->join_chan_number,
 						  mac->hw->wiphy->perm_addr, mac->join_ap,
 						  mac->join_rx_allowed, &frame))
 				continue;
@@ -2722,7 +2731,7 @@ void mt6797_mac_join_work(struct work_struct *work)
 			skb_put_data(skb, mac->join_packet + frame.offset, frame.bytes);
 			memset(IEEE80211_SKB_RXCB(skb), 0, sizeof(struct ieee80211_rx_status));
 			IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
-			IEEE80211_SKB_RXCB(skb)->freq = 5200;
+			IEEE80211_SKB_RXCB(skb)->freq = mac->join_chan_freq;
 			IEEE80211_SKB_RXCB(skb)->signal = frame.signal_dbm;
 			__skb_queue_tail(&received, skb);
 		}
@@ -2981,7 +2990,8 @@ int mt6797_mac_join_add_peer(struct mt6797_mac *mac,
 	mac->join_credit_pending = true;
 	mac->join_page_debt = 1;
 	ret = mt6797_hif_join_channel_sco(mac->hif, mac->sequence++,
-					  mac->join_channel_token, 40, mac->join_sco,
+					  mac->join_channel_token, mac->join_chan_number,
+					  mac->join_sco,
 					  mac->join_requested_ms,
 					  mac->join_credit_deadline);
 	mt6797_mac_join_refused(mac, ret);
@@ -3148,11 +3158,12 @@ int mt6797_mac_join_associate(struct mt6797_mac *mac, unsigned int aid)
 		 * join, info 1 drops its secondary offset and channel width.
 		 */
 		memcpy(ht_op40, mac->join_ht_op, sizeof(ht_op40));
-		if (mac->join_sco != 3)
+		if (!mac->join_sco)
 			ht_op40[1] &= ~0x07;
 		ht_op = ht_op40;
 	}
 	ret = mt6797_hif_join_bss_qos(mac->hif, mac->sequence++, mac->join_ap,
+				      mac->join_chan_number,
 				      mac->join_ssid, mac->join_ssid_bytes,
 				     mac->join_desired_rates, mac->join_peer_basic_rates,
