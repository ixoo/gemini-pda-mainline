From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 1 Nov 2026 08:17:43 -0500
Subject: [PATCH] wifi: mt6797: join any non-DFS 5 GHz channel

Join, its firmware commands and the receive path were pinned to channel
40. Take the channel from mac80211's operating channel instead: the
channel request, the BSS record, the descriptor comparison on every
receive path, and the frequency reported to mac80211. HT40 now works
with the secondary channel above as well as below.

Keep refusing what the admitted radio protocol excludes: 2.4 GHz, which
needs its own band and rate handling, and channels marked no-IR or
radar, so no DFS channel is joined.

Part of the Wi-Fi daily-use plan, phase 3.
---
 drivers/net/wireless/mediatek/mt6797/data.c   | 11 +++---
 drivers/net/wireless/mediatek/mt6797/hif.c    |  9 ++---
 drivers/net/wireless/mediatek/mt6797/hif.h    |  4 +-
 drivers/net/wireless/mediatek/mt6797/join.c   | 39 ++++++++++++-------
 .../net/wireless/mediatek/mt6797/mac-priv.h   |  5 ++-
 drivers/net/wireless/mediatek/mt6797/main.c   | 23 +++++++----
 drivers/net/wireless/mediatek/mt6797/mcu.h    |  9 +++--
 7 files changed, 61 insertions(+), 39 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/data.c b/drivers/net/wireless/mediatek/mt6797/data.c
index dcf4e0e0a..02bb63e29 100644
--- a/drivers/net/wireless/mediatek/mt6797/data.c
+++ b/drivers/net/wireless/mediatek/mt6797/data.c
@@ -1186,7 +1186,8 @@ static bool mt6797_ccmp_llc_mismatch(struct mt6797_mac *mac, size_t bytes)
 	struct mt6797_data_rx view;
 
 	if (!mac->ccmp_gtk || mac->join_key_group != 1 ||
-	    !mt6797_data_rx_llc_mismatch(mac->join_packet, bytes, 40, mac->join_ap,
+	    !mt6797_data_rx_llc_mismatch(mac->join_packet, bytes,
+					 mac->join_chan_number, mac->join_ap,
 					 MT6797_JOIN_BMC_WLAN_INDEX, &view) ||
 	    view.key_id != mac->join_group_key_id)
 		return false;
@@ -1314,7 +1315,7 @@ static int mt6797_ccmp_deliver_rx(struct mt6797_mac *mac, size_t bytes,
 	skb_put_data(skb, mac->join_packet + view.offset, view.bytes);
 	memset(IEEE80211_SKB_RXCB(skb), 0, sizeof(struct ieee80211_rx_status));
 	IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
-	IEEE80211_SKB_RXCB(skb)->freq = 5200;
+	IEEE80211_SKB_RXCB(skb)->freq = mac->join_chan_freq;
 	IEEE80211_SKB_RXCB(skb)->flag = rx_flags;
 	/* The queued-frame count saturates; it never limits delivery. */
 	if (mac->ccmp_queued < MT6797_CCMP_DIAG_CHECKED_MAX)
@@ -1610,7 +1611,7 @@ void mt6797_ccmp_receive(struct mt6797_mac *mac, struct sk_buff *skb)
 /* This lifetime's data width and receive A-MPDU. */
 bool __maybe_unused mt6797_mac_data_bw40(const struct mt6797_mac *mac)
 {
-	return mac->join_sco == 3;
+	return mac->join_sco;
 }
 
 /* This lifetime's ordinary data at mac80211's rate control choice. */
@@ -1640,7 +1641,7 @@ mt6797_mac_tx_rate(struct mt6797_mac *mac, struct sk_buff *skb,
 
 	if (!mt6797_mac_data_minstrel(mac))
 		goto fixed;
-	if ((!w40 || mac->join_sco == 3) &&
+	if ((!w40 || mac->join_sco) &&
 	    mt6797_tx_rate_map(rate->idx, rate->flags & IEEE80211_TX_RC_MCS,
 			       rate->flags & IEEE80211_TX_RC_VHT_MCS, w40,
 			       rate->flags & IEEE80211_TX_RC_SHORT_GI, legacy, r))
@@ -1747,7 +1748,7 @@ int mt6797_mac_join_deliver_beacon(struct mt6797_mac *mac, size_t offset,
 	skb_put_data(skb, mac->join_packet + offset, bytes);
 	memset(IEEE80211_SKB_RXCB(skb), 0, sizeof(struct ieee80211_rx_status));
 	IEEE80211_SKB_RXCB(skb)->band = NL80211_BAND_5GHZ;
-	IEEE80211_SKB_RXCB(skb)->freq = 5200;
+	IEEE80211_SKB_RXCB(skb)->freq = mac->join_chan_freq;
 	if (rcpi <= 220)
 		IEEE80211_SKB_RXCB(skb)->signal = (int)rcpi / 2 - 110;
 	else
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index a51eb11f7..2039770df 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.c
+++ b/drivers/net/wireless/mediatek/mt6797/hif.c
@@ -1544,18 +1544,17 @@ EXPORT_SYMBOL_GPL(mt6797_hif_join_station);
  * PHY (byte 55, PHY_TYPE_BIT_OFDM | PHY_TYPE_BIT_HT) and, in the RLM tail at
  * byte 68, ucHtProtectMode (73, the operating mode of info 2, the vendor's
  * ENUM_HT_PROTECT_MODE values), u2HtOpInfo3 (76), u2HtOpInfo2 (78) and
- * ucHtOpInfo1 (80). The secondary channel, greenfield and RIFS fields stay
- * zero: the join is HT20 at the fixed channel (0295).
+ * ucHtOpInfo1 (80). Greenfield and RIFS stay zero (0295).
  */
 int mt6797_hif_join_bss_qos(struct mt6797_hif *hif, unsigned int sequence,
-			    const u8 *ap, const u8 *ssid, unsigned int ssid_bytes,
+			    const u8 *ap, u8 channel, const u8 *ssid, unsigned int ssid_bytes,
 	unsigned int desired_rates, unsigned int basic_rates,
 	bool short_preamble, bool wpa2, bool qos, const u8 *ht_op,
 	u64 deadline_ns)
 {
 	u8 payload[MT6797_JOIN_BSS_BYTES];
 
-	if (!mt6797_join_bss_payload(ap, ssid, ssid_bytes, desired_rates,
+	if (!mt6797_join_bss_payload(ap, channel, ssid, ssid_bytes, desired_rates,
 				     basic_rates, short_preamble, wpa2, payload))
 		return -EINVAL;
 	payload[42] = qos;
@@ -1660,7 +1659,7 @@ int mt6797_hif_join_channel_sco(struct mt6797_hif *hif, unsigned int sequence,
 {
 	u8 payload[16];
 
-	if ((sco && (sco != 3 || channel != 40)) ||
+	if ((sco != 0 && sco != 1 && sco != 3) ||
 	    !mt6797_join_channel_payload(token, channel, interval_ms, false, payload))
 		return -EINVAL;
 	payload[4] = sco;
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.h b/drivers/net/wireless/mediatek/mt6797/hif.h
index 47110f8fb..2cf60f97a 100644
--- a/drivers/net/wireless/mediatek/mt6797/hif.h
+++ b/drivers/net/wireless/mediatek/mt6797/hif.h
@@ -232,7 +232,7 @@ int mt6797_hif_join_station(struct mt6797_hif *hif, unsigned int sequence,
 			    const u8 *ap, unsigned int state, unsigned int aid,
 	unsigned int desired_rates, unsigned int basic_rates, u64 deadline_ns);
 int mt6797_hif_join_bss_qos(struct mt6797_hif *hif, unsigned int sequence,
-			    const u8 *ap, const u8 *ssid, unsigned int ssid_bytes,
+			    const u8 *ap, u8 channel, const u8 *ssid, unsigned int ssid_bytes,
 	unsigned int desired_rates, unsigned int basic_rates,
 	bool short_preamble, bool wpa2, bool qos, const u8 *ht_op,
 	u64 deadline_ns);
@@ -245,7 +245,7 @@ int mt6797_hif_join_remove_station(struct mt6797_hif *hif,
 int mt6797_hif_join_channel(struct mt6797_hif *hif, unsigned int sequence,
 			    u8 token, u8 channel, unsigned int interval_ms, bool abort,
 			    u64 deadline_ns);
-/* The same request with ucRfSco (byte 4) set: 0, or 3 (below) on channel 40. */
+/* The same request with ucRfSco (byte 4) set: 0, 1 (above) or 3 (below). */
 int mt6797_hif_join_channel_sco(struct mt6797_hif *hif, unsigned int sequence,
 				u8 token, u8 channel, u8 sco, unsigned int interval_ms,
 				u64 deadline_ns);
