From 6ba7213cf2fbe0474e843e532ebdd7489d5cf8c6 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 26 Oct 2026 20:28:27 -0400
Subject: [PATCH] wifi: mt6797: count the block-ack and reorder records per
 lifetime

The rearm resets every other count the data phase records, so each
lifetime's records are that lifetime's alone. The block-ack session
counts and the reorder window's counts, including the per-TID holes,
were reset only at boot. With several lifetimes in one boot, the
"RX BA:" line and the per-join test stats line (0329) therefore
accumulated across lifetimes. In boot AU, held and released climbed
from 281 to 1189 over six lifetimes.

Reset them at the rearm, after the teardown drop. Frames dropped at
teardown count in no lifetime's record.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index faaa5da04..7f9b43921 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -2574,6 +2574,27 @@ static void mt6797_mac_join_rearm(struct mt6797_mac *mac)
 #ifdef CONFIG_MT6797_RX_AMPDU
 	mac->rx_ba_active = 0;
 	mt6797_rx_reorder_drop(mac);
+	/* The block-ack and reorder counts are per lifetime, as the rest of
+	 * the data phase's records are; they start again after the teardown
+	 * drop, which no lifetime's record counts.
+	 */
+	mac->rx_ba_starts = 0;
+	mac->rx_ba_stops = 0;
+	mac->rx_ba_frames = 0;
+	mac->rx_reorder_held = 0;
+	mac->rx_reorder_released = 0;
+	mac->rx_reorder_timeouts = 0;
+	mac->rx_reorder_duplicates = 0;
+	mac->rx_reorder_behind = 0;
+	mac->rx_reorder_dropped = 0;
+	mac->rx_reorder_plain = 0;
+	mac->rx_reorder_max = 0;
+	{
+		unsigned int tid;
+
+		for (tid = 0; tid < MT6797_RX_REORDER_TIDS; tid++)
+			mac->rx_reorder[tid].holes = 0;
+	}
 #endif
 	mac->join_tx_allowed = 0;
 	mac->join_rx_allowed = 0;
-- 
