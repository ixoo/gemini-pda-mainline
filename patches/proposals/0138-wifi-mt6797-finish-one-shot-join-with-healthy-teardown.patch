From 7b7579385b497410e68422e7fa7d35786df9591e Mon Sep 17 00:00:00 2001
From: scratch <scratch@invalid>
Date: Tue, 6 Oct 2026 02:33:28 +0000
Subject: [PATCH] wifi: mt6797: finish one-shot join with healthy finite
 teardown

Keep polling after mac80211 removes a refused station. For an accepted legacy association queue one owned deauthentication with the next sequence, wait for actual TX completion and returned credits, then remove the peer, abort its channel and deactivate its BSS. Retire all slots after teardown; no credit return asserts firmware drain or reuse. Late MLME completion cannot close the owned deauthentication gate. Reserve the full command sequence budget before admitting a peer. Poisoned sessions submit no cleanup command.

Production-function host fixtures cover acceptance, refusal, callback ordering and each command fault with ASan/UBSan. Hardware behavior is untested. No DCO certification is asserted.
---
 drivers/net/wireless/mediatek/mt6797/mac.c | 211 ++++++++++++++++++++-
 1 file changed, 204 insertions(+), 7 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/mac.c b/drivers/net/wireless/mediatek/mt6797/mac.c
index 4b3e1ec27..e16d49951 100644
--- a/drivers/net/wireless/mediatek/mt6797/mac.c
+++ b/drivers/net/wireless/mediatek/mt6797/mac.c
@@ -58,6 +58,10 @@ struct mt6797_mac {
 	unsigned int join_submitted;
 	u8 join_ssid[32], join_ssid_bytes;
 	bool join_short_preamble, join_bss_configured;
+	bool join_cleanup_requested, join_cleanup_done, join_deauth_done;
+	unsigned int join_cleanup_stage;
+	u16 join_last_sequence;
+	struct sk_buff *join_internal;
 #endif
 	struct completion join_channel_done, join_sta_done, join_credit_done, join_frame_done;
 	bool join_last_acked;
@@ -615,6 +619,84 @@ static int mt6797_mac_join_control_event(struct mt6797_mac *mac, size_t bytes)
 	return -EPROTO;
 }
 
+#if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+/* Poller-owned finite teardown. A returned page proves submission, not reuse. */
+static int mt6797_mac_join_cleanup_step(struct mt6797_mac *mac)
+{
+	unsigned long flags;
+	bool queued;
+	u64 deadline;
+	u8 bss[12];
+	int ret;
+
+	if (!mac->join_cleanup_requested || mac->join_cleanup_done)
+		return 0;
+	if (mac->first_error || mac->closing || mac->join_retired)
+		return -ECANCELED;
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	queued = !skb_queue_empty(&mac->join_queue);
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	if (queued || mac->join_inflight || mac->join_page_debt ||
+	    mac->join_credit_pending)
+		return 0;
+	if (mac->join_sta_active && !mac->join_deauth_done)
+		return 0;
+	deadline = min_t(u64, mac->join_deadline,
+			 ktime_get_ns() + 100 * NSEC_PER_MSEC);
+	ret = mt6797_mac_join_guard(mac, deadline);
+	if (ret)
+		return ret;
+	if (!mt6797_hif_normal_idle(mac->hif))
+		return -EPROTO;
+	if (mac->join_cleanup_stage == 3) {
+		mac->join_cleanup_done = true;
+		mac->join_sta_active = false;
+		mac->join_channel_granted = false;
+		mac->bss_active = false;
+		mac->join_scan_ready = false;
+		mac->join_retired = true;
+		spin_lock_irqsave(&mac->join_queue.lock, flags);
+		mac->join_open = false;
+		mac->join_running = false;
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join cleanup: stage=3 credits=returned slots=retired deauth=%u\n",
+			 mac->join_deauth_done);
+		/* This API only queues work; no synchronous MLME call under our mutex. */
+		if (mac->vif && mac->started)
+			ieee80211_connection_loss(mac->vif);
+		return 0;
+	}
+	if (mac->join_cleanup_stage > 3 || mac->sequence > 255)
+		return -ENOSPC;
+	mac->join_credit_deadline = deadline;
+	reinit_completion(&mac->join_credit_done);
+	mac->join_credit_pending = true;
+	mac->join_page_debt = 1;
+	switch (mac->join_cleanup_stage) {
+	case 0:
+		ret = mt6797_hif_join_remove_station(mac->hif, mac->sequence++, deadline);
+		break;
+	case 1:
+		ret = mt6797_hif_join_channel(mac->hif, mac->sequence++,
+					      mac->join_channel_token, 40, 0, true, deadline);
+		break;
+	default:
+		mt6797_scan_bss(mac->hw->wiphy->perm_addr, false, bss);
+		ret = mt6797_hif_send_config(mac->hif, MT6797_NORMAL_BSS_ACTIVE,
+					     mac->sequence++, bss, sizeof(bss), deadline);
+		break;
+	}
+	if (!ret) {
+		dev_info(wiphy_dev(mac->hw->wiphy),
+			 "one-shot WLAN join cleanup submission: stage=%u\n",
+			 mac->join_cleanup_stage);
+		mac->join_cleanup_stage++;
+	}
+	return ret;
+}
+#endif
+
 static void mt6797_mac_join_work(struct work_struct *work)
 {
 	struct mt6797_mac *mac = container_of(to_delayed_work(work),
@@ -631,7 +713,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
 	const u8 *body;
 #endif
-	bool running, ack = false;
+	bool running, ack = false, completed_internal = false;
 	int ret = 0;
 
 	skb_queue_head_init(&received);
@@ -698,6 +780,7 @@ static void mt6797_mac_join_work(struct work_struct *work)
 				goto failed;
 #if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
 			mac->join_submitted |= BIT((get_unaligned_le16(skb->data) >> 4) & 15);
+			mac->join_last_sequence = get_unaligned_le16(skb->data + 22) >> 4;
 #endif
 			mac->join_page_debt = pages;
 			mac->join_frame_deadline = ktime_get_ns() + 750 * NSEC_PER_MSEC;
@@ -725,8 +808,18 @@ static void mt6797_mac_join_work(struct work_struct *work)
 				}
 				completed = mac->join_inflight;
 				mac->join_inflight = NULL;
+#if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+				if (completed == mac->join_internal) {
+					completed_internal = true;
+					mac->join_internal = NULL;
+				}
+#endif
 				ack = result.status == 0;
 				mac->join_last_acked = ack;
+#if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+				if (completed_internal)
+					mac->join_deauth_done = ack;
+#endif
 				complete_all(&mac->join_frame_done);
 				ieee80211_tx_info_clear_status(IEEE80211_SKB_CB(completed));
 				IEEE80211_SKB_CB(completed)->flags &= ~IEEE80211_TX_STAT_ACK;
@@ -794,6 +887,11 @@ static void mt6797_mac_join_work(struct work_struct *work)
 		if (!got)
 			break;
 	}
+#if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+	ret = mt6797_mac_join_cleanup_step(mac);
+	if (ret)
+		goto failed;
+#endif
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	if (mac->join_running)
 		schedule_delayed_work(&mac->join_work, msecs_to_jiffies(20));
@@ -826,8 +924,12 @@ static void mt6797_mac_join_work(struct work_struct *work)
 unlock:
 	mutex_unlock(&mac->mutex);
 	/* One worker serializes RX_ni and TX_status_ni, outside driver locks. */
-	if (completed)
-		ieee80211_tx_status_ni(mac->hw, completed);
+	if (completed) {
+		if (completed_internal)
+			dev_kfree_skb(completed);
+		else
+			ieee80211_tx_status_ni(mac->hw, completed);
+	}
 	while ((skb = __skb_dequeue(&received))) {
 		if (ret)
 			dev_kfree_skb(skb);
@@ -1307,7 +1409,7 @@ static int mt6797_mac_join_add_peer(struct mt6797_mac *mac,
 	    !mac->join_bss_valid || !mac->join_channel_valid ||
 	    mac->join_peer_used || mac->join_retired || mac->closing ||
 	    mac->first_error || mac->join_page_debt ||
-	    ktime_get_ns() >= mac->join_deadline || mac->sequence > 253 ||
+	    ktime_get_ns() >= mac->join_deadline || mac->sequence > 248 ||
 	    !mt6797_hif_normal_idle(mac->hif) ||
 	    !ether_addr_equal(sta->addr, mac->join_bssid) ||
 	    !mt6797_join_legacy_rates(sta->deflink.supp_rates[NL80211_BAND_5GHZ],
@@ -1399,7 +1501,7 @@ static int mt6797_mac_join_associate(struct mt6797_mac *mac, unsigned int aid)
 	if (!mac->join_assoc_received || mac->join_assoc_status ||
 	    !mac->join_ssid_bytes || !aid || aid > 2007 || aid != mac->join_aid ||
 	    mac->join_bss_configured || mac->join_sta_active || mac->join_sta_pending ||
-	    mac->sequence > 254)
+	    mac->sequence > 251)
 		return -EOPNOTSUPP;
 	ret = mt6797_mac_join_wait_management(mac);
 	if (ret)
@@ -1452,6 +1554,61 @@ static int mt6797_mac_join_associate(struct mt6797_mac *mac, unsigned int aid)
 	return 0;
 }
 
+/* Reserve cleanup once. An accepted join gets exactly one owned deauth skb. */
+static int mt6797_mac_join_request_cleanup(struct mt6797_mac *mac)
+{
+	struct sk_buff *skb = NULL;
+	unsigned long flags;
+	u8 *frame;
+
+	if (mac->join_cleanup_requested || mac->join_cleanup_done)
+		return 0;
+	if (!mac->join_peer_used || !mac->join_running || mac->join_retired ||
+	    mac->first_error || mac->closing)
+		return -ECANCELED;
+	if (mac->sequence > 253)
+		return -ENOSPC;
+	if (ktime_get_ns() + 1200 * NSEC_PER_MSEC >= mac->join_deadline)
+		return -ETIMEDOUT;
+	if (mac->join_sta_active) {
+		if (!mac->join_assoc_received || mac->join_assoc_status ||
+		    !mac->join_channel_granted ||
+		    ktime_get_ns() + 1200 * NSEC_PER_MSEC >= mac->join_grant_deadline)
+			return -ETIMEDOUT;
+		skb = dev_alloc_skb(26);
+		if (!skb)
+			return -ENOMEM;
+		frame = skb_put_zero(skb, 26);
+		put_unaligned_le16(IEEE80211_STYPE_DEAUTH, frame);
+		ether_addr_copy(frame + 4, mac->join_ap);
+		ether_addr_copy(frame + 10, mac->hw->wiphy->perm_addr);
+		ether_addr_copy(frame + 16, mac->join_ap);
+		put_unaligned_le16(((mac->join_last_sequence + 1) & 0xfff) << 4, frame + 22);
+		put_unaligned_le16(WLAN_REASON_DEAUTH_LEAVING, frame + 24);
+		memset(IEEE80211_SKB_CB(skb), 0, sizeof(struct ieee80211_tx_info));
+		IEEE80211_SKB_CB(skb)->band = NL80211_BAND_5GHZ;
+	}
+	spin_lock_irqsave(&mac->join_queue.lock, flags);
+	if (!skb_queue_empty(&mac->join_queue) ||
+	    (skb && (mac->join_seen & BIT(12)))) {
+		spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+		dev_kfree_skb(skb);
+		return -EPROTO;
+	}
+	mac->join_cleanup_requested = true;
+	mac->join_open = !!skb;
+	mac->join_tx_allowed = skb ? BIT(12) : 0;
+	if (skb) {
+		mac->join_seen |= BIT(12);
+		mac->join_internal = skb;
+		mac->join_queue_bytes = skb->len;
+		__skb_queue_tail(&mac->join_queue, skb);
+	}
+	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
+	mac->join_rx_allowed = BIT(10) | BIT(12);
+	return 0;
+}
+
 static void mt6797_mac_mgd_prepare_tx(struct ieee80211_hw *hw,
 				      struct ieee80211_vif *vif,
 				      struct ieee80211_prep_tx_info *info)
@@ -1462,6 +1619,10 @@ static void mt6797_mac_mgd_prepare_tx(struct ieee80211_hw *hw,
 	bool admitted;
 
 	mutex_lock(&mac->mutex);
+	if (mac->join_cleanup_requested || mac->join_cleanup_done) {
+		mutex_unlock(&mac->mutex);
+		return;
+	}
 	admitted = vif == mac->vif && !vif->valid_links && !info->link_id &&
 		   mac->join_peer_ready && mac->join_running &&
 		   !mac->join_retired && !mac->closing && !mac->first_error &&
@@ -1497,11 +1658,25 @@ static void mt6797_mac_mgd_complete_tx(struct ieee80211_hw *hw,
 	unsigned long flags;
 
 	mutex_lock(&mac->mutex);
+	/* A later MLME notification must not close the owned deauth queue. */
+	if (mac->join_cleanup_requested || mac->join_cleanup_done) {
+		mutex_unlock(&mac->mutex);
+		return;
+	}
 	spin_lock_irqsave(&mac->join_queue.lock, flags);
 	mac->join_open = false;
 	mac->join_tx_allowed = 0;
 	spin_unlock_irqrestore(&mac->join_queue.lock, flags);
-	if (vif != mac->vif || info->link_id || !info->success) {
+	if (!mac->join_cleanup_requested && !mac->join_cleanup_done &&
+	    vif == mac->vif && !info->link_id &&
+	    (info->subtype == IEEE80211_STYPE_ASSOC_REQ || !info->success)) {
+		int ret = mt6797_mac_join_request_cleanup(mac);
+
+		if (ret && !mac->first_error) {
+			mac->first_error = ret;
+			mac->closing = true;
+		}
+	} else if (vif != mac->vif || info->link_id) {
 		if (!mac->first_error)
 			mac->first_error = -ECANCELED;
 		mac->closing = true;
@@ -1520,8 +1695,30 @@ static int mt6797_mac_sta_state(struct ieee80211_hw *hw,
 	 */
 	if (new <= old) {
 #if IS_ENABLED(CONFIG_MT6797_PASSIVE_SCAN)
-		if (new < old)
+		if (new < old) {
+#if IS_ENABLED(CONFIG_MT6797_STATION_JOIN)
+			struct mt6797_mac *mac = hw->priv;
+			bool close = true;
+
+			mutex_lock(&mac->mutex);
+			if (vif == mac->vif && mac->join_peer_used &&
+			    !mac->join_retired && !mac->first_error && !mac->closing) {
+				int ret = mt6797_mac_join_request_cleanup(mac);
+
+				if (!ret) {
+					close = false;
+				} else {
+					mac->first_error = ret;
+					mac->closing = true;
+				}
+			}
+			mutex_unlock(&mac->mutex);
+			if (close)
+				mt6797_mac_join_close(mac);
+#else
 			mt6797_mac_join_close(hw->priv);
+#endif
+		}
 #endif
 		return 0;
 	}
-- 
