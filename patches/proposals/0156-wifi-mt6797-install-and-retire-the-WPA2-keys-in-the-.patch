+int mt6797_hif_join_key(struct mt6797_hif *hif, unsigned int sequence,
+			bool add, bool pairwise, const u8 *peer,
+			unsigned int key_id, const u8 *material, u64 deadline_ns)
+{
+	u8 payload[MT6797_JOIN_KEY_BYTES];
+	int error;
+
+	if (!mt6797_join_key_payload(add, pairwise, peer, key_id, material, payload))
+		return -EINVAL;
+	error = mt6797_hif_send_join_command(hif, 0x07, sequence, payload,
+					     sizeof(payload), true, deadline_ns);
+	memzero_explicit(payload, sizeof(payload));
+	return error;
+}
