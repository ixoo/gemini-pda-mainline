From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Mon, 23 Nov 2026 15:38:44 -0500
Subject: [PATCH] soc: mediatek: mt6797-spm-sleep: optionally power CPU0 down
 in SODI test periods

The vendor enters SODI with CPU0 powered down: flag bit 0 clear, then
PSCI CPU_SUSPEND for the cluster, so the firmware flushes CPU0, takes the
cluster out of coherency and waits in WFI before the program pauses the
bus masters; the program powers the core back on at the wake, and it
resumes at cpu_resume. Test periods here have kept CPU0 powered and
coherent in WFI, and the pause of one master then hangs at low operating
points.

sodi_cpu_pdn (default off) makes sodi_once_ms periods do the same as the
vendor: flag bit 0 clear, no ACINACTM writes, cpu_pm_enter(), then
psci_cpu_suspend_enter(0x01010000) and cpu_pm_exit(). The return is read
from SPM_IRQ_STA as before. CPU0's timer compare values are saved and
restored around the period, since a powered-down core comes back with its
timer registers reset.

With flag bit 0 clear the program powers off CPU0, MP0, MP_TOP and
MCUSYS, so every other core and cluster under MCUSYS must already be off.
The period is refused unless CPU_PWR_STATUS and CPU_PWR_STATUS_2ND show
CPU1-9 and the MP1 and MP2 clusters off (in the second word, whose low
byte reads 0xff with CPU0 alone, CPU1-7 and the clusters only). The status words, the external
buck isolation word before and after, and the PSCI path's result are
logged with the kick-to-WFI line. A powered-down period also needs CPU0 to be the only online CPU, the
observer's CPU8 included. After the warm boot the PCM-return status is
polled for up to 5 ms, since the program raises its interrupt last.
From a failed power-down to the PCM reset in spm_restore(), CPU0 takes no
WFI, so the kicked program cannot power it off without the firmware.
The cpuidle path is unchanged.
---
 drivers/soc/mediatek/mt6797-spm-sleep.c | 117 ++++++++++++++++++++++--
 1 file changed, 109 insertions(+), 8 deletions(-)

diff --git a/drivers/soc/mediatek/mt6797-spm-sleep.c b/drivers/soc/mediatek/mt6797-spm-sleep.c
index 8dde2dc8e..fd71c2057 100644
--- a/drivers/soc/mediatek/mt6797-spm-sleep.c
+++ b/drivers/soc/mediatek/mt6797-spm-sleep.c
@@ -6,7 +6,8 @@
  * powered in WFI (SPM_FLAG_DIS_CPU_PDN) and a PCM-timer wake. The program
  * is not part of this driver: it is read at load time from the owner's own
  * copy of the vendor file and checked against its SHA-256. No PSCI or SiP
- * call is made.
+ * call is made, except PSCI CPU_SUSPEND in SODI test periods with
+ * sodi_cpu_pdn set.
  *
  * The register sequence follows the project's analysis in
  * docs/hardware/mt6797-spm-sleep.md and the S1 write list in
@@ -20,6 +21,7 @@
 #include <linux/bitops.h>
 #include <linux/backlight.h>
 #include <linux/bits.h>
+#include <linux/cpu_pm.h>
 #include <linux/cpufreq.h>
 #include <linux/cpuidle.h>
 #include <linux/debugfs.h>
@@ -39,6 +41,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm_qos.h>
 #include <linux/pm_runtime.h>
+#include <linux/psci.h>
 #include <linux/regmap.h>
 #include <linux/seq_file.h>
 #include <linux/smp.h>
@@ -265,6 +268,19 @@ MODULE_PARM_DESC(sodi_keep_26m, "SODI: set DIS_SRCCLKEN_LOW, so 26 MHz and infra
  * program's master pause (D5ap-D5as). This holds CPU0's policy at a floor
  * across each test period and refuses the period if CPU0 is not there.
  */
+/*
+ * The vendor's SODI powers CPU0 down instead of keeping it in WFI: flag bit
+ * 0 clear, then PSCI CPU_SUSPEND for the cluster, so CPU0 flushes, leaves
+ * coherency and waits in the secure firmware's WFI before the program pauses
+ * the bus masters; the program powers it back on at the wake and it resumes
+ * at cpu_resume. With a powered, coherent cluster, the pause hangs at low
+ * operating points (D5ap-D5ay). Test periods only (sodi_once_ms).
+ */
+static bool sodi_cpu_pdn;
+module_param(sodi_cpu_pdn, bool, 0644);
+MODULE_PARM_DESC(sodi_cpu_pdn, "SODI: power CPU0 down through PSCI CPU_SUSPEND in test periods, as the vendor does");
+#define SODI_PSCI_CLUSTER_PDN	0x01010000
+
 static unsigned int sodi_min_khz;
 module_param(sodi_min_khz, uint, 0644);
 MODULE_PARM_DESC(sodi_min_khz, "SODI: hold CPU0 at this kHz or more across each test period, refusing it otherwise (0: off)");
@@ -529,6 +545,7 @@ struct spm_scen {
 	bool im_reuse;		/* IM slave mode when the program is resident (D5q) */
 	bool r7_vendor;		/* r7 starts from SPM_R7_VENDOR (D5r) */
 	bool vec_clear;		/* PCM_EVENT_VECTOR_EN 0 before the kick (D5r) */
+	bool cpu_pdn;		/* CPU0 down through PSCI CPU_SUSPEND (D6) */
 	bool ready;
 };
 
@@ -543,8 +560,10 @@ struct spm_wake {
 	u32 on_val0, on_val1;	/* r0 and r7 start values, at entry */
 	u32 r0, r7;		/* after the return */
 	u32 vec_en_reset, vec_en_kick;	/* PCM_EVENT_VECTOR_EN */
+	u32 cpu_pwr, cpu_pwr2, buck_iso;	/* at entry, with CPU0 powered down (D6) */
 	bool im_reused, im_stuck;
 	bool backstop;		/* CPU0's timer ended the wait, not the PCM */
+	int pdn_ret;		/* cpu_pm_enter or psci_cpu_suspend_enter result */
 	u32 rd_en, rd_pend;	/* CPU0's SGIs and PPIs at entry */
 	u64 isr_el1;		/* at entry */
 	u64 cnt_kick, cnt_return;	/* arch counter around the wait */
@@ -661,6 +680,21 @@ static inline void spm_wr(u32 off, u32 val)
  */
 #define SPM_PWR_STATUS		0x180
 #define SPM_PWR_STATUS_2ND	0x184
+#define CPU_PWR_STATUS		0x188
+#define CPU_PWR_STATUS_2ND	0x18c
+/*
+ * CPU_PWR_STATUS bits (program session, from the program and the secure
+ * firmware): CPU n at bit 15 - n, MP2_CPUSYS 17, MP1_CPUSYS 18 (inferred),
+ * MP0_CPUSYS 19, MCUSYS 21. The program powers off only CPU0, MP0, MP_TOP
+ * and MCUSYS, so everything else under MCUSYS must be off already.
+ */
+#define CPU_PWR_OTHERS		(GENMASK(14, 6) | BIT(17) | BIT(18))
+/*
+ * The second word's low byte reads 0xff with CPU0 alone (D6a's live read),
+ * so it is not per-CPU status there: check CPU1-7, MP1 and MP2 in it only.
+ */
+#define CPU_PWR2_OTHERS		(CPU_PWR_OTHERS & ~GENMASK(7, 0))
+#define CPU_EXT_BUCK_ISO	0x290
 #define PWR_DIS			BIT(3)
 #define MMSYS_CG_CON0		0x100
 #define MMSYS_CG_SET0		0x104
@@ -1154,7 +1188,9 @@ static int spm_run(const struct spm_scen *sc)
 	bool obs_cpu = obs.on && cpu_online(SODI_OBS_CPU);
 	bool mp2 = !obs_cpu && !READ_ONCE(sodi_no_mp2);
 	bool smi = false;
-	bool late = sc->cirq && READ_ONCE(sodi_acinactm_late);
+	bool pdn = sc->cpu_pdn;
+	/* The vendor sets ACINACTM only when CPU0 stays powered */
+	bool late = (sc->cirq && READ_ONCE(sodi_acinactm_late)) || pdn;
 	bool crumbs = sc->cirq && READ_ONCE(sodi_crumbs);
 	u32 smi_saved = 0;
 	int i;
@@ -1169,6 +1205,26 @@ static int spm_run(const struct spm_scen *sc)
 		return -EBUSY;
 	if (!spm_off(MD1_PWR_CON) || !spm_off(C2K_PWR_CON))
 		return -EBUSY;
+	/* MCUSYS goes off with CPU0: every other core and cluster must be off */
+	if (pdn) {
+		u32 st = spm_rd(CPU_PWR_STATUS), st2 = spm_rd(CPU_PWR_STATUS_2ND);
+
+		/* The observer's CPU8 included: the vendor has CPU0 alone */
+		if (num_online_cpus() != 1) {
+			dev_info(&s.pdev->dev, "sodi pdn: %u CPUs online, refused\n",
+				 num_online_cpus());
+			return -EBUSY;
+		}
+
+		if ((st & CPU_PWR_OTHERS) || (st2 & CPU_PWR2_OTHERS)) {
+			dev_info(&s.pdev->dev, "sodi pdn: CPU power status %08x %08x, buck iso %08x: another core or cluster is on, refused\n",
+				 st, st2, spm_rd(CPU_EXT_BUCK_ISO));
+			return -EBUSY;
+		}
+		s.wake.cpu_pwr = st;
+		s.wake.cpu_pwr2 = st2;
+		s.wake.buck_iso = spm_rd(CPU_EXT_BUCK_ISO);
+	}
 
 	/*
 	 * SODI: refuse the period if an enabled interrupt is already pending,
@@ -1400,14 +1456,49 @@ static int spm_run(const struct spm_scen *sc)
 	if (sc->idle)
 		ct_cpuidle_enter();
 	/* The loop's dsb completes these before the first WFI */
-	if (late) {
+	if (late && !pdn) {
 		writel(axi[0] | ACINACTM, s.mcucfg + MP0_AXI_CONFIG);
 		writel(axi[1] | ACINACTM, s.mcucfg + MP1_AXI_CONFIG);
 		if (mp2)
 			writel(axi[2] | ACINACTM | BIT(0), s.mcucfg + MP2_AXI_CONFIG);
 	}
 	s.wake.cnt_wfi = __arch_counter_get_cntvct();
-	for (i = 0; i < 1000000; i++) {
+	if (pdn) {
+		u64 end;
+
+		/*
+		 * The firmware flushes, leaves coherency and waits for the SPM.
+		 * If the power-down fails here, the kicked program is still
+		 * waiting for CPU0's standby with flag 0 clear, and CPU0's next
+		 * WFI would let it power CPU0 off with no firmware context. So
+		 * from here to spm_restore(), whose PCM reset stops the program,
+		 * interrupts stay off and CPU0 takes no WFI.
+		 */
+		dsb(sy);
+		s.wake.pdn_ret = cpu_pm_enter();
+		if (!s.wake.pdn_ret) {
+			/* psci_cpu_suspend_enter exists only with CONFIG_CPU_IDLE */
+			s.wake.pdn_ret = IS_ENABLED(CONFIG_CPU_IDLE) ?
+				psci_cpu_suspend_enter(SODI_PSCI_CLUSTER_PDN) : -EOPNOTSUPP;
+			cpu_pm_exit();
+		}
+		/*
+		 * The program raises its interrupt last, after powering CPU0 back
+		 * on and releasing the pause: give it up to 5 ms, without a WFI.
+		 * The CNTP backstop cannot fire while CPU0 is off.
+		 */
+		end = __arch_counter_get_cntvct() + arch_timer_get_cntfrq() / 200;
+		do {
+			if (spm_rd(SPM_IRQ_STA) & ISRS_PCM_RETURN) {
+				s.wake.returned = true;
+				s.im_resident = sc->im_ptr;
+				break;
+			}
+			cpu_relax();
+		} while (!s.wake.pdn_ret && __arch_counter_get_cntvct() < end);
+		i = 0;
+	}
+	for (i = 0; !pdn && i < 1000000; i++) {
 		/* Complete every register write before the SPM sees CPU0 in WFI */
 		dsb(sy);
 		wfi();
@@ -1701,9 +1792,11 @@ static void spm_log_wake(const char *what)
 		 s.wake.assert_pc);
 	dev_info(&s.pdev->dev, "%s: dummy1=%08x pasr_dpd_0=%08x\n", what, s.dummy1,
 		 spm_rd(SPM_PASR_DPD_0));
-	dev_info(&s.pdev->dev, "%s: kick to first WFI %llu ns\n", what,
-		 mul_u64_u64_div_u64(s.wake.cnt_wfi - s.wake.cnt_pcm_kick, NSEC_PER_SEC,
-				     arch_timer_get_cntfrq()));
+	dev_info(&s.pdev->dev, "%s: kick to first WFI %llu ns, cpu pdn %d ret %d, cpu power %08x %08x, buck iso %08x>%08x\n",
+		 what, mul_u64_u64_div_u64(s.wake.cnt_wfi - s.wake.cnt_pcm_kick, NSEC_PER_SEC,
+					   arch_timer_get_cntfrq()),
+		 !(s.sodi.flags & BIT(0)), s.wake.pdn_ret, s.wake.cpu_pwr, s.wake.cpu_pwr2,
+		 s.wake.buck_iso, spm_rd(CPU_EXT_BUCK_ISO));
 	dev_info(&s.pdev->dev, "%s: im fsm %08x>%08x after %u us, reused=%d stuck=%d\n",
 		 what, s.wake.im_fsm0, s.wake.im_fsm1, s.wake.im_us,
 		 s.wake.im_reused, s.wake.im_stuck);
@@ -1840,7 +1933,7 @@ static int sodi_once(u64 ms)
 	struct cpufreq_policy *hold;
 	struct i2c_adapter *i2c6;
 	enum sodi_no busy;
-	u64 cntv, cntp, left_us;
+	u64 cntv, cntp, cntv_cval, cntp_cval, left_us;
 	int ret;
 
 	if (!s.sodi.ready)
@@ -1879,6 +1972,9 @@ static int sodi_once(u64 ms)
 	s.sodi.im_reuse = READ_ONCE(sodi_im_reuse);
 	s.sodi.r7_vendor = READ_ONCE(sodi_r7_vendor);
 	s.sodi.vec_clear = READ_ONCE(sodi_vec_clear);
+	s.sodi.cpu_pdn = READ_ONCE(sodi_cpu_pdn);
+	if (s.sodi.cpu_pdn)
+		s.sodi.flags &= ~BIT(0);
 	if (s.sodi.pcm_wdt)
 		s.sodi.wake_src |= WAKE_PCM_WDT;
 	if (sodi_pdn)
@@ -1894,6 +1990,9 @@ static int sodi_once(u64 ms)
 					      arch_timer_get_cntfrq());
 	cntv = read_sysreg(cntv_ctl_el0);
 	cntp = read_sysreg(cntp_ctl_el0);
+	/* A powered-down CPU0 comes back with its timer registers reset */
+	cntv_cval = read_sysreg(cntv_cval_el0);
+	cntp_cval = read_sysreg(cntp_cval_el0);
 	write_sysreg(cntv | ARCH_TIMER_CTRL_IT_MASK, cntv_ctl_el0);
 	write_sysreg(cntp | ARCH_TIMER_CTRL_IT_MASK, cntp_ctl_el0);
 	isb();
@@ -1914,6 +2013,8 @@ static int sodi_once(u64 ms)
 	else if (ret && !s.entered)
 		dev_info(&s.pdev->dev, "sodi: not entered (%d): CPU1-9 online, PCM busy, or modem or C2K on\n",
 			 ret);
+	write_sysreg(cntv_cval, cntv_cval_el0);
+	write_sysreg(cntp_cval, cntp_cval_el0);
 	write_sysreg(cntv, cntv_ctl_el0);
 	write_sysreg(cntp, cntp_ctl_el0);
 	isb();
-- 
2.43.0

