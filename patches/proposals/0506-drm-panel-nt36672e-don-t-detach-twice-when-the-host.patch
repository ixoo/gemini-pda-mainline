From c44405ee48299bcb8f53903dab357328cafd6e22 Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Mon, 2 Nov 2026 20:33:20 -0500
Subject: [PATCH] drm/panel: nt36672e: don't detach twice when the host goes
 first

mipi_dsi_host_unregister() detaches each device and then unregisters it, so
the panel's remove runs on a detached device and hits the WARN in
mipi_dsi_detach() when the DSI host module unloads first.
---
 drivers/gpu/drm/panel/panel-novatek-nt36672e.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36672e.c b/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
index a46a27d62..77937de61 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
@@ -998,7 +998,9 @@ static void nt36672e_panel_remove(struct mipi_dsi_device *dsi)
 {
 	struct nt36672e_panel *ctx = mipi_dsi_get_drvdata(dsi);
 
-	mipi_dsi_detach(ctx->dsi);
+	/* A host being unregistered has already detached its devices. */
+	if (ctx->dsi->attached)
+		mipi_dsi_detach(ctx->dsi);
 	drm_panel_remove(&ctx->panel);
 }
 
