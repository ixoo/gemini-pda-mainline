From c9fbd501a941f4b0c56c46d7243608c433166a60 Mon Sep 17 00:00:00 2001
From: Gemini bring-up archive <archive@example.invalid>
Date: Fri, 2 Oct 2026 18:36:03 -0400
Subject: [PATCH] wifi: mediatek: retarget isolated scan samples to early
 receive bytes

Use the existing bounded read-only sampler for two fixed early
management statistic words. Preserve its four-query limit, timings,
reply checks, credit accounting and retired scan lifetime.

The byte counters can wrap or reset; unchanged samples do not prove
radio silence and positive values do not prove host delivery.

Synthetic archive author; no DCO certification.
This is not an upstream submission.
---
 drivers/net/wireless/mediatek/mt6797/Kconfig  | 16 ++--
 drivers/net/wireless/mediatek/mt6797/hif.c    | 12 +--
 drivers/net/wireless/mediatek/mt6797/hif.h    |  6 +-
 drivers/net/wireless/mediatek/mt6797/mac.c    | 77 ++++++++++---------
 .../wireless/mediatek/mt6797/normal_command.h | 27 +++----
 5 files changed, 71 insertions(+), 67 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt6797/Kconfig b/drivers/net/wireless/mediatek/mt6797/Kconfig
index 5b49f43..5549c1e 100644
--- a/drivers/net/wireless/mediatek/mt6797/Kconfig
+++ b/drivers/net/wireless/mediatek/mt6797/Kconfig
@@ -45,22 +45,24 @@ config MT6797_PASSIVE_SCAN
 	bool "MT6797 one-shot passive mac80211 scan"
 	depends on MT6797_HIF_TC4_RECONCILE
 	default n
 	help
 	  Admit one standard station-type interface for one passive 2.4 GHz
 	  hardware scan, bounded to permitted channels with no probe requests.
 	  Poll RX and fresh TC4 accounting under the retained exclusive PIO
 	  owner while IRQs stay disabled. Validate native beacon descriptors and
 	  report them through cfg80211. Cancellation, timeout and failure abort
 	  the host request and retire its wire lifetime; they are not firmware
 	  stop acknowledgements. No association, key, data TX or DMA is provided.
 
-config MT6797_SCAN_TUNING_SAMPLE
-	bool "MT6797 bounded read-only scan tuning samples"
+config MT6797_SCAN_RX_SAMPLE
+	bool "MT6797 bounded read-only early receive samples"
 	depends on MT6797_PASSIVE_SCAN
 	default n
 	help
-	  During the sole passive scan, issue at most four read-only firmware
-	  RAM queries for two fixed channel-state words. Match exact replies
-	  within 100 ms using fresh shared command sequences. Samples are
-	  non-atomic software state, not proof of RF tuning or listening time.
-	  No arbitrary register access or register write interface is exposed.
+	  Read two fixed ordinary firmware RAM statistic words during one
+	  passive scan. Issue at most four queries with fresh shared command
+	  sequences and require each exact reply within 100 ms. These separate
+	  software samples contain eight-bit counters that can wrap or reset.
+	  Unchanged values cannot prove radio silence. Positive values cannot
+	  prove host delivery, frame validity or measured RF listening time.
+	  There is no arbitrary address or register write interface.
diff --git a/drivers/net/wireless/mediatek/mt6797/hif.c b/drivers/net/wireless/mediatek/mt6797/hif.c
index 889d5e7..871101f 100644
