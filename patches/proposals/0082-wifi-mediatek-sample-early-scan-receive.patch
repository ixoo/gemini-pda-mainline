@@ -630,47 +630,47 @@ int mt6797_hif_send_config(struct mt6797_hif *hif,
 					sizeof(hif->scratch), &transfer);
 	error = mt6797_normal_submitted(&hif->normal, error);
 	if (!error)
 		error = mt6797_hif_guard(hif);
 out:
 	if (error)
 		error = mt6797_hif_fail(hif, error);
 unlock:
 	mutex_unlock(&hif->mutex);
 	return error;
 }
 
-#if IS_ENABLED(CONFIG_MT6797_SCAN_TUNING_SAMPLE)
-int mt6797_hif_send_scan_tuning(struct mt6797_hif *hif, unsigned int role,
-				unsigned int sequence, u64 deadline_ns)
+#if IS_ENABLED(CONFIG_MT6797_SCAN_RX_SAMPLE)
+int mt6797_hif_send_scan_early_rx(struct mt6797_hif *hif, unsigned int role,
+				  unsigned int sequence, u64 deadline_ns)
 {
 	struct mt6797_hif_pio_result transfer;
 	struct mt6797_hif_command command;
 	int error;
 
-	if (!hif || !mt6797_scan_tuning_address(role) || sequence > 255)
+	if (!hif || !mt6797_scan_early_rx_address(role) || sequence > 255)
 		return -EINVAL;
 	if (!mutex_trylock(&hif->mutex))
 		return -EBUSY;
 	if (!hif->firmware_ready || !hif->capability_complete ||
 	    hif->transaction->phase != MT6797_INIT_IDLE ||
 	    hif->normal.phase != MT6797_NORMAL_NVRAM_SUBMITTED) {
 		error = -EIO;
 		goto unlock;
 	}
 	error = mt6797_hif_enter(hif, deadline_ns);
 	if (error)
 		goto out;
-	error = mt6797_normal_prepare_scan_tuning(&hif->normal, role, sequence,
-						  hif->scratch, sizeof(hif->scratch), &command);
+	error = mt6797_normal_prepare_scan_early_rx(&hif->normal, role, sequence,
+						    hif->scratch, sizeof(hif->scratch), &command);
 	if (error)
 		goto out;
 	error = mt6797_hif_pio_transfer(&hif->io, 0x34, MT6797_HIF_WRITE,
 					hif->scratch, 16, sizeof(hif->scratch), &transfer);
 	error = mt6797_normal_submitted(&hif->normal, error);
 	if (!error)
 		error = mt6797_hif_guard(hif);
 out:
 	if (error)
 		error = mt6797_hif_fail(hif, error);
 unlock:
 	mutex_unlock(&hif->mutex);
