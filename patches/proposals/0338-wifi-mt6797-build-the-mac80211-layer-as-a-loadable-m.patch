+	int ret;
+
+	mutex_lock(&mt6797_consys_wlan_lock);
+	ret = !owner->wlan_ready ? -ENODEV : owner->wlan_attached ? -EBUSY : 0;
+	if (ret)
+		goto out;
+	/* One attempt: a failed attach may leave firmware state behind. */
+	owner->wlan_attached = true;
+	dev = owner->wlan_dev;
+	ret = mt6797_wifi_record_prepare(dev, &record);
+	dev_info(dev, "one-shot WLAN private record prepare: status=%d\n", ret);
+	if (!ret) {
+		ret = ops->reg(dev, owner->fw_hif, &owner->wlan_capability,
+			       record, &owner->wlan_hw);
+		dev_info(dev, "one-shot WLAN regulatory configuration: status=%d\n",
+			 ret);
+	}
+	mt6797_wifi_record_release(record);
+	if (ret)
+		goto out;
+#if IS_ENABLED(CONFIG_MT6797_HIF_TX_STATUS_PROBE)
+	/* The only later normal sender is the RTNL-serialized notifier. */
+	rtnl_lock();
+	ret = mt6797_consys_observe_tx_status(dev, owner, true);
+	rtnl_unlock();
+	if (ret)
+		goto out;
+#if IS_ENABLED(CONFIG_MT6797_PASSIVE_SCAN)
+	ops->scan_ready(owner->wlan_hw);
+#endif
+#endif
+out:
+	mutex_unlock(&mt6797_consys_wlan_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_wlan_attach);
+#endif
