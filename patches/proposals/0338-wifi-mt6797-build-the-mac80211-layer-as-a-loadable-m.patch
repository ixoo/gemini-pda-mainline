@@ -26,4 +26,21 @@ int mt6797_mac_register(struct device *dev, struct mt6797_hif *hif,
  */
 void mt6797_mac_scan_ready(struct ieee80211_hw *hw);
 
+/* The mac80211 layer's entry points, built in or in the mac module. */
+struct mt6797_mac_ops {
+	int (*reg)(struct device *dev, struct mt6797_hif *hif,
+		   const struct mt6797_normal_capability *capability,
+		   const struct mt6797_wifi_record *record,
+		   struct ieee80211_hw **out);
+	void (*scan_ready)(struct ieee80211_hw *hw);
+};
+
+extern const struct mt6797_mac_ops mt6797_mac_attach_ops;
+
+/* Attach the mac80211 layer once to the firmware the CONSYS owner started:
+ * record, registration, the initial TC4 accounting pair, then scan ready.
+ * -ENODEV before the firmware is ready, -EBUSY after any attach.
+ */
+int mt6797_consys_wlan_attach(const struct mt6797_mac_ops *ops);
+
 #endif
