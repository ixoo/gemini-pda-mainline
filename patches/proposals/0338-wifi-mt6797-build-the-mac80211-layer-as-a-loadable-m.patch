+	.reg = mt6797_mac_register,
+	.scan_ready = mt6797_mac_scan_ready,
+};
+
+#if IS_MODULE(CONFIG_MT6797_MAC80211)
+/* No module_exit: there is no detach yet, so the module stays loaded. */
+static int __init mt6797_mac_module_init(void)
+{
+	return mt6797_consys_wlan_attach(&mt6797_mac_attach_ops);
+}
+module_init(mt6797_mac_module_init);
+
+MODULE_DESCRIPTION("MT6797 WLAN mac80211 station driver");
+MODULE_LICENSE("GPL");
+#endif
