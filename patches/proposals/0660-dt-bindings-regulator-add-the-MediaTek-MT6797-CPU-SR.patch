From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Etienne <julien.etienne@gmail.com>
Date: Sun, 8 Nov 2026 14:40:26 -0500
Subject: [PATCH] dt-bindings: regulator: add the MediaTek MT6797 CPU SRAM LDO

Eight SoC-internal LDOs in INFRACFG_AO supply the SRAM of the MT6797
Cortex-A53 clusters and the CCI (VSRAM_L). They are set together through
the INFRACFG_AO system controller, so describe them as one regulator
with a phandle to it.
---
 .../mediatek,mt6797-cpu-sram-ldo.yaml         | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/mediatek,mt6797-cpu-sram-ldo.yaml

diff --git a/Documentation/devicetree/bindings/regulator/mediatek,mt6797-cpu-sram-ldo.yaml b/Documentation/devicetree/bindings/regulator/mediatek,mt6797-cpu-sram-ldo.yaml
new file mode 100644
index 000000000..2a1c58405
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/mediatek,mt6797-cpu-sram-ldo.yaml
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/mediatek,mt6797-cpu-sram-ldo.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 CPU SRAM LDO
+
+maintainers:
+  - Julien Etienne <julien.etienne@gmail.com>
+
+description:
+  Eight SoC-internal LDOs in INFRACFG_AO supply the SRAM of the two
+  Cortex-A53 clusters and the CCI (VSRAM_L). They are set together, as one
+  regulator, through the INFRACFG_AO system controller.
+
+allOf:
+  - $ref: regulator.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6797-cpu-sram-ldo
+
+  mediatek,infracfg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The INFRACFG_AO system controller.
+
+required:
+  - compatible
+  - mediatek,infracfg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    regulator-vsram-l {
+        compatible = "mediatek,mt6797-cpu-sram-ldo";
+        mediatek,infracfg = <&infrasys>;
+        regulator-name = "vsram_l";
+        regulator-min-microvolt = <1000000>;
+        regulator-max-microvolt = <1200000>;
+    };
+...
-- 
2.43.0

