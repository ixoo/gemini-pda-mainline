From 48a4fc1e09ed3eddbef36b6d5e472d91856c6ebc Mon Sep 17 00:00:00 2001
From: Gemini Mainline Experiment <gemini-mainline@example.invalid>
Date: Wed, 9 Sep 2026 04:05:23 -0400
Subject: [PATCH] pinctrl: mediatek: add MT6797 MSDC1 pull fields

Map the independent PUPD, R0 and R1 bits for GPIO129-134 in IOCFG_B
registers 0x100, 0x110 and 0x120. Select the PUPD/R0/R1 pull type for
these six pins and use the existing combo and advanced-pull callbacks.
Other pins retain unsupported pull configuration.

The vendor GPIO table and MMC register definitions agree on this map.
The retained MMC settings can be expressed using resistor selections;
no complete ohmic resistance table is inferred. This adds no board
state, bias tuning, Schmitt, delay or rail operation.

Apply after the earlier MT6797 MSDC1 field topics in this series.

Unsigned experiment draft; archive identity is non-certifying.
---
 drivers/pinctrl/mediatek/pinctrl-mt6797.c | 24 +++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/pinctrl/mediatek/pinctrl-mt6797.c b/drivers/pinctrl/mediatek/pinctrl-mt6797.c
index ac573c3..37c1744 100644
--- a/drivers/pinctrl/mediatek/pinctrl-mt6797.c
+++ b/drivers/pinctrl/mediatek/pinctrl-mt6797.c
@@ -48,6 +48,18 @@ static const struct mtk_pin_field_calc mt6797_pin_drv_range[] = {
 	PIN_FIELD_CALC(134, 134, 2, 0x1b0, 0x10, 27, 3, 32, 0),
 };
 
+static const struct mtk_pin_field_calc mt6797_pin_pupd_range[] = {
+	PIN_FIELD_CALC(129, 134, 2, 0x100, 0x10, 18, 1, 32, 0),
+};
+
+static const struct mtk_pin_field_calc mt6797_pin_r0_range[] = {
+	PIN_FIELD_CALC(129, 134, 2, 0x110, 0x10, 18, 1, 32, 0),
+};
+
+static const struct mtk_pin_field_calc mt6797_pin_r1_range[] = {
+	PIN_FIELD_CALC(129, 134, 2, 0x120, 0x10, 18, 1, 32, 0),
+};
+
 static const struct mtk_pin_reg_calc mt6797_reg_cals[PINCTRL_PIN_REG_MAX] = {
 	[PINCTRL_PIN_REG_MODE] = MTK_RANGE(mt6797_pin_mode_range),
 	[PINCTRL_PIN_REG_DIR] = MTK_RANGE(mt6797_pin_dir_range),
@@ -55,12 +67,19 @@ static const struct mtk_pin_reg_calc mt6797_reg_cals[PINCTRL_PIN_REG_MAX] = {
 	[PINCTRL_PIN_REG_DO] = MTK_RANGE(mt6797_pin_do_range),
 	[PINCTRL_PIN_REG_IES] = MTK_RANGE(mt6797_pin_ies_range),
 	[PINCTRL_PIN_REG_DRV] = MTK_RANGE(mt6797_pin_drv_range),
+	[PINCTRL_PIN_REG_PUPD] = MTK_RANGE(mt6797_pin_pupd_range),
+	[PINCTRL_PIN_REG_R0] = MTK_RANGE(mt6797_pin_r0_range),
+	[PINCTRL_PIN_REG_R1] = MTK_RANGE(mt6797_pin_r1_range),
 };
 
 static const char * const mt6797_pinctrl_register_base_names[] = {
 	"gpio", "iocfgl", "iocfgb", "iocfgr", "iocfgt",
 };
 
+static const unsigned int mt6797_pull_type[ARRAY_SIZE(mtk_pins_mt6797)] = {
+	[129 ... 134] = MTK_PULL_PUPD_R1R0_TYPE,
+};
+
 static const struct mtk_pin_soc mt6797_data = {
 	.reg_cal = mt6797_reg_cals,
 	.pins = mtk_pins_mt6797,
@@ -71,6 +90,11 @@ static const struct mtk_pin_soc mt6797_data = {
 	.nbase_names = ARRAY_SIZE(mt6797_pinctrl_register_base_names),
 	.drive_set = mtk_pinconf_drive_set_rev1,
 	.drive_get = mtk_pinconf_drive_get_rev1,
+	.pull_type = mt6797_pull_type,
+	.bias_set_combo = mtk_pinconf_bias_set_combo,
+	.bias_get_combo = mtk_pinconf_bias_get_combo,
+	.adv_pull_set = mtk_pinconf_adv_pull_set,
+	.adv_pull_get = mtk_pinconf_adv_pull_get,
 };
 
 static const struct of_device_id mt6797_pinctrl_of_match[] = {
