# Development station: the soak kernel with loadable modules. The MT6797
# Wi-Fi stack is three modules, none loaded at boot: the host interface core,
# the CONSYS owner (unloading it powers CONN off) and the mac80211 layer.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
CONFIG_MT6797_HIF_CORE=m
CONFIG_MTK_MT6797_CONSYS=m
CONFIG_MT6797_MAC80211=m
CONFIG_LOCALVERSION="-gemini-a53-station"
CONFIG_LOG_BUF_SHIFT=20
# Power off through the MT6351 RTC, as Gemian does (0342-0345), not PSCI.
CONFIG_POWER_RESET_MT6323=y
# Read-only charger status through /dev/i2c-N (2026-10-31-gemini-power-status).
CONFIG_I2C_CHARDEV=y
# Reviewed device-register reads with busybox devmem
# (2026-10-31-gemini-thermal-protection). RAM stays off-limits; driver-owned
# ranges such as TOPRGU stay reachable. Every write needs its own review.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
# With modules on, defconfig's =m options would become modules that nothing
# loads. Keep each one built in, as in the soak kernel without modules.
CONFIG_ALTERA_FREEZE_BRIDGE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_BTRFS_FS=y
CONFIG_COMMON_CLK_XLNX_CLKWZRD=y
CONFIG_COUNTER=y
CONFIG_CRC_CCITT=y
CONFIG_CROS_EC_CHARDEV=y
CONFIG_CROS_EC_RPMSG=y
CONFIG_CROS_KBD_LED_BACKLIGHT=y
CONFIG_CRYPTO_AES_ARM64_BS=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CHACHA20=y
