# Development station: the soak kernel with loadable modules. The MT6797
# Wi-Fi stack is three modules, none loaded at boot: the host interface core,
# the CONSYS owner (unloading it powers CONN off) and the mac80211 layer.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
CONFIG_MT6797_HIF_CORE=m
CONFIG_MTK_MT6797_CONSYS=m
CONFIG_MT6797_MAC80211=m
# Lid policy: backlight off and keyboard inhibited while closed. A module, so it
# can be reloaded without a boot; init loads it.
CONFIG_INPUT_GEMINI_LID=m
# The NT36772 touchscreen (2026-11-02-gemini-touchscreen-module). A module, so
# it can be reloaded without a boot; nothing loads it.
CONFIG_TOUCHSCREEN_NOVATEK_NT36XXX=m
# The I2C1 IMU and light/proximity sensor (2026-10-06-gemini-i2c1-sensors). Modules,
# so they can be reloaded without a boot; nothing loads them.
CONFIG_BMI160_I2C=m
CONFIG_STK3310=m
# The AW9120 indicator LEDs (2026-11-04-gemini-aw9120-leds). A module, so it can
# be reloaded without a boot; nothing loads it.
CONFIG_LEDS_AW9120=m
# The vibration motor on the MT6351 VIBR LDO (2026-11-05-gemini-vibrator). A
# module, so it can be reloaded without a boot; nothing loads it.
CONFIG_INPUT_REGULATOR_HAPTIC=m
# exFAT, the factory format of SDXC microSD cards (2026-11-05-gemini-microsd). A
# module, so nothing changes at boot; mount loads it. UTF-8 names need NLS_UTF8,
# built in so the module has no further dependency to load.
CONFIG_EXFAT_FS=m
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_UTF8=y
CONFIG_LOCALVERSION="-gemini-a53-station"
CONFIG_LOG_BUF_SHIFT=20
# Power off through the MT6351 RTC, as Gemian does (0342-0345), not PSCI.
CONFIG_POWER_RESET_MT6323=y
# Read-only charger status through /dev/i2c-N (2026-10-31-gemini-power-status).
CONFIG_I2C_CHARDEV=y
# Reviewed device-register reads with busybox devmem
# (2026-10-31-gemini-thermal-protection). RAM stays off-limits; driver-owned
# ranges such as TOPRGU stay reachable. Every write needs its own review.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
# SoC temperature and protection (2026-10-31-gemini-thermal-protection): the
# thermal core, the MT6797 AUXADC thermal variant and LK's devinfo
# calibration, all built in so protection is armed before userspace. A
# critical trip in the station DT powers off; the station DT also arms the
# 117 C hardware reset.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=10000
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
# CONFIG_MTK_LVTS_THERMAL is not set
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_ATAG_DEVINFO=y
# The battery NTC through the MT6351 AUXADC, and a kernel battery zone on it
# (generic ADC thermal) whose critical trip powers off, built in.
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6359_AUXADC=y
CONFIG_GENERIC_ADC_THERMAL=y
# The MT6351 fuel gauge as /sys/class/power_supply/battery (2026-10-31-gemini-fuel-gauge).
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_MT6351=y
# The charging guard in the BQ25896 driver, built in so it needs no userspace
# (2026-11-02-gemini-kernel-charge-guard). Emulation is only how a 50 C stop can
# be tested; it can mask the real reading below 60 C, so it goes once proven.
CONFIG_CHARGER_BQ25890=y
CONFIG_THERMAL_EMULATION=y
# With modules on, defconfig's =m options would become modules that nothing
# loads. Keep each one built in, as in the soak kernel without modules.
CONFIG_ALTERA_FREEZE_BRIDGE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_BTRFS_FS=y
CONFIG_COMMON_CLK_XLNX_CLKWZRD=y
CONFIG_COUNTER=y
CONFIG_CRC_CCITT=y
CONFIG_CROS_EC_CHARDEV=y
CONFIG_CROS_EC_RPMSG=y
CONFIG_CROS_KBD_LED_BACKLIGHT=y
CONFIG_CRYPTO_AES_ARM64_BS=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_DEV_AMLOGIC_GXL=y
CONFIG_CRYPTO_DEV_CCREE=y
CONFIG_CRYPTO_DH=y
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ENGINE=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_KPP=y
CONFIG_CRYPTO_KPP2=y
CONFIG_CRYPTO_LIB_BLAKE2B=y
CONFIG_CRYPTO_LIB_CHACHA=y
CONFIG_CRYPTO_LIB_DES=y
CONFIG_CRYPTO_LIB_MD5=y
CONFIG_CRYPTO_LIB_SHA1=y
CONFIG_CRYPTO_LIB_SHA3=y
CONFIG_CRYPTO_LIB_SHA512=y
CONFIG_CRYPTO_LIB_SM3=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SM3=y
CONFIG_CRYPTO_SM4=y
CONFIG_CRYPTO_SM4_GENERIC=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CUSE=y
CONFIG_DEVFREQ_GOV_PASSIVE=y
CONFIG_FPGA_BRIDGE=y
CONFIG_FPGA_REGION=y
CONFIG_FUSE_FS=y
CONFIG_GNSS=y
CONFIG_GNSS_MT6797=m
CONFIG_GNSS_MTK_SERIAL=y
CONFIG_GNSS_SERIAL=y
CONFIG_GOOGLE_CBMEM=y
CONFIG_GOOGLE_COREBOOT_TABLE=y
CONFIG_GPIO_AGGREGATOR=y
CONFIG_GPIO_ALTERA=y
CONFIG_GPIO_WCD934X=y
CONFIG_GPIO_XILINX=y
CONFIG_GREYBUS=y
CONFIG_GREYBUS_BEAGLEPLAY=y
CONFIG_HID_MULTITOUCH=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_PWM_BEEPER=y
CONFIG_INPUT_PWM_VIBRA=y
CONFIG_INPUT_SPARSEKMAP=y
CONFIG_IPMI_DEVICE_INTERFACE=y
CONFIG_IPMI_HANDLER=y
CONFIG_IPMI_SI=y
CONFIG_IR_GPIO_CIR=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_CROS_EC=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_LZ4_COMPRESS=y
CONFIG_MFD_WCD934X=y
CONFIG_MHI_BUS=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_OF_FPGA_REGION=y
CONFIG_OVERLAY_FS=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PWM_CROS_EC=y
CONFIG_PWM_MEDIATEK=y
CONFIG_PWM_MTK_DISP=y
CONFIG_PWM_XILINX=y
CONFIG_QCOM_PBS=y
CONFIG_RAID6_PQ=y
CONFIG_RAID_ATTRS=y
CONFIG_RC_CORE=y
CONFIG_RC_MAP=y
CONFIG_REGMAP_SLIMBUS=y
CONFIG_RESET_GPIO=y
CONFIG_RPMSG_CTRL=y
CONFIG_SENSORS_GPIO_FAN=y
CONFIG_SENSORS_PWM_FAN=y
CONFIG_SLIMBUS=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_STM=y
CONFIG_STM_PROTO_BASIC=y
CONFIG_STM_PROTO_SYS_T=y
CONFIG_TCG_TIS=y
CONFIG_TCG_TIS_CORE=y
CONFIG_UACCE=y
CONFIG_XILINX_PR_DECOUPLER=y
CONFIG_XILINX_SDFEC=y
CONFIG_XILINX_VCU=y
CONFIG_XILINX_WATCHDOG=y
CONFIG_XILINX_WINDOW_WATCHDOG=y
CONFIG_XOR_BLOCKS=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_ZSTD_COMPRESS=y
# Audio (2026-11-01-gemini-audio-station): modules, so nothing touches the AFE,
# the codec or the amplifier GPIOs until they are loaded.
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_MT6797=m
CONFIG_SND_SOC_MT6797_MT6351=m
CONFIG_SND_SOC_MT6351=m
CONFIG_SND_SOC_AW8738=m
# iwd, the Arch root's Wi-Fi daemon (2026-11-06-gemini-arch-root), does its WPA
# key derivation through AF_ALG hashes and ciphers and the keyctl DH operation.
# Userspace interfaces only; no driver changes. CRYPTO_USER_API is what the two
# AF_ALG options select; it is named here to override gemini-usbdiag.fragment's
# minimal-network "not set" from the July handoff diagnostic.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
# Suspend to idle and its wake sources (2026-11-06-gemini-power-management).
# The secure firmware has no PSCI SYSTEM_SUSPEND, so s2idle is the only state;
# CPU idle stays off because its power-down states need the vendor SPM program.
# PM_DEBUG gives /sys/power/pm_test, so a first run can stop before the CPUs
# idle. The MT6351 RTC gives rtcwake an alarm to end a test suspend.
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
# Landlock, which pacman 7 needs to sandbox its downloads on the Arch root
# (2026-11-06-gemini-arch-root); CONFIG_LSM already lists it. POSIX message
# queues complete the IPC namespace and back systemd's /dev/mqueue; named here
# to override gemini-usbdiag.fragment's "not set". Userspace interfaces only.
CONFIG_SECURITY_LANDLOCK=y
CONFIG_POSIX_MQUEUE=y
