# One-shot device candidate for the isolated third physical reader. Resolve all
# three suppliers before capture, replay the qualified platform/provider prefix,
# bracket exactly one protected-clock call with the GAPC ledger, and never retry.
CONFIG_MODULES=y
CONFIG_MTK_MT6797_A72_PLATFORM_STATE=y
CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND=y
CONFIG_MTK_MT6797_DVFSP_BIGIDVFS_BACKEND=y
CONFIG_MTK_MT6797_A72_PLATFORM_PROVIDER_CLOCK_OBSERVER=y
CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_LEDGER=y
CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_CLOCK_LEDGER=y

# Keep predecessor observers, conflicting ledgers, every writer, and every
# action path absent. The BigiDVFS backend remains built as the qualified
# baseline but this observer has no BigiDVFS call.
# CONFIG_MTK_MT6797_A72_PLATFORM_PROVIDER_SNAPSHOT_OBSERVER is not set
# CONFIG_MTK_MT6797_A72_PLATFORM_SNAPSHOT_OBSERVER is not set
# CONFIG_PSTORE_GEMINI_A72_PLATFORM_PROVIDER_SNAPSHOT_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_PLATFORM_SNAPSHOT_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_PRECAPTURE_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER is not set
# CONFIG_PSTORE_GEMINI_PRE_RAMOOPS_LEDGER is not set
# CONFIG_PSTORE_GEMINI_ARM64_ENTRY_LEDGER is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_PROBE_GATE_LEDGER is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_STAGE_CONTROL is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_PREFIX_CONTROL is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_MAP_CONTROL is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_RAW_ENTRY_LEDGER is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_RAW_WRITE_QUALIFICATION is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_FIRST_DMESG_WRITE_QUALIFICATION is not set
# CONFIG_PSTORE_GEMINI_CLOCK_BACKEND_ENTRY_LEDGER is not set
# CONFIG_PSTORE_GEMINI_CLOCK_BACKEND_FIRST_DMESG_ENTRY_QUALIFICATION is not set
# CONFIG_PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION is not set
# CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER is not set
# CONFIG_MTK_MT6797_PROTECTED_READBACK_OBSERVER is not set
# CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR is not set
# CONFIG_ARM64_MT6797_A72_BOOTSTRAP_PUBLISHER is not set
# CONFIG_REGULATOR_DA9213_LEGACY_POSITIVE_PROVIDER_TRANSACTION is not set
# CONFIG_MTK_MT6797_I2C6_FW_WRITER_TRANSACTION_WINDOW is not set
# CONFIG_REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE is not set
# CONFIG_KUNIT is not set
CONFIG_LOCALVERSION="-gemini-a72-clock-third"
