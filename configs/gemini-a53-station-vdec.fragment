# Development station: the MT6797 video decoder resource probe (Stage 1 of
# experiments/2026-11-09-mt6797-video-codec). Both are modules loaded by hand;
# nothing loads them at boot. The VDECSYS clock driver powers the VDEC domain
# through runtime PM (0697); the probe reads registers only (0698).
CONFIG_COMMON_CLK_MT6797_VDECSYS=m
CONFIG_MTK_MT6797_VDEC_PROBE=m
