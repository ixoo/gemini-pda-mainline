# Candidate AP PM-audit is compile/link evidence only. It must never be
# assembled into an Android boot container, installed, or booted. Enabling
# system sleep here makes the provider/consumer ordering callbacks auditable.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND_FREEZER=y
# CONFIG_HIBERNATION is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_PM_USERSPACE_AUTOSLEEP is not set
