# Development-only eMMC access for the retained Gemini mmc0 DT node.
# This exposes ordinary Linux block devices in the initramfs so a separate,
# explicitly guarded USB-side tool can inspect or write a named boot partition.
# It does not mount a filesystem, select a slot, or perform any write itself.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y

# Keep unrelated host-controller families out of the fixed-size LK image.
# MMC_MTK selects only the CQHCI/HSQ support it needs.
# CONFIG_MMC_ARMMMCI is not set
# CONFIG_MMC_DW is not set
# CONFIG_MMC_DW_EXYNOS is not set
# CONFIG_MMC_DW_HI3798CV200 is not set
# CONFIG_MMC_DW_K3 is not set
# CONFIG_MMC_DW_PLTFM is not set
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SDHCI_CADENCE is not set
# CONFIG_MMC_SDHCI_F_SDH30 is not set
# CONFIG_MMC_SDHCI_OF_ARASAN is not set
# CONFIG_MMC_SDHCI_OF_DWCMSHC is not set
# CONFIG_MMC_SDHCI_PLTFM is not set
# CONFIG_MMC_SDHCI_XENON is not set
# CONFIG_MMC_STM32_SDMMC is not set
