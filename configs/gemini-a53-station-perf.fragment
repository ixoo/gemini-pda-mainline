# Profiling and power analysis on the station and the Arch card root (owner,
# 2026-11-07): perf, ftrace and trace-cmd, and powertop, which reads the power
# tracepoints. gemini-handoff.fragment turns these off for the bring-up images.
# mt6797's device tree has no CPU PMU node yet, so perf has software events,
# tracepoints and timer sampling, not hardware counters; ARM_PMUV3 is here for
# when that node is added.
CONFIG_PERF_EVENTS=y
CONFIG_PROFILING=y
CONFIG_ARM_PMU=y
CONFIG_ARM_PMUV3=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
