# Display H2: board-services RTC scope plus legacy SCPSYS in adopt mode.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
# CONFIG_RTC_NVMEM is not set
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
# MTK_SCPSYS selects MTK_INFRACFG: a bus-protection helper library whose
# only init code targets MT8192; its helpers run only on SCPSYS power on/off,
# which adopt mode never calls at probe.
CONFIG_MTK_INFRACFG=y
CONFIG_MTK_SCPSYS=y
CONFIG_MTK_SCPSYS_ADOPT_BOOT_STATE=y
CONFIG_LOCALVERSION="-gemini-a53-display-h2-compile"
