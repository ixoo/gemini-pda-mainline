# C1: power-key child, enabled lid and a bounded PMIC baseline at probe.
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
# Preserve the foundation NVMEM exclusion; no RTC storage window is needed.
# CONFIG_RTC_NVMEM is not set
# Time synchronisation is outside the first RTC observation protocol.
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
# Compile IRQ wake-error handling; suspend/wake testing remains separate.
CONFIG_PM=y
CONFIG_SUSPEND=y
# Experiment-only ten-word MT6351 read before IRQ setup; no writes.
CONFIG_MFD_MT6351_BASELINE_OBSERVER=y
# GPIO66 level for the lid test through /sys/kernel/debug/gpio.
CONFIG_DEBUG_FS=y
# Read-only EINT register snapshot for the lid test.
CONFIG_EINT_MTK_SNAPSHOT=y
# One-shot level-low lid EINT delivery probe; its DT node stays disabled.
CONFIG_GEMINI_LID_EINT_PROBE=y
CONFIG_LOCALVERSION="-gemini-a53-c1-compile"
