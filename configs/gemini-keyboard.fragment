# Candidate Q/U keyboard-only override. Apply after the exact Candidate P
# rotation profile. Keep every input-path driver built in because modules are
# disabled, and prevent VT blanking for the supervised local tty1 shell.
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_PINCTRL_AW9523=y
CONFIG_KEYBOARD_MATRIX=y

# CONFIG_I2C_CHARDEV is not set
# CONFIG_I2C_CADENCE is not set
# CONFIG_I2C_DESIGNWARE_PLATFORM is not set
# CONFIG_I2C_GPIO is not set
# CONFIG_I2C_MUX_PCA954x is not set
# CONFIG_I2C_MUX_PINCTRL is not set
# CONFIG_I2C_RK3X is not set
# CONFIG_I2C_SLAVE is not set
# CONFIG_I2C_XILINX is not set

# Enabling the I2C core makes numerous arm64 defconfig defaults visible. Keep
# Candidate Q/U policy boundary explicit: only the MT65xx controller, AW9523
# expander, and matrix keyboard are added to Candidate P.
# CONFIG_BACKLIGHT_LP855X is not set
# CONFIG_BATTERY_BQ27XXX_I2C is not set
# CONFIG_BATTERY_MAX17042 is not set
# CONFIG_BATTERY_SBS is not set
# CONFIG_CEC_NXP_TDA9950 is not set
