# A41 source-only runtime-evidence ownership boundary. The core seals an empty
# private record and rejects profile-authored runtime observations; the fixture
# remains evaluator-only, maxcpus=8 is inherited, and CPU admission stays shut.
CONFIG_ARM64_MT6797_A72_CAPABILITY_PROFILE=y
CONFIG_ARM64_MT6797_A72_FIXTURE_EVIDENCE=y
CONFIG_LOCALVERSION="-gemini-a41-owner-blocked"
