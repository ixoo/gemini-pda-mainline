# Isolated compile-only provider lifecycle review; never a device candidate.
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT6797=y
CONFIG_MFD_SYSCON=y
CONFIG_MTK_SCPSYS=y
CONFIG_PM=y
CONFIG_REGULATOR=y
CONFIG_LOCALVERSION="-mt6797-provider-compile"
