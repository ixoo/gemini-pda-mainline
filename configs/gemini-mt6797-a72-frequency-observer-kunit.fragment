# Hardware-free proof of the bounded MT6797 A72 frequency observer. The
# focused suite injects its protected-clock and BigiDVFS records. QEMU has no
# MT6797 platform device, and no MMIO, secure call, CPU, retained-memory,
# storage, network, or device action is reachable.
CONFIG_KUNIT=y
CONFIG_MTK_MT6797_A72_PLATFORM_STATE=y
# CONFIG_MTK_MT6797_A72_PLATFORM_STATE_KUNIT_TEST is not set
CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND=y
CONFIG_MTK_MT6797_DVFSP_BIGIDVFS_BACKEND=y
CONFIG_MTK_MT6797_A72_HOTPLUG_EXECUTOR=y
# CONFIG_MTK_MT6797_A72_HOTPLUG_EXECUTOR_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_HOTPLUG_SNAPSHOT=y
# CONFIG_MTK_MT6797_A72_HOTPLUG_SNAPSHOT_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_FREQUENCY_OBSERVER=y
CONFIG_MTK_MT6797_A72_FREQUENCY_OBSERVER_KUNIT_TEST=y
# CONFIG_MTK_MT6797_DVFSP_CLOCK_STATE_KUNIT_TEST is not set
# CONFIG_REGULATOR_DA9213_LEGACY_PROVIDER_SNAPSHOT_KUNIT_TEST is not set
# CONFIG_REGULATOR_DA9213_LEGACY_POSITIVE_PROVIDER_KUNIT_TEST is not set
# CONFIG_ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST is not set
# CONFIG_HOTPLUG_SPLIT_STARTUP is not set
CONFIG_LOCALVERSION="-gemini-mt6797-a72-frequency-observer-kunit"
