# Distribution service facilities on the frozen A53 foundation; compile only.
CONFIG_NET_NS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
# udev no longer implements the legacy sysfs firmware fallback.
# CONFIG_FW_LOADER_USER_HELPER is not set
CONFIG_LOCALVERSION="-gemini-a53-service-facilities"
