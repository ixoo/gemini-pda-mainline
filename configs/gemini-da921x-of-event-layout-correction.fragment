# Experiment-only correction of the ordered real-OF event layout.
CONFIG_I2C_GEMINI_DA921X_DUAL_MODALIAS_STATE_DIAGNOSTIC=y
CONFIG_I2C_GEMINI_DA921X_ROOT_PATH_CORRECTION_DIAGNOSTIC=y
CONFIG_I2C_GEMINI_DA921X_VALIDATION_STAGE_DIAGNOSTIC=y
CONFIG_I2C_GEMINI_DA921X_ENVELOPE_STATE_DIAGNOSTIC=y
CONFIG_I2C_GEMINI_DA921X_ENTRY_CLASSIFICATION_DIAGNOSTIC=y
CONFIG_I2C_GEMINI_DA921X_OF_EVENT_LAYOUT_CORRECTION_DIAGNOSTIC=y
CONFIG_LOCALVERSION="-gemini-da921x-ofevent"
