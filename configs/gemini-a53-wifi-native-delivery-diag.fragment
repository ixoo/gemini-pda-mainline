# Default-off native-crypto-delivery diagnostic (proposal 0181), armed.
#
# Builds the diagnostic into the station-join kernel (it is inert at CONFIG and
# at boot unless the read-only boot parameter arms it) and force-arms it on the
# command line so the one-shot post-association window runs during the reviewed
# C2 join. The parameter name is mac.native_delivery_diag (KBUILD_MODNAME 'mac',
# the module_param is 0444/read-only). Everything else is the reviewed
# station-join (phase-b) base: this fragment is applied last.
#
# clk_ignore_unused is preserved and PSCI stays enabled (CONFIG_ARM_PSCI_FW is
# not touched). The USB-gadget diagnostic link carries a distinct native-delivery
# identity so the laptop can tell this boot apart. No driver behaviour beyond the
# admitted default-off diagnostic is added; no IRQ/DMA, no new command.
CONFIG_LOCALVERSION="-gemini-a53-wifi-native-delivery-diag"
CONFIG_MT6797_NATIVE_DELIVERY_DIAG=y
CONFIG_CMDLINE="console=ttyS0,921600n8 earlycon maxcpus=8 nokaslr ignore_loglevel loglevel=8 log_buf_len=1M initcall_debug rdinit=/init panic=0 g_ether.dev_addr=42:00:15:19:82:01 g_ether.host_addr=42:00:15:19:82:00 g_ether.iManufacturer=gemini-pda-mainline g_ether.iProduct=Gemini-Native-Delivery-Diag g_ether.iSerialNumber=GEMINI_NATIVE_DELIVERY_20261012 clk_ignore_unused fbcon=rotate:3 consoleblank=0 fbcon=font:TER16x32 mac.native_delivery_diag=1"
CONFIG_CMDLINE_FORCE=y
