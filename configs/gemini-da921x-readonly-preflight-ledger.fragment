# Gate-6 read-only attribution child of the runtime-proven LK-clock provider
# baseline. Record at most 32 fixed transfer entries and read the five exact
# DA921x preflight registers twice. Neither option can trigger a transfer or
# expose a writable provider operation.
CONFIG_I2C_MT65XX_GEMINI_LIFECYCLE_ORACLE=y
CONFIG_I2C_MT65XX_GEMINI_ENTRY_LEDGER=y
CONFIG_REGULATOR_DA9213_LEGACY_PREFLIGHT=y
CONFIG_LOCALVERSION="-gemini-da921x-preflight"
