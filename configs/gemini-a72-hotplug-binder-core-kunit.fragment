# Hardware-free proof for the disconnected one-task CPU9 hotplug binder core.
# The focused suite injects the parent proof, record-4 publication, CPU9 down,
# CPU9 restore, and terminal operations. No production caller invokes the core,
# so this profile performs no CPU request, PSCI, MMIO, retained-RAM, watchdog,
# network, storage, or device action.
CONFIG_KUNIT=y
CONFIG_ARM64_MT6797_A72_P24_TRANSACTION_OWNER_MODEL=y
CONFIG_ARM64_MT6797_A72_CPU9_MEMBERSHIP=y
# CONFIG_ARM64_MT6797_A72_P24_OWNER_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER_KUNIT_TEST is not set
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_GEMINI_TRANSITION_LEDGER=y
# CONFIG_PSTORE_GEMINI_TRANSITION_LEDGER_KUNIT_TEST is not set
CONFIG_PSTORE_GEMINI_CPU9_TRANSITION_LEDGER=y
# CONFIG_PSTORE_GEMINI_CPU9_TRANSITION_LEDGER_KUNIT_TEST is not set
CONFIG_PSTORE_GEMINI_CPU9_PROGRESS_LEDGER=y
# CONFIG_PSTORE_GEMINI_CPU9_PROGRESS_LEDGER_KUNIT_TEST is not set
CONFIG_PSTORE_GEMINI_A72_HOTPLUG_LEDGER=y
# CONFIG_PSTORE_GEMINI_A72_HOTPLUG_LEDGER_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_HOTPLUG_EXECUTOR=y
# CONFIG_MTK_MT6797_A72_HOTPLUG_EXECUTOR_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_HOTPLUG_SNAPSHOT=y
# CONFIG_MTK_MT6797_A72_HOTPLUG_SNAPSHOT_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_CPU8_OBSERVER=y
# CONFIG_MTK_MT6797_A72_CPU8_OBSERVER_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_RESTORE_EXECUTOR=y
# CONFIG_MTK_MT6797_A72_RESTORE_EXECUTOR_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_HOTPLUG_BINDER_CORE=y
CONFIG_MTK_MT6797_A72_HOTPLUG_BINDER_CORE_KUNIT_TEST=y
# CONFIG_HOTPLUG_SPLIT_STARTUP is not set
CONFIG_LOCALVERSION="-gemini-a72-hotplug-binder-core-kunit"
