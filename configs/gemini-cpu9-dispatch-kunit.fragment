# Hardware-free coverage for the retained-cluster CPU9 production dispatch.
# The CPU9 binder is linked to injected KUnit backends, while the candidate
# controller and every add_cpu caller remain absent. No physical CPU request,
# CPU_OFF, retry, watchdog, cluster effect, retained-RAM mapping, SMC call, or
# device action is reachable from this profile.
CONFIG_ARM64_MT6797_A72_DIRECT_STATE_COMPOSITOR=y
CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR=y
CONFIG_ARM64_MT6797_A72_BOOTSTRAP_PUBLISHER=y
CONFIG_ARM64_MT6797_A72_DERIVED_ADMISSION=y
CONFIG_ARM64_MT6797_A72_CPU9_MEMBERSHIP=y
CONFIG_PSTORE_GEMINI_CPU9_TRANSITION_LEDGER=y
# CONFIG_PSTORE_GEMINI_CPU9_TRANSITION_LEDGER_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR=y
CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR_KUNIT_TEST=y
CONFIG_MTK_MT6797_A72_CPU9_BINDER=y
CONFIG_MTK_MT6797_A72_CPU9_BINDER_KUNIT_TEST=y
CONFIG_LOCALVERSION="-gemini-cpu9-dispatch-kunit"
