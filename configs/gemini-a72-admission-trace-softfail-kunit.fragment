# Hardware-free coverage for live-only admission trace soft-failure policy.
# The base DT has no binder or controller node. All trace outcomes, source
# results, and CPU requests are injected. No physical retained RAM, MMIO,
# regulator/SMC call, CPU request, CPU_OFF, retry, reboot, storage, or device
# action is possible in this profile.
CONFIG_KUNIT=y
CONFIG_RESET_CONTROLLER=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG_RECOVERY_TAKEOVER=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_GEMINI_TRANSITION_LEDGER=y
# CONFIG_PSTORE_GEMINI_TRANSITION_LEDGER_KUNIT_TEST is not set
CONFIG_PSTORE_GEMINI_ADMISSION_TRACE=y
CONFIG_PSTORE_GEMINI_ADMISSION_TRACE_KUNIT_TEST=y
CONFIG_ARM64_MT6797_A72_DIRECT_STATE_COMPOSITOR=y
CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR=y
CONFIG_ARM64_MT6797_A72_BOOTSTRAP_PUBLISHER=y
CONFIG_ARM64_MT6797_A72_DERIVED_ADMISSION=y
# CONFIG_ARM64_MT6797_A72_DERIVED_ADMISSION_KUNIT_TEST is not set
CONFIG_MTK_MT6797_A72_PLATFORM_STATE=y
CONFIG_MTK_MT6797_A72_PLATFORM_EFFECTS=y
CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND=y
CONFIG_MTK_MT6797_DVFSP_BIGIDVFS_BACKEND=y
CONFIG_MTK_MT6797_A72_BIGIDVFS_SRAM_OWNER=y
CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR=y
CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER=y
CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y
CONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER=y
CONFIG_MTK_MT6797_A72_ADMISSION_LIVE_TRIGGER=y
CONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER_KUNIT_TEST=y
# CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER_KUNIT_TEST is not set
# CONFIG_HOTPLUG_SPLIT_STARTUP is not set
CONFIG_LOCALVERSION="-gemini-a72-admission-softtrace-kunit"
