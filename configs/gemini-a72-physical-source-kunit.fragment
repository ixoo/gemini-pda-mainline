# Hardware-free Phase B source composition. QEMU has no Gemini DT nodes; the
# focused suite replaces every component, checkpoint, and direct-runtime call
# with in-memory operations.
CONFIG_KUNIT=y
CONFIG_ARM64_MT6797_A72_DIRECT_STATE_COMPOSITOR=y
CONFIG_MTK_MT6797_A72_PLATFORM_STATE=y
CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND=y
CONFIG_MTK_MT6797_DVFSP_BIGIDVFS_BACKEND=y
CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y
CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_KUNIT_TEST=y
# CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER is not set
# CONFIG_MTK_MT6797_PROTECTED_READBACK_OBSERVER is not set
# CONFIG_MTK_MT6797_PROTECTED_READBACK_KUNIT_TEST is not set
# CONFIG_ARM64_MT6797_A72_DIRECT_STATE_KUNIT_TEST is not set
# CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR is not set
# CONFIG_REGULATOR_DA9213_LEGACY_POSITIVE_PROVIDER_TRANSACTION is not set
# CONFIG_MTK_MT6797_I2C6_FW_WRITER_TRANSACTION_WINDOW is not set
# CONFIG_REGULATOR_DA9213_LEGACY_PROVIDER_SNAPSHOT_KUNIT_TEST is not set
# CONFIG_REGULATOR_DA9213_LEGACY_POSITIVE_PROVIDER_KUNIT_TEST is not set
# CONFIG_REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE_KUNIT_TEST is not set
# CONFIG_REGULATOR_DA9213_LEGACY_SAME_VALUE_WRITE is not set
CONFIG_LOCALVERSION="-gemini-a72-physical-source-kunit"
