# One-boot physical CPU8 admission candidate. Keep the proven eight-A53
# serviceability baseline, enable the complete source-derived owner chain, and
# submit one same-task add_cpu(8) request through the DT-bound controller.
# CPU9, CPU_OFF, userspace trigger, retry, and KUnit policy remain absent.
CONFIG_MODULES=y
CONFIG_RESET_CONTROLLER=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG_RECOVERY_TAKEOVER=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_GEMINI_TRANSITION_LEDGER=y
CONFIG_ARM64_MT6797_A72_DIRECT_STATE_COMPOSITOR=y
CONFIG_ARM64_MT6797_A72_A34_ELIGIBILITY_EVALUATOR=y
CONFIG_ARM64_MT6797_A72_BOOTSTRAP_PUBLISHER=y
CONFIG_ARM64_MT6797_A72_DERIVED_ADMISSION=y
CONFIG_MTK_MT6797_A72_PLATFORM_STATE=y
CONFIG_MTK_MT6797_A72_PLATFORM_EFFECTS=y
CONFIG_MTK_MT6797_DVFSP_CLOCK_BACKEND=y
CONFIG_MTK_MT6797_DVFSP_BIGIDVFS_BACKEND=y
CONFIG_MTK_MT6797_A72_BIGIDVFS_SRAM_OWNER=y
CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR=y
CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER=y
CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_OBSERVER=y
CONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER=y

# The mutable transition ledger exclusively owns the first retained zone.
# CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_PHYSICAL_SOURCE_PRECAPTURE_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_GLOBAL_INITCALL_LEDGER is not set
# CONFIG_PSTORE_GEMINI_A72_EARLY_INITCALL_LEDGER is not set

# Keep every injected test suite and split-startup experiment out of the boot.
# CONFIG_KUNIT is not set
# CONFIG_ARM64_MT6797_A72_DERIVED_ADMISSION_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_ADMISSION_CONTROLLER_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_DEFAULT_OFF_BINDER_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_TRANSITION_EXECUTOR_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_PLATFORM_EFFECTS_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_BIGIDVFS_SRAM_OWNER_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_PHYSICAL_SOURCE_KUNIT_TEST is not set
# CONFIG_HOTPLUG_SPLIT_STARTUP is not set
CONFIG_LOCALVERSION="-gemini-a72-admission"
