# One-boot production CPU9 successor. Extend the exact proven CPU8 live
# admission candidate only after its terminal same-boot proof. CPU9 receives
# one retained-cluster CPU_ON attempt; cluster acquisition, provider changes,
# watchdog refresh, CPU_OFF, retry, and automatic probe action stay absent.
CONFIG_ARM64_MT6797_A72_CPU9_MEMBERSHIP=y
CONFIG_PSTORE_GEMINI_CPU9_TRANSITION_LEDGER=y
CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR=y
CONFIG_MTK_MT6797_A72_CPU9_BINDER=y
CONFIG_MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER=y

# Keep every CPU9 injected test suite out of the production boot.
# CONFIG_PSTORE_GEMINI_CPU9_TRANSITION_LEDGER_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_CPU9_EXECUTOR_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_CPU9_BINDER_KUNIT_TEST is not set
# CONFIG_MTK_MT6797_A72_CPU9_ADMISSION_CONTROLLER_KUNIT_TEST is not set
CONFIG_LOCALVERSION="-gemini-cpu9-controller"
