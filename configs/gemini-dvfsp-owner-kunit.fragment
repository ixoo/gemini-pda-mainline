# Hardware-free KUnit coverage for the dedicated MT6797 DVFSP owner boundary.
# The profile also selects the existing disabled-only handoff/readback objects
# needed to link the source pipeline; no DT node is enabled and the test uses
# only fake struct device references.
CONFIG_KUNIT=y
CONFIG_MTK_MT6797_DVFSP_OWNER_KUNIT_TEST=y
CONFIG_MTK_MT6797_DVFSP_PROVIDER_KUNIT_TEST=y
CONFIG_MTK_MT6797_DVFSP_VENDOR_OWNER=y
CONFIG_MTK_MT6797_DVFSP_VENDOR_OWNER_KUNIT_TEST=y
CONFIG_MTK_MT6797_DVFSP_VENDOR_PROVIDER_BRIDGE_KUNIT_TEST=y
CONFIG_MTK_MT6797_DVFSP_VENDOR_WRITER=y
CONFIG_MTK_MT6797_DVFSP_VENDOR_WRITER_KUNIT_TEST=y
CONFIG_MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE=y
CONFIG_LOCALVERSION="-gemini-dvfsp-owner-kunit"
