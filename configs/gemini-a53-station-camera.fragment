# The front camera (2026-11-04-gemini-camera). All modules, and nothing loads
# them at boot. Sensors are a separate menu behind the media filter.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_HI556=m
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_COMMON_CLK_MT6797_CAMSYS=m
CONFIG_VIDEO_MT6797_SENINF=m
# Enabling media exposes defconfig's other drivers; none is on this board.
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_VIDEO_CADENCE_CSI2RX is not set
# CONFIG_VIDEO_IMX219 is not set
# CONFIG_VIDEO_IMX412 is not set
# CONFIG_VIDEO_MAX96712 is not set
# CONFIG_VIDEO_OV5640 is not set
# CONFIG_VIDEO_OV5645 is not set
# CONFIG_VIDEO_S5KJN1 is not set
# libcamera's software ISP allocates its output through a DMA heap.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
