# MT6797 mac80211 station driver, single build arm. Replaces the chained
# experiment fragments: the driver's compile-time structure now follows
# CONFIG_MT6797_MAC80211 alone, and the retired diagnostics have no option.
# The command line keeps messages below warning level off the serial console;
# the RAM logger reads the ring buffer, so retained evidence is unchanged.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MT6797_MAC80211=y
CONFIG_PACKET=y
CONFIG_DEBUG_FS=y
# CONFIG_CFG80211_DEBUGFS is not set
# The release string stays the one every retained host and device-side
# check pins; the candidate is identified by its hashes and kernel notes.
CONFIG_LOCALVERSION="-gemini-a53-private-p2e-delivery"
CONFIG_CMDLINE="console=ttyS0,921600n8 earlycon maxcpus=8 nokaslr loglevel=4 log_buf_len=1M initcall_debug rdinit=/init panic=0 g_ether.dev_addr=42:00:15:19:82:01 g_ether.host_addr=42:00:15:19:82:00 g_ether.iManufacturer=gemini-pda-mainline g_ether.iProduct=Gemini-CCMP-Stable-Monitor g_ether.iSerialNumber=GEMINI_CCMP_STABLE_MONITOR_20261014 clk_ignore_unused fbcon=rotate:3 consoleblank=0 fbcon=font:TER16x32"
CONFIG_CMDLINE_FORCE=y
