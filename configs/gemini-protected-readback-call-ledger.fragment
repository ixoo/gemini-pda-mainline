# Candidate-only retained checkpoints around the first protected readback.
# This fragment must follow the exact protected-readback observer profile.
# Normal ramoops registration is intentionally withheld so known-good Gemian
# can recover the two owned records after a warm return.
# CONFIG_PSTORE_GEMINI_PRE_RAMOOPS_LEDGER is not set
# CONFIG_PSTORE_GEMINI_ARM64_ENTRY_LEDGER is not set
CONFIG_PSTORE_GEMINI_PROTECTED_READBACK_LEDGER=y
CONFIG_LOCALVERSION="-gemini-protected-readback-ledger"
