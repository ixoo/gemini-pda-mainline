#!/usr/bin/env python3
"""Generate or check the experiments index table in experiments/README.md.

Every ``experiments/YYYY-MM-DD-*/`` directory must have a README.md. The table
between the ``<!-- index:begin -->`` and ``<!-- index:end -->`` markers is
generated from each README's title and Status field; ``--check`` fails when a
directory lacks a README or the committed table is out of date. No network,
build or device access.
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
EXPERIMENTS = ROOT / "experiments"
INDEX = EXPERIMENTS / "README.md"
BEGIN = "<!-- index:begin -->"
END = "<!-- index:end -->"
VOCABULARY = ("planned", "running", "completed", "inconclusive", "superseded",
              "parked", "unstated")
# First matching group wins; the Status text is lower-cased before matching.
CLASSES = (
    ("superseded", r"supersed|retired|archiv|quarantin|withdrawn|obsolete|replaced by"),
    ("parked", r"\bparked|\bblocked|deferred|paused|on hold|shelved"),
    ("inconclusive", r"inconclusive|\bfail|\bstopped|rejected|refused|aborted|not established|unresolved|ambiguous"),
    ("completed", r"consumed|\bproven\b|complet|\bclosed\b|\bpassed\b|\bdone\b|\bpasses\b"),
    ("running", r"\brunning\b|in progress|in-progress|\bactive\b|collecting|awaiting|ongoing|\binstalled\b|pending (?:runtime|boot|owner|device|attended)"),
    ("planned", r"\bplanned\b|preparing|preparation in|checkpoint|\bunfinished|incomplete|design only"),
    ("completed", r"accepted|validated|measured|\bpass\b|recorded|confirmed|established|review|offline|bound|selected|admitted|attempt|\bbuilt\b|collected|identified|serviceable|implicated|reached|returned|verified|source-only"),
)


def title_of(text: str, fallback: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            title = line[2:].strip()
            title = re.sub(r"^(?:Experiment|Record|Review)\s*:\s*", "", title, flags=re.I)
            return title.replace("|", "\\|")
    return fallback


def status_text(text: str) -> str | None:
    match = re.search(r"(?m)^\|\s*Status\s*\|\s*(.+?)\s*\|\s*$", text)
    if match:
        return match.group(1)
    match = re.search(r"(?m)^(?:\*\*)?Status(?:\*\*)?\s*:\s*(.+)$", text)
    if match:
        return match.group(1)
    match = re.search(r"(?ms)^##+\s*Status\s*\n+(.+?)(?:\n\n|\Z)", text)
    if match:
        return match.group(1).replace("\n", " ")
    return None


def classify(raw: str | None) -> str:
    if raw is None:
        return "unstated"
    lowered = re.sub(r"[`\\*]", "", raw).lower()
    for word in VOCABULARY:
        if lowered.startswith(word):
            return word
    for word, pattern in CLASSES:
        if re.search(pattern, lowered):
            return word
    return "unstated"


def rows() -> tuple[list[str], list[str]]:
    lines: list[str] = []
    missing: list[str] = []
    for directory in sorted(p for p in EXPERIMENTS.iterdir() if p.is_dir()):
        if not re.match(r"\d{4}-\d{2}-\d{2}-", directory.name):
            continue
        readme = directory / "README.md"
        if not readme.is_file():
            missing.append(directory.name)
            continue
        text = readme.read_text(encoding="utf-8", errors="replace")
        date, slug = directory.name[:10], directory.name[11:]
        status = classify(status_text(text))
        title = title_of(text, slug)
        lines.append(f"| {date} | [{slug}]({directory.name}/README.md) | `{status}` | {title} |")
    return lines, missing


def render(lines: list[str]) -> str:
    counts: dict[str, int] = {}
    for line in lines:
        word = line.split("`")[1]
        counts[word] = counts.get(word, 0) + 1
    summary = ", ".join(f"{counts[w]} {w}" for w in VOCABULARY if w in counts)
    header = [
        BEGIN,
        f"{len(lines)} records, newest first: {summary}. Generated by",
        "`scripts/experiments-index`; edit the record READMEs, not this table.",
        "",
        "| Date | Record | Status | Title |",
        "| --- | --- | --- | --- |",
    ]
    return "\n".join(header + list(reversed(lines)) + [END])


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true",
                        help="fail if a README is missing or the index is stale")
    args = parser.parse_args()
    lines, missing = rows()
    text = INDEX.read_text(encoding="utf-8")
    if BEGIN not in text or END not in text or text.index(BEGIN) > text.index(END):
        print(f"error: {INDEX.relative_to(ROOT)} lacks the index markers", file=sys.stderr)
        return 1
    head, rest = text.split(BEGIN, 1)
    _, tail = rest.split(END, 1)
    updated = head + render(lines) + tail
    unstated = sum(1 for line in lines if "`unstated`" in line)
    if args.check:
        failed = False
        for name in missing:
            print(f"error: experiments/{name}/ has no README.md", file=sys.stderr)
            failed = True
        if updated != text:
            print("error: experiments/README.md index is stale; run scripts/experiments-index",
                  file=sys.stderr)
            failed = True
        print(f"experiments_indexed={len(lines)} unstated_status={unstated}")
        return 1 if failed else 0
    INDEX.write_text(updated, encoding="utf-8")
    for name in missing:
        print(f"warning: experiments/{name}/ has no README.md", file=sys.stderr)
    print(f"experiments_indexed={len(lines)} unstated_status={unstated} missing_readme={len(missing)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
