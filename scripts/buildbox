for marker in hardware_action=none device_action=none boot_candidate=false \
  physical_da921x_write_authorized=false p28_effect=false cpu_on=false \
  cpu_off=false; do
  grep -Fx "${marker}" "${package}/provenance/generation.txt" >/dev/null
