[[ -z "$(git -C "${checkout}" status --porcelain)" ]]

if [[ -f "${job_record}" ]] && jq -e \
  --arg commit "${commit}" --arg purpose "${purpose}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == $purpose
  ' "${job_record}" >/dev/null; then
  package="$(jq -er '.package' "${job_record}")"
  case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
  [[ -d "${package}" && ! -L "${package}" ]]
  (cd "${package}" && sha256sum --check --strict SHA256SUMS >/dev/null)
  printf 'buildbox_job=%s\nbuildbox_package=%s\n' "${job_key}" "${package}"
  exit 0
fi

rm -f "${job_record}.partial"
if ! output="$("${checkout}/${generator}" "${commit}" "${source_root}" "${artifact_root}")"; then
  printf '%s\n' "${output}" >&2
  printf 'error: A72 platform/provider readiness generator failed for %s\n' "${commit}" >&2
  exit 1
fi
printf '%s\n' "${output}"
package="$(printf '%s\n' "${output}" | sed -n \
  's/^Generated A72 platform\/provider readiness patches at //p' | tail -n 1)"
case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
[[ -d "${package}" && ! -L "${package}" ]]
(cd "${package}" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=3 provider_property=mediatek,provider \
  provider_compatible=dlg,da9214-legacy \
  provider_lookup=of_find_i2c_device_by_node provider_readiness=device_is_bound \
  provider_not_ready_result=-EPROBE_DEFER provider_not_ready_platform_calls=0 \
  provider_not_ready_checkpoint_calls=0 provider_not_ready_provider_calls=0 \
  platform_snapshot_calls=1 platform_samples=2 platform_register_observations=26 \
  provider_snapshots=1 provider_samples=2 provider_i2c_reads=10 \
  provider_i2c_writes=0 observer_retries=0 protected_clock_reads=0 \
  bigidvfs_reads=0 secure_calls=0 provider_acquires=0 provider_releases=0 \
  publisher_calls=0 owner_mutations=0 cpu_requests=0 hardware_free_tests=7 \
  device_action=none boot_candidate=false; do
  grep -Fx "${marker}" "${package}/provenance/generation.txt" >/dev/null
done
jq -n --arg status validated --arg repository_commit "${commit}" \
  --arg purpose "${purpose}" --arg package "${package}" \
  --arg package_name "$(basename "${package}")" \
  '{status: $status, repository_commit: $repository_commit,
    purpose: $purpose, package: $package, package_name: $package_name}' \
  >"${job_record}.partial"
mv "${job_record}.partial" "${job_record}"
printf 'buildbox_job=%s\nbuildbox_package=%s\n' "${job_key}" "${package}"
REMOTE
}

fetch_a72_platform_provider_ready_patches() {
  local destination job_info job_key package_name remote_command sha temporary

  require_command git
  require_command jq
  require_command sha256sum
  require_command ssh
  require_command tar
  sha="$(git -C "${REPO_DIR}" rev-parse HEAD)"
  [[ "${sha}" =~ ^[0-9a-f]{40}$ ]] || die "invalid HEAD commit"
  job_key="${sha}-a72-platform-provider-ready-patchgen"
  printf -v remote_command 'test -f %q && cat %q' \
    "/workspace/gemini-pda/jobs/${job_key}.json" \
    "/workspace/gemini-pda/jobs/${job_key}.json"
  job_info="$(ssh_buildbox "${remote_command}")" || \
    die "no completed A72 platform/provider readiness generation for ${sha}"
  printf '%s' "${job_info}" | jq -e --arg commit "${sha}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == "mainline-a72-platform-provider-ready-patch-generation" and
    (.package_name | test("^[A-Za-z0-9_.+-]+$"))
  ' >/dev/null || die "A72 platform/provider readiness job record is invalid"
  package_name="$(printf '%s' "${job_info}" | jq -er '.package_name')"
  destination="${REPO_DIR}/artifacts/buildbox/${sha}/${package_name}"
  [[ ! -e "${destination}" ]] || die "refusing to overwrite ${destination}"
  mkdir -p "$(dirname "${destination}")"
  temporary="$(mktemp -d "$(dirname "${destination}")/.fetch.XXXXXX")"
  trap 'test -n "${temporary:-}" && test -d "${temporary}" && rm -rf -- "${temporary}"' EXIT

  printf -v remote_command 'bash -s -- %q %q' "${job_key}" "${sha}"
  ssh_buildbox "${remote_command}" <<'REMOTE' | tar -C "${temporary}" -xf -
set -euo pipefail
readonly job_key="$1"
readonly commit="$2"
readonly artifact_root=/workspace/gemini-pda/a72-platform-provider-ready-artifacts
readonly record="/workspace/gemini-pda/jobs/${job_key}.json"
[[ -f "${record}" && ! -L "${record}" ]]
package="$(jq -er --arg commit "${commit}" '
  select(.status == "validated" and .repository_commit == $commit and
    .purpose == "mainline-a72-platform-provider-ready-patch-generation") | .package
' "${record}")"
case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
[[ -d "${package}" && ! -L "${package}" ]]
(cd "${package}" && sha256sum --check --strict SHA256SUMS >/dev/null)
grep -Fx "repository_commit=${commit}" "${package}/provenance/generation.txt" >/dev/null
grep -Fx 'generated_patch_count=3' "${package}/provenance/generation.txt" >/dev/null
tar -C "$(dirname "${package}")" -cf - -- "$(basename "${package}")"
REMOTE
  [[ -d "${temporary}/${package_name}" ]]
  (cd "${temporary}/${package_name}" &&
    sha256sum --check --strict SHA256SUMS >/dev/null &&
    grep -Fx "repository_commit=${sha}" provenance/generation.txt >/dev/null &&
    grep -Fx 'generated_patch_count=3' provenance/generation.txt >/dev/null)
  mv "${temporary}/${package_name}" "${destination}"
  rmdir "${temporary}"
  trap - EXIT
  printf 'Artifact fetched to %s\n' "${destination}"
}

generate_a72_platform_provider_clock_patches() {
  local branch
  local identity
  local remote_command
  local sha

  require_command git
  require_command jq
  require_command ssh
  identity="$(require_clean_pushed_head)"
  IFS=$'\t' read -r sha branch <<< "${identity}"
  printf -v remote_command 'bash -s -- %q %q' "${sha}" "${branch}"

  printf 'Submitting A72 platform/provider/clock generation %s to %s\n' \
    "${sha}" "${BUILDBOX_HOST}"
  ssh_buildbox "${remote_command}" <<'REMOTE'
set -euo pipefail
readonly commit="$1"
readonly branch="$2"
readonly remote_url=https://github.com/ixoo/gemini-pda-mainline.git
readonly persistent_root="${HOME}/gemini-pda-buildbox"
readonly mirror="${persistent_root}/repo.git"
readonly workspace_root=/workspace/gemini-pda
readonly checkout_root="${workspace_root}/checkouts"
readonly checkout="${checkout_root}/${commit}"
readonly source_parent_profile=a72-platform-provider-clock-generator-parent
readonly source_root="${workspace_root}/src/linux-7.1.3-series-a72-platform-provider-clock-parent-source"
readonly build_root="${workspace_root}/build"
readonly artifact_root="${workspace_root}/a72-platform-provider-clock-artifacts"
readonly job_root="${workspace_root}/jobs"
readonly job_key="${commit}-a72-platform-provider-clock-patchgen"
readonly job_record="${job_root}/${job_key}.json"
readonly purpose=mainline-a72-platform-provider-clock-patch-generation
readonly generator=experiments/2026-08-25-mainline-a72-platform-provider-protected-clock-third-read/scripts/generate-on-buildbox

mkdir -p "${persistent_root}" "${checkout_root}" "${artifact_root}" "${job_root}"
exec 9>"${persistent_root}/build.lock"
flock 9
if [[ ! -d "${mirror}" ]]; then
  if [[ -e "${mirror}.partial" ]]; then
    [[ -d "${mirror}.partial" && ! -L "${mirror}.partial" ]]
    rm -rf -- "${mirror}.partial"
  fi
  git clone --mirror "${remote_url}" "${mirror}.partial"
  mv "${mirror}.partial" "${mirror}"
fi
[[ "$(git --git-dir="${mirror}" remote get-url origin)" == "${remote_url}" ]]
git --git-dir="${mirror}" fetch --prune origin \
  "refs/heads/${branch}:refs/remotes/origin/${branch}"
[[ "$(git --git-dir="${mirror}" rev-parse "refs/remotes/origin/${branch}")" == "${commit}" ]]

if [[ ! -d "${checkout}" ]]; then
  for stale_partial in "${checkout}".partial.*; do
    [[ -d "${stale_partial}" && ! -L "${stale_partial}" ]] || continue
    rm -rf -- "${stale_partial}"
  done
  partial="${checkout}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' EXIT
  git clone --no-checkout "${mirror}" "${partial}"
  git -C "${partial}" checkout --detach "${commit}"
  [[ -z "$(git -C "${partial}" status --porcelain)" ]]
  mv "${partial}" "${checkout}"
  partial=""
  trap - EXIT
fi
[[ "$(git -C "${checkout}" rev-parse HEAD)" == "${commit}" ]]
[[ -z "$(git -C "${checkout}" status --porcelain)" ]]

if [[ -f "${job_record}" ]] && jq -e \
  --arg commit "${commit}" --arg purpose "${purpose}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == $purpose
  ' "${job_record}" >/dev/null; then
  package="$(jq -er '.package' "${job_record}")"
  case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
  [[ -d "${package}" && ! -L "${package}" ]]
  (cd "${package}" && sha256sum --check --strict SHA256SUMS >/dev/null)
  printf 'buildbox_job=%s\nbuildbox_package=%s\n' "${job_key}" "${package}"
  exit 0
fi

rm -f "${job_record}.partial"
env \
  KERNEL_PROFILE="${source_parent_profile}" \
  GEMINI_SOURCE_ROOT="${workspace_root}/src" \
  GEMINI_BUILD_ROOT="${build_root}" \
  GEMINI_ARTIFACT_ROOT="${workspace_root}/artifacts" \
  GEMINI_CACHE_ROOT="${HOME}/.cache/gemini-pda" \
  "${checkout}/scripts/kernel" prepare
if ! output="$("${checkout}/${generator}" "${commit}" "${source_root}" "${artifact_root}")"; then
  printf '%s\n' "${output}" >&2
  printf 'error: A72 platform/provider/clock generator failed for %s\n' "${commit}" >&2
  exit 1
fi
printf '%s\n' "${output}"
package="$(printf '%s\n' "${output}" | sed -n \
  's/^Generated A72 platform\/provider\/clock patches at //p' | tail -n 1)"
case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
[[ -d "${package}" && ! -L "${package}" ]]
(cd "${package}" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=4 retained_token=GAPC-20260825-A \
  retained_checkpoints=before-clock,after-clock retained_slots=1,2 \
  retained_maximum_write_attempts=2 dependency_sources_resolved_before_capture=3 \
  provider_compatible=dlg,da9214-legacy \
  clock_compatible=mediatek,mt6797-dvfsp-clock-backend \
  not_ready_result=-EPROBE_DEFER not_ready_hardware_calls=0 \
  not_ready_retained_writes=0 platform_snapshot_calls=1 platform_samples=2 \
  platform_register_observations=26 provider_snapshots=1 provider_samples=2 \
  provider_i2c_reads=10 provider_i2c_writes=0 protected_clock_calls=1 \
  protected_clock_caller_retries=0 clock_backend_abi=2 clock_gate_pairs=1 \
  explicit_mmio_writes_maximum=401 explicit_mmio_reads_maximum=419 \
  bigidvfs_reads=0 secure_calls=0 provider_acquires=0 provider_releases=0 \
  publisher_calls=0 owner_mutations=0 cpu_requests=0 hardware_free_tests=8 \
  device_action=none boot_candidate=false; do
  grep -Fx "${marker}" "${package}/provenance/generation.txt" >/dev/null
done
jq -n --arg status validated --arg repository_commit "${commit}" \
  --arg purpose "${purpose}" --arg package "${package}" \
  --arg package_name "$(basename "${package}")" \
  '{status: $status, repository_commit: $repository_commit,
    purpose: $purpose, package: $package, package_name: $package_name}' \
  >"${job_record}.partial"
mv "${job_record}.partial" "${job_record}"
printf 'buildbox_job=%s\nbuildbox_package=%s\n' "${job_key}" "${package}"
REMOTE
}

