    outputs/baseline/focused-disassembly/cpu_psci_cpu_boot.txt \
    outputs/baseline/focused-disassembly/hps_algo_do_cluster_action.txt \
    outputs/baseline/focused-disassembly/mt6797_a72_hold_workfn.txt; do
