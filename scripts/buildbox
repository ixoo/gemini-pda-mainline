    "/workspace/gemini-pda/jobs/${job_key}.json" \
    "/workspace/gemini-pda/jobs/${job_key}.json"
  job_info="$(ssh_buildbox "${remote_command}")" || \
    die "no completed A72 A34 eligibility patch generation for ${sha}"
  printf '%s' "${job_info}" | jq -e --arg commit "${sha}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == "mainline-a72-a34-eligibility-patch-generation" and
    (.package_name | test("^[A-Za-z0-9_.+-]+$"))
  ' >/dev/null || die "A72 A34 eligibility patch record is invalid"
  package_name="$(printf '%s' "${job_info}" | jq -er '.package_name')"
  destination="${REPO_DIR}/artifacts/buildbox/${sha}/${package_name}"
  [[ ! -e "${destination}" ]] || die "refusing to overwrite ${destination}"
  mkdir -p "$(dirname "${destination}")"
  temporary="$(mktemp -d "$(dirname "${destination}")/.fetch.XXXXXX")"
  trap 'test -n "${temporary:-}" && test -d "${temporary}" && rm -rf -- "${temporary}"' EXIT

  printf -v remote_command 'bash -s -- %q %q' "${job_key}" "${sha}"
  ssh_buildbox "${remote_command}" <<'REMOTE' | tar -C "${temporary}" -xf -
set -euo pipefail
readonly job_key="$1"
readonly commit="$2"
readonly artifact_root=/workspace/gemini-pda/a72-a34-eligibility-artifacts
readonly record="/workspace/gemini-pda/jobs/${job_key}.json"
