  checkpatch_intentional_ignore=SPLIT_STRING-for-one-atomic-raw-record \
  observer_calls=clock-1,bigidvfs-1 defer_before_hardware_access=yes \
  automatic_retry_after_access=no raw_fields=complete \
  candidate_dtb_enables=clock,bigidvfs,observer \
  base_gemini_dtb_changed=false \
  named_tee_identity_gate=required-before-deployment secure_write=none \
  owner_registration=0 cpu_on=false cpu_off=false device_action=none \
  boot_candidate=false; do
  grep -Fx "${marker}" "${package}/provenance/generation.txt" >/dev/null
done
