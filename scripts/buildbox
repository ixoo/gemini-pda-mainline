(cd "${package}" && sha256sum --check --strict SHA256SUMS >/dev/null)
grep -Fx "repository_commit=${commit}" "${package}/provenance.txt" >/dev/null
grep -Fx 'generated_patch_count=1' "${package}/provenance.txt" >/dev/null
tar -C "$(dirname "${package}")" -cf - -- "$(basename "${package}")"
REMOTE
  [[ -d "${temporary}/${package_name}" ]]
  (
    cd "${temporary}/${package_name}"
    sha256sum --check --strict SHA256SUMS >/dev/null
    grep -Fx "repository_commit=${sha}" provenance.txt >/dev/null
    for marker in generated_patch_count=1 \
      component_order=platform,provider,clock,bigidvfs \
      component_calls_per_snapshot=1,1,1,1 \
      long_lived_device_references=3 protected_readback_checkpoints=0 \
      clock_transport_writes_max=401 bigidvfs_register_reads=8 \
      sample_generations_in_equality=0 focused_kunit_cases=6 \
      unsafe_mutations_rejected=20 production_callers=0 \
      device_tree_nodes=0 mt6797_cpu_can_disable=false \
      native_vm_build=none boot_candidate=false device_action=none; do
      grep -Fx "${marker}" provenance.txt >/dev/null
    done
  )
