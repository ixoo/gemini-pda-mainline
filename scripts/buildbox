die() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

ssh_buildbox() {
  # Callers either pass fixed commands or strings assembled from values that
  # have already passed the strict commit/ref/profile validators above.
  # shellcheck disable=SC2029
  ssh "${SSH_OPTIONS[@]}" "${BUILDBOX_HOST}" "$@"
}

profile_name() {
  local profile="${KERNEL_PROFILE:-}"

  if [[ -z "${profile}" ]]; then
    profile="$(jq -er '.config.default_profile' "${REPO_DIR}/kernel/manifest.json")"
  fi
  [[ "${profile}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || \
    die "invalid kernel profile: ${profile}"
  printf '%s\n' "${profile}"
}

module_mode() {
  case "${BUILD_MODULES:-0}" in
    0|1) printf '%s\n' "${BUILD_MODULES:-0}" ;;
    *) die "BUILD_MODULES must be 0 or 1" ;;
  esac
}

job_count() {
  local jobs="${KERNEL_JOBS:-${DEFAULT_JOBS}}"

  [[ "${jobs}" =~ ^[1-9][0-9]*$ ]] || die "KERNEL_JOBS must be positive"
  printf '%s\n' "${jobs}"
}

require_clean_pushed_head() {
  local branch
  local local_sha
  local remote_branch
  local remote_name
  local remote_sha
  local remote_url
  local upstream

  git -C "${REPO_DIR}" diff --quiet || \
    die "commit tracked worktree changes before using buildbox"
  git -C "${REPO_DIR}" diff --cached --quiet || \
    die "commit staged changes before using buildbox"
  [[ -z "$(git -C "${REPO_DIR}" ls-files --others --exclude-standard)" ]] || \
    die "commit or remove untracked files before using buildbox"

  branch="$(git -C "${REPO_DIR}" symbolic-ref --quiet --short HEAD)" || \
    die "buildbox requires a checked-out branch"
  [[ "${branch}" =~ ^[A-Za-z0-9._/-]+$ ]] || \
    die "branch name is not safe for the buildbox transport: ${branch}"
  git -C "${REPO_DIR}" check-ref-format --branch "${branch}" >/dev/null || \
    die "invalid branch name: ${branch}"

  upstream="$(git -C "${REPO_DIR}" rev-parse \
    --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || \
    die "current branch has no upstream; push it with: git push -u origin HEAD"
  remote_name="${upstream%%/*}"
  remote_branch="${upstream#*/}"
  [[ "${remote_name}" != "${remote_branch}" && \
     "${remote_branch}" =~ ^[A-Za-z0-9._/-]+$ ]] || \
    die "unsafe upstream branch: ${upstream}"

  remote_url="$(git -C "${REPO_DIR}" remote get-url "${remote_name}")"
  [[ "${remote_url}" == "${REMOTE_URL}" ]] || \
    die "upstream remote must be ${REMOTE_URL}; found ${remote_url}"

  git -C "${REPO_DIR}" fetch --quiet "${remote_name}" \
    "refs/heads/${remote_branch}:refs/remotes/${remote_name}/${remote_branch}"
  local_sha="$(git -C "${REPO_DIR}" rev-parse HEAD)"
  remote_sha="$(git -C "${REPO_DIR}" rev-parse \
    "refs/remotes/${remote_name}/${remote_branch}")"
  [[ "${local_sha}" == "${remote_sha}" ]] || \
    die "HEAD is not pushed to ${upstream}; push it before using buildbox"

  printf '%s\t%s\n' "${local_sha}" "${remote_branch}"
}

available() {
  require_command ssh
  ssh_buildbox \
    "test \"\$(uname -m)\" = x86_64 && command -v aarch64-linux-gnu-gcc >/dev/null && command -v aarch64-linux-gnu-ld >/dev/null && command -v ccache >/dev/null && command -v flock >/dev/null && command -v git >/dev/null && command -v jq >/dev/null && command -v make >/dev/null && command -v sha256sum >/dev/null && command -v tar >/dev/null && test -w /workspace && git ls-remote '${REMOTE_URL}' HEAD >/dev/null" \
    >/dev/null 2>&1
}

doctor() {
  require_command git
  require_command jq
  require_command ssh

  printf 'local_repository=%s\n' "${REPO_DIR}"
  printf 'buildbox_host=%s\n' "${BUILDBOX_HOST}"
  ssh_buildbox "bash -s" <<'REMOTE'
set -euo pipefail
test "$(uname -m)" = x86_64
for command in aarch64-linux-gnu-gcc aarch64-linux-gnu-ld apt-cache apt-get ccache dpkg-deb file flock git jq make pahole python3 rsync sha256sum tar; do
  command -v "${command}" >/dev/null
done
test -w /workspace
git ls-remote https://github.com/ixoo/gemini-pda-mainline.git HEAD >/dev/null
printf 'remote_architecture=%s\n' "$(uname -m)"
printf 'remote_cpus=%s\n' "$(nproc)"
printf 'remote_cpu_quota='
cat /sys/fs/cgroup/cpu.max 2>/dev/null || printf 'unknown\n'
printf 'remote_memory='; awk '/^MemTotal:/ { print $2 " KiB" }' /proc/meminfo
printf 'remote_home_filesystem='; df -hP "${HOME}" | awk 'NR == 2 { print $2 " total, " $4 " available" }'
printf 'remote_workspace_filesystem='; df -hP /workspace | awk 'NR == 2 { print $2 " total, " $4 " available" }'
printf 'remote_compiler=%s\n' "$(aarch64-linux-gnu-gcc --version | head -n 1)"
printf 'remote_linker=%s\n' "$(aarch64-linux-gnu-ld --version | head -n 1)"
printf 'remote_ccache=%s\n' "$(ccache --version | head -n 1)"
printf 'repository_access=passed\n'
REMOTE
}

build_kernel() {
  local branch
  local identity
  local jobs
  local modules
  local profile
  local remote_command
  local sha

  require_command git
  require_command jq
  require_command ssh
  identity="$(require_clean_pushed_head)"
  IFS=$'\t' read -r sha branch <<< "${identity}"
  profile="$(profile_name)"
  modules="$(module_mode)"
  jobs="$(job_count)"
  printf -v remote_command 'bash -s -- %q %q %q %q %q' \
    "${sha}" "${branch}" "${profile}" "${modules}" "${jobs}"

  printf 'Submitting %s profile %s to %s\n' "${sha}" "${profile}" "${BUILDBOX_HOST}"
  ssh_buildbox "${remote_command}" <<'REMOTE'
set -euo pipefail

readonly commit="$1"
readonly branch="$2"
readonly profile="$3"
readonly modules="$4"
readonly jobs="$5"
readonly remote_url=https://github.com/ixoo/gemini-pda-mainline.git
readonly persistent_root="${HOME}/gemini-pda-buildbox"
readonly mirror="${persistent_root}/repo.git"
readonly workspace_root=/workspace/gemini-pda
readonly checkout_root="${workspace_root}/checkouts"
readonly checkout="${checkout_root}/${commit}"
readonly source_root="${workspace_root}/src"
readonly build_root="${workspace_root}/build"
readonly artifact_root="${workspace_root}/artifacts"
readonly job_root="${workspace_root}/jobs"
readonly job_key="${commit}-${profile}-m${modules}"
readonly job_log="${job_root}/${job_key}.log"
readonly job_record="${job_root}/${job_key}.json"

mkdir -p "${persistent_root}" "${checkout_root}" "${source_root}" \
  "${build_root}" "${artifact_root}" "${job_root}" \
  "${HOME}/.cache/gemini-pda" "${HOME}/.cache/ccache"
exec 9>"${persistent_root}/build.lock"
flock 9

if [[ ! -d "${mirror}" ]]; then
  if [[ -e "${mirror}.partial" ]]; then
    [[ -d "${mirror}.partial" && ! -L "${mirror}.partial" ]]
    rm -rf -- "${mirror}.partial"
  fi
  git clone --mirror "${remote_url}" "${mirror}.partial"
  mv "${mirror}.partial" "${mirror}"
fi
[[ "$(git --git-dir="${mirror}" remote get-url origin)" == "${remote_url}" ]] || {
  echo "error: buildbox mirror has an unexpected origin" >&2
  exit 1
}
git --git-dir="${mirror}" fetch --prune origin \
  "refs/heads/${branch}:refs/remotes/origin/${branch}"
[[ "$(git --git-dir="${mirror}" rev-parse "refs/remotes/origin/${branch}")" == "${commit}" ]] || {
  echo "error: fetched branch does not resolve to requested commit" >&2
  exit 1
}

if [[ ! -d "${checkout}" ]]; then
  for stale_partial in "${checkout}".partial.*; do
    [[ -d "${stale_partial}" && ! -L "${stale_partial}" ]] || continue
    rm -rf -- "${stale_partial}"
  done
  partial="${checkout}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' EXIT
  git clone --no-checkout "${mirror}" "${partial}"
  git -C "${partial}" checkout --detach "${commit}"
  [[ -z "$(git -C "${partial}" status --porcelain)" ]]
  mv "${partial}" "${checkout}"
  partial=""
  trap - EXIT
fi
[[ "$(git -C "${checkout}" rev-parse HEAD)" == "${commit}" ]] || {
  echo "error: cached checkout does not match requested commit" >&2
  exit 1
}
[[ -z "$(git -C "${checkout}" status --porcelain)" ]] || {
  echo "error: cached checkout is dirty" >&2
  exit 1
}

ccache --set-config=cache_dir="${HOME}/.cache/ccache"
ccache --set-config=max_size=5G
ccache --set-config=compression=true

rm -f "${job_record}.partial"
set -o pipefail
env \
  KERNEL_PROFILE="${profile}" \
  BUILD_MODULES="${modules}" \
  KERNEL_JOBS="${jobs}" \
  CROSS_COMPILE=aarch64-linux-gnu- \
  KERNEL_CCACHE=1 \
  GEMINI_REPOSITORY_COMMIT="${commit}" \
  GEMINI_REPOSITORY_DIRTY=false \
  GEMINI_SOURCE_ROOT="${source_root}" \
  GEMINI_BUILD_ROOT="${build_root}" \
  GEMINI_ARTIFACT_ROOT="${artifact_root}" \
  GEMINI_CACHE_ROOT="${HOME}/.cache/gemini-pda" \
  "${checkout}/scripts/kernel" build 2>&1 | tee "${job_log}"

package="$(sed -n 's/^Packaged artifacts at //p' "${job_log}" | tail -n 1)"
case "${package}" in
  "${artifact_root}"/*) ;;
  *) echo "error: build did not report a safe package path" >&2; exit 1 ;;
esac
[[ -d "${package}" && ! -L "${package}" ]]
GEMINI_ARTIFACT_ROOT="${artifact_root}" \
  "${checkout}/scripts/validate-kernel-artifact" "${package}"
jq -e \
  --arg commit "${commit}" \
  --arg profile "${profile}" \
  --argjson modules "$(if [[ "${modules}" == 1 ]]; then printf true; else printf false; fi)" '
    .repository_commit == $commit and
    .repository_dirty == false and
    .build_profile == $profile and
    .modules_built == $modules and
    .build_architecture == "x86_64" and
    .target_architecture == "arm64" and
    .toolchain_mode == "cross"
  ' "${package}/provenance/build.json" >/dev/null
jq -n \
  --arg status validated \
  --arg repository_commit "${commit}" \
  --arg profile "${profile}" \
  --argjson modules_built "$(if [[ "${modules}" == 1 ]]; then printf true; else printf false; fi)" \
  --arg package "${package}" \
  --arg package_name "$(basename "${package}")" \
  --arg completed_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{
    status: $status,
    repository_commit: $repository_commit,
    profile: $profile,
    modules_built: $modules_built,
    package: $package,
    package_name: $package_name,
    completed_utc: $completed_utc
  }' > "${job_record}.partial"
mv "${job_record}.partial" "${job_record}"
printf 'buildbox_job=%s\n' "${job_key}"
printf 'buildbox_package=%s\n' "${package}"
REMOTE
}

fetch_package() {
  local destination
  local job_info
  local job_key
  local modules
  local package_name
  local profile
  local remote_command
  local sha
  local temporary

  require_command git
  require_command jq
  require_command sha256sum
  require_command ssh
  require_command tar
  sha="$(git -C "${REPO_DIR}" rev-parse HEAD)"
  [[ "${sha}" =~ ^[0-9a-f]{40,64}$ ]] || die "invalid HEAD commit"
  profile="$(profile_name)"
  modules="$(module_mode)"
  job_key="${sha}-${profile}-m${modules}"
  printf -v remote_command 'test -f %q && cat %q' \
    "/workspace/gemini-pda/jobs/${job_key}.json" \
    "/workspace/gemini-pda/jobs/${job_key}.json"
  job_info="$(ssh_buildbox "${remote_command}")" || \
    die "no completed buildbox job for ${sha} profile ${profile}"
  printf '%s' "${job_info}" | jq -e \
    --arg commit "${sha}" --arg profile "${profile}" \
    --argjson modules "$(if [[ "${modules}" == 1 ]]; then printf true; else printf false; fi)" '
      .status == "validated" and
      .repository_commit == $commit and
      .profile == $profile and
      .modules_built == $modules and
      (.package_name | test("^[A-Za-z0-9_.+-]+$"))
    ' >/dev/null || die "buildbox job record is invalid"
  package_name="$(printf '%s' "${job_info}" | jq -er '.package_name')"
  destination="${REPO_DIR}/artifacts/buildbox/${sha}/${package_name}"
  [[ ! -e "${destination}" ]] || die "refusing to overwrite ${destination}"
  mkdir -p "$(dirname "${destination}")"
  temporary="$(mktemp -d "$(dirname "${destination}")/.fetch.XXXXXX")"
  trap 'test -n "${temporary:-}" && test -d "${temporary}" && rm -rf -- "${temporary}"' EXIT

  printf -v remote_command 'bash -s -- %q %q %q %q' \
    "${job_key}" "${sha}" "${profile}" "${modules}"
  ssh_buildbox "${remote_command}" <<'REMOTE' | tar -C "${temporary}" -xf -
set -euo pipefail
readonly job_key="$1"
readonly commit="$2"
readonly profile="$3"
readonly modules="$4"
readonly artifact_root=/workspace/gemini-pda/artifacts
readonly record="/workspace/gemini-pda/jobs/${job_key}.json"
[[ -f "${record}" && ! -L "${record}" ]]
package="$(jq -er \
  --arg commit "${commit}" --arg profile "${profile}" \
  --argjson modules "$(if [[ "${modules}" == 1 ]]; then printf true; else printf false; fi)" '
    select(.status == "validated" and
      .repository_commit == $commit and .profile == $profile and
      .modules_built == $modules) |
    .package
  ' "${record}")"
case "${package}" in
  "${artifact_root}"/*) ;;
  *) echo "error: unsafe package path in job record" >&2; exit 1 ;;
esac
[[ -d "${package}" && ! -L "${package}" ]]
jq -e \
  --arg commit "${commit}" \
  --arg profile "${profile}" \
  --argjson modules "$(if [[ "${modules}" == 1 ]]; then printf true; else printf false; fi)" '
    .repository_commit == $commit and
    .repository_dirty == false and
    .build_profile == $profile and
    .modules_built == $modules
  ' "${package}/provenance/build.json" >/dev/null
tar -C "$(dirname "${package}")" -cf - -- "$(basename "${package}")"
REMOTE

  [[ -d "${temporary}/${package_name}" ]]
  (
    cd "${temporary}/${package_name}"
    sha256sum --check --strict SHA256SUMS
  )
  mv "${temporary}/${package_name}" "${destination}"
  rmdir "${temporary}"
  trap - EXIT
  printf 'Artifact fetched to %s\n' "${destination}"
}

build_gemian_provenance_observer() {
  local branch
  local identity
  local jobs
  local remote_command
  local sha

  require_command git
  require_command jq
  require_command ssh
  identity="$(require_clean_pushed_head)"
  IFS=$'\t' read -r sha branch <<< "${identity}"
  jobs="$(job_count)"
  printf -v remote_command 'bash -s -- %q %q %q' \
    "${sha}" "${branch}" "${jobs}"

  printf 'Submitting Gemian provenance pre-init full-link review %s to %s\n' \
    "${sha}" "${BUILDBOX_HOST}"
  ssh_buildbox "${remote_command}" <<'REMOTE'
set -euo pipefail

readonly commit="$1"
readonly branch="$2"
readonly jobs="$3"
readonly remote_url=https://github.com/ixoo/gemini-pda-mainline.git
readonly persistent_root="${HOME}/gemini-pda-buildbox"
readonly mirror="${persistent_root}/repo.git"
readonly workspace_root=/workspace/gemini-pda
readonly checkout_root="${workspace_root}/checkouts"
readonly checkout="${checkout_root}/${commit}"
readonly source_root="${workspace_root}/gemian-source"
readonly build_root="${workspace_root}/build"
readonly artifact_root="${workspace_root}/gemian-provenance-artifacts"
readonly toolchain_root="${workspace_root}/gemian-toolchains"
readonly job_root="${workspace_root}/jobs"
readonly job_key="${commit}-gemian-provenance-preinit"
readonly job_purpose=vendor-runtime-provenance-preinit-full-link-compile-review
readonly job_log="${job_root}/${job_key}.log"
readonly job_record="${job_root}/${job_key}.json"
readonly build_script=experiments/2026-08-14-mt6797-runtime-provenance-observer/scripts/build-on-buildbox

mkdir -p "${persistent_root}" "${checkout_root}" "${source_root}" \
  "${build_root}" "${artifact_root}" "${toolchain_root}" "${job_root}"
exec 9>"${persistent_root}/build.lock"
flock 9

if [[ ! -d "${mirror}" ]]; then
  if [[ -e "${mirror}.partial" ]]; then
    [[ -d "${mirror}.partial" && ! -L "${mirror}.partial" ]]
    rm -rf -- "${mirror}.partial"
  fi
  git clone --mirror "${remote_url}" "${mirror}.partial"
  mv "${mirror}.partial" "${mirror}"
fi
[[ "$(git --git-dir="${mirror}" remote get-url origin)" == "${remote_url}" ]]
git --git-dir="${mirror}" fetch --prune origin \
  "refs/heads/${branch}:refs/remotes/origin/${branch}"
[[ "$(git --git-dir="${mirror}" rev-parse "refs/remotes/origin/${branch}")" == \
   "${commit}" ]]

if [[ ! -d "${checkout}" ]]; then
  for stale in "${checkout}.partial."*; do
    [[ -d "${stale}" && ! -L "${stale}" ]] || continue
    rm -rf -- "${stale}"
  done
  partial="${checkout}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' EXIT
  git clone --no-checkout "${mirror}" "${partial}"
  git -C "${partial}" checkout --detach "${commit}"
  [[ -z "$(git -C "${partial}" status --porcelain)" ]]
  mv "${partial}" "${checkout}"
  partial=""
  trap - EXIT
fi
[[ "$(git -C "${checkout}" rev-parse HEAD)" == "${commit}" ]]
[[ -z "$(git -C "${checkout}" status --porcelain)" ]]

if [[ -f "${job_record}" ]] && jq -e \
  --arg commit "${commit}" --arg purpose "${job_purpose}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == $purpose
  ' "${job_record}" >/dev/null; then
  package="$(jq -er '.package' "${job_record}")"
  [[ -d "${package}" && ! -L "${package}" ]]
  printf 'buildbox_job=%s\n' "${job_key}"
  printf 'buildbox_package=%s\n' "${package}"
  exit 0
fi

rm -f "${job_record}.partial"
set -o pipefail
"${checkout}/${build_script}" \
  "${commit}" "${source_root}" "${build_root}" "${artifact_root}" \
  "${toolchain_root}" "${jobs}" 2>&1 | tee "${job_log}"
package="$(sed -n \
  's/^Packaged Gemian provenance pre-init compile review at //p' \
  "${job_log}" | tail -n 1)"
case "${package}" in
  "${artifact_root}"/*) ;;
  *) echo "error: provenance build did not report a safe package path" >&2; exit 1 ;;
esac
[[ -d "${package}" && ! -L "${package}" ]]
(
  cd "${package}"
  sha256sum --check --strict SHA256SUMS
)
jq -e --arg commit "${commit}" '
  .repository_commit == $commit and .repository_dirty == false and
  .purpose == "vendor-runtime-provenance-preinit-full-link-compile-review-only" and
  .build_mode == "provenance-preinit-recovery" and
  .source_commit == "d388d350cb2dda8f23b99be6fa5db9628896e87f" and
  .parent_commit == "f3d2a14bd1b8355c68e59e8bd4be6bc1525f9c24" and
  .patched_commit == "2dbf7be3999120f297aedb9842bce320d759d26e" and
  .parent_patch_sha256 ==
    "3520538de1c31ea592c2f0c76af7deef10f5c1ee00689d74bdac17def48dbb11" and
  .recovery_patch_sha256 ==
    "0ddf2b5b28bb0957a467d38bfece553b89bf6b81c85c365f293d00b94efbd3d1" and
  .normal_patch_application == true and .config_delta_exact == true and
  .observer_config_enabled == true and
  .preinit_recovery_config_enabled == true and
  .localversion == "-gemini-provenance-preinit" and
  .full_kernel_link == true and
  .dct_project == "k97v1_64_bsp" and
  .dct_project_matches_config == true and
  .dct_python == "Python 3.11.2" and
  .dct_python_sha256 ==
    "6d972cf21be56fe3c947ab6ba257ff8d08c342dd2714442986791bd9a6dfabfe" and
  .dct_tool_sha256 ==
    "05ea43ff25ae7127197ff3a0121ab5731dfc1482d13ca988e987d84e6e5a78a4" and
  .dws_sha256 ==
    "181c963bc71b5462d0cbc9a45c52fc272918454f66455c416a95bd99ac3aa94f" and
  .cust_dtsi_sha256 ==
    "0a061c5d462a3cfc294d347c3c765e2a6e3868ad82fa2c4b07cb72beb6e8588a" and
  .unresolved_symbol_count == 0 and .debugfs_mode == "0444" and
  .interrupt_safe_observer == true and
  .lifecycle_completion_fail_closed == true and
  .eem_required_bank_mask == "0x0000003b" and
  .coherent_transition_owner == false and .owner_handle == 0 and
  .transition_handle == 0 and .provider == "none" and
  .recovery_deadline_seconds == 120 and
  .initcall_order_valid == true and
  .reset_action == "bounded-emergency-restart" and
  .dvfsp_hardware_write == "none" and .hardware_write == "reset-only" and
  .cpu8_cpu9_admission == "closed" and
  .boot_candidate == false
' "${package}/provenance/build.json" >/dev/null
for required in outputs/Image.gz-dtb outputs/System.map outputs/vmlinux \
  outputs/config outputs/baseline.config outputs/config.diff \
  outputs/cust.dtsi outputs/dct.log outputs/build.log \
  outputs/initcall-order.txt outputs/recovery-workfn-range.txt \
  outputs/recovery-workfn-disassembly.txt \
  provenance/changed-paths.txt \
  provenance/source-commits.txt; do
  [[ -s "${package}/${required}" ]]
done
[[ -f "${package}/outputs/undefined-symbols.txt" && \
   ! -s "${package}/outputs/undefined-symbols.txt" ]]
for symbol in gemini_mt6797_dvfsp_provenance_calibration_bank_publish \
  gemini_mt6797_dvfsp_provenance_calibration_invalidate \
  gemini_mt6797_dvfsp_provenance_table_commit \
  gemini_mt6797_dvfsp_provenance_init \
  gemini_mt6797_preinit_recovery_init \
  gemini_mt6797_preinit_recovery_workfn; do
  grep -q " ${symbol}$" "${package}/outputs/System.map"
done
jq -n \
  --arg status validated \
  --arg repository_commit "${commit}" \
  --arg purpose "${job_purpose}" \
  --arg package "${package}" \
  --arg package_name "$(basename "${package}")" \
  --arg completed_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{status: $status, repository_commit: $repository_commit, purpose: $purpose,
    package: $package, package_name: $package_name,
    completed_utc: $completed_utc}' > "${job_record}.partial"
mv "${job_record}.partial" "${job_record}"
printf 'buildbox_job=%s\n' "${job_key}"
printf 'buildbox_package=%s\n' "${package}"
REMOTE
}

fetch_gemian_provenance_observer() {
  local destination
  local job_info
  local job_key
  local package_name
  local remote_command
  local sha
  local temporary

  require_command git
  require_command jq
  require_command sha256sum
  require_command ssh
  require_command tar
  sha="$(git -C "${REPO_DIR}" rev-parse HEAD)"
  [[ "${sha}" =~ ^[0-9a-f]{40}$ ]] || die "invalid HEAD commit"
  job_key="${sha}-gemian-provenance-preinit"
  printf -v remote_command 'test -f %q && cat %q' \
    "/workspace/gemini-pda/jobs/${job_key}.json" \
    "/workspace/gemini-pda/jobs/${job_key}.json"
  job_info="$(ssh_buildbox "${remote_command}")" || \
    die "no completed Gemian provenance Buildbox job for ${sha}"
  printf '%s' "${job_info}" | jq -e --arg commit "${sha}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == "vendor-runtime-provenance-preinit-full-link-compile-review" and
    (.package_name | test("^[A-Za-z0-9_.+-]+$"))
  ' >/dev/null || die "Gemian provenance Buildbox job record is invalid"
  package_name="$(printf '%s' "${job_info}" | jq -er '.package_name')"
  destination="${REPO_DIR}/artifacts/buildbox/${sha}/${package_name}"
  [[ ! -e "${destination}" ]] || die "refusing to overwrite ${destination}"
  mkdir -p "$(dirname "${destination}")"
  temporary="$(mktemp -d "$(dirname "${destination}")/.fetch.XXXXXX")"
  trap 'test -n "${temporary:-}" && test -d "${temporary}" && rm -rf -- "${temporary}"' EXIT

  printf -v remote_command 'bash -s -- %q %q' "${job_key}" "${sha}"
  ssh_buildbox "${remote_command}" <<'REMOTE' | tar -C "${temporary}" -xf -
set -euo pipefail
readonly job_key="$1"
readonly commit="$2"
readonly artifact_root=/workspace/gemini-pda/gemian-provenance-artifacts
readonly record="/workspace/gemini-pda/jobs/${job_key}.json"
[[ -f "${record}" && ! -L "${record}" ]]
package="$(jq -er --arg commit "${commit}" '
  select(.status == "validated" and .repository_commit == $commit and
    .purpose == "vendor-runtime-provenance-preinit-full-link-compile-review") |
    .package
' "${record}")"
case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
[[ -d "${package}" && ! -L "${package}" ]]
jq -e --arg commit "${commit}" '
  .repository_commit == $commit and .repository_dirty == false and
  .purpose == "vendor-runtime-provenance-preinit-full-link-compile-review-only" and
  .build_mode == "provenance-preinit-recovery" and
  .full_kernel_link == true and .unresolved_symbol_count == 0 and
  .normal_patch_application == true and .config_delta_exact == true and
  .observer_config_enabled == true and
  .preinit_recovery_config_enabled == true and
  .interrupt_safe_observer == true and
  .lifecycle_completion_fail_closed == true and
  .provider == "none" and .recovery_deadline_seconds == 120 and
  .initcall_order_valid == true and
  .reset_action == "bounded-emergency-restart" and
  .dvfsp_hardware_write == "none" and .hardware_write == "reset-only" and
  .cpu8_cpu9_admission == "closed" and .boot_candidate == false
' "${package}/provenance/build.json" >/dev/null
tar -C "$(dirname "${package}")" -cf - -- "$(basename "${package}")"
REMOTE
  [[ -d "${temporary}/${package_name}" ]]
  (
    cd "${temporary}/${package_name}"
    sha256sum --check --strict SHA256SUMS >/dev/null
  )
  mv "${temporary}/${package_name}" "${destination}"
  rmdir "${temporary}"
  trap - EXIT
  printf 'Artifact fetched to %s\n' "${destination}"
}

build_gemian_observer() {
  local branch
  local identity
  local jobs
  local mode="${1:-observer}"
  local remote_command
  local sha

  case "${mode}" in
    observer|rollback|recovery|one-way|held|late|cpu9|window|terminal|coherence|multiline|parallel|scheduler) ;;
    *) die "invalid Gemian compile-review mode: ${mode}" ;;
  esac

  require_command git
  require_command jq
  require_command ssh
  identity="$(require_clean_pushed_head)"
  IFS=$'\t' read -r sha branch <<< "${identity}"
  jobs="$(job_count)"
  printf -v remote_command 'bash -s -- %q %q %q %q %q' \
    "${sha}" "${branch}" "${jobs}" "${mode}" \
    "${EXPECTED_SCHEDULER_UNPARK_PATCHSET_SHA256}"

  printf 'Submitting Gemian %s compile review %s to %s\n' \
    "${mode}" "${sha}" "${BUILDBOX_HOST}"
  ssh_buildbox "${remote_command}" <<'REMOTE'
set -euo pipefail

readonly commit="$1"
readonly branch="$2"
readonly jobs="$3"
readonly mode="$4"
readonly expected_scheduler_patchset="$5"
readonly remote_url=https://github.com/ixoo/gemini-pda-mainline.git
readonly persistent_root="${HOME}/gemini-pda-buildbox"
readonly mirror="${persistent_root}/repo.git"
readonly workspace_root=/workspace/gemini-pda
readonly checkout_root="${workspace_root}/checkouts"
readonly checkout="${checkout_root}/${commit}"
readonly source_root="${workspace_root}/gemian-source"
readonly build_root="${workspace_root}/build"
readonly artifact_root="${workspace_root}/gemian-artifacts"
readonly toolchain_root="${workspace_root}/gemian-toolchains"
readonly job_root="${workspace_root}/jobs"
case "${mode}" in
  observer)
    readonly job_suffix=gemian-a72-owner-observer
    readonly job_purpose=gemian-a72-owner-observer-compile-review
    readonly build_script=experiments/2026-07-23-gemian-a72-owner-observer/scripts/build-on-buildbox
    ;;
  rollback)
    readonly job_suffix=gemian-a72-preiso-rollback
    readonly job_purpose=gemian-a72-preiso-rollback-compile-review
    readonly build_script=experiments/2026-08-02-a72-pre-isolation-rollback-discriminator/scripts/build-on-buildbox
    ;;
  recovery)
    readonly job_suffix=gemian-a72-recovery
    readonly job_purpose=gemian-a72-recovery-compile-review
    readonly build_script=experiments/2026-08-02-a72-recovery-only-discriminator/scripts/build-on-buildbox
    ;;
  one-way)
    readonly job_suffix=gemian-a72-one-way
    readonly job_purpose=gemian-a72-one-way-compile-review
    readonly build_script=experiments/2026-08-02-a72-one-way-cpu8-boundary/scripts/build-on-buildbox
    ;;
  held)
    readonly job_suffix=gemian-a72-held
    readonly job_purpose=gemian-a72-held-online-compile-review
    readonly build_script=experiments/2026-08-02-a72-cpu8-held-online/scripts/build-on-buildbox
    ;;
  late)
    readonly job_suffix=gemian-a72-late
    readonly job_purpose=gemian-a72-late-hold-compile-review
    readonly build_script=experiments/2026-08-03-a72-cpu8-late-hold/scripts/build-on-buildbox
    ;;
  cpu9)
    readonly job_suffix=gemian-a72-cpu9
    readonly job_purpose=gemian-a72-cpu9-cluster-reuse-compile-review
    readonly build_script=experiments/2026-08-03-a72-cpu9-cluster-reuse/scripts/build-on-buildbox
    ;;
  window)
    readonly job_suffix=gemian-a72-cpu9-window
    readonly job_purpose=gemian-a72-cpu9-retention-window-compile-review
    readonly build_script=experiments/2026-08-03-a72-cpu9-retention-window/scripts/build-on-buildbox
    ;;
  terminal)
    readonly job_suffix=gemian-a72-cpu9-terminal
    readonly job_purpose=gemian-a72-cpu9-terminal-attribution-compile-review
    readonly build_script=experiments/2026-08-03-a72-cpu9-terminal-attribution/scripts/build-on-buildbox
    ;;
  coherence)
    readonly job_suffix=gemian-a72-cpu9-coherency
    readonly job_purpose=gemian-a72-cpu9-bounded-coherency-compile-review
    readonly build_script=experiments/2026-08-03-a72-cpu9-bounded-coherency/scripts/build-on-buildbox
    ;;
  multiline)
    readonly job_suffix=gemian-a72-cpu9-multiline
    readonly job_purpose=gemian-a72-cpu9-multiline-integrity-compile-review
    readonly build_script=experiments/2026-08-03-a72-cpu9-multiline-integrity/scripts/build-on-buildbox
    ;;
  parallel)
    readonly job_suffix=gemian-a72-cpu9-parallel
    readonly job_purpose=gemian-a72-cpu9-parallel-disjoint-load-compile-review
    readonly build_script=experiments/2026-08-03-a72-cpu9-parallel-disjoint-load/scripts/build-on-buildbox
    ;;
  scheduler)
    readonly job_suffix=gemian-a72-scheduler
    readonly job_purpose=gemian-a72-scheduler-context-compile-review
    readonly build_script=experiments/2026-08-03-a72-scheduler-context/scripts/build-on-buildbox
    ;;
  *) exit 2 ;;
esac
readonly job_key="${commit}-${job_suffix}"
readonly job_log="${job_root}/${job_key}.log"
readonly job_record="${job_root}/${job_key}.json"

mkdir -p "${persistent_root}" "${checkout_root}" "${source_root}" \
  "${build_root}" "${artifact_root}" "${toolchain_root}" "${job_root}"
exec 9>"${persistent_root}/build.lock"
flock 9

if [[ ! -d "${mirror}" ]]; then
  if [[ -e "${mirror}.partial" ]]; then
    [[ -d "${mirror}.partial" && ! -L "${mirror}.partial" ]]
    rm -rf -- "${mirror}.partial"
  fi
  git clone --mirror "${remote_url}" "${mirror}.partial"
  mv "${mirror}.partial" "${mirror}"
fi
[[ "$(git --git-dir="${mirror}" remote get-url origin)" == "${remote_url}" ]]
git --git-dir="${mirror}" fetch --prune origin \
  "refs/heads/${branch}:refs/remotes/origin/${branch}"
[[ "$(git --git-dir="${mirror}" rev-parse "refs/remotes/origin/${branch}")" == "${commit}" ]]

if [[ ! -d "${checkout}" ]]; then
  for stale_partial in "${checkout}".partial.*; do
    [[ -d "${stale_partial}" && ! -L "${stale_partial}" ]] || continue
    rm -rf -- "${stale_partial}"
  done
  partial="${checkout}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' EXIT
  git clone --no-checkout "${mirror}" "${partial}"
  git -C "${partial}" checkout --detach "${commit}"
  [[ -z "$(git -C "${partial}" status --porcelain)" ]]
  mv "${partial}" "${checkout}"
  partial=""
  trap - EXIT
fi
[[ "$(git -C "${checkout}" rev-parse HEAD)" == "${commit}" ]]
[[ -z "$(git -C "${checkout}" status --porcelain)" ]]

if [[ -f "${job_record}" ]] && jq -e \
  --arg commit "${commit}" --arg purpose "${job_purpose}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == $purpose
  ' "${job_record}" >/dev/null; then
  package="$(jq -er '.package' "${job_record}")"
  [[ -d "${package}" && ! -L "${package}" ]]
  printf 'buildbox_job=%s\n' "${job_key}"
  printf 'buildbox_package=%s\n' "${package}"
  exit 0
fi

rm -f "${job_record}.partial"
set -o pipefail
"${checkout}/${build_script}" \
  "${commit}" "${source_root}" "${build_root}" "${artifact_root}" \
  "${toolchain_root}" "${jobs}" 2>&1 | tee "${job_log}"
package="$(sed -n 's/^Packaged Gemian .* compile review at //p' \
  "${job_log}" | tail -n 1)"
case "${package}" in
  "${artifact_root}"/*) ;;
  *) echo "error: Gemian build did not report a safe package path" >&2; exit 1 ;;
esac
[[ -d "${package}" && ! -L "${package}" ]]
(
  cd "${package}"
  sha256sum --check --strict SHA256SUMS
)
jq -e --arg commit "${commit}" --arg mode "${mode}" '
  .repository_commit == $commit and .repository_dirty == false and
  .build_mode == $mode and
  .source_commit == "59e00a9144d782e148332009a835b99c43382467" and
  .cust_dtsi_sha256 == "7a7eb416499346afff30c15f967ccb9cf79323c076204b6a953515db74811632" and
  .build_architecture == "x86_64" and .target_architecture == "arm64" and
  .host_extra_cflags == "-fcommon" and
  .target_extra_cflags == "-fstack-usage" and
  .baseline_comparison == true and .diagnostics_identical == true and
  .stack_usage_captured == true and .stack_usage_file_count > 100 and
  .boot_candidate == false
' "${package}/provenance/build.json" >/dev/null
for required in outputs/System.map outputs/diagnostics.txt \
  outputs/baseline/config outputs/baseline/System.map \
  outputs/baseline/diagnostics.txt outputs/baseline/output-sha256.txt \
  outputs/stack-usage.tar outputs/stack-usage-files.nul \
  outputs/stack-usage-files.txt; do
  [[ -s "${package}/${required}" ]]
done
cmp "${package}/outputs/diagnostics.txt" \
  "${package}/outputs/baseline/diagnostics.txt" >/dev/null
if [[ "${mode}" == observer ]]; then
  jq -e '
    .baseline_source_unpatched == true and
    .purpose == "compile-review-only"
  ' "${package}/provenance/build.json" >/dev/null
  grep -q ' mt6797_a72_obs_init$' "${package}/outputs/System.map"
  ! grep -qE ' (mt6797|da9214)_a72_obs_' \
    "${package}/outputs/baseline/System.map"
elif [[ "${mode}" == rollback ]]; then
  for required in outputs/baseline/stack-usage.tar \
    outputs/baseline/stack-usage-files.nul \
    outputs/baseline/stack-usage-files.txt; do
    [[ -s "${package}/${required}" ]]
  done
  jq -e '
    .baseline_source_parent_observer == true and
    .baseline_stack_usage_file_count > 100 and
    .parent_patchset_sha256 ==
      "3584e9dd5ffb041573b851f31f3a96eaa0a684acb880fd59560762e5abc58be0" and
    .rollback_patchset_sha256 ==
      "fd4da13202c62a6ea21a216ffc9eb2650d70dcaa216a8ca1b3c64e5ef5c10b9d" and
    .purpose == "rollback-compile-review-only"
  ' "${package}/provenance/build.json" >/dev/null
  grep -q ' da9214_a72_diag_compare_update$' "${package}/outputs/System.map"
  grep -q ' mt6797_a72_diag_spm_compare_update$' \
    "${package}/outputs/System.map"
  grep -q ' mt6797_a72_diag_toprgu_compare_update$' \
    "${package}/outputs/System.map"
  grep -q ' mt6797_a72_obs_rollback_terminal$' \
    "${package}/outputs/System.map"
  grep -q ' mt6797_a72_obs_init$' "${package}/outputs/baseline/System.map"
  ! grep -qE ' (mt6797_a72_obs_rollback_terminal|.*_a72_diag_)$' \
    "${package}/outputs/baseline/System.map"
  [[ "$(tar -tf "${package}/outputs/baseline/stack-usage.tar" | wc -l)" -gt 100 ]]
elif [[ "${mode}" == recovery ]]; then
  jq -e '
    .baseline_source_unpatched == true and
    .purpose == "recovery-compile-review-only" and
    (.recovery_patchset_sha256 | test("^[0-9a-f]{64}$"))
  ' "${package}/provenance/build.json" >/dev/null
  grep -q ' mtk_wdt_recovery_arm$' "${package}/outputs/System.map"
  grep -q ' recovery_discriminator_callback$' \
    "${package}/outputs/System.map"
  ! grep -qE ' (mtk_wdt_recovery_arm|recovery_discriminator_callback)$' \
    "${package}/outputs/baseline/System.map"
  for required in outputs/baseline/stack-usage.tar \
    outputs/baseline/stack-usage-files.nul \
    outputs/baseline/stack-usage-files.txt; do
    [[ -s "${package}/${required}" ]]
  done
  [[ "$(tar -tf "${package}/outputs/baseline/stack-usage.tar" | wc -l)" -gt 100 ]]
elif [[ "${mode}" == one-way ]]; then
  for required in outputs/baseline/stack-usage.tar \
    outputs/baseline/stack-usage-files.nul \
    outputs/baseline/stack-usage-files.txt; do
    [[ -s "${package}/${required}" ]]
  done
  jq -e '
    .baseline_source_parent_rollback_owners == true and
    .baseline_stack_usage_file_count > 100 and
    .parent_patchset_sha256 ==
      "3584e9dd5ffb041573b851f31f3a96eaa0a684acb880fd59560762e5abc58be0" and
    .accepted_rollback_patchset_sha256 ==
      "76a00aeb9ebefe0c964e70e56b63977071d2f2b12b12ce52ecdb7bb298f8fdd3" and
    .one_way_patchset_sha256 ==
      "d9649e1453a05bc8a016da6fa371e97480ff62aebad3dedd87d148d5cb574890" and
    .purpose == "one-way-compile-review-only"
  ' "${package}/provenance/build.json" >/dev/null
  grep -q ' mtk_wd_a72_recovery_takeover$' "${package}/outputs/System.map"
  grep -q ' mt6797_a72_one_way_sram_set_verify$' \
    "${package}/outputs/System.map"
