if ! output="$("${checkout}/${generator}" \
  "${commit}" "${source_root}" "${artifact_root}")"; then
  printf '%s\n' "${output}" >&2
  printf 'error: clock-backend entry-ledger fix generator failed for %s\n' \
    "${commit}" >&2
  exit 1
