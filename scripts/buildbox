  local destination
  local job_info
  local job_key
  local package_name
  local remote_command
  local sha
  local temporary

  require_command git
  require_command jq
  require_command sha256sum
  require_command ssh
  require_command tar
  sha="$(git -C "${REPO_DIR}" rev-parse HEAD)"
  [[ "${sha}" =~ ^[0-9a-f]{40}$ ]] || die "invalid HEAD commit"
