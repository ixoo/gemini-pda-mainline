  ' "${package}/provenance/build.json" >/dev/null
  grep -q ' mt6797_a72_hps_down_snapshot$' "${package}/outputs/System.map"
  ! grep -q ' mt6797_a72_hps_down_snapshot$' \
    "${package}/outputs/baseline/System.map"
  grep -aFq 'gemini-a72-pair-v3 result=pass sample=3' \
    "${package}/outputs/vmlinux"
  grep -aFq 'hps_reported=%d hps_cpu=%d hps_error=%d hps_count=%d' \
