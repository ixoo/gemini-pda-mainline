(cd "${package}" && sha256sum --check --strict SHA256SUMS >/dev/null)
for marker in generated_patch_count=2 \
  membership_parent_proof=exact-read-only \
  binder_parent_proof=exact-read-only membership_kunit_cases=40 \
  binder_kunit_cases=10 combined_kunit_cases=62 \
  watchdog_max_age_ms=5000 source_mutation_rejections=20 \
  watchdog_takeovers_added=0 production_callers=0 \
  physical_effect_calls=0 mt6797_cpu_can_disable=false \
