  [[ "$(tar -tf "${package}/outputs/baseline/stack-usage.tar" | wc -l)" -gt 100 ]]
fi
[[ "$(tar -tf "${package}/outputs/stack-usage.tar" | wc -l)" -gt 100 ]]
jq -n \
  --arg status validated \
  --arg repository_commit "${commit}" \
  --arg purpose "${job_purpose}" \
  --arg package "${package}" \
  --arg package_name "$(basename "${package}")" \
  --arg completed_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{status: $status, repository_commit: $repository_commit, purpose: $purpose,
    package: $package, package_name: $package_name,
    completed_utc: $completed_utc}' > "${job_record}.partial"
mv "${job_record}.partial" "${job_record}"
printf 'buildbox_job=%s\n' "${job_key}"
printf 'buildbox_package=%s\n' "${package}"
REMOTE
}

fetch_gemian_observer() {
  local destination
  local job_info
  local job_key
  local job_purpose
  local job_suffix
  local mode="${1:-observer}"
  local package_name
  local remote_command
  local sha
  local temporary

  require_command git
  require_command jq
  require_command sha256sum
  require_command ssh
  require_command tar
  case "${mode}" in
    observer)
      job_suffix=gemian-a72-owner-observer
      job_purpose=gemian-a72-owner-observer-compile-review
      ;;
    rollback)
      job_suffix=gemian-a72-preiso-rollback
      job_purpose=gemian-a72-preiso-rollback-compile-review
      ;;
    recovery)
      job_suffix=gemian-a72-recovery
      job_purpose=gemian-a72-recovery-compile-review
      ;;
    one-way)
      job_suffix=gemian-a72-one-way
      job_purpose=gemian-a72-one-way-compile-review
      ;;
    held)
      job_suffix=gemian-a72-held
      job_purpose=gemian-a72-held-online-compile-review
      ;;
    late)
      job_suffix=gemian-a72-late
      job_purpose=gemian-a72-late-hold-compile-review
      ;;
    cpu9)
      job_suffix=gemian-a72-cpu9
      job_purpose=gemian-a72-cpu9-cluster-reuse-compile-review
      ;;
    window)
      job_suffix=gemian-a72-cpu9-window
      job_purpose=gemian-a72-cpu9-retention-window-compile-review
      ;;
    terminal)
      job_suffix=gemian-a72-cpu9-terminal
      job_purpose=gemian-a72-cpu9-terminal-attribution-compile-review
      ;;
    coherence)
      job_suffix=gemian-a72-cpu9-coherency
      job_purpose=gemian-a72-cpu9-bounded-coherency-compile-review
      ;;
    multiline)
      job_suffix=gemian-a72-cpu9-multiline
      job_purpose=gemian-a72-cpu9-multiline-integrity-compile-review
      ;;
    parallel)
      job_suffix=gemian-a72-cpu9-parallel
      job_purpose=gemian-a72-cpu9-parallel-disjoint-load-compile-review
      ;;
    scheduler)
      job_suffix=gemian-a72-scheduler
      job_purpose=gemian-a72-scheduler-context-compile-review
      ;;
    *) die "invalid Gemian compile-review mode: ${mode}" ;;
  esac
  if [[ "${mode}" == scheduler ]]; then
    [[ "${EXPECTED_SCHEDULER_UNPARK_PATCHSET_SHA256}" =~ ^[0-9a-f]{64}$ ]] || \
      die "scheduler unpark child patchset hash pin is pending"
  fi
  sha="$(git -C "${REPO_DIR}" rev-parse HEAD)"
  [[ "${sha}" =~ ^[0-9a-f]{40}$ ]] || die "invalid HEAD commit"
  job_key="${sha}-${job_suffix}"
  printf -v remote_command 'test -f %q && cat %q' \
    "/workspace/gemini-pda/jobs/${job_key}.json" \
    "/workspace/gemini-pda/jobs/${job_key}.json"
  job_info="$(ssh_buildbox "${remote_command}")" || \
    die "no completed Gemian ${mode} Buildbox job for ${sha}"
  printf '%s' "${job_info}" | jq -e \
    --arg commit "${sha}" --arg purpose "${job_purpose}" '
    .status == "validated" and .repository_commit == $commit and
    .purpose == $purpose and
    (.package_name | test("^[A-Za-z0-9_.+-]+$"))
  ' >/dev/null || die "Gemian ${mode} Buildbox job record is invalid"
  package_name="$(printf '%s' "${job_info}" | jq -er '.package_name')"
  destination="${REPO_DIR}/artifacts/buildbox/${sha}/${package_name}"
  [[ ! -e "${destination}" ]] || die "refusing to overwrite ${destination}"
  mkdir -p "$(dirname "${destination}")"
  temporary="$(mktemp -d "$(dirname "${destination}")/.fetch.XXXXXX")"
  trap 'test -n "${temporary:-}" && test -d "${temporary}" && rm -rf -- "${temporary}"' EXIT

  printf -v remote_command 'bash -s -- %q %q %q %q %q' \
    "${job_key}" "${sha}" "${job_purpose}" "${mode}" \
    "${EXPECTED_SCHEDULER_UNPARK_PATCHSET_SHA256}"
  ssh_buildbox "${remote_command}" <<'REMOTE' | tar -C "${temporary}" -xf -
set -euo pipefail
readonly job_key="$1"
readonly commit="$2"
readonly job_purpose="$3"
readonly mode="$4"
readonly expected_scheduler_patchset="$5"
readonly artifact_root=/workspace/gemini-pda/gemian-artifacts
readonly record="/workspace/gemini-pda/jobs/${job_key}.json"
[[ -f "${record}" && ! -L "${record}" ]]
package="$(jq -er --arg commit "${commit}" --arg purpose "${job_purpose}" '
  select(.status == "validated" and .repository_commit == $commit and
    .purpose == $purpose) | .package
' "${record}")"
case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
[[ -d "${package}" && ! -L "${package}" ]]
  jq -e --arg commit "${commit}" --arg mode "${mode}" \
    --arg scheduler_patchset "${expected_scheduler_patchset}" '
  .repository_commit == $commit and .repository_dirty == false and
  .build_mode == $mode and
  .boot_candidate == false and
  (($mode == "observer" and .purpose == "compile-review-only") or
   ($mode == "rollback" and .purpose == "rollback-compile-review-only") or
   ($mode == "recovery" and .purpose == "recovery-compile-review-only") or
   ($mode == "one-way" and .purpose == "one-way-compile-review-only") or
   ($mode == "held" and .purpose == "held-online-compile-review-only") or
   ($mode == "late" and .purpose == "late-hold-compile-review-only") or
   ($mode == "cpu9" and .purpose == "cpu9-cluster-reuse-compile-review-only") or
   ($mode == "window" and .purpose == "cpu9-retention-window-compile-review-only") or
   ($mode == "terminal" and .purpose == "cpu9-terminal-attribution-compile-review-only") or
   ($mode == "coherence" and .purpose == "cpu9-bounded-coherency-compile-review-only") or
   ($mode == "multiline" and .purpose == "cpu9-multiline-integrity-compile-review-only") or
   ($mode == "parallel" and .purpose == "cpu9-parallel-disjoint-load-compile-review-only") or
   ($mode == "scheduler" and
    .purpose == "a72-scheduler-unpark-compile-review-only" and
    .baseline_source_exact_scheduler_phase_parent == true and
    .scheduler_phase_parent_patchset_sha256 ==
      "b2c971d4a1860ec09616a61dbd8a29fde488f7d99deb8bd6bfbf2c517b2c3493" and
    .scheduler_patchset_sha256 == $scheduler_patchset))
' "${package}/provenance/build.json" >/dev/null
tar -C "$(dirname "${package}")" -cf - -- "$(basename "${package}")"
REMOTE
  [[ -d "${temporary}/${package_name}" ]]
  (
    cd "${temporary}/${package_name}"
    sha256sum --check --strict SHA256SUMS >/dev/null
  )
  mv "${temporary}/${package_name}" "${destination}"
  rmdir "${temporary}"
  trap - EXIT
  printf 'Artifact fetched to %s\n' "${destination}"
}

generate_gemian_rollback_patches() {
  local branch
  local identity
  local remote_command
  local sha

  require_command git
  require_command jq
  require_command ssh
  identity="$(require_clean_pushed_head)"
  IFS=$'\t' read -r sha branch <<< "${identity}"
  printf -v remote_command 'bash -s -- %q %q' "${sha}" "${branch}"

  printf 'Submitting Gemian rollback patch generation %s to %s\n' \
    "${sha}" "${BUILDBOX_HOST}"
  ssh_buildbox "${remote_command}" <<'REMOTE'
set -euo pipefail

readonly commit="$1"
readonly branch="$2"
readonly remote_url=https://github.com/ixoo/gemini-pda-mainline.git
readonly persistent_root="${HOME}/gemini-pda-buildbox"
readonly mirror="${persistent_root}/repo.git"
readonly workspace_root=/workspace/gemini-pda
readonly checkout_root="${workspace_root}/checkouts"
readonly checkout="${checkout_root}/${commit}"
readonly source_root="${workspace_root}/gemian-source"
readonly artifact_root="${workspace_root}/gemian-rollback-artifacts"
readonly job_root="${workspace_root}/jobs"
readonly job_key="${commit}-gemian-a72-preiso-patchgen"
readonly job_record="${job_root}/${job_key}.json"

mkdir -p "${persistent_root}" "${checkout_root}" "${source_root}" \
  "${artifact_root}" "${job_root}"
exec 9>"${persistent_root}/build.lock"
flock 9

if [[ ! -d "${mirror}" ]]; then
  git clone --mirror "${remote_url}" "${mirror}.partial"
  mv "${mirror}.partial" "${mirror}"
fi
[[ "$(git --git-dir="${mirror}" remote get-url origin)" == "${remote_url}" ]]
git --git-dir="${mirror}" fetch --prune origin \
  "refs/heads/${branch}:refs/remotes/origin/${branch}"
[[ "$(git --git-dir="${mirror}" rev-parse "refs/remotes/origin/${branch}")" == \
   "${commit}" ]]

if [[ ! -d "${checkout}" ]]; then
  partial="${checkout}.partial.$$"
  trap 'test -n "${partial:-}" && test -d "${partial}" && rm -rf -- "${partial}"' EXIT
  git clone --no-checkout "${mirror}" "${partial}"
  git -C "${partial}" checkout --detach "${commit}"
  [[ -z "$(git -C "${partial}" status --porcelain)" ]]
  mv "${partial}" "${checkout}"
  partial=""
  trap - EXIT
fi
[[ "$(git -C "${checkout}" rev-parse HEAD)" == "${commit}" ]]
[[ -z "$(git -C "${checkout}" status --porcelain)" ]]

if [[ -f "${job_record}" ]] && jq -e --arg commit "${commit}" '
  .status == "validated" and .repository_commit == $commit and
  .purpose == "gemian-a72-preiso-patch-generation"
' "${job_record}" >/dev/null; then
  package="$(jq -er '.package' "${job_record}")"
  [[ -d "${package}" && ! -L "${package}" ]]
  printf 'buildbox_job=%s\n' "${job_key}"
  printf 'buildbox_package=%s\n' "${package}"
  exit 0
fi

rm -f "${job_record}.partial"
output="$(${checkout}/experiments/2026-08-02-a72-pre-isolation-rollback-discriminator/scripts/generate-on-buildbox \
  "${commit}" "${source_root}" "${artifact_root}")"
printf '%s\n' "${output}"
package="$(printf '%s\n' "${output}" | \
  sed -n 's/^Generated rollback patch review at //p' | tail -n 1)"
case "${package}" in "${artifact_root}"/*) ;; *) exit 1 ;; esac
[[ -d "${package}" && ! -L "${package}" ]]
(
  cd "${package}"
  sha256sum --check --strict SHA256SUMS >/dev/null
)
jq -n \
  --arg status validated \
  --arg repository_commit "${commit}" \
  --arg purpose gemian-a72-preiso-patch-generation \
  --arg package "${package}" \
  --arg package_name "$(basename "${package}")" \
  '{status: $status, repository_commit: $repository_commit,
    purpose: $purpose, package: $package, package_name: $package_name}' \
  > "${job_record}.partial"
mv "${job_record}.partial" "${job_record}"
printf 'buildbox_job=%s\n' "${job_key}"
printf 'buildbox_package=%s\n' "${package}"
REMOTE
}

