#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR

usage() {
  cat <<'EOF'
Usage: ./scripts/build-kernel [--backend auto|buildbox|vm]

Build the manifest-selected kernel on buildbox. If buildbox is unavailable,
the build is deferred. "auto" is retained as an alias for buildbox; it never
falls back to the VM. Use the VM only for an explicitly owner-requested build.

Environment:
  GEMINI_BUILD_BACKEND  buildbox, auto, or vm (default: buildbox)
  KERNEL_PROFILE       Manifest profile
  BUILD_MODULES=1      Build and package modules
  KERNEL_JOBS=N        Parallel build jobs
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

backend="${GEMINI_BUILD_BACKEND:-buildbox}"
if [[ "$#" -gt 0 ]]; then
  case "$1" in
    --backend=*) backend="${1#--backend=}"; shift ;;
    --backend)
      [[ "$#" -ge 2 ]] || die "--backend requires a value"
      backend="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
fi
[[ "$#" -eq 0 ]] || die "unexpected arguments"

case "${backend}" in
  auto|buildbox)
    "${SCRIPT_DIR}/buildbox" available || \
      die "buildbox is unavailable; kernel build deferred (VM builds require an explicit owner request)"
    backend=buildbox
    ;;
  vm) ;;
  *) die "backend must be auto, buildbox, or vm" ;;
esac

case "${backend}" in
  buildbox) exec "${SCRIPT_DIR}/buildbox" build-kernel ;;
  vm) exec "${SCRIPT_DIR}/dev-vm" build-kernel ;;
esac
