#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
readonly REPO_DIR
readonly MANIFEST="${REPO_DIR}/kernel/manifest.json"
readonly MANIFEST_SERIES_VALIDATOR="${SCRIPT_DIR}/validate-manifest-series"
readonly SOURCE_INTEGRITY_HELPER="${SCRIPT_DIR}/source-tree-integrity"

die() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_linux() {
  [[ "$(uname -s)" == Linux ]] || die "run this command on a supported Linux builder"
  case "$(uname -m)" in
    aarch64|x86_64) ;;
    *) die "expected an aarch64 native builder or x86_64 cross-builder" ;;
  esac
}

declare -a KERNEL_MAKE_TOOLCHAIN_ARGS=()
BUILD_ARCHITECTURE=""
TOOLCHAIN_MODE=""
TARGET_CC=""
TARGET_LD=""
TARGET_COMPILER_VERSION=""
TARGET_COMPILER_FULL_VERSION=""
TARGET_COMPILER_TARGET=""
TARGET_COMPILER_SHA256=""
TARGET_LINKER_VERSION=""
TARGET_LINKER_SHA256=""
CCACHE_ENABLED=false
CCACHE_VERSION=""

initialize_toolchain() {
  local cross_compile="${CROSS_COMPILE:-}"
  local ccache_mode="${KERNEL_CCACHE:-0}"

  BUILD_ARCHITECTURE="$(uname -m)"
  case "${BUILD_ARCHITECTURE}" in
    aarch64)
      TOOLCHAIN_MODE=native
      ;;
    x86_64)
      TOOLCHAIN_MODE=cross
      cross_compile="${cross_compile:-aarch64-linux-gnu-}"
      ;;
  esac

  [[ "${cross_compile}" != *[[:space:]]* && "${cross_compile}" != *$'\n'* ]] || \
    die "CROSS_COMPILE may not contain whitespace"
  case "${ccache_mode}" in
    0|1) ;;
    *) die "KERNEL_CCACHE must be 0 or 1" ;;
  esac

  TARGET_CC="${cross_compile}gcc"
  TARGET_LD="${cross_compile}ld"
  require_command "${TARGET_CC}"
  require_command "${TARGET_LD}"

  TARGET_COMPILER_VERSION="$(${TARGET_CC} --version | head -n 1)"
  TARGET_COMPILER_FULL_VERSION="$(${TARGET_CC} -dumpfullversion -dumpversion)"
  TARGET_COMPILER_TARGET="$(${TARGET_CC} -dumpmachine)"
  TARGET_COMPILER_SHA256="$(sha256sum "$(command -v "${TARGET_CC}")" | awk '{print $1}')"
  TARGET_LINKER_VERSION="$(${TARGET_LD} --version | head -n 1)"
  TARGET_LINKER_SHA256="$(sha256sum "$(command -v "${TARGET_LD}")" | awk '{print $1}')"

  [[ "${TARGET_COMPILER_TARGET}" == aarch64-* || \
     "${TARGET_COMPILER_TARGET}" == aarch64 ]] || \
    die "compiler does not target aarch64: ${TARGET_COMPILER_TARGET}"

  KERNEL_MAKE_TOOLCHAIN_ARGS=(
    "CROSS_COMPILE=${cross_compile}"
    "LD=${TARGET_LD}"
  )
  if [[ "${ccache_mode}" == 1 ]]; then
    require_command ccache
    CCACHE_ENABLED=true
    CCACHE_VERSION="$(ccache --version | head -n 1)"
    KERNEL_MAKE_TOOLCHAIN_ARGS+=("CC=ccache ${TARGET_CC}")
  else
    KERNEL_MAKE_TOOLCHAIN_ARGS+=("CC=${TARGET_CC}")
  fi
}

kernel_make() {
  make -C "${SOURCE_DIR}" \
    O="${BUILD_DIR}" \
    ARCH="${ARCH}" \
    "${KERNEL_MAKE_TOOLCHAIN_ARGS[@]}" \
    "$@"
}

manifest_value() {
  jq -er "$1" "${MANIFEST}"
}

[[ -x "${MANIFEST_SERIES_VALIDATOR}" ]] || \
  die "manifest-series validator is missing or not executable: ${MANIFEST_SERIES_VALIDATOR}"
[[ -f "${SOURCE_INTEGRITY_HELPER}" && ! -L "${SOURCE_INTEGRITY_HELPER}" ]] || \
  die "source-integrity helper is missing or unsafe: ${SOURCE_INTEGRITY_HELPER}"
require_command python3
"${MANIFEST_SERIES_VALIDATOR}" "${MANIFEST}" >/dev/null

VERSION="$(manifest_value '.kernel.version')"
readonly VERSION
RELEASED="$(manifest_value '.kernel.released')"
readonly RELEASED
SOURCE_URL="$(manifest_value '.kernel.source_url')"
readonly SOURCE_URL
SOURCE_SHA256="$(manifest_value '.kernel.sha256')"
readonly SOURCE_SHA256
ARCH="$(manifest_value '.architecture')"
readonly ARCH
DEFAULT_PROFILE="$(manifest_value '.config.default_profile')"
readonly DEFAULT_PROFILE
KERNEL_PROFILE="${KERNEL_PROFILE:-${DEFAULT_PROFILE}}"
readonly KERNEL_PROFILE
[[ "${KERNEL_PROFILE}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || \
  die "invalid kernel profile name: ${KERNEL_PROFILE}"
jq -e --arg profile "${KERNEL_PROFILE}" '
  . as $manifest |
  ($manifest.config.profiles[$profile] | type) == "object" and
  ($manifest.config.profiles[$profile].base | type) == "string" and
  ($manifest.config.profiles[$profile].base | length) > 0 and
  ($manifest.config.profiles[$profile].fragments | type) == "array" and
  ($manifest.config.profiles[$profile].fragments |
    all(.[]; type == "string" and length > 0)) and
  (($manifest.config.profiles[$profile].patch_series //
    $manifest.patch_series) | type == "string" and length > 0)
' "${MANIFEST}" >/dev/null || die "kernel profile is not defined correctly: ${KERNEL_PROFILE}"
BASE_CONFIG="$(jq -er --arg profile "${KERNEL_PROFILE}" \
  '.config.profiles[$profile].base' "${MANIFEST}")"
readonly BASE_CONFIG
[[ "${BASE_CONFIG}" =~ ^[A-Za-z0-9_.+-]+$ ]] || \
  die "invalid base configuration for profile ${KERNEL_PROFILE}: ${BASE_CONFIG}"
PROFILE_SERIES_REL="$(jq -r --arg profile "${KERNEL_PROFILE}" \
  '.config.profiles[$profile].patch_series // ""' "${MANIFEST}")"
readonly PROFILE_SERIES_REL
SERIES_REL="$(jq -er --arg profile "${KERNEL_PROFILE}" \
  '.config.profiles[$profile].patch_series // .patch_series' "${MANIFEST}")"
readonly SERIES_REL
[[ "${SERIES_REL}" == patches/* && "${SERIES_REL}" != */ && \
   "${SERIES_REL}" != *[[:space:]]* ]] || \
  die "unsafe patch series path for profile ${KERNEL_PROFILE}: ${SERIES_REL}"
case "/${SERIES_REL}/" in
  *//*|*/../*|*/./*)
    die "unsafe patch series path for profile ${KERNEL_PROFILE}: ${SERIES_REL}"
    ;;
esac
readonly SERIES_FILE="${REPO_DIR}/${SERIES_REL}"
[[ -f "${SERIES_FILE}" && ! -L "${SERIES_FILE}" ]] || \
  die "patch series is missing, not regular, or a symlink: ${SERIES_FILE}"
PATCH_DIR="$(dirname "${SERIES_FILE}")"
readonly PATCH_DIR

readonly SOURCE_ROOT="${GEMINI_SOURCE_ROOT:-${HOME}/src/gemini-pda}"
readonly BUILD_ROOT="${GEMINI_BUILD_ROOT:-${HOME}/build/gemini-pda}"
readonly ARTIFACT_ROOT="${GEMINI_ARTIFACT_ROOT:-${HOME}/artifacts/gemini-pda}"
readonly CACHE_ROOT="${GEMINI_CACHE_ROOT:-${HOME}/.cache/gemini-pda}"
if [[ -n "${PROFILE_SERIES_REL}" ]]; then
  # Configuration profiles that share a patch series must share one extracted
  # and patched Linux tree.  The out-of-tree BUILD_DIR remains profile-specific.
  SERIES_KEY="${SERIES_REL##*/}"
  [[ "${SERIES_KEY}" =~ ^[A-Za-z0-9_.+-]+$ ]] || \
    die "unsafe patch-series source key: ${SERIES_KEY}"
  SOURCE_DIR="${SOURCE_ROOT}/linux-${VERSION}-${SERIES_KEY}-source"
else
  SOURCE_DIR="${SOURCE_ROOT}/linux-${VERSION}"
fi
readonly SOURCE_DIR
if [[ "${KERNEL_PROFILE}" == full ]]; then
  BUILD_DIR="${BUILD_ROOT}/linux-${VERSION}"
else
  BUILD_DIR="${BUILD_ROOT}/linux-${VERSION}-${KERNEL_PROFILE}"
fi
readonly BUILD_DIR
readonly ARCHIVE="${CACHE_ROOT}/linux-${VERSION}.tar.xz"

usage() {
  cat <<'EOF'
Usage: ./scripts/kernel COMMAND

Commands:
  prepare       Download, verify, extract, and apply the ordered patch series
  configure     Prepare and generate the merged arm64 kernel configuration
  build         Prepare, configure, compile Image + Image.gz + DTBs, and package artifacts
  paths         Print the managed source, build, cache, and artifact locations
  status        Show the pinned version, patch state, and prepared-tree state
  check-latest  Compare the pinned version with kernel.org's latest stable release

Environment:
  KERNEL_PROFILE        Config profile from the manifest (default: full)
  KERNEL_JOBS           Parallel build jobs (default: guest CPU count)
  BUILD_MODULES=1       Also compile modules
  CROSS_COMPILE=PREFIX  Target compiler prefix (default: native or aarch64-linux-gnu-)
  KERNEL_CCACHE=1       Compile target objects through ccache
  GEMINI_SOURCE_ROOT    Override the managed source root
  GEMINI_BUILD_ROOT     Override the out-of-tree build root
  GEMINI_ARTIFACT_ROOT  Override the artifact root
  GEMINI_CACHE_ROOT     Override the verified-download cache

Profiles may select an isolated patch series with a `patch_series` member in
kernel/manifest.json. Profiles without one retain the top-level series.
EOF
}

for_each_config_fragment() {
  local fragment
  local basename
  local -A seen_basenames=()

  while IFS= read -r fragment; do
    [[ "${fragment}" == configs/* && "${fragment}" != *[[:space:]]* ]] || \
      die "unsafe config fragment path for profile ${KERNEL_PROFILE}: ${fragment}"
    case "/${fragment}/" in
      *//*|*/../*|*/./*)
        die "unsafe config fragment path for profile ${KERNEL_PROFILE}: ${fragment}"
        ;;
    esac
    [[ -f "${REPO_DIR}/${fragment}" && ! -L "${REPO_DIR}/${fragment}" ]] || \
      die "config fragment is missing, not regular, or a symlink: ${fragment}"
    basename="${fragment##*/}"
    [[ "${basename}" =~ ^[A-Za-z0-9_.+-]+$ ]] || \
      die "unsafe config fragment basename: ${basename}"
    [[ -z "${seen_basenames[${basename}]+present}" ]] || \
      die "config fragments have a packaged-basename collision: ${basename}"
    seen_basenames["${basename}"]="${fragment}"
    printf '%s\n' "${fragment}"
  done < <(jq -er --arg profile "${KERNEL_PROFILE}" \
    '.config.profiles[$profile].fragments[]' "${MANIFEST}")
}

for_each_patch() {
  local callback="$1"
  local line
  local line_number=0

  [[ -f "${SERIES_FILE}" ]] || die "patch series not found: ${SERIES_FILE}"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_number=$((line_number + 1))
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    [[ "${line}" != *[[:space:]]* ]] || \
      die "${SERIES_FILE}:${line_number}: patch paths may not contain whitespace"
    [[ "${line}" != /* ]] || \
      die "${SERIES_FILE}:${line_number}: patch path must remain below patches/"
    case "/${line}/" in
      *//*|*/../*|*/./*)
        die "${SERIES_FILE}:${line_number}: patch path must remain below patches/"
        ;;
    esac
    [[ -f "${PATCH_DIR}/${line}" && ! -L "${PATCH_DIR}/${line}" ]] || \
      die "patch listed in series is missing, not regular, or a symlink: ${line}"
    "${callback}" "${line}" "${PATCH_DIR}/${line}"
  done < "${SERIES_FILE}"
}

hash_patch() {
  local relative="$1"
  local path="$2"
  [[ -f "${path}" && ! -L "${path}" ]] || \
    die "patch listed in series is unsafe: ${relative}"
  printf '%s  %s\n' "$(sha256sum "${path}" | awk '{print $1}')" "${relative}"
}

patchset_hash() {
  {
    printf '%s  %s\n' "$(sha256sum "${SERIES_FILE}" | awk '{print $1}')" "${SERIES_REL}"
    for_each_patch hash_patch
  } | sha256sum | awk '{print $1}'
}

hash_config_fragment() {
  local relative="$1"
  local path="${REPO_DIR}/${relative}"
  [[ -f "${path}" && ! -L "${path}" ]] || \
    die "config fragment is unsafe: ${relative}"
  printf '%s  %s\n' "$(sha256sum "${path}" | awk '{print $1}')" "${relative}"
}

config_hash() {
  {
    printf '%s\n' "profile=${KERNEL_PROFILE}"
    printf '%s\n' "base=${BASE_CONFIG}"
    while IFS= read -r fragment; do
      hash_config_fragment "${fragment}"
    done < <(for_each_config_fragment)
  } | sha256sum | awk '{print $1}'
}

source_state_hash() {
  printf '%s\n%s\n%s\n' "${VERSION}" "${SOURCE_SHA256}" "$(patchset_hash)" \
    | sha256sum | awk '{print $1}'
}

source_integrity_valid() {
  [[ -f "${SOURCE_DIR}/.gemini-source-integrity" && \
     ! -L "${SOURCE_DIR}/.gemini-source-integrity" ]] && \
    python3 "${SOURCE_INTEGRITY_HELPER}" verify "${SOURCE_DIR}" >/dev/null 2>&1
}

build_state_hash() {
  {
    source_state_hash
    config_hash
    printf '%s\n' "build_architecture=${BUILD_ARCHITECTURE}"
    printf '%s\n' "toolchain_mode=${TOOLCHAIN_MODE}"
    printf '%s\n' "compiler_version=${TARGET_COMPILER_FULL_VERSION}"
    printf '%s\n' "compiler_target=${TARGET_COMPILER_TARGET}"
    printf '%s\n' "compiler_sha256=${TARGET_COMPILER_SHA256}"
    printf '%s\n' "linker=${TARGET_LINKER_VERSION}"
    printf '%s\n' "linker_sha256=${TARGET_LINKER_SHA256}"
  } | sha256sum | awk '{print $1}'
}

download_source() {
  mkdir -p "${CACHE_ROOT}"
  if [[ ! -f "${ARCHIVE}" ]]; then
    echo "Downloading Linux ${VERSION} from kernel.org"
    curl --fail --location --retry 3 --output "${ARCHIVE}.partial" "${SOURCE_URL}"
    mv "${ARCHIVE}.partial" "${ARCHIVE}"
  fi

  if ! printf '%s  %s\n' "${SOURCE_SHA256}" "${ARCHIVE}" | sha256sum --check --status; then
    rm -f "${ARCHIVE}"
    die "kernel archive checksum mismatch; removed ${ARCHIVE}"
  fi
}

apply_patch_file() {
  local relative="$1"
  local path="$2"
  echo "Applying ${relative}"
  git -C "${PREPARED_TREE}" apply --check --unidiff-zero "${path}"
  git -C "${PREPARED_TREE}" apply --unidiff-zero "${path}"
}

prepare_kernel() {
  local expected_state
  local temporary
  expected_state="$(source_state_hash)"

  mkdir -p "${SOURCE_ROOT}"
  # Interrupted preparation used to leave full extracted trees behind because
  # the cleanup trap only ran on normal function return.  These are disposable
  # VM-owned staging paths, never a published source tree.
  for temporary in "${SOURCE_ROOT}"/.prepare-"${VERSION}".*; do
    [[ -d "${temporary}" && ! -L "${temporary}" ]] || continue
    rm -rf -- "${temporary}"
  done

  if [[ -f "${SOURCE_DIR}/.gemini-source-state" ]] && \
     [[ "$(< "${SOURCE_DIR}/.gemini-source-state")" == "${expected_state}" ]]; then
    if source_integrity_valid; then
      echo "Linux ${VERSION} source is already prepared at ${SOURCE_DIR}"
      return
    fi
    echo "Prepared Linux ${VERSION} source content drifted; reconstructing" >&2
  fi

  download_source
  temporary="$(mktemp -d "${SOURCE_ROOT}/.prepare-${VERSION}.XXXXXX")"
  PREPARED_TREE="${temporary}/linux-${VERSION}"
  export PREPARED_TREE

  cleanup_prepare() {
    if [[ -n "${temporary:-}" && -d "${temporary}" && ! -L "${temporary}" ]]; then
      rm -rf -- "${temporary}"
    fi
  }
  trap cleanup_prepare EXIT

  echo "Extracting Linux ${VERSION}"
  tar -xJf "${ARCHIVE}" -C "${temporary}"
  [[ -d "${PREPARED_TREE}" ]] || die "archive did not contain linux-${VERSION}"
  git -C "${PREPARED_TREE}" init --quiet
  for_each_patch apply_patch_file
  printf '%s\n' "${expected_state}" > "${PREPARED_TREE}/.gemini-source-state"
  python3 "${SOURCE_INTEGRITY_HELPER}" write "${PREPARED_TREE}" >/dev/null

  case "${SOURCE_DIR}" in
    "${SOURCE_ROOT}"/linux-*) ;;
    *) die "refusing to replace unexpected source path: ${SOURCE_DIR}" ;;
  esac
  rm -rf "${SOURCE_DIR}"
  mv "${PREPARED_TREE}" "${SOURCE_DIR}"
  trap - EXIT
  rm -rf "${temporary}"
  echo "Prepared Linux ${VERSION} at ${SOURCE_DIR}"
}

configure_kernel() {
  local expected_state
  local fragment
  local -a fragments=()

  prepare_kernel
  expected_state="$(build_state_hash)"
  if [[ -f "${BUILD_DIR}/.gemini-build-state" ]] && \
     [[ "$(< "${BUILD_DIR}/.gemini-build-state")" != "${expected_state}" ]]; then
    case "${BUILD_DIR}" in
      "${BUILD_ROOT}"/linux-*) rm -rf "${BUILD_DIR}" ;;
      *) die "refusing to replace unexpected build path: ${BUILD_DIR}" ;;
    esac
  fi

  mkdir -p "${BUILD_DIR}"
  kernel_make "${BASE_CONFIG}"
  while IFS= read -r fragment; do
    fragments+=("${REPO_DIR}/${fragment}")
  done < <(for_each_config_fragment)

  if [[ "${#fragments[@]}" -gt 0 ]]; then
    (
      cd "${BUILD_DIR}"
      "${SOURCE_DIR}/scripts/kconfig/merge_config.sh" \
        -m -O "${BUILD_DIR}" "${BUILD_DIR}/.config" "${fragments[@]}"
    )
  fi
  kernel_make olddefconfig
  validate_config_fragments
  printf '%s\n' "${expected_state}" > "${BUILD_DIR}/.gemini-build-state"
  echo "Configured Linux ${VERSION} at ${BUILD_DIR}"
}

validate_config_fragments() {
  local relative
  local path
  local line
  local line_number
  local symbol
  local -a symbols=()
  local -A expected=()
  local -A origin=()

  while IFS= read -r relative; do
    path="${REPO_DIR}/${relative}"
    line_number=0
    while IFS= read -r line || [[ -n "${line}" ]]; do
      line_number=$((line_number + 1))
      case "${line}" in
        CONFIG_*=*)
          symbol="${line%%=*}"
          ;;
        '# CONFIG_'*' is not set')
          symbol="${line#\# }"
          symbol="${symbol% is not set}"
          ;;
        ''|'# '*)
          continue
          ;;
        *)
          die "${relative}:${line_number}: unsupported config-fragment line: ${line}"
          ;;
      esac
      if [[ -z "${expected[${symbol}]+present}" ]]; then
        symbols+=("${symbol}")
      fi
      expected["${symbol}"]="${line}"
      origin["${symbol}"]="${relative}:${line_number}"
    done < "${path}"
  done < <(for_each_config_fragment)

  # merge_config.sh applies fragments in order. Validate the final request for
  # each symbol so a narrow profile may intentionally override common policy.
  for symbol in "${symbols[@]}"; do
    line="${expected[${symbol}]}"
    case "${line}" in
      CONFIG_*=*)
        grep -Fqx "${line}" "${BUILD_DIR}/.config" || \
          die "${origin[${symbol}]}: requested value was not retained: ${line}"
        ;;
      '# CONFIG_'*' is not set')
        if ! grep -Fqx "${line}" "${BUILD_DIR}/.config"; then
          if grep -Eq "^${symbol}=" "${BUILD_DIR}/.config"; then
            die "${origin[${symbol}]}: requested value was not retained: ${line}"
          fi
        fi
        ;;
    esac
  done
}

copy_patch_to_provenance() {
  local relative="$1"
  local path="$2"
  mkdir -p "${PACKAGE_DIR}/provenance/patches/$(dirname "${relative}")"
  cp "${path}" "${PACKAGE_DIR}/provenance/patches/${relative}"
}

assert_build_inputs_unchanged() {
  local expected_source_state="$1"
  local expected_build_state="$2"

  [[ -f "${SOURCE_DIR}/.gemini-source-state" ]] || \
    die "prepared source state disappeared during build"
  [[ -f "${SOURCE_DIR}/.gemini-source-integrity" && \
     ! -L "${SOURCE_DIR}/.gemini-source-integrity" ]] || \
    die "prepared source integrity marker disappeared during build"
  [[ -f "${BUILD_DIR}/.gemini-build-state" ]] || \
    die "configured build state disappeared during build"
  [[ "$(< "${SOURCE_DIR}/.gemini-source-state")" == "${expected_source_state}" ]] || \
    die "prepared source was replaced during build; rerun the build"
  [[ "$(< "${BUILD_DIR}/.gemini-build-state")" == "${expected_build_state}" ]] || \
    die "configured build was replaced during build; rerun the build"
  [[ "$(source_state_hash)" == "${expected_source_state}" ]] || \
    die "kernel or patch inputs changed during build; rerun the build"
  python3 "${SOURCE_INTEGRITY_HELPER}" verify "${SOURCE_DIR}" >/dev/null || \
    die "prepared source content changed during build; rerun the build"
  [[ "$(build_state_hash)" == "${expected_build_state}" ]] || \
    die "configuration or toolchain inputs changed during build; rerun the build"
}

package_artifacts() {
  local kernel_release="$1"
  local expected_source_state="$2"
  local expected_build_state="$3"
  local patch_hash="$4"
  local config_input_hash="$5"
  local config_fragments_json
  local package_name
  local repository_commit
  local repository_dirty
  local resolved_config_sha256
  local temporary
  local sums_file
  local fragment
  local modules_built=false

  repository_commit="${GEMINI_REPOSITORY_COMMIT:-$(git -C "${REPO_DIR}" rev-parse HEAD 2>/dev/null || true)}"
  if [[ -n "${GEMINI_REPOSITORY_DIRTY:-}" ]]; then
    repository_dirty="${GEMINI_REPOSITORY_DIRTY}"
  elif [[ -n "$(git -C "${REPO_DIR}" status --porcelain 2>/dev/null)" ]]; then
    repository_dirty=true
  else
    repository_dirty=false
  fi
  [[ -z "${repository_commit}" || "${repository_commit}" =~ ^[0-9a-f]{40,64}$ ]] || \
    die "invalid repository commit identity"
  [[ "${repository_dirty}" == true || "${repository_dirty}" == false ]] || \
    die "GEMINI_REPOSITORY_DIRTY must be true or false"

  if [[ "${KERNEL_PROFILE}" == full ]]; then
    package_name="linux-${VERSION}-gemini-${patch_hash:0:12}"
  else
    package_name="linux-${VERSION}-gemini-${KERNEL_PROFILE}-${patch_hash:0:8}-${config_input_hash:0:8}"
  fi
  PACKAGE_DIR="${ARTIFACT_ROOT}/${package_name}"
  export PACKAGE_DIR
  temporary="${PACKAGE_DIR}.partial"

  rm -rf "${temporary}"
  mkdir -p "${temporary}/dtbs/mediatek" "${temporary}/provenance/configs"
  PACKAGE_DIR="${temporary}"
  export PACKAGE_DIR

  install -m 0644 "${BUILD_DIR}/arch/arm64/boot/Image" "${PACKAGE_DIR}/Image"
  install -m 0644 "${BUILD_DIR}/arch/arm64/boot/Image.gz" "${PACKAGE_DIR}/Image.gz"
  install -m 0644 "${BUILD_DIR}/.config" "${PACKAGE_DIR}/kernel.config"
  install -m 0644 "${BUILD_DIR}/System.map" "${PACKAGE_DIR}/System.map"
  if [[ "${BUILD_MODULES:-0}" == 1 ]]; then
    modules_built=true
    kernel_make \
      INSTALL_MOD_PATH="${PACKAGE_DIR}/modules" \
      modules_install
  fi
  rsync -a \
    --include='*/' --include='*.dtb' --exclude='*' \
    "${BUILD_DIR}/arch/arm64/boot/dts/mediatek/" \
    "${PACKAGE_DIR}/dtbs/mediatek/"

  cp "${MANIFEST}" "${PACKAGE_DIR}/provenance/kernel-manifest.json"
  cp "${SERIES_FILE}" "${PACKAGE_DIR}/provenance/series"
  while IFS= read -r fragment; do
    cp "${REPO_DIR}/${fragment}" "${PACKAGE_DIR}/provenance/configs/$(basename "${fragment}")"
  done < <(for_each_config_fragment)
  for_each_patch copy_patch_to_provenance

  resolved_config_sha256="$(sha256sum "${BUILD_DIR}/.config" | awk '{print $1}')"

  config_fragments_json="$(jq -cer --arg profile "${KERNEL_PROFILE}" \
    '.config.profiles[$profile].fragments' "${MANIFEST}")"

  jq -n \
    --arg generated "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg kernel_release "${kernel_release}" \
    --arg build_profile "${KERNEL_PROFILE}" \
    --arg base_config "${BASE_CONFIG}" \
    --argjson config_fragments "${config_fragments_json}" \
    --arg config_inputs_sha256 "${config_input_hash}" \
    --arg source_sha256 "${SOURCE_SHA256}" \
    --arg patchset_sha256 "${patch_hash}" \
    --arg config_sha256 "${resolved_config_sha256}" \
    --argjson modules_built "${modules_built}" \
    --arg build_architecture "${BUILD_ARCHITECTURE}" \
    --arg target_architecture "${ARCH}" \
    --arg toolchain_mode "${TOOLCHAIN_MODE}" \
    --arg compiler "${TARGET_COMPILER_VERSION}" \
    --arg compiler_full_version "${TARGET_COMPILER_FULL_VERSION}" \
    --arg compiler_target "${TARGET_COMPILER_TARGET}" \
    --arg compiler_sha256 "${TARGET_COMPILER_SHA256}" \
    --arg linker "${TARGET_LINKER_VERSION}" \
    --arg linker_sha256 "${TARGET_LINKER_SHA256}" \
    --argjson ccache_enabled "${CCACHE_ENABLED}" \
    --arg ccache_version "${CCACHE_VERSION}" \
    --arg repository_commit "${repository_commit}" \
    --argjson repository_dirty "${repository_dirty}" \
    '{
      schema: 1,
      generated_utc: $generated,
      kernel_release: $kernel_release,
      build_profile: $build_profile,
      base_config: $base_config,
      config_fragments: $config_fragments,
      config_inputs_sha256: $config_inputs_sha256,
      source_sha256: $source_sha256,
      patchset_sha256: $patchset_sha256,
      config_sha256: $config_sha256,
      modules_built: $modules_built,
      build_architecture: $build_architecture,
      target_architecture: $target_architecture,
      toolchain_mode: $toolchain_mode,
      compiler: $compiler,
      compiler_full_version: $compiler_full_version,
      compiler_target: $compiler_target,
      compiler_sha256: $compiler_sha256,
      linker: $linker,
      linker_sha256: $linker_sha256,
      ccache_enabled: $ccache_enabled,
      ccache_version: $ccache_version,
      repository_commit: $repository_commit,
      repository_dirty: $repository_dirty
    }' > "${PACKAGE_DIR}/provenance/build.json"

  # ABI-7's expected record is package authority, not kernel source. Emit it
  # only when the selected image contains the matching producer, and fail
  # closed if the DT tooling or the Gemini DTB is unavailable.
  if grep -Fqx 'CONFIG_ARM64_LATE_CPU_RUNTIME_IDENTITY=y' \
      "${BUILD_DIR}/.config"; then
    for command in python3 dtc fdtoverlay fdtget; do
      require_command "${command}"
    done
    python3 "${SCRIPT_DIR}/generate-late-cpu-provenance.py" \
      --vmlinux "${BUILD_DIR}/vmlinux" \
      --config "${BUILD_DIR}/.config" \
      --image "${PACKAGE_DIR}/Image" \
      --dtb "${PACKAGE_DIR}/dtbs/mediatek/mt6797-gemini-pda.dtb" \
      --record-json "${PACKAGE_DIR}/provenance/a41-record.json" \
      --profile-id 'mt6797-a53-a72-a41-v7' \
      --source-sha256 "${SOURCE_SHA256}" \
      --patchset-sha256 "${patch_hash}" \
      --config-inputs-sha256 "${config_input_hash}" \
      --resolved-config-sha256 "${resolved_config_sha256}" \
      --build-provenance "${PACKAGE_DIR}/provenance/build.json"
  fi

  sums_file="${temporary}.SHA256SUMS"
  (
    cd "${PACKAGE_DIR}"
    find . -type f ! -path ./SHA256SUMS -print0 \
      | sort -z \
      | xargs -0 sha256sum > "${sums_file}"
  )
  mv "${sums_file}" "${PACKAGE_DIR}/SHA256SUMS"

  assert_build_inputs_unchanged \
    "${expected_source_state}" "${expected_build_state}"

  PACKAGE_DIR="${ARTIFACT_ROOT}/${package_name}"
  rm -rf "${PACKAGE_DIR}"
  mv "${temporary}" "${PACKAGE_DIR}"
  echo "Packaged artifacts at ${PACKAGE_DIR}"
}

build_kernel() {
  local jobs="${KERNEL_JOBS:-$(nproc)}"
  local -a targets=(Image Image.gz dtbs)
  local config_input_hash
  local expected_build_state
  local expected_source_state
  local kernel_release
  local patch_hash

  case "${KERNEL_PROFILE}:${BUILD_MODULES:-0}" in
    handoff:1|usbdiag:1|usbdiag-clkignore:1)
      die "the ${KERNEL_PROFILE} profile is built-in-only; BUILD_MODULES=1 is not supported"
      ;;
  esac

  configure_kernel
  expected_source_state="$(< "${SOURCE_DIR}/.gemini-source-state")"
  expected_build_state="$(< "${BUILD_DIR}/.gemini-build-state")"
  patch_hash="$(patchset_hash)"
  config_input_hash="$(config_hash)"
  if [[ "${BUILD_MODULES:-0}" == 1 ]]; then
    targets+=(modules)
  fi

  export KBUILD_BUILD_USER=gemini-pda
  export KBUILD_BUILD_HOST=devvm
  export KBUILD_BUILD_VERSION=1
  export KBUILD_BUILD_TIMESTAMP="${RELEASED} 00:00:00 UTC"
  export KCONFIG_NOTIMESTAMP=1

  kernel_make -j "${jobs}" \
    "${targets[@]}"
  assert_build_inputs_unchanged \
    "${expected_source_state}" "${expected_build_state}"
  kernel_release="$(kernel_make -s kernelrelease)"
  package_artifacts "${kernel_release}" \
    "${expected_source_state}" "${expected_build_state}" "${patch_hash}" \
    "${config_input_hash}"
}

show_paths() {
  cat <<EOF
profile=${KERNEL_PROFILE}
patch_series=${SERIES_REL}
source=${SOURCE_DIR}
build=${BUILD_DIR}
artifacts=${ARTIFACT_ROOT}
cache=${CACHE_ROOT}
EOF
}

show_status() {
  local count=0
  count_patches() {
    count=$((count + 1))
  }
  for_each_patch count_patches

  echo "Pinned stable kernel: ${VERSION} (${RELEASED})"
  echo "Build profile:        ${KERNEL_PROFILE}"
  echo "Patch series:         ${SERIES_REL}"
  echo "Base configuration:   ${BASE_CONFIG}"
  echo "Config inputs SHA-256: $(config_hash)"
  while IFS= read -r fragment; do
    echo "Config fragment:      ${fragment}"
  done < <(for_each_config_fragment)
  echo "Patch count:          ${count}"
  echo "Patchset SHA-256:     $(patchset_hash)"
  if [[ -f "${SOURCE_DIR}/.gemini-source-state" ]] && \
     [[ "$(< "${SOURCE_DIR}/.gemini-source-state")" == "$(source_state_hash)" ]] && \
     source_integrity_valid; then
    echo "Prepared source:      current"
  else
    echo "Prepared source:      absent or stale"
  fi
  show_paths
}

check_latest() {
  local latest
  latest="$(curl --fail --location --silent https://www.kernel.org/releases.json \
    | jq -er '.latest_stable.version')"
  echo "Pinned: ${VERSION}"
  echo "Latest: ${latest}"
  [[ "${VERSION}" == "${latest}" ]] || return 1
}

require_linux
for command in curl git jq make sha256sum tar; do
  require_command "${command}"
done
initialize_toolchain
[[ -f "${MANIFEST}" ]] || die "kernel manifest not found: ${MANIFEST}"

readonly COMMAND="${1:-}"
case "${COMMAND}" in
  prepare)
    prepare_kernel
    ;;
  configure)
    configure_kernel
    ;;
  build)
    build_kernel
    ;;
  paths)
    show_paths
    ;;
  status)
    show_status
    ;;
  check-latest)
    check_latest
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
