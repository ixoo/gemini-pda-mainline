#!/usr/bin/env bash

set -euo pipefail

die() {
  echo "error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: ./scripts/validate-kernel-artifact [ARTIFACT_DIR]

Validate a packaged kernel artifact in the development VM. With no argument,
the newest package below ~/artifacts/gemini-pda is selected.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

validate_relative_path() {
  local label="$1"
  local path="$2"

  [[ -n "${path}" ]] || die "${label} is empty"
  [[ "${path}" != /* ]] || die "${label} must be relative: ${path}"
  [[ "${path}" != *[[:space:]]* ]] || \
    die "${label} may not contain whitespace: ${path}"
  case "/${path}/" in
    *//*|*/../*|*/./*)
      die "${label} contains an unsafe path component: ${path}"
      ;;
  esac
}

[[ "$(uname -s)" == Linux ]] || die "run this command inside the development VM"
[[ "$(uname -m)" == aarch64 ]] || die "expected an aarch64 development VM"

for command in awk basename cmp find gzip head jq od sha256sum sort tail tr uniq wc; do
  require_command "${command}"
done

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    artifact_root="${GEMINI_ARTIFACT_ROOT:-${HOME}/artifacts/gemini-pda}"
    artifact_record="$(find "${artifact_root}" -mindepth 1 -maxdepth 1 \
      -type d -name 'linux-*-gemini-*' -printf '%T@ %p\n' \
      | sort -n | tail -n 1)"
    artifact_dir="${artifact_record#* }"
    [[ -n "${artifact_dir}" ]] || die "no packaged kernel artifacts found below ${artifact_root}"
    ;;
  *)
    [[ "$#" -eq 1 ]] || die "accepts at most one artifact directory"
    artifact_dir="$1"
    ;;
esac

[[ -d "${artifact_dir}" ]] || die "artifact directory does not exist: ${artifact_dir}"
[[ -f "${artifact_dir}/SHA256SUMS" && ! -L "${artifact_dir}/SHA256SUMS" ]] || \
  die "missing or non-regular SHA256SUMS in ${artifact_dir}"
[[ -f "${artifact_dir}/provenance/build.json" ]] || \
  die "missing provenance/build.json in ${artifact_dir}"
[[ -f "${artifact_dir}/provenance/kernel-manifest.json" && \
   ! -L "${artifact_dir}/provenance/kernel-manifest.json" ]] || \
  die "missing or non-regular provenance/kernel-manifest.json in ${artifact_dir}"
[[ -f "${artifact_dir}/provenance/series" && \
   ! -L "${artifact_dir}/provenance/series" ]] || \
  die "missing or non-regular provenance/series in ${artifact_dir}"
[[ -d "${artifact_dir}/provenance/patches" && \
   ! -L "${artifact_dir}/provenance/patches" ]] || \
  die "missing or non-directory provenance/patches in ${artifact_dir}"
[[ -d "${artifact_dir}/provenance/configs" && \
   ! -L "${artifact_dir}/provenance/configs" ]] || \
  die "missing or non-directory provenance/configs in ${artifact_dir}"
unexpected_entry="$(find "${artifact_dir}" -mindepth 1 \
  ! -type d ! -type f -print -quit)"
[[ -z "${unexpected_entry}" ]] || \
  die "artifact tree contains a non-regular entry: ${unexpected_entry}"

for file in Image Image.gz kernel.config System.map provenance/build.json \
  provenance/kernel-manifest.json provenance/series; do
  [[ -s "${artifact_dir}/${file}" ]] || die "missing or empty artifact file: ${file}"
done

gzip -t "${artifact_dir}/Image.gz" || die "Image.gz is not a valid gzip stream"
image_gzip_decompressed_size="$(gzip -cd "${artifact_dir}/Image.gz" | wc -c)"
(( image_gzip_decompressed_size <= 0x03200000 )) || \
  die "Image.gz decompresses beyond the MT6797 LK 50 MiB buffer: ${image_gzip_decompressed_size}"
gzip -cd "${artifact_dir}/Image.gz" | cmp -s - "${artifact_dir}/Image" || \
  die "Image.gz does not decompress byte-for-byte to the packaged Image"

image_size="$(wc -c < "${artifact_dir}/Image")"
[[ "${image_size}" -eq "${image_gzip_decompressed_size}" ]] || \
  die "packaged Image size does not match the gzip stream"
image_magic="$(od -An -tx1 -N4 -j56 "${artifact_dir}/Image" | tr -d ' \n')"
[[ "${image_magic}" == 41524d64 ]] || \
  die "packaged Image is missing the ARM64 Image magic at offset 56"
image_text_offset="$(od -An -tu8 -N8 -j8 "${artifact_dir}/Image" | tr -d ' ')"
image_effective_size="$(od -An -tu8 -N8 -j16 "${artifact_dir}/Image" | tr -d ' ')"
[[ "${image_text_offset}" =~ ^[0-9]+$ ]] || die "invalid ARM64 Image text offset"
[[ "${image_effective_size}" =~ ^[0-9]+$ && "${image_effective_size}" -gt 0 ]] || \
  die "invalid ARM64 Image effective size"
(( image_effective_size <= 0x03200000 )) || \
  die "ARM64 Image effective size exceeds the MT6797 LK 50 MiB region: ${image_effective_size}"

dtb_count="$(find "${artifact_dir}/dtbs/mediatek" -type f -name '*.dtb' | wc -l)"
[[ "${dtb_count}" -gt 0 ]] || die "no MediaTek DTBs found in ${artifact_dir}/dtbs/mediatek"

invalid_manifest_line="$(awk '
  length($1) != 64 || $1 ~ /[^0-9a-f]/ || NF != 2 ||
  $2 !~ /^\.\// || $2 == "./SHA256SUMS" ||
  $2 ~ /(^|\/)\.\.($|\/)/ || $2 ~ /\/\// {
    print NR ":" $0
    exit
  }
' "${artifact_dir}/SHA256SUMS")"
[[ -z "${invalid_manifest_line}" ]] || \
  die "unsafe or malformed SHA256SUMS line: ${invalid_manifest_line}"
manifest_paths="$(awk '{ print $2 }' "${artifact_dir}/SHA256SUMS" | sort)"
duplicate_manifest_path="$(printf '%s\n' "${manifest_paths}" | uniq -d | head -n 1)"
[[ -z "${duplicate_manifest_path}" ]] || \
  die "duplicate SHA256SUMS path: ${duplicate_manifest_path}"
actual_paths="$(cd "${artifact_dir}" && \
  find . -type f ! -path ./SHA256SUMS -print | sort)"
[[ "${manifest_paths}" == "${actual_paths}" ]] || \
  die "SHA256SUMS is not an exact inventory of the artifact's regular files"

(
  cd "${artifact_dir}"
  sha256sum --check --strict SHA256SUMS
)

jq -e '
  .schema == 1 and
  (.kernel_release | length > 0) and
  ((.build_profile == null) or (.build_profile | test("^[a-z0-9][a-z0-9_-]*$"))) and
  ((.base_config == null) or (.base_config | length > 0)) and
  ((.config_fragments == null) or (.config_fragments | type == "array")) and
  ((.config_inputs_sha256 == null) or (.config_inputs_sha256 | test("^[0-9a-f]{64}$"))) and
  (.source_sha256 | test("^[0-9a-f]{64}$")) and
  (.patchset_sha256 | test("^[0-9a-f]{64}$")) and
  (.config_sha256 | test("^[0-9a-f]{64}$")) and
  ((.modules_built == null) or (.modules_built | type == "boolean")) and
  (.compiler | length > 0) and
  (.linker | length > 0)
' "${artifact_dir}/provenance/build.json" >/dev/null || \
  die "invalid provenance/build.json"
[[ "$(jq -er '.config_sha256' "${artifact_dir}/provenance/build.json")" == \
  "$(sha256sum "${artifact_dir}/kernel.config" | awk '{print $1}')" ]] || \
  die "provenance config_sha256 does not match kernel.config"

build_json="${artifact_dir}/provenance/build.json"
kernel_manifest="${artifact_dir}/provenance/kernel-manifest.json"
series_file="${artifact_dir}/provenance/series"
patch_root="${artifact_dir}/provenance/patches"
config_root="${artifact_dir}/provenance/configs"

jq -e '
  .schema == 1 and
  (.kernel | type == "object") and
  (.kernel.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
  (.architecture == "arm64") and
  (((has("patch_series") | not) or (.patch_series == null)) or
   (.patch_series | type == "string" and length > 0)) and
  (.config | type == "object")
' "${kernel_manifest}" >/dev/null || \
  die "invalid provenance/kernel-manifest.json"

manifest_source_sha256="$(jq -er '.kernel.sha256' "${kernel_manifest}")"
build_source_sha256="$(jq -er '.source_sha256' "${build_json}")"
[[ "${build_source_sha256}" == "${manifest_source_sha256}" ]] || \
  die "provenance source_sha256 does not match the packaged kernel manifest"

build_profile="$(jq -r '
  if has("build_profile") and .build_profile != null then .build_profile else "" end
' "${build_json}")"
if [[ -n "${build_profile}" ]]; then
  jq -e --arg profile "${build_profile}" '
    (.config.profiles | type == "object") and
    (.config.profiles[$profile] as $selected |
      ($selected | type == "object") and
      ($selected.base | type == "string" and length > 0) and
      ($selected.fragments | type == "array") and
      ($selected.fragments | all(.[]; type == "string" and length > 0)) and
      (($selected.patch_series == null) or
       ($selected.patch_series | type == "string" and length > 0)))
  ' "${kernel_manifest}" >/dev/null || \
    die "build_profile is absent or invalid in the packaged kernel manifest: ${build_profile}"
  selected_base="$(jq -er --arg profile "${build_profile}" \
    '.config.profiles[$profile].base' "${kernel_manifest}")"
  selected_fragments="$(jq -cer --arg profile "${build_profile}" \
    '.config.profiles[$profile].fragments' "${kernel_manifest}")"
  if jq -e --arg profile "${build_profile}" '
      .config.profiles[$profile].patch_series |
      type == "string" and length > 0
    ' "${kernel_manifest}" >/dev/null; then
    selected_series="$(jq -er --arg profile "${build_profile}" \
      '.config.profiles[$profile].patch_series' "${kernel_manifest}")"
  else
    jq -e '
      .patch_series | type == "string" and length > 0
    ' "${kernel_manifest}" >/dev/null || \
      die "manifest profile ${build_profile} has no patch-series override or valid fallback"
    selected_series="$(jq -er '.patch_series' "${kernel_manifest}")"
  fi
  jq -e \
    --arg base "${selected_base}" \
    --argjson fragments "${selected_fragments}" '
      .base_config == $base and .config_fragments == $fragments
    ' "${build_json}" >/dev/null || \
    die "build base_config/config_fragments do not match manifest profile ${build_profile}"
  resolved_profile="${build_profile}"
else
  jq -e '
      (.config | has("profiles") | not) and
      (.config.base | type == "string" and length > 0) and
      (.config.fragments | type == "array") and
      (.config.fragments | all(.[]; type == "string" and length > 0))
    ' "${kernel_manifest}" >/dev/null || \
    die "build_profile is required when the packaged manifest uses config.profiles"
  jq -e '
    .patch_series | type == "string" and length > 0
  ' "${kernel_manifest}" >/dev/null || \
    die "legacy manifest requires a valid top-level patch_series"
  selected_base="$(jq -er '.config.base' "${kernel_manifest}")"
  selected_fragments="$(jq -cer '.config.fragments' "${kernel_manifest}")"
  selected_series="$(jq -er '.patch_series' "${kernel_manifest}")"
  resolved_profile="legacy"
  jq -e \
    --arg base "${selected_base}" \
    --argjson fragments "${selected_fragments}" '
      ((.base_config == null) or .base_config == $base) and
      ((.config_fragments == null) or .config_fragments == $fragments)
    ' "${build_json}" >/dev/null || \
    die "legacy build base_config/config_fragments disagree with the packaged manifest"
fi

validate_relative_path "selected patch series" "${selected_series}"
[[ "${selected_series}" == patches/* ]] || \
  die "selected patch series must remain below patches/: ${selected_series}"

printf '%s' "${selected_fragments}" | jq -e '
  all(.[];
    (startswith("/") | not) and
    (contains("..") | not) and
    (contains("//") | not) and
    (test("\\s") | not))
' >/dev/null || die "manifest contains an unsafe config-fragment path"

declare -a fragment_paths=()
declare -a config_basenames=()
while IFS= read -r fragment; do
  basename_collision=false
  validate_relative_path "config fragment" "${fragment}"
  fragment_basename="${fragment##*/}"
  for packaged_basename in "${config_basenames[@]}"; do
    if [[ "${packaged_basename}" == "${fragment_basename}" ]]; then
      basename_collision=true
      break
    fi
  done
  [[ "${basename_collision}" == false ]] || \
    die "config fragments have an unsafe packaged-basename collision: ${fragment_basename}"
  fragment_paths+=("${fragment}")
  config_basenames+=("${fragment_basename}")
done < <(printf '%s' "${selected_fragments}" | jq -er '.[]')

expected_config_inventory="$(printf '%s\n' "${config_basenames[@]}" | sort)"
actual_config_inventory="$(find "${config_root}" -type f -printf '%P\n' | sort)"
[[ "${actual_config_inventory}" == "${expected_config_inventory}" ]] || \
  die "provenance/configs is not the exact regular-file inventory selected by the manifest"
for fragment_index in "${!fragment_paths[@]}"; do
  config_file="${config_root}/${config_basenames[${fragment_index}]}"
  [[ -f "${config_file}" && ! -L "${config_file}" ]] || \
    die "selected config fragment is missing or non-regular: ${fragment_paths[${fragment_index}]}"
done

if [[ "${resolved_profile}" == legacy ]]; then
  [[ "$(jq -r '.config_inputs_sha256 // ""' "${build_json}")" == "" ]] || \
    die "legacy build cannot attribute a profile-bound config_inputs_sha256"
else
  computed_config_inputs_sha256="$({
    printf '%s\n' "profile=${resolved_profile}"
    printf '%s\n' "base=${selected_base}"
    for fragment_index in "${!fragment_paths[@]}"; do
      printf '%s  %s\n' \
        "$(sha256sum "${config_root}/${config_basenames[${fragment_index}]}" | awk '{print $1}')" \
        "${fragment_paths[${fragment_index}]}"
    done
  } | sha256sum | awk '{print $1}')"
  recorded_config_inputs_sha256="$(jq -er '
    .config_inputs_sha256 |
    select(type == "string" and test("^[0-9a-f]{64}$"))
  ' "${build_json}")" || \
    die "profile build is missing a valid config_inputs_sha256"
  [[ "${computed_config_inputs_sha256}" == "${recorded_config_inputs_sha256}" ]] || \
    die "provenance config_inputs_sha256 does not match the selected configuration inputs"
fi

declare -a patch_paths=()
line_number=0
while IFS= read -r line || [[ -n "${line}" ]]; do
  duplicate=false
  line_number=$((line_number + 1))
  [[ -z "${line}" || "${line}" == \#* ]] && continue
  validate_relative_path "series line ${line_number}" "${line}"
  for relative in "${patch_paths[@]}"; do
    if [[ "${relative}" == "${line}" ]]; then
      duplicate=true
      break
    fi
  done
  [[ "${duplicate}" == false ]] || \
    die "duplicate patch path in provenance/series: ${line}"
  patch_paths+=("${line}")
done < "${series_file}"
[[ "${#patch_paths[@]}" -gt 0 ]] || die "provenance/series contains no patches"

expected_patch_inventory="$(printf '%s\n' "${patch_paths[@]}" | sort)"
actual_patch_inventory="$(find "${patch_root}" -type f -printf '%P\n' | sort)"
[[ "${actual_patch_inventory}" == "${expected_patch_inventory}" ]] || \
  die "provenance/patches is not the exact regular-file inventory listed by provenance/series"
for relative in "${patch_paths[@]}"; do
  patch_file="${patch_root}/${relative}"
  [[ -s "${patch_file}" && ! -L "${patch_file}" ]] || \
    die "listed patch is missing, empty, or non-regular: ${relative}"
done

computed_patchset_sha256="$({
  printf '%s  %s\n' "$(sha256sum "${series_file}" | awk '{print $1}')" "${selected_series}"
  for relative in "${patch_paths[@]}"; do
    printf '%s  %s\n' \
      "$(sha256sum "${patch_root}/${relative}" | awk '{print $1}')" "${relative}"
  done
} | sha256sum | awk '{print $1}')"
recorded_patchset_sha256="$(jq -er '.patchset_sha256' "${build_json}")"
[[ "${computed_patchset_sha256}" == "${recorded_patchset_sha256}" ]] || \
  die "provenance patchset_sha256 does not match the selected series and patch inventory"

printf 'validation=kernel-artifact\n'
printf 'artifact=%s\n' "$(basename "${artifact_dir}")"
printf 'kernel_release=%s\n' "$(jq -er '.kernel_release' "${artifact_dir}/provenance/build.json")"
printf 'build_profile=%s\n' "$(jq -er '.build_profile // "legacy"' "${artifact_dir}/provenance/build.json")"
printf 'generated_utc=%s\n' "$(jq -er '.generated_utc' "${artifact_dir}/provenance/build.json")"
printf 'source_sha256=%s\n' "$(jq -er '.source_sha256' "${artifact_dir}/provenance/build.json")"
printf 'patchset_sha256=%s\n' "$(jq -er '.patchset_sha256' "${artifact_dir}/provenance/build.json")"
printf 'patch_series=%s\n' "${selected_series}"
printf 'patch_count=%s\n' "${#patch_paths[@]}"
printf 'resolved_profile=%s\n' "${resolved_profile}"
printf 'config_sha256=%s\n' "$(jq -er '.config_sha256' "${artifact_dir}/provenance/build.json")"
printf 'config_fragment_count=%s\n' "${#fragment_paths[@]}"
printf 'modules_built=%s\n' "$(jq -er '.modules_built // false' "${artifact_dir}/provenance/build.json")"
printf 'image_gzip_sha256=%s\n' "$(sha256sum "${artifact_dir}/Image.gz" | awk '{print $1}')"
printf 'image_gzip_decompressed_size=%s\n' "${image_gzip_decompressed_size}"
printf 'image_text_offset=%s\n' "${image_text_offset}"
printf 'image_effective_size=%s\n' "${image_effective_size}"
printf 'dtb_count=%s\n' "${dtb_count}"
printf 'sha256sums=passed\n'
printf 'hardware_write=none\n'
